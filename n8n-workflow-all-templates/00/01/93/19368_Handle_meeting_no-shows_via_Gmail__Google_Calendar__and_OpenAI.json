    {
      "id": "0c9b3921-883b-4fb3-ba5f-1578b0b9e0ab",
      "name": "Sticky Note - Section 1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2432,
        416
      ],
      "parameters": {
        "color": 7,
        "width": 628,
        "height": 488,
        "content": "## 1. Receive the click\nOne webhook backs all three buttons in your reminder email. The action in the link decides which branch runs: confirm, reschedule or cancel."
      },
      "typeVersion": 1
    },
    {
      "id": "a9cdf50e-5b7b-48f7-8184-1946db51f87a",
      "name": "Sticky Note - Section 2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        3952,
        -208
      ],
      "parameters": {
        "color": 7,
        "width": 1460,
        "height": 400,
        "content": "## 2. Confirm\nThe event is fetched by its ID, the guest email and meeting link are read from it, and a confirmation email goes back to the guest."
      },
      "typeVersion": 1
    },
    {
      "id": "4eae09a7-4b63-459e-a891-38db1e7b4061",
      "name": "Sticky Note - Section 3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        3952,
        352
      ],
      "parameters": {
        "color": 7,
        "width": 1488,
        "height": 800,
        "content": "## 3. Reschedule\nThe guest's new time is read from the link. An agent creates the replacement event with Google Meet, then deletes the old one, and the guest is emailed the new details."
      },
      "typeVersion": 1
    },
    {
      "id": "b27e64d8-8ab0-44cd-9719-9d27e25f2511",
      "name": "Sticky Note - Section 4",
