        1232
      ],
      "parameters": {
        "color": 7,
        "width": 1468,
        "height": 352,
        "content": "## 4. Cancel\nThe event is fetched, deleted from the calendar, and the guest gets a cancellation email."
      },
      "typeVersion": 1
    },
