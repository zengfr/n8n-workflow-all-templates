    {
      "id": "49e95c53-65de-455f-9373-0ae1cbcbc846",
      "name": "Build Weekly Digest",
      "type": "n8n-nodes-base.code",
      "position": [
        528,
        720
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst now = new Date();\nconst weekAgo = new Date(now.getTime() - 7 * 86400000);\nconst num = v => parseFloat(String(v ?? '').replace(/[^0-9.\\-]/g, '')) || 0;\nlet weekTotal = 0, weekCount = 0;\nconst byCat = {};\nconst upcoming = [];\nfor (const r of rows) {\n  const amt = num(r.total_amount);\n  const rec = new Date(r.received_at || r.invoice_date);\n  if (!isNaN(rec.getTime()) && rec >= weekAgo) { weekTotal += amt; weekCount++; const c = r.category || 'Other'; byCat[c] = (byCat[c] || 0) + amt; }\n  const due = new Date(r.due_date);\n  if (!isNaN(due.getTime())) { const days = (due - now) / 86400000; if (days >= 0 && days <= 7) upcoming.push({ vendor: r.vendor, amount: amt, due: r.due_date }); }\n}\nconst catLines = Object.entries(byCat).map(([c, a]) => '<li>' + c + ': ' + (Math.round(a * 100) / 100) + '</li>').join('') || '<li>None</li>';\nconst dueLines = upcoming.map(u => '<li>' + u.vendor + ' — ' + u.amount + ' due ' + u.due + '</li>').join('') || '<li>None</li>';\nconst html = '<h2>Weekly AP Digest</h2><p><b>' + weekCount + '</b> invoices logged this week totaling <b>' + (Math.round(weekTotal * 100) / 100) + '</b>.</p><h3>By category</h3><ul>' + catLines + '</ul><h3>Due in the next 7 days</h3><ul>' + dueLines + '</ul>';\nreturn [{ json: { week_total: Math.round(weekTotal * 100) / 100, week_count: weekCount, html } }];"
      },
      "typeVersion": 2
    },
