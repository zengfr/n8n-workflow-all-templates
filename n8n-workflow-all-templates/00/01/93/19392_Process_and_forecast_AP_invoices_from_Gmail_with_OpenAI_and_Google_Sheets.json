    {
      "id": "9037ef2a-a158-4ba4-8aba-452110fc96ff",
      "name": "Calculate Cash Flow",
      "type": "n8n-nodes-base.code",
      "position": [
        1392,
        304
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst now = new Date();\nconst ym = now.toISOString().slice(0, 7);\nconst num = v => parseFloat(String(v ?? '').replace(/[^0-9.\\-]/g, '')) || 0;\nlet mtd = 0, count = 0, upcoming = 0;\nfor (const r of rows) {\n  const amt = num(r.total_amount);\n  if (String(r.invoice_date || '').slice(0, 7) === ym) { mtd += amt; count++; }\n  const due = new Date(r.due_date);\n  if (!isNaN(due.getTime())) { const days = (due - now) / 86400000; if (days >= 0 && days <= 30) upcoming += amt; }\n}\nreturn [{ json: { month: ym, mtd_total: Math.round(mtd * 100) / 100, mtd_count: count, upcoming_due_30d: Math.round(upcoming * 100) / 100 } }];"
      },
      "typeVersion": 2
    },
