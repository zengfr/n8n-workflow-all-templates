    {
      "id": "1c3877b1-ff7c-4f0c-89f8-5d978b7f422d",
      "name": "Build Actor Request",
      "type": "n8n-nodes-base.code",
      "position": [
        560,
        944
      ],
      "parameters": {
        "jsCode": "const c = $input.first().json;\n\nconst list = (value, sep) => String(value || \"\").split(sep || \",\").map(s => s.trim()).filter(Boolean);\n\nconst LOCATION_TYPES = [\"Remote\", \"Hybrid\", \"In-Person\"];\nconst COMPANY_SIZES = [\"1-10\", \"11-50\", \"51-200\", \"201-500\", \"501-1000\", \"1001-5000\", \"5+1234567890\", \"10000+\"];\n\nconst normalise = (value, allowed) => {\n  const wanted = String(value).toLowerCase().replace(/[\\s_-]+/g, \" \").trim();\n  return allowed.find(a => a.toLowerCase() === wanted) || null;\n};\n\nconst payload = {\n  postedWithinDays: 1,\n  hideRecruitingAgencies: true,\n  includeJobsWithoutSalary: true,\n  maxResults: Math.max(1, Number(c.maxResults) || 50)\n};\n\nconst jobTitles = list(c.jobTitles);\nif (jobTitles.length) payload.jobTitles = jobTitles;\n\nconst keywords = list(c.keywords);\nif (keywords.length) payload.keywords = keywords;\n\nconst industries = list(c.industries, \";\");\nif (industries.length) payload.industries = industries;\n\nconst companySizes = list(c.companySizes).map(v => normalise(v, COMPANY_SIZES)).filter(Boolean);\nif (companySizes.length) payload.companySizes = companySizes;\n\nconst locations = list(c.locations, \";\");\nif (locations.length) payload.locations = locations;\n\nconst locationTypes = list(c.locationTypes).map(v => normalise(v, LOCATION_TYPES)).filter(Boolean);\nif (locationTypes.length) payload.locationTypes = locationTypes;\n\nif (!payload.jobTitles && !payload.keywords) {\n  throw new Error(\"Open the Radar Settings node and fill in Job Titles or Keywords before running.\");\n}\n\nreturn [{ json: { payload } }];"
      },
      "typeVersion": 2
    },
