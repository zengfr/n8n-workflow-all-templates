    {
      "id": "4b5c0a68-c5ef-4704-b771-663b29da2f52",
      "name": "Build Radar Digest",
      "type": "n8n-nodes-base.code",
      "position": [
        2432,
        880
      ],
      "parameters": {
        "jsCode": "const leads = $input.all().map(i => i.json);\nconst today = $now.toFormat(\"cccc, LLLL d, yyyy\");\nconst count = leads.length;\nconst noun = count === 1 ? \"company\" : \"companies\";\n\nconst lines = leads.map(l => {\n  const head = \"\\u2022 *\" + l.companyName + \"* posted \" + l.roleCount + \" new role(s): \" + l.roleTitles;\n  const meta = [l.industry, l.companyType, l.locations].filter(Boolean).join(\" \\u00b7 \");\n  const site = l.companyWebsite ? (\"\\n   \" + l.companyWebsite) : \"\";\n  return head + (meta ? (\"\\n   \" + meta) : \"\") + site;\n});\n\nconst digest = \":satellite_antenna: *New Client Radar - \" + today + \"*\\n\"\n  + count + \" \" + noun + \" in your niche started hiring in the last 24 hours.\\n\"\n  + \"Full list with the drafted openers is in your Google Sheet.\\n\\n\"\n  + lines.join(\"\\n\\n\");\n\nreturn [{ json: { digest: digest, leadCount: count } }];"
      },
      "typeVersion": 2
    },
