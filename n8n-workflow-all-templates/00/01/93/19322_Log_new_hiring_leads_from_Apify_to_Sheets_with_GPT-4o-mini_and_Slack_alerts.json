    {
      "id": "d55303f7-6fa1-42cc-aafd-9d66963bdb03",
      "name": "Group Postings by Company",
      "type": "n8n-nodes-base.code",
      "position": [
        992,
        944
      ],
      "parameters": {
        "jsCode": "const byCompany = new Map();\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (!j.companyName) continue;\n\n  const key = j.companySlug || j.companyName;\n  if (!byCompany.has(key)) {\n    const cd = j.companyData || {};\n    byCompany.set(key, {\n      companyName: j.companyName,\n      companyWebsite: j.companyWebsite || \"\",\n      industry: Array.isArray(cd.industries) ? cd.industries.join(\", \") : \"\",\n      companyType: cd.type || \"\",\n      roles: [],\n      locations: [],\n      links: []\n    });\n  }\n\n  const c = byCompany.get(key);\n  if (j.jobTitle && c.roles.indexOf(j.jobTitle) === -1) c.roles.push(j.jobTitle);\n  if (j.location && c.locations.indexOf(j.location) === -1) c.locations.push(j.location);\n  const link = j.applicationLink || j.jobBoardLink;\n  if (link && c.links.length < 5) c.links.push(link);\n}\n\nconst results = [];\nfor (const c of byCompany.values()) {\n  results.push({\n    json: {\n      companyName: c.companyName,\n      companyWebsite: c.companyWebsite,\n      industry: c.industry,\n      companyType: c.companyType,\n      roleCount: c.roles.length,\n      roleTitles: c.roles.join(\", \"),\n      locations: c.locations.slice(0, 3).join(\" | \"),\n      jobLinks: c.links.join(\"\\n\")\n    }\n  });\n}\n\nresults.sort((a, b) => b.json.roleCount - a.json.roleCount);\nreturn results;"
      },
      "typeVersion": 2
    },
