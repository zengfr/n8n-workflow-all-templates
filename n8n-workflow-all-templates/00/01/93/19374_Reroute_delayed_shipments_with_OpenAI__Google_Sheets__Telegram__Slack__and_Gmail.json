    {
      "id": "74f72f9a-c9d1-4aa5-a643-5cc436c3f0a8",
      "name": "Parse AI Recommendation",
      "type": "n8n-nodes-base.code",
      "position": [
        3760,
        0
      ],
      "parameters": {
        "jsCode": "const shipment = $('Split Delayed Shipments').item.json;\nconst aiRaw = $input.first().json;\nconst raw = aiRaw.message?.content ?? aiRaw.content ?? aiRaw.text ?? '';\nconst cleaned = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet rec;\ntry {\n  rec = JSON.parse(cleaned);\n} catch (e) {\n  rec = { parse_error: true, raw_ai_output: raw, requires_approval: true, recommended_action: 'escalate' };\n}\n\nreturn [{ json: { ...shipment, ...rec } }];"
      },
      "typeVersion": 2
    },
