    {
      "id": "0234de75-2157-48c0-a99a-1186b32f6ed0",
      "name": "Detect Delays",
      "type": "n8n-nodes-base.code",
      "position": [
        2160,
        -512
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst delayed = items.filter(i => {\n  const promised = new Date(i.json['Promised Delivery']);\n  const eta = new Date(i.json['Current ETA']);\n  const isLate = eta > promised;\n  const flagged = String(i.json['Status']).toLowerCase() === 'delayed';\n  return isLate || flagged;\n}).map(i => {\n  const promised = new Date(i.json['Promised Delivery']);\n  const eta = new Date(i.json['Current ETA']);\n  const delayHours = Math.max(0, Math.round((eta - promised) / (1000 * 60 * 60)));\n  return { json: { ...i.json, delay_hours: delayHours } };\n});\n\nreturn delayed;"
      },
      "typeVersion": 2
    },
