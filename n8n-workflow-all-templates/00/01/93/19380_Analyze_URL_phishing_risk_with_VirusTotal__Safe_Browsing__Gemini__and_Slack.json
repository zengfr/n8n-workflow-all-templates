    {
      "id": "d0c7f829-ecdb-4e41-9302-f4dcbe41c8dd",
      "name": "Aggregate Risk Scores",
      "type": "n8n-nodes-base.code",
      "position": [
        3792,
        -144
      ],
      "parameters": {
        "jsCode": "// Single aggregation point - pulls all prior signals and scores risk 0-100\nconst normalize = $('Prepare URL Data').first().json;\nconst gsb = $('Post to Safe Browsing API').first().json;\nconst geo = $('Fetch IP and Location Info').first().json;\nconst rdap = $('Retrieve Domain Age').first().json;\nconst crtCerts = $('Combine crt.sh Results').first().json.certs || [];\nconst vt = $('Get VirusTotal Report').first().json;\n\nlet score = 0;\nconst flags = [];\n\nif (gsb && gsb.matches && gsb.matches.length > 0) {\n  score += 50;\n  flags.push('Flagged by Google Safe Browsing: ' + gsb.matches.map(m => m.threatType).join(', '));\n}\n\nconst vtStats = (vt && vt.data && vt.data.attributes && vt.data.attributes.stats) || {};\nconst malicious = vtStats.malicious || 0;\nconst suspicious = vtStats.suspicious || 0;\nif (malicious > 0) {\n  score += Math.min(40, malicious * 5);\n  flags.push(malicious + ' security vendors flagged this URL as malicious');\n}\nif (suspicious > 0) {\n  score += Math.min(15, suspicious * 3);\n  flags.push(suspicious + ' security vendors flagged this URL as suspicious');\n}\n\nlet domainAgeDays = null;\ntry {\n  const events = (rdap && rdap.events) || [];\n  const reg = events.find(e => e.eventAction === 'registration');\n  if (reg) {\n    domainAgeDays = Math.floor((Date.now() - new Date(reg.eventDate).getTime()) / 86400000);\n    if (domainAgeDays < 30) {\n      score += 20;\n      flags.push('Domain registered ' + domainAgeDays + ' days ago (very new)');\n    } else if (domainAgeDays < 180) {\n      score += 10;\n      flags.push('Domain registered ' + domainAgeDays + ' days ago (recently created)');\n    }\n  }\n} catch (e) {\n  flags.push('Domain age unavailable (RDAP lookup failed or unsupported TLD)');\n}\n\nconst certCount = crtCerts.length;\nif (certCount === 0) {\n  score += 5;\n  flags.push('No SSL certificate history found in Certificate Transparency logs');\n}\n\nconst hostingCountry = (geo && geo.country) || 'Unknown';\nconst hostingIsp = (geo && geo.isp) || 'Unknown';\n\nscore = Math.min(100, score);\nlet riskLevel = 'Low';\nif (score >= 60) riskLevel = 'High';\nelse if (score >= 25) riskLevel = 'Medium';\n\nreturn [{\n  json: {\n    submitted_url: normalize.submitted_url,\n    domain: normalize.domain,\n    scan_timestamp: normalize.scan_timestamp,\n    risk_score: score,\n    risk_level: riskLevel,\n    flags,\n    domain_age_days: domainAgeDays,\n    ssl_cert_count: certCount,\n    hosting_country: hostingCountry,\n    hosting_isp: hostingIsp,\n    vt_malicious_count: malicious,\n    vt_suspicious_count: suspicious,\n    gsb_flagged: !!(gsb && gsb.matches && gsb.matches.length > 0)\n  }\n}];"
      },
      "typeVersion": 2
    },
