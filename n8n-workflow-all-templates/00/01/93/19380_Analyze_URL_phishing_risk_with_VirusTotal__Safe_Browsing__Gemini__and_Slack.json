    {
      "id": "efcbf7d1-f2cd-4198-bbed-c5d3adabb27e",
      "name": "Combine crt.sh Results",
      "type": "n8n-nodes-base.code",
      "position": [
        2912,
        -144
      ],
      "parameters": {
        "jsCode": "return [{ json: { certs: $input.all().map(item => item.json) } }];"
      },
