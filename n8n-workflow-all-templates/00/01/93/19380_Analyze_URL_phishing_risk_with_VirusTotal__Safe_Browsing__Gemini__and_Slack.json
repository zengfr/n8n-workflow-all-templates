        1536,
        -320
      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 336,
        "content": "## Capture submitted URL\n\nStarts the workflow from a form submission and normalizes the submitted URL into reusable fields such as submitted_url, domain, and scan_timestamp."
      },
      "typeVersion": 1
    },
    {
      "id": "ddda55b8-ff1e-4952-a4e0-f96a340a50b1",
