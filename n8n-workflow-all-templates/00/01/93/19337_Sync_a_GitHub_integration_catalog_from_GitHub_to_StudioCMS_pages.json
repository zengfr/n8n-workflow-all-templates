      ],
      "parameters": {
        "jsCode": "const source = $('Decode Package Metadata').item.json;\nconst c = $('Configure Integration Catalog').first().json;\nconst repo = source.repo;\nconst pkg = source.package || {};\nconst release = $input.first().json || {};\nconst clean = v => String(v ?? '').trim();\nconst esc = v => clean(v).replace(/\\|/g, '\\\\|');\nconst slugify = v => clean(v).toLowerCase().replace(/^n8n-nodes-/, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\nconst findSection = (markdown, titlePattern) => {\n  const lines = clean(markdown).split(/\\r?\\n/);\n  const start = lines.findIndex(line => /^##\\s+/.test(line) && titlePattern.test(line.replace(/^##\\s+/, '').trim()));\n  if (start < 0) return '';\n  const out = [];\n  for (let i = start + 1; i < lines.length && !/^##\\s+/.test(lines[i]); i++) out.push(lines[i]);\n  return out.join('\\n').trim().slice(0, 5000);\n};\nconst operations = findSection(source.readme, /operations|supported resources|resources/i) || '_See the repository README for the current operation list._';\nconst compatibility = clean(pkg.engines?.n8n || pkg.n8n?.n8nNodesApiVersion || pkg.peerDependencies?.['n8n-workflow'] || 'See package metadata');\nconst packageName = clean(pkg.name || '@' + c.githubOwner.toLowerCase() + '/' + repo.name);\nconst version = clean(pkg.version || release.tag_name || 'Unreleased');\nconst description = clean(pkg.description || repo.description || 'n8n community integration maintained in GitHub.').slice(0, 300);\nconst releaseName = clean(release.name || release.tag_name || 'No GitHub release published');\nconst releaseDate = clean(release.published_at || release.created_at || '');\nconst releaseBody = clean(release.body).slice(0, 1800) || '_No release notes available._';\nconst npmUrl = 'https://www.npmjs.com/package/' + encodeURIComponent(packageName);\nconst githubUrl = clean(repo.html_url || ('https://github.com/' + c.githubOwner + '/' + repo.name));\nconst docsUrl = clean(pkg.homepage || githubUrl + '#readme');\nconst draft = Boolean(repo.archived || repo.disabled || !c.publishActiveRepositories);\nconst titleBase = clean(pkg.displayName || repo.name.replace(/^n8n-nodes-/, '').replace(/[-_]+/g, ' '));\nconst title = titleBase.replace(/\\b\\w/g, ch => ch.toUpperCase()) + ' for n8n';\nconst contentBody = [\n  c.ownershipMarker,\n  '# ' + title,\n  '', description, '',\n  '| Package | Current version | n8n compatibility | Status |',\n  '|---|---:|---|---|',\n  '| ' + esc(packageName) + ' | ' + esc(version) + ' | ' + esc(compatibility) + ' | ' + (repo.archived ? 'Archived' : 'Active') + ' |',\n  '', '## Supported resources and operations', '', operations,\n  '', '## Install', '', 'npm install ' + packageName,\n  '', '## Links', '',\n  '- [GitHub repository](' + githubUrl + ')',\n  '- [npm package](' + npmUrl + ')',\n  '- [Documentation](' + docsUrl + ')',\n  '', '## Latest release', '',\n  '**' + releaseName + '**' + (releaseDate ? ' — ' + releaseDate.slice(0, 10) : ''), '', releaseBody,\n  '', '_This page is maintained automatically from GitHub metadata. Last checked ' + new Date().toISOString() + '._'\n].join('\\n');\nlet hash = 2166136261;\nfor (const ch of contentBody.replace(/^_This page is maintained automatically.*$/m, '')) { hash ^= ch.charCodeAt(0); hash = Math.imul(hash, 16777619); }\nconst digest = (hash >>> 0).toString(16).padStart(8, '0');\nconst content = c.ownershipMarker + '\\n<!-- source-digest: ' + digest + ' -->\\n' + contentBody.replace(c.ownershipMarker + '\\n', '');\nreturn [{ json: { repoName: repo.name, slug: c.managedSlugPrefix + slugify(repo.name), title, description, content, digest, draft, packageName, version, githubUrl, warnings: source.warnings, archived: Boolean(repo.archived) } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "f4257b24-1a89-447a-8fc1-18b5a0d4c253",
      "name": "Plan Safe StudioCMS Upsert",
      "type": "n8n-nodes-base.code",
      "position": [
        5424,
        336
      ],
      "parameters": {
        "jsCode": "const desired = $input.first().json;\nconst c = $('Configure Integration Catalog').first().json;\nconst folder = $('Resolve Catalog Folder Context').first().json;\nconst pages = $('Fetch Existing StudioCMS Pages').all().map(i => i.json).filter(p => p.id && String(p.slug || '').toLowerCase() === String(desired.slug).toLowerCase());\nif (pages.length > 1) return [{ json: { ...desired, action: 'conflict', message: 'Multiple StudioCMS pages use this exact slug.', pageId: null, folderId: folder.folderId } }];\nif (!pages.length) return [{ json: { ...desired, action: c.previewOnly ? 'preview_create' : 'create', message: c.previewOnly ? 'Would create page.' : '', pageId: null, folderId: folder.folderId } }];\nconst existing = pages[0];\nconst currentContent = String(existing.defaultContent?.content ?? existing.content ?? '');\nif (!currentContent.includes(c.ownershipMarker)) return [{ json: { ...desired, action: 'conflict', message: 'Existing slug is not owned by this workflow; no overwrite attempted.', pageId: String(existing.id), folderId: folder.folderId } }];\nconst currentDigest = currentContent.match(/<!-- source-digest:\\s*([a-f0-9]+)\\s*-->/i)?.[1] || '';\nconst currentDraft = Boolean(Number(existing.draft ?? 0));\nconst currentFolder = String(existing.parentFolder?.id ?? existing.parentFolder ?? '');\nconst unchanged = currentDigest === desired.digest && currentDraft === desired.draft && String(existing.title || '') === desired.title && String(existing.description || '') === desired.description && (!folder.folderId || currentFolder === String(folder.folderId));\nreturn [{ json: { ...desired, action: unchanged ? 'skip' : (c.previewOnly ? 'preview_update' : 'update'), message: unchanged ? 'Already current.' : (c.previewOnly ? 'Would update page.' : ''), pageId: String(existing.id), folderId: folder.folderId } }];"
      },
      "typeVersion": 2
    },
