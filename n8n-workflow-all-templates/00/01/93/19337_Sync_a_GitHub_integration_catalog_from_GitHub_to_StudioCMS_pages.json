    {
      "id": "1cd61036-6295-4ccb-9cb6-e932e232d218",
      "name": "Select Managed Integration Repositories",
      "type": "n8n-nodes-base.code",
      "position": [
        2816,
        384
      ],
      "parameters": {
        "jsCode": "const c = $('Configure Integration Catalog').first().json;\nconst seen = new Set();\nconst repos = $input.all().map(i => i.json).filter(r => r.id && String(r.name || '').startsWith(c.repositoryPrefix) && (c.includeForks || !r.fork));\nrepos.sort((a,b) => String(a.name).localeCompare(String(b.name)));\nreturn repos.slice(0, c.maxRepositories).filter(r => { const k = String(r.full_name || r.name).toLowerCase(); if (seen.has(k)) return false; seen.add(k); return true; }).map(r => ({ json: { repo: r } }));"
      },
      "typeVersion": 2
    },
    {
      "id": "84cb0e93-338b-495a-83e6-672dcfdf750c",
      "name": "Compile Integration Catalog Report",
      "type": "n8n-nodes-base.code",
      "position": [
        6672,
        400
      ],
      "parameters": {
        "jsCode": "const c = $('Configure Integration Catalog').first().json;\nconst folder = $('Resolve Catalog Folder Context').first().json;\nconst results = $('Record Repository Outcome').isExecuted ? $('Record Repository Outcome').all().map(i => i.json) : [];\nconst count = outcome => results.filter(r => r.outcome === outcome).length;\nreturn [{ json: {\n  ok: count('error') === 0 && count('conflict') === 0,\n  previewOnly: c.previewOnly,\n  source: { githubOwner: c.githubOwner, repositoryPrefix: c.repositoryPrefix },\n  destination: { folderName: folder.folderName, folderId: folder.folderId || null, folderAction: folder.folderAction },\n  counts: { repositories: results.length, created: count('created'), updated: count('updated'), unchanged: count('unchanged'), wouldCreate: count('would_create'), wouldUpdate: count('would_update'), conflicts: count('conflict'), errors: count('error'), warnings: results.reduce((n,r) => n + (r.warnings?.length || 0), 0) },\n  results,\n  completedAt: new Date().toISOString()\n} }];"
      },
      "typeVersion": 2
    },
