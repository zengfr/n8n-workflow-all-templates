    {
      "id": "f956d4b1-749d-4265-a18b-b6b77f8e6e98",
      "name": "Plan Catalog Folder",
      "type": "n8n-nodes-base.code",
      "position": [
        1152,
        400
      ],
      "parameters": {
        "jsCode": "const c = $('Configure Integration Catalog').first().json;\nconst matches = $input.all().map(i => i.json).filter(f => f.id && String(f.name || '').trim().toLowerCase() === String(c.catalogFolderName).trim().toLowerCase());\nif (matches.length > 1) throw new Error('More than one StudioCMS folder exactly matches ' + c.catalogFolderName + '. Rename duplicates before running.');\nif (matches.length === 1) return [{ json: { folderAction: 'existing', folderId: String(matches[0].id), folderName: c.catalogFolderName } }];\nreturn [{ json: { folderAction: c.previewOnly ? 'preview' : 'create', folderId: '', folderName: c.catalogFolderName } }];"
      },
      "typeVersion": 2
    },
