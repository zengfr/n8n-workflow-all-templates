        "jsCode": "const repo = $('Process Repositories Sequentially').item.json.repo;\nconst raw = $input.first().json;\nlet readme = '';\ntry { if (raw.content) readme = Buffer.from(String(raw.content).replace(/\\s/g, ''), 'base64').toString('utf8'); } catch {}\nreturn [{ json: { repo, readme, warnings: readme ? [] : ['README.md could not be read'] } }];"
