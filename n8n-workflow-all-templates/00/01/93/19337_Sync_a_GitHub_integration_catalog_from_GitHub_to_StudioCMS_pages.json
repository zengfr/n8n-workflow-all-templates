        "jsCode": "const prior = $('Decode README Content').item.json;\nconst raw = $input.first().json;\nlet pkg = {};\nconst warnings = [...prior.warnings];\ntry { if (raw.content) pkg = JSON.parse(Buffer.from(String(raw.content).replace(/\\s/g, ''), 'base64').toString('utf8')); else warnings.push('package.json could not be read'); }\ncatch { warnings.push('package.json is not valid JSON'); }\nreturn [{ json: { ...prior, package: pkg, warnings } }];"
