    {
      "id": "f7396ae3-587b-4af8-b8df-8476b8254f99",
      "name": "Configure Integration Catalog",
      "type": "n8n-nodes-base.code",
      "position": [
        304,
        400
      ],
      "parameters": {
        "jsCode": "return [{ json: {\n  githubOwner: 'BlackSwampAI',\n  repositoryPrefix: 'n8n-nodes-',\n  catalogFolderName: 'Integrations',\n  managedSlugPrefix: 'integration-',\n  previewOnly: true,\n  publishActiveRepositories: true,\n  includeForks: false,\n  maxRepositories: 100,\n  ownershipMarker: '<!-- managed-by: github-studiocms-integration-catalog -->'\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "4366d155-c6af-4f69-8ff9-3abdd8b23ce7",
      "name": "Run Daily at 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        480
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 6
            }
          ]
        }
      },
      "typeVersion": 1.4
    },
    {
      "id": "733301d5-a0c8-40b0-99f1-d12902665a87",
      "name": "Validate Catalog Settings",
      "type": "n8n-nodes-base.code",
      "position": [
        544,
        400
      ],
      "parameters": {
        "jsCode": "const c = $input.first().json;\nconst errors = [];\nif (!String(c.githubOwner || '').trim()) errors.push('githubOwner is required');\nif (!String(c.repositoryPrefix || '').trim()) errors.push('repositoryPrefix is required');\nif (!String(c.catalogFolderName || '').trim()) errors.push('catalogFolderName is required');\nif (!String(c.managedSlugPrefix || '').trim()) errors.push('managedSlugPrefix is required');\nif (!String(c.ownershipMarker || '').includes('managed-by:')) errors.push('ownershipMarker must identify this workflow');\nif (!Number.isInteger(c.maxRepositories) || c.maxRepositories < 1 || c.maxRepositories > 500) errors.push('maxRepositories must be an integer from 1 to 500');\nif (errors.length) throw new Error(errors.join('; '));\nreturn [{ json: c }];"
      },
      "typeVersion": 2
    },
