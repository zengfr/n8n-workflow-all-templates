    {
      "id": "edccdef1-8840-44eb-a801-92d081047809",
      "name": "Clean Transcript Text",
      "type": "n8n-nodes-base.code",
      "position": [
        1648,
        768
      ],
      "parameters": {
        "jsCode": "const transcript = $json.transcript;\n\n// remove HTML entities like &#39;\nconst clean = transcript\n  .replace(/&#39;/g, \"'\")\n  .replace(/\\[♪.*?♪\\]/g, \"\")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\nreturn [{\n  transcript: clean\n}];"
      },
      "typeVersion": 2
    },
