    {
      "id": "8d3a319b-99ab-4cf4-a2fb-712141d96934",
      "name": "Parse AI Analysis Response",
      "type": "n8n-nodes-base.code",
      "position": [
        2432,
        864
      ],
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  const rawText = item.json.output[0].content[0].text;\n\n  const cleanedText = rawText\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  return {\n    json: JSON.parse(cleanedText)\n  };\n\n});"
      },
      "typeVersion": 2
    },
