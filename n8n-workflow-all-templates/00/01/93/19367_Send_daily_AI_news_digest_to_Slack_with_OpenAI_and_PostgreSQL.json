    {
      "id": "066c262b-a652-4aec-9bca-0767cc277c69",
      "name": "Prepare Daily Digest Payload",
      "type": "n8n-nodes-base.code",
      "position": [
        4208,
        976
      ],
      "parameters": {
        "jsCode": "const sourceItems = $('Merge Article & AI Insights').all();\n\nconst keywordCount = {};\n\nconst articles = sourceItems.map(item => {\n\n  const keywords = item.json.trend_keywords || [];\n\n  keywords.forEach(keyword => {\n\n    const normalized = keyword.toLowerCase();\n\n    keywordCount[normalized] =\n      (keywordCount[normalized] || 0) + 1;\n\n  });\n\n  return {\n    headline: item.json.headline,\n    summary: item.json.summary,\n    category: item.json.category,\n    importance_score: item.json.importance_score,\n    sentiment: item.json.sentiment,\n    source: item.json.source\n  };\n\n});\n\nconst topTrends = Object.entries(keywordCount)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 10)\n  .map(([keyword, count]) => ({\n    keyword,\n    count\n  }));\n\nreturn [\n  {\n    json: {\n      total_articles: articles.length,\n      top_trends: topTrends,\n      articles: articles\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
    {
      "id": "1dc2d74c-2d80-4a43-9fca-4fb0596e3690",
      "name": "Generate Executive AI Digest",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        4624,
        976
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {},
        "responses": {
          "values": [
            {
              "content": "=You are a senior AI news analyst.\n\nYour task is to generate a Daily AI News Digest STRICTLY using the provided JSON data.\n\nIMPORTANT RULES:\n- Use ONLY the articles and trends from the provided data.\n- Do NOT invent headlines, companies, trends, industries, or news.\n- Do NOT mention healthcare, regulations, startups, or technologies unless explicitly present in the data.\n- Base every insight only on the provided articles.\n\nGenerate the digest in this format:\n\n# Daily AI News Digest\n\n## Executive Summary\nSummarize today's AI developments in 2-3 sentences.\n\n## Top Trends\nMention the most repeated and important trends from the data.\n\n## Important Headlines\nProvide bullet points summarizing the provided articles.\n\n## Business & Industry Impact\nExplain the potential impact of these developments.\n\n## Key Takeaways\nProvide short concluding insights.\n\nDATA:\n{{ JSON.stringify($json, null, 2) }}"
            }
          ]
        },
        "builtInTools": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "yOfw9W9XwQefVROR",
          "name": "OpenAI (PAID) (AI-ML Team)"
        }
      },
      "typeVersion": 2.1
    },
