            {
              "content": "=You are an AI news analyst.\n\nAnalyze the following article and return ONLY valid JSON.\n\nArticle Details:\n\nTitle:\n{{$json.title}}\n\nDescription:\n{{$json.description}}\n\nContent:\n{{$json.content}}\n\nSource:\n{{$json.source}}\n\nReturn this JSON format:\n\n{\n  \"summary\": \"\",\n  \"category\": \"\",\n  \"importance_score\": 1,\n  \"trend_keywords\": [],\n  \"sentiment\": \"\",\n  \"why_it_matters\": \"\",\n  \"headline\": \"\"\n}"
            }
