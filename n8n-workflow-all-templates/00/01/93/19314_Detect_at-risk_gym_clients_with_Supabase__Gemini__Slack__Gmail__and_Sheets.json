    {
      "id": "e07bd523-ee84-4dc1-b788-2597e607417d",
      "name": "Generate Re Engagement Draft with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [
        2352,
        320
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": "=You are a gym retention assistant.\n\nWrite a short and supportive re engagement email for a gym client who has missed recent check ins or weekly form submissions.\n\nRules:\nKeep it warm, personal, and non judgmental\nKeep it under 120 words\nMention the coach name\nEncourage the client to reply\nDo not sound salesy\nDo not use emojis\nReturn output in valid JSON only with keys subject and body\n\nClient context:\n{{ $json.client_context_summary }}"
            }
          ]
        },
        "builtInTools": {}
      },
      "credentials": {
        "googlePalmApi": {
          "id": "YjMToIWaaQ2guKzB",
          "name": "Gemini (PAID) (AI-ML Team)"
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "0143db8b-abf6-469a-bae8-38af34c65326",
      "name": "Parse Draft Response",
      "type": "n8n-nodes-base.code",
      "position": [
        2704,
        320
      ],
      "parameters": {
        "jsCode": "const sourceItems = $('Check Duplicate Alert Window').all();\n\nreturn items.map((item, index) => {\n  try {\n    // Get matching client data from previous node\n    const clientData = sourceItems[index]?.json || {};\n\n    // Get Gemini raw response\n    let rawText = item.json.content.parts[0].text;\n\n    // Remove markdown fences\n    rawText = rawText\n      .replace(/```json/g, '')\n      .replace(/```/g, '')\n      .trim();\n\n    // Parse AI JSON\n    const parsed = JSON.parse(rawText);\n\n    // Safe subject/body\n    const subject =\n      parsed.subject ||\n      'Quick check in from your coach';\n\n    const body =\n      parsed.body ||\n      'Hi there, just checking in. We noticed your recent updates slowed down and wanted to help you get back on track.';\n\n    // Slack message\n    const slack_message =\n      'Client at risk detected\\n' +\n      'Client: ' + (clientData.full_name || 'Unknown') + '\\n' +\n      'Reason: ' + (clientData.risk_reason || 'N/A') + '\\n' +\n      'Risk score: ' + (clientData.risk_score || 'N/A') + '\\n' +\n      'Escalation: ' + (clientData.escalation_level || '0') + '\\n' +\n      'Coach: ' + (clientData.coach_name || 'N/A') + '\\n' +\n      'Plan: ' + (clientData.plan_type || 'N/A') + '\\n' +\n      'Email subject: ' + subject + '\\n' +\n      'Email preview: ' + body.slice(0, 180);\n\n    return {\n      json: {\n        // Client data\n        ...clientData,\n        // AI output\n        subject,\n        body,\n\n        // Slack message\n        slack_message\n      }\n    };\n\n  } catch (error) {\n\n    const clientData = sourceItems[index]?.json || {};\n\n    return {\n      json: {\n        subject: 'Quick check in from your coach',\n        body: 'Hi there, just checking in. We noticed your recent updates slowed down and wanted to help you get back on track.',\n        slack_message:\n          'Client at risk detected\\n' +\n          'Client: ' + (clientData.full_name || 'Unknown') + '\\n' +\n          'Parse error: ' + error.message,\n        parse_error: error.message\n      }\n    };\n  }\n});"
      },
      "typeVersion": 2
    },
