    {
      "id": "8c692da0-0a05-451c-ad59-737481dc4fb2",
      "name": "Calculate Client Risk Metrics",
      "type": "n8n-nodes-base.code",
      "position": [
        1168,
        352
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst now = new Date();\nconst nowMs = now.getTime();\nconst threeDaysMs = 3 * 24 * 60 * 60 * 1000;\n\nfunction toDate(value) {\n  if (!value) return null;\n  const d = new Date(value);\n  return isNaN(d.getTime()) ? null : d;\n}\n\nfunction diffDays(dateValue) {\n  const d = toDate(dateValue);\n  if (!d) return null;\n  return Math.floor((nowMs - d.getTime()) / (24 * 60 * 60 * 1000));\n}\n\nfunction isoPlusDays(dateValue, days) {\n  const d = toDate(dateValue) || new Date();\n  d.setDate(d.getDate() + days);\n  return d.toISOString();\n}\n\nfunction startOfWeekMonday(date) {\n  const d = new Date(date);\n  const day = d.getDay();\n  const diff = day === 0 ? -6 : 1 - day;\n  d.setHours(0, 0, 0, 0);\n  d.setDate(d.getDate() + diff);\n  return d;\n}\n\nconst weekStart = startOfWeekMonday(now);\n\nconst grouped = {};\n\nfor (const item of items) {\n  const row = item.json;\n  const clientId = row.client_id;\n  if (!clientId) continue;\n\n  if (!grouped[clientId]) {\n    grouped[clientId] = {\n      client: null,\n      checkins: [],\n      forms: []\n    };\n  }\n\n  if (row.full_name && row.email && row.coach_name && row.slack_channel_id) {\n    grouped[clientId].client = row;\n  } else if (row.checkin_id) {\n    grouped[clientId].checkins.push(row);\n  } else if (row.form_id) {\n    grouped[clientId].forms.push(row);\n  }\n}\n\nconst output = [];\n\nfor (const clientId of Object.keys(grouped)) {\n  const bundle = grouped[clientId];\n  const client = bundle.client;\n\n  if (!client) continue;\n\n  const checkins = bundle.checkins.sort((a, b) => {\n    return new Date(b.checkin_date).getTime() - new Date(a.checkin_date).getTime();\n  });\n\n  const forms = bundle.forms.sort((a, b) => {\n    return new Date(b.submitted_at).getTime() - new Date(a.submitted_at).getTime();\n  });\n\n  const latestCheckin = checkins[0] || null;\n  const latestForm = forms[0] || null;\n\n  const daysSinceLastCheckin = latestCheckin ? diffDays(latestCheckin.checkin_date) : 999;\n  const daysSinceLastForm = latestForm ? diffDays(latestForm.submitted_at) : 999;\n\n  const weeklyCheckinCount = checkins.filter(c => {\n    const cDate = toDate(c.checkin_date);\n    return cDate && cDate >= weekStart;\n  }).length;\n\n  const expectedCheckins = Number(client.expected_checkins_per_week || 3);\n  const expectedForms = Number(client.expected_forms_per_week || 1);\n\n  const missedCheckins = Math.max(expectedCheckins - weeklyCheckinCount, 0);\n  const missedForms = daysSinceLastForm >= 8 ? expectedForms : 0;\n\n  let riskScore = 0;\n  const reasons = [];\n\n  if (daysSinceLastCheckin >= 4) {\n    riskScore += 50;\n    reasons.push(`No check in for ${daysSinceLastCheckin} days`);\n  }\n\n  if (daysSinceLastForm >= 8) {\n    riskScore += 40;\n    reasons.push(`No weekly form for ${daysSinceLastForm} days`);\n  }\n\n  if (weeklyCheckinCount < 2) {\n    riskScore += 20;\n    reasons.push(`Only ${weeklyCheckinCount} check in this week`);\n  }\n\n  if (latestForm && Number(latestForm.stress_level || 0) >= 4) {\n    riskScore += 10;\n    reasons.push(`High stress reported: ${latestForm.stress_level}`);\n  }\n\n  let riskType = 'normal';\n  if (riskScore >= 70) {\n    riskType = 'high';\n  } else if (riskScore >= 50) {\n    riskType = 'medium';\n  } else if (riskScore > 0) {\n    riskType = 'low';\n  }\n\n  const lastAlertDate = toDate(client.last_alert_sent_at);\n  const alertAllowedNow = !lastAlertDate || (nowMs - lastAlertDate.getTime()) >= threeDaysMs;\n\n  let escalationLevel = Number(client.escalation_level || 0);\n  if (riskScore >= 50 && lastAlertDate && alertAllowedNow) {\n    escalationLevel += 1;\n  }\n\n  const nextEligibleAlertAt = lastAlertDate\n    ? isoPlusDays(lastAlertDate, 3)\n    : now.toISOString();\n\n  output.push({\n    json: {\n      client_id: client.client_id,\n      full_name: client.full_name,\n      client_email: client.email,\n      phone: client.phone,\n      coach_name: client.coach_name,\n      coach_email: client.coach_email,\n      slack_channel_id: client.slack_channel_id,\n      plan_type: client.plan_type,\n      status: client.status,\n      notes: client.notes,\n\n      latest_checkin_date: latestCheckin ? latestCheckin.checkin_date : null,\n      latest_form_submitted_at: latestForm ? latestForm.submitted_at : null,\n\n      days_since_last_checkin: daysSinceLastCheckin,\n      days_since_last_form: daysSinceLastForm,\n      weekly_checkin_count: weeklyCheckinCount,\n      expected_checkins_per_week: expectedCheckins,\n      expected_forms_per_week: expectedForms,\n      missed_checkins: missedCheckins,\n      missed_forms: missedForms,\n\n      risk_score: riskScore,\n      risk_type: riskType,\n      risk_reason: reasons.length ? reasons.join(', ') : 'No risk detected',\n\n      risk_status: client.risk_status,\n      last_alert_sent_at: client.last_alert_sent_at,\n      last_message_sent_at: client.last_message_sent_at,\n      escalation_level: escalationLevel,\n      alert_allowed_now: alertAllowedNow,\n      next_eligible_alert_at: nextEligibleAlertAt,\n      detected_at: now.toISOString()\n    }\n  });\n}\n\nreturn output;"
      },
      "typeVersion": 2
    },
