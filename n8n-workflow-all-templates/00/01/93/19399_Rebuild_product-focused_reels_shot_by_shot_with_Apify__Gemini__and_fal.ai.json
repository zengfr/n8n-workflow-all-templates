    {
      "id": "extract-scene-prompts",
      "name": "Extract Scene Prompts",
      "type": "n8n-nodes-base.code",
      "position": [
        2064,
        -112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Set Source Reel And Target Product').first().json;\nconst timings = $('Split Detected Scenes').all().map(i => i.json);\nconst analysed = JSON.parse($json.candidates[0].content.parts[0].text).scenes;\nreturn timings.map((t, i) => {\n  const a = analysed[i] || {};\n  return { json: {\n    scene_index: t.index,\n    scene_number: t.index + 1,\n    start_seconds: t.startSeconds,\n    end_seconds: t.endSeconds,\n    duration_seconds: t.durationSeconds,\n    duration_ms: Math.round(t.durationSeconds * 1000),\n    clip_seconds: t.durationSeconds > 5 ? '10' : '5',\n    shot_size: a.shot_size,\n    camera_angle: a.camera_angle,\n    camera_movement: a.camera_movement,\n    composition: a.composition,\n    image_prompt: a.image_prompt,\n    motion_prompt: a.motion_prompt,\n    target_product: cfg.target_product,\n    clip_aspect_ratio: cfg.clip_aspect_ratio\n  } };\n});"
