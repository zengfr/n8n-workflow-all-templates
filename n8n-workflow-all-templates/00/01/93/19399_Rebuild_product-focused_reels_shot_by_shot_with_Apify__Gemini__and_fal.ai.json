    {
      "id": "construct-scene-timeline",
      "name": "Construct Scene Timeline",
      "type": "n8n-nodes-base.code",
      "position": [
        2288,
        -336
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Rebuild the timeline in the SOURCE order, trimming every generated clip\n// back to the exact duration of the scene it replaces. This is what keeps\n// the output's shot count and pacing identical to the source reel.\nconst plan = $('Extract Scene Prompts').all().map(i => i.json);\nconst clips = $('Fetch Scene Clip').all().map(i => i.json);\nlet cursor = 0;\nconst keyframes = plan.map((scene, i) => {\n  const clip = clips[i];\n  const frame = {\n    timestamp: cursor,\n    duration: scene.duration_ms,\n    url: clip.video ? clip.video.url : clip.url\n  };\n  cursor += scene.duration_ms;\n  return frame;\n});\nreturn [{ json: { tracks: [{ id: 'reconstructed_scenes', type: 'video', keyframes }],\n  scene_count: plan.length, total_ms: cursor } }];"
      },
      "typeVersion": 2
    },
