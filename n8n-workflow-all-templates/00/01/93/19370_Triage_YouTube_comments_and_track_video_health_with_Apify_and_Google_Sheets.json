    {
      "id": "b79da2bb-7ad0-42fa-b217-df772b398ca5",
      "name": "Count run outcomes",
      "type": "n8n-nodes-base.code",
      "position": [
        2288,
        720
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nlet failedFetches = 0, highEngagement = 0, questions = 0, newlyFailing = 0, newlyHealthy = 0;\nfor (const item of items) {\n  const j = item.json;\n  if (j.outcome === 'failing') { newlyFailing++; continue; }\n  if (j.outcome === 'healthy') { newlyHealthy++; continue; }\n  if (j.success === false) { failedFetches++; continue; }\n  if (typeof j.likeCount === 'number' && j.likeCount >= 10) { highEngagement++; continue; }\n  questions++;\n}\nreturn [{ json: {\n  run_at: new Date().toISOString(),\n  failed_fetches: failedFetches,\n  high_engagement_comments: highEngagement,\n  question_comments: questions,\n  videos_now_failing: newlyFailing,\n  videos_recovered: newlyHealthy,\n} }];"
      },
      "typeVersion": 2
    },
