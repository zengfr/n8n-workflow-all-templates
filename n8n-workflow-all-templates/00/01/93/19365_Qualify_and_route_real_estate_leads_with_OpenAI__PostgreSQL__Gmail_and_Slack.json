    {
      "id": "d19ccaa7-90d9-4602-b196-591d130c26d4",
      "name": "AI Lead Qualification",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1504,
        448
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {},
        "responses": {
          "values": [
            {
              "content": "=You are an expert real estate lead qualification AI.\n\nAnalyze this lead and return JSON only.\n\nLead:\nName: {{$json.name}}\nBudget: {{$json.budget}}\nLocation: {{$json.location}}\nMessage: {{$json.message}}\n\nReturn:\n{\n  \"lead_score\": number,\n  \"lead_type\": \"HOT/WARM/COLD\",\n  \"reasoning\": \"\"\n}\n\nRules:\n- Budget > 80 lakh = HOT\n- Urgent message = HOT\n- Low detail = COLD"
            }
          ]
        },
        "builtInTools": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "yOfw9W9XwQefVROR",
          "name": "OpenAI (PAID) (AI-ML Team)"
        }
      },
      "typeVersion": 2.1
    },
    {
      "id": "d0255aac-57fe-4e31-a0f6-4719684463c2",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "position": [
        1840,
        448
      ],
      "parameters": {
        "jsCode": "const rawText = $json.output[0].content[0].text;\n\nconst cleaned = rawText\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst parsed = JSON.parse(cleaned);\n\nreturn [\n  {\n    json: parsed\n  }\n];"
      },
      "typeVersion": 2
    },
