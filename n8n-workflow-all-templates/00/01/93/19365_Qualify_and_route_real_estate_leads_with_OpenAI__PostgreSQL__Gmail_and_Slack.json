      "id": "6dd7a399-05dc-48a7-a2ac-1a83269491ef",
      "name": "Assign Sales Agent",
      "type": "n8n-nodes-base.code",
      "position": [
        2384,
        576
      ],
      "parameters": {
        "jsCode": "let assigned_agent = \"General Team\";\n\nif ($json.location === \"Ahmedabad\") {\n  assigned_agent = \"Agent A\";\n} else if ($json.location === \"Mumbai\") {\n  assigned_agent = \"Agent B\";\n}\n\nreturn [{\n  json: {\n    ...$json,\n    assigned_agent\n  }\n}];"
      },
      "typeVersion": 2
