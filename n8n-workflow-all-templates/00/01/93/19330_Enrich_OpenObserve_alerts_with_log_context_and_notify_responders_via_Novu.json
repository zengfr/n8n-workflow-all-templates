    {
      "id": "f414e879-206f-4822-8916-8dd9311a9435",
      "name": "Find Closest Log Anchor",
      "type": "n8n-nodes-base.code",
      "position": [
        3552,
        1360
      ],
      "parameters": {
        "jsCode": "const a=$('Prepare Log Search Query').first().json;\nconst rows=$input.all().map(i=>i.json).filter(r=>r&&Object.keys(r).length&&r._timestamp!==undefined);\nconst toMs=v=>{const n=Number(v);if(Number.isFinite(n)) return n>1e15?n/1000:n>1e12?n:n*1000;const d=Date.parse(String(v));return Number.isFinite(d)?d:null;};\nrows.sort((x,y)=>Math.abs((toMs(x._timestamp)??0)-a.triggered_ms)-Math.abs((toMs(y._timestamp)??0)-a.triggered_ms));\nreturn [{json:{...a,query_hit_count:rows.length,has_anchor:rows.length>0,anchor_record:rows[0]||null,query_rows:rows.slice(0,a.query_limit)}}];"
