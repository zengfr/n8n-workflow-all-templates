    {
      "id": "090ff6c8-7295-46f4-9b06-f02347e13eea",
      "name": "Compile Incident Brief",
      "type": "n8n-nodes-base.code",
      "position": [
        4416,
        1376
      ],
      "parameters": {
        "jsCode": "const a=$('Find Closest Log Anchor').first().json;\nconst source=$input.all().map(i=>i.json).filter(r=>r&&Object.keys(r).length);\nconst rows=a.has_anchor?source:a.query_rows;\nconst blocked=/pass(word)?|secret|token|authorization|cookie|api[-_]?key|credential/i;\nconst clean=(v,depth=0)=>{if(depth>3)return '[depth limited]';if(Array.isArray(v))return v.slice(0,20).map(x=>clean(x,depth+1));if(v&&typeof v==='object'){const o={};for(const [k,x] of Object.entries(v).slice(0,40))o[k]=blocked.test(k)?'[redacted]':clean(x,depth+1);return o;}if(typeof v==='string')return v.length>500?v.slice(0,500)+'…':v;return v;};\nconst evidence=rows.slice(0,20).map(r=>clean(r));\nconst summary=a.alert_name+' on '+(a.service||'the configured log stream')+' produced '+evidence.length+' nearby log record'+(evidence.length===1?'':'s')+'.';\nconst title='['+a.severity.toUpperCase()+'] '+a.alert_name+(a.service?' — '+a.service:'');\nconst base=String(a.openobserve_url||'').replace(/\\/$/,'');\nconst hash=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619);}return (h>>>0).toString(36);};\nconst bucket=Math.floor(a.triggered_ms/(a.cooldown_minutes*60000));\nreturn [{json:{...a,title,summary,evidence_count:evidence.length,evidence,openobserve_url:base||null,notification_key:'oo-'+hash(a.incident_key)+'-'+bucket+'-'+a.severity_rank,novu_payload:{title,summary,severity:a.severity,service:a.service,alert_name:a.alert_name,triggered_at:a.triggered_at,evidence_count:evidence.length,evidence,openobserve_url:base||null}}}];"
      },
      "typeVersion": 2
    },
