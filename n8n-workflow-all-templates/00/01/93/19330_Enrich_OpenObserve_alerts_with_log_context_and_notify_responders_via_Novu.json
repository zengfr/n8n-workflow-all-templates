    {
      "id": "dd0e21be-0c7d-4ccc-8ff3-b89c6e34d5ee",
      "name": "Normalize Alert Data",
      "type": "n8n-nodes-base.code",
      "position": [
        2720,
        1360
      ],
      "parameters": {
        "jsCode": "const raw=$('OpenObserve Alert Trigger').first().json;\nconst cfg=$input.first().json;\nconst body=raw&&typeof raw.body==='object'&&raw.body!==null?raw.body:raw;\nconst alert=body.alert&&typeof body.alert==='object'?body.alert:body;\nconst labels=alert.labels&&typeof alert.labels==='object'?alert.labels:{};\nconst pick=(...v)=>v.find(x=>x!==undefined&&x!==null&&String(x).trim()!=='');\nconst alertId=String(pick(alert.alert_id,alert.alertId,alert.id,body.alert_id,body.alertId,'')||'').trim();\nconst alertName=String(pick(alert.alert_name,alert.alertName,alert.name,body.alert_name,body.alertName,'')||'').trim();\nif(!alertId&&!alertName) throw new Error('OpenObserve payload has no alert ID or name.');\nconst service=String(pick(alert.service,alert.service_name,labels.service,labels.service_name,labels.job,cfg.default_service,'')||'').trim();\nif(service.length>200) throw new Error('Service identity exceeds 200 characters.');\nconst sev=String(pick(alert.severity,labels.severity,body.severity,'warning')).toLowerCase();\nconst severity=['critical','error','warning','info'].includes(sev)?sev:sev==='high'?'critical':sev==='medium'?'warning':sev==='low'?'info':'warning';\nconst rawTime=pick(alert.triggered_at,alert.triggeredAt,alert.timestamp,body.triggered_at,body.triggeredAt,body.timestamp,body.eventDate,Date.now());\nlet ms;\nif(typeof rawTime==='number'){ms=rawTime>1e15?rawTime/1000:rawTime>1e12?rawTime:rawTime*1000;}else{ms=Date.parse(String(rawTime));}\nif(!Number.isFinite(ms)||Math.abs(Date.now()-ms)>365*24*3600*1000) throw new Error('Alert timestamp is invalid or outside the one-year safety bound.');\nconst incidentKey=(alertId||alertName)+'|'+(service||'all-services');\nreturn [{json:{...cfg,alert_id:alertId||null,alert_name:alertName||alertId,service:service||null,severity,severity_rank:{info:1,warning:2,error:3,critical:4}[severity],triggered_at:new Date(ms).toISOString(),triggered_ms:ms,incident_key:incidentKey,raw_alert:alert}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "51b00100-3d9e-4c09-8203-1c53672a7344",
      "name": "Prepare Log Search Query",
      "type": "n8n-nodes-base.code",
      "position": [
        3008,
        1360
      ],
      "parameters": {
        "jsCode": "const a=$input.first().json;\nfor(const k of ['search_window_minutes','query_limit','search_around_limit','cooldown_minutes']) if(!Number.isInteger(a[k])||a[k]<1) throw new Error('Invalid positive integer setting: '+k);\nif(a.search_window_minutes>60||a.query_limit>100||a.search_around_limit>100||a.cooldown_minutes>1440) throw new Error('Search or cooldown setting exceeds documented safety limits.');\nif(!/^[A-Za-z_][A-Za-z0-9_]{0,127}$/.test(a.log_stream)||!/^[A-Za-z_][A-Za-z0-9_]{0,127}$/.test(a.service_field)) throw new Error('Stream and service field must be safe identifiers.');\nconst quote=s=>String(s).replace(/'/g,\"''\");\nconst where=a.service?' WHERE \"'+a.service_field+'\" = \\''+quote(a.service)+'\\'':'';\nconst sql='SELECT * FROM \"'+a.log_stream+'\"'+where+' ORDER BY _timestamp DESC';\nreturn [{json:{...a,search_start:new Date(a.triggered_ms-a.search_window_minutes*60000).toISOString(),search_end:new Date(a.triggered_ms+a.search_window_minutes*60000).toISOString(),search_sql:sql}}];"
      },
      "typeVersion": 2
    },
