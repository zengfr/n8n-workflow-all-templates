      "position": [
        4960,
        1376
      ],
      "parameters": {
        "jsCode": "const b=$('Compile Incident Brief').first().json;\nconst rows=$input.all().map(i=>i.json).filter(r=>r&&Object.keys(r).length);\nif(rows.length>1) throw new Error('Multiple cooldown rows share this incident key.');\nconst previous=rows[0]||null;\nconst last=previous?Date.parse(previous.last_notified_at):NaN;\nconst expired=!Number.isFinite(last)||b.triggered_ms-last>=b.cooldown_minutes*60000;\nconst escalated=previous&&b.severity_rank>Number(previous.severity_rank||0);\nreturn [{json:{...b,previous_notification:previous,should_notify:!previous||expired||escalated,suppression_reason:previous&&!expired&&!escalated?'cooldown_active':null}}];"
