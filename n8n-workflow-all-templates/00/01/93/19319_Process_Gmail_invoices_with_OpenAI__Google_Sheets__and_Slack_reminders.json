    {
      "id": "bee69122-4deb-4529-97d4-4c116e938cf9",
      "name": "Calculate Remaining Due Days",
      "type": "n8n-nodes-base.code",
      "position": [
        752,
        720
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst today = new Date();\n\nfor (const item of items) {\n\n  const dueDate = new Date(item.json.due_date);\n\n  const diffTime = dueDate - today;\n\n  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n\n  item.json.days_remaining = diffDays;\n\n}\n\nreturn items;"
      },
      "typeVersion": 2
    },
    {
      "id": "56a30696-a5ae-4b10-8dbf-d3b2ad487f20",
      "name": "Generate Reminder Priority & Status",
      "type": "n8n-nodes-base.code",
      "position": [
        944,
        720
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n\n  const days = item.json.days_remaining;\n\n  let reminder_type = \"\";\n  let priority = \"\";\n\n  if (days < 0) {\n    reminder_type = \"OVERDUE ESCALATION\";\n    priority = \"HIGH\";\n    item.json.status = \"OVERDUE\";\n  }\n\n  else if (days <= 1) {\n    reminder_type = \"URGENT REMINDER\";\n    priority = \"HIGH\";\n  }\n\n  else if (days <= 3) {\n    reminder_type = \"IMPORTANT REMINDER\";\n    priority = \"MEDIUM\";\n  }\n\n  else if (days <= 7) {\n    reminder_type = \"GENTLE REMINDER\";\n    priority = \"LOW\";\n  }\n\n  else {\n    reminder_type = \"NO ACTION\";\n    priority = \"NONE\";\n  }\n\n  item.json.reminder_type = reminder_type;\n  item.json.priority = priority;\n\n}\n\nreturn items;"
      },
      "typeVersion": 2
    },
