    {
      "id": "6a58953d-94d5-4512-9320-ee19f84b0f74",
      "name": "Generate Article with Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2160,
        360
      ],
      "parameters": {
        "text": "=You are an expert SEO blog writer. Write a complete long-form article of roughly 1,200–2,000 words using only the supplied content brief.\n\nTOPIC: {{ $(\"Set Blog Input Fields\").item.json.TOPIC }}\nSEO_TITLE: {{ $(\"Set Blog Input Fields\").item.json.SEO_TITLE }}\nSEO_DESCRIPTION: {{ $(\"Set Blog Input Fields\").item.json.SEO_DESCRIPTION }}\nSLUG: {{ $(\"Set Blog Input Fields\").item.json.SLUG }}\nKEYWORD_PRIMARY: {{ $(\"Set Blog Input Fields\").item.json.KEYWORD_PRIMARY }}\nKEYWORDS_SECONDARY: {{ $(\"Set Blog Input Fields\").item.json.KEYWORDS_SECONDARY }}\nTARGET_AUDIENCE: {{ $(\"Set Blog Input Fields\").item.json.TARGET_AUDIENCE }}\nCONTENT_GOAL: {{ $(\"Set Blog Input Fields\").item.json.CONTENT_GOAL }}\n\nReturn one <article>...</article> block inside article_html. Use exactly one <h1> containing SEO_TITLE. Put <!--HERO_IMAGE--> immediately after the H1, <!--IMAGE_2--> in the middle, and <!--IMAGE_3--> near the end. Use useful H2/H3 sections, paragraphs and lists. Include an FAQ near the end. Integrate keywords naturally without stuffing. Do not invent statistics, studies, customer results or brand claims. For health, legal, financial or other high-stakes topics, keep the article informational and avoid diagnosis or individualized professional advice. Do not output CSS, scripts, iframes, JSON-LD or anything outside the article.",
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 0
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.9
    },
    {
      "id": "e00c1eb4-16b3-4c54-bd40-106c4f9bfd34",
      "name": "Gemini Content Generator",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
