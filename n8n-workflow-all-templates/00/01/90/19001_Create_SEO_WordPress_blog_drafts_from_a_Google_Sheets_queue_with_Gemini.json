    {
      "id": "2000d1c1-f29b-43c5-8c6f-2c96918e209f",
      "name": "Check Article HTML Validity",
      "type": "n8n-nodes-base.code",
      "position": [
        2400,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const html=String($input.first().json.output?.article_html||'').trim();\nif(!html) throw new Error('Article HTML missing');\nconst count=(re)=>((html.match(re)||[]).length);\nif(count(/<article(?:\\s|>)/gi)!==1||count(/<\\/article>/gi)!==1) throw new Error('Article must contain exactly one <article> block');\nif(count(/<h1(?:\\s|>)/gi)!==1) throw new Error('Article must contain exactly one <h1>');\nfor(const slot of ['HERO_IMAGE','IMAGE_2','IMAGE_3']) if(count(new RegExp('<!--'+slot+'-->','g'))!==1) throw new Error('Missing or duplicate image placeholder: '+slot);\nconst forbidden=/<script\\b|<iframe\\b|<object\\b|<embed\\b|javascript\\s*:|\\son[a-z]+\\s*=/i;\nif(forbidden.test(html)) throw new Error('Unsafe HTML construct detected');\nconst text=html.replace(/<[^>]+>/g,' ').replace(/\\s+/g,' ').trim();\nconst words=text ? text.split(' ').length : 0;\nif(words<800) throw new Error('Article too short: '+words+' words');\nreturn [{json:{article_html_template:html,word_count:words}}];",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
    {
