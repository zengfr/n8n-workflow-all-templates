    {
      "id": "3257cba0-cb3f-4b1d-a64b-50b107cb9b61",
      "name": "Validate Media & Build Final HTML",
      "type": "n8n-nodes-base.code",
      "position": [
        4320,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uploads=$input.all();\nif(uploads.length!==3) throw new Error('Expected exactly 3 WordPress media uploads, received '+uploads.length);\nconst by={};\nfor(const it of uploads){\n  const j=it.json||{};\n  if(!j.slot||!j.id) throw new Error('Uploaded media missing slot or id');\n  if(by[j.slot]) throw new Error('Duplicate uploaded media slot: '+j.slot);\n  const url=j.source_url||j.guid?.rendered||j.guid?.raw;\n  if(!url) throw new Error('Uploaded media missing URL for '+j.slot);\n  by[j.slot]={id:j.id,url};\n}\nfor(const s of ['HERO_IMAGE','IMAGE_2','IMAGE_3']) if(!by[s]) throw new Error('Missing uploaded media slot: '+s);\nlet html=$('Check Article HTML Validity').first().json.article_html_template;\nconst title=$('Set Blog Input Fields').first().json.SEO_TITLE||'Blog article';\nconst esc=(v)=>String(v).replace(/&/g,'&amp;').replace(/\"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst tag=(u,a,eager)=>'<figure><img src=\"'+esc(u)+'\" alt=\"'+esc(a)+'\" loading=\"'+(eager?'eager':'lazy')+'\" /></figure>';\nhtml=html.replace('<!--HERO_IMAGE-->',tag(by.HERO_IMAGE.url,title,true));\nhtml=html.replace('<!--IMAGE_2-->',tag(by.IMAGE_2.url,title+' illustration',false));\nhtml=html.replace('<!--IMAGE_3-->',tag(by.IMAGE_3.url,title+' closing illustration',false));\nif(/<!--(?:HERO_IMAGE|IMAGE_2|IMAGE_3)-->/.test(html)) throw new Error('Unresolved image placeholder remains');\nreturn [{json:{article_html_final:html,featured_media_id:by.HERO_IMAGE.id,IMAGE_URL_1:by.HERO_IMAGE.url,IMAGE_URL_2:by.IMAGE_2.url,IMAGE_URL_3:by.IMAGE_3.url}}];",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
    {
