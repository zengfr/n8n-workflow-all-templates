      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const post=$input.first().json;\nconst href=post?._links?.self?.[0]?.href;\nif(!post?.id||!href) throw new Error('Created WordPress draft is missing id or self link');\nconst body={\n  featured_media:$('Validate Media & Build Final HTML').first().json.featured_media_id,\n  excerpt:$('Set Blog Input Fields').first().json.SEO_DESCRIPTION||''\n};\nconst categoryId=$('Fetch WP Category by Slug').first().json.id;\nif(categoryId) body.categories=[categoryId];\nreturn [{json:{post_id:post.id,post_url:post.link||'',self_url:href,update_body:body}}];",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
