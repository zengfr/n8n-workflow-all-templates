      "id": "9e7640b4-11b9-473f-86b6-e6d95c8db3e6",
      "name": "Select First Blog for Draft",
      "type": "n8n-nodes-base.code",
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().filter(i => {\n  const j = i.json || {};\n  const s = String(j.STATUS || '').toLowerCase();\n  return Boolean(j.rowKey) && s !== 'draftready' && s !== 'published';\n});\nconst fresh = rows.find(i => String(i.json.STATUS || '').toLowerCase() !== 'processing');\nreturn fresh ? [fresh] : (rows.length ? [rows[0]] : []);",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
