    },
    {
      "id": "e5b0c519-a568-46e5-bcb0-2ccaebb0d8ec",
      "name": "Notify via Telegram",
      "type": "n8n-nodes-base.telegram",
      "position": [
        32,
        352
      ],
      "parameters": {
        "text": "={{ '🚨 WordPress Broken Link Monitor\\n\\n' + 'Detected ' + $json.data.length + ' broken or unavailable page(s).\\n\\n' + $json.data.map((item, index) => (index + 1) + '. ❌ HTTP ' + item.statusCode + '\\n' + item.url + '\\n' + (item.statusMessage || 'HTTP Error')).join('\\n\\n') + '\\n\\nChecked at: ' + $now.toFormat('yyyy-LL-dd HH:mm:ss') }}",
        "chatId": "={{ $('Configure Website Settings').item.json.telegramChatId }}",
        "additionalFields": {}
      },
      "typeVersion": 1.2
    },
