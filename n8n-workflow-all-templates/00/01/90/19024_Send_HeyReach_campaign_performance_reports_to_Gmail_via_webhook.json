    {
      "id": "5f3372b5-44a9-4a25-8432-92c17cd0b3f0",
      "name": "Prepare HTML Email Report",
      "type": "n8n-nodes-base.set",
      "position": [
        1216,
        16
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "subj",
              "name": "subject",
              "type": "string",
              "value": "=Campaign Completed: {{ $(\"Set Campaign & Recipient Info\").item.json.campaignName }}"
            },
            {
              "id": "bod",
              "name": "body",
              "type": "string",
              "value": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:680px;margin:0 auto;color:#243447;background:#f6f8fb;padding:24px\">\n  <div style=\"background:#4f46e5;color:#fff;padding:24px 28px;border-radius:12px 12px 0 0\">\n    <div style=\"font-size:12px;letter-spacing:1px;text-transform:uppercase;opacity:.85\">HeyReach campaign report</div>\n    <h1 style=\"margin:8px 0 0;font-size:26px;line-height:1.2\">{{ $json.name }}</h1>\n  </div>\n  <div style=\"background:#fff;padding:28px;border-radius:0 0 12px 12px;box-shadow:0 4px 18px rgba(15,23,42,.08)\">\n    <p style=\"margin-top:0;font-size:16px\">Your campaign has completed successfully. Here is the performance summary.</p>\n\n    <h2 style=\"font-size:17px;color:#334155;margin:24px 0 12px\">Performance summary</h2>\n    <table style=\"width:100%;border-collapse:collapse;font-size:14px\">\n      <tr><td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0\">Connections sent</td>\n      <td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0;text-align:right;font-weight:700\">{{ $json.overallStats?.connectionsSent ?? 0 }}</td></tr>\n\n      <tr><td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0\">Connections accepted</td>\n      <td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0;text-align:right;font-weight:700\">{{ $json.overallStats?.connectionsAccepted ?? 0 }} ({{ (($json.overallStats?.connectionAcceptanceRate ?? 0) * 100).toFixed(1) }}%)</td></tr>\n\n      <tr><td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0\">Messages started</td>\n      <td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0;text-align:right;font-weight:700\">{{ $json.overallStats?.totalMessageStarted ?? 0 }}</td></tr>\n\n      <tr><td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0\">Replies</td>\n      <td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0;text-align:right;font-weight:700\">{{ $json.overallStats?.totalMessageReplies ?? 0 }} ({{ (($json.overallStats?.messageReplyRate ?? 0) * 100).toFixed(1) }}%)</td></tr>\n\n      <tr><td style=\"padding:11px 0\">Interested leads</td>\n      <td style=\"padding:11px 0;text-align:right;font-weight:700\">{{ $json.overallStats?.autoTaggedInterested ?? 0 }} ({{ (($json.overallStats?.autoTaggedInterested ?? 0) / (($json.overallStats?.connectionsSent ?? 0) || 1) * 100).toFixed(1) }} per 100 invites)</td></tr>\n    </table>\n\n    <h2 style=\"font-size:17px;color:#334155;margin:24px 0 12px\">Lead status</h2>\n    <table style=\"width:100%;border-collapse:collapse;font-size:14px\">\n      <tr><td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0\">Total leads</td>\n      <td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0;text-align:right;font-weight:700\">{{ $json.progressStats?.totalUsers ?? 0 }}</td></tr>\n\n      <tr><td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0\">Finished</td>\n      <td style=\"padding:11px 0;border-bottom:1px solid #e2e8f0;text-align:right;font-weight:700\">{{ $json.progressStats?.totalUsersFinished ?? 0 }}</td></tr>\n\n      <tr><td style=\"padding:11px 0\">Failed</td>\n      <td style=\"padding:11px 0;text-align:right;font-weight:700\">{{ $json.progressStats?.totalUsersFailed ?? 0 }}</td></tr>\n    </table>\n\n    <div style=\"margin-top:26px;padding:16px;background:#eef2ff;border-left:4px solid #4f46e5;border-radius:6px\">\n      <strong>Recommended next steps</strong>\n      <ol style=\"margin:8px 0 0;padding-left:20px\">\n        <li>Compare A/B message variants and sunset underperforming variations.</li>\n        <li>Review leads tagged as interested and send follow-ups.</li>\n      </ol>\n    </div>\n\n    <p style=\"margin:26px 0 0\"><a href=\"https://app.heyreach.io/app/campaigns/{{ $json.id }}\" style=\"display:inline-block;background:#4f46e5;color:#fff;text-decoration:none;padding:12px 18px;border-radius:6px;font-weight:700\">Open campaign in HeyReach</a></p>\n    <p style=\"font-size:12px;color:#64748b;margin-bottom:0\">This report was generated automatically by n8n.</p>\n  </div>\n</div>"
            }
