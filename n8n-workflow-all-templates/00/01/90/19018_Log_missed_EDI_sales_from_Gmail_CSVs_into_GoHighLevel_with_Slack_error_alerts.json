    {
      "id": "77ea4f68-ba39-40a1-abfd-fe6e34e421a0",
      "name": "Build Unique Key & Map CSV Fields",
      "type": "n8n-nodes-base.code",
      "position": [
        528,
        -128
      ],
      "parameters": {
        "jsCode": "const row = $input.item.json;\nconst poNumber = String(row['PO Number'] || '').trim();\nconst sapCode = String(row['Material'] || '').trim();\nconst customerName = String(row['Cust Trading Name'] || '').trim();\nconst missedQty = parseFloat(row['Order Qty']) || 0;\nconst unitPrice = parseFloat(row['Net Price']) || 0;\nconst missedValue = parseFloat(row['Item Net Value']) || 0;\nconst rejectionReason = String(row['Rej. Reason Txt'] || '').trim().toUpperCase();\n\nreturn [{\n  json: {\n    uniqueKey: `${poNumber}-${sapCode}`,\n    recordName: `${customerName} — ${poNumber}`,\n    missedSaleDate: row['Created on'] || new Date().toLocaleDateString('en-GB'),\n    poNumber,\n    salesDocument: String(row['Sales Document'] || '').trim(),\n    salesItem: String(row['Sales Item'] || '').trim(),\n    soldToParty: String(row['Sold-To Party'] || '').trim(),\n    customerName,\n    sapCode,\n    sku: String(row['Manufacturer Part No'] || '').trim(),\n    productName: String(row['Material Desc.'] || '').trim(),\n    missedQuantity: missedQty,\n    unitPrice,\n    missedValue,\n    rejectionReason,\n    status: 'Pending',\n    sourceType: 'EDI',\n    accountId: null,\n    productId: null,\n    opportunityId: null\n  }\n}];"
      },
      "typeVersion": 2
    },
