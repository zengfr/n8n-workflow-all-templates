    {
      "id": "9d160bca-1c1d-4fb4-a315-061a57b24c29",
      "name": "AI Extract & Validate",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Set up an 'Anthropic API' generic credential (header auth) and select it in Authentication settings.",
      "position": [
        4240,
        2576
      ],
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-5\",\n  max_tokens: 800,\n  system: \"You extract and validate structured data from documents. If documentTypeHint is empty, first determine the document type: Invoice, Resume, Contract, or Application. Then extract fields for that type:\\n- Invoice: vendor, invoiceNumber, amount, invoiceDate, dueDate, lineItems (array of strings)\\n- Resume: candidateName, email, phone, yearsExperience, topSkills (array), mostRecentRole\\n- Contract: partyA, partyB, effectiveDate, term, keyObligations (array of strings)\\n- Application: applicantName, position, contactEmail, contactPhone, notes\\nList any of that type's required fields (all except lineItems/topSkills/keyObligations/notes which are optional) that are missing or unreadable in missingRequiredFields. Give a confidence score 0-1 for the extraction as a whole. Respond with ONLY valid JSON, no markdown fences, no preamble, in this exact shape: {\\\"documentType\\\":\\\"Invoice|Resume|Contract|Application\\\",\\\"fields\\\":{...type-specific fields...},\\\"missingRequiredFields\\\":[\\\"string\\\"],\\\"validationNotes\\\":\\\"string\\\",\\\"confidence\\\":0.0}\",\n  messages: [\n    {\n      role: \"user\",\n      content: \"documentTypeHint: \" + ($json.documentTypeHint || \"none - please detect\") + \"\\n\\nDocument text:\\n\" + $json.rawText\n    }\n  ]\n}) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $credentials.anthropicApi.apiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "4173c20a-004c-49ed-acbb-5a6921ffedab",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "notes": "Falls back to 'Unknown' / flagged for review if the AI response isn't valid JSON.",
      "position": [
        4464,
        2576
      ],
      "parameters": {
        "jsCode": "const meta = $('Merge Sources').first().json;\nconst raw = $json.content[0].text;\nlet parsed;\ntry {\n  parsed = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  parsed = {\n    documentType: 'Unknown',\n    fields: {},\n    missingRequiredFields: ['ALL - AI response could not be parsed'],\n    validationNotes: 'Could not parse AI response as JSON.',\n    confidence: 0\n  };\n}\nreturn [{\n  json: {\n    source: meta.source,\n    submittedBy: meta.submittedBy,\n    rawTextSnippet: (meta.rawText || '').slice(0, 300),\n    documentType: parsed.documentType,\n    fields: parsed.fields,\n    missingRequiredFields: parsed.missingRequiredFields || [],\n    validationNotes: parsed.validationNotes || '',\n    confidence: parsed.confidence ?? 0\n  }\n}];"
      },
      "typeVersion": 2
    },
