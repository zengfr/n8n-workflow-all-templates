    {
      "id": "975b25ab-6e44-4d4f-8cbd-630f05dc474b",
      "name": "Generate Email Summary",
      "type": "n8n-nodes-base.code",
      "position": [
        3024,
        832
      ],
      "parameters": {
        "jsCode": "let total = 0;\nlet sent = 0;\nlet invalid = 0;\nlet skipped = 0;\n\nfor (const item of $input.all()) {\n  total++;\n\n  const status = item.json[\"Email sent\"];\n\n  if (status === 'sent') sent++;\n  else if (status === 'invalid') invalid++;\n  else skipped++;\n}\n\nreturn [{\n  json: {\n    total,\n    sent,\n    invalid,\n    skipped\n  }\n}];"
      },
      "typeVersion": 2
    },
