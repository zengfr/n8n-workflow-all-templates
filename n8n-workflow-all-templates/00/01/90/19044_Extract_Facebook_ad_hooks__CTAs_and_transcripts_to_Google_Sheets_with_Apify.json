              "type": "boolean",
              "value": "={{ $json.charged }}"
            },
            {
              "id": "t-text",
              "name": "transcript",
              "type": "string",
              "value": "={{ $json.transcript }}"
            }
          ]
        }
      },
      "notesInFlow": true,
      "typeVersion": 3.4
    },
