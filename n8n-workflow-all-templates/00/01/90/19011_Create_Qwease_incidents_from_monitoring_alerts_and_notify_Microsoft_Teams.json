  "nodes": [
    {
      "id": "99bc0e82-7e92-464d-80b9-aa3d477ac408",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -400,
        224
      ],
      "parameters": {
        "width": 480,
        "height": 768,
        "content": "## Monitoring alert → Qwease incident + Microsoft Teams\n\n### How it works\n\nThis workflow receives a monitoring alert through a webhook, normalizes the incoming payload into ticket title and body fields, then creates an incident ticket in Qwease. After the ticket is created, it posts a notification to Microsoft Teams so the team is alerted in their collaboration channel.\n\n### Setup steps\n\n- Configure the webhook URL in the external monitoring system so alerts are sent to the n8n webhook node.\n- Review the field mapping in the Normalize alert fields node to ensure it matches the monitoring payload structure.\n- Add the required Qwease API credentials or authorization headers for the HTTP request to https://rest.qwease.fr/api/ticket/.\n- Connect Microsoft Teams credentials in n8n and select the target team/channel or chat for notifications.\n\n### Customization\n\nAdjust the normalized ticket_title and ticket_body fields, Qwease ticket payload, and Teams message format to include the alert severity, affected service, runbook links, or ticket URL."
      },
      "typeVersion": 1
    },
    {
      "id": "943951f4-681d-41bc-8402-1a75d98db8a9",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        160,
        224
      ],
      "parameters": {
        "color": 7,
        "width": 432,
        "height": 320,
        "content": "## Receive and normalize alert\n\nReceives the monitoring webhook event and maps the alert payload into standardized fields used for the downstream incident ticket."
      },
      "typeVersion": 1
    },
    {
      "id": "0f16957d-1faa-4416-889e-42e9026727f1",
      "name": "Sticky Note2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        640,
        224
      ],
      "parameters": {
        "color": 7,
        "width": 432,
        "height": 320,
        "content": "## Create and notify incident\n\nCreates the Qwease ticket from the normalized alert data, then posts the incident notification to Microsoft Teams."
      },
      "typeVersion": 1
    },
    {
      "id": "wh-monitoring",
      "name": "When Monitoring Alert Received",
      "type": "n8n-nodes-base.webhook",
      "position": [
        200,
        380
      ],
      "webhookId": "qwease-monitoring-alert",
      "parameters": {
        "path": "monitoring-alert",
        "options": {},
        "httpMethod": "POST"
      },
      "typeVersion": 2
    },
    {
      "id": "set-map-alert",
      "name": "Set Qwease Ticket Fields",
      "type": "n8n-nodes-base.set",
      "position": [
        440,
        380
      ],
      "parameters": {
        "mode": "manual",
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "map-title",
              "name": "ticket_title",
              "type": "string",
              "value": "={{ $json.body?.title || $json.title || $json.body?.alertname || 'Monitoring alert' }}"
            },
            {
              "id": "map-body",
              "name": "ticket_body",
              "type": "string",
              "value": "={{ $json.body?.message || $json.message || $json.body?.description || JSON.stringify($json.body || $json) }}"
            }
          ]
        },
        "duplicateItem": false
      },
      "typeVersion": 3.4
    },
    {
      "id": "http-qwease-create",
      "name": "Post Qwease Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        680,
        380
      ],
      "parameters": {
        "url": "https://rest.qwease.fr/api/ticket/",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"type\": \"INC\",\n  \"form\": 1,\n  \"for_user\": 1,\n  \"resume\": {{ JSON.stringify($json.ticket_title) }},\n  \"description\": {{ JSON.stringify($json.ticket_body + \"\\n\\n---\\nCreated by n8n · monitoring bridge\") }}\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "teams-notify",
      "name": "Notify via Microsoft Teams",
      "type": "n8n-nodes-base.microsoftTeams",
      "position": [
        920,
        380
      ],
      "parameters": {
        "teamId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "message": "=🚨 Qwease incident #{{ $json.id || $json.display_name || '?' }} · {{ $('Set Qwease Ticket Fields').item.json.ticket_title }}",
        "options": {
          "includeLinkToWorkflow": false
        },
        "resource": "channelMessage",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "operation": "create",
        "messageType": "text"
      },
      "typeVersion": 2
    }
  ],
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
