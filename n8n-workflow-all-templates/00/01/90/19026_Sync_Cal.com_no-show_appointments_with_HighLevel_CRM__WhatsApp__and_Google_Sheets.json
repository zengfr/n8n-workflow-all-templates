        -672,
        -448
      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 320,
        "content": "## Receive no-show event\n\nStarts from the Cal.com webhook and filters incoming events so only bookings marked as no-show continue through the workflow."
      },
      "typeVersion": 1
    },
    {
