{
  "meta": {
    "site": "https://github.com/zengfr/n8n-workflow-all-templates",
    "tokenfree": "https://tokenyep.com/",
    "name": "Generate AI images from form inputs with Kavel’s anonymous API",
    "wechat": "youandme10086",
    "id": 19009,
    "update_time": "2026-09-27"
  },
  "name": "Generate AI images from a form — free, no API key (Kavel)",
  "nodes": [
    {
      "id": "b1f0a0e2-0001-4a10-9a01-000000000001",
      "name": "Image request form",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        -460,
        0
      ],
      "webhookId": "0b7d8b2a-0e10-4a5b-9c31-3f2a1d6e7c11",
      "parameters": {
        "options": {},
        "formTitle": "AI image generator",
        "formFields": {
          "values": [
            {
              "fieldType": "textarea",
              "fieldLabel": "Prompt",
              "placeholder": "A calm minimalist workspace with a laptop and a cup of coffee, soft morning light, photorealistic",
              "requiredField": true
            },
            {
              "fieldType": "dropdown",
              "fieldLabel": "Aspect ratio",
              "fieldOptions": {
                "values": [
                  {
                    "option": "1:1"
                  },
                  {
                    "option": "16:9"
                  },
                  {
                    "option": "9:16"
                  },
                  {
                    "option": "4:3"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "formDescription": "Describe the image you want. It is generated by Kavel (https://www.kavel.ai) — no account and no API key needed."
      },
      "typeVersion": 2.2
    },
    {
      "id": "b1f0a0e2-0002-4a10-9a01-000000000002",
      "name": "Prepare request",
      "type": "n8n-nodes-base.code",
      "position": [
        -240,
        0
      ],
      "parameters": {
        "jsCode": "// One anonymous client id per execution. Kavel meters the free tier per\n// client id (and per IP per day), so a fresh id keeps each run independent.\nconst anonId = 'n8n-' + Math.random().toString(36).slice(2, 12);\n\nreturn [{\n  json: {\n    anonId,\n    prompt: $input.first().json['Prompt'],\n    aspectRatio: $input.first().json['Aspect ratio'] || '1:1',\n  },\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "b1f0a0e2-0003-4a10-9a01-000000000003",
      "name": "Start generation",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        -20,
        0
      ],
      "parameters": {
        "url": "https://www.kavel.ai/api/ai/generate",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ provider: 'kie', mediaType: 'image', model: 'kavel-image-v1', scene: 'text-to-image', prompt: $json.prompt, options: { aspect_ratio: $json.aspectRatio } }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-anon-id",
              "value": "={{ $json.anonId }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 3000
    },
    {
      "id": "b1f0a0e2-0004-4a10-9a01-000000000004",
      "name": "Free quota used up?",
      "type": "n8n-nodes-base.if",
      "position": [
        200,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "wall-check",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.data.wall }}",
              "rightValue": true
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "b1f0a0e2-0005-4a10-9a01-000000000005",
      "name": "Out of free quota",
      "type": "n8n-nodes-base.set",
      "position": [
        420,
        -160
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "wall-msg",
              "name": "message",
              "type": "string",
              "value": "The free anonymous quota for this machine is used up for today. Sign in at https://www.kavel.ai to keep generating."
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "b1f0a0e2-0006-4a10-9a01-000000000006",
      "name": "Wait 20s",
      "type": "n8n-nodes-base.wait",
      "position": [
        420,
        140
      ],
      "webhookId": "3c9e6a41-7b52-4d18-9f0a-8e5c2b7d1a44",
      "parameters": {
        "amount": 20
      },
      "typeVersion": 1.1
    },
    {
      "id": "b1f0a0e2-0007-4a10-9a01-000000000007",
      "name": "Check status",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        640,
        140
      ],
      "parameters": {
        "url": "https://www.kavel.ai/api/ai/anon-query",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "taskId",
              "value": "={{ $('Start generation').item.json.data.id }}"
            },
            {
              "name": "provider",
              "value": "kie"
            },
            {
              "name": "mediaType",
              "value": "image"
            }
          ]
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 3000
    },
    {
      "id": "b1f0a0e2-0008-4a10-9a01-000000000008",
      "name": "Image ready?",
      "type": "n8n-nodes-base.if",
      "position": [
        860,
        140
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "done-check",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "success"
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "b1f0a0e2-0009-4a10-9a01-000000000009",
      "name": "Download image",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        1080,
        40
      ],
      "parameters": {
        "url": "={{ $json.data.images[0] }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "image"
            }
          }
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 3000
    },
    {
      "id": "b1f0a0e2-000a-4a10-9a01-00000000000a",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -700,
        -400
      ],
      "parameters": {
        "color": 4,
        "width": 420,
        "height": 320,
        "content": "## What this does\n\nTurns a prompt typed into an n8n form into a finished image, using the free anonymous tier of **Kavel** (https://www.kavel.ai). There is no signup step and no API key to store — the workflow sends a random client id with each run and Kavel meters the free tier against it.\n\nUse it as a drop-in image step inside bigger automations: blog cover art, social posts, product mockups, placeholder assets."
      },
      "typeVersion": 1
    },
    {
      "id": "b1f0a0e2-000b-4a10-9a01-00000000000b",
      "name": "How to use",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -260,
        -400
      ],
      "parameters": {
        "color": 7,
        "width": 420,
        "height": 320,
        "content": "## How to use\n\n1. **Execute workflow** and open the form URL.\n2. Type a prompt, pick an aspect ratio, submit.\n3. The workflow queues the job, waits 20s, then polls until the image is ready — usually 40–120 seconds in total.\n4. The last node downloads the image as binary data — connect it to Google Drive, Slack, WordPress, S3, or anything else.\n\n**Swap the form** for a Schedule, RSS, Airtable or Gmail trigger to generate images automatically."
      },
      "typeVersion": 1
    },
    {
      "id": "b1f0a0e2-000c-4a10-9a01-00000000000c",
      "name": "Limits",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        180,
        -400
      ],
      "parameters": {
        "color": 3,
        "width": 420,
        "height": 320,
        "content": "## Limits of the free tier\n\n- Output is **1K, watermarked**, one image per run.\n- The anonymous allowance is small and also capped per IP per day. When it runs out the API answers with `wall: true` and the workflow takes the upper branch.\n- Signing in at https://www.kavel.ai raises the allowance, removes the watermark and unlocks the larger image and video models — swap `model` in the *Start generation* node once you do."
      },
      "typeVersion": 1
    },
    {
      "id": "b1f0a0e2-000d-4a10-9a01-00000000000d",
      "name": "Generation failed?",
      "type": "n8n-nodes-base.if",
      "position": [
        1080,
        240
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "failed-check",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "failed"
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "b1f0a0e2-000e-4a10-9a01-00000000000e",
      "name": "Report failure",
      "type": "n8n-nodes-base.set",
      "position": [
        1300,
        180
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "fail-msg",
              "name": "message",
              "type": "string",
              "value": "={{ 'Generation failed: ' + ($json.data.reason || 'the model rejected this prompt. Try rewording it.') }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    }
  ],
