            },
            {
              "id": "7",
              "name": "flood_risk_pct",
              "type": "number",
              "value": "={{$json.daily.precipitation_probability_max[0]}}"
            },
            {
              "id": "8",
              "name": "is_heavy_snow",
              "type": "boolean",
              "value": "={{$json.current.snowfall >= 2 || $json.daily.snowfall_sum[0] >= 5}}"
            },
            {
              "id": "9",
              "name": "is_flood_warning",
              "type": "boolean",
              "value": "={{$json.daily.precipitation_probability_max[0] >= 80 && $json.current.precipitation >= 4}}"
            },
            {
              "id": "10",
              "name": "is_severe",
              "type": "boolean",
              "value": "={{ ($json.current.snowfall >= 2 || $json.daily.snowfall_sum[0] >= 5) || ($json.daily.precipitation_probability_max[0] >= 80 && $json.current.precipitation >= 4) || $json.current.visibility < 500 }}"
            },
            {
              "id": "11",
              "name": "severity_type",
              "type": "string",
              "value": "={{\n  ($json.current.snowfall >= 2 || $json.daily.snowfall_sum[0] >= 5)\n    ? 'heavy_snow'\n    : ($json.daily.precipitation_probability_max[0] >= 80 && $json.current.precipitation >= 4)\n      ? 'flood_warning'\n      : ($json.current.visibility < 500)\n        ? 'low_visibility'\n        : 'none'\n}}"
            },
            {
              "id": "12",
              "name": "raw_weather_json",
              "type": "string",
              "value": "={{JSON.stringify($json)}}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
