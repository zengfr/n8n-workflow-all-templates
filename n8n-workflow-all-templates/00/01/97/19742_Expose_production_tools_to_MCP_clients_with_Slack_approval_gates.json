      "id": "cbc35f25-6f81-4412-85da-ff0750bb91bf",
      "name": "JS - Merge Execution Result",
      "type": "n8n-nodes-base.code",
      "position": [
        3376,
        384
      ],
      "parameters": {
        "jsCode": "// Whichever executor branch ran, its own item already carries the full\n// call record plus the raw API response merged in by n8n.\nconst result = $input.first().json;\nconst succeeded = !(result.error || result.errorMessage);\n\nreturn [{\n  json: {\n    ...result,\n    executionSucceeded: succeeded,\n    executionResult: succeeded ? (result.body || result) : (result.error || result.errorMessage),\n    executedAt: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
