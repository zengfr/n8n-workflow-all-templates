    {
      "id": "c386f215-73ad-4caa-bb21-9aee8e91580c",
      "name": "JS - Validate Tool Call",
      "type": "n8n-nodes-base.code",
      "position": [
        1360,
        672
      ],
      "parameters": {
        "jsCode": "// Validates the incoming MCP tool call against a fixed allow-list before\n// anything is allowed to touch a production system.\nconst item = $input.first().json;\nconst toolName = item.toolName || item.tool || item.name;\nconst params = item.parameters || item.arguments || item.input || {};\n\nconst TOOL_SCHEMAS = {\n  deploy_service: { required: ['serviceName', 'environment', 'version'], destructive: true },\n  query_production_database: { required: ['queryName', 'filters'], destructive: false },\n  search_knowledge_base: { required: ['query'], destructive: false },\n  issue_refund: { required: ['orderId', 'amount', 'reason'], destructive: true }\n};\n\nconst schema = TOOL_SCHEMAS[toolName];\nconst errors = [];\n\nif (!schema) {\n  errors.push('Unknown or disallowed tool name: ' + toolName);\n} else {\n  for (const field of schema.required) {\n    if (params[field] === undefined || params[field] === null || params[field] === '') {\n      errors.push('Missing required parameter: ' + field);\n    }\n  }\n}\n\nreturn [{\n  json: {\n    toolName,\n    params,\n    isValid: errors.length === 0,\n    validationErrors: errors,\n    isDestructive: schema ? schema.destructive : true,\n    requestedAt: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
