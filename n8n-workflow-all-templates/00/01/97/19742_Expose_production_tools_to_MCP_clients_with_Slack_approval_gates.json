      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn [{\n  json: {\n    ...d,\n    auditStatus: d.executionSucceeded ? 'call_executed_successfully' : 'call_execution_failed',\n    auditCompletedAt: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
