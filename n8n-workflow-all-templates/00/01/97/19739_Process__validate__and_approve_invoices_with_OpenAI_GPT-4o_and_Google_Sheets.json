    {
      "id": "9d06ac0d-db8d-48c4-af57-84e1b247d175",
      "name": "AI - Analyze and Categorize Invoice - Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        3136,
        736
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\"\n      ]\n    },\n    \"risk_level\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\"\n      ]\n    },\n    \"approval_required\": {\n      \"type\": \"boolean\"\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"priority\",\n    \"risk_level\",\n    \"approval_required\",\n    \"reason\"\n  ]\n}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "b9d076b7-e247-4bad-bd8f-be8bf0e950c6",
      "name": "Code - Verify Invoice Total",
      "type": "n8n-nodes-base.code",
      "position": [
        3360,
        528
      ],
      "parameters": {
        "jsCode": "const invoice = $('Code - Validate Required Fields').first().json;\n\nconst aiRaw = $input.first().json;\nlet analysis;\nif (aiRaw.output && typeof aiRaw.output === 'object') {\n  analysis = aiRaw.output;\n} else try {\n  const content = aiRaw.output || aiRaw.text || aiRaw.content || aiRaw;\n  analysis = typeof content === 'string' ? JSON.parse(content) : content;\n} catch (e) {\n  analysis = { category: 'Other', priority: 'medium', risk_level: 'medium', approval_required: true, reason: 'AI analysis could not be parsed' };\n}\n\nconst subtotal = invoice.subtotal || 0;\nconst tax = invoice.tax || 0;\nconst total = invoice.total_amount || 0;\nconst expectedTotal = Math.round((subtotal + tax) * 100) / 100;\nconst totalMismatch = Math.abs(expectedTotal - total) > 0.01;\n\nreturn [{\n  json: {\n    ...invoice,\n    category: analysis.category || 'Other',\n    priority: analysis.priority || 'medium',\n    risk_level: analysis.risk_level || 'medium',\n    approval_required: analysis.approval_required !== undefined ? analysis.approval_required : true,\n    analysis_reason: analysis.reason || '',\n    expected_total: expectedTotal,\n    total_mismatch: totalMismatch\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "00135e6e-1dc7-45f8-a23e-01f61cb16abe",
      "name": "Switch - Determine Approval Path",
