                  },
                  {
                    "id": "r1d",
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    },
                    "leftValue": "={{$json.total_mismatch}}",
                    "rightValue": false
                  }
                ]
              }
            },
            {
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "or",
                "conditions": [
                  {
                    "id": "r2a",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{$json.risk_level}}",
                    "rightValue": "high"
                  },
                  {
                    "id": "r2b",
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    },
                    "leftValue": "={{$json.total_mismatch}}",
                    "rightValue": true
                  }
                ]
              }
            },
            {
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r3a",
                    "operator": {
                      "type": "number",
                      "operation": "gt"
                    },
                    "leftValue": "={{$json.total_amount}}",
                    "rightValue": 1000
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 3.2
    },
    {
      "id": "9ac1563a-3115-47c6-87db-adbc5679c8de",
      "name": "Code - Auto Approve Invoice",
      "type": "n8n-nodes-base.code",
      "position": [
        4256,
        432
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    approval_status: 'Approved',\n    approval_method: 'Automatic (low value, low risk)',\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
