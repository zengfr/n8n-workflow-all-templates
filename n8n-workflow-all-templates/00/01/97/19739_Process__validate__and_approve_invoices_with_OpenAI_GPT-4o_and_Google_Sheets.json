    {
      "id": "18f43ea1-789a-4fad-8189-c05734d82425",
      "name": "AI - Extract Invoice Data - Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1744,
        672
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"invoice_number\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"vendor_name\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"vendor_email\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"invoice_date\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"due_date\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"subtotal\": {\n      \"type\": [\n        \"number\",\n        \"null\"\n      ]\n    },\n    \"tax\": {\n      \"type\": [\n        \"number\",\n        \"null\"\n      ]\n    },\n    \"total_amount\": {\n      \"type\": [\n        \"number\",\n        \"null\"\n      ]\n    },\n    \"currency\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"line_items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"description\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"quantity\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"unit_price\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          },\n          \"amount\": {\n            \"type\": [\n              \"number\",\n              \"null\"\n            ]\n          }\n        }\n      }\n    },\n    \"payment_info\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"method\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"account\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"terms\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"invoice_number\",\n    \"vendor_name\",\n    \"invoice_date\",\n    \"total_amount\"\n  ]\n}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "c25f45a5-1bb2-4b55-9f9c-7965fd6ea52b",
      "name": "Code - Clean and Normalize Data",
      "type": "n8n-nodes-base.code",
      "position": [
        1888,
        464
      ],
      "parameters": {
        "jsCode": "// Parse the AI extraction output and normalize it into a consistent shape\nconst raw = $input.first().json;\nlet extracted;\nif (raw.output && typeof raw.output === 'object') {\n  extracted = raw.output;\n} else {\n  try {\n    const content = raw.output || raw.text || raw.content || raw;\n    extracted = typeof content === 'string' ? JSON.parse(content) : content;\n  } catch (e) {\n    extracted = {};\n  }\n}\n\nconst toNumber = (v) => {\n  if (v === null || v === undefined || v === '') return null;\n  const n = Number(String(v).replace(/[^0-9.\\-]/g, ''));\n  return isNaN(n) ? null : n;\n};\n\nconst meta = $('Set - Prepare Invoice Metadata').first().json;\n\nconst normalized = {\n  invoice_number: (extracted.invoice_number || '').toString().trim() || null,\n  vendor_name: (extracted.vendor_name || meta.vendorNameSubmitted || '').toString().trim() || null,\n  vendor_email: (extracted.vendor_email || meta.vendorEmailSubmitted || '').toString().trim().toLowerCase() || null,\n  invoice_date: extracted.invoice_date || null,\n  due_date: extracted.due_date || null,\n  subtotal: toNumber(extracted.subtotal),\n  tax: toNumber(extracted.tax),\n  total_amount: toNumber(extracted.total_amount),\n  currency: (extracted.currency || 'USD').toString().toUpperCase(),\n  line_items: Array.isArray(extracted.line_items) ? extracted.line_items : [],\n  payment_info: extracted.payment_info || {},\n  received_at: meta.receivedAt,\n  source_request_id: meta.sourceRequestId\n};\n\nreturn [{ json: normalized }];"
      },
      "typeVersion": 2
    },
    {
      "id": "bc6755ae-f66f-4802-a896-4e50094b935c",
      "name": "Code - Validate Required Fields",
      "type": "n8n-nodes-base.code",
      "position": [
        2112,
        464
      ],
      "parameters": {
        "jsCode": "const inv = $input.first().json;\nconst required = ['invoice_number', 'vendor_name', 'invoice_date', 'total_amount'];\nconst missingFields = required.filter(f => inv[f] === null || inv[f] === undefined || inv[f] === '');\n\nreturn [{\n  json: {\n    ...inv,\n    is_valid: missingFields.length === 0,\n    missing_fields: missingFields\n  }\n}];"
      },
      "typeVersion": 2
    },
