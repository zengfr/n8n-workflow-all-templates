    },
    {
      "id": "55ff48c2-a49e-4c77-a78e-2c628af17b05",
      "name": "Send Email - Approval Request",
      "type": "n8n-nodes-base.gmail",
      "position": [
        3808,
        624
      ],
      "webhookId": "efdd83ec-182c-444a-802a-aac0c3bfdc7e",
      "parameters": {
        "sendTo": "={{$json.risk_level === 'high' ? 'finance-review@yourcompany.com' : 'manager-approvals@yourcompany.com'}}",
        "message": "=An invoice requires your approval.\n\nVendor: {{$json.vendor_name}}\nInvoice Number: {{$json.invoice_number}}\nAmount: {{$json.total_amount}} {{$json.currency}}\nCategory: {{$json.category}}\nPriority: {{$json.priority}}\nRisk Level: {{$json.risk_level}}\nReason: {{$json.analysis_reason}}\n\nApprove or reject here:\nhttps://yourcompany.com/approvals/{{$json.invoice_number}}?requestId={{$json.source_request_id}}",
        "options": {},
        "subject": "=Approval Needed: Invoice {{$json.invoice_number}} - {{$json.vendor_name}}",
        "emailType": "text"
      },
      "typeVersion": 2.1
    },
    {
      "id": "b8135a95-da0c-4b3b-a391-3f9163426c24",
      "name": "Wait - Wait for Approval Decision",
      "type": "n8n-nodes-base.wait",
      "position": [
        4032,
        624
      ],
      "webhookId": "ca7632ad-0598-4dfe-af07-051085c18072",
      "parameters": {
        "resume": "webhook",
        "options": {}
      },
      "typeVersion": 1.1
    },
    {
      "id": "4105ed91-a398-40e2-a789-8ba2aae29710",
      "name": "Code - Process Approval Decision",
      "type": "n8n-nodes-base.code",
      "position": [
        4256,
        624
      ],
      "parameters": {
        "jsCode": "// The resume payload from the approval webhook is expected to include\n// a \"decision\" field: \"approved\" or \"rejected\", plus optional \"approver\" and \"comment\".\nconst resumeData = $input.first().json;\nconst priorItem = $('Switch - Determine Approval Path').first().json;\n\nconst decision = (resumeData.body?.decision || resumeData.decision || 'rejected').toLowerCase();\n\nreturn [{\n  json: {\n    ...priorItem,\n    approval_status: decision === 'approved' ? 'Approved' : 'Rejected',\n    approval_method: resumeData.body?.approver || resumeData.approver || 'Manual reviewer',\n    approval_comment: resumeData.body?.comment || resumeData.comment || '',\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "0f4709bb-461f-4423-8592-604e026378f6",
      "name": "Google Sheets - Store Invoice Record",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        4480,
        528
      ],
      "parameters": {
        "columns": {
          "value": {
            "tax": "={{$json.tax}}",
