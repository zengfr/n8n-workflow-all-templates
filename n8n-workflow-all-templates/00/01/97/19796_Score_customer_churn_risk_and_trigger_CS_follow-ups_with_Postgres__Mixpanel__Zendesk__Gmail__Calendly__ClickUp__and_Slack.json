    {
      "id": "a6a3ebd7-1035-489e-9946-1baaf4198e73",
      "name": "Calculate Churn Risk Score1",
      "type": "n8n-nodes-base.code",
      "position": [
        832,
        1920
      ],
      "parameters": {
        "jsCode": "// Compute a churn-risk score per customer from usage, NPS and ticket signals\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const d = item.json;\n\n  const daysSinceLogin = d.last_login_at\n    ? Math.floor((Date.now() - new Date(d.last_login_at).getTime()) / 86400000)\n    : 999;\n\n  const usageDropPct = d.feature_usage_30d > 0\n    ? Math.round((1 - (d.feature_usage_7d * 4 / d.feature_usage_30d)) * 100)\n    : 0;\n\n  const seatUtilization = d.seats_purchased > 0\n    ? (d.seats_active / d.seats_purchased)\n    : 1;\n\n  const npsScore = typeof d.nps_score === 'number' ? d.nps_score : null;\n  const openTicketCount = d.open_ticket_count || 0;\n  const negativeTicketSentiment = d.negative_sentiment_flag === true;\n\n  let score = 0;\n  const reasons = [];\n\n  if (daysSinceLogin >= 14) { score += 30; reasons.push(`No login in ${daysSinceLogin} days`); }\n  else if (daysSinceLogin >= 7) { score += 15; reasons.push(`Login gap of ${daysSinceLogin} days`); }\n\n  if (usageDropPct >= 50) { score += 25; reasons.push(`Feature usage down ${usageDropPct}%`); }\n  else if (usageDropPct >= 25) { score += 12; reasons.push(`Feature usage down ${usageDropPct}%`); }\n\n  if (seatUtilization < 0.3) { score += 15; reasons.push(`Seat utilization at ${Math.round(seatUtilization * 100)}%`); }\n\n  if (npsScore !== null && npsScore <= 6) { score += 20; reasons.push(`Detractor NPS score: ${npsScore}`); }\n  else if (npsScore !== null && npsScore <= 8) { score += 8; reasons.push(`Passive NPS score: ${npsScore}`); }\n\n  if (openTicketCount >= 3) { score += 15; reasons.push(`${openTicketCount} open support tickets`); }\n  if (negativeTicketSentiment) { score += 15; reasons.push('Negative sentiment detected in support tickets'); }\n\n  const riskLevel = score >= 60 ? 'high' : score >= 35 ? 'medium' : 'low';\n\n  results.push({\n    json: {\n      ...d,\n      churn_score: score,\n      risk_level: riskLevel,\n      churn_reasons: reasons,\n      is_churn_risk: score >= 35\n    }\n  });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
