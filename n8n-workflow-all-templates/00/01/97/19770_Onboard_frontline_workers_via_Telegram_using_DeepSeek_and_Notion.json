      "position": [
        3504,
        4400
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nlet extracted;\ntry {\n  const text = response.choices[0].message.content;\n  const cleaned = text.replace(/```json|```/g, '').trim();\n  extracted = JSON.parse(cleaned);\n} catch (e) {\n  extracted = { documentType: 'Unknown', fullName: '', idNumber: '', expiryDate: null, isReadable: false };\n}\nreturn [{\n  json: {\n    chatId: $('Route by Message Type').item.json.message.chat.id,\n    documentType: extracted.documentType || 'Unknown',\n    fullName: extracted.fullName || '',\n    idNumber: extracted.idNumber || '',\n    expiryDate: extracted.expiryDate || null,\n    isReadable: extracted.isReadable === true,\n    statusValue: extracted.isReadable === true ? 'Docs Verified' : 'Docs Submitted',\n    notesSummary: `Type: ${extracted.documentType || 'Unknown'} | Name: ${extracted.fullName || 'n/a'} | ID: ${extracted.idNumber || 'n/a'} | Expiry: ${extracted.expiryDate || 'n/a'} | Readable: ${extracted.isReadable}`\n  }\n}];"
      },
      "typeVersion": 2
