        "jsCode": "const items = $input.all();\nconst found = items.length > 0 && items[0].json && items[0].json.id;\nconst prep = $('Set Employee Fields').first().json;\nreturn [{\n  json: {\n    exists: found ? 'true' : 'false',\n    existingPageId: found ? items[0].json.id : null,\n    existingStatus: found ? (items[0].json.property_status || 'Unknown') : null,\n    chatId: prep.chatId,\n    firstName: prep.firstName,\n    lastName: prep.lastName,\n    onboardingDate: prep.onboardingDate\n  }\n}];"
