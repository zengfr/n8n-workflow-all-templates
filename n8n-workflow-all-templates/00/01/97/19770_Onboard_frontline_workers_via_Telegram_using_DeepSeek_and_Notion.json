    {
      "id": "c178dfb3-3b0e-4fc6-8ab9-af16370b314f",
      "name": "Prepare Text for DeepSeek Extraction",
      "type": "n8n-nodes-base.code",
      "position": [
        3056,
        4496
      ],
      "parameters": {
        "jsCode": "const extractedText = ($json.text || '').slice(0, 6000);\nconst requestBody = JSON.stringify({\n  model: 'deepseek-chat',\n  messages: [{\n    role: 'user',\n    content: `Extract the following from this document text and return ONLY valid JSON (no markdown, no explanation) with keys: documentType, fullName, idNumber, expiryDate (YYYY-MM-DD or null if none), isReadable (true or false).\\n\\nDocument text:\\n${extractedText}`\n  }]\n});\nreturn [{ json: { requestBody } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "77a32b2a-8075-42b2-a748-ba37061f06df",
      "name": "Convert Doc to Base64",
      "type": "n8n-nodes-base.code",
      "position": [
        3072,
        4352
      ],
      "parameters": {
        "jsCode": "const binaryData = $input.first().binary.data;\n\n// Fetch the actual binary buffer via n8n's binary helper (needed when binary data\n// is stored on disk/filesystem rather than inline in the item). On this n8n version\n// (self-hosted 2.36.7) the helper is exposed as this.helpers, NOT a global $helpers.\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64Data = buffer.toString('base64');\nconst mimeType = binaryData.mimeType || 'image/jpeg';\n\nconst requestBody = JSON.stringify({\n  model: 'deepseek-v4-flash-vision-exp',\n  messages: [{\n    role: 'user',\n    content: [\n      { type: 'text', text: 'Extract the following from this document image and return ONLY valid JSON (no markdown, no explanation) with keys: documentType, fullName, idNumber, expiryDate (YYYY-MM-DD or null if none), isReadable (true or false).' },\n      { type: 'image_url', image_url: { url: `data:${mimeType};base64,${base64Data}` } }\n    ]\n  }]\n});\n\nreturn [{ json: { requestBody } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "6a55c8a2-db11-4889-a899-bcfbd9cd0908",
      "name": "Post to DeepSeek API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        3280,
        4400
      ],
      "parameters": {
        "url": "https://api.deepseek.com/chat/completions",
        "body": "={{ $json.requestBody }}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "raw",
        "sendHeaders": true,
        "authentication": "genericCredentialType",
