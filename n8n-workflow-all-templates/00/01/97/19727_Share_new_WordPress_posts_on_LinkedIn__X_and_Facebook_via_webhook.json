    {
      "id": "a5237a41-fa8c-4157-8b5c-b224dea9d7a7",
      "name": "Get Post",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        448,
        0
      ],
      "parameters": {
        "url": "={{ $json.site_url.replace(/\\/+$/, '') }}/wp-json/wp/v2/posts/{{ $json.body.post_id }}",
        "method": "GET",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "_embed",
              "value": "wp:featuredmedia"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "02f398f4-0174-4827-b4c8-64cb0e59436f",
      "name": "Post Fields",
      "type": "n8n-nodes-base.code",
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "// Turns the REST API response into the fields the publish nodes use.\n// Input: one item, the post from /wp-json/wp/v2/posts/{id}?_embed=wp:featuredmedia\nconst post = $input.first().json;\n\n// WordPress returns titles and excerpts as HTML with entities (&#8217; &amp; ...).\nconst decode = (text) => text\n  .replace(/&#(\\d+);/g, (match, code) => String.fromCharCode(code))\n  .replace(/&amp;/g, '&')\n  .replace(/&quot;/g, '\"')\n  .replace(/&hellip;/g, '…')\n  .replace(/&nbsp;/g, ' ');\n\nconst stripTags = (html) => html.replace(/<[^>]+>/g, '');\n\nconst title = decode(post.title.rendered).trim();\n\n// Auto excerpts end in \" [...]\"; keep it as a single ellipsis.\nconst summary = decode(stripTags(post.excerpt.rendered))\n  .replace(/\\s*\\[…\\]\\s*$/, '…')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst url = post.link;\n\n// LinkedIn gets this uploaded as an image post (Get Featured Image). X and Facebook show the image\n// from the page's own og:image tags.\nconst featured = post._embedded && post._embedded['wp:featuredmedia'] && post._embedded['wp:featuredmedia'][0];\nconst image_url = featured ? featured.source_url : '';\n\n// X counts a URL as 23 characters, so 240 leaves room for the link.\nconst short_title = title.length > 240 ? title.slice(0, 237) + '…' : title;\n\nreturn [{ json: { title, summary, url, image_url, short_title } }];\n"
      },
      "typeVersion": 2
    },
