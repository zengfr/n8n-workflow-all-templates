    {
      "id": "2cd9a5ff-726d-4c18-87d0-42d74b830f52",
      "name": "Formatting email from template",
      "type": "n8n-nodes-base.code",
      "position": [
        1888,
        64
      ],
      "parameters": {
        "jsCode": "const template_subject = $input.first().json.property_subject;\nconst template_body = $input.first().json.property_body;\n\nconst data = $(\"Notion Trigger\").first().json;\n\nconst email_subject = template_subject.replace(/\\[([^\\]]+)\\]/g, (_, key) => {\n  return data[key] ?? \"\";\n});\nconst email_body = template_body.replace(/\\[([^\\]]+)\\]/g, (_, key) => {\n  return data[key] ?? \"\";\n});\n\nreturn {\n  email_subject,\n  email_body,\n};"
      },
      "typeVersion": 2
    },
