    {
      "id": "5134368f-108c-4381-933a-5ee3abe20f1b",
      "name": "Exclude Unwanted Titles",
      "type": "n8n-nodes-base.filter",
      "notes": "Drops titles matching Senior|Lead|Staff|Principal (case-insensitive, hard-coded).",
      "position": [
        1456,
        480
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-1",
              "operator": {
                "type": "string",
                "operation": "notRegex"
              },
              "leftValue": "={{ $json.job_title }}",
              "rightValue": "=/(Senior|Lead|Staff|Principal)/i"
            }
          ]
        }
      },
      "notesInFlow": false,
      "typeVersion": 2.2
    },
