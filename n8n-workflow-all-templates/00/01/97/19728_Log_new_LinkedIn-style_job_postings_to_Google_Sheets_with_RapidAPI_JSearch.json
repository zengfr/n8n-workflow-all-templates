    {
      "id": "55d585ea-89af-4abc-9099-c128b875be0c",
      "name": "Search Jobs (RapidAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "GET JSearch /search-v2 via RapidAPI. Only page 1 is fetched (page=1, num_pages=1).",
      "position": [
        1024,
        480
      ],
      "parameters": {
        "url": "   https://jsearch.p.rapidapi.com/search-v2",
        "options": {},
        "sendQuery": true,
        "sendHeaders": true,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.job_title + ' in ' + $json.location }}"
            },
            {
              "name": "page",
              "value": "1"
            },
            {
              "name": "num_pages",
              "value": "1"
            },
            {
              "name": "date_posted",
              "value": "={{ $json.date_posted }}"
            },
            {
              "name": "remote_jobs_only",
              "value": "={{ $json.remote_only }}"
            },
            {
              "name": "country",
              "value": "in"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Host",
              "value": "jsearch.p.rapidapi.com"
            }
          ]
        }
      },
      "notesInFlow": false,
      "typeVersion": 4.2
    },
    {
      "id": "527dce2b-e50f-478c-b77a-c491b185fa1f",
