        "respondWith": "showText",
        "responseText": "<h1>Check your brief</h1><p>Use a product name of 1–120 characters, an HTTPS reference-image URL, one of the listed scenes and ratios, and at most 1200 characters of additional instructions. Go back and correct the form.</p>"
      },
      "typeVersion": 2.4
    },
