    {
      "id": "894e72d4-8ec2-5c05-a177-ac184e15b1a5",
      "name": "Show prompt and manual creation steps",
      "type": "n8n-nodes-base.form",
      "position": [
        1200,
        0
      ],
      "webhookId": "aad00693-2e87-51c5-a460-b2e486d329c6",
      "parameters": {
        "options": {},
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "={{ '<h1>Your image brief is ready</h1><p><b>Task ID:</b> '+($('Build reusable image brief').first().json.brief_id).toString().replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\").replace(/'/g,\"&#39;\")+'<br><b>Scene:</b> '+($('Build reusable image brief').first().json.scene).toString().replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\").replace(/'/g,\"&#39;\")+'<br><b>Aspect ratio:</b> '+($('Build reusable image brief').first().json.aspect_ratio).toString().replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\").replace(/'/g,\"&#39;\")+'</p><h2>Copy this prompt</h2><pre>'+($('Build reusable image brief').first().json.prompt).toString().replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\").replace(/'/g,\"&#39;\")+'</pre><p>1. Open <a href=\"https://whisk-ai.io/\" target=\"_blank\" rel=\"noopener noreferrer\">Whisk AI</a>.<br>2. Upload your own product reference, paste the prompt, and generate an image manually.<br>3. Download the result and submit it with the task ID in the return form.</p><p><a href=\"' + $('Configure brief workspace').first().json.return_form_url.replace(/\"/g, '%22') + '\">Open asset return form</a></p><p>Review product shape, labels and logos before using an image. Whisk generation costs apply separately.</p>' }}"
      },
      "typeVersion": 2.4
    },
    {
      "id": "f60c29be-00a1-5c49-849a-c1460d30c9bd",
