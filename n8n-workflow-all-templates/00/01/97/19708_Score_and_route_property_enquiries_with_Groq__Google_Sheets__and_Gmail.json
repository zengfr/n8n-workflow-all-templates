      "parameters": {
        "color": 7,
        "width": 864,
        "height": 656,
        "content": "## Classify and score intent\n\nCentral processing cluster that flattens and classifies the enquirer, calls Groq AI to score buying intent, merges the AI score with the enquiry data, and provides a fallback score if the AI call fails."
      },
      "typeVersion": 1
    },
    {
      "id": "4f990672-1d87-48b7-88e2-03ad888a78dd",
      "name": "Sticky Note4",
