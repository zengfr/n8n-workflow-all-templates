    {
      "id": "a296757c-18a0-40b7-84d3-a9a6353cf5ec",
      "name": "Classify Enquirer Type",
      "type": "n8n-nodes-base.code",
      "position": [
        2864,
        784
      ],
      "parameters": {
        "jsCode": "// ----- 1. SAFE DATA EXTRACTION (Flatten) -----\nlet rawData = $input.first().json;\nlet bodyData = rawData.body || rawData.payload || rawData;\nlet email = bodyData.email || rawData.email;\nlet name = bodyData.name || rawData.name;\nlet phone = bodyData.phone || rawData.phone;\n\nif (!email) {\n    throw new Error('❌ Email is missing');\n}\n\n// ----- 2. DOMAIN CLASSIFICATION (Personal vs Business) -----\nconst freeDomains = [\n  'gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', \n  'protonmail.com', 'aol.com', 'icloud.com', 'mail.com', \n  'yandex.com', 'zoho.com'\n];\n\nlet domain = email.split('@')[1]?.toLowerCase();\nif (!domain) throw new Error('Invalid email format');\n\nconst isPersonal = freeDomains.includes(domain);\n\n// ----- 3. RETURN CLEAN FLAT DATA -----\nreturn {\n  json: {\n    name: name,\n    email: email,\n    phone: phone,\n    leadType: isPersonal ? 'Personal' : 'Business'\n  }\n};"
      },
      "typeVersion": 2
    },
