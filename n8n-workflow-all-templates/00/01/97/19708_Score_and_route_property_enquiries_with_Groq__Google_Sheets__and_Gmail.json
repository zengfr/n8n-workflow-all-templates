        1280,
        624
      ],
      "parameters": {
        "color": 7,
        "width": 512,
        "height": 320,
        "content": "## Receive and validate enquiry\n\nEntry cluster that receives a property enquiry from the website and checks whether the required email field is present before continuing."
      },
      "typeVersion": 1
    },
    {
