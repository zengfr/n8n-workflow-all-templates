    {
      "id": "61fc4984-af5b-4288-8de1-6be2558d3551",
      "name": "Post to Groq AI for Intent Score",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueErrorOutput",
      "position": [
        3184,
        784
      ],
      "parameters": {
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a lead scoring AI. Analyze the lead details and give a buying intent score from 1 to 10 (10 = highest intent). Return ONLY the single number. No explanations.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Name: {{ $json.name }}, Email: {{ $json.email }}, Phone: {{ $json.phone }}\"\n    }\n  ]\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi"
      },
      "typeVersion": 4.4
    },
    {
      "id": "dfbcb91a-7847-4fd5-963d-0527e7ce12b6",
      "name": "Integrate AI Score with Enquiry",
      "type": "n8n-nodes-base.code",
      "position": [
        3536,
        768
      ],
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json;\n\nconst scoreText = aiOutput.choices?.[0]?.message?.content \n  || aiOutput?.body?.choices?.[0]?.message?.content \n  || '0';\n\nconst score = parseInt(scoreText.trim()) || 0;\nconst originalData = $('Classify Enquirer Type').item.json;\n\nconst isScored = aiOutput.choices?.[0]?.message?.content ? true : false;\n\nreturn {\n  json: {\n    name: originalData.name,\n    email: originalData.email,\n    phone: originalData.phone,\n    leadType: originalData.leadType,\n    score: score,\n    scored: isScored\n  }\n};"
      },
      "typeVersion": 2
    },
