    {
      "id": "3a74a001-8747-4844-9aaa-b7094c750cf8",
      "name": "Send Enquiry Notification Email",
      "type": "n8n-nodes-base.gmail",
      "position": [
        6192,
        784
      ],
      "webhookId": "853fbed9-8b6e-4834-8cc5-9c8c2a1a2942",
      "parameters": {
        "message": "=<p>Hi Team,</p>\n<p>A new lead has just been registered. Here are the details:</p>\n\n<p><strong>📌 Source:</strong> Website Contact Form</p>\n\n<div style=\"background-color: #f9f9f9; padding: 15px; border-left: 4px solid #4caf50; margin: 15px 0;\">\n    <p style=\"margin: 5px 0;\"><strong>👤 Name:</strong> {{ $('Integrate AI Score with Enquiry').item.json.name }}</p>\n    <p style=\"margin: 5px 0;\"><strong>📧 Email:</strong> {{ $('Integrate AI Score with Enquiry').item.json.email }}</p>\n    <p style=\"margin: 5px 0;\"><strong>📞 Phone:</strong> {{ $('Integrate AI Score with Enquiry').item.json.phone }}</p>\n    <p style=\"margin: 5px 0;\"><strong>🏷️ Lead Type:</strong> {{ $('Integrate AI Score with Enquiry').item.json.leadType }}</p>\n    <p style=\"margin: 5px 0;\">\n        <strong>⭐ AI Score:</strong> {{ $('Integrate AI Score with Enquiry').item.json.score }}/10\n        {{ $('Integrate AI Score with Enquiry').item.json.scored == false ? ' <span style=\"color: #d9534f; font-size: 12px; font-weight: bold;\">⚠️ Default score (AI was unavailable)</span>' : '' }}\n    </p>\n</div>\n\n<p style=\"margin-top: 20px; color: #d9534f; font-weight: bold;\">⚠️ Immediate Action Required:</p>\n<p>Please follow up with this lead within 24 hours.</p>\n\n<hr>\n<p style=\"font-size: 12px; color: #777; font-style: italic;\">This email was sent automatically via n8n Lead Automation</p>",
        "options": {},
        "subject": "=New Lead Alert: {{ $json.name }}"
      },
