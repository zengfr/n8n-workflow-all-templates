      "position": [
        4368,
        560
      ],
      "parameters": {
        "color": 7,
        "height": 384,
        "content": "## Route by enquirer type\n\nIsolated routing decision that sends the enriched lead to the personal buyer or business investor storage path based on the earlier classification."
      },
      "typeVersion": 1
    },
    {
