    {
      "id": "8dc2b6e9-2ec8-496b-a187-1ec6e41e5b86",
      "name": "Prepare the chase",
      "type": "n8n-nodes-base.code",
      "position": [
        640,
        400
      ],
      "parameters": {
        "jsCode": "// Everything the chase needs is worked out once, here, so the rest of the workflow only reads it.\nconst s = $('Your settings').first().json;\nconst b = $('Quote sent').first().json.body || {};\n\nconst digits = String(b.phone || '').replace(/[^0-9]/g, '');\nlet phone = '';\nif (digits.length === 10) phone = '+1' + digits;\nelse if (digits.length === 11 && digits.startsWith('1')) phone = '+' + digits;\nelse if (digits.length > 11) phone = '+' + digits;\nconst pretty = phone ? phone.replace(/^\\+1(\\d{3})(\\d{3})(\\d{4})$/, '($1) $2-$3') : '';\n\nconst name = String(b.name || '').trim();\nconst who = name || 'there';\nconst amount = String(b.amount || '').trim();\nconst money = amount ? (amount.startsWith('$') ? amount : '$' + amount) : '';\nconst job = String(b.job || 'the work').trim();\nconst link = String(b.quote_url || '').trim();\n\n// Read the waits explicitly. A plain \"value || default\" would throw away a configured 0,\n// which is exactly what you set while testing.\nconst num = (v, dflt) => {\n  if (v === null || v === undefined || String(v).trim() === '') return dflt;\n  const n = Number(v);\n  return Number.isFinite(n) && n >= 0 ? n : dflt;\n};\nconst d1 = num(s.wait_1_days, 2), d2 = num(s.wait_2_days, 3), d3 = num(s.wait_3_days, 4);\n\nconst tz = s.timezone || 'America/New_York';\nconst now = DateTime.now().setZone(tz);\n// A wait of a day or more lands at 10am local, never overnight. A shorter wait fires as soon as it is due.\nconst at = (days) => days >= 1\n  ? now.plus({ days }).set({ hour: 10, minute: 0, second: 0, millisecond: 0 }).toUTC().toISO()\n  : now.plus({ days }).toUTC().toISO();\n\nconst fill = (t) => String(t || '')\n  .replace(/\\{name\\}/g, who).replace(/\\{business\\}/g, s.business_name || 'us')\n  .replace(/\\{amount\\}/g, money).replace(/\\{job\\}/g, job).replace(/\\{link\\}/g, link)\n  .replace(/\\s+/g, ' ').trim();\n\nreturn [{ json: {\n  ok: !!phone && !!s.business_number && !!s.owner_cell,\n  phone, pretty, name: who, amount: money, job,\n  business_number: s.business_number,\n  owner_cell: s.owner_cell,\n  started_at: now.toUTC().toISO(),\n  // Twilio filters by calendar day, so ask for everything since yesterday and compare exact times after.\n  since_day: now.toUTC().minus({ days: 1 }).toFormat('yyyy-MM-dd'),\n  nudge_1: fill(s.nudge_1_text), nudge_2: fill(s.nudge_2_text), nudge_3: fill(s.nudge_3_text),\n  nudge_1_at: at(d1), nudge_2_at: at(d1 + d2), nudge_3_at: at(d1 + d2 + d3),\n  owner_start: 'Quote chase started: ' + who + ' ' + pretty + (money ? ', ' + money : '') + ', ' + job + '.',\n  owner_replied: who + ' ' + pretty + ' replied about the ' + job + ' quote. Chase stopped, over to you.',\n  owner_done: who + ' ' + pretty + ' never replied about the ' + job + ' quote. Three texts sent, chase closed.'\n} }];"
      },
      "typeVersion": 2
    },
