              "value": 2
            },
            {
              "id": "d103dd44-453a-4be5-8c81-1b985908c73d",
              "name": "wait_2_days",
              "type": "number",
              "value": 3
            },
            {
              "id": "a6fa40bc-a973-49e9-b30f-c1f353ee5771",
              "name": "wait_3_days",
              "type": "number",
              "value": 4
            },
            {
              "id": "4aeb9e31-4e22-4a79-8d26-8eceee66f5cc",
              "name": "nudge_1_text",
              "type": "string",
              "value": "Hi {name}, just checking you got the quote from {business} for {job}. Any questions at all, reply here."
            },
            {
              "id": "331c3eeb-d3e6-480e-8a79-95159e861490",
              "name": "nudge_2_text",
              "type": "string",
              "value": "Hi {name}, following up on the {job} quote. Happy to walk through it or adjust the scope if the number is off. Just reply."
            },
            {
              "id": "68f9e46e-abc0-4bd6-b50f-855a69d3744e",
              "name": "nudge_3_text",
              "type": "string",
              "value": "Last one from me {name}. If the timing is not right, no problem. If you want to go ahead, just reply and we will get you booked in."
