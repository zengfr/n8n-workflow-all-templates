    {
      "id": "90a746c1-4cb0-4a5b-ab77-9701566dced8",
      "name": "Normalize Incoming Data",
      "type": "n8n-nodes-base.code",
      "position": [
        944,
        384
      ],
      "parameters": {
        "jsCode": "const incoming=$input.first().json; const body=incoming.body||incoming;\nconst mode=String(body.mode||'').trim(); if(!['event','speaker'].includes(mode)) throw new Error('mode must be event or speaker');\nconst rawLimit=Number(body.max_results); const max_results=Number.isFinite(rawLimit)&&rawLimit>0?Math.min(Math.floor(rawLimit),25):10;\nconst email=String(body.email||'').trim()||null;\nconst location=String(body.location||'').trim();\nif(mode==='event'){ const industry=String(body.industry||'').trim(); if(!industry) throw new Error('industry is required'); return [{json:{mode,email,max_results,industry,location,vendor_type:String(body.vendor_type||'vendor').trim()}}]; }\nconst topic=String(body.topic||'').trim(); if(!topic) throw new Error('topic is required');\nreturn [{json:{mode,email,max_results,topic,context:String(body.context||'').trim(),location}}];"
      },
      "typeVersion": 2
    },
