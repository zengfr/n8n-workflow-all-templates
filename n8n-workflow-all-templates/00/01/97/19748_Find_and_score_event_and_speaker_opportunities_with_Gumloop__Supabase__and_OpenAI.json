    {
      "id": "f23d1174-f92d-4837-a2fd-2acc6d69485d",
      "name": "Evaluate Event Scoring",
      "type": "n8n-nodes-base.code",
      "position": [
        1712,
        1072
      ],
      "parameters": {
        "jsCode": "const {request_id,results,email}=$input.first().json;\nconst scored=results.map(r=>{const d=r.deadline?new Date(r.deadline):null; const days=d&&!isNaN(d)?Math.ceil((d.getTime()-Date.now())/86400000):null; const score=days===null?50:days<=14?95:days<=30?85:days<=60?70:50; return {title:r.event_name||'Untitled event',score,reason:days===null?'Deadline not stated; verify before applying.':`Submission deadline in ${days} day(s).`,detail:`Accepting: ${r.vendor_type_accepted||'unspecified'}${r.location?' — '+r.location:''}`,source_url:r.source_url||'',days};}).filter(r=>r.days===null||r.days>=0).map(({days,...r})=>r).sort((a,b)=>b.score-a.score);\nreturn [{json:{request_id,scored_results:scored,email}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "e2f4c6e5-4c59-4203-96ac-526f078a77c9",
      "name": "Evaluate Speaker Scoring",
      "type": "n8n-nodes-base.code",
      "position": [
        1712,
        1264
      ],
      "parameters": {
        "jsCode": "const {request_id,results,email}=$input.first().json;\nconst scored=results.map(r=>{const d=r.date?new Date(r.date):null; const days=d&&!isNaN(d)?Math.floor((Date.now()-d.getTime())/86400000):null; const score=days===null?60:days<=30?90:days<=90?75:55; return {title:r.person_name||'Unknown speaker',score,reason:r.title_or_role?`${r.title_or_role}${days!==null?' — discussed this '+days+' day(s) ago':''}`:'Discussed this topic publicly.',detail:r.snippet||r.publication_or_platform||'',source_url:r.source_url||''};}).sort((a,b)=>b.score-a.score); return [{json:{request_id,scored_results:scored,email}}];"
      },
      "typeVersion": 2
