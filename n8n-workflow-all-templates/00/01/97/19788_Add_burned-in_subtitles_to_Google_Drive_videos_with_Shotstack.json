            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 10 seconds": {
      "main": [
        [
          {
            "node": "Check the render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check the render": {
