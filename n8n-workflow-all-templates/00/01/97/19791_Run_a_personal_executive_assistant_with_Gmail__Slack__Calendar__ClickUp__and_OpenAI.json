      "id": "a87c0fd8-61f5-40c5-8f7d-71b161f68e36",
      "name": "Detect Calendar Conflicts",
      "type": "n8n-nodes-base.code",
      "position": [
        1744,
        6832
      ],
      "parameters": {
        "jsCode": "const ev = $input.all().map(i=>i.json).sort((a,b)=>new Date(a.start.dateTime)-new Date(b.start.dateTime));\nconst out=[];\nfor(let i=0;i<ev.length-1;i++){ if(new Date(ev[i+1].start.dateTime) < new Date(ev[i].end.dateTime)) out.push({eventA: ev[i], eventB: ev[i+1]}); }\nreturn out.map(c=>({json:c}));"
      },
      "typeVersion": 2
    },
