    {
      "id": "0f6fab77-6c60-4b2d-b56a-21784e82132d",
      "name": "Prepare Search Results",
      "type": "n8n-nodes-base.code",
      "position": [
        2672,
        432
      ],
      "parameters": {
        "jsCode": "const results = $input.first().json.query.search || [];\n\nreturn results.map(item => ({\n  json: {\n    title: item.title,\n    url: `https://en.wikipedia.org/wiki/${encodeURIComponent(item.title.replace(/ /g, '_'))}`,\n    snippet: item.snippet\n      ? item.snippet.replace(/<[^>]*>/g, '')\n      : '',\n    pageId: item.pageid,\n    timestamp: item.timestamp\n  }\n}));\n"
      },
      "typeVersion": 2
    },
    {
      "id": "b05799ce-6ad9-4f2f-9c00-e085366c5e46",
      "name": "Clean Website Content",
      "type": "n8n-nodes-base.code",
      "position": [
        3808,
        448
      ],
      "parameters": {
        "jsCode": "const response = $json;\n\nconst pages = response.query?.pages || {};\nconst page = Object.values(pages)[0];\n\nconst original = $('Process Search Results').item.json;\n\nreturn [\n  {\n    json: {\n      title: original.title,\n      url: original.url,\n      snippet: original.snippet,\n      pageId: original.pageId,\n      content: page?.extract || ''\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
