        },
        "options": {},
        "responses": {
          "values": [
            {
              "content": "=You are an AI research assistant.\n\nResearch Topic:\n{{ $json.title }}\n\nAnalyze the collected research information below.\n\nProvide:\n\n1. Executive Summary\n2. Key Findings\n3. Important Facts\n4. Benefits\n5. Challenges\n6. Latest Trends\n7. Future Outlook\n8. Source References\n\nKey Insights\n\nAdvantages\nDisadvantages\nLatest Trends\nReferences\n\nUse only information supported by the provided research content.\n\nResearch Content:\n{{$json.content}}"
            }
          ]
        },
        "builtInTools": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "yOfw9W9XwQefVROR",
          "name": "OpenAI (PAID) (AI-ML Team)"
        }
      },
      "typeVersion": 2.3
    },
    {
      "id": "9288476f-bc5c-4f74-9d00-99d2ab7bafa4",
      "name": "Research Report Formatter",
      "type": "n8n-nodes-base.code",
      "position": [
        4864,
        448
      ],
      "parameters": {
        "jsCode": "const report = $json.output?.[0]?.content?.[0]?.text || '';\n\nif (!report) {\n  throw new Error('AI research report is empty.');\n}\n\nfunction extractSection(text, heading, nextHeadings = []) {\n  const escapedHeading = heading.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n\n  let pattern = `###\\\\s*${escapedHeading}\\\\s*\\\\n([\\\\s\\\\S]*?)`;\n\n  if (nextHeadings.length > 0) {\n    const nextPattern = nextHeadings\n      .map(h => `###\\\\s*${h.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}`)\n      .join('|');\n\n    pattern += `(?=\\\\n(?:${nextPattern})|$)`;\n  } else {\n    pattern += '$';\n  }\n\n  const match = text.match(new RegExp(pattern, 'i'));\n\n  return match ? match[1].trim() : '';\n}\n\nconst headings = [\n  'Executive Summary',\n  'Key Findings',\n  'Important Facts',\n  'Benefits',\n  'Challenges',\n  'Latest Trends',\n  'Future Outlook',\n  'Source References'\n];\n\nreturn [\n  {\n    json: {\n      topic: $('Merge Research Data').first().json.title,\n      report: report.trim(),\n\n      executiveSummary: extractSection(\n        report,\n        'Executive Summary',\n        headings.slice(1)\n      ),\n\n      keyFindings: extractSection(\n        report,\n        'Key Findings',\n        headings.slice(2)\n      ),\n\n      importantFacts: extractSection(\n        report,\n        'Important Facts',\n        headings.slice(3)\n      ),\n\n      benefits: extractSection(\n        report,\n        'Benefits',\n        headings.slice(4)\n      ),\n\n      challenges: extractSection(\n        report,\n        'Challenges',\n        headings.slice(5)\n      ),\n\n      latestTrends: extractSection(\n        report,\n        'Latest Trends',\n        headings.slice(6)\n      ),\n\n      futureOutlook: extractSection(\n        report,\n        'Future Outlook',\n        headings.slice(7)\n      ),\n\n      sourceReferences: extractSection(\n        report,\n        'Source References'\n      ),\n\n      generatedAt: new Date().toISOString()\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
    {
