    {
      "id": "fb52d4ca-1eb7-4d93-8988-1d49e6271d6f",
      "name": "Parse Search Queries",
      "type": "n8n-nodes-base.code",
      "position": [
        1984,
        432
      ],
      "parameters": {
        "jsCode": "const text = $json.output?.[0]?.content?.[0]?.text || '';\n\nconst cleaned = text\n  .replace(/```json\\s*/i, '')\n  .replace(/```\\s*/g, '')\n  .trim();\n\nconst queries = JSON.parse(cleaned);\n\nreturn queries.map(query => ({\n  json: {\n    query\n  }\n}));"
      },
      "typeVersion": 2
    },
    {
      "id": "259bb380-00ce-4c92-a3ce-e9eea9ccc7df",
      "name": "Sticky Note10",
