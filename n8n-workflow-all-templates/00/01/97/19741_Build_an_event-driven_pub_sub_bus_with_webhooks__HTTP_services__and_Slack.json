    {
      "id": "5d125a85-60ac-4ca8-bf84-48e60d83fb6c",
      "name": "Code 1 - Validate & Enrich Envelope",
      "type": "n8n-nodes-base.code",
      "position": [
        1008,
        256
      ],
      "parameters": {
        "jsCode": "// Normalize whichever ingress fired (webhook body vs execute-workflow inputs)\n// into one event envelope shape, validate required fields, and stamp metadata.\nconst crypto = require('crypto');\nconst cfg = $('Set - Event Bus Config').first().json;\nconst raw = $input.first().json;\n\n// Webhook puts the payload under `body`; Execute Workflow Trigger exposes fields directly.\nconst src = raw.body ? raw.body : raw;\n\nconst eventType = src.eventType || '';\nconst source = src.source || 'unknown';\nconst payload = src.payload !== undefined ? src.payload : {};\nconst eventId = src.eventId || crypto.randomUUID();\nconst timestamp = src.timestamp || new Date().toISOString();\n\nconst missingFields = [];\nif (!eventType) missingFields.push('eventType');\nif (payload === undefined) missingFields.push('payload');\n\nconst valid = missingFields.length === 0;\n\nreturn [{\n  json: {\n    ...cfg,\n    eventId,\n    eventType,\n    source,\n    payload,\n    timestamp,\n    receivedAtIso: new Date().toISOString(),\n    valid,\n    missingFields\n  }\n}];"
      },
      "typeVersion": 2
    },
