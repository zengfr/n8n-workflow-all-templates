    {
      "id": "3e7c9721-cc95-4352-9ddc-b5d035e1f8a0",
      "name": "Code - Compute Backoff & Retry Count",
      "type": "n8n-nodes-base.code",
      "position": [
        2800,
        176
      ],
      "parameters": {
        "jsCode": "// Track delivery attempts per (eventId + eventType branch) in workflow static\n// data, and decide whether to retry (with exponential backoff) or send to DLQ.\nconst item = $input.first().json;\nconst staticData = $getWorkflowStaticData('node');\nif (!staticData.attempts) staticData.attempts = {};\n\nconst attemptKey = item.eventId + '::' + item.eventType;\nconst maxAttempts = item.maxRetryAttempts || 3;\nconst baseDelay = item.baseBackoffSeconds || 5;\n\nconst currentAttempts = (staticData.attempts[attemptKey] || 0) + 1;\nstaticData.attempts[attemptKey] = currentAttempts;\n\nconst attemptsExhausted = currentAttempts >= maxAttempts;\nconst backoffSeconds = attemptsExhausted ? 0 : baseDelay * Math.pow(2, currentAttempts - 1);\n\nif (attemptsExhausted) {\n  delete staticData.attempts[attemptKey];\n}\n\nreturn [{\n  json: {\n    ...item,\n    currentAttempts,\n    maxAttempts,\n    attemptsExhausted,\n    backoffSeconds\n  }\n}];"
      },
      "typeVersion": 2
    },
