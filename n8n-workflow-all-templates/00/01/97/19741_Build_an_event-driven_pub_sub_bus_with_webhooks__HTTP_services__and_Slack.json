    {
      "id": "3db5a057-d9c2-4424-9c3f-5597dd3bc1c1",
      "name": "Code - Tag Subscriber & Outcome",
      "type": "n8n-nodes-base.code",
      "position": [
        2352,
        80
      ],
      "parameters": {
        "jsCode": "// Determine which subscriber this branch was, and whether the HTTP call succeeded,\n// using n8n's error output shape (continueOnFail routes errors into the same output\n// with an `error` field present).\nconst item = $input.first().json;\nconst nodeName = $execution.customData?.get?.('lastSubscriberNode') || null;\n\n// Identify the source node for this item to know which subscriber it came from.\nconst sourceNodeName = $input.first().pairedItem\n  ? $('Switch - Route by Event Type').first()?.json?.eventType\n  : null;\n\nconst hasError = item.error !== undefined;\n\nreturn [{\n  json: {\n    ...item,\n    deliveryFailed: hasError,\n    deliveryErrorMessage: hasError ? (item.error?.message || String(item.error)) : null\n  }\n}];"
      },
      "typeVersion": 2
    },
