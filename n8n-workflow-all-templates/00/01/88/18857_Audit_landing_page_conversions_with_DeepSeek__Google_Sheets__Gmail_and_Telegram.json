    {
      "id": "parse-ai-audit",
      "name": "Parse AI Audit",
      "type": "n8n-nodes-base.code",
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $json.output || '';\nconst m = raw.match(/\\{[\\s\\S]*\\}/);\nlet parsed;\ntry {\n  parsed = JSON.parse(m ? m[0] : raw);\n} catch (e) {\n  throw new Error('AI audit response was not valid JSON: ' + String(raw).slice(0, 200));\n}\nconst recs = Array.isArray(parsed.recommendations) ? parsed.recommendations : [];\nconst score = Math.max(0, Math.min(100, Number(parsed.overall_score) || 0));\nconst grade = score >= 90 ? 'A' : score >= 80 ? 'B' : score >= 75 ? 'C' : score >= 60 ? 'D' : 'F';\nconst recText = recs.map((r, i) =>\n  (i + 1) + '. [' + (r.priority || ('P' + (i + 1))) + '] ' + (r.title || '') +\n  '\\n   Why: ' + (r.why || '') +\n  '\\n   Do this: ' + (r.fix || '') +\n  '\\n   Effort: ' + (r.effort || '?') + ' | Impact: ' + (r.impact || '?')\n).join('\\n\\n');\nconst base = $('Normalize Request').first().json;\nreturn [{ json: Object.assign({}, base, {\n  overall_score: score,\n  grade: grade,\n  roast_summary: parsed.roast_summary || '',\n  sub_scores_json: JSON.stringify(parsed.sub_scores || {}),\n  top_issue: recs.length && recs[0] ? (recs[0].title || 'See full report') : 'See full report',\n  recommendation_count: recs.length,\n  recommendations_text: recText || 'No recommendations returned.',\n  recommendations_json: JSON.stringify(recs)\n}) }];"
      },
      "typeVersion": 2
    },
