    {
      "id": "compute-weekly-stats",
      "name": "Compute Weekly Stats",
      "type": "n8n-nodes-base.code",
      "position": [
        240,
        656
      ],
      "parameters": {
        "jsCode": "const cutoff = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();\nconst rows = items.map(i => i.json).filter(r => r.audited_at && r.audited_at >= cutoff);\nif (!rows.length) {\n  return [{ json: { digest_date: new Date().toISOString().slice(0, 10), audit_count: 0, avg_score: 0, min_score: 0, worst_url: '', lines: 'No audits were run in the last 7 days.' } }];\n}\nconst scores = rows.map(r => Number(r.overall_score) || 0);\nconst worst = rows.reduce((a, b) => (Number(b.overall_score) || 0) < (Number(a.overall_score) || 0) ? b : a);\nreturn [{ json: {\n  digest_date: new Date().toISOString().slice(0, 10),\n  audit_count: rows.length,\n  avg_score: Math.round(scores.reduce((a, b) => a + b, 0) / scores.length),\n  min_score: Math.min.apply(null, scores),\n  worst_url: worst.url || '',\n  lines: rows.map(r => '- ' + String(r.audited_at).slice(0, 10) + ' | ' + r.url + ' | score ' + r.overall_score + '/100 (' + r.grade + ') | top issue: ' + r.top_issue).join('\\n')\n} }];"
      },
      "typeVersion": 2
    },
