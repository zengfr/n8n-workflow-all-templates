              "id": "f5",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $('Set Workflow Configurations').first().json.only_fill_empty === false || !($json.settings && $json.settings.errorWorkflow) }}",
              "rightValue": true
            },
            {
              "id": "f1",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": "={{ $json.settings && $json.settings.errorWorkflow ? $json.settings.errorWorkflow : 'none' }}",
              "rightValue": "={{ $('Set Workflow Configurations').first().json.error_workflow_id }}"
            },
            {
              "id": "f2",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": "={{ $json.id }}",
              "rightValue": "={{ $('Set Workflow Configurations').first().json.error_workflow_id }}"
            },
            {
              "id": "f3",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "leftValue": "={{ $json.isArchived === true }}",
              "rightValue": false
            },
            {
              "id": "f4",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "leftValue": "={{ ($json.tags || []).some(t => t.name === $('Set Workflow Configurations').first().json.exclusion_tag) }}",
              "rightValue": false
            }
          ]
        }
      },
      "typeVersion": 2
    },
