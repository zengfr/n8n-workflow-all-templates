        },
        "options": {}
      },
      "typeVersion": 1.3
    },
    {
      "id": "69d4ac9a-0569-4bc4-baa9-dc386b79cf02",
      "name": "Parse Action Items Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1824,
        656
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"actionItems\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"owner\": {\"type\": \"string\"},\n          \"task\": {\"type\": \"string\"},\n          \"deadline\": {\"type\": \"string\"},\n          \"priority\": {\"type\": \"string\", \"enum\": [\"high\", \"medium\", \"low\"]}\n        }\n      }\n    }\n  }\n}"
      },
      "typeVersion": 1.3
    },
