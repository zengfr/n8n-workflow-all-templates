    {
      "id": "c750e970-4e96-4675-9f64-51d3479b9c8e",
      "name": "Analyze Meeting Content Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1280,
        656
      ],
      "parameters": {
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "You are a meeting intelligence assistant that analyzes meeting transcripts.\n\nYour task is to:\n1. Extract all attendee names and email addresses (if mentioned)\n2. Identify the main topics discussed\n3. List all decisions made during the meeting\n4. Extract action items with owners and deadlines\n5. Analyze the overall sentiment of the meeting (positive, neutral, negative)\n6. Identify any relationship health signals for account management\n\nReturn the analysis in the structured JSON format defined by the output parser."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3
    },
    {
      "id": "99317265-4735-4a95-8e21-ca8233bb6d23",
      "name": "Claude Analyzer Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "position": [
        1280,
        880
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-4-5-20250929",
          "cachedResultName": "Claude Sonnet 4.5"
        },
        "options": {}
      },
      "typeVersion": 1.3
    },
    {
      "id": "0c379d95-8bb7-47e4-b740-5437d3aa5d50",
      "name": "Parse Meeting Data Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1408,
        880
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"attendees\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\"type\": \"string\"},\n          \"email\": {\"type\": \"string\"}\n        }\n      }\n    },\n    \"topics\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    \"decisions\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    \"actionItems\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"task\": {\"type\": \"string\"},\n          \"owner\": {\"type\": \"string\"},\n          \"deadline\": {\"type\": \"string\"}\n        }\n      }\n    },\n    \"sentiment\": {\"type\": \"string\"},\n    \"relationshipSignals\": {\"type\": \"string\"}\n  }\n}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "ff5c524c-b7a3-409c-a94e-42d50bf26a10",
      "name": "Format Action Items Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1664,
        432
      ],
      "parameters": {
        "text": "={{ $json.output }}",
        "options": {
          "systemMessage": "You are an action item formatter that structures meeting action items.\n\nYour task is to:\n1. Take the action items from the meeting analysis\n2. Format each action item with: owner, task description, deadline, and priority level\n3. Ensure owner names match attendee names from the meeting\n4. Assign priority based on urgency mentioned in the meeting (high, medium, low)\n5. Format deadlines in ISO 8601 format (YYYY-MM-DD)\n\nReturn the formatted action items in the structured JSON format defined by the output parser."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3
    },
    {
      "id": "f2b02adb-cc5b-42ad-9280-5ba5e61ad0ba",
      "name": "Claude Formatter Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "position": [
        1696,
        656
