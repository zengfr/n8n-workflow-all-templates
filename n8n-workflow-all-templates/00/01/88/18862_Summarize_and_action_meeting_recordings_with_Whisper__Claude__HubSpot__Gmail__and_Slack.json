    {
      "id": "42fd8e44-10f9-48e1-a620-841ee359fd47",
      "name": "Draft Follow-up Emails Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2912,
        128
      ],
      "parameters": {
        "text": "={{ 'Attendee: ' + $json.name + '\\nEmail: ' + $json.email + '\\n\\nMeeting Transcript: ' + $('Transcribe Audio with Whisper').first().json.text + '\\n\\nAction Items for this attendee: ' + $('Format Action Items Agent').first().json.output.actionItems.filter(item => item.owner === $json.name).map(item => item.task + ' (Due: ' + item.deadline + ')').join('\\n') }}",
        "options": {
          "systemMessage": "You are a professional email writer that drafts personalized follow-up emails after meetings.\n\nYour task is to:\n1. Write a personalized follow-up email for the specific attendee\n2. Reference their specific action items with deadlines\n3. Mention key decisions that are relevant to them\n4. Keep a professional but friendly tone\n5. Include a clear subject line\n6. Format the email in HTML\n\nReturn ONLY the HTML email content without any additional text or explanations."
        },
        "promptType": "define"
      },
      "typeVersion": 3
    },
