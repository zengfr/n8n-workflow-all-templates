    {
      "id": "1e340f81-0668-46cf-bb0b-d23ef9b26333",
      "name": "Merge Enrichment",
      "type": "n8n-nodes-base.code",
      "position": [
        -1232,
        384
      ],
      "parameters": {
        "jsCode": "const lead = $('Clean & Validate Lead').item.json;\nlet companyMatch = null;\ntry {\n  const results = $input.item.json;\n  if (Array.isArray(results) && results.length > 0) {\n    companyMatch = results[0];\n  } else if (Array.isArray(results.body) && results.body.length > 0) {\n    companyMatch = results.body[0];\n  }\n} catch (e) {}\n\nreturn [{\n  json: {\n    ...lead,\n    company_domain_guess: companyMatch?.domain || lead.domain,\n    company_logo: companyMatch?.logo || null,\n    enrichment_found: !!companyMatch\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "f51bc051-735c-4960-8f7c-d3035a01898b",
      "name": "AI Lead Qualification",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "onError": "continueErrorOutput",
      "position": [
        -960,
        384
      ],
      "parameters": {
        "text": "=Analyze the following lead and return a JSON response with:\n\n* lead_score (1-100)\n* category (Hot, Warm, Cold)\n* summary (exactly 4 short bullet-point style statements, each under 10 words)\n* recommended_action (one concise sentence)\n* suggested_owner (Sales or Nurture)\n* follow_up_in_days (integer - how soon to follow up)\n\nScoring Guidelines:\n\n* Hot (70-100): Clear buying intent, urgency, budget stated, or a decision timeline.\n* Warm (40-69): Interest shown but missing urgency, budget, or firm commitment.\n* Cold (1-39): Researching, unclear intent, free/personal email domain, or insufficient information.\n\nLead Information:\n\nName: {{ $json.name }}\nCompany: {{ $json.company }}\nCompany Domain: {{ $json.company_domain_guess }}\nUses Free/Personal Email: {{ $json.is_free_email }}\nBudget Range: {{ $json.budget }}\nTimeline: {{ $json.timeline }}\nMessage: {{ $json.message }}\n",
        "options": {
          "systemMessage": "You are an expert B2B sales lead qualification assistant. Score leads on buying intent, stated budget, timeline urgency, company legitimacy (business domain vs. free email), and message specificity. Weight explicit budget/timeline signals heavily. Free-email-domain leads with vague messages should rarely score above Warm."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
