    {
      "id": "63191cee-c368-4b12-b8f0-7cbe60e4cbe9",
      "name": "Clean & Validate Lead",
      "type": "n8n-nodes-base.code",
      "position": [
        -2416,
        688
      ],
      "parameters": {
        "jsCode": "const item = $input.item.json;\n\nconst name = (item['Full Name'] || '').trim();\nconst email = (item['Work Email'] || '').trim().toLowerCase();\nconst company = (item['Company'] || '').trim();\nconst message = (item['What are you looking to automate?'] || '').trim();\nconst budget = item['Budget Range'] || 'Not provided';\nconst timeline = item['Timeline'] || 'Not provided';\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst isValidEmail = emailRegex.test(email);\n\nconst freeDomains = ['gmail.com','yahoo.com','hotmail.com','outlook.com','icloud.com'];\nconst domain = email.split('@')[1] || '';\nconst isFreeEmail = freeDomains.includes(domain);\n\nreturn [{\n  json: {\n    name,\n    email,\n    company,\n    message,\n    budget,\n    timeline,\n    domain,\n    is_valid_email: isValidEmail,\n    is_free_email: isFreeEmail,\n    submitted_at: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
