    {
      "id": "f0285136-de47-4952-b9a9-51ed5560d64c",
      "name": "Prepare Diff Prompt",
      "type": "n8n-nodes-base.set",
      "position": [
        12176,
        3056
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "543ac0d1-6e0d-4fbb-aed4-9e2ea8b04d76",
              "name": "prompt",
              "type": "string",
              "value": "={{ 'You are a change-detection assistant. Below are two text snapshots of the same web page, taken at different times.\\nIf OLD SNAPSHOT is empty, this is the first time this page has been recorded: reply with exactly: BASELINE SAVED\\nOtherwise, say in plain English what ACTUALLY changed. Be specific about prices, numbers, dates, and items that were added or removed.\\nMaximum 3 short bullet points. No preamble.\\nIf the difference is only cosmetic or meaningless, reply with exactly: NO MEANINGFUL CHANGE\\n\\nPAGE: ' + $json.name + '\\nURL: ' + $json.url + '\\n\\n--- OLD SNAPSHOT ---\\n' + $json.old_snapshot + '\\n\\n--- NEW SNAPSHOT ---\\n' + $json.new_snapshot }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
