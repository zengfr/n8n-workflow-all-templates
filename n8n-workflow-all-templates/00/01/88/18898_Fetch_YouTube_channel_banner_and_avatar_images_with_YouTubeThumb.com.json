    {
      "id": "a1c0e110-1111-4a11-8a11-000000000003",
      "name": "Lookup public channel images",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1240,
        320
      ],
      "parameters": {
        "url": "https://youtubethumb.com/api/channel-images",
        "method": "GET",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.youtubeUrl }}"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "a1c0e110-1111-4a11-8a11-000000000004",
      "name": "Lookup succeeded?",
      "type": "n8n-nodes-base.if",
      "position": [
        1800,
        320
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "ok-true",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.ok }}",
              "rightValue": true
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "a1c0e110-1111-4a11-8a11-000000000005",
      "name": "Pick largest banner and avatar",
      "type": "n8n-nodes-base.code",
      "position": [
        2300,
        320
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst banners = Array.isArray(data.banners) ? data.banners : [];\nconst avatars = Array.isArray(data.avatars) ? data.avatars : [];\nconst largest = (items) =>\n  items\n    .slice()\n    .sort((a, b) => (Number(b.width) * Number(b.height)) - (Number(a.width) * Number(a.height)))[0] || null;\n\nreturn [{\n  json: {\n    ok: true,\n    title: data.title || '',\n    handle: data.handle || '',\n    channelId: data.channelId || '',\n    channelUrl: data.channelUrl || '',\n    bannerCount: banners.length,\n    avatarCount: avatars.length,\n    largestBanner: largest(banners),\n    largestAvatar: largest(avatars),\n    banners,\n    avatars,\n  },\n}];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "a1c0e110-1111-4a11-8a11-000000000006",
      "name": "Has a public banner?",
      "type": "n8n-nodes-base.if",
      "position": [
        2640,
        320
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "banner-url",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.largestBanner.url }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "a1c0e110-1111-4a11-8a11-000000000007",
      "name": "Download largest banner JPG",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        3160,
        320
      ],
      "parameters": {
        "url": "=https://youtubethumb.com/api/channel-image-file?url={{ encodeURIComponent($json.largestBanner.url) }}",
        "method": "GET",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "a1c0e110-1111-4a11-8a11-000000000008",
