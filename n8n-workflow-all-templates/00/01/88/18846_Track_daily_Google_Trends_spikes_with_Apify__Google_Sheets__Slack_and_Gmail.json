    {
      "id": "07364258-a1c4-4273-d485-767081920315",
      "name": "Rank trends and build digest",
      "type": "n8n-nodes-base.code",
      "position": [
        400,
        434
      ],
      "parameters": {
        "jsCode": "// Rank the day's new trends and prepare the Slack digest and the spike alert.\n// Items follow the Google Trends Scraper dataset schema (type = \"trending_now\").\nconst settings = $('Workflow settings').first().json;\nconst TOP_N = Number(settings.topN) || 10;\nconst SPIKE_VOLUME = Number(settings.spikeVolume) || 500000;\n\nconst rows = $input.all().map((item) => item.json);\nconst sorted = [...rows].sort((a, b) => (b.search_volume || 0) - (a.search_volume || 0));\nconst top = sorted.slice(0, TOP_N);\nconst spikes = sorted.filter((row) => (row.search_volume || 0) >= SPIKE_VOLUME);\n\nconst today = new Date().toISOString().slice(0, 10);\nconst geos = [...new Set(sorted.map((t) => t.geo))].filter(Boolean).join(', ');\n\nconst line = (t) => {\n  const volume = t.formatted_volume ? ` (${t.formatted_volume} searches)` : '';\n  const category = t.category ? ` · ${t.category}` : '';\n  const status = t.is_active ? '' : ' (already ended)';\n  const link = t.trends_url ? ` <${t.trends_url}|explore>` : '';\n  return `• *${t.term}*${volume}${category}${status}${link}`;\n};\n\nconst message = [\n  `:chart_with_upwards_trend: *New Google Trends: ${geos}, ${today}*`,\n  ...top.map(line),\n].join('\\n');\n\nconst spikeLead = spikes[0];\nconst spikeSubject = spikeLead\n  ? `Google Trends spike: ${spikeLead.term} (${spikeLead.formatted_volume || spikeLead.search_volume} searches)`\n  : '';\nconst spikeBody = spikeLead\n  ? [\n      `These trends crossed your spike threshold today (${geos}, ${today}):`,\n      '',\n      ...spikes.map((t) => `- ${t.term}: ${t.formatted_volume || t.search_volume} searches${t.category ? ', ' + t.category : ''}${t.trends_url ? ', ' + t.trends_url : ''}`),\n      '',\n      'The threshold and this recipient live in the Workflow settings node of the n8n workflow.',\n    ].join('\\n')\n  : '';\n\nreturn [{ json: { newCount: rows.length, spikeCount: spikes.length, message, spikeSubject, spikeBody } }];"
      },
      "typeVersion": 2
    },
