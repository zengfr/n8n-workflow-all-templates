{
  "nodes": [
    {
      "id": "Every_Monday_at_07:00",
      "name": "Every Monday at 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "Set_the_pages_to_archive",
      "name": "Set the pages to archive",
      "type": "n8n-nodes-base.set",
      "position": [
        280,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "pages",
              "type": "array",
              "value": "[\"https://n8n.io/\",\"https://pdf.mintapis.com/\",\"https://pdf.mintapis.com/docs\"]"
            },
            {
              "id": "a2",
              "name": "archiveName",
              "type": "string",
              "value": "Web page archive"
            }
          ]
        },
        "includeOtherFields": false
      },
      "typeVersion": 3.4
    },
    {
      "id": "Check_the_list_is_usable",
      "name": "Check the list is usable",
      "type": "n8n-nodes-base.if",
      "position": [
        560,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "l1",
              "operator": {
                "type": "array",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.pages }}",
              "rightValue": ""
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "Check_remaining_quota",
      "name": "Check remaining quota",
      "type": "n8n-nodes-pdfmint.pdfMint",
      "onError": "continueRegularOutput",
      "position": [
        900,
        -80
      ],
      "parameters": {
        "operation": "usage"
      },
      "typeVersion": 1
    },
    {
      "id": "Enough_credits_for_this_run?",
      "name": "Enough credits for this run?",
      "type": "n8n-nodes-base.if",
      "position": [
        1180,
        -80
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "q1",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": "={{ $json.credits_remaining }}",
              "rightValue": "={{ $('Set the pages to archive').first().json.pages.length + 1 }}"
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "Name_this_week's_archive",
      "name": "Name this week's archive",
      "type": "n8n-nodes-base.code",
      "position": [
        1520,
        -80
      ],
      "parameters": {
        "jsCode": "// One credit per page plus one for the merge. Naming the archive here means the\n// merge node and the summary both read the same string.\nconst src = $('Set the pages to archive').first().json;\nconst pages = src.pages;\nconst now = new Date();\nconst monday = new Date(now);\nmonday.setUTCDate(now.getUTCDate() - ((now.getUTCDay() + 6) % 7));\nconst week = monday.toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    pages,\n    pageCount: pages.length,\n    creditsNeeded: pages.length + 1,\n    week,\n    fileName: `web-archive-${week}.pdf`,\n    archiveName: `${src.archiveName} — week of ${week}`,\n  },\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "One_item_per_page",
      "name": "One item per page",
      "type": "n8n-nodes-base.splitOut",
      "position": [
        1800,
        -80
      ],
      "parameters": {
        "options": {},
        "fieldToSplitOut": "pages"
      },
      "typeVersion": 1
    },
    {
      "id": "Render_each_page_to_PDF",
      "name": "Render each page to PDF",
      "type": "n8n-nodes-pdfmint.pdfMint",
      "onError": "continueRegularOutput",
      "position": [
        2080,
        -80
      ],
      "parameters": {
        "url": "={{ $json.pages }}",
        "output": "binary",
        "source": "url",
        "options": {
          "margin": "12mm"
        },
        "fileName": "={{ 'page.pdf' }}",
        "operation": "pdf"
      },
      "typeVersion": 1
    },
    {
      "id": "Keep_the_pages_that_rendered",
      "name": "Keep the pages that rendered",
      "type": "n8n-nodes-base.filter",
      "position": [
        2300,
        -80
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "f1",
              "operator": {
                "type": "object",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $binary }}",
              "rightValue": ""
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "Merge_into_one_archive",
      "name": "Merge into one archive",
      "type": "n8n-nodes-pdfmint.pdfMint",
      "onError": "continueRegularOutput",
      "position": [
        2780,
        -160
      ],
      "parameters": {
        "output": "binary",
        "fileName": "={{ $('Name this week\\'s archive').first().json.fileName }}",
        "operation": "merge",
        "mergeSource": "items",
        "mergeBinaryProperty": "data"
      },
      "typeVersion": 1
    },
    {
      "id": "Say_what_was_archived",
      "name": "Say what was archived",
      "type": "n8n-nodes-base.set",
      "position": [
        3060,
        -160
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "summary",
              "type": "string",
              "value": "={{ 'Archived ' + $('Keep the pages that rendered').all().length + ' of ' + $('Name this week\\'s archive').first().json.pageCount + ' pages into ' + $('Name this week\\'s archive').first().json.fileName }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "id": "Sticky Note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -620,
        -320
      ],
      "parameters": {
        "width": 500,
        "height": 880,
        "content": "## Archive a list of web pages as one PDF every week\n\nEvery Monday morning PDFMint renders each page on your list and merges the\nresults into a single, dated PDF — a readable snapshot of pages that change\nunder you: pricing, terms, a competitor's docs, your own status page.\n\n**What it does**\nThe list lives in one node you edit. Before spending anything the workflow\nchecks the PDFMint plan has enough credits for this run — one per page plus one\nfor the merge. Each page is rendered on its own, and a page that will not load\nis dropped rather than failing the week: the archive still gets built from the\npages that did render, and the summary says how many of how many.\n\n**Set up**\n1. Add a PDFMint credential — the free plan is 10 documents a month and needs no card.\n2. Put your URLs in **Set the pages to archive**.\n3. Change the schedule if Monday 07:00 is not your week.\n\n**Requirements**\n- A PDFMint API key from pdf.mintapis.com.\n- This template uses a community node, so it runs on **self-hosted n8n only**.\n\n**Disclosure**\nI build and run PDFMint. This is a self-submission, not a third-party recommendation."
      },
      "typeVersion": 1
    },
    {
      "id": "Sticky Note1",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -60,
        -180
      ],
      "parameters": {
        "color": 7,
        "width": 900,
        "height": 360,
        "content": "## 1. The list, and a sanity check\nThe schedule fires weekly. **Set the pages to archive** is the one node you edit. An empty list stops here."
      },
      "typeVersion": 1
    },
    {
      "id": "Sticky Note2",
      "name": "Sticky Note2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        840,
        -260
      ],
      "parameters": {
        "color": 7,
        "width": 620,
        "height": 360,
        "content": "## 2. Can we afford this run?\nOne credit per page plus one for the merge. PDFMint's `usage` operation is free and reports `credits_remaining`, so a run that cannot finish never starts."
      },
      "typeVersion": 1
    },
    {
      "id": "Sticky Note3",
      "name": "Sticky Note3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1460,
        -260
      ],
      "parameters": {
        "color": 7,
        "width": 1060,
        "height": 360,
        "content": "## 3. Render page by page\nThe archive is named once, the list is split, and each page is rendered on its own. `onError: continueRegularOutput` plus the filter means one dead URL costs one page, not the week."
      },
      "typeVersion": 1
    },
    {
      "id": "Sticky Note4",
      "name": "Sticky Note4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2540,
        -300
      ],
      "parameters": {
        "color": 7,
        "width": 840,
        "height": 620,
        "content": "## 4. One file, and an honest sentence\nTwo or more surviving pages are merged into a single dated PDF. **Exactly one** cannot be merged — PDFMint needs two — so that page becomes the archive on its own, and the summary says which of the two happened. Neither branch claims something that did not occur."
      },
      "typeVersion": 1
    },
    {
      "id": "if_multi",
      "name": "More than one page survived?",
      "type": "n8n-nodes-base.if",
      "position": [
        2580,
        -80
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "m1",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 2
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "single",
      "name": "The one page is the archive",
      "type": "n8n-nodes-base.set",
      "position": [
        2780,
        180
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "o1",
              "name": "summary",
              "type": "string",
              "value": "={{ 'Only 1 of ' + $('Name this week\\'s archive').first().json.pageCount + ' pages rendered, so that page is this week\\'s archive.' }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    }
  ],
