        3376,
        6976
      ],
      "parameters": {
        "actorId": {
          "__rl": true,
          "mode": "list",
          "value": "BG3WDrGdteHgZgbPK",
          "cachedResultUrl": "https://console.apify.com/actors/BG3WDrGdteHgZgbPK/input",
          "cachedResultName": "Amazon Product Scraper (junglee/Amazon-crawler)"
        },
        "operation": "Run actor and get dataset",
        "customBody": "={\n    \"categoryOrProductUrls\":[{ \"url\": \"{{ $json.URL }}\"}],\n    \"locationDeliverableRoutes\": [\n        \"PRODUCT\",\n        \"SEARCH\",\n        \"OFFERS\"\n    ],\n    \"maxItemsPerStartUrl\": 10,\n    \"maxOffers\": 0,\n    \"maxProductVariantsAsSeparateResults\": 0,\n    \"maxSearchPagesPerStartUrl\": 9999,\n    \"proxyCountry\": \"AUTO_SELECT_PROXY_COUNTRY\",\n    \"scrapeProductDetails\": true,\n    \"scrapeProductVariantPrices\": false,\n    \"scrapeSellers\": false,\n    \"useCaptchaSolver\": false\n}",
        "actorSource": "store",
        "authentication": "apifyOAuth2Api"
      },
      "credentials": {
