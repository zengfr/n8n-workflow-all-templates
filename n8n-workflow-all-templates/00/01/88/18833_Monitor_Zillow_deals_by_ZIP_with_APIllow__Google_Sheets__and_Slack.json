{
  "meta": {
    "site": "https://github.com/zengfr/n8n-workflow-all-templates",
    "tokenfree": "https://tokenyep.com/",
    "name": "Monitor Zillow deals by ZIP with APIllow, Google Sheets, and Slack",
    "wechat": "youandme10086",
    "id": 18833,
    "update_time": "2026-09-27"
  },
  "name": "Zillow Deal-Flow Monitor: ZIP Watcher → $/sqft Scoring → Sheets + Slack (APIllow)",
  "nodes": [
    {
      "id": "d3a1f001-0001-4001-8001-000000000001",
      "name": "Sticky Note — setup",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        40,
        -60
      ],
      "parameters": {
        "width": 520,
        "height": 420,
        "content": "## Zillow Deal-Flow Monitor\nWatches your ZIP codes for new for-sale listings, scores each one by **$ / sqft vs the ZIP median**, logs everything to Google Sheets, and pings Slack when something lists meaningfully below market.\n\n**Setup (~5 min)**\n1. Get a free APIllow key → https://apillow.co\n2. Add a *Header Auth* credential: name `x-api-key`, value = your key\n3. Pick your ZIPs + deal threshold in **Watch config**\n4. Point both Google Sheets nodes at a spreadsheet with a `Deals` tab\n5. Choose your Slack channels (deal alerts + error alerts)"
      },
      "typeVersion": 1
    },
    {
      "id": "d3a1f001-0002-4001-8001-000000000002",
      "name": "Sticky Note — polling",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        880,
        40
      ],
      "parameters": {
        "color": 4,
        "width": 560,
        "height": 260,
        "content": "### Async job pattern\nAPIllow batches are async: the submit call returns a `job_id` instantly and results are fetched separately. **Polling is free — it never counts against your monthly quota.** The loop below re-checks every 10 seconds until the job reports `complete`."
      },
      "typeVersion": 1
    },
    {
      "id": "d3a1f001-0003-4001-8001-000000000003",
      "name": "Sticky Note — scoring",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1560,
        40
      ],
      "parameters": {
        "color": 5,
        "width": 660,
        "height": 280,
        "content": "### Dedup + scoring\nZPIDs already present in your sheet are skipped, so re-runs never create duplicate rows. Every new listing gets a `$ / sqft` figure and is compared to the **median $ / sqft of its ZIP** (computed from the same batch). Anything at or below `deal_threshold × median` is routed to Slack."
      },
      "typeVersion": 1
    },
    {
      "id": "d3a1f001-0004-4001-8001-000000000004",
      "name": "Sticky Note — errors",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        500,
        760
      ],
      "parameters": {
        "color": 3,
        "width": 440,
        "height": 200,
        "content": "### If something fails\nBoth API calls retry 3× with a 5s backoff, and any final failure is routed to the ⚠️ Slack alert below instead of dying silently."
      },
      "typeVersion": 1
    },
    {
      "id": "d3a1f001-0005-4001-8001-000000000005",
      "name": "Every day at 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        240,
        460
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "d3a1f001-0006-4001-8001-000000000006",
      "name": "Watch config",
      "type": "n8n-nodes-base.set",
      "position": [
        460,
        460
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "cfg-zips",
              "name": "zipcodes",
              "type": "array",
              "value": "={{ [44124, 44122] }}"
            },
            {
              "id": "cfg-threshold",
              "name": "deal_threshold",
              "type": "number",
              "value": 0.85
            },
            {
              "id": "cfg-max",
              "name": "max_items",
              "type": "number",
              "value": 100
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "d3a1f001-0007-4001-8001-000000000007",
      "name": "APIllow: submit ZIP search",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueErrorOutput",
      "maxTries": 3,
      "position": [
        680,
        460
      ],
      "parameters": {
        "url": "https://api.apillow.co/v1/properties",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ { \"zipcodes\": $json.zipcodes, \"type\": \"sale\", \"max_items\": $json.max_items } }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "APIllow"
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 5000
    },
    {
      "id": "d3a1f001-0008-4001-8001-000000000008",
      "name": "Wait for job",
      "type": "n8n-nodes-base.wait",
      "position": [
        900,
        460
      ],
      "parameters": {
        "unit": "seconds",
        "amount": 10
      },
      "typeVersion": 1.1
    },
    {
      "id": "d3a1f001-0009-4001-8001-000000000009",
      "name": "APIllow: get results",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueErrorOutput",
      "maxTries": 3,
      "position": [
        1120,
        460
      ],
      "parameters": {
        "url": "=https://api.apillow.co/v1/results/{{ $('APIllow: submit ZIP search').first().json.job_id }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "APIllow"
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 5000
    },
    {
      "id": "d3a1f001-0010-4001-8001-000000000010",
      "name": "Job complete?",
      "type": "n8n-nodes-base.if",
      "position": [
        1340,
        460
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-complete",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.status }}",
              "rightValue": "complete"
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "d3a1f001-0011-4001-8001-000000000011",
      "name": "Wait then re-check",
      "type": "n8n-nodes-base.wait",
      "position": [
        1340,
        640
      ],
      "parameters": {
        "unit": "seconds",
        "amount": 10
      },
      "typeVersion": 1.1
    },
    {
      "id": "d3a1f001-0012-4001-8001-000000000012",
      "name": "Flatten & score",
      "type": "n8n-nodes-base.code",
      "position": [
        1580,
        460
      ],
      "parameters": {
        "jsCode": "// Turn the raw job payload into one scored item per listing.\nconst cfg = $('Watch config').first().json;\nconst results = $input.first().json.results || [];\nconst props = results.map(r => r.property).filter(p => p && p.zpid);\n\nconst scored = props.map(p => {\n  const price = Number(p.price) || null;\n  const sqft = Number(p.living_area) || null;\n  const ppsf = price && sqft ? Math.round(price / sqft) : null;\n  const address = [p.street_address, p.city, p.state].filter(Boolean).join(', ');\n  return { ...p, address, price_per_sqft: ppsf };\n});\n\n// Median $/sqft per ZIP, computed from this batch\nconst byZip = {};\nfor (const p of scored) {\n  if (p.price_per_sqft == null || !p.zipcode) continue;\n  (byZip[p.zipcode] ??= []).push(p.price_per_sqft);\n}\nconst median = (arr) => {\n  const s = [...arr].sort((a, b) => a - b);\n  const m = Math.floor(s.length / 2);\n  return s.length % 2 ? s[m] : Math.round((s[m - 1] + s[m]) / 2);\n};\nconst medians = Object.fromEntries(\n  Object.entries(byZip).map(([z, v]) => [z, median(v)])\n);\n\nreturn scored.map(p => {\n  const med = medians[p.zipcode] ?? null;\n  const cutoff = med ? Math.round(med * cfg.deal_threshold) : null;\n  const discount = med && p.price_per_sqft\n    ? Math.round((1 - p.price_per_sqft / med) * 100)\n    : null;\n  return { json: { ...p, zip_median_ppsf: med, deal_cutoff: cutoff, discount_pct: discount } };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "d3a1f001-0013-4001-8001-000000000013",
      "name": "Read tracked deals",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1800,
        460
      ],
      "parameters": {
        "options": {},
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Deals"
        },
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "YOUR_SHEET_ID"
        }
      },
      "typeVersion": 4,
      "alwaysOutputData": true
    },
    {
      "id": "d3a1f001-0014-4001-8001-000000000014",
      "name": "Drop already-tracked",
      "type": "n8n-nodes-base.code",
      "position": [
        2020,
        460
      ],
      "parameters": {
        "jsCode": "// Input = rows already in the sheet; scored listings come from the upstream node.\nconst tracked = new Set(\n  $input.all()\n    .map(i => String(i.json.zpid ?? ''))\n    .filter(s => s && s !== 'undefined')\n);\nconst fresh = $('Flatten & score').all()\n  .map(i => i.json)\n  .filter(p => !tracked.has(String(p.zpid)));\nreturn fresh.map(p => ({ json: p }));"
      },
      "typeVersion": 2
    },
    {
      "id": "d3a1f001-0015-4001-8001-000000000015",
      "name": "Append to deal sheet",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        2240,
        460
      ],
      "parameters": {
        "columns": {
          "value": {
            "url": "={{ $json.url }}",
            "zip": "={{ $json.zipcode }}",
            "beds": "={{ $json.bedrooms }}",
            "sqft": "={{ $json.living_area }}",
            "zpid": "={{ $json.zpid }}",
            "baths": "={{ $json.bathrooms }}",
            "price": "={{ $json.price }}",
            "status": "={{ $json.home_status }}",
            "address": "={{ $json.address }}",
            "zestimate": "={{ $json.zestimate }}",
            "date_added": "={{ $now.format('yyyy-MM-dd') }}",
            "discount_pct": "={{ $json.discount_pct }}",
            "last_sold_date": "={{ $json.last_sold_date }}",
            "price_per_sqft": "={{ $json.price_per_sqft }}",
            "last_sold_price": "={{ $json.last_sold_price }}",
            "zip_median_ppsf": "={{ $json.zip_median_ppsf }}"
          },
          "mappingMode": "defineBelow"
        },
        "options": {},
        "operation": "append",
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "Deals"
        },
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "YOUR_SHEET_ID"
        }
      },
      "typeVersion": 4
    },
    {
      "id": "d3a1f001-0016-4001-8001-000000000016",
      "name": "Priced below market?",
      "type": "n8n-nodes-base.if",
      "position": [
        2460,
        460
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-has-ppsf",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ $json.price_per_sqft }}",
              "rightValue": 0
            },
            {
              "id": "cond-below-cutoff",
              "operator": {
                "type": "number",
                "operation": "lte"
              },
              "leftValue": "={{ $json.price_per_sqft }}",
              "rightValue": "={{ $json.deal_cutoff }}"
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "d3a1f001-0017-4001-8001-000000000017",
      "name": "Slack: deal alert",
      "type": "n8n-nodes-base.slack",
      "position": [
        2700,
        460
      ],
      "parameters": {
        "text": "=:rotating_light: *Deal flag — {{ $json.zipcode }}*\n{{ $json.address }}\n${{ $json.price }} · {{ $json.price_per_sqft }}/sqft vs ZIP median {{ $json.zip_median_ppsf }}/sqft ({{ $json.discount_pct }}% below)\n{{ $json.url }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": "YOUR_SLACK_CHANNEL"
        },
        "otherOptions": {}
      },
      "credentials": {},
      "typeVersion": 2.2
    },
    {
      "id": "d3a1f001-0018-4001-8001-000000000018",
      "name": "Slack: error alert",
      "type": "n8n-nodes-base.slack",
      "position": [
        1080,
        820
      ],
      "parameters": {
        "text": "=:warning: Deal-flow monitor: APIllow call failed — {{ ($json.error && ($json.error.message || $json.error.description)) || 'see the n8n execution log' }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": "YOUR_SLACK_CHANNEL"
        },
        "otherOptions": {}
      },
      "credentials": {},
      "typeVersion": 2.2
    }
  ],
