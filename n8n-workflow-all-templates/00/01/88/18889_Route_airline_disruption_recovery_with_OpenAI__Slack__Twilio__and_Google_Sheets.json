        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an airline disruption-recovery specialist. Given passenger tier, PNR data and disruption details, classify the response path. Return strict JSON: {\"response_path\":\"VIP-Concierge|Standard-AutoRebook|Minor-Notify\",\"impact_score\":number,\"recommended_rebooking\":string}."
            },
            {
              "content": "=Disruption: {{ JSON.stringify($json) }}\nPNR/Loyalty: {{ JSON.stringify($('Fetch PNR Details').item.json) }}"
            }
          ]
        },
        "jsonOutput": true
      },
      "credentials": {
        "openAiApi": {
          "id": "YHvExhpGeOP4AX3Q",
          "name": "n8n free OpenAI API credits"
        }
      },
      "typeVersion": 1.8
    },
    {
      "id": "8a99c9c9-710b-45f1-9f81-aaba27db548b",
      "name": "Route by Impact",
      "type": "n8n-nodes-base.switch",
      "position": [
        2016,
        32
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "VIP",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.message.content.response_path }}",
                    "rightValue": "VIP-Concierge"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Standard",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.message.content.response_path }}",
                    "rightValue": "Standard-AutoRebook"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Minor",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.message.content.response_path }}",
                    "rightValue": "Minor-Notify"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      },
      "typeVersion": 3.2
    },
