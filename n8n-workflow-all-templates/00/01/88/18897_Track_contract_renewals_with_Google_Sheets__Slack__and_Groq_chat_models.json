    {
      "id": "9e80413d-6f67-42fc-91f4-52b765541224",
      "name": "Calculate Days to Expiry",
      "type": "n8n-nodes-base.code",
      "position": [
        1632,
        288
      ],
      "parameters": {
        "jsCode": "return items.map(item => {\n  const expiryDate = new Date(item.json.ExpiryDate);\n  const today = new Date();\n\n  const daysToExpiry = Math.ceil(\n    (expiryDate - today) / (1000 * 60 * 60 * 24)\n  );\n\n  return {\n    json: {\n      ...item.json,\n      DaysToExpiry: daysToExpiry\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "de0dd7de-5cc3-45a7-b439-32850fb10eb6",
      "name": "Calculate Renewal Priority Score",
      "type": "n8n-nodes-base.code",
      "position": [
        1856,
        288
      ],
      "parameters": {
        "jsCode": "return items.map(item => {\n  const value = Number(item.json.ContractValue || 0);\n  const risk = item.json.RiskLevel;\n  const performance = Number(item.json.PerformanceScore || 0);\n  const days = Number(item.json.DaysToExpiry || 999);\n\n  let score = 0;\n\n  // Expiry urgency\n  if (days <= 30) score += 40;\n  else if (days <= 60) score += 25;\n  else if (days <= 90) score += 10;\n\n  // Contract value\n  if (value >= 100000) score += 30;\n  else if (value >= 50000) score += 20;\n  else score += 10;\n\n  // Risk level\n  if (risk === \"High\") score += 20;\n  else if (risk === \"Medium\") score += 10;\n\n  // Performance impact\n  if (performance < 60) score += 10;\n\n  // Final Priority\n  let priority = \"Low\";\n  if (score >= 70) priority = \"High\";\n  else if (score >= 40) priority = \"Medium\";\n\n  return {\n    json: {\n      ...item.json,\n      PriorityScore: score,\n      PriorityLevel: priority\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
