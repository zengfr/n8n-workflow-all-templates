        "jsonBody": "={{ JSON.stringify({ company: $('Only jobs not read yet').item.json.company, role: $('Only jobs not read yet').item.json.title, url: $('Only jobs not read yet').item.json.url, signal: JSON.parse($json.text) }) }}",
        "sendBody": true,
        "specifyBody": "json"
      },
      "typeVersion": 4.2
    },
    {
      "id": "sticky-gate",
      "name": "Sticky Note 8",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
