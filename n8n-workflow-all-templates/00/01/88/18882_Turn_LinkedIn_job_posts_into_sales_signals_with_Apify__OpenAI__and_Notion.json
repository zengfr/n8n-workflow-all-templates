{
  "name": "Turn LinkedIn job posts into sales buying signals with Apify, OpenAI and Notion",
  "nodes": [
    {
      "id": "b7c3d1e0-0000-4a00-9000-000000000001",
      "name": "Every Monday at 8",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
        520
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "b7c3d1e0-0000-4a00-9000-000000000002",
      "name": "Roles that signal a buyer",
      "type": "n8n-nodes-base.set",
      "position": [
        240,
        520
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "cfg-searchQueries",
              "name": "searchQueries",
              "type": "string",
              "value": "customer support manager"
            },
            {
              "id": "cfg-locations",
              "name": "locations",
              "type": "string",
              "value": "United Kingdom"
            },
            {
              "id": "cfg-sell",
              "name": "sell",
              "type": "string",
              "value": "helpdesk software for small support teams"
            },
            {
              "id": "cfg-maxItems",
              "name": "maxItems",
              "type": "number",
              "value": 40
            },
            {
              "id": "cfg-minRelevance",
              "name": "minRelevance",
              "type": "number",
              "value": 4
            },
            {
              "id": "cfg-slackChannel",
              "name": "slackChannel",
              "type": "string",
              "value": "#sales-signals"
            },
            {
              "id": "cfg-digestEmail",
              "name": "digestEmail",
              "type": "string",
              "value": "you@example.com"
            }
          ]
        }
      },
      "typeVersion": 3.4
