        "height": 512,
        "content": "## Vision screening path\n\nRenders the PDF into an image, converts the Base64 response into a file, and runs a Gemini vision-based CV review with structured parsing."
      },
      "typeVersion": 1
    },
    {
      "id": "9d66f55a-eea4-4b08-a8e6-7e954002eaa9",
      "name": "Sticky Note4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1808,
        464
      ],
      "parameters": {
        "color": 7,
        "width": 640,
        "height": 352,
        "content": "## Merge and compare verdicts\n\nCombines the text and vision screening outputs, normalizes their key score and qualification fields, and decides whether the two screeners diverged."
      },
      "typeVersion": 1
    },
    {
      "id": "b5e52d96-8a44-4060-b5a9-c91ce1014daf",
      "name": "Sticky Note5",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2480,
        384
      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 320,
        "content": "## Quarantine flagged applications\n\nStores divergent or suspicious applications in Google Drive quarantine and sends a Telegram alert for manual review."
