      "position": [
        1056,
        0
      ],
      "parameters": {
        "color": 7,
        "width": 576,
        "height": 544,
        "content": "## Text screening path\n\nExtracts text from the submitted CV and sends it to the Gemini text screener with a structured parser to produce a machine-readable verdict."
      },
      "typeVersion": 1
    },
    {
      "id": "7b28e780-a2b4-432b-9e57-770c2eb55e25",
      "name": "Sticky Note3",
