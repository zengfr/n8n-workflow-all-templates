    {
      "id": "a1692893-4904-4bd8-9ef6-09d72947570d",
      "name": "Set Verdict Fields",
      "type": "n8n-nodes-base.set",
      "notes": "Three independent triggers. Any one is enough.",
      "position": [
        2080,
        640
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "text_score",
              "type": "number",
              "value": "={{ $('Text Analysis Screener').first().json.output.score }}"
            },
            {
              "id": "c2",
              "name": "vision_score",
              "type": "number",
              "value": "={{ $('Vision Analysis Screener').first().json.output.score }}"
            },
            {
              "id": "c3",
              "name": "text_qualified",
              "type": "boolean",
              "value": "={{ $('Text Analysis Screener').first().json.output.qualified }}"
            },
            {
              "id": "c4",
              "name": "vision_qualified",
              "type": "boolean",
              "value": "={{ $('Vision Analysis Screener').first().json.output.qualified }}"
            },
            {
              "id": "c5",
              "name": "score_gap",
              "type": "number",
              "value": "={{ Math.abs($('Text Analysis Screener').first().json.output.score - $('Vision Analysis Screener').first().json.output.score) }}"
            },
            {
              "id": "c6",
              "name": "years_gap",
              "type": "number",
              "value": "={{ Math.abs($('Text Analysis Screener').first().json.output.years_experience - $('Vision Analysis Screener').first().json.output.years_experience) }}"
            },
            {
              "id": "c7",
              "name": "injection_suspected",
              "type": "boolean",
              "value": "={{ ($('Text Analysis Screener').first().json.output.qualified !== $('Vision Analysis Screener').first().json.output.qualified) || Math.abs($('Text Analysis Screener').first().json.output.score - $('Vision Analysis Screener').first().json.output.score) >= 25 || Math.abs($('Text Analysis Screener').first().json.output.years_experience - $('Vision Analysis Screener').first().json.output.years_experience) >= 3 }}"
            },
            {
              "id": "c8",
              "name": "trusted_reason",
              "type": "string",
              "value": "={{ $('Vision Analysis Screener').first().json.output.reason }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
