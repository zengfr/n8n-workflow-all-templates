    {
      "id": "b1b679e7-1eb7-4327-a932-aef1e56483fa",
      "name": "Format Slack Report",
      "type": "n8n-nodes-base.code",
      "position": [
        3856,
        656
      ],
      "parameters": {
        "jsCode": "let message = \" *Weekly Sourcing Priority Report* \\n\\n\";\nlet maxScore = 0; // We will track the highest score for our email alert\n\nfor (let i = 0; i < $input.all().length; i++) {\n  let item = $input.all()[i].json;\n  \n  // Track highest score\n  if (item.priorityScore > maxScore) {\n    maxScore = item.priorityScore;\n  }\n\n  message += `*${i + 1}. ${item.projectName}* (Score: ${item.priorityScore})\\n`;\n  message += `_${item.aiRationale}_\\n\\n`;\n}\n\n// Return a single bundled item\nreturn [{ \n  json: { \n    slackMessage: message,\n    topScore: maxScore\n  } \n}];"
      },
      "typeVersion": 2
    },
