      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2368,
        512
      ],
      "parameters": {
        "text": "=\nProject: {{$json.projectName}}\nContract Value: ${{$json.value}}\nUrgency (1-10): {{$json.urgency}}\nSupplier Risk (1-10): {{$json.supplierRisk}}\nBusiness Impact (1-10): {{$json.businessImpact}}\nCalculated Priority Score: {{$json.priorityScore}}\n\n",
        "options": {
          "systemMessage": "You are an expert procurement analyst. Your job is to write a concise, 2-sentence rationale explaining the priority level of a sourcing initiative based on its metrics. Focus on the relationship between high/low metrics. Do not use pleasantries or introductory text."
