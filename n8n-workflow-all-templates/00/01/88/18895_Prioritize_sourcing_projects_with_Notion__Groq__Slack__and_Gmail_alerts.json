    {
      "id": "193196b8-6b92-4155-a4c5-78c1841aa567",
      "name": "Calculate Priority Score",
      "type": "n8n-nodes-base.code",
      "position": [
        1824,
        624
      ],
      "parameters": {
        "jsCode": "// Loop through every project coming from the Notion Set node\nfor (let item of $input.all()) {\n  \n  // 1. Extract the variables we mapped in the previous step\n  let value = item.json.value || 0;\n  let urgency = item.json.urgency || 1;\n  let risk = item.json.supplierRisk || 1;\n  let impact = item.json.businessImpact || 1;\n  let effort = item.json.effort || 1; // Defaults to 1 to prevent dividing by zero\n\n  // 2. Normalize the Value (so it doesn't overpower the 1-10 metrics)\n  // Example: $850,000 becomes 8.5\n  let normalizedValue = value / 100000;\n\n  // 3. The Core Algorithm: ((Value * Urgency) + (Risk * Impact)) / Effort\n  let rawScore = ((normalizedValue * urgency) + (risk * impact)) / effort;\n\n  // 4. Round to 2 decimal places and attach it to our JSON data\n  item.json.priorityScore = Math.round(rawScore * 100) / 100; \n}\n\n// Return the updated data to the next node\nreturn $input.all();"
      },
      "typeVersion": 2
    },
    {
      "id": "75bd53f8-1d02-4369-9810-de3395a817c4",
