    {
      "id": "1cba8403-bdfe-400c-8677-1ce955afae9b",
      "name": "Compute Breach Probability",
      "type": "n8n-nodes-base.code",
      "position": [
        1008,
        -240
      ],
      "parameters": {
        "jsCode": "const openIncidents = $('Set Incident Field Data').all();\n\nconst historicalItems = $input.all();\n\nconst avgMap = {};\nconst buckets = {};\n\nfor (const item of historicalItems) {\n  const cat = item.json.category || \"\";\n  const prio = item.json.priority || \"\";\n  const key = `${cat}_${prio}`;\n\n  if (!buckets[key]) buckets[key] = [];\n\n  if (item.json.opened_at && item.json.resolved_at) {\n    const mins = (new Date(item.json.resolved_at) - new Date(item.json.opened_at)) / 60000;\n    if (mins > 0) buckets[key].push(mins);\n  }\n}\n\nfor (const key in buckets) {\n  const durations = buckets[key];\n  if (durations.length > 0) {\n    const sum = durations.reduce((a, b) => a + b, 0);\n    avgMap[key] = sum / durations.length;\n  }\n}\n\nconst DEFAULT_SLA_MINUTES = 240;\nconst now = new Date();\n\nreturn openIncidents.map(incidentItem => {\n  const incident = incidentItem.json;\n  const key = `${incident.category || \"\"}_${incident.priority || \"\"}`;\n\n  const elapsedMinutes = (now - new Date(incident.opened_at)) / 60000;\n  const avgResolutionMinutes = avgMap[key] || DEFAULT_SLA_MINUTES;\n\n  const breachProbability = Math.min(100, Math.round((elapsedMinutes / avgResolutionMinutes) * 100));\n\n  return {\n    json: {\n      ...incident,\n      elapsed_minutes: Math.round(elapsedMinutes),\n      avg_historical_resolution_minutes: Math.round(avgResolutionMinutes),\n      breach_probability: breachProbability\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
