      "parameters": {
        "color": 7,
        "width": 640,
        "height": 320,
        "content": "## Poll and load incidents\n\nStarts the workflow on a 15-minute schedule, retrieves open incidents from ServiceNow, and keeps only the core incident fields needed downstream."
      },
      "typeVersion": 1
    },
    {
