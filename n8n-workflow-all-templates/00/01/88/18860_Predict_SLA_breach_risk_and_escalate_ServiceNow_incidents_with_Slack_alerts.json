    {
      "id": "56dcb0af-b61f-47d5-8625-d385a5f86cb9",
      "name": "Group Incidents by Category",
      "type": "n8n-nodes-base.code",
      "position": [
        544,
        96
      ],
      "parameters": {
        "jsCode": "const openIncidents = $input.all();\nconst uniquePairs = {};\n\nfor (const item of openIncidents) {\n  const cat = item.json.category || \"\";\n  const prio = item.json.priority || \"\";\n  const key = `${cat}_${prio}`;\n  \n  if (!uniquePairs[key]) {\n    uniquePairs[key] = { category: cat, priority: prio };\n  }\n}\n\nreturn Object.values(uniquePairs).map(val => ({ json: val }));"
      },
      "typeVersion": 2
