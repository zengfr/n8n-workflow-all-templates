    {
      "id": "9e9b8065-fbce-4db3-9a49-1f7531839844",
      "name": "Calculate Lowest Price",
      "type": "n8n-nodes-base.code",
      "position": [
        2304,
        10304
      ],
      "parameters": {
        "jsCode": "const prices = $input.all().map(item => Number(item.json.price));\n\nconst latestPrice = prices[prices.length - 1];\nconst lowestPrice = Math.min(...prices);\n\nreturn [{\n  json: {\n    latestPrice,\n    lowestPrice,\n    isLowest: latestPrice === lowestPrice\n  }\n}];"
      },
      "typeVersion": 2
    },
