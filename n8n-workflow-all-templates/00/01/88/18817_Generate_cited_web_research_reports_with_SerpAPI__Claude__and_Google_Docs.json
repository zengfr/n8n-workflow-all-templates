      "parameters": {
        "text": "=⚠️ *Research Report Complete - Requires Human Review*\n\n*Query:* {{ $('Set Research Workflow Parameters').first().json.query }}\n*Overall Confidence:* {{ $json.output.overallConfidence }}%\n\n📄 *Report:* {{ $json.documentUrl || \"Document created\" }}\n\n*Low Confidence Claims ({{ $json.output.lowConfidenceClaims.length }}):*\n{{ $json.output.lowConfidenceClaims.slice(0, 3).map(c => `• ${c}`).join(\"\\n\") }}\n\n👤 Please review flagged sections before using this report.",
