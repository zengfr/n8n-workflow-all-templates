    {
      "id": "e34b760c-e22d-4ee9-b33f-7db5bbe01e2c",
      "name": "Planner AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1040,
        256
      ],
      "parameters": {
        "text": "={{ $json.query }}",
        "options": {
          "systemMessage": "You are a research planning agent. Your task is to decompose a research query into 3-5 specific, focused sub-questions that will enable comprehensive research.\n\nGuidelines:\n- Each sub-question should target a distinct aspect of the main query\n- Questions should be specific enough for web search\n- Avoid overlapping questions\n- Prioritize questions that will yield factual, verifiable information\n\nReturn your response as a JSON object with a \"subQuestions\" array containing the questions."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3
    },
    {
      "id": "bf6ebc39-29e5-4d79-9a23-846c958113de",
      "name": "Claude Model for Planning",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "position": [
        1040,
        480
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-3-5-sonnet-20241022"
        },
        "options": {}
      },
      "typeVersion": 1.3
    },
    {
      "id": "6c35c259-0c20-4b19-8518-3ce10cb21959",
      "name": "Parse Planner Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1168,
        480
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"subQuestions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Array of 3-5 specific research sub-questions\"\n    }\n  },\n  \"required\": [\"subQuestions\"]\n}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "1fe953d3-c779-47e8-88ce-3c55cd2bad7b",
      "name": "Extract Sub-Questions for Research",
      "type": "n8n-nodes-base.set",
      "position": [
        1424,
        256
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "id-1",
              "name": "subQuestions",
              "type": "string",
              "value": "={{ $json.output.subQuestions }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "id": "67cfc24e-499b-46b8-9cd5-489d92931437",
      "name": "Split Sub-Questions for Parallel Processing",
      "type": "n8n-nodes-base.code",
      "position": [
        1648,
        256
      ],
      "parameters": {
        "jsCode": "// Split sub-questions array into individual items for parallel processing\nconst subQuestions = $input.first().json.subQuestions;\n\nreturn subQuestions.map(question => ({\n  json: {\n    question: question,\n    originalQuery: $input.first().json.query\n  }\n}));"
      },
      "typeVersion": 2
    },
    {
      "id": "43789518-4671-42b6-a92f-33dffee60903",
      "name": "Fetch Search Results from SerpAPI",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1872,
        256
      ],
      "parameters": {
        "url": "https://serpapi.com/search",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.question }}"
            },
            {
              "name": "api_key",
              "value": "={{ $('Set Research Workflow Parameters').first().json.serpApiKey }}"
            },
            {
              "name": "engine",
              "value": "google"
            },
            {
              "name": "num",
              "value": "5"
            }
          ]
        }
      },
      "typeVersion": 4.3
    },
    {
      "id": "2c7fe73e-e629-44ca-a3ba-11cf3e0e8db9",
      "name": "Combine Search Results for Synthesis",
      "type": "n8n-nodes-base.aggregate",
      "position": [
        2096,
        256
      ],
      "parameters": {
        "include": "specifiedFields",
        "options": {},
        "aggregate": "aggregateAllItemData",
        "fieldsToInclude": "organic_results",
        "destinationFieldName": "allSearchResults"
      },
      "typeVersion": 1
    },
    {
      "id": "d5049376-4b8a-40ef-a81a-4c0112d4cf7a",
      "name": "Synthesis AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2320,
        256
      ],
      "parameters": {
        "text": "=Original Query: {{ $('Set Research Workflow Parameters').first().json.query }}\n\nSearch Results:\n{{ JSON.stringify($json.allSearchResults, null, 2) }}",
        "options": {
          "systemMessage": "You are a research synthesis agent. Your task is to analyze web search results and create a comprehensive, well-structured research report.\n\nGuidelines:\n- Synthesize information from multiple sources into coherent sections\n- Include inline citations using [Source: URL] format after each claim\n- Organize the report with clear headings and logical flow\n- Focus on factual, verifiable information\n- Highlight key findings and insights\n- Ensure all major claims are supported by citations\n\nCreate a detailed research report based on the provided search results."
        },
        "promptType": "define"
      },
      "typeVersion": 3
    },
    {
      "id": "9e98ecba-97d7-4d7e-a634-0342b1febe0d",
      "name": "Claude Model for Synthesis",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "position": [
        2416,
        480
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-3-5-sonnet-20241022"
        },
        "options": {}
      },
      "typeVersion": 1.3
    },
    {
      "id": "c91c864e-9b82-4e5b-a7e8-243fa2991f27",
      "name": "Confidence Scoring Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2672,
        256
      ],
      "parameters": {
        "text": "={{ $json.output }}",
        "options": {
          "systemMessage": "You are a confidence scoring agent. Your task is to analyze a research report and assign confidence scores to each major claim.\n\nGuidelines:\n- Score each claim from 0-100 based on:\n  * Number and quality of citations (40%)\n  * Source credibility (30%)\n  * Claim specificity and verifiability (30%)\n- Flag any claim scoring below 70 as requiring human review\n- Calculate an overall confidence score for the entire report\n- Identify specific claims that need additional verification\n\nAnalyze the report and return confidence scores in the specified JSON format."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3
    },
    {
      "id": "5e0f7e1f-0a14-4ab9-9858-de990c75ea46",
      "name": "Claude Model for Confidence Scoring",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "position": [
        2704,
        480
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-3-5-sonnet-20241022"
        },
        "options": {}
      },
      "typeVersion": 1.3
    },
    {
      "id": "ef6911cc-ecaa-4875-9b1d-59d3dc461c21",
      "name": "Parse Scorer Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        2832,
        480
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"overallConfidence\": {\n      \"type\": \"number\",\n      \"description\": \"Overall confidence score 0-100\"\n    },\n    \"claims\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"claim\": {\"type\": \"string\"},\n          \"score\": {\"type\": \"number\"},\n          \"reasoning\": {\"type\": \"string\"}\n        }\n      }\n    },\n    \"lowConfidenceClaims\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\"},\n      \"description\": \"Claims scoring below 70\"\n    }\n  },\n  \"required\": [\"overallConfidence\", \"claims\", \"lowConfidenceClaims\"]\n}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "a4ea3ac3-a59e-4a37-bb6f-2689e3ae0015",
      "name": "Check Confidence Threshold",
      "type": "n8n-nodes-base.if",
      "position": [
        3056,
        256
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "id-1",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": "={{ $json.overallConfidence }}",
              "rightValue": "={{ $('Set Research Workflow Parameters').first().json.confidenceThreshold }}"
            }
          ]
        }
      },
      "typeVersion": 2.3
    },
    {
