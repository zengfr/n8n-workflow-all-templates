      "parameters": {
        "color": 7,
        "width": 352,
        "height": 544,
        "content": "## Plan research with AI agent\n\nUses an AI agent (Planner Agent) to decompose the initial research request into sub-questions for parallel processing."
      },
      "typeVersion": 1
    },
    {
      "id": "fa630329-db7b-4ea2-82f3-9567f192e3ae",
      "name": "Sticky Note3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1376,
        96
      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 320,
        "content": "## Process and split sub-questions\n\nExtracts and splits the sub-questions array into individual items for parallel web searches using SerpAPI."
      },
      "typeVersion": 1
    },
    {
      "id": "9a8371c0-bcf7-4d4d-a498-eded26d79e8d",
      "name": "Sticky Note4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1824,
        96
      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 320,
        "content": "## Execute web searches and aggregate results\n\nPerforms parallel web searches for each sub-question using SerpAPI and aggregates the results for synthesis."
      },
      "typeVersion": 1
    },
    {
      "id": "48b32254-9936-4ce7-aac4-98fcd3f7b6f4",
      "name": "Sticky Note5",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2272,
        128
      ],
      "parameters": {
        "color": 7,
        "width": 704,
        "height": 512,
        "content": "## Synthesize results and score confidence\n\nUses an AI agent (Synthesis Agent) to synthesize search results and a Confidence Scorer agent to evaluate the confidence level of the synthesis."
      },
      "typeVersion": 1
    },
    {
      "id": "6192fd10-a1a8-4830-b920-adfa5a3ac39a",
      "name": "Sticky Note6",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        3008,
        32
      ],
      "parameters": {
        "color": 7,
        "width": 640,
        "height": 496,
        "content": "## Generate report and notify stakeholders\n\nCreates a Google Doc report based on confidence levels and sends notifications to Slack channels for high or low confidence results."
      },
      "typeVersion": 1
    },
    {
      "id": "ed53547d-c5a5-4b63-9383-3b2e8d28c747",
