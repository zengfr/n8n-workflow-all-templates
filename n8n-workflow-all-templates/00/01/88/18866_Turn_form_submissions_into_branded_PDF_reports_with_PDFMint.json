      "parameters": {
        "color": 7,
        "width": 340,
        "height": 300,
        "content": "## 4a. Success\nThe submitter sees what was produced."
      },
      "typeVersion": 1
    },
    {
      "id": "Sticky Note5",
      "name": "Sticky Note5",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2020,
        160
      ],
      "parameters": {
        "color": 7,
        "width": 660,
        "height": 320,
        "content": "## 4b. Failure\nNo quota, a bad submission or an unreachable PDFMint all end here — with the real reason, never a blank page."
      },
      "typeVersion": 1
    }
