    {
      "id": "Build_the_Markdown_report",
      "name": "Build the Markdown report",
      "type": "n8n-nodes-base.code",
      "position": [
        1520,
        -80
      ],
      "parameters": {
        "jsCode": "// The form gives loose text. The PDF wants a document: a title block, the\n// findings as Markdown, and a short summary the reader sees before the detail.\nconst brand = $('Set report branding').first().json;\nconst s = brand.submission;\n\nconst findings = String(s['Findings'] || '').trim();\nconst recommendation = String(s['Recommendation'] || '').trim();\nconst words = findings.split(/\\s+/).filter(Boolean).length;\nconst readingMinutes = Math.max(1, Math.round(words / 200));\nconst today = new Date().toISOString().slice(0, 10);\nconst slug = String(s['Report title'] || 'report')\n  .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 48);\n\nconst md = [\n  `# ${s['Report title']}`,\n  '',\n  `**${brand.company}** · ${today}`,\n  `Author: ${s['Author']}${s['Site or client'] ? ` · Site: ${s['Site or client']}` : ''}`,\n  '',\n  '---',\n  '',\n  `> ${words} words, about ${readingMinutes} minute${readingMinutes === 1 ? '' : 's'} to read.`,\n  '',\n  '## Findings',\n  '',\n  findings,\n];\nif (recommendation) md.push('', '## Recommendation', '', recommendation);\nmd.push('', '---', '', `_${brand.footer}_`);\n\nreturn [{\n  json: {\n    markdown: md.join('\\n'),\n    fileName: `${slug}-${today}.pdf`,\n    words,\n    readingMinutes,\n    title: s['Report title'],\n  },\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "Render_Markdown_to_PDF",
      "name": "Render Markdown to PDF",
      "type": "n8n-nodes-pdfmint.pdfMint",
      "onError": "continueRegularOutput",
      "position": [
        1800,
        -80
      ],
      "parameters": {
        "output": "binary",
        "source": "markdown",
        "options": {
          "margin": "18mm",
          "pageNumbers": true
        },
        "fileName": "={{ $json.fileName }}",
        "markdown": "={{ $json.markdown }}",
        "operation": "pdf"
      },
      "credentials": {
        "pdfMintApi": {
          "id": "PDFMINT_CRED",
          "name": "PDFMint account"
        }
      },
      "typeVersion": 1
    },
