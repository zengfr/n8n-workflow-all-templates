    },
    {
      "id": "0d9a77b5-3497-492d-a8e9-578732cfcd4e",
      "name": "Valid order?",
      "type": "n8n-nodes-base.if",
      "position": [
        304,
        608
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-valid-order",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ !!$json.body.order && Array.isArray($json.body.order.lines) && $json.body.order.lines.length > 0 && !!$json.body.order.customer && !!$json.body.order.customer.email }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "81aa052c-2432-423b-817d-206faec64aae",
      "name": "Build invoice",
      "type": "n8n-nodes-base.code",
      "position": [
        656,
        608
      ],
      "parameters": {
        "jsCode": "  const order = $input.first().json.body.order;\n  const taxRate = order.taxRate ?? 20;\n\n  let subtotal = 0;\n  const items = order.lines.map((l) => {\n    const quantity = Number(l.quantity);\n    const unitPrice = Number(l.unitPrice);\n    const lineTotal = Math.round(quantity * unitPrice * 100) / 100;\n    subtotal += lineTotal;\n    return {\n      name: l.name,\n      description: l.description ?? '',\n      quantity,\n      unit_price: unitPrice,\n      line_total: lineTotal,\n    };\n  });\n\n  subtotal = Math.round(subtotal * 100) / 100;\n  const taxAmount = Math.round(subtotal * taxRate) / 100;\n  const total = Math.round((subtotal + taxAmount) * 100) / 100;\n\n  const issueDate = order.issueDate ?? new Date().toISOString().slice(0, 10);\n  const invoiceNumber = order.invoiceNumber ?? `INV-${issueDate.slice(0, 7)}-${order.orderId}`;\n  const currency = order.currencyCode ?? 'EUR';\n  const money = (n) => `${currency} ${n.toFixed(2)}`;\n\n  const invoice = {\n    invoice_number: invoiceNumber,\n    invoice_date: issueDate,\n    due_date: order.dueDate ?? '',\n    currency,\n    customer_name: order.customer.name,\n    customer_email: order.customer.email,\n    items,\n    subtotal,\n    subtotal_formatted: money(subtotal),\n    tax_rate: taxRate,\n    tax_amount: taxAmount,\n    tax_formatted: money(taxAmount),\n    total,\n    total_formatted: money(total),\n  };\n\n  return [{ json: invoice }];"
      },
      "typeVersion": 2
    },
    {
      "id": "69d9393f-2ffb-4484-9261-00d51213bd86",
      "name": "Render invoice PDF",
      "type": "n8n-nodes-polydoc.polyDoc",
      "position": [
        912,
        608
      ],
      "parameters": {
        "pdfOptions": {
          "format": "A4",
          "printBackground": true
        },
        "sourceType": "template",
        "templateId": "YOUR_TEMPLATE_ID",
        "templateData": "={{ $json }}",
        "additionalFields": {
          "filename": "=invoice-{{ $json.invoice_number }}.pdf"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "087b2f82-c6b7-4341-9a74-e3441dd80e41",
      "name": "Email invoice",
      "type": "n8n-nodes-base.emailSend",
      "position": [
        1216,
        576
      ],
      "webhookId": "a295227a-1490-4d39-b092-97703eddd0f9",
      "parameters": {
        "text": "=Hello {{ $('Build invoice').item.json.customer_name }},\n\nPlease find invoice {{ $('Build invoice').item.json.invoice_number }} for {{ $('Build invoice').item.json.total_formatted }} attached.\n\nThank you.",
        "options": {
          "attachments": "data"
        },
        "subject": "=Invoice {{ $('Build invoice').item.json.invoice_number }}",
        "toEmail": "={{ $('Build invoice').item.json.customer_email }}",
        "fromEmail": "user@example.com",
        "emailFormat": "text"
      },
      "typeVersion": 2.1
    },
