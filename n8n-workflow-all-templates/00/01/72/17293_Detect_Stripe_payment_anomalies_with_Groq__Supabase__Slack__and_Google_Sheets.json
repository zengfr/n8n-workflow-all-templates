      ],
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nreturn rows.map(row => {\n  const r = row.json;\n  return {\n    json: {\n      transaction_id: r.transaction_id,\n      customer_id:    r.customer_id,\n      customer_email: r.customer_email,\n      amount_usd:     parseFloat(r.amount) / 100,  // cents → dollars\n      currency:       r.currency,\n      status:         r.status,\n      payment_method: r.payment_method,\n      country:        r.country,\n      risk_score:     parseInt(r.risk_score),\n      created:        r.created,\n      description:    r.description,\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
