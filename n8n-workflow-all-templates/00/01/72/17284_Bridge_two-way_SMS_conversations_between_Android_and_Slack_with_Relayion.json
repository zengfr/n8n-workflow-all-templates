    {
      "id": "85fe059d-a919-43b8-a8d6-ac35d2cf8930",
      "name": "Extract Phone and Reply Details",
      "type": "n8n-nodes-base.code",
      "position": [
        320,
        528
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const parentText = $json.messages ? $json.messages[0].text : $json.text;\nconst match = parentText.match(/`([+][0-9]+)`/);\nif (!match) {\n  throw new Error('Could not find a phone number in the original Slack message. Do not edit the auto-posted SMS notification text.');\n}\nconst recipientNumber = match[1];\nconst replyBody = $('When Slack Message Received').item.json.text;\nreturn { recipientNumber, replyBody };"
      },
      "typeVersion": 2
    },
