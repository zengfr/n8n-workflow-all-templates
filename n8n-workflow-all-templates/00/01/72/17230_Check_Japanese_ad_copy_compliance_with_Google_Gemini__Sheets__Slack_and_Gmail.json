    {
      "id": "14bc4cb5-0095-41e1-88c0-52bfac2246e5",
      "name": "Risk Result Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1088,
        288
      ],
      "parameters": {
        "jsonSchemaExample": "{\"risk_level\":\"high\",\"violations\":[{\"phrase\":\"必ず痩せます\",\"law\":\"Pharmaceutical and Medical Device Act\",\"reason\":\"Guaranteed medical effect is not allowed\"}],\"safe_rewrite\":\"毎日の食生活をサポートします\",\"summary\":\"Claims a guaranteed slimming effect\"}"
      },
      "typeVersion": 1.3
