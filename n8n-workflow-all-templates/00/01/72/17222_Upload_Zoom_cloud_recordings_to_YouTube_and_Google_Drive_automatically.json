      ],
      "parameters": {
        "color": 7,
        "width": 1200,
        "height": 506,
        "content": "### 3. Download & upload\nExtract completed MP4s, download with the event's token, then upload to Google Drive and YouTube (unlisted) in parallel."
      },
      "typeVersion": 1
    },
    {
