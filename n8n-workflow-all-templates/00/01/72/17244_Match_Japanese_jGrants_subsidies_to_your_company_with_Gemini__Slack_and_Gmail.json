    {
      "id": "7aab350d-0312-4f0b-801f-8b5dcad16129",
      "name": "Score Subsidy Fit with Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "onError": "continueErrorOutput",
      "position": [
        1184,
        32
      ],
      "parameters": {
        "text": "=You are a Japanese subsidy consultant. Judge how well the government subsidy below fits the company and respond with a fit score from 0 to 100. verdict must be \"strong\" when the company is clearly eligible and the subsidy matches the investment plan, \"possible\" when it may apply with conditions, and \"no\" when it does not apply.\n\nCompany: industry {{ $(\"Set Company Profile\").item.json.industry }}, {{ $(\"Set Company Profile\").item.json.employees }} employees, based in {{ $(\"Set Company Profile\").item.json.prefecture }}.\nInvestment plan: {{ $(\"Set Company Profile\").item.json.investmentPlan }}\n\nSubsidy: {{ $json.title }}\nMax amount: {{ $json.subsidy_max_limit }}\nTarget area: {{ $json.target_area_search }}\nTarget employees: {{ $json.target_number_of_employees }}\nPurpose: {{ $json.use_purpose }}\nApplications close: {{ $json.acceptance_end_datetime }}",
        "batching": {},
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.9
    },
