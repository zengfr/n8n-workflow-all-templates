    },
    {
      "id": "503f06db-d518-409c-ba9e-a2818c85d490",
      "name": "S4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1808,
        -288
      ],
      "parameters": {
        "color": 7,
        "width": 992,
