    {
      "id": "dc9ea368-3e16-4ae9-aa06-866ce5d53253",
      "name": "Fit Result Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1376,
        240
      ],
      "parameters": {
        "jsonSchemaExample": "{\"fit_score\":85,\"verdict\":\"strong\",\"reasons\":[\"Matches IT investment plan\"],\"required_actions\":[\"Prepare a business plan\"],\"summary\":\"Strong fit for the planned automation investment\"}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "d1239f6f-473d-4e3e-9975-1360d23fa1d9",
      "name": "Parse Fit Result",
      "type": "n8n-nodes-base.code",
      "position": [
        1568,
        16
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $json.output || $json;\nconst s = $('Split Subsidies').item.json;\nconst arr = function (x) { return Array.isArray(x) ? x.join('; ') : (x || ''); };\nreturn {\n  subsidyId: s.id || '',\n  title: s.title || '',\n  maxAmount: s.subsidy_max_limit || '',\n  closesAt: s.acceptance_end_datetime || '',\n  fitScore: Number(src.fit_score) || 0,\n  verdict: String(src.verdict || 'no').toLowerCase(),\n  reasons: arr(src.reasons),\n  requiredActions: arr(src.required_actions),\n  summary: src.summary || ''\n};"
      },
      "typeVersion": 2
    },
