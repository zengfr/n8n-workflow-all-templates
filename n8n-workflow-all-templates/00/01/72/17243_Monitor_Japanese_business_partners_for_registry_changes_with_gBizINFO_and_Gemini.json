      "parameters": {
        "color": 7,
        "width": 816,
        "height": 760,
        "content": "## 3. AI materiality rating (Basic LLM Chain)\nGemini rates how serious the change is for credit and contract risk and recommends an action."
      },
      "typeVersion": 1
    },
    {
      "id": "8ca349d9-68b8-4ca3-b8ca-049e957f6ac9",
      "name": "S4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2128,
        -288
      ],
      "parameters": {
