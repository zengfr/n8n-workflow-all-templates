    {
      "id": "abd4d661-d337-4b4f-802d-2e4631715266",
      "name": "Detect Registry Changes",
      "type": "n8n-nodes-base.code",
      "position": [
        848,
        48
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $('Get Partner List').item.json;\nconst res = $json || {};\nconst list = res['hojin-infos'] || res.hojinInfos || [];\nconst info = (Array.isArray(list) ? list[0] : list) || {};\nconst currentName = info.name || '';\nconst currentAddress = info.location || '';\nconst closeCause = info.close_cause || '';\nconst prevName = p['Last Name'] || '';\nconst prevAddress = p['Last Address'] || '';\nconst changes = [];\nif (prevName && currentName && prevName !== currentName) { changes.push('Company name: ' + prevName + ' -> ' + currentName); }\nif (prevAddress && currentAddress && prevAddress !== currentAddress) { changes.push('Address: ' + prevAddress + ' -> ' + currentAddress); }\nif (closeCause) { changes.push('Closure or dissolution recorded: ' + closeCause); }\nreturn {\n  corporateNumber: p['Corporate Number'] || '',\n  partnerName: p['Company Name'] || currentName,\n  currentName: currentName,\n  currentAddress: currentAddress,\n  closeCause: closeCause,\n  changes: changes.join(' | '),\n  hasChanges: changes.length > 0\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "1b5ab468-02aa-4c11-a8e8-a2ba61fedd0d",
      "name": "Check for Changes",
      "type": "n8n-nodes-base.if",
      "position": [
        1072,
        48
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": false,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.hasChanges }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "bf7e08f5-41ef-47b5-a08b-577c7207d576",
      "name": "Assess Change Materiality with Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "onError": "continueErrorOutput",
      "position": [
        1424,
        32
      ],
      "parameters": {
        "text": "=You are a Japanese credit and contract risk analyst. The corporate registry (gBizINFO) shows the following changes for a business partner. Judge how material they are for commercial and credit risk. Set materiality to \"high\" for dissolution, closure or a change that invalidates contracts, \"medium\" for a change that needs paperwork updates, and \"low\" for cosmetic changes. Give a short summary and one recommended action.\n\nPartner: {{ $json.partnerName }}\nCorporate number: {{ $json.corporateNumber }}\nDetected changes: {{ $json.changes }}\nClosure cause field: {{ $json.closeCause }}",
        "batching": {},
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.9
    },
