    {
      "id": "6db4e0ad-9db3-4a4e-9df7-8130729f9b55",
      "name": "Classify Business Card with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1632,
        272
      ],
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [\n      { \"text\": \"You are an AI assistant that reads business card (meishi) photos. Determine whether the image is a business card. If it is, extract the following fields as accurately as possible from the text on the card. Return ONLY valid JSON, no markdown.\\n\\nReturn JSON with:\\n- is_business_card: true or false\\n- name: the person's full name (empty string if unreadable)\\n- company: the company or organization name\\n- position: job title or role\\n- phone: phone number\\n- email: email address\" },\n      { \"inline_data\": { \"mime_type\": \"{{ $('Download Image from LINE').item.binary.data.mimeType }}\", \"data\": \"{{ $('Convert Image to Base64').item.json.imageBase64 }}\" } }\n    ]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"responseSchema\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"is_business_card\": { \"type\": \"boolean\" },\n        \"name\": { \"type\": \"string\" },\n        \"company\": { \"type\": \"string\" },\n        \"position\": { \"type\": \"string\" },\n        \"phone\": { \"type\": \"string\" },\n        \"email\": { \"type\": \"string\" }\n      },\n      \"required\": [\"is_business_card\", \"name\", \"company\", \"position\", \"phone\", \"email\"]\n    }\n  }\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi"
      },
      "typeVersion": 4.2
    },
    {
      "id": "33cde920-b3e6-4d18-a724-f0216e4b640e",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.set",
      "position": [
        1872,
        272
      ],
