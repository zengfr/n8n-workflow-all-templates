      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst item = $input.all()[0];\nreturn [{\n  json: {\n    ...item.json,\n    imageBase64: buffer.toString('base64')\n  },\n  binary: item.binary\n}];"
      },
      "typeVersion": 2
    }
