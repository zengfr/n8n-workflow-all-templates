      ],
      "parameters": {
        "color": 7,
        "width": 500,
        "height": 620,
        "content": "## Download & Classify with AI\nDownloads the photo from LINE (via HTTP Header Auth) and sends it to Google Gemini, which decides if it's a business card and extracts the contact details."
      },
      "typeVersion": 1
    },
    {
      "id": "76540eaf-a3b6-4e7d-8805-3d365d45696e",
