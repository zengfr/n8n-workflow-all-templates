    {
      "id": "6668981a-0955-463c-83ee-43f77dfd135f",
      "name": "Classify Email Urgency",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        816,
        800
      ],
      "parameters": {
        "text": "=Classify this support email into exactly one category: \"urgent\" (needs a response within hours - complaints, outages, angry customers, time-sensitive requests), \"routine\" (a normal question or request that can wait for a daily summary), or \"spam\" (newsletters, marketing, automated notifications, anything not requiring a real reply).\n\nFrom: {{ $json.From }}\nSubject: {{ $json.Subject }}\nBody: {{ $json.snippet }}\n\nAlso write a one-sentence summary of what the email is about, and a short reason for the category you picked.",
        "batching": {},
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.8
    },
    {
      "id": "9de63bf9-bc93-4cb9-beff-df3264fea20d",
      "name": "Classifier Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
