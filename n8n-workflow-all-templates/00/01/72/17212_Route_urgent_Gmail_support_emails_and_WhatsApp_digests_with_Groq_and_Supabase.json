    {
      "id": "f0133123-848a-424f-90f1-7db761a80458",
      "name": "Build Digest Text",
      "type": "n8n-nodes-base.code",
      "position": [
        1328,
        1312
      ],
      "parameters": {
        "jsCode": "const emails = $json.emails || [];\n\nif (emails.length === 0) {\n  return [];\n}\n\nconst lines = emails.map(e => `- ${e.subject} (from ${e.sender}): ${e.summary}`).join('\\n');\nconst digestText = `Daily digest: ${emails.length} routine email(s) today.\\n\\n${lines}`;\nconst ids = emails.map(e => e.id);\n\nreturn [{ json: { digest_text: digestText, email_ids: ids } }];"
      },
      "typeVersion": 2
    },
