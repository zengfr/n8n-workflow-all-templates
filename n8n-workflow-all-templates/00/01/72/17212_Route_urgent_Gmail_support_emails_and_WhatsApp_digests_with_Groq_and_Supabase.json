      "parameters": {
        "color": 7,
        "width": 1168,
        "height": 492,
        "content": "## 1️⃣ As Emails Arrive\nEvery new email gets classified and logged immediately. Urgent ones also get an instant WhatsApp alert, routine ones wait for the daily digest below."
      },
      "typeVersion": 1
    },
