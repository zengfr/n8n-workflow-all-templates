        "options": {}
      },
      "credentials": {
        "groqApi": {
          "id": "giAHD01oHYBjecJ4",
          "name": "Groq account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "d29a5932-53ed-481d-82f6-904db2f71dbb",
