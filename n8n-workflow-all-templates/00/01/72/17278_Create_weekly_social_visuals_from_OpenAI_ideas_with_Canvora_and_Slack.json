      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 320,
        "content": "## Generate post concept\n\nUses OpenAI to write the post concept, then extracts and structures the generated concept for downstream use."
      },
      "typeVersion": 1
    },
    {
      "id": "st030000-0000-4000-8000-000000000000",
