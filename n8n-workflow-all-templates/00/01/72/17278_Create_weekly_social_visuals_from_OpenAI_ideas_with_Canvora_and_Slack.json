      ],
      "parameters": {
        "color": 7,
        "width": 240,
        "height": 400,
        "content": "## Start Canvora generation\n\nSubmits the prepared concept and campaign settings to the Canvora generation API to begin creating the visual assets."
      },
      "typeVersion": 1
    },
    {
      "id": "st040000-0000-4000-8000-000000000000",
