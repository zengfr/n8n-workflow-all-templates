      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "topic",
              "type": "string",
              "value": "practical productivity systems for solo founders"
            },
            {
              "id": "s2",
              "name": "formats",
              "type": "string",
              "value": "instagram_post,linkedin_post"
            },
            {
              "id": "s3",
              "name": "language",
              "type": "string",
              "value": ""
            },
            {
              "id": "s4",
              "name": "brandId",
              "type": "string",
              "value": ""
            }
