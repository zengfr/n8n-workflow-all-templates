    {
      "id": "67287783-7a9e-4e2d-97a2-58e791c923ee",
      "name": "Calculate Domain Rank Position",
      "type": "n8n-nodes-base.code",
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const results = [];\nconst brightDataItems = $input.all();\n\nfor (let i = 0; i < brightDataItems.length; i++) {\n  const serpData = brightDataItems[i].json;\n  const organic = serpData.organic || serpData.body?.organic || [];\n  \n  const sheetRow = $('Read Keywords from Sheets').all()[i].json;\n  const targetDomain = sheetRow['Target Domain'] || '';\n  const keyword = sheetRow['Keyword'] || '';\n  const country = sheetRow['Target Country'] || '';\n  const rowNumber = sheetRow.row_number;\n  const previousPosition = sheetRow['Last Position'] || '';\n  \n  let position = 'Not in top 100';\n  for (const result of organic) {\n    if (result.link && targetDomain && result.link.includes(targetDomain)) {\n      position = result.rank;\n      break;\n    }\n  }\n  \n  results.push({\n    json: {\n      Keyword: keyword,\n      'Target Country': country,\n      'Target Domain': targetDomain,\n      'Last Position': position,\n      'Previous Position': previousPosition,\n      row_number: rowNumber\n    }\n  });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
