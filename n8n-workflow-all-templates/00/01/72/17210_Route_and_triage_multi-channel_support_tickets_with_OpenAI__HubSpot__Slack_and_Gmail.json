              "type": "string",
              "value": "={{ 'TKT-' + (Math.floor(Math.random() * 90000) + 10000) }}"
            },
            {
              "id": "sh2",
              "name": "customer_email",
              "type": "string",
              "value": "={{ $json.body.email || $json.body.customer_email || $json.body.from_email || '' }}"
            },
            {
              "id": "sh3",
              "name": "customer_name",
