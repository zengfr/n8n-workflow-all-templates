              "value": "={{ $json.sentiment || 'neutral' }}"
            },
            {
              "id": "triage4",
              "name": "language",
              "type": "string",
              "value": "={{ $json.language || 'english' }}"
            },
            {
              "id": "triage5",
              "name": "auto_resolve",
              "type": "boolean",
              "value": "={{ $json.auto_resolve || false }}"
            },
            {
              "id": "triage6",
              "name": "assigned_team",
              "type": "string",
              "value": "={{ $json.assigned_team || 'cs_team' }}"
            },
            {
              "id": "triage7",
              "name": "suggested_response",
              "type": "string",
              "value": "={{ $json.suggested_response || '' }}"
            },
            {
              "id": "triage8",
              "name": "confidence",
              "type": "number",
              "value": "={{ $json.confidence || 0.5 }}"
            }
          ]
        }
