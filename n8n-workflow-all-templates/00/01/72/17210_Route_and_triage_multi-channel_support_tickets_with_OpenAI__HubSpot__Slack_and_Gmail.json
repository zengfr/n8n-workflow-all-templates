              "value": "={{ $json.body.message || $json.body.content || $json.body.text || $json.body.body || '' }}"
            },
            {
              "id": "sh5",
              "name": "subject",
              "type": "string",
              "value": "={{ $json.body.subject || $json.body.topic || '' }}"
            },
            {
              "id": "sh6",
              "name": "channel",
              "type": "string",
              "value": "={{ $json.body.channel || $json.query.source || 'unknown' }}"
            },
            {
              "id": "sh7",
              "name": "phone",
              "type": "string",
              "value": "={{ $json.body.phone || $json.body.whatsapp_number || '' }}"
