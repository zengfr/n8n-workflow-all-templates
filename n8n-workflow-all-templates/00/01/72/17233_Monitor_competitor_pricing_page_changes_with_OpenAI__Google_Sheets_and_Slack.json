          }
        ],
        [
          {
            "node": "Update Snapshot in Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Content Change Summary Agent": {
      "main": [
        [
          {
            "node": "Post Summary to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Old Snapshot from Sheets": {
      "main": [
        [
          {
