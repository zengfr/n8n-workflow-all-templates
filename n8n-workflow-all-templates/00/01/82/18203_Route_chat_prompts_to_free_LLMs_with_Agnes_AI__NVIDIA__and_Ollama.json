      "name": "NVIDIA API FREE1",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Altri modelli:\nnvidia/nemotron-3-ultra-550b-a55b\nstepfun-ai/step-3.7-flash\nopenai/gpt-oss-120b\ngoogle/gemma-4-31b-it\nz-ai/glm-5.2",
