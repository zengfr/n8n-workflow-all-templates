      "parameters": {
        "url": "https://integrate.api.nvidia.com/v1/chat/completions",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n\"model\": \"nvidia/nemotron-3-ultra-550b-a55b\",\n\"messages\": [{\"role\":\"user\",\"content\":\"{{$json.chatInput}}\"}],\n\"stream\": false\n}",
