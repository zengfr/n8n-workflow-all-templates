    {
      "id": "a71ddf7a-2979-40eb-8036-a0829affcae5",
      "name": "AI Receipt Vision Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "onError": "continueErrorOutput",
      "maxTries": 2,
      "position": [
        9376,
        3920
      ],
      "parameters": {
        "text": "=You are a receipt / invoice extractor. The receipt image is attached to this message.\n\nRules:\n- Extract ONLY what is visibly printed on the image. Never invent a value.\n- If a value cannot be read, return an empty string for text and 0 for numbers.\n- receiptDate MUST be normalised to YYYY-MM-DD. If the year is missing, use the current year.\n- Keep the currency exactly as printed (MAD, DH, EUR, USD, ...).\n- total is the final amount paid, tax included.\n- confidence is 0-100: how sure you are that merchant, date and total are all correct.\n- If the image is blurry, cropped, or is not a receipt, set needsReview to true and say why in reviewReason.\n- If you cannot see an image at all, set confidence to 0 and reviewReason to NO_IMAGE_RECEIVED.",
        "batching": {},
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "retryOnFail": true,
      "typeVersion": 1.7
    },
    {
      "id": "fddcf670-023f-4b46-8096-ffb4acf38899",
      "name": "Build Receipt Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        9552,
        4144
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"merchant\": {\n      \"type\": \"string\",\n      \"description\": \"Shop or company name printed on the receipt\"\n    },\n    \"receiptDate\": {\n      \"type\": \"string\",\n      \"description\": \"Date in YYYY-MM-DD format\"\n    },\n    \"currency\": {\n      \"type\": \"string\",\n      \"description\": \"Currency code or symbol as printed\"\n    },\n    \"total\": {\n      \"type\": \"number\",\n      \"description\": \"Final amount paid, tax included\"\n    },\n    \"tax\": {\n      \"type\": \"number\",\n      \"description\": \"Tax amount, 0 if not shown\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"FOOD\",\n        \"TRANSPORT\",\n        \"SHOPPING\",\n        \"UTILITIES\",\n        \"HEALTH\",\n        \"BUSINESS\",\n        \"TRAVEL\",\n        \"ENTERTAINMENT\",\n        \"OTHER\"\n      ]\n    },\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"qty\": {\n            \"type\": \"number\"\n          },\n          \"price\": {\n            \"type\": \"number\"\n          }\n        }\n      }\n    },\n    \"paymentMethod\": {\n      \"type\": \"string\"\n    },\n    \"invoiceNumber\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"description\": \"0-100 certainty on merchant, date and total\"\n    },\n    \"needsReview\": {\n      \"type\": \"boolean\"\n    },\n    \"reviewReason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"merchant\",\n    \"receiptDate\",\n    \"currency\",\n    \"total\",\n    \"tax\",\n    \"category\",\n    \"confidence\",\n    \"needsReview\",\n    \"reviewReason\"\n  ]\n}"
      },
      "typeVersion": 1.2
    },
