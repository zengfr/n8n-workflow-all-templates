              "type": "number",
              "value": "={{ $json.message.chat.id }}"
            },
            {
              "id": "f-messageid",
              "name": "messageId",
              "type": "number",
              "value": "={{ $json.message.message_id }}"
            },
            {
              "id": "f-caption",
              "name": "caption",
              "type": "string",
              "value": "={{ ($json.message.caption || '').trim() }}"
            },
            {
              "id": "f-istotalcommand",
              "name": "isTotalCommand",
              "type": "boolean",
              "value": "={{ ($json.message.text || '').trim().toLowerCase().startsWith('/total') }}"
            },
            {
              "id": "f-fileid",
              "name": "fileId",
              "type": "string",
              "value": "={{ $json.message.photo ? $json.message.photo.last().file_id : ($json.message.document && ($json.message.document.mime_type.startsWith('image/') || $json.message.document.mime_type === 'application/pdf') ? $json.message.document.file_id : '') }}"
            },
            {
              "id": "f-hasfile",
              "name": "hasFile",
              "type": "boolean",
              "value": "={{ Boolean($json.message.photo) || Boolean($json.message.document && ($json.message.document.mime_type.startsWith('image/') || $json.message.document.mime_type === 'application/pdf')) }}"
            }
          ]
        }
