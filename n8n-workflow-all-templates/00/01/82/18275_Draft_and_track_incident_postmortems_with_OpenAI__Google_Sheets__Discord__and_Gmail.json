      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1216,
        736
      ],
      "parameters": {
        "text": "={{ 'Incident details: ' + JSON.stringify($json) }}",
        "options": {
          "systemMessage": "You are an incident postmortem writer for a software team. Write clear, blameless postmortem content based on the incident details. Return ONLY valid JSON with exactly these keys: overview (string, 2-3 sentences), timeline (string, a short bullet-style list of key moments), root_cause (string, 2-3 sentences), impact (string, 1-2 sentences), action_items (string, one action item per line in the format 'Owner: <name> | Due: <YYYY-MM-DD> | <task>'; write 2-4 realistic action items), digest (string, 2 sentences for a team notification). Do not use markdown code fences, return the raw JSON object only."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
