    {
      "id": "0e261214-662e-4ffc-8e5c-ca3090b9622b",
      "name": "Prepare Weekly Follow-up",
      "type": "n8n-nodes-base.code",
      "position": [
        592,
        1440
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = Date.now();\nconst open = items.filter((i) => String(i.json.status || '').toUpperCase() === 'OPEN');\nif (open.length === 0) {\n  return [{ json: { no_open: true } }];\n}\nconst out = [];\nfor (const it of open) {\n  const j = it.json;\n  let is_overdue = false;\n  let due = String(j.due_date || '').trim();\n  if (due) {\n    const d = new Date(due);\n    if (!isNaN(d.getTime()) && d.getTime() < now) { is_overdue = true; }\n  }\n  out.push({\n    json: {\n      incident_id: j.incident_id || '',\n      incident_title: j.incident_title || '',\n      item_text: j.item_text || '',\n      owner: j.owner || '',\n      due_date: due,\n      status: 'OPEN',\n      reporter_email: j.reporter_email || '',\n      is_overdue: is_overdue,\n      line: (j.incident_title || '') + ' | ' + (j.item_text || '') + ' | Owner: ' + (j.owner || 'n/a') + ' | Due: ' + (due || 'n/a') + (is_overdue ? ' | OVERDUE' : '')\n    }\n  });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
