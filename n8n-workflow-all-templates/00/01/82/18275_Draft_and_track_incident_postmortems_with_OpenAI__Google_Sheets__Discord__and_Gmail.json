    {
      "id": "0436d2fe-87f7-4978-9c21-0474fec96255",
      "name": "Extract Action Items",
      "type": "n8n-nodes-base.code",
      "position": [
        2160,
        688
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const j = it.json;\n  const lines = String(j.action_items || '')\n    .split('\\n')\n    .map((l) => l.replace(/^\\s*[-*\\u2022]\\s*/, '').trim())\n    .filter((l) => l.length > 0);\n  if (lines.length === 0) {\n    out.push({ json: { incident_id: j.incident_id || '', incident_title: j.incident_title || '', item_text: 'No action items', owner: '', due_date: '', status: 'OPEN', reporter_email: j.reporter_email || '', created_at: j.received_at || '' } });\n  } else {\n    for (const line of lines) {\n      let owner = '';\n      let due = '';\n      const mO = line.match(/owner:\\s*([^|]+)/i);\n      const mD = line.match(/due:\\s*(\\d{4}-\\d{2}-\\d{2})/i);\n      if (mO) { owner = mO[1].trim(); }\n      if (mD) { due = mD[1].trim(); }\n      out.push({ json: { incident_id: j.incident_id || '', incident_title: j.incident_title || '', item_text: line, owner: owner, due_date: due, status: 'OPEN', reporter_email: j.reporter_email || '', created_at: j.received_at || '' } });\n    }\n  }\n}\nreturn out;"
      },
      "typeVersion": 2
    },
