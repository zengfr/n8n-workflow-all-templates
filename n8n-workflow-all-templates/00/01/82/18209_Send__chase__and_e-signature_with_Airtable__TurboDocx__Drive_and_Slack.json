    {
      "id": "28d5759f-8bea-418a-acf7-31a908925524",
      "name": "Keep only unsigned for 3+ days",
      "type": "n8n-nodes-base.code",
      "position": [
        2896,
        2016
      ],
      "parameters": {
        "jsCode": "// Chase anything sent 3+ days ago that we have not already reminded.\n// Reminding once is the point -- a daily nag is how you get marked as spam.\nconst DAYS = 3;\nconst cutoff = Date.now() - DAYS * 24 * 60 * 60 * 1000;\n\nreturn items.filter((item) => {\n  const f = item.json || {};\n  if (!f['Document ID']) return false;          // never actually sent\n  if (f['Reminded At']) return false;           // already chased once\n  const sentAt = f['Sent At'] ? new Date(f['Sent At']).getTime() : null;\n  return sentAt !== null && sentAt <= cutoff;\n});\n"
      },
      "typeVersion": 2
    },
