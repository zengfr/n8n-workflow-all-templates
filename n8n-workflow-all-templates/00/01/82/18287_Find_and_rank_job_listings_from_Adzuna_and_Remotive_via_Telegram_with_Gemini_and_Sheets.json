    {
      "id": "38f7de2c-e5df-4a0d-b417-1acd61010506",
      "name": "Normalize Adzuna Jobs",
      "type": "n8n-nodes-base.set",
      "position": [
        28016,
        11168
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "adzuna_jobs",
              "type": "array",
              "value": "={{ ($json.results || []).map(j => ({\n  title: String(j.title || '').replace(/<[^>]*>/g, ''),\n  company: String(j.company?.display_name || ''),\n  location: String(j.location?.display_name || ''),\n  remote: /remote/i.test(String(j.title || '') + ' ' + String(j.location?.display_name || '')),\n  salary: (j.salary_min || j.salary_max)\n    ? ((j.salary_min ? '$' + Math.round(Number(j.salary_min)).toLocaleString() : '')\n      + (j.salary_min && j.salary_max ? ' - ' : '')\n      + (j.salary_max ? '$' + Math.round(Number(j.salary_max)).toLocaleString() : ''))\n    : '',\n  description: String(j.description || '').replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim(),\n  source: 'Adzuna',\n  published_at: String(j.created || ''),\n  url: String(j.redirect_url || ''),\n  job_type: String(j.contract_time || j.contract_type || '')\n})) }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
