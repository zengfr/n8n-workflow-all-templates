      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "k1",
              "name": "domain",
              "type": "string",
              "value": "={{ $('Set Search Configuration').first().json.domain }}"
            },
            {
              "id": "k2",
              "name": "search_query",
              "type": "string",
              "value": "={{ $('AI Build Search Plan Agent').first().json.output.search_query }}"
            },
            {
              "id": "k3",
              "name": "jobs",
              "type": "array",
              "value": "={{ (() => {\n  const src = $('Merge Job Sources').first().json;\n  const clean = u => String(u || '').split('?')[0].replace(/\\/+$/, '').toLowerCase();\n  const logged = new Set(($json.data || []).map(r => clean(r.job_url)).filter(Boolean));\n  const seen = new Set();\n  const cap = Number($('Set Search Configuration').first().json.desc_chars || 300);\n  const out = [];\n  for (const j of [ ...(src.adzuna_jobs || []), ...(src.remotive_jobs || []) ]) {\n    if (!j || !j.title || !j.url) continue;\n    const key = clean(j.url);\n    if (!key || seen.has(key) || logged.has(key)) continue;\n    seen.add(key);\n    out.push({ ...j, description: String(j.description || '').slice(0, cap) });\n  }\n  return out.slice(0, Number($('Set Search Configuration').first().json.max_candidates || 24));\n})() }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
