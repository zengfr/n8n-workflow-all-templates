    {
      "id": "31a9680f-1388-4860-b571-e4998bace504",
      "name": "Format Telegram Report Chunks",
      "type": "n8n-nodes-base.set",
      "position": [
        30672,
        11360
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "chunks",
              "type": "array",
              "value": "={{ (() => {\n  const r = $json.output || {};\n  const jobs = r.top_jobs || [];\n  const head = 'JOB SEARCH COMPLETE\\n\\nDomain: ' + $('Set Search Configuration').first().json.domain\n    + '\\nJobs ranked: ' + jobs.length\n    + (r.search_summary ? '\\nSummary: ' + r.search_summary : '')\n    + '\\n\\nTOP JOBS\\n';\n  const blocks = jobs.map(j => [\n    j.rank + '. ' + (j.title || ''),\n    'Company: ' + (j.company || ''),\n    'Score: ' + (j.score || 0) + '/100',\n    'Location: ' + (j.location || (j.remote ? 'Remote' : '')),\n    j.salary ? 'Salary: ' + j.salary : '',\n    'Source: ' + (j.source || ''),\n    'Why: ' + (j.why_relevant || ''),\n    'Apply: ' + (j.url || '')\n  ].filter(Boolean).join('\\n'));\n  blocks.push('Listings can expire. Check the original posting before applying.');\n  const out = [];\n  let cur = head;\n  for (const b of blocks) {\n    if ((cur + '\\n' + b).length > 3800) { out.push(cur); cur = ''; }\n    cur += '\\n' + b + '\\n';\n  }\n  if (cur.trim()) out.push(cur);\n  return out;\n})() }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
