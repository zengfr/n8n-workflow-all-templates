    {
      "id": "8a367186-c5ea-4a71-8875-af1b6bb057e6",
      "name": "Build Alert Payload & Escalation Message",
      "type": "n8n-nodes-base.code",
      "position": [
        2112,
        -800
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Combine the deviation/ROCOF analysis with recent historical context into\n// an operator-facing alert, and decide whether operators should be paged.\nconst item = $input.item.json;\nconst history = $('Fetch Historical Stability Context').item.json;\nconst recentEvents = (history && history.events) || [];\n\nlet primaryCause = 'Frequency deviation';\nif (Math.abs(item.rocofHzPerSec) >= item.rocofWarningThreshold) {\n  primaryCause = 'Rapid rate-of-change of frequency (ROCOF)';\n} else if (item.deviationHz > 0) {\n  primaryCause = 'Over-frequency (generation surplus / load loss)';\n} else if (item.deviationHz < 0) {\n  primaryCause = 'Under-frequency (generation deficit / load surge)';\n}\n\nconst recentSimilarCount = recentEvents.filter(e => e.severityTier === item.severityTier).length;\n\nconst pageOperators = item.severityTier === 'Warning' || item.severityTier === 'Critical';\n\nconst alertTitle = `${item.severityTier} frequency deviation: ${item.regionName}`;\nconst alertDescription = `Region ${item.regionName} is at ${item.currentFrequencyHz} Hz `\n  + `(deviation ${item.deviationHz} Hz from ${item.nominalFrequencyHz} Hz nominal, ROCOF ${item.rocofHzPerSec} Hz/s). `\n  + `Likely cause: ${primaryCause}. ${recentSimilarCount} similar-severity event(s) in the last 6 hours. `\n  + `Last reading at ${item.lastReadingTimestamp}.`;\n\nconst recommendedAction = item.severityTier === 'Critical'\n  ? 'Initiate load-shedding/reserve-dispatch runbook immediately and notify system operator on-call.'\n  : item.severityTier === 'Warning'\n    ? 'Increase monitoring cadence, prepare reserves, and notify the on-call operator.'\n    : 'Log for trend awareness; no immediate operator action required.';\n\nreturn {\n  json: {\n    ...item,\n    primaryCause,\n    recentSimilarCount,\n    pageOperators,\n    alertTitle,\n    alertDescription,\n    recommendedAction\n  }\n};"
      },
      "typeVersion": 2
    },
