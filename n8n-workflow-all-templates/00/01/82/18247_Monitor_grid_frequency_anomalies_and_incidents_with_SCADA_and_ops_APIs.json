    {
      "id": "b3ab438f-f61e-40e3-93bc-775420eb0661",
      "name": "Analyze Frequency Deviation & ROCOF",
      "type": "n8n-nodes-base.code",
      "position": [
        1376,
        -752
      ],
      "parameters": {
        "jsCode": "// Compute deviation from nominal frequency and rate-of-change-of-frequency\n// (ROCOF) per region, then classify a severity tier. Expects the telemetry\n// response shape: { regions: [ { regionId, regionName, readings: [ { timestamp, frequencyHz }, ... ] } ] }\nconst config = $('Set Configuration Parameters').item.json;\nconst response = $input.item.json;\nconst regions = response.regions || [];\n\nfunction classifyTier(absDeviation, absRocof) {\n  if (absDeviation >= config.criticalDeviationHz || absRocof >= config.rocofCriticalThreshold) return 'Critical';\n  if (absDeviation >= config.warningDeviationHz || absRocof >= config.rocofWarningThreshold) return 'Warning';\n  if (absDeviation >= config.watchDeviationHz) return 'Watch';\n  return 'Normal';\n}\n\nconst output = regions.map(region => {\n  const readings = region.readings || [];\n\n  if (readings.length < 2) {\n    return { json: { ...config, regionId: region.regionId, regionName: region.regionName || region.regionId, severityTier: 'Normal', reason: 'insufficient-data' } };\n  }\n\n  const last = readings[readings.length - 1];\n  const prev = readings[readings.length - 2];\n\n  const currentFrequencyHz = last.frequencyHz;\n  const deviationHz = Math.round((currentFrequencyHz - config.nominalFrequencyHz) * 1000) / 1000;\n\n  const deltaSeconds = Math.max((new Date(last.timestamp) - new Date(prev.timestamp)) / 1000, 0.001);\n  const rocofHzPerSec = Math.round(((last.frequencyHz - prev.frequencyHz) / deltaSeconds) * 1000) / 1000;\n\n  const recentWindow = readings.slice(-10).map(r => r.frequencyHz);\n  const rollingAverageHz = Math.round((recentWindow.reduce((a, b) => a + b, 0) / recentWindow.length) * 1000) / 1000;\n\n  const severityTier = classifyTier(Math.abs(deviationHz), Math.abs(rocofHzPerSec));\n\n  return {\n    json: {\n      ...config,\n      regionId: region.regionId,\n      regionName: region.regionName || region.regionId,\n      currentFrequencyHz,\n      deviationHz,\n      rocofHzPerSec,\n      rollingAverageHz,\n      severityTier,\n      lastReadingTimestamp: last.timestamp\n    }\n  };\n});\n\nreturn output;"
      },
      "typeVersion": 2
    },
