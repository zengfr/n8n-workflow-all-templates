    {
      "id": "9123c746-2637-480b-b0a7-7397c3c785c6",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "position": [
        1360,
        336
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const binaries = item.binary || {};\n\n  for (const [fieldName, binary] of Object.entries(binaries)) {\n    output.push({\n      json: {\n        ...item.json,\n        attachment_field: fieldName,\n        file_name: binary.fileName,\n      },\n      binary: {\n        data: binary,\n      },\n    });\n  }\n}\n\nreturn output;\n"
      },
      "typeVersion": 2
    },
    {
      "id": "24094712-9813-49e6-bb60-593e854296d4",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.code",
      "position": [
        1520,
        336
      ],
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('node');\nif (!staticData.processedAttachments) {\n  staticData.processedAttachments = {};\n}\n\nconst output = [];\nfor (const item of $input.all()) {\n  const key = `${item.json.id || ''}:${item.json.file_name || ''}`;\n  if (staticData.processedAttachments[key]) {\n    continue;\n  }\n  staticData.processedAttachments[key] = true;\n  output.push(item);\n}\n\nreturn output;\n"
      },
      "typeVersion": 2
    },
