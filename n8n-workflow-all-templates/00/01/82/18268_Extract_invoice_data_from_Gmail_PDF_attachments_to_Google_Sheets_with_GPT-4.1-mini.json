    {
      "id": "a299657d-7a90-4315-80c3-a7abf61fcd98",
      "name": "Parse JSON Response",
      "type": "n8n-nodes-base.code",
      "position": [
        2416,
        256
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function stripFences(raw) {\n  if (typeof raw !== 'string') return raw;\n  return raw\n    .trim()\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/```\\s*$/i, '')\n    .trim();\n}\n\nfunction toNumber(val) {\n  if (typeof val === 'number') return val;\n  if (typeof val === 'string') {\n    const cleaned = val.replace(/[^0-9.-]/g, '');\n    const n = parseFloat(cleaned);\n    return isNaN(n) ? null : n;\n  }\n  return null;\n}\n\nfunction extractCurrency(val) {\n  if (typeof val !== 'string') return null;\n  const match = val.trim().match(/^([A-Za-z]{2,5})/);\n  return match ? match[1].toUpperCase() : null;\n}\n\nfunction pick(obj, ...paths) {\n  for (const path of paths) {\n    const val = path.split('.').reduce((o, k) => (o == null ? undefined : o[k]), obj);\n    if (val !== undefined) return val;\n  }\n  return null;\n}\n\nconst item = $input.item;\nlet parsed;\ntry {\n  const jsonText = stripFences(item.json.output);\n  parsed = JSON.parse(jsonText);\n} catch (err) {\n  return { json: { error: `Failed to parse AI response: ${err.message}`, raw: item.json.output, validation_status: 'parse_error' } };\n}\n\nconst inv = parsed.invoice || parsed;\n\nconst company = inv.company || {};\nconst details = inv.invoice_details || {};\nconst billTo = inv.bill_to || {};\nconst payment = inv.payment_details || {};\nconst summary = inv.summary || {};\n\nconst invoiceNo = pick(inv, 'invoice_no', 'invoice_number') || pick(details, 'invoice_no');\nconst date = pick(inv, 'date') || pick(details, 'date');\nconst dueDate = pick(inv, 'due_date') || pick(details, 'due_date');\nconst poNumber = pick(inv, 'po_number', 'purchase_order') || pick(details, 'po_number');\nconst status = pick(inv, 'status') || pick(details, 'status') || pick(payment, 'status');\nconst paymentMethod = pick(inv, 'payment_method') || pick(details, 'payment_method') || pick(payment, 'method');\nconst terms = pick(inv, 'terms') || pick(details, 'terms') || pick(payment, 'terms');\n\nconst billToName = typeof billTo === 'string' ? billTo : billTo.name;\nconst billToAddress = typeof billTo === 'string' ? '' : billTo.address;\n\nconst subtotalRaw = pick(inv, 'subtotal') ?? summary.subtotal;\nconst discountRaw = pick(inv, 'discount') ?? summary.discount;\nconst taxRaw = pick(inv, 'tax') ?? summary.tax;\nconst grandTotalRaw = pick(inv, 'grand_total') ?? summary.grand_total;\n\nconst currency = extractCurrency(subtotalRaw) || extractCurrency(grandTotalRaw) || 'PKR';\nconst vendorContact = [company.phone, company.email].filter(Boolean).join(' | ') || null;\n\nconst subtotalNum = toNumber(subtotalRaw);\nconst discountNum = toNumber(discountRaw);\nconst taxNum = toNumber(taxRaw);\nconst grandTotalNum = toNumber(grandTotalRaw);\n\nlet validationStatus = 'ok';\nlet validationError = null;\n\nif (!invoiceNo || grandTotalNum == null) {\n  validationStatus = 'missing_fields';\n  validationError = 'Missing invoice number or grand total';\n} else {\n  const expected = (subtotalNum || 0) - (discountNum || 0) + (taxNum || 0);\n  if (Math.abs(expected - grandTotalNum) > 1) {\n    validationStatus = 'total_mismatch';\n  }\n}\n\nreturn {\n  json: {\n    invoice_number: invoiceNo,\n    date,\n    due_date: dueDate,\n    po_number: poNumber,\n    vendor_name: company.name || null,\n    vendor_address: company.address || null,\n    vendor_contact: vendorContact,\n    vendor_tax_ntn: company.tax_ntn || null,\n    bill_to: billToName,\n    bill_to_address: billToAddress,\n    payment_method: paymentMethod,\n    payment_terms: terms,\n    invoice_status: status,\n    subtotal: subtotalNum,\n    discount: discountNum,\n    tax: taxNum,\n    grand_total: grandTotalNum,\n    currency,\n    validation_status: validationStatus,\n    error: validationError,\n  },\n};\n"
      },
      "typeVersion": 2
    },
