    {
      "id": "e6aae7d3-8477-4429-8ba9-81d0ec7a99d1",
      "name": "Filter Due Reminders",
      "type": "n8n-nodes-base.code",
      "position": [
        1584,
        1184
      ],
      "parameters": {
        "jsCode": "const now=Date.now(); const outputs=[]; for(const item of $input.all()){const e=item.json; if((e.status||'').toLowerCase()==='cancelled') continue; const startRaw=e.start?.dateTime||e.start||e.startTime||e.start?.date; const start=new Date(startRaw); if(Number.isNaN(start.getTime())) continue; const diffMinutes=Math.round((start.getTime()-now)/60000); let reminderType=''; if(diffMinutes>=1380&&diffMinutes<=1500) reminderType='24H'; if(diffMinutes>=45&&diffMinutes<=75) reminderType='1H'; if(!reminderType) continue; outputs.push({json:{eventId:e.id||'',title:e.summary||e.title||'Appointment',start:start.toISOString(),location:e.location||'',diffMinutes,reminderType,reminderKey:`${e.id||e.summary}-${reminderType}`}});} return outputs;"
      },
      "typeVersion": 2,
      "alwaysOutputData": false
    },
