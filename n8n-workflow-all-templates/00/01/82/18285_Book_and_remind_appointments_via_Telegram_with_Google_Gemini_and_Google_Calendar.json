    {
      "id": "04172616-6eb2-42ac-b95c-8339e4c8d156",
      "name": "Parse Telegram Message",
      "type": "n8n-nodes-base.code",
      "position": [
        1360,
        432
      ],
      "parameters": {
        "jsCode": "const msg=$json.message||{}; const text=(msg.text||'').trim(); const chatId=msg.chat?.id; if(!text||!chatId) throw new Error('Telegram message text or chat ID is missing'); return [{json:{chatId,rawText:text,receivedAt:new Date().toISOString(),senderName:[msg.from?.first_name,msg.from?.last_name].filter(Boolean).join(' '),telegramMessageId:msg.message_id}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "b327d5b6-e5c6-4564-be30-701d314f6195",
      "name": "Validate Appointment Input",
      "type": "n8n-nodes-base.code",
      "position": [
        1936,
        432
      ],
      "parameters": {
        "jsCode": "const original = $('Parse Telegram Message').item.json;\n\n// AI Agent normally returns its answer in $json.output\nlet raw = $json.output || $json.text || '';\n\nraw = String(raw)\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  return [{\n    json: {\n      ...original,\n      title: '',\n      start: '',\n      end: '',\n      location: '',\n      notes: '',\n      needsClarification: true,\n      clarificationQuestion:\n        'I could not understand the appointment. Please send the date and time clearly.'\n    }\n  }];\n}\n\n// Validate start\nconst start = parsed.start ? new Date(parsed.start) : null;\n\nif (!start || Number.isNaN(start.getTime())) {\n  parsed.needsClarification = true;\n  parsed.clarificationQuestion =\n    parsed.clarificationQuestion ||\n    'What date and time should I schedule this appointment for?';\n}\n\n// If end is missing, default to 1 hour\nlet end = parsed.end ? new Date(parsed.end) : null;\n\nif ((!end || Number.isNaN(end.getTime())) && start && !Number.isNaN(start.getTime())) {\n  parsed.end = new Date(start.getTime() + 60 * 60 * 1000).toISOString();\n}\n\nreturn [{\n  json: {\n    ...original,\n    title: parsed.title || 'Appointment',\n    start: parsed.start || '',\n    end: parsed.end || '',\n    location: parsed.location || '',\n    notes: parsed.notes || '',\n    needsClarification: Boolean(parsed.needsClarification),\n    clarificationQuestion:\n      parsed.clarificationQuestion ||\n      'Please provide the missing appointment details.'\n  }\n}];"
      },
      "typeVersion": 2
    },
