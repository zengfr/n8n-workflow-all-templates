      "name": "Extract Search Results",
      "type": "n8n-nodes-base.code",
      "position": [
        2160,
        448
      ],
      "parameters": {
        "jsCode": "const organicResults = $json.organic || [];\n\nreturn organicResults.slice(0, 5).map(result => {\n  return {\n    json: {\n      searchQuery: $json.searchParameters.q,\n      title: result.title,\n      snippet: result.snippet,\n      url: result.link,\n      sourceDate: result.date || null,\n      position: result.position\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
