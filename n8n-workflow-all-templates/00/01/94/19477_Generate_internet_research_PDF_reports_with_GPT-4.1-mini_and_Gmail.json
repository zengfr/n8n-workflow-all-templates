      ],
      "parameters": {
        "jsCode": "const articles = items.map(item => {\n  const text = item.json.output[0].content[0].text;\n  return JSON.parse(text);\n});\n\nreturn [\n  {\n    json: {\n      articles\n    }\n  }\n];"
