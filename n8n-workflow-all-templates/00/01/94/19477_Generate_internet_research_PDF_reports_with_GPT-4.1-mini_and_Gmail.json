    {
      "id": "81e00c61-4ef8-492a-bdb1-f0537cd303d5",
      "name": "Analyze Research Insights",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        3920,
        448
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
