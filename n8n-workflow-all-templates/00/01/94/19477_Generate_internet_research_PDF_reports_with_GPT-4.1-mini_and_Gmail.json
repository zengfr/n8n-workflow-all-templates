    {
      "id": "db8995e1-9bc8-4b6f-9321-4c64d30f937a",
      "name": "Format Search Queries",
      "type": "n8n-nodes-base.code",
      "position": [
        1648,
        448
      ],
      "parameters": {
        "jsCode": "const text = $json.output[0].content[0].text;\n\nconst queries = JSON.parse(text);\n\nreturn queries.map(query => {\n  return {\n    json: {\n      query\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
