    {
      "id": "50568dfc-6dca-4863-9c74-b29bd7975f52",
      "name": "Split Pricebooks into Loop Items1",
      "type": "n8n-nodes-base.code",
      "position": [
        1104,
        304
      ],
      "parameters": {
        "jsCode": "const pricebooks = $('Sheets - Read Product Rows1').first().json.Pricebook;\n\nconst pricebookArray = pricebooks.split(',').map(p => p.trim());\n\nreturn pricebookArray.map(p => {\n  return {\n    json: {\n      pricebook: p\n    }\n  };\n});"
