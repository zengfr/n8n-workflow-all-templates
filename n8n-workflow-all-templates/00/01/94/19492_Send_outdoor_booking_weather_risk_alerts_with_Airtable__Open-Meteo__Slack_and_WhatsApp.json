    {
      "id": "8af741c2-8277-4fe4-b182-02b65b632df4",
      "name": "Calculate Weather Risk",
      "type": "n8n-nodes-base.code",
      "position": [
        2064,
        624
      ],
      "parameters": {
        "jsCode": "const booking = $('Filter Upcoming Bookings').first().json;\nconst config = $('Prepare Configuration Settings').first().json;\nconst forecast = $json.daily;\n\nconst rainProb = forecast.precipitation_probability_max ? forecast.precipitation_probability_max[0] : 0;\nconst rainAmount = forecast.precipitation_sum ? forecast.precipitation_sum[0] : 0;\nconst windSpeed = forecast.windspeed_10m_max ? forecast.windspeed_10m_max[0] : 0;\n\nlet riskLevel = 'none';\n\nconst isSevere = (rainProb >= config.rain_probability_threshold && rainAmount >= config.heavy_rain_mm_threshold)\n  || windSpeed >= config.high_wind_kmh_threshold;\n\nconst isModerate = !isSevere && (rainProb >= config.rain_probability_threshold || rainAmount > 0);\n\nif (isSevere) {\n  riskLevel = 'severe';\n} else if (isModerate) {\n  riskLevel = 'moderate';\n}\n\nreturn [{\n  json: {\n    booking_id: booking.id,\n    customer_name: booking.customer_name,\n    customer_number: booking.customer_number,\n    booking_date: booking.booking_date,\n    location: booking.location,\n    customer_already_notified: !!booking.customer_notified,\n    rain_probability: rainProb,\n    rain_amount_mm: rainAmount,\n    wind_speed_kmh: windSpeed,\n    risk_level: riskLevel\n  }\n}];"
      },
      "typeVersion": 2
    },
