    {
      "id": "c2924af4-5d9c-45f9-9619-c3f40aa0e3a6",
      "name": "Filter Upcoming Bookings",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        624
      ],
      "parameters": {
        "jsCode": "const lookaheadDays = Number($('Prepare Configuration Settings').first().json.lookahead_days);\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst cutoff = new Date(today);\ncutoff.setDate(cutoff.getDate() + lookaheadDays);\n\nreturn $input.all().filter(item => {\n  const bookingDate = new Date(item.json.booking_date);\n  return bookingDate >= today && bookingDate <= cutoff;\n});"
      },
      "typeVersion": 2
    },
