    {
      "id": "221880af-9879-4f2d-b566-cc625cf68b1b",
      "name": "Calculate remaining capacity",
      "type": "n8n-nodes-base.code",
      "position": [
        656,
        784
      ],
      "parameters": {
        "jsCode": "const config = $('Configure limits').first().json;\nconst rows = $input.all().map(i => i.json);\n\nconst byEmployee = {};\nfor (const r of rows) {\n  const id = String(r.employeeId || '').trim();\n  const month = String(r.month || '').trim();\n  if (!id || !/^\\d{4}-\\d{2}$/.test(month)) continue;\n\n  byEmployee[id] = byEmployee[id] || { employeeId: id, name: r.name, months: {} };\n  byEmployee[id].months[month] = {\n    overtime: Number(r.overtimeHours) || 0,\n    holiday: Number(r.holidayWorkHours) || 0,\n  };\n}\n\nfunction shiftMonth(ym, back) {\n  const [y, m] = ym.split('-').map(Number);\n  const d = new Date(y, m - 1 - back, 1);\n  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;\n}\n\nconst current = config.currentMonth;\nconst warnings = [];\n\nfor (const emp of Object.values(byEmployee)) {\n  const get = ym => emp.months[ym] || null;\n  const combined = ym => {\n    const v = get(ym);\n    return v ? v.overtime + v.holiday : null;\n  };\n\n  const thisMonth = get(current) || { overtime: 0, holiday: 0 };\n  const usedCombined = thisMonth.overtime + thisMonth.holiday;\n\n  const candidates = [];\n\n  candidates.push({\n    limit: 'Monthly cap (under 100h)',\n    remaining: config.monthlyCombinedLimit - 1 - usedCombined,\n  });\n\n  const missing = [];\n  for (let w = 2; w <= 6; w++) {\n    let past = 0;\n    let complete = true;\n    for (let b = 1; b < w; b++) {\n      const ym = shiftMonth(current, b);\n      const v = combined(ym);\n      if (v === null) { complete = false; missing.push(ym); break; }\n      past += v;\n    }\n    if (!complete) continue;\n    const allowed = config.rollingAverageLimit * w - past;\n    candidates.push({\n      limit: `${w}-month average (80h)`,\n      remaining: allowed - usedCombined,\n    });\n  }\n\n  let yearOvertime = 0;\n  for (let b = 0; b < 12; b++) {\n    const v = get(shiftMonth(current, b));\n    if (v) yearOvertime += v.overtime;\n  }\n  candidates.push({\n    limit: 'Annual cap (720h)',\n    remaining: config.annualOvertimeLimit - yearOvertime,\n  });\n\n  const binding = candidates.reduce((a, b) => (b.remaining < a.remaining ? b : a));\n\n  if (binding.remaining < config.warnWhenRemainingBelow) {\n    warnings.push({\n      employeeId: emp.employeeId,\n      name: emp.name,\n      month: current,\n      usedThisMonth: usedCombined,\n      bindingLimit: binding.limit,\n      remainingHours: Math.max(0, Math.round(binding.remaining * 10) / 10),\n      incompleteMonths: [...new Set(missing)].join(', '),\n    });\n  }\n}\n\nreturn [{\n  json: {\n    warningCount: warnings.length,\n        checkedEmployees: Object.keys(byEmployee).length,\n    warnings,\n  },\n}];"
      },
      "typeVersion": 2
    },
