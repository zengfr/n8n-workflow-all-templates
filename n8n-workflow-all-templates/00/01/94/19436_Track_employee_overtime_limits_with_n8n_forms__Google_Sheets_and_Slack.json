    {
      "id": "d1d23021-6311-4629-b790-3abc20150bc2",
      "name": "Check the submission",
      "type": "n8n-nodes-base.code",
      "position": [
        384,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nconst problems = [];\n\nif (!/^\\d{4}-\\d{2}$/.test(d.month)) {\n  problems.push('Month must look like 2026-09.');\n} else {\n  const now = new Date();\n  const current = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;\n  if (d.month > current) {\n    problems.push('Month cannot be in the future.');\n  }\n}\n\nfor (const [label, value] of [\n  ['Overtime hours', d.overtimeHours],\n  ['Holiday work hours', d.holidayWorkHours],\n]) {\n  if (!Number.isFinite(value)) {\n    problems.push(`${label} must be a number.`);\n  } else if (value < 0 || value > 300) {\n    problems.push(`${label} must be between 0 and 300.`);\n  }\n}\n\nreturn {\n  json: {\n    ...d,\n    isUsable: problems.length === 0,\n    problems: problems.join(' '),\n  },\n};"
      },
      "typeVersion": 2
    },
