    {
      "id": "3b67c346-4f93-42be-889e-b36f928e0d9c",
      "name": "Parse Incident Fields from File",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        320
      ],
      "parameters": {
        "jsCode": "const INITIAL_REPORT_LABEL = 'Ankstyvasis perspėjimas';\n\n// false = omit null, undefined, and empty-string fields.\n// Boolean false is still preserved.\nconst INCLUDE_EMPTY_FIELDS = false;\n\nconst COMMON_FIELDS = [\n  'Organization',\n  'Reporter',\n  'ReporterEmail',\n  'ReporterPhone',\n  'ReporterTitle',\n  'Summary',\n  'DetectedOn',\n  'XSC_ExternalTicket_RecId'\n];\n\nconst FORM_FIELDS = {\n  Nedidelis: [\n    ...COMMON_FIELDS,\n    'TypeOfCyberIncident',\n    'AffectedEntities',\n    'ImpactToPersonYesNo',\n    'AffectedPersons',\n    'CyberIncidentResolvedYesNo',\n    'CyberIncidentResolvedValue',\n    'CriminalOffenceYesNo',\n    'AffectedServices',\n    'FinancialLossYesNo',\n    'FinancialLossValue',\n    'ImpactFromThirdPartyYesNo',\n    'ImpactFromThirdPartyValue',\n    'Evidence',\n    'CyberIncidentResolvedHelpYesNo',\n    'CyberIncidentResolvedHelpValue',\n    'CyberIncidentRecurrenceYesNo',\n    'CyberIncidentReportedYesNo',\n    'CyberIncidentReportedValue',\n    'FinalReportUpdateYesNo',\n    'Threat',\n    'ThreatCategory',\n    'CyberIncidentImpact',\n    'CyberIncidentMitigation',\n    'IntergovernmentalImpactYesNo',\n    'IntergovernmentalImpactValue',\n    'OtherInformation',\n  ],\n\n  Didelis: [\n    ...COMMON_FIELDS,\n    'TypeOfCyberIncident',\n\n    // The Excel export contains ScopeOption1–ScopeOption11.\n    ...Array.from(\n      { length: 11 },\n      (_, index) => `ScopeOption${index + 1}`,\n    ),\n\n    'InitialReportUpdateYesNo',\n    'CyberIncidentReputationYesNo',\n    'CyberIncidentReputationValue',\n    'ResolvedOn',\n    'ImpactToPersonYesNo',\n    'LossOption1',\n    'LossOption2',\n    'LossOption3',\n    'AffectedPersons',\n    'CyberIncidentResolvedYesNo',\n    'CyberIncidentResolvedValue',\n    'AffectedServices',\n    'FinancialLossYesNo',\n    'FinancialLossValue',\n    'ImpactFromThirdPartyYesNo',\n    'ImpactFromThirdPartyValue',\n    'Evidence',\n    'CyberIncidentRecurrenceYesNo',\n    'OtherInformation',\n  ],\n\n  [INITIAL_REPORT_LABEL]: [\n    ...COMMON_FIELDS,\n    'AffectedEntities',\n    'CriminalOffenceYesNo',\n    'Evidence',\n    'IntergovernmentalImpactYesNo',\n    'IntergovernmentalImpactValue',\n    'CyberIncidentResolvedHelpYesNo',\n    'CyberIncidentResolvedHelpValue',\n    'CyberIncidentReportedYesNo',\n    'CyberIncidentReportedValue',\n    'OtherInformation',\n  ],\n\n  'Vos neįvykęs': [\n    ...COMMON_FIELDS,\n    'TypeOfCyberIncident',\n    'AffectedEntities',\n    'DetailReportDescription',\n    'OtherInformation',\n  ],\n};\n\nconst DATE_FIELDS = new Set([\n  'DetectedOn',\n  'ResolvedOn',\n]);\n\nfunction getReportType(row) {\n  const securityReportType = String(\n    row.XSC_SecurityReportType ?? '',\n  ).trim();\n\n  // Initial reports do not contain TypeOfCyberIncident.\n  if (securityReportType === 'InitialReport') {\n    return INITIAL_REPORT_LABEL;\n  }\n\n  return String(row.TypeOfCyberIncident ?? '').trim();\n}\n\nfunction normalizeValue(fieldName, value) {\n  if (!DATE_FIELDS.has(fieldName) || value === null || value === undefined) {\n    return value;\n  }\n\n  // HTML examples use YYYY-MM-DDTHH:MM:SS.\n  if (value instanceof Date) {\n    return value.toISOString().slice(0, 19);\n  }\n\n  const text = String(value).trim();\n\n  // For example:\n  // 2026-07-20T09:16:33Z -> 2026-07-20T09:16:33\n  return text.length >= 19 ? text.slice(0, 19) : text;\n}\n\nfunction pickFields(row, fieldNames) {\n  const result = {};\n\n  for (const fieldName of fieldNames) {\n    const value = normalizeValue(fieldName, row[fieldName]);\n\n    const isEmpty =\n      value === null ||\n      value === undefined ||\n      value === '';\n\n    // false and 0 are intentionally not considered empty.\n    if (!INCLUDE_EMPTY_FIELDS && isEmpty) {\n      continue;\n    }\n\n    result[fieldName] = value;\n  }\n\n  return result;\n}\n\nreturn $input.all().map((item, index) => {\n  const row = item.json;\n  const reportType = getReportType(row);\n  const allowedFields = FORM_FIELDS[reportType];\n\n  if (!allowedFields) {\n    throw new Error(\n      `Unsupported report type in XLSX row ${index + 2}: ` +\n      `\"${reportType || '(empty)'}\". ` +\n      `TypeOfCyberIncident=\"${row.TypeOfCyberIncident ?? ''}\", ` +\n      `XSC_SecurityReportType=\"${row.XSC_SecurityReportType ?? ''}\"`,\n    );\n  }\n\n  return {\n    json: {\n      body: {\n        reportType,\n        fields: {\n          ExternalTicketID: $input.item.json.XSC_ExternalTicket_RecId,\n          ...pickFields(row, allowedFields),\n        },\n      },\n    },\n    pairedItem: {\n      item: index,\n    },\n  };\n});"
      },
      "typeVersion": 2
    },
