    {
      "id": "gemini_lookup",
      "name": "Gemini Word Lookup",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "maxTries": 5,
      "position": [
        480,
        860
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3.8-flash",
          "cachedResultName": "models/gemini-3.8-flash"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": "=You are a language tutor helping a {{ $json.learnerLevel }} learner of {{ $json.targetLanguage }}. The learner just came across this word, phrase, sentence, or grammar pattern: \"{{ $('When New Word Added').item.json['Word, phrase, or grammar pattern'] }}\"\n\nLook it up and return ONLY a raw JSON object (no markdown code fences, no extra commentary) with these exact keys:\n- \"term\": the word/phrase/pattern written in its native script\n- \"reading\": if the language uses a script with a separate phonetic reading (for example, hiragana next to Japanese kanji), give that reading here. Leave this an empty string if not applicable.\n- \"meaning\": a clear, concise English meaning or translation\n- \"example\": one natural example sentence using the term in the target language, followed by an English translation in parentheses\n- \"grammar_note\": a short, beginner-friendly breakdown of the grammar or conjugation involved (word-by-word or component-by-component where relevant), or a brief usage note if no grammar breakdown applies\n\nReturn compact, valid JSON only."
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {}
      },
      "retryOnFail": true,
      "typeVersion": 1.2,
      "waitBetweenTries": 5000
    },
    {
      "id": "code_parse",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "position": [
        784,
        860
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Extract the raw text the model produced. The real Gemini API response shape is\n// { content: { parts: [{ text: \"...\" }], role: \"model\" }, finishReason, index }\nlet raw;\nif (item && item.content && Array.isArray(item.content.parts)) {\n  raw = item.content.parts.map(p => p.text || '').join('');\n} else if (typeof item.content === 'string') {\n  raw = item.content;\n} else if (typeof item.text === 'string') {\n  raw = item.text;\n} else if (typeof item.output === 'string') {\n  raw = item.output;\n} else if (typeof item.response === 'string') {\n  raw = item.response;\n} else {\n  raw = item;\n}\n\nlet parsed;\nif (raw && typeof raw === 'object' && !Array.isArray(raw)) {\n  parsed = raw;\n} else {\n  let text = typeof raw === 'string' ? raw : JSON.stringify(raw);\n  text = text.trim()\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/, '')\n    .replace(/```\\s*$/, '')\n    .trim();\n  try {\n    parsed = JSON.parse(text);\n  } catch (e) {\n    parsed = {\n      term: $('When New Word Added').item.json['Word, phrase, or grammar pattern'],\n      reading: '',\n      meaning: 'Could not parse the AI response automatically - check it by hand: ' + text.slice(0, 300),\n      example: '',\n      grammar_note: ''\n    };\n  }\n}\n\nreturn [{\n  json: {\n    term: parsed.term || '',\n    reading: parsed.reading || '',\n    meaning: parsed.meaning || '',\n    example: parsed.example || '',\n    grammar_note: parsed.grammar_note || '',\n    date_added: new Date().toISOString().slice(0, 10),\n    last_sent: ''\n  }\n}];"
      },
      "typeVersion": 2
    },
