    {
      "id": "code_pick",
      "name": "Select Word of the Day",
      "type": "n8n-nodes-base.code",
      "position": [
        784,
        1340
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.term);\n\nif (rows.length === 0) {\n  return [];\n}\n\nlet candidates = rows.filter(r => !r.last_sent);\nif (candidates.length === 0) {\n  candidates = [...rows].sort((a, b) => new Date(a.last_sent) - new Date(b.last_sent));\n} else {\n  candidates.sort((a, b) => new Date(a.date_added) - new Date(b.date_added));\n}\n\nreturn [{ json: candidates[0] }];"
      },
      "typeVersion": 2
    },
