    {
      "id": "4e631d62-7cd1-4f6a-89c2-0f24b5d91624",
      "name": "Calculate Renewal Risk",
      "type": "n8n-nodes-base.code",
      "position": [
        1088,
        304
      ],
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n\n  const today = new Date();\n  const endDate = new Date(data.ContractEndDate);\n\n  const daysToEnd = Math.ceil(\n    (endDate - today) / (1000 * 60 * 60 * 24)\n  );\n\n  const noticePeriod = Number(data.NoticePeriodDays);\n\n  const hasAutoRenewal =\n    String(data.AutoRenewalClause).toLowerCase() === \"yes\";\n\n  const supplierRating = Number(data.SupplierRating);\n  const usageLevel = data.UsageLevel;\n\n  let riskLevel = \"Low\";\n\n  if (\n    hasAutoRenewal &&\n    daysToEnd <= noticePeriod &&\n    supplierRating < 3 &&\n    usageLevel === \"Low\"\n  ) {\n    riskLevel = \"High\";\n  } else if (\n    hasAutoRenewal &&\n    daysToEnd <= noticePeriod\n  ) {\n    riskLevel = \"Medium\";\n  }\n\n  return {\n    json: {\n      ...data,\n      daysToEnd,\n      riskLevel\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
