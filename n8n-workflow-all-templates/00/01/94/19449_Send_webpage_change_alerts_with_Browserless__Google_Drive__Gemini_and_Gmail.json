          "mappingMode": "defineBelow"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "url",
              "keyValue": "={{ $('Configuration (edit this first)').item.json.targetUrl }}"
            }
          ]
        },
        "options": {},
        "matchType": "allConditions",
        "operation": "update",
        "dataTableId": {
          "mode": "name",
          "value": "site_watch_state"
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "ifChanged",
      "name": "Did the AI detect a meaningful change?",
      "type": "n8n-nodes-base.if",
      "position": [
        2448,
        368
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "startsWith"
              },
              "leftValue": "={{ $('Compare screenshots with AI').item.json.content }}",
              "rightValue": "CHANGED:"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "notifyChange",
      "name": "Email: change alert",
      "type": "n8n-nodes-base.gmail",
      "maxTries": 3,
      "position": [
        2672,
        272
      ],
      "webhookId": "ebd71375-26c5-46fb-8b87-25b151c538df",
      "parameters": {
        "sendTo": "={{ $('Configuration (edit this first)').item.json.notifyEmail }}",
        "message": "={{ $('Compare screenshots with AI').item.json.content }}",
        "options": {},
        "subject": "=Change detected: {{ $('Configuration (edit this first)').item.json.targetUrl }}"
      },
      "retryOnFail": true,
      "typeVersion": 2.1,
      "waitBetweenTries": 3000
    },
    {
      "id": "noChange",
      "name": "No meaningful change - nothing to do",
      "type": "n8n-nodes-base.noOp",
      "position": [
        2672,
        464
      ],
      "parameters": {},
      "typeVersion": 1
    }
