    {
      "id": "29d7c904-e21f-4307-9ee2-2a3a0da0405c",
      "name": "Execute 3-Way Match Logic",
      "type": "n8n-nodes-base.code",
      "position": [
        2736,
        592
      ],
      "parameters": {
        "jsCode": "const invoice = $('Set Invoice Fields').first().json;\nconst po = $('Read Purchase Orders').first().json;\nconst grn = $('Read Goods Receipts').first().json;\n\nconst reasons = [];\n\nconst hasPO = Boolean(po && po.poNumber);\nconst hasGRN = Boolean(grn && grn.grnNumber);\n\nconst invoiceQty = Number(invoice.invoiceQuantity);\nconst invoiceUnitPrice = Number(invoice.unitPrice);\nconst invoiceTotal = Number(invoice.invoiceTotal);\n\nconst poQty = hasPO ? Number(po.orderedQuantity) : null;\nconst poUnitPrice = hasPO ? Number(po.unitPrice) : null;\nconst receivedQty = hasGRN ? Number(grn.receivedQuantity) : null;\n\nif (!hasPO) {\n  reasons.push('Purchase Order not found');\n} else {\n  if (po.poStatus !== 'APPROVED') {\n    reasons.push('Purchase Order is not approved');\n  }\n\n  if (invoice.vendorId !== po.vendorId) {\n    reasons.push('Vendor mismatch');\n  }\n\n  if (invoice.itemCode !== po.itemCode) {\n    reasons.push('Item / SKU mismatch');\n  }\n\n  if (invoice.poNumber !== po.poNumber) {\n    reasons.push('PO Number mismatch');\n  }\n\n  if (invoice.currency !== po.currency) {\n    reasons.push('Currency mismatch');\n  }\n\n  if (invoiceQty > poQty) {\n    reasons.push('Invoice quantity exceeds ordered quantity');\n  }\n\n  if (invoiceUnitPrice !== poUnitPrice) {\n    reasons.push('Unit price mismatch');\n  }\n}\n\nif (!hasGRN) {\n  reasons.push('Goods Receipt not found');\n} else {\n  if (grn.receiptStatus !== 'RECEIVED') {\n    reasons.push('Goods Receipt is not received');\n  }\n\n  if (invoice.vendorId !== grn.vendorId && !reasons.includes('Vendor mismatch')) {\n    reasons.push('Vendor mismatch');\n  }\n\n  if (invoice.itemCode !== grn.itemCode && !reasons.includes('Item / SKU mismatch')) {\n    reasons.push('Item / SKU mismatch');\n  }\n\n  if (invoice.poNumber !== grn.poNumber && !reasons.includes('PO Number mismatch')) {\n    reasons.push('PO Number mismatch');\n  }\n\n  if (invoice.grnNumber !== grn.grnNumber) {\n    reasons.push('GRN Number mismatch');\n  }\n\n  if (invoiceQty > receivedQty) {\n    reasons.push('Invoice quantity exceeds received quantity');\n  }\n}\n\nconst expectedTotal = hasPO && Number.isFinite(poUnitPrice)\n  ? invoiceQty * poUnitPrice\n  : null;\n\nif (\n  expectedTotal !== null &&\n  invoiceTotal !== expectedTotal\n) {\n  reasons.push('Invoice total mismatch');\n}\n\nreturn [\n  {\n    json: {\n      invoiceNumber: invoice.invoiceNumber,\n      vendorId: invoice.vendorId,\n      poNumber: invoice.poNumber,\n      grnNumber: invoice.grnNumber,\n      itemCode: invoice.itemCode,\n\n      invoiceQuantity: invoiceQty,\n      orderedQuantity: poQty,\n      receivedQuantity: receivedQty,\n\n      invoiceUnitPrice: invoiceUnitPrice,\n      poUnitPrice: poUnitPrice,\n\n      invoiceTotal: invoiceTotal,\n      expectedTotal: expectedTotal,\n\n      currency: invoice.currency,\n\n      matchPassed: reasons.length === 0,\n      matchStatus: reasons.length === 0 ? 'MATCHED' : 'MISMATCH',\n      exceptionReasons: reasons\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
