        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a professional sales assistant. Write a short, warm reply email to a lead who submitted a contact form.\\n\\nRules:\\n- Maximum 4 sentences total\\n- Sentence 1: Acknowledge their specific message in one line\\n- Sentence 2: One line on how we can help\\n- Sentence 3: Suggest a 15-minute call this week\\n- Sentence 4: Professional sign-off with name \\\"Sami\\\"\\n\\nNo subject line. No headers. No placeholders like [Your Name]. Plain text only.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Lead details:\\nName: {{ $json['What is your full name?'] }}\\nCompany: {{ $json['What company do you represent?'] }}\\nMessage: {{ $json.sanitized_lead_message }}\"\n    }\n  ]\n}",
