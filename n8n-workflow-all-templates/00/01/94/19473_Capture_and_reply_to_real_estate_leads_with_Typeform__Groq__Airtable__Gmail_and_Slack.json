    {
      "id": "70a0d5a0-02b3-4165-8059-6b6edc3d00d9",
      "name": "Clean Lead Message",
      "type": "n8n-nodes-base.code",
      "onError": "continueRegularOutput",
      "position": [
        1808,
        192
      ],
      "parameters": {
        "jsCode": "// 1. Fetch the raw input message from the Typeform submission payload\nconst rawMessage = $('When Typeform Submitted').first()?.json['How can we help you?'] || \"\";\n\n// 2. Set the strict technical character threshold (Consulting standard: 500 characters)\nconst CHAR_LIMIT = 500;\n\n// 3. Truncate the text safely if it exceeds the limit and append ellipsis\nlet cleanMessage = rawMessage;\nif (rawMessage.length > CHAR_LIMIT) {\n  cleanMessage = rawMessage.substring(0, CHAR_LIMIT) + \"... [Truncated for Token Optimization]\";\n}\n\n// 4. Pass the sanitized payload forward to the Groq node execution pipeline\nreturn [{\n  json: {\n    ...$json,\n    sanitized_lead_message: cleanMessage\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "8dc12593-0ece-407d-8c72-63c02371ba2d",
      "name": "Check AI Draft Validity",
      "type": "n8n-nodes-base.code",
      "onError": "continueErrorOutput",
      "position": [
        2512,
        192
      ],
      "parameters": {
        "jsCode": "// 1. Safely extract the message content from the Groq node response\nconst groqResponse = $('Post to Groq API').first()?.json;\nconst draftText = groqResponse?.choices?.[0]?.message?.content;\n\n// 2. Validate if the generated draft is empty, null, or contains fallback placeholders\nif (!draftText || draftText.trim() === \"\" || draftText.includes(\"[Your Name]\")) {\n  // Intentionally throw an error to route the execution to the fallback backup branch\n  throw new Error(\"Groq validation failed: AI response is empty, invalid, or missing content.\");\n}\n\n// 3. Pass the clean, validated draft data forward to the main sequence\nreturn [{\n  json: {\n    ...$json,\n    validated_draft: draftText.trim()\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "57915ada-a5ad-4a40-8d9c-25d4f62dc917",
      "name": "Check CRM Update Success",
      "type": "n8n-nodes-base.code",
      "onError": "continueErrorOutput",
      "position": [
        3712,
        160
      ],
      "parameters": {
        "jsCode": "// 1. Fetch the data returned by the CRM/Airtable node API response\nconst crmResponse = $('Update CRM with Lead').first()?.json;\n\n// 2. Safely access the saved fields returned by the CRM using exact Airtable Column Names\nconst savedEmail = crmResponse?.fields?.Email || crmResponse?.Email;\nconst savedDraft = crmResponse?.fields?.Draft || crmResponse?.Draft;\n\n// 3. Strict structural checks: Ensure the CRM actually saved critical data fields without dropping them\nif (!savedEmail || !savedDraft || savedDraft.trim() === \"\") {\n  throw new Error(\"CRM Write Mismatch: CRM accepted the payload but returned an empty or truncated data structure.\");\n}\n\n// 4. Forward clean payload if verification checks pass\nreturn [{\n  json: {\n    ...$json,\n    crm_verification: \"verified_stable\"\n  }\n}];"
      },
      "typeVersion": 2
    }
