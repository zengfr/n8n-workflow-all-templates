    {
      "id": "fa8b83de-80dc-4e6e-acc0-0bdb6ef44f4e",
      "name": "Compare Invoice and Contract Prices",
      "type": "n8n-nodes-base.code",
      "position": [
        1168,
        272
      ],
      "parameters": {
        "jsCode": "const invoiceRows = $('When Invoice Added to Sheets').all().map(item => item.json);\nconst contractRows = $input.all().map(item => item.json);\n\nconst results = invoiceRows.map(invoiceRow => {\n  const match = contractRows.find(r => r['Item Code'] === invoiceRow['Item Code']);\n\n  const invoicedPrice = parseFloat(invoiceRow['Invoiced Unit Price ($)']);\n  const quantity = parseFloat(invoiceRow['Quantity']);\n\n  let agreedPrice = null;\n  let priceDifference = null;\n  let overchargeAmount = 0;\n  let status = '';\n\n  if (!match) {\n    status = 'Item Not Found - Verify Code';\n  } else {\n    agreedPrice = parseFloat(match['Agreed Price ($)']);\n    priceDifference = invoicedPrice - agreedPrice;\n    if (priceDifference > 0) {\n      overchargeAmount = priceDifference * quantity;\n      status = 'OVERCHARGED';\n    } else if (priceDifference < 0) {\n      status = 'Undercharged - Check';\n    } else {\n      status = 'OK';\n    }\n  }\n\n  return {\n    json: {\n      'Invoice Number': invoiceRow['Invoice Number'],\n      'Invoice Date': invoiceRow['Invoice Date'],\n      'Supplier': invoiceRow['Supplier'],\n      'Item Code': invoiceRow['Item Code'],\n      'Item Name': invoiceRow['Item Name'],\n      'Quantity': quantity,\n      'Invoiced Price ($)': invoicedPrice,\n      'Agreed Price ($)': agreedPrice !== null ? agreedPrice : 'Not Found',\n      'Price Difference ($)': priceDifference !== null ? priceDifference : '',\n      'Overcharge Amount ($)': overchargeAmount,\n      'Status': status\n    }\n  };\n});\n\nreturn results;"
      },
      "typeVersion": 2
    },
