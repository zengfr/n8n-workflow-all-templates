      "type": "n8n-nodes-base.httpRequest",
      "position": [
        3184,
        784
      ],
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are a real-estate operations analyst reviewing one listing. Respond ONLY with a JSON object of this exact shape: {\\\"likely_issue\\\": string, \\\"suggested_action\\\": string, \\\"severity\\\": \\\"low\\\" | \\\"medium\\\" | \\\"high\\\"}.\\n\\nIf dataQualityIssue is true, ignore performance entirely and just describe what data is missing/invalid and needs fixing; severity should be low unless it's blocking the listing from being tracked at all.\\n\\nOtherwise diagnose using:\\nProperty: {{ $json['Property'] }}\\nDays on market: {{ $json.daysOnMarket }}\\nEnquiries: {{ $json.enquiries }} | Viewings: {{ $json.viewings }} | Offers: {{ $json.offers }}\\nEnquiry-to-viewing rate: {{ $json.enquiryToViewingRate }} (portfolio median: {{ $json.medianEnquiryToViewing }})\\nViewing-to-offer rate: {{ $json.viewingToOfferRate }} (portfolio median: {{ $json.medianViewingToOffer }})\\nDetected pattern: {{ $json.issueType }}\\ndataQualityIssue: {{ $json.dataQualityIssue }}\\nInterest cooling off vs its own earlier pace: {{ $json.coolingOff }}\\nTimes previously flagged: {{ $json.alertCount }}\\n\\nBe specific and actionable — reference the portfolio comparison or the cooling-off trend if that's what's driving the flag, rather than restating days-on-market. Keep likely_issue under 20 words and suggested_action under 25 words.\"\n    }]\n  }],\n  \"generationConfig\": { \"responseMimeType\": \"application/json\" }\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi"
