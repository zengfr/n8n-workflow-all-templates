    {
      "id": "420d8e6f-93ba-4757-b20c-5d8b04893cf7",
      "name": "Compute Listing Metrics",
      "type": "n8n-nodes-base.code",
      "position": [
        2464,
        784
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst today = new Date();\n\n// ---------- PASS 1: normalize + per-row metrics ----------\nconst processed = [];\nfor (const item of rows) {\n  const listingId = item['Listing ID'];\n  const property = item['Property'];\n\n  // unidentifiable rows can't be written back to safely later - drop silently\n  if (!listingId || !property) continue;\n\n  const listedDate = item['Listed Date'] ? new Date(item['Listed Date']) : null;\n  const daysOnMarket = item['Days on Market'] !== undefined && item['Days on Market'] !== ''\n    ? Number(item['Days on Market'])\n    : (listedDate && !isNaN(listedDate) ? Math.floor((today - listedDate) / 86400000) : null);\n\n  const enquiriesRaw = item['Enquiries'];\n  const viewingsRaw = item['Viewings'];\n  const offersRaw = item['Offers'];\n\n  const dataQualityIssue = (\n    daysOnMarket === null ||\n    enquiriesRaw === undefined || enquiriesRaw === '' || isNaN(Number(enquiriesRaw)) ||\n    viewingsRaw === undefined || viewingsRaw === '' || isNaN(Number(viewingsRaw)) ||\n    offersRaw === undefined || offersRaw === '' || isNaN(Number(offersRaw))\n  );\n\n  const enquiries = Number(enquiriesRaw) || 0;\n  const viewings = Number(viewingsRaw) || 0;\n  const offers = Number(offersRaw) || 0;\n\n  const enquiryToViewingRate = enquiries > 0 ? viewings / enquiries : 0;\n  const viewingToOfferRate = viewings > 0 ? offers / viewings : 0;\n\n  const status = (item['Status'] || 'Active').toString().toLowerCase();\n  const notActive = status !== 'active';\n  const tooNew = daysOnMarket !== null && daysOnMarket < 14;\n\n  // --- velocity / cooling-off: needs a prior snapshot to mean anything ---\n  const prevSnapshotDate = item['Prev Snapshot Date'] ? new Date(item['Prev Snapshot Date']) : null;\n  let coolingOff = false;\n  const overallEnquiryRate = daysOnMarket ? enquiries / daysOnMarket : 0;\n\n  if (prevSnapshotDate && !isNaN(prevSnapshotDate)) {\n    const daysSinceSnapshot = Math.max(1, Math.floor((today - prevSnapshotDate) / 86400000));\n    const prevEnquiries = Number(item['Prev Enquiries']) || 0;\n    const enquiryDelta = Math.max(0, enquiries - prevEnquiries);\n    const recentEnquiryRate = enquiryDelta / daysSinceSnapshot;\n    if (daysOnMarket >= 14 && overallEnquiryRate > 0 && recentEnquiryRate < overallEnquiryRate * 0.4) {\n      coolingOff = true;\n    }\n  }\n\n  // --- remediation grace period after a price change ---\n  const lastPriceChangeRaw = item['Last Price Change Date'];\n  let recentPriceChange = false;\n  if (lastPriceChangeRaw) {\n    const d = new Date(lastPriceChangeRaw);\n    if (!isNaN(d)) recentPriceChange = Math.floor((today - d) / 86400000) < 10;\n  }\n\n  processed.push({\n    ...item,\n    listingId, daysOnMarket, enquiries, viewings, offers,\n    enquiryToViewingRate: Number(enquiryToViewingRate.toFixed(2)),\n    viewingToOfferRate: Number(viewingToOfferRate.toFixed(2)),\n    dataQualityIssue, notActive, tooNew, coolingOff, recentPriceChange, status\n  });\n}\n\n// ---------- PASS 2: portfolio benchmark (peer-relative) ----------\nconst comparables = processed.filter(p => !p.notActive && !p.dataQualityIssue && p.enquiries >= 3);\n\nfunction median(nums) {\n  if (!nums.length) return null;\n  const s = [...nums].sort((a, b) => a - b);\n  const mid = Math.floor(s.length / 2);\n  return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2;\n}\n\nconst usePeerBenchmark = comparables.length >= 5;\nconst medianEnquiryToViewing = usePeerBenchmark ? median(comparables.map(p => p.enquiryToViewingRate)) : null;\nconst medianViewingToOffer = usePeerBenchmark ? median(comparables.map(p => p.viewingToOfferRate)) : null;\n\n// ---------- PASS 3: needsReview decision + cooldown/escalation ----------\nconst output = [];\nfor (const p of processed) {\n  let needsReview = false;\n  let issueType = 'none';\n\n  if (!p.tooNew && !p.notActive && !p.dataQualityIssue) {\n    if (p.enquiries === 0 && p.daysOnMarket >= 21) {\n      needsReview = true; issueType = 'no_interest';\n    } else if (p.viewings === 0 && p.enquiries >= 5) {\n      needsReview = true; issueType = 'enquiry_no_viewing';\n    } else if (p.viewings >= 5 && p.offers === 0) {\n      needsReview = true; issueType = 'viewing_no_offer';\n    } else if (usePeerBenchmark && p.enquiries >= 3 && p.enquiryToViewingRate < medianEnquiryToViewing * 0.5) {\n      needsReview = true; issueType = 'below_peer_enquiry_conversion';\n    } else if (usePeerBenchmark && p.viewings >= 3 && p.viewingToOfferRate < medianViewingToOffer * 0.5) {\n      needsReview = true; issueType = 'below_peer_viewing_conversion';\n    } else if (p.coolingOff) {\n      needsReview = true; issueType = 'interest_cooling_off';\n    }\n  }\n\n  const lastAlertRaw = p['Last Alert Date'];\n  let daysSinceLastAlert = null;\n  if (lastAlertRaw) {\n    const d = new Date(lastAlertRaw);\n    if (!isNaN(d)) daysSinceLastAlert = Math.floor((today - d) / 86400000);\n  }\n  const onCooldown = daysSinceLastAlert !== null && daysSinceLastAlert < 7;\n  const eligibleForAlert = !onCooldown && !p.recentPriceChange;\n\n  const alertCount = Number(p['Alert Count']) || 0;\n  const escalationLevel = alertCount === 0 ? 'first' : alertCount <= 2 ? 'repeat' : 'urgent';\n\n  output.push({\n    json: {\n      ...p, needsReview, issueType, usePeerBenchmark,\n      medianEnquiryToViewing, medianViewingToOffer,\n      daysSinceLastAlert, eligibleForAlert, alertCount, escalationLevel,\n      checkedAt: today.toISOString()\n    }\n  });\n}\n\nreturn output;"
      },
      "typeVersion": 2
    },
