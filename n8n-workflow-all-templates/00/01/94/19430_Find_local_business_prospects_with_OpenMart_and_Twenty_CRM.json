    {
      "id": "dfa77497-cd06-414f-ab63-45201afa8478",
      "name": "Aggregate OpenMart Results",
      "type": "n8n-nodes-base.aggregate",
      "position": [
        6192,
        1904
      ],
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData",
