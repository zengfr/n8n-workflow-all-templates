    {
      "id": "6994e609-e65d-416b-b89b-eef6b086355e",
      "name": "Normalize Business Data",
      "type": "n8n-nodes-base.code",
      "position": [
        6400,
        1904
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json.rawBusinesses || [];\nconst settings = $('Set Search Parameters').first().json;\nconst candidates = [];\nlet skippedWithoutDomain = 0;\n\nfor (const row of raw) {\n  if (!row || (!row.id && !row.content && !row.business_name)) continue;\n  const source = row.content || row;\n  const name = String(source.business_name || source.name || '').trim();\n  const websiteValue = String(source.website_url || source.website || source.root_domain || '').trim();\n  const domain = websiteValue.toLowerCase()\n    .replace(/^https?:\\/\\//, '')\n    .split('/')[0]\n    .replace(/^www\\./, '')\n    .split(':')[0];\n  if (!name || !/^[a-z0-9.-]+\\.[a-z]{2,}$/.test(domain)) {\n    skippedWithoutDomain += 1;\n    continue;\n  }\n  candidates.push({\n    providerId: String(row.id || source.id || ''),\n    name,\n    domain,\n    website: /^https?:\\/\\//i.test(websiteValue) ? websiteValue : 'https://' + domain,\n    matchScore: row.match_score ?? source.match_score ?? null,\n    matchHighlights: Array.isArray(row.match_highlights) ? row.match_highlights : [],\n    phones: Array.isArray(source.store_phones) ? source.store_phones : [],\n    query: settings.query,\n    city: settings.city,\n    state: settings.state,\n    country: settings.country,\n  });\n}\n\nreturn [{ json: {\n  candidates,\n  receivedCount: raw.filter(r => r && (r.id || r.content || r.business_name)).length,\n  skippedWithoutDomain,\n} }];"
      },
      "typeVersion": 2
    },
