        7904,
        1744
      ],
      "parameters": {
        "color": 7,
        "width": 448,
        "height": 320,
        "content": "## Load existing companies\n\nFetches existing company records from Twenty CRM and aggregates them so candidate domains can be compared against current CRM data."
      },
      "typeVersion": 1
    },
    {
      "id": "c68d8b0e-1bee-456b-8099-dae0b8f9fe37",
      "name": "Sticky Note6",
