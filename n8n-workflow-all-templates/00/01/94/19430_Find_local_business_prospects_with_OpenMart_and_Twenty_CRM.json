      ],
      "parameters": {
        "color": 7,
        "width": 400,
        "height": 512,
        "content": "## Check candidate availability\n\nCollects the deduplicated candidates, checks whether any usable businesses remain, and reports a no-results status when none are available for import."
      },
      "typeVersion": 1
    },
    {
