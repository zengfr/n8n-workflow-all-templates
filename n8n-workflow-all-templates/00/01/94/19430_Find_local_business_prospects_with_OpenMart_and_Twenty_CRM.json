      "id": "e727fe5e-21f5-44e5-9064-d6835021b751",
      "name": "Create Review Task in Twenty",
      "type": "@blackswampai/n8n-nodes-twentycrm.twenty",
      "position": [
        10368,
        2128
      ],
      "parameters": {
        "resource": "task",
        "inputMode": "json",
        "jsonInput": "={{ ({\n  title: 'Review OpenMart prospect: ' + $('Set Existing Company ID').item.json.name,\n  bodyV2: { markdown:\n    'Imported from an OpenMart local business search.\\n\\n' +\n    'Website: ' + $('Set Existing Company ID').item.json.website + '\\n' +\n    'Search: ' + $('Set Existing Company ID').item.json.query + ' in ' +\n      $('Set Existing Company ID').item.json.city + ', ' +\n      $('Set Existing Company ID').item.json.state + '\\n' +\n    'OpenMart provider ID: ' + ($('Set Existing Company ID').item.json.providerId || 'not returned') + '\\n' +\n    'Match score: ' + ($('Set Existing Company ID').item.json.matchScore ?? 'not returned') + '\\n\\n' +\n    'Verify fit and contact details before outreach.'\n  },\n  dueAt: $now.plus({ days: $('Set Search Parameters').first().json.reviewTaskDueInDays }).toISO()\n}) }}",
        "operation": "create"
      },
      "credentials": {
        "twentyApi": {
          "id": "YfGkgdKvAxAVOH0p",
          "name": "Twenty account"
        }
      },
      "typeVersion": 1
    },
