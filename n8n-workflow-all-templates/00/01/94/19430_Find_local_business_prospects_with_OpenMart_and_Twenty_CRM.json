        10064,
        1968
      ],
      "parameters": {
        "color": 7,
        "width": 720,
        "height": 320,
        "content": "## Create new prospects\n\nCreates a new company in Twenty for unmatched candidates, adds a prospect review task, records the created company and task identifiers, and sends the result back to the batch loop."
      },
      "typeVersion": 1
    },
    {
      "id": "5c365185-889a-4d82-a14d-d051283e10d1",
