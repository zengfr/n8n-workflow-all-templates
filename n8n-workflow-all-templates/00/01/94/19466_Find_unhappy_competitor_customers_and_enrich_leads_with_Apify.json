    {
      "id": "727ce977-5ee3-4f2c-865e-403a0ca818f2",
      "name": "Process Items in JavaScript",
      "type": "n8n-nodes-base.code",
      "position": [
        2336,
        96
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const d = item.json;\n  \n  // Gürültüyü at\n  if (!d.personId) continue;\n  if (!d.email) continue;\n  \n  result.push({\n    json: {\n      person_id: d.personId,\n      first_name: d.firstName,\n      last_name: d.lastName,\n      full_name: d.fullName,\n      email: d.email,\n      position: d.position,\n      seniority: d.seniority,\n      linkedin_url: d.linkedinUrl,\n      city: d.city,\n      country: d.country,\n      organization_name: d.organizationName,\n      organization_domain: d.organizationWebsite,\n      organization_industry: d.organizationIndustry,\n      organization_size: d.organizationSize\n    }\n  });\n}\n\nreturn result;"
      },
      "typeVersion": 2
    }
