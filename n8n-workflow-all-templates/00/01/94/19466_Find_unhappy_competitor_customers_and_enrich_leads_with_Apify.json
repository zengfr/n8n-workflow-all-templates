    {
      "id": "3a4d88a4-e021-4769-ad8a-16c656ab933c",
      "name": "Process Results in JavaScript",
      "type": "n8n-nodes-base.code",
      "position": [
        1696,
        96
      ],
      "parameters": {
        "jsCode": "const countryMap = {\n  \"GB\": \"United Kingdom\",\n  \"US\": \"United States\",\n  \"CA\": \"Canada\",\n  \"AU\": \"Australia\",\n  \"DE\": \"Germany\",\n  \"FR\": \"France\",\n  \"PT\": \"Portugal\",\n  \"NL\": \"Netherlands\",\n  \"TR\": \"Turkey\"\n};\n\nconst items = $input.all();\nconst result = [];\n\nfor (const i of items) {\n  const name = (i.json.authorName || '').trim();\n  const parts = name.split(' ');\n  if (i.json.rating > 2 || parts.length < 2) continue;\n  \n  const country = countryMap[i.json.country] || i.json.country;\n  \n  result.push({\n    json: {\n      firstName: parts[0],\n      lastName: parts.slice(1).join(' '),\n      personCountry: [country],\n      includeEmails: true,\n      totalResults: 100,\n      contactEmailStatus: \"verified\"\n    }\n  });\n}\n\nreturn result;"
      },
      "typeVersion": 2
    },
