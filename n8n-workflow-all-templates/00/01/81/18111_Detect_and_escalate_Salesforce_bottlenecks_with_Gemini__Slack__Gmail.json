    {
      "id": "d33de2e8-9f81-4550-a70e-fa481fc70528",
      "name": "Detect Bottlenecks and SLA Breaches",
      "type": "n8n-nodes-base.code",
      "position": [
        1024,
        976
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst results = items.map((item) => {\n  const task = item.json;\n\n  const dueDate = task.ActivityDate ? new Date(task.ActivityDate) : null;\n  if (dueDate) dueDate.setHours(0, 0, 0, 0);\n\n  const isCompleted = ['Completed', 'Closed'].includes(task.Status);\n  const isOverdue = dueDate && dueDate < today && !isCompleted;\n  const isHighPriority = task.Priority === 'High';\n\n  const subject = (task.Subject || '').toLowerCase();\n\n  const dependencyType =\n    subject.includes('legal') ? 'Legal Review' :\n    subject.includes('proposal') ? 'Proposal Approval' :\n    subject.includes('technical') ? 'Technical Input' :\n    subject.includes('finance') ? 'Finance Approval' :\n    'Internal Dependency';\n\n  const bottleneckFound = isOverdue || (isHighPriority && !isCompleted);\n\n  let severity = 'Low';\n  if (isOverdue && isHighPriority) {\n    severity = 'High';\n  } else if (isOverdue || isHighPriority) {\n    severity = 'Medium';\n  }\n\n  return {\n    json: {\n      opportunity_id: task.WhatId,\n      task_id: task.Id,\n      opportunity_name: task.Name,\n      stage: task.StageName,\n      close_date: task.CloseDate,\n      amount: task.Amount,\n      probability: task.Probability,\n      task_subject: task.Subject,\n      task_status: task.Status,\n      task_priority: task.Priority,\n      due_date: task.ActivityDate,\n      task_description: task.Description,\n      dependency_type: dependencyType,\n      is_overdue: isOverdue,\n      is_high_priority: isHighPriority,\n      bottleneck_found: bottleneckFound,\n      severity,\n      blocker_reason: bottleneckFound\n        ? `${dependencyType} is ${isOverdue ? 'overdue' : 'high priority and still open'}.`\n        : 'No active bottleneck detected for this task.'\n    }\n  };\n});\n\nreturn results;"
      },
      "typeVersion": 2
    },
