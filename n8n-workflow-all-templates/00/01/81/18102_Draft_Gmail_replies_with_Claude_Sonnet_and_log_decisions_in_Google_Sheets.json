    {
      "id": "1adcd93d-f69a-46e0-a886-ef6e56fbf88d",
      "name": "Normalize Email Content",
      "type": "n8n-nodes-base.code",
      "position": [
        224,
        112
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst fromValue = raw.from?.value?.[0] || {};\nconst from_address = String(fromValue.address || raw.From || raw.from || '').replace(/^.*</, '').replace(/>.*$/, '').trim();\nconst from_name = String(fromValue.name || '').trim() || from_address;\nconst subject = String(raw.subject || raw.Subject || '');\nconst body = String(raw.text || raw.textPlain || raw.snippet || '');\nreturn [{ json: {\n  received_at: $now.toISO(),\n  message_id: String(raw.id || ''),\n  thread_id: String(raw.threadId || ''),\n  from_address,\n  from_name,\n  subject,\n  body: body.slice(0, 8000)\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "ce391505-c440-4c4d-9391-947ed5fd47a9",
      "name": "Fetch Full Thread History",
      "type": "n8n-nodes-base.gmail",
      "onError": "continueRegularOutput",
      "position": [
        448,
        112
      ],
      "webhookId": "54faa80d-6161-4667-982f-5d57f688b655",
      "parameters": {
        "simple": false,
        "options": {
          "returnOnlyMessages": true
        },
        "resource": "thread",
        "threadId": "={{ $json.thread_id }}",
        "operation": "get"
      },
      "typeVersion": 2.2
    },
    {
      "id": "5185c393-9e0c-49a3-9360-a36ca67291c4",
      "name": "Build Conversation Transcript",
      "type": "n8n-nodes-base.code",
      "position": [
        672,
        112
      ],
      "parameters": {
        "jsCode": "const base = $('Normalize Email Content').first().json;\n\nconst decode = (data) => {\n  try { return Buffer.from(String(data || '').replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8'); } catch (e) { return ''; }\n};\n\nconst findPlainText = (payload) => {\n  if (!payload) return '';\n  if (payload.mimeType === 'text/plain' && payload.body && payload.body.data) { return decode(payload.body.data); }\n  const parts = Array.isArray(payload.parts) ? payload.parts : [];\n  for (const p of parts) {\n    const found = findPlainText(p);\n    if (found) return found;\n  }\n  return '';\n};\n\nlet msgs = [];\nconst first = $input.first().json || {};\nif (Array.isArray(first.messages)) {\n  msgs = first.messages;\n} else {\n  msgs = $input.all().map(i => i.json).filter(m => m && m.id);\n}\nmsgs.sort((a, b) => Number(a.internalDate || 0) - Number(b.internalDate || 0));\n\nconst lines = [];\nfor (const m of msgs) {\n  if (String(m.id) === String(base.message_id)) continue;\n  const from = String(m.From || m.from || 'unknown sender');\n  const date = String(m.Date || m.date || '');\n  let body = String(m.text || m.textPlain || '') || findPlainText(m.payload) || String(m.snippet || '');\n  body = body.split('\\n').filter(l => !l.trim().startsWith('>') && !/^On .+ wrote:\\s*$/.test(l.trim())).join('\\n');\n  body = body.replace(/\\s+/g, ' ').trim();\n  if (!body) continue;\n  if (body.length > 700) { body = body.slice(0, 700) + ' [trimmed]'; }\n  lines.push('From: ' + from + (date ? ' on ' + date : '') + '\\n' + body);\n}\n\nlet thread_history = lines.join('\\n---\\n');\nif (thread_history.length > 6000) { thread_history = '[earlier messages trimmed]\\n' + thread_history.slice(-6000); }\nif (!lines.length) { thread_history = 'This is the first message in the thread, there is no earlier history.'; }\nreturn [{ json: { ...base, thread_history } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "b3ee4adf-5909-4e10-82a8-216d3f363a26",
