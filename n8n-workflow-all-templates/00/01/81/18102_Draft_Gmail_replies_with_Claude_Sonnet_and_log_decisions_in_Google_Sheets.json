    {
      "id": "67691f85-e26a-499c-be41-bfaba56e38d3",
      "name": "Match Approved to Pending",
      "type": "n8n-nodes-base.code",
      "position": [
        880,
        640
      ],
      "parameters": {
        "jsCode": "const approved = $('Extract Approved Thread IDs').all().map(i => String(i.json.thread_id));\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (String(r.status || '').toLowerCase() === 'pending' && approved.includes(String(r.thread_id || ''))) {\n    out.push({ json: r });\n  }\n}\nreturn out;"
      },
      "typeVersion": 2
    },
