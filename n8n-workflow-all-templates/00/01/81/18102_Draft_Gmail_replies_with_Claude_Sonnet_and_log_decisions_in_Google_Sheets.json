    {
      "id": "1e50b73b-fbb4-455a-b3cf-848e7886f56a",
      "name": "Parse and Validate Response",
      "type": "n8n-nodes-base.code",
      "position": [
        1328,
        112
      ],
      "parameters": {
        "jsCode": "const base = $('Build Conversation Transcript').first().json;\nlet ai = {};\ntry { ai = JSON.parse($input.first().json.text.replace(/```json|```/g, '').trim()); } catch (e) { ai = { needs_reply: false, category: 'other', urgency: 'low', escalate: true, reply_subject: '', reply_body: '', reason: 'AI response could not be parsed, review this email manually' }; }\nif (typeof ai.escalate === 'undefined') { ai.escalate = false; }\nif (!ai.reply_subject && base.subject) { ai.reply_subject = 'Re: ' + base.subject; }\nconst strip = s => String(s || '').replace(/\\u2014|\\u2013/g, ', ').replace(/;/g, ',');\nai.reply_subject = strip(ai.reply_subject);\nai.reply_body = strip(ai.reply_body);\nai.reason = strip(ai.reason);\nreturn [{ json: { ...base, ...ai } }];"
      },
      "typeVersion": 2
    },
