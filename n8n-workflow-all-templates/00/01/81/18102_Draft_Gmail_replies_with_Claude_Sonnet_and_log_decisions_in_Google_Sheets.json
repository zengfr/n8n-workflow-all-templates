      "name": "Prepare Label Removal",
      "type": "n8n-nodes-base.code",
      "position": [
        1996,
        640
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const labels = $input.all().map(i => i.json);\nconst target = labels.find(l => String(l.name || '').toLowerCase() === 'send-approved');\nconst seen = new Set();\nconst out = [];\nfor (const item of $('Match Approved to Pending').all()) {\n  const tid = String(item.json.thread_id || '');\n  if (target && tid && !seen.has(tid)) {\n    seen.add(tid);\n    out.push({ json: { thread_id: tid, label_id: String(target.id) } });\n  }\n}\nreturn out;",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
