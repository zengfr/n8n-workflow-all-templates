    {
      "id": "f36daa83-aa5a-4cfd-89e2-8a668cb1073e",
      "name": "Extract Approved Thread IDs",
      "type": "n8n-nodes-base.code",
      "position": [
        448,
        640
      ],
      "parameters": {
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const tid = String(item.json.threadId || '');\n  if (tid && !seen.has(tid)) { seen.add(tid); out.push({ json: { thread_id: tid } }); }\n}\nreturn out;"
      },
      "typeVersion": 2
    },
