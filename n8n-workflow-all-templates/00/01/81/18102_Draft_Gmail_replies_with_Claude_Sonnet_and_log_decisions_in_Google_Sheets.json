  "nodes": [
    {
      "id": "2372f71f-f659-4371-9ebc-e82f67108a5c",
      "name": "When Email is Received",
      "type": "n8n-nodes-base.gmailTrigger",
      "position": [
        0,
        112
      ],
      "parameters": {
        "simple": false,
        "filters": {
