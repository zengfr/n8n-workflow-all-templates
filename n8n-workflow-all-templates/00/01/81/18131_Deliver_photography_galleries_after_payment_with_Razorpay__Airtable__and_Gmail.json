            "package": "={{ $json.package }}",
            "delivered": false,
            "client_name": "={{ $json.client_name }}",
            "client_email": "={{ $json.client_email }}",
            "gallery_link": "",
            "total_amount": "={{ $json.total_amount }}",
            "order_reference": "={{ $json.order_reference }}",
            "selected_proof_ids": "={{ $json.selected_proof_ids }}"
