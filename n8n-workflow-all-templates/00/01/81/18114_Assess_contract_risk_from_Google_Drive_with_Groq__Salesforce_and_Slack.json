    {
      "id": "268f7e93-9884-4e1f-b1b0-c349207b0e8a",
      "name": "Generate Final Risk Report",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        3696,
        800
      ],
      "parameters": {
        "text": "=Generate a final contract risk report.\n\nReturn JSON in this format:\n\n{\n  \"overall_risk\": \"low | medium | high\",\n  \"summary\": \"short summary\",\n  \"top_risks\": [\n    \"risk 1\",\n    \"risk 2\"\n  ],\n  \"recommendations\": [\n    \"recommendation 1\",\n    \"recommendation 2\"\n  ]\n}\n\nANALYSIS DATA:\n{{ JSON.stringify($json[\"analysis\"], null, 2) }}\n",
        "options": {
          "systemMessage": "You are a senior legal analyst.\n\nYour job is to generate a final contract risk report based on clause-level risk analysis.\n\nBe concise but professional.\nReturn structured JSON only."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "69553aa9-710c-4a66-8471-798c9a8ae5f5",
      "name": "Parse Final Report",
      "type": "n8n-nodes-base.code",
      "position": [
        4016,
        896
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let raw =$json.output\n\n// Remove markdown if present\nraw = raw.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  throw new Error(\"Invalid JSON from OpenAI (Final Report): \" + raw);\n}\n\nreturn {\n  json: parsed\n};"
      },
      "typeVersion": 2
    },
