    {
      "id": "a8a42674-9480-4f6a-a93f-14633eae067a",
      "name": "Analyze Clause Risks",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        3056,
        544
      ],
      "parameters": {
        "text": "=Analyze the following contract clauses and identify risks.\n\nReturn JSON in this format:\n\n{\n  \"analysis\": [\n    {\n      \"type\": \"clause type\",\n      \"risk_level\": \"low | medium | high\",\n      \"issue\": \"what is wrong\",\n      \"recommendation\": \"how to fix it\"\n    }\n  ]\n}\n\nCLAUSES:\nCLAUSES:\n{{ JSON.stringify($json[\"clauses\"], null, 2) }}",
        "options": {
          "systemMessage": "=You are a legal risk analyst.\n\nYour job is to evaluate contract clauses and identify risks based on best practices.\n\nYou must:\n- Assign a risk level (low, medium, high)\n- Explain the issue clearly\n- Suggest a better alternative\n\nReturn ONLY valid JSON."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "4007bfdc-a546-4106-a822-b26f91e8796d",
      "name": "Parse Risk Analysis Output",
      "type": "n8n-nodes-base.code",
      "position": [
        3376,
        608
      ],
      "parameters": {
        "jsCode": "let raw = $json.message?.content || $json.output || \"\";\n\n// Remove markdown formatting if present\nraw = raw.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  throw new Error(\"Invalid JSON from OpenAI (Risk Analysis): \" + raw);\n}\n\nreturn {\n  json: parsed\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "8073ef37-0f98-4408-94c3-e3fb685c6126",
