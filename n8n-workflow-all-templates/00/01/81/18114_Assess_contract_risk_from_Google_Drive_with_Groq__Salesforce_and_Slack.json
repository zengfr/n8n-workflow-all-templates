    {
      "id": "7ca6edaf-73aa-48c0-9bd6-58708035e030",
      "name": "Split Contract into Chunks",
      "type": "n8n-nodes-base.code",
      "position": [
        2096,
        672
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet output = [];\n\nfor (const item of items) {\n  const text = item.json.contract_text || \"\";\n  const chunkSize = 3000;\n\n  for (let i = 0; i < text.length; i += chunkSize) {\n    output.push({\n      json: {\n        chunk: text.slice(i, i + chunkSize)\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "typeVersion": 2
    },
    {
      "id": "2582bb96-af8b-411b-990c-e9d04d017e51",
      "name": "Extract Contract Clauses",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2464,
        576
      ],
      "parameters": {
        "text": "=Analyze the following contract text and extract clauses.\n\nReturn ONLY JSON in this format:\n\n{\n  \"clauses\": [\n    {\n      \"type\": \"clause type\",\n      \"text\": \"original clause text\",\n      \"summary\": \"short explanation\"\n    }\n  ]\n}\n\nCONTRACT TEXT:\n{{$json[\"chunk\"]}}",
        "options": {
          "systemMessage": "You are a legal contract analysis expert.\n\nYour task is to extract clauses from a contract and classify them into categories such as:\n- Payment\n- Termination\n- Liability\n- Indemnity\n- Governing Law\n- Renewal\n- Dispute Resolution\n\nAlways return clean structured JSON only."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "executeOnce": false,
      "typeVersion": 3.1,
      "alwaysOutputData": false
    },
    {
      "id": "7c1d9cdb-b628-4fe0-bafd-1ae0f593100c",
      "name": "LLM: Clause Extraction Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "position": [
        2368,
        720
      ],
      "parameters": {
        "model": "openai/gpt-oss-safeguard-20b",
        "options": {}
      },
      "typeVersion": 1
    },
    {
      "id": "1674f10a-52a4-4998-bf4c-7c7f9374b971",
      "name": "Parse Clause Output",
      "type": "n8n-nodes-base.code",
      "position": [
        2752,
        576
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let raw = $json.message?.content || $json.output || \"\";\n\n// Remove markdown if present\nraw = raw.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  throw new Error(\"Invalid JSON from OpenAI: \" + raw);\n}\n\nreturn {\n  json: parsed\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "4625c2f6-5987-4180-bdbf-036273a69d17",
      "name": "LLM: Risk Analysis Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "position": [
