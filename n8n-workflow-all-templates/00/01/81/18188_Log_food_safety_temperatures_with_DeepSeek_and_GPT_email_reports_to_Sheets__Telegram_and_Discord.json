    {
      "id": "b83b27c7-80d7-4f9f-83f9-9cbe551c6b09",
      "name": "Stats This Week",
      "type": "n8n-nodes-base.code",
      "position": [
        3408,
        3568
      ],
      "parameters": {
        "jsCode": "// Summarize the temperature log for the weekly owner report.\nconst rows = $input.all().map((i) => i.json);\nconst cutoff = new Date(Date.now() - 7 * 24 * 3600 * 1000);\nlet total = 0, atRisk = 0, byZone = {};\nlet lastReading = null;\nfor (const r of rows) {\n  const d = new Date(String(r.received_at || ''));\n  if (isNaN(d.getTime())) continue;\n  if (d < cutoff) continue;\n  total++;\n  const st = String(r.status || '');\n  if (st.includes('at_risk') || st.includes('critical')) {\n    atRisk++;\n    const z = String(r.zone || 'unknown');\n    byZone[z] = (byZone[z] || 0) + 1;\n  }\n  if (!lastReading || d > lastReading) lastReading = d;\n}\nconst zoneText = Object.keys(byZone).length ? Object.entries(byZone).map(([z, c]) => z + ': ' + c).join(', ') : 'none';\nconst lastText = lastReading ? lastReading.toISOString().slice(0, 10) : 'no readings logged this week';\nreturn [{ json: { total_readings: total, at_risk_readings: atRisk, zones_text: zoneText, last_reading: lastText, window_end: new Date().toISOString().slice(0, 10) } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "6469f3c6-8a44-4447-a81a-945a4490ccc6",
      "name": "Write Weekly Report",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        3632,
        3568
      ],
      "parameters": {
        "text": "={{ 'Total readings logged this week: ' + $json.total_readings + '. Out of range readings: ' + $json.at_risk_readings + '. Out of range by zone: ' + $json.zones_text + '. Last reading: ' + $json.last_reading + '. Week ending ' + $json.window_end }}",
        "options": {
          "systemMessage": "You are a food safety reporting assistant for a small restaurant owner. Write a short plain-text weekly temperature log summary email. Max 120 words, friendly and concrete, no hype. State the totals, highlight the out of range count, and give one practical next step if anything was out of range. If everything was safe, say so plainly. No em dashes, no markdown, no bullet point soup, no code fences. Return the email body text only."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
