    {
      "id": "6e475b6f-6e8c-44f5-aa8d-a256ae604a84",
      "name": "Parse Safety Assessment",
      "type": "n8n-nodes-base.code",
      "position": [
        4144,
        2304
      ],
      "parameters": {
        "jsCode": "// Parse the AI safety verdict; fall back to deterministic zone checks.\nconst it = $input.first().json;\nlet raw = String(it.output != null ? it.output : '').trim();\nraw = raw.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\nlet p = {};\nconst m = raw.match(/\\{[\\s\\S]*\\}/);\nif (m) { try { p = JSON.parse(m[0]); } catch (e) { try { p = JSON.parse(m[0].replace(/'/g, '\"')); } catch (e2) {} } }\nlet ctx = it;\ntry { ctx = $('Normalize Reading').first().json; } catch (e) {}\nconst clean = (s) => String(s || '').replace(/[\\u2014\\u2013]/g, '-');\nconst status = ['safe','at_risk','critical'].includes(p.status) ? p.status : 'safe';\nconst zoneLabel = ({walk_in:'Walk-in cooler', walkin:'Walk-in cooler', reach_in:'Reach-in cooler', reachin:'Reach-in cooler', freezer:'Freezer', hot_hold:'Hot hold cabinet', hothold:'Hot hold cabinet', prep:'Prep table'})[ctx.zone] || ctx.zone;\nlet tempF = Number(ctx.temp_f);\nif (isNaN(tempF)) tempF = Number(ctx.temp);\nlet issue = clean(p.issue || '');\nlet action = clean(p.corrective_action || '');\nif (status !== 'safe') {\n  if (!issue) {\n    if (ctx.zone === 'freezer') { issue = 'Freezer above safe 0F'; }\n    else if (ctx.zone === 'hot_hold' || ctx.zone === 'hothold') { issue = 'Hot hold below safe 135F'; }\n    else { issue = 'Cooler temperature outside safe 40F range'; }\n  }\n  if (!action) {\n    if (ctx.zone === 'freezer') { action = 'Check the door seal and defrost cycle, log a recheck in one hour.'; }\n    else if (ctx.zone === 'hot_hold' || ctx.zone === 'hothold') { action = 'Raise the holding temperature and recheck in 30 minutes.'; }\n    else { action = 'Check the door seal and fan, verify with a second thermometer, recheck in one hour.'; }\n  }\n}\nreturn [{ json: {\n  reading_id: ctx.reading_id, zone: ctx.zone, zone_label: zoneLabel, temp: ctx.temp,\n  unit: ctx.unit, temp_f: tempF, temp_display: (ctx.unit === 'C' ? (Number(ctx.temp) + 'C') : (Number(ctx.temp) + 'F')),\n  staff: ctx.staff, notes: ctx.notes, received_at: ctx.received_at,\n  status: status, issue: issue, corrective_action: action, alert_sent: (status !== 'safe')\n} }];"
      },
      "typeVersion": 2
    },
