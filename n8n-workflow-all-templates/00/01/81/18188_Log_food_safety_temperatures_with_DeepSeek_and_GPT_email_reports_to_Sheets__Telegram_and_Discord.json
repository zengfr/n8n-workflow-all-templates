    {
      "id": "eb516ea7-c4f1-4d9d-b382-67c3e2bf8248",
      "name": "Assess Temperature Safety",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        3792,
        2304
      ],
      "parameters": {
        "text": "={{ 'Zone: ' + $json.zone_label + '. Temp: ' + $json.temp_display + ' (' + $json.temp_f + 'F). Staff: ' + $json.staff + '. Notes: ' + ($json.notes || 'none') }}",
        "options": {
          "systemMessage": "You are a food safety checklist assistant for a restaurant kitchen. Judge the reading against FDA temperature rules: walk-in and reach-in coolers are safe at or below 40F (4C), freezers at or below 0F (-18C), hot hold at or above 135F (57C), prep tables at or below 41F (5C). Return ONLY valid JSON with these keys: status (one of: safe, at_risk, critical), issue (a short phrase describing what is wrong, or an empty string when safe), corrective_action (a concrete next step for the shift lead, or an empty string when safe). critical means the temperature is far outside the safe range and food may already be compromised (cooler above 45F, freezer above 10F, hot hold below 130F). at_risk means it is borderline and needs a recheck within the hour. No em dashes, no markdown, no code fences."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
