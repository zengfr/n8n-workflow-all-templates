      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = Date.now();\nconst weekAgo = now - 7 * 24 * 60 * 60 * 1000;\nreturn items.filter((it) => {\n  const ts = new Date(it.json.received_at || it.json.created_at || 0).getTime();\n  return !isNaN(ts) && ts >= weekAgo;\n});"
