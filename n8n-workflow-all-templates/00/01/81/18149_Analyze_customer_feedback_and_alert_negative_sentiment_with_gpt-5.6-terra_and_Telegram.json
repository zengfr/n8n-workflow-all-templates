    {
      "id": "w1-agent",
      "name": "Analyze Feedback with AI",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        896,
        -144
      ],
      "parameters": {
        "text": "={{ 'Analyze this customer feedback: \"' + $json.message + '\" from ' + $json.customer_name + ' (rating ' + $json.rating + ', source ' + $json.source + ', product ' + ($json.product || 'n/a') + '). Return ONLY valid JSON with keys: sentiment (positive|neutral|negative), category (one of: product, service, delivery, pricing, other), score (0-100, negative score high means more negative), urgency (low|medium|high), suggested_action (string, max 20 words). No markdown, no code fences.' }}",
        "options": {
          "systemMessage": "You are a customer feedback analyst for a small business. Classify feedback accurately and concisely. Always return valid JSON only."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
