      "name": "Filter Current Month",
      "type": "n8n-nodes-base.code",
      "position": [
        480,
        448
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst firstOfMonth = new Date(now.getFullYear(), now.getMonth(), 1).getTime();\nreturn items.filter((it) => {\n  const ts = new Date(it.json.received_at || 0).getTime();\n  return !isNaN(ts) && ts >= firstOfMonth;\n});"
      },
