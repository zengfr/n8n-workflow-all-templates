              "value": "={{ (($json['SSN'] || '').toString().replace(/[^0-9]/g,'').length >= 9) ? 'full' : ((($json['SSN'] || '').toString().replace(/[^0-9]/g,'').length === 4) ? 'last4' : 'partial') }}"
            },
            {
              "id": "p6",
              "name": "ssn_masked",
              "type": "string",
              "value": "={{ (($json['SSN'] || '').toString().replace(/[^0-9]/g,'').length >= 9) ? ('***-**-' + ($json['SSN'] || '').toString().replace(/[^0-9]/g,'').slice(-4)) : ((($json['SSN'] || '').toString().replace(/[^0-9]/g,'').length > 0) ? ('****' + ($json['SSN'] || '').toString().replace(/[^0-9]/g,'').slice(-4)) : '') }}"
