    {
      "id": "ae317699-f2ac-47ff-ad1b-ad1d3ada2be1",
      "name": "Extract Card Data with Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "notes": "Vision OCR, returns JSON only",
      "maxTries": 3,
      "position": [
        -1008,
        400
      ],
      "parameters": {
        "text": "This image is a business card. Read it and return ONLY a JSON object with the keys below. Do not add any explanation or code fences.\n\n{\n  \"company\": \"company name\",\n  \"department\": \"department\",\n  \"title\": \"job title\",\n  \"name\": \"full name\",\n  \"name_kana\": \"phonetic reading of the name if printed on the card\",\n  \"email\": \"email address\",\n  \"tel\": \"landline number\",\n  \"mobile\": \"mobile number\",\n  \"address\": \"postal address\",\n  \"website\": \"URL\"\n}\n\nRules:\n- Use an empty string \"\" for anything that is not printed on the card. Never guess.\n- Keep the original language and script of the card.\n- Transcribe the email address character by character. Do not correct or normalise it.",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "options": {
          "maxOutputTokens": 2048
        },
        "resource": "image",
        "inputType": "binary",
        "operation": "analyze"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "credential-id",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "notesInFlow": true,
      "retryOnFail": true,
      "typeVersion": 1.2,
      "waitBetweenTries": 2000
    },
    {
      "id": "647f2263-83ed-4a28-9518-37b69d5d852d",
      "name": "Parse OCR Result",
      "type": "n8n-nodes-base.code",
      "notes": "Repairs the model output and rescues the e-mail address",
      "position": [
        -768,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function pickText(j) {\n  if (j?.content?.parts?.length) {\n    return j.content.parts.map(p => p?.text ?? \"\").join(\"\");\n  }\n  if (j?.candidates?.[0]?.content?.parts?.length) {\n    return j.candidates[0].content.parts.map(p => p?.text ?? \"\").join(\"\");\n  }\n  if (typeof j?.content === \"string\") return j.content;\n  if (typeof j?.text === \"string\") return j.text;\n  if (typeof j?.response === \"string\") return j.response;\n  return \"\";\n}\n\nlet raw = String(pickText($json)).trim();\n\nraw = raw.replace(/[\\u0060]{3}json/gi, \"\").replace(/[\\u0060]{3}/g, \"\").trim();\n\nconst s = raw.indexOf(\"{\");\nconst e = raw.lastIndexOf(\"}\");\nif (s !== -1 && e !== -1 && e > s) raw = raw.slice(s, e + 1);\n\nlet d = {};\nlet parseError = false;\ntry {\n  d = JSON.parse(raw);\n} catch (err) {\n  parseError = true;\n}\n\nif (parseError || !d.email) {\n  const m = raw.match(/[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}/);\n  if (m) d.email = m[0];\n}\n\nconst src = $(\"Search Business Cards\").item.json;\nconst clean = (v) => String(v ?? \"\").trim();\n\nreturn {\n  json: {\n    company: clean(d.company),\n    department: clean(d.department),\n    title: clean(d.title),\n    name: clean(d.name),\n    name_kana: clean(d.name_kana),\n    email: clean(d.email).toLowerCase(),\n    tel: clean(d.tel),\n    mobile: clean(d.mobile),\n    address: clean(d.address),\n    website: clean(d.website),\n    fileId: src.id,\n    fileName: src.name,\n    fileLink: src.webViewLink ?? \"\",\n    parseError,\n    rawOutput: raw\n  }\n};"
      },
      "notesInFlow": true,
      "typeVersion": 2
    },
