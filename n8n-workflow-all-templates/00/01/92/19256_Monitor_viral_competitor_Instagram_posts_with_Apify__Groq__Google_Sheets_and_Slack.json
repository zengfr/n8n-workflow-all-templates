    {
      "id": "code-0013",
      "name": "Flag the breakout posts",
      "type": "n8n-nodes-base.code",
      "position": [
        1720,
        -40
      ],
      "parameters": {
        "jsCode": "// Engagement is judged against each account's OWN median in this run,\n// so a big account and a small one are compared fairly.\nconst multiplier = Number($('Config').first().json.viralMultiplier) || 2;\nconst items = $input.all().map(({ json }) => ({\n  ...json,\n  engagement: (Number(json.likeCount) || 0) + (Number(json.commentCount) || 0),\n}));\n\nconst byAccount = {};\nfor (const row of items) {\n  const key = row.profileHandle || row.ownerUsername || 'unknown';\n  (byAccount[key] = byAccount[key] || []).push(row.engagement);\n}\nconst medians = {};\nfor (const [key, values] of Object.entries(byAccount)) {\n  const sorted = values.slice().sort((a, b) => a - b);\n  const mid = Math.floor(sorted.length / 2);\n  medians[key] = sorted.length % 2 ? sorted[mid] : Math.round((sorted[mid - 1] + sorted[mid]) / 2);\n}\n\nreturn items.map((row) => {\n  const median = medians[row.profileHandle || row.ownerUsername || 'unknown'] || 0;\n  return {\n    json: {\n      ...row,\n      account_median_engagement: median,\n      is_viral: median > 0 && row.engagement >= multiplier * median,\n    },\n  };\n});"
      },
      "typeVersion": 2
    },
