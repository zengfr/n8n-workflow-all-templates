    {
      "id": "code-0023",
      "name": "Write the Slack alert",
      "type": "n8n-nodes-base.code",
      "position": [
        3520,
        -40
      ],
      "parameters": {
        "jsCode": "// Only the posts that broke out, biggest first.\nconst rows = $input.first().json.rows || [];\nconst top = rows.slice().sort((a, b) => (b.engagement || 0) - (a.engagement || 0));\nconst lines = top.map((r) => `• @${r.account} — ${(r.engagement || 0).toLocaleString()} engagements (normal is about ${(r.account_median_engagement || 0).toLocaleString()})\\n  ${r.summary || ''}\\n  ${r.post_url || ''}`);\nconst digest = [`*${rows.length} competitor post${rows.length === 1 ? '' : 's'} broke out today*`, '', ...lines].join('\\n');\nreturn [{ json: { digest, viral_posts: rows.length } }];"
      },
      "typeVersion": 2
    },
