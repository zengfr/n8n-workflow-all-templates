      "parameters": {
        "jsCode": "// The AI node replaces each item with its extracted attributes, so put the\n// original row back together with them. Items come back in the same order.\nconst source = $('Flag the breakout posts').all();\nreturn $input.all().map((item, i) => {\n  const row = { ...(source[i] ? source[i].json : {}) };\n  const ai = item.json.output || {};\n\n  return { json: { ...row, ...ai } };\n});"
