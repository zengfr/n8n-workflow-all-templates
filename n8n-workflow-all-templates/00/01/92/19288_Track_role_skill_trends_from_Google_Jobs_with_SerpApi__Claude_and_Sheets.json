    {
      "id": "4d11aa63-1cf1-467d-b963-78a9475c4820",
      "name": "Process Input Data",
      "type": "n8n-nodes-base.code",
      "notes": "Role falls back to last config if blank. Location defaults to United Kingdom if nothing is saved yet. 'Global' is converted to an empty search_location so SerpApi applies no country filter, while the display label is still kept for logging.",
      "position": [
        6288,
        3248
      ],
      "parameters": {
        "jsCode": "const GLOBAL_LABEL = 'Global (no location filter)';\n\nlet formRole, formLocation;\ntry {\n  const formData = $('When Form Submitted').first().json;\n  formRole = formData['Role'];\n  formLocation = formData['Location'];\n} catch (e) {\n  // Manual Form Trigger did not fire this execution, the schedule did instead\n}\n\nconst configRows = $input.all();\nconst lastConfig = configRows.length ? configRows[0].json : {};\n\nconst role = (formRole && formRole.trim()) ? formRole.trim() : lastConfig.role;\nconst location = formLocation || lastConfig.location || 'United Kingdom';\n\nif (!role) {\n  throw new Error('No role provided and no previous role found in the Config sheet. Run this manually once with a role before relying on the schedule.');\n}\n\nconst search_location = (location === GLOBAL_LABEL) ? '' : location;\n\nreturn [{\n  json: {\n    role,\n    location,\n    search_location,\n    run_date: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "0239e068-4aa9-49d5-826d-2540d5a3f4e2",
      "name": "Fetch Job Postings via SerpApi",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Query params are set as individual fields, not raw JSON. Attach your own SerpAPI credential after import. Paginates up to 10 pages (roughly 100 postings). If pagination shows empty here after import, reopen this node once, it sometimes needs a re-save to register.",
      "position": [
        6528,
        3248
      ],
      "parameters": {
        "url": "https://serpapi.com/search.json",
        "options": {
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "name": "next_page_token",
                    "value": "={{ $response.body.serpapi_pagination?.next_page_token }}"
                  }
                ]
              },
              "maxRequests": 10,
              "requestInterval": 500,
              "limitPagesFetched": true,
              "completeExpression": "={{ !$response.body.serpapi_pagination?.next_page_token }}",
              "paginationCompleteWhen": "other"
            }
          }
        },
        "sendQuery": true,
        "authentication": "predefinedCredentialType",
        "queryParameters": {
          "parameters": [
            {
              "name": "engine",
              "value": "google_jobs"
            },
            {
              "name": "q",
              "value": "={{$json.role}}"
            },
            {
              "name": "hl",
              "value": "en"
            },
            {
              "name": "location",
              "value": "={{$json.search_location}}"
            }
          ]
        },
        "nodeCredentialType": "serpApi"
      },
      "credentials": {
        "serpApi": {
          "id": "toKAa5sEipzKyo2T",
          "name": "SerpAPI account"
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "e76a8523-7692-4ef2-b729-49d532bbe329",
      "name": "Flatten Job Data",
      "type": "n8n-nodes-base.code",
      "notes": "Flattens jobs_results from every page fetched into one list. Descriptions truncated to 800 chars to control token cost.",
      "position": [
        6768,
        3248
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst jobs = [];\nfor (const item of items) {\n  const results = item.json.jobs_results || [];\n  for (const job of results) {\n    jobs.push({\n      title: job.title,\n      company: job.company_name,\n      location: job.location,\n      via: job.via,\n      posted_at: job.detected_extensions?.posted_at || '',\n      description: (job.description || '').slice(0, 800)\n    });\n  }\n}\nreturn jobs.map(j => ({ json: j }));"
      },
      "typeVersion": 2
    },
    {
      "id": "4f053b50-b464-49e7-977b-207f94114b9e",
      "name": "Deduplicate and Limit Results",
      "type": "n8n-nodes-base.code",
      "notes": "Deduplicates by title+company, caps at 100 postings, packages into a single item.",
      "position": [
        7008,
        3248
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst seen = new Set();\nconst unique = [];\nfor (const item of items) {\n  const j = item.json;\n  const key = (j.title + '|' + j.company).toLowerCase();\n  if (!seen.has(key)) {\n    seen.add(key);\n    unique.push(j);\n  }\n}\nconst limited = unique.slice(0, 100);\n\nreturn [{\n  json: {\n    role: $('Process Input Data').first().json.role,\n    location: $('Process Input Data').first().json.location,\n    postings_analyzed: limited.length,\n    postings: limited\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "ac0354d6-109e-4ce8-a39e-689677fa4fdd",
      "name": "Prepare AI Request Payload",
      "type": "n8n-nodes-base.code",
      "notes": "Builds the entire OpenRouter request body in JavaScript and stringifies it, so nothing needs to be hand-typed as raw JSON in the HTTP node. Replace YOUR_MODEL_ID_HERE with the exact model ID copied from openrouter.ai/models.",
      "position": [
        7248,
        3248
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst systemPrompt = `You are analyzing job postings to identify the core technical skills and competencies required for a role. Base your answer only on the postings provided, do not use outside knowledge. Output valid JSON only, no markdown fences, no commentary before or after. Do not include courses, certifications, or learning resource recommendations anywhere in the output. Schema: {\"role\":string,\"location\":string,\"postings_analyzed\":number,\"skills\":[{\"skill\":string,\"category\":string,\"percentage_of_postings\":number}],\"summary_text\":string}. skills should be sorted by percentage_of_postings descending, keep the top 15. summary_text is a short plain text breakdown of the top skills grouped by category, written for someone to read out loud, technical skills only, no fluff.`;\n\nconst userContent = JSON.stringify({\n  role: item.role,\n  location: item.location,\n  postings_analyzed: item.postings_analyzed,\n  postings: item.postings\n});\n\nconst body = {\n  model: \"anthropic/claude-sonnet-4.5\",\n  temperature: 0.2,\n  messages: [\n    { role: \"system\", content: systemPrompt },\n    { role: \"user\", content: userContent }\n  ]\n};\n\nreturn [{ json: { ...item, requestBody: JSON.stringify(body) } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "e0ad4383-e8d5-43bc-ad84-7847061822c6",
      "name": "Post to OpenAI for Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Body is just a reference to the pre-built requestBody string from the previous node. Attach a Header Auth credential with header name 'Authorization' and value 'Bearer YOUR_OPENROUTER_KEY'.",
      "position": [
        7488,
        3248
      ],
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ $json.requestBody }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "KhRVMo2ne1c8pl54",
          "name": "Header Auth account"
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "c51ea542-feb5-416b-9035-cb92fd894b81",
      "name": "Parse OpenAI Response",
      "type": "n8n-nodes-base.code",
      "notes": "Parses the model's JSON reply. Role/location/run_date are taken from Resolve Inputs directly (not from the AI's echo) so the log always matches what was actually searched.",
      "position": [
        7728,
        3248
      ],
      "parameters": {
        "jsCode": "const raw = $json.choices[0].message.content;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Could not parse AI response as JSON: ' + raw);\n}\n\nconst resolved = $('Process Input Data').first().json;\n\nparsed.role = resolved.role;\nparsed.location = resolved.location;\nparsed.run_date = resolved.run_date;\nparsed.top_skills_readable = (parsed.skills || [])\n  .map(s => `${s.skill} (${s.percentage_of_postings}%)`)\n  .join(', ');\nparsed.raw_skills_json = JSON.stringify(parsed.skills || []);\n\nreturn [{ json: parsed }];"
      },
      "typeVersion": 2
    },
    {
      "id": "3e11fb07-5106-4a45-bbdd-7842ba2dd354",
      "name": "Separate Skills into Rows",
      "type": "n8n-nodes-base.code",
      "notes": "Turns one item containing the whole skills array into one item per skill, so Append Row writes a separate row for each skill instead of only the first one.",
      "position": [
        7968,
        2960
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst skills = item.skills || [];\n\nreturn skills.map(s => ({\n  json: {\n    run_date: item.run_date,\n    role: item.role,\n    location: item.location,\n    postings_analyzed: item.postings_analyzed,\n    skill: s.skill,\n    category: s.category,\n    percentage_of_postings: s.percentage_of_postings\n  }\n}));"
      },
      "typeVersion": 2
    },
