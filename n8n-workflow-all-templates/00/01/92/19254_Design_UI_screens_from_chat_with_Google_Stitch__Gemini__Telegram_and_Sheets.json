    {
      "id": "f3923ac8-c4db-4fc9-9deb-03ab82e40c4d",
      "name": "Normalize incoming message",
      "type": "n8n-nodes-base.code",
      "position": [
        -1456,
        304
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const src = item.json;\n  const viaTelegram = src.message !== undefined && src.message !== null && typeof src.message.text === 'string';\n  const raw = viaTelegram ? src.message.text : (src.chatInput !== undefined ? src.chatInput : '');\n  const uid = viaTelegram\n    ? String((src.message.from && src.message.from.id !== undefined) ? src.message.from.id : 'telegram-anon')\n    : String((src.sessionId !== undefined && src.sessionId !== null) ? src.sessionId : 'web-guest');\n  out.push({\n    json: {\n      chatInput: String(raw).trim(),\n      sessionId: uid,\n      channel: viaTelegram ? 'telegram' : 'webchat'\n    }\n  });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
