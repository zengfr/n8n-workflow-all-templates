        -112
      ],
      "parameters": {
        "jsCode": "// Pull video id, title, URL and publish date out of each feed entry\nreturn items.map((item, index) => {\n  const link = (item.json.link || '').toString();\n  const videoId = link.includes('v=') ? link.split('v=')[1] : link.split('/').pop();\n  return {\n    json: {\n      video_id: videoId,\n      title: item.json.title || 'Untitled video',\n      video_url: link,\n      link: link,\n      published: item.json.pubDate || item.json.isoDate || ''\n    },\n    pairedItem: { item: index }\n  };\n});"
      },
      "typeVersion": 2
    },
