    {
      "id": "06288a94-8202-483f-a78b-60a48c7dfe0f",
      "name": "Normalize RemoteOK Jobs",
      "type": "n8n-nodes-base.code",
      "position": [
        592,
        656
      ],
      "parameters": {
        "jsCode": "const cfg = $('Search Config').first().json;\nconst kw = String(cfg.keyword_list || '').toLowerCase().split(',').map(s => s.trim()).filter(Boolean);\nconst out = [];\nfor (const i of $input.all()) {\n  const j = i.json;\n  if (!j || !j.position) continue;\n  const hay = ((j.position || '') + ' ' + (Array.isArray(j.tags) ? j.tags.join(' ') : '')).toLowerCase();\n  if (kw.length && !kw.some(k => hay.includes(k))) continue;\n  out.push({ json: {\n    source: 'remoteok',\n    job_title: j.position || '',\n    company_name: j.company || '',\n    company_id: '',\n    job_url: j.url || (j.slug ? 'https://remoteok.com/remote-jobs/' + j.slug : ''),\n    job_location: j.location || 'Remote'\n  } });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
    {
      "id": "c2cbdccb-2aee-4d75-ae81-191a04168ff8",
      "name": "Fetch We Work Remotely",
      "type": "n8n-nodes-base.rssFeedRead",
      "onError": "continueRegularOutput",
      "position": [
        400,
        864
      ],
      "parameters": {
        "url": "={{ $('Search Config').first().json.wwr_feed_url }}",
        "options": {}
      },
      "typeVersion": 1.2
    },
    {
      "id": "4851db00-f2df-4020-920c-eacf341bddf9",
      "name": "Normalize We Work Remotely",
      "type": "n8n-nodes-base.code",
      "position": [
        608,
        864
      ],
      "parameters": {
        "jsCode": "const cfg = $('Search Config').first().json;\nconst kw = String(cfg.keyword_list || '').toLowerCase().split(',').map(s => s.trim()).filter(Boolean);\nconst out = [];\nfor (const i of $input.all()) {\n  const j = i.json;\n  const title = j.title || '';\n  let company = '';\n  let position = title;\n  const idx = title.indexOf(':');\n  if (idx > 0) { company = title.slice(0, idx).trim(); position = title.slice(idx + 1).trim(); }\n  const hay = title.toLowerCase();\n  if (kw.length && !kw.some(k => hay.includes(k))) continue;\n  out.push({ json: {\n    source: 'weworkremotely',\n    job_title: position,\n    company_name: company,\n    company_id: '',\n    job_url: j.link || '',\n    job_location: 'Remote'\n  } });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
    {
      "id": "43dfd49e-405f-49cf-b9b5-7591437b91b8",
      "name": "Deduplicate Jobs",
      "type": "n8n-nodes-base.code",
      "position": [
        976,
        672
      ],
      "parameters": {
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const i of $input.all()) {\n  const j = i.json;\n  const key = (j.job_url || '') || ((j.company_name || '') + '|' + (j.job_title || ''));\n  if (!key || seen.has(key)) continue;\n  seen.add(key);\n  out.push({ json: { ...j, company_match: j.company_id ? 'has_id' : '' } });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
