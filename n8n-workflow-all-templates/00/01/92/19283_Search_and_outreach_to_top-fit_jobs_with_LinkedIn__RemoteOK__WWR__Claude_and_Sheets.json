      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let note = '';\ntry {\n  let raw = $json.content?.[0]?.text || '{}';\n  raw = raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  note = JSON.parse(raw).note || '';\n} catch (e) {}\nconst prev = $('Extract Recipient').item.json;\nreturn { json: { ...prev, connection_note: note } };"
