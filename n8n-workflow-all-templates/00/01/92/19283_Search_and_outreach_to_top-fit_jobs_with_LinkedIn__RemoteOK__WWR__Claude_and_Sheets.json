    {
      "id": "c3fe6954-ef9e-4118-aedc-620a331df7b3",
      "name": "Extract Company ID",
      "type": "n8n-nodes-base.code",
      "position": [
        1632,
        848
      ],
      "parameters": {
        "jsCode": "const job = $('Has Company ID Already').item.json;\nconst results = $input.all().map(i => i.json);\nconst norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst targetNorm = norm(job.company_name);\nlet best = null;\nfor (const r of results) {\n  const name = r.name || r.company_name || '';\n  const nameNorm = norm(name);\n  if (!nameNorm) continue;\n  if (nameNorm === targetNorm || nameNorm.includes(targetNorm) || targetNorm.includes(nameNorm)) { best = r; break; }\n}\nlet company_match = 'not_found';\nif (!best && results.length) { best = results[0]; company_match = 'unverified_fallback'; }\nelse if (best) { company_match = 'verified'; }\nbest = best || {};\nconst resolvedId = best.id || best.entity_urn || best.universal_name || (best.url ? best.url.split('/').filter(Boolean).pop() : '') || '';\nreturn [{ json: { ...job, company_id: resolvedId, company_match } }];"
      },
      "typeVersion": 2
    },
