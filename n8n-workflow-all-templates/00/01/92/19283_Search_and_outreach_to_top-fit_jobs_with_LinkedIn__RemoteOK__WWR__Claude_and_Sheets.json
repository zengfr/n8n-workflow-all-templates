        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 200, messages: [ { role: 'user', content: 'Write a short LinkedIn connection request note under 300 characters. Sender: ' + $('Search Config').first().json.candidate_name + ', applying for the ' + $json.job_title + ' role at ' + $json.company_name + '. Sender background: ' + $('Search Config').first().json.candidate_profile + '. Recipient: ' + $json.recipient_name + ' (' + $json.recipient_headline + ') at the same company. Rules: first person from the sender, mention genuine interest in the specific open role, warm and professional, no hard pitch, no apostrophes. Return raw JSON only with key: note string.' } ] }) }}",
