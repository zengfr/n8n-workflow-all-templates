    {
      "id": "5dc98aad-0750-4b3b-af2c-922046148e16",
      "name": "Extract Recipient",
      "type": "n8n-nodes-base.code",
      "position": [
        2784,
        560
      ],
      "parameters": {
        "jsCode": "const job = $('Parse Draft').item.json;\nconst results = $input.all().map(i => i.json);\nconst cfg = $('Search Config').first().json;\nconst wanted = String(cfg.recipient_titles || '').toLowerCase().split(',').map(s => s.trim()).filter(Boolean);\nlet best = null;\nfor (const r of results) {\n  const c = r.author || r;\n  const headline = String(c.headline || c.occupation || '').toLowerCase();\n  if (wanted.length && wanted.some(w => w && headline.includes(w))) { best = c; break; }\n}\nlet recipient_match = 'not_found';\nif (!best && results.length) {\n  const first = results[0] || {};\n  best = first.author || first;\n  recipient_match = 'unverified_fallback';\n} else if (best) {\n  recipient_match = 'verified';\n}\nbest = best || {};\nconst recipient_id = best.provider_id || best.id || best.entity_urn || '';\nreturn [{ json: { ...job, recipient_id, recipient_name: best.name || [best.first_name, best.last_name].filter(Boolean).join(' ') || '', recipient_headline: best.headline || best.occupation || '', recipient_match } }];"
      },
