        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          }
        },
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 300, messages: [ { role: 'user', content: 'Score this job for candidate fit from 1 to 10. Candidate profile: ' + $('Search Config').first().json.candidate_profile + '. Preferences: ' + $('Search Config').first().json.candidate_preferences + '. Job title: ' + $json.job_title + '. Company: ' + $json.company_name + '. Location: ' + $json.job_location + '. Source: ' + $json.source + '. Rules: if the role does not match the wanted roles score 3 max; if it matches base score 7; classify work_mode as one of REMOTE_OK, HYBRID_OK, HYBRID_TOO_FAR, UNCLEAR using the preferences; if HYBRID_TOO_FAR score 2 max. Respond in raw JSON only, keys score number, work_mode string, reason string.' } ] }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "nodeCredentialType": "anthropicApi"
      },
      "retryOnFail": true,
      "typeVersion": 4.4
    },
    {
      "id": "64317e33-bdf8-476a-bda6-dbf67ae8d6c7",
      "name": "Parse Fit Score",
      "type": "n8n-nodes-base.code",
      "position": [
        1520,
        672
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Deduplicate Jobs').item.json;\nlet parsed = { score: 0, work_mode: 'UNCLEAR', reason: 'parse error' };\ntry {\n  let raw = $json.content?.[0]?.text || '{}';\n  raw = raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  parsed = JSON.parse(raw);\n} catch (e) {}\nreturn { json: { ...original, fit_score: parsed.score || 0, work_mode: parsed.work_mode || 'UNCLEAR', fit_reason: parsed.reason || '' } };"
      },
      "typeVersion": 2
    },
