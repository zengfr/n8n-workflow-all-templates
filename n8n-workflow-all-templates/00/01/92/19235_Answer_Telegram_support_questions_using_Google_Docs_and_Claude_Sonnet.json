    {
      "id": "e350fdf4-c7b6-40e9-a890-571d9118706a",
      "name": "Format AI Response",
      "type": "n8n-nodes-base.code",
      "position": [
        2272,
        208
      ],
      "parameters": {
        "jsCode": "let txt = $('Response Generation Agent').first().json.output || '';\n\n// Telegram markdown'ı destekler ama temizlemek istersen:\n// txt = txt.replace(/[*_~`]+/g, '');\n\n// Markdown link formatını düz metne çevir\ntxt = txt.replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^\\s)]+)\\)/g, '$1 $2');\n\n// 3+ boş satırı 2'ye indir\ntxt = txt.replace(/\\n{3,}/g, '\\n\\n').trim();\n\n// Belge referansı kalıplarını temizle\ntxt = txt.replace(/^.*?based on the document you provided[,:]?\\s*/i, '');\n\nreturn [{ json: { answer: txt } }];"
      },
      "typeVersion": 2
    },
