    {
      "id": "575f03f8-78be-4390-b506-a8e250738806",
      "name": "Extract Email Context",
      "type": "n8n-nodes-base.code",
      "position": [
        272,
        0
      ],
      "parameters": {
        "jsCode": "// Normalize each Gmail message into predictable fields for the rest of the flow.\nconst items = [];\nfor (const item of $input.all()) {\n  const raw = item.json;\n  const from = raw.from || {};\n  const to = Array.isArray(raw.to) ? raw.to[0] : (raw.to || {});\n  const replyTo = Array.isArray(raw.replyTo) ? raw.replyTo[0] : (raw.replyTo || {});\n  const textOf = (src) => src && (src.text || src.email || src.name || (typeof src === 'string' ? src : ''));\n  const headers = (raw.payload && raw.payload.headers) || [];\n  const fromHeader = headers.find((h) => h.name === 'From');\n  const sender = String(textOf(from) || textOf(replyTo) || textOf(to) || (fromHeader ? fromHeader.value : '') || '');\n  items.push({\n    json: {\n      thread_id: String(raw.threadId || ''),\n      message_id: String(raw.id || ''),\n      sender: sender,\n      subject: String(raw.subject || ''),\n      snippet: String(raw.snippet || ''),\n      label_ids: Array.isArray(raw.labelIds) ? raw.labelIds.join(',') : '',\n      received_at: new Date().toISOString()\n    }\n  });\n}\nreturn items;"
      },
      "typeVersion": 2
    },
