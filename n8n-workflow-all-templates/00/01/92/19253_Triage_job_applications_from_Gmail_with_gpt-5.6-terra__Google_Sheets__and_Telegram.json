    {
      "id": "99f4c6c0-42ba-407e-8627-f2392c94c535",
      "name": "Classify and Draft Reply",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1376,
        0
      ],
      "parameters": {
        "text": "=You are the inbox sorter for a busy recruiting team. Read the applicant email below and return only the JSON object described by your output schema. Do not add any text outside that JSON.\n\nRules:\n1. category must be exactly one of: application, question, other.\n   Use application when the sender applies for a role, submits a resume, or shows interest in an open position.\n   Use question when the sender asks about the hiring process, a role, the company, or timelines.\n   Use other for anything else, including newsletters, spam, and internal mail.\n2. sentiment must be exactly one of: neutral, positive, negative, urgent.\n   Use urgent when the sender is time sensitive, frustrated, or demands an immediate follow up.\n3. draft_reply must be a short, polite, professional reply. Greet the sender by name when one is visible.\n   For applications, thank the sender for applying and confirm that the team reviews every submission.\n   For questions that are not about an open application, politely decline to answer and point the sender to the public careers page.\n   Never invent facts, salaries, or timelines. Never include internal details.\n4. suggested_subject must be a reply subject of 8 words or fewer.\n\nEmail details:\nSender: {{ $json.sender }}\nSubject: {{ $json.subject }}\nBody preview: {{ $json.snippet }}\nThread id: {{ $json.thread_id }}",
        "options": {},
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
      "id": "72526241-94a9-4a52-bfa0-bad1ce34bbef",
      "name": "Draft and Category Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1552,
        -160
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": { \"type\": \"string\", \"description\": \"One of: application, question, other\" },\n    \"sentiment\": { \"type\": \"string\", \"description\": \"One of: neutral, positive, negative, urgent\" },\n    \"draft_reply\": { \"type\": \"string\", \"description\": \"Polite professional reply to the sender\" },\n    \"suggested_subject\": { \"type\": \"string\", \"description\": \"Short reply subject line\" }\n  },\n  \"required\": [\"category\", \"sentiment\", \"draft_reply\", \"suggested_subject\"]\n}"
      },
      "typeVersion": 1.3
    },
