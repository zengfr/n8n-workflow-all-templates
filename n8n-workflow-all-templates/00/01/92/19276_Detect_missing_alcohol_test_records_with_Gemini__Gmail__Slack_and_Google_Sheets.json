    {
      "id": "b2ec64fd-33c8-4479-b807-102a47bce17f",
      "name": "Write reminder and summary",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "maxTries": 5,
      "position": [
        1184,
        1712
      ],
      "parameters": {
        "text": "=You are a fleet operations assistant at a Japanese transport company.\n\nDriver: {{ $json.name }}\nVehicle: {{ $json.vehicle }}\nDate: {{ $json.shiftDate }}\nMissing check: {{ $json.shiftType }} the shift\n\nThis driver did not submit an alcohol test record for the shift above.\n\nWrite two messages in Japanese, separated by a line containing only \"---\".\n\nFirst message: to the driver. Polite and matter-of-fact (です・ます調).\nState which check is missing and ask them to submit the record today.\nDo not accuse them of drinking or of misconduct. Keep it under 200 characters.\n\nSecond message: one line for the operations manager.\nFormat: 氏名 / 車両 / 未実施の区分",
        "batching": {},
        "promptType": "define"
      },
      "retryOnFail": true,
      "typeVersion": 1.9,
      "waitBetweenTries": 5000
    },
