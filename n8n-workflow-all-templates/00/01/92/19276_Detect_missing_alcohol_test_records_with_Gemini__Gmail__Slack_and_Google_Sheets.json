    {
      "id": "cf3b1984-5bee-46fc-a8cc-deb62dbd995c",
      "name": "Summarise missing checks",
      "type": "n8n-nodes-base.code",
      "position": [
        544,
        1776
      ],
      "parameters": {
        "jsCode": "const config = $('Configure check rules').first().json;\n\nconst items = $input.all()\n  .map(i => i.json)\n  .filter(r => String(r.shiftDate).slice(0, 10) === config.checkDate);\n\nreturn [{\n  json: {\n    checkDate: config.checkDate,\n    missingCount: items.length,\n    missing: items,\n  },\n}];"
      },
      "typeVersion": 2
    },
