    {
      "id": "a6e872b1-b893-4f23-9717-e1a6c091de28",
      "name": "Validate & Guard Output",
      "type": "n8n-nodes-base.code",
      "position": [
        576,
        0
      ],
      "parameters": {
        "jsCode": "const normalizedLead = $('Normalize Lead Fields').first().json;\nconst output = $input.first().json?.output;\nconst valid =\n  output &&\n  typeof output.reasoning === 'string' &&\n  output.reasoning.trim().length > 0 &&\n  typeof output.score === 'number' &&\n  Number.isFinite(output.score) &&\n  output.score >= 0 &&\n  output.score <= 100 &&\n  ['hot', 'warm', 'cold'].includes(output.tier);\n\nconst qualification = valid\n  ? {\n      reasoning: output.reasoning,\n      score: output.score,\n      tier: output.tier,\n    }\n  : {\n      reasoning: '[MANUAL REVIEW] AI qualification unavailable or invalid',\n      score: null,\n      tier: 'review',\n    };\n\nreturn [{ json: { ...normalizedLead, ...qualification } }];"
      },
      "typeVersion": 2
    }
