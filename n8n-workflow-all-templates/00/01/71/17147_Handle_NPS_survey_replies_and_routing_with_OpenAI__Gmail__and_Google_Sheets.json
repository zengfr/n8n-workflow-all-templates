      ],
      "webhookId": "840c06fa-0316-4408-8309-2d8157a7434b",
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "message": "={{ $json.emailBody }}",
        "options": {
          "senderName": "Customer Success Team",
          "appendAttribution": false
        },
        "subject": "={{ $json.emailSubject }}"
      },
      "typeVersion": 2.1
