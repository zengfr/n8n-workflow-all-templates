      ],
      "parameters": {
        "color": 7,
        "width": 644,
        "height": 364,
        "content": "## Log every check\n\nAll campaigns — healthy or not — get a dated row, so you can see trends over time."
      },
      "typeVersion": 1
    },
    {
      "id": "2ed0ee9d-5f33-4b1b-a8fd-bd88df841c07",
      "name": "Section: alert",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1280,
        1024
      ],
      "parameters": {
        "color": 7,
        "width": 628,
        "height": 204,
        "content": "## Alert on trouble\n\nCampaigns needing attention also fire a Slack alert naming the bottleneck, so you hear about a leak the day it starts."
      },
      "typeVersion": 1
    },
    {
      "id": "e551f968-0808-4fc8-a828-3a10c9d72d51",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        608,
