      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "c0eb9dd4-c846-40aa-a41c-f0a300b5e3d7",
      "name": "Google Sheets: read campaigns",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        848,
        448
      ],
      "parameters": {
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        }
      },
      "typeVersion": 4.5
    },
    {
      "id": "b969d3c9-b875-45ad-9341-3dfcdffaf7d3",
      "name": "Build diagnosis payload",
      "type": "n8n-nodes-base.code",
      "position": [
        1072,
        448
      ],
      "parameters": {
        "jsCode": "// One diagnosis request per campaign row. Numbers are coerced; blank cells\n// are dropped so Spendict only sees metrics you actually track.\nconst METRIC_KEYS = ['spend','impressions','ctr','cpc','cpm','lpv_rate','conversion_rate','cpa','roas','conversions'];\nreturn $input.all().map((item) => {\n  const r = item.json;\n  const metrics = {};\n  for (const k of METRIC_KEYS) {\n    const n = parseFloat(r[k]);\n    if (!isNaN(n)) metrics[k] = n;\n  }\n  return { json: {\n    campaign_identifier: String(r.campaign || r.campaign_name || 'unnamed campaign'),\n    platform: String(r.platform || 'meta').toLowerCase(),\n    objective: String(r.objective || 'purchases'),\n    metrics\n  } };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "548acf21-1259-436b-9c0e-1cdca9bd9bbe",
      "name": "Spendict: analyze_campaign_performance",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1328,
        448
      ],
      "parameters": {
        "url": "https://www.spendict.com/api/v1/analyze-performance",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ platform: $json.platform, objective: $json.objective, metrics: $json.metrics, campaign_identifier: $json.campaign_identifier }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "5b691425-5360-404b-afa0-c4eff8ad457b",
      "name": "Route on health",
      "type": "n8n-nodes-base.switch",
      "position": [
        1568,
        448
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "healthy",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.verdict }}",
                    "rightValue": "healthy"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "fix_first",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.verdict }}",
                    "rightValue": "fix_first"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "kill_or_rebuild",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.verdict }}",
                    "rightValue": "kill_or_rebuild"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "insufficient_data"
        }
      },
      "typeVersion": 3
    },
    {
      "id": "a6b8b494-7f16-440f-97ba-d648c8f014a3",
      "name": "Row: healthy / no data",
      "type": "n8n-nodes-base.code",
      "position": [
        2048,
        448
      ],
      "parameters": {
        "jsCode": "const c = $('Build diagnosis payload').item.json;\nreturn [{ json: {\n  campaign: c.campaign_identifier,\n  platform: c.platform,\n  verdict: $json.verdict,\n  score: $json.overall_score,\n  bottleneck: $json.primary_bottleneck || '',\n  diagnosis: $json.diagnosis || '',\n  checked_at: new Date().toISOString().slice(0, 10)\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "f082339b-776e-4014-b7f4-cbd641b96418",
      "name": "Row: needs attention",
      "type": "n8n-nodes-base.code",
      "position": [
        1328,
        848
      ],
      "parameters": {
        "jsCode": "const c = $('Build diagnosis payload').item.json;\nconst fixes = $json.prioritized_fixes || [];\nreturn [{ json: {\n  campaign: c.campaign_identifier,\n  platform: c.platform,\n  verdict: $json.verdict,\n  score: $json.overall_score,\n  bottleneck: $json.primary_bottleneck || '',\n  diagnosis: ($json.diagnosis || '') + (fixes.length ? ' → Fix: ' + (fixes[0].suggestion || fixes[0].issue) : ''),\n  checked_at: new Date().toISOString().slice(0, 10)\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "b4638add-5439-4e00-b909-d193971b2faf",
      "name": "Slack: alert",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1568,
        848
      ],
      "parameters": {
        "url": "https://hooks.slack.com/services/REPLACE_WITH_YOUR_SLACK_WEBHOOK",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ text: ($json.verdict === 'kill_or_rebuild' ? '🚨 ' : '⚠️ ') + $json.campaign + ' (' + $json.platform + ') — ' + $json.verdict + ', score ' + $json.score + '/100. Bottleneck: ' + $json.bottleneck + '. ' + $json.diagnosis }) }}",
        "sendBody": true,
        "specifyBody": "json"
      },
      "typeVersion": 4.2
    },
    {
      "id": "4ba65617-b14a-44f0-baa5-76105093b252",
