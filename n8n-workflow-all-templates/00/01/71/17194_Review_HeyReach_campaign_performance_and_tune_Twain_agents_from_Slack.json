    {
      "id": "7a39fe72-3776-4629-b687-09fd5aa3af25",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "position": [
        2368,
        320
      ],
      "parameters": {
        "jsCode": "const a = $('Twain: Analyze Campaign').first().json;\nconst req = $('Build Analyze Request').first().json;\nconst h = a.health || {};\nconst pct = (x, d) => (x == null ? null : (x * 100).toFixed(d == null ? 0 : d) + '%');\nconst link = a.link ? String(a.link).replace(/^https?:\\/\\/[^/]+/, 'https://www.twain.ai') : '';\nconst lines = [':mag: *Campaign Co-pilot — ' + req.campaign_name + '*' + (req.campaign_status ? '  ·  ' + req.campaign_status : '')];\nlines.push(req.cumulative_line);\nconst trend = [];\nif (h.reply_rate_7d != null) trend.push('Reply rate last 7d: ' + pct(h.reply_rate_7d, 1) + (h.reply_rate_prior_7d != null ? ' (prior 7d: ' + pct(h.reply_rate_prior_7d, 1) + ')' : ''));\nif (h.new_replies_24h != null && h.new_replies_24h > 0) trend.push(h.new_replies_24h + ' new repl' + (h.new_replies_24h === 1 ? 'y' : 'ies') + ' in the last 24h');\nif (trend.length) lines.push(trend.join(' · '));\nfor (const al of h.alerts || []) lines.push(':warning: ' + al.message);\nlines.push('');\nlines.push('*Summary*  ' + (a.summary || '(none)'));\nconst themes = Array.isArray(a.themes) ? a.themes : [];\nif (themes.length) { lines.push(''); lines.push('*Reply themes*'); for (const t of themes) lines.push('•  ' + t.label + ' — ' + (t.count || 0) + ' ' + (t.sentiment || 'neutral') + (t.example ? '  ·  _' + String(t.example).slice(0, 150) + '_' : '')); }\nconst diags = Array.isArray(a.step_diagnostics) ? a.step_diagnostics : [];\nif (diags.length) { lines.push(''); lines.push('*Step diagnostics*'); for (const d of diags) lines.push('•  Step ' + (Number(d.step_index) + 1) + ': ' + d.verdict + (d.reply_rate != null ? ' (' + (d.reply_rate * 100).toFixed(1) + '% reply rate)' : '')); }\nconst camps = Array.isArray(a.campaign_suggestions) ? a.campaign_suggestions : [];\nif (camps.length) { lines.push(''); lines.push('*Campaign advice* — act on these in HeyReach'); for (const c of camps) lines.push('•  *' + (c.area || 'other') + '*: ' + c.suggestion + (c.rationale ? '  ·  _' + c.rationale + '_' : '')); }\nconst suggestions = Array.isArray(a.suggestions) ? a.suggestions : [];\nconst changes = suggestions.filter((s) => s.field !== 'personas').map((s) => ({ field: s.field, action: s.action, value: s.value }));\nif (suggestions.length) { lines.push(''); lines.push('*Proposed Agent changes*'); let i = 0; for (const s of suggestions) { i++; lines.push(i + '. `' + s.field + '` ' + s.action + ' → ' + String(s.value).slice(0, 200)); const meta = []; if (s.rationale) meta.push(s.rationale); if (s.evidence) meta.push('evidence: ' + s.evidence); meta.push(Math.round((s.confidence || 0) * 100) + '% confidence'); lines.push('    _' + meta.join(' · ') + '_'); } }\nconst digest = lines.join('\\n');\nconst postText = digest + (link ? '\\n<' + link + '|Open campaign in Twain>' : '');\nconst approvalText = digest + '\\n\\n*Apply ' + (changes.length === 1 ? 'this change' : 'these ' + changes.length + ' changes') + ' to the campaign Agent?*';\nconst shouldPost = a.analyzed === true || (h.alerts || []).length > 0;\nreturn [{ json: { approval_text: approvalText, post_text: postText, changes: changes, has_changes: changes.length > 0, should_post: shouldPost, campaign_name: req.campaign_name, twain_campaign_id: req.analyze_payload.campaign_id, campaign_link: link } }];"
      },
      "typeVersion": 2
    },
