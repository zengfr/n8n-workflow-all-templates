    {
      "id": "fd9f70d0-53cc-45c9-8d1b-c57a9d9d075e",
      "name": "Build Analyze Request",
      "type": "n8n-nodes-base.code",
      "position": [
        1888,
        384
      ],
      "parameters": {
        "jsCode": "const pair = $('Each Campaign').first().json;\nconst camp = $('HeyReach: Campaign').first().json || {};\nconst stats = $('HeyReach: Overall Stats').first().json || {};\nconst convs = $('HeyReach: Conversations').first().json || {};\nconst overall = stats.overallStats || {};\nconst byDay = stats.byDayStats || {};\nconst daily = Object.keys(byDay).map((k) => { const d = byDay[k] || {}; return { day: k.slice(0, 10), sent: d.messagesSent || 0, replied: d.totalMessageReplies || 0, connections_sent: d.connectionsSent || 0, connections_accepted: d.connectionsAccepted || 0 }; }).sort((a, b) => (a.day < b.day ? -1 : 1)).slice(-60);\nconst conversations = (Array.isArray(convs.items) ? convs.items : []).map((c) => ({ contact_ref: (c.correspondentProfile || {}).profileUrl || null, messages: (Array.isArray(c.messages) ? c.messages : []).slice(-100).map((m) => ({ body: String(m.body || '').slice(0, 4000), direction: m.sender === 'ME' ? 'outgoing' : 'incoming', sent_at: m.createdAt || null })).filter((m) => m.body) })).filter((t) => t.messages.length).slice(0, 120);\nconst ps = camp.progressStats || {};\nconst payload = { campaign_id: pair.twain_campaign_id, provider: 'heyreach', force: new Date().getUTCDay() === 1, stats: { sent: overall.messagesSent != null ? overall.messagesSent : null, replied: overall.totalMessageReplies != null ? overall.totalMessageReplies : null, connection_accept_rate: overall.connectionAcceptanceRate != null ? overall.connectionAcceptanceRate : null, total_leads: ps.totalUsers != null ? ps.totalUsers : null, finished: ps.totalUsersFinished != null ? ps.totalUsersFinished : null, failed: ps.totalUsersFailed != null ? ps.totalUsersFailed : null, campaign_active: camp.status === 'IN_PROGRESS', daily: daily }, conversations: conversations };\nif (pair.focus) payload.focus = String(pair.focus);\nconst cum = [];\ncum.push((overall.connectionsSent || 0) + ' invites' + (overall.connectionAcceptanceRate != null ? ' (' + (overall.connectionAcceptanceRate * 100).toFixed(0) + '% accepted)' : ''));\ncum.push((overall.messagesSent || 0) + ' messages');\ncum.push((overall.totalMessageReplies || 0) + ' replies');\nreturn [{ json: { analyze_payload: payload, campaign_name: camp.name || String(pair.heyreach_campaign_id), campaign_status: camp.status || '', cumulative_line: cum.join(' · ') } }];"
      },
      "typeVersion": 2
    },
