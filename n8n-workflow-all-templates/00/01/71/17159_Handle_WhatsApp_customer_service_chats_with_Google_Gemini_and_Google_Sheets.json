    {
      "id": "99007c0d-62b7-40bc-a040-1befa1489d84",
      "name": "Set AI Handle",
      "type": "n8n-nodes-base.code",
      "position": [
        -48,
        80
      ],
      "parameters": {
        "jsCode": "const d = $json.data || {};\nconst chatId = d.chatId || d.senderId || '';\nconst r = d.reaction;\nconst emoji = typeof r === 'string' ? r : (r && r.text) || '';\nconst ok = chatId && (emoji.includes('✅') || emoji.includes('☑'));\nreturn ok ? [{ json: { chatId } }] : [];"
      },
      "retryOnFail": true,
      "typeVersion": 2
    },
