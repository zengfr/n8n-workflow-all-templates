    {
      "id": "ms_aeaaa2c69144e9df",
      "name": "mergeState",
      "type": "n8n-nodes-base.code",
      "position": [
        2048,
        368
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Merge the HTTP poll response with the carried loop state. NO network calls.\n// Items arrive via Merge(append): one from pollTask (response), one from carryState.\nconst items = $input.all();\n// Identify the response item by its status in EITHER supported shape: the\n// current envelope reports it as data.status, the compatibility shape reports it\n// top-level. Do NOT require a top-level `object` -- the current contract does\n// not send one.\nconst isCarried = (j) => !!(j && j.poll_index !== undefined);\nconst hasStatus = (j) => !!(j && (typeof j.status === 'string'\n  || (j.data && typeof j.data.status === 'string')));\nconst response = items.find(i => hasStatus(i.json) && !isCarried(i.json)) || items[0];\nconst carried = items.find(i => isCarried(i.json)) || items[items.length > 1 ? 1 : 0] || items[0];\nconst pollIndex = (carried.json.poll_index || 0) + 1;\nconst rj = response.json || {};\nconst data = (rj.data && typeof rj.data === 'object') ? rj.data : {};\n// Task id: current data.task_id first, then the compatibility top-level forms.\nconst taskId = data.task_id || rj.task_id || rj.id || data.id || carried.json.task_id;\n// Status: current data.status first, top-level status is compatibility only.\nconst status = (typeof data.status === 'string' && data.status)\n  || (typeof rj.status === 'string' && rj.status)\n  || undefined;\nconst metadata = rj.metadata || data.metadata;\nconst error = rj.error || data.error;\n// Failure reason: current data.fail_reason first, error.message is compat only.\nconst failReason = (typeof data.fail_reason === 'string' && data.fail_reason)\n  || (error && error.message)\n  || '';\n// Result URL: current data.result_url first; the rest are compat fallbacks.\nconst resultUrl = data.result_url\n  || (metadata && metadata.url)\n  || (data.data && data.data.content && data.data.content.video_url)\n  || '';\nreturn [{ json: {\n  task_id: taskId,\n  status: status,\n  fail_reason: failReason,\n  metadata: metadata,\n  data: data,\n  error: error,\n  poll_index: pollIndex,\n  maxPolls: carried.json.maxPolls || 120,\n  intervalSeconds: carried.json.intervalSeconds || 5,\n  base_url: carried.json.base_url || 'https://vancine.com',\n  result_url: resultUrl\n}}];",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
