      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1120,
        -288
      ],
      "parameters": {
        "color": 7,
        "width": 752,
        "height": 708,
        "content": "## 3. Log & send the notes\nAppend the meeting to Sheets and email the summary, decisions, actions and open questions to every attendee."
      },
      "typeVersion": 1
    },
    {
      "id": "03b2d1d9-97f0-4be9-b355-1bf50dc04d3f",
      "name": "S4",
