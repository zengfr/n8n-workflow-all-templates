    {
      "id": "ebbcd0f1-42e8-4684-b92f-544784fea329",
      "name": "Meeting Notes Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        640,
        224
      ],
      "parameters": {
        "jsonSchemaExample": "{\"summary\":\"Agreed the Q3 roadmap\",\"decisions\":[\"Ship billing in July\"],\"action_items\":[{\"task\":\"Draft billing spec\",\"owner\":\"Sam\",\"due\":\"2026-08-01\"}],\"open_questions\":[\"Who owns pricing?\"]}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "20f38f2a-ba6a-428c-990e-430fbcb46fe2",
      "name": "Parse Meeting Notes",
      "type": "n8n-nodes-base.code",
      "position": [
        1200,
        32
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $json.output || $json;\nconst f = $('Meeting Notes Form').item.json;\nconst list = function (x) { return Array.isArray(x) ? x : []; };\nconst actions = list(src.action_items).map(function (a) { return { task: a.task || '', owner: a.owner || 'Unassigned', due: a.due || '' }; });\nreturn {\n  meetingTitle: f['Meeting title'] || '',\n  attendees: f['Attendee emails'] || '',\n  summary: src.summary || '',\n  decisions: list(src.decisions).join(' | '),\n  openQuestions: list(src.open_questions).join(' | '),\n  actionItems: actions,\n  actionCount: actions.length,\n  actionText: actions.map(function (a) { return '- ' + a.task + ' (' + a.owner + (a.due ? ', due ' + a.due : '') + ')'; }).join('\\n')\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "7a6d6ef1-1ad4-48ba-b98d-6a0178e50d69",
      "name": "Log Meeting Notes",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1440,
