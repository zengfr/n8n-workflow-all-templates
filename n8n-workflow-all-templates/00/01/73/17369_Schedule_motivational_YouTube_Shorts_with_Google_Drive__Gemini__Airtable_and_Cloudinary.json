    {
      "id": "8d986bfb-bd6a-48c0-b2d6-e87eb525849b",
      "name": "Build Cloudinary URL",
      "type": "n8n-nodes-base.code",
      "position": [
        672,
        -160
      ],
      "parameters": {
        "jsCode": "// Get the Cloudinary upload response\nconst r = $input.item.json;\n\n// Original URL, e.g.\n// https://res.cloudinary.com/dtpfzs17b/video/upload/v1764774155/uc.mp4\nconst secure = r.secure_url;\n\nif (!secure || !secure.includes('/upload/')) {\n  throw new Error('Unexpected secure_url from Cloudinary');\n}\n\n// Your compression transform\nconst transform = 'f_mp4,vc_h264,w_1080,c_limit,br_5000k,q_80';\n;\n\n// Insert the transform between /upload/ and the rest\nconst [prefix, rest] = secure.split('/upload/');\nconst compressedUrl = `${prefix}/upload/${transform}/${rest.replace(/^\\/+/, '')}`;\n\nreturn [{ json: { compressedUrl } }];\n"
      },
      "typeVersion": 2
    },
