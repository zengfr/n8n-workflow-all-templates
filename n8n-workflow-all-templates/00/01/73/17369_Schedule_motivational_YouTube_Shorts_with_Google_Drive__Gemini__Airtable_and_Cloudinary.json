    {
      "id": "ddf09c07-4e11-4466-a76e-ba5c9e3c0b56",
      "name": "build tags for YT",
      "type": "n8n-nodes-base.code",
      "position": [
        1744,
        320
      ],
      "parameters": {
        "jsCode": "const inputItems = $input.all();\n// Assuming you want to process the 'content.parts[0].text' from the first input item\nconst content = inputItems[0]?.json?.content?.parts?.[0]?.text || \"\";\nconst result = content\n  .trim()\n  .split(/\\s+/)\n  .map(w => w.replace(/^#/, \"\"))\n  .filter(w => w.length > 0)\n  .join(\", \");\n\nreturn [\n  {\n    json: {\n      tagsRaw: content,\n      formattedTags: result\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
