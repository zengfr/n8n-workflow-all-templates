        -48,
        -160
      ],
      "parameters": {
        "color": 7,
        "width": 400,
        "height": 320,
        "content": "## Schedule product input\n\nStarts the workflow on a schedule and reads the list of products to monitor from Google Sheets."
      },
      "typeVersion": 1
    },
