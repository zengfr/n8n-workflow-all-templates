      "name": "Email Domain Alert",
      "type": "n8n-nodes-base.gmail",
      "position": [
        3456,
        96
      ],
      "webhookId": "a1e1c1a1-webhook-0013",
      "parameters": {
        "sendTo": "user@example.com",
        "message": "==<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#222;max-width:600px\">\n  <h2 style=\"margin:0 0 4px\">🌐 {{ $json.domain }}</h2>\n  <p style=\"margin:0 0 12px;color:#666\">{{ $json.source }} · .{{ $json.tld }}</p>\n  <table style=\"border-collapse:collapse;width:100%\">\n    <tr><td style=\"padding:5px 10px;font-weight:bold;background:#f4f4f4;width:140px\">Domain Age</td><td style=\"padding:5px 10px\">{{ $json.domainAgeYears ? $json.domainAgeYears + ' yrs' : 'unknown' }}</td></tr>\n    <tr><td style=\"padding:5px 10px;font-weight:bold;background:#f4f4f4\">Backlinks</td><td style=\"padding:5px 10px\">{{ $json.backlinks ?? 'unknown' }}</td></tr>\n    <tr><td style=\"padding:5px 10px;font-weight:bold;background:#f4f4f4\">Current Bid</td><td style=\"padding:5px 10px\">{{ $json.currentBid || 'n/a' }}</td></tr>\n    <tr><td style=\"padding:5px 10px;font-weight:bold;background:#f4f4f4\">Expiry/Auction</td><td style=\"padding:5px 10px\">{{ $json.expiryOrAuctionDate || 'n/a' }}</td></tr>\n  </table>\n  <p><a href=\"{{ $('Batch Process Domains').item.json.search_url }}\" style=\"color:#0645ad\">View listing →</a></p>\n</div>",
        "options": {},
        "subject": "=🌐 Domain Drop: {{ $json.domain }} ({{ $json.source }})"
      },
      "typeVersion": 2.2
    },
