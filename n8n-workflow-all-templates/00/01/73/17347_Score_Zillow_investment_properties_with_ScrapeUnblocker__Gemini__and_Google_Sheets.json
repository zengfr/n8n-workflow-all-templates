    {
      "id": "b6eee755-282a-4c8b-b6d8-f1a6745f4580",
      "name": "Extract Unique Listings",
      "type": "n8n-nodes-base.code",
      "position": [
        1616,
        160
      ],
      "parameters": {
        "jsCode": "const scraped = $input.all().map(i => i.json);\n\nconst seenUrls = new Set(\n  $('Read From Zillow Sheet').all().map(i => i.json.url)\n);\n\nconst newListings = scraped.filter(l => !seenUrls.has(l.url));\n\nif (newListings.length === 0) {\n  return [{ json: { status: \"no_new_listings\" } }];\n}\n\nreturn newListings.map(l => ({ json: l }));"
      },
      "typeVersion": 2
    },
    {
      "id": "644bb6d9-e533-4398-94a4-c142d96dbb12",
      "name": "Parse Scraped Listings",
      "type": "n8n-nodes-base.code",
      "position": [
        1424,
        160
      ],
      "parameters": {
        "jsCode": "const html = $input.item.json;\n\nconst match = html.match(\n  /<script type=\"application\\/ld\\+json\">\\s*(\\{\"@context\":\"https:\\/\\/schema\\.org\",\"@type\":\"ItemList\"[^<]+)\\s*<\\/script>/\n);\n\nif (!match) {\n  return [{ json: { error: \"No listings found\" } }];\n}\n\nconst schema = JSON.parse(match[1]);\n\nconst listings = schema.itemListElement.map(item => {\n  const home = item.item;\n  const offer = home.offers;\n  return {\n    address: home.name,\n    url:     home.url,\n    price:   offer.price,\n    beds:    offer.itemOffered?.numberOfBedrooms ?? null,\n    sqft:    offer.itemOffered?.floorSize?.value ?? null,\n    city:    offer.itemOffered?.address?.addressLocality ?? null,\n    state:   offer.itemOffered?.address?.addressRegion ?? null,\n    zip:     offer.itemOffered?.address?.postalCode ?? null,\n    scraped_at: new Date().toISOString(),\n  };\n});\n\nreturn listings.map(l => ({ json: l }));\n"
      },
      "typeVersion": 2
    },
