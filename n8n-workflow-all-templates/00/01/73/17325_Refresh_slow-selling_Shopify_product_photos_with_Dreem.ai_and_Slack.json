    {
      "id": "55bfa2b1-4d9c-47b9-bd0d-fa2d2435ab5d",
      "name": "When Monthly at 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        576,
        416
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 1 * *"
