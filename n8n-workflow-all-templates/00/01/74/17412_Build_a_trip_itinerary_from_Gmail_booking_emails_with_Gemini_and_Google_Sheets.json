        208
      ],
      "parameters": {
        "options": {
          "temperature": 0.1
        },
        "modelName": "models/gemini-3.1-flash-lite"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "SqSj0UBxvATZV3OU",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
