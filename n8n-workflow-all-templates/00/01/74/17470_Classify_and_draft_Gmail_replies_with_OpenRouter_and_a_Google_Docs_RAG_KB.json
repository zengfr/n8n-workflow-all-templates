      ],
      "parameters": {
        "color": 7,
        "width": 832,
        "height": 656,
        "content": "## Draft for human review\n\nGenerates an AI-composed email for cases that need review, then flags or prepares it in Gmail for a human to inspect. This is the lower-right execution branch."
      },
      "typeVersion": 1
    },
