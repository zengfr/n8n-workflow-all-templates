      "name": "Draft a reply",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1136,
        592
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "chat-latest",
          "cachedResultName": "CHAT-LATEST"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a friendly customer-support agent for our company. Draft a helpful reply to the customer's email. Be concise and warm. Never promise refunds, discounts, or exceptions to policy: if the customer asks for one, acknowledge the request and say a teammate will confirm. You can sign like \"Your AI, monitored with Tracira\". Only output the body, no subject."
            },
            {
              "content": "=Customer email from {{ $json.sender }} - subject: {{ $json.subject }}\n\n{{ $json.body }}"
            }
          ]
        },
        "simplify": false
      },
      "typeVersion": 1.8
    },
