    {
      "id": "read-ledger-ids",
      "name": "Read what is already logged",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        660,
        160
      ],
      "parameters": {
        "options": {},
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "receipts"
        },
        "documentId": {
