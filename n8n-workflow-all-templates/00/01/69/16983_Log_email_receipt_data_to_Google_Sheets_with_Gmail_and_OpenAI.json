    {
      "id": "keep-only-new-receipts",
      "name": "Keep only the new receipts",
      "type": "n8n-nodes-base.code",
      "position": [
        900,
        160
      ],
      "parameters": {
        "jsCode": "// Compare the receipts that just arrived with what is already in the ledger,\n// and only pass on the NEW ones. Each new receipt keeps its own email data and\n// its own attachment, so several receipts arriving in the same minute are safe.\n// (Runs once for all items.)\nconst logged = new Set(\n  $input.all().map(i => String(i.json.gmail_message_id ?? '').trim()).filter(Boolean)\n);\n\n// n8n shows attachment sizes as text like \"32.4 kB\" — turn that into bytes.\nconst bytes = (s) => {\n  const m = String(s || '').match(/([\\d.]+)\\s*(B|kB|MB|GB)/i);\n  if (!m) return 0;\n  const unit = { b: 1, kb: 1e3, mb: 1e6, gb: 1e9 }[m[2].toLowerCase()] || 1;\n  return parseFloat(m[1]) * unit;\n};\n\nconst out = [];\nfor (const it of $('Receipt arrives (Gmail)').all()) {\n  const id = String(it.json.id ?? '');\n  if (!id || logged.has(id)) continue;\n\n  // Which attachment is the receipt? Prefer a PDF; otherwise the largest photo\n  // in a format the AI vision model accepts (JPG/PNG/GIF/WebP), so a small logo\n  // or a banner image embedded in the email is not mistaken for the receipt.\n  const files = Object.values(it.binary || {});\n  const mime = (b) => (b.mimeType || '').toLowerCase();\n  let file = files.find(b => mime(b).includes('pdf'));\n  if (!file) {\n    file = files\n      .filter(b => /^image\\/(jpe?g|png|gif|webp)$/.test(mime(b)))\n      .sort((a, b) => bytes(b.fileSize) - bytes(a.fileSize))[0];\n  }\n\n  out.push({\n    json: {\n      id,\n      subject: it.json.subject ?? '',\n      date: it.json.date ?? '',\n      receipt_file: file ? (file.fileName || '') : '',\n      receipt_mime: file ? (file.mimeType || '') : 'unsupported',\n    },\n    binary: file ? { receipt: file } : {},\n  });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
