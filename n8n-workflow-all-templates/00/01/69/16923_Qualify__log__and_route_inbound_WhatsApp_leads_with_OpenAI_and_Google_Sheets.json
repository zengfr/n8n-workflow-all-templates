      "parameters": {
        "path": "whatsapp-lead-intake",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "a8a67067-41ba-45fe-ba09-f2ab781d2f03",
      "name": "Extract Message",
      "type": "n8n-nodes-base.set",
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "message",
              "type": "string",
              "value": "={{ $json.body?.message || $json.body?.text || $json.message }}"
            },
            {
              "id": "a2",
              "name": "phone",
              "type": "string",
              "value": "={{ $json.body?.from || $json.body?.phone }}"
            },
            {
              "id": "a3",
              "name": "name",
              "type": "string",
              "value": "={{ $json.body?.name || $json.body?.profile_name || \"\" }}"
            }
          ]
        },
        "includeOtherFields": false
      },
      "typeVersion": 3.4
    },
    {
      "id": "b26329cd-bc1f-41ef-87db-0529776730dd",
      "name": "Classify Lead",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        544,
        0
      ],
      "parameters": {
        "text": "=Lead message: \"{{ $json.message }}\" from \"{{ $json.name }}\".",
        "options": {
          "systemMessage": "You classify inbound WhatsApp messages for a B2B automation agency. The segment field must be exactly one of: buyer, job_seeker, spam. Also return a short intent_summary, a confidence between 0 and 1, and a one-line reasoning. Be strict and consistent."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
      "id": "bfe4f7f8-cb46-4252-8e40-e8105981a4f3",
      "name": "OpenAI Chat Model",
