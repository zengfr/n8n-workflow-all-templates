      "position": [
        784,
        272
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"segment\": \"buyer\", \"intent_summary\": \"Wants a WhatsApp bot for their store\", \"confidence\": 0.9, \"reasoning\": \"Asked about pricing and features\" }"
      },
      "typeVersion": 1.3
    },
    {
