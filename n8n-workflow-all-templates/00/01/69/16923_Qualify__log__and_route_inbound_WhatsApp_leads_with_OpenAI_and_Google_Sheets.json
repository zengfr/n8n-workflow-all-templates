            },
            {
              "id": "f3",
              "name": "Message",
              "type": "string",
              "value": "={{ $('Extract Message').item.json.message }}"
            },
            {
              "id": "f4",
              "name": "Segment",
              "type": "string",
              "value": "={{ $json.output.segment }}"
            },
            {
              "id": "f5",
              "name": "Intent",
              "type": "string",
              "value": "={{ $json.output.intent_summary }}"
            },
            {
              "id": "f6",
              "name": "Confidence",
              "type": "number",
              "value": "={{ $json.output.confidence }}"
            },
            {
              "id": "f7",
              "name": "Reasoning",
              "type": "string",
              "value": "={{ $json.output.reasoning }}"
            },
            {
              "id": "f8",
              "name": "ReceivedAt",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "f9",
              "name": "NeedsReview",
              "type": "string",
              "value": "={{ $json.output.confidence < 0.6 ? \"yes\" : \"no\" }}"
            }
          ]
        },
        "includeOtherFields": false
      },
      "typeVersion": 3.4
    },
