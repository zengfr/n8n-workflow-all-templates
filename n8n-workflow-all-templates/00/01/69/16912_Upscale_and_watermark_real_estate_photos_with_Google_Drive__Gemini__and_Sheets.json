    {
      "id": "cc004af2-f74e-42ca-b758-0e87b1446760",
      "name": "Calculate Watermark Position",
      "type": "n8n-nodes-base.code",
      "position": [
        2912,
        -96
      ],
      "parameters": {
        "jsCode": "// Reads binary dimensions of base image + logo, computes bottom-right watermark position\n\nfunction getImageSize(buffer) {\n  // PNG\n  if (buffer[0] === 0x89 && buffer[1] === 0x50 && buffer[2] === 0x4E && buffer[3] === 0x47) {\n    return {\n      width: buffer.readUInt32BE(16),\n      height: buffer.readUInt32BE(20),\n      format: 'png'\n    };\n  }\n\n  // JPEG\n  if (buffer[0] === 0xFF && buffer[1] === 0xD8) {\n    let offset = 2;\n    while (offset < buffer.length) {\n      if (buffer[offset] !== 0xFF) break;\n      const marker = buffer[offset + 1];\n      if (marker >= 0xC0 && marker <= 0xC3) {\n        return {\n          height: buffer.readUInt16BE(offset + 5),\n          width: buffer.readUInt16BE(offset + 7),\n          format: 'jpeg'\n        };\n      }\n      const segmentLength = buffer.readUInt16BE(offset + 2);\n      offset += 2 + segmentLength;\n    }\n  }\n\n  throw new Error('Unsupported image format or could not parse dimensions');\n}\n\nconst items = $input.all();\nconst itemIndex = 0;\nconst item = items[itemIndex];\n\nif (!item.binary || !item.binary.data) throw new Error('Missing \"data\" binary (base image)');\nif (!item.binary.logo) throw new Error('Missing \"logo\" binary (watermark) - did you rename HTTP Request1 output field to \"logo\"?');\n\n// Use n8n's binary helper so this works regardless of binaryDataMode (default/filesystem/database)\nconst baseBuffer = await this.helpers.getBinaryDataBuffer(itemIndex, 'data');\nconst logoBuffer = await this.helpers.getBinaryDataBuffer(itemIndex, 'logo');\n\nconst baseSize = getImageSize(baseBuffer);\nconst logoSize = getImageSize(logoBuffer);\n\n// Watermark target width = 15% of base image width, scaled proportionally\nconst watermarkScale = 0.15;\nconst targetLogoWidth = Math.round(baseSize.width * watermarkScale);\nconst scaleFactor = targetLogoWidth / logoSize.width;\nconst targetLogoHeight = Math.round(logoSize.height * scaleFactor);\n\n// Padding from edges (in px), scaled with image size\nconst padding = Math.round(baseSize.width * 0.02);\n\nconst positionX = baseSize.width - targetLogoWidth - padding;\nconst positionY = baseSize.height - targetLogoHeight - padding;\n\nreturn [{\n  json: {\n    baseWidth: baseSize.width,\n    baseHeight: baseSize.height,\n    logoOriginalWidth: logoSize.width,\n    logoOriginalHeight: logoSize.height,\n    logoResizeWidth: targetLogoWidth,\n    logoResizeHeight: targetLogoHeight,\n    positionX,\n    positionY,\n    padding\n  },\n  binary: item.binary\n}];"
      },
      "typeVersion": 2
    },
