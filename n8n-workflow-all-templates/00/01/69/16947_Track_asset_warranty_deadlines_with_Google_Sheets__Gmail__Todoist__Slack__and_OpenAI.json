    {
      "id": "fd69bf11-9571-4394-9c1a-0ad6aaf2ecd3",
      "name": "Compute Days Left",
      "type": "n8n-nodes-base.code",
      "position": [
        704,
        608
      ],
      "parameters": {
        "jsCode": "// Expiry date = purchase_date + warranty_months; compute days left for each asset\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nreturn $input.all()\n  .map(item => {\n    const row = item.json;\n    const purchase = new Date(row.purchase_date);\n    const months = Number(row.warranty_months) || 0;\n    const expiry = new Date(purchase);\n    expiry.setMonth(expiry.getMonth() + months);\n    const daysLeft = Math.floor((expiry - today) / 864e5);\n\n    return {\n      json: {\n        ...row,\n        value: Number(row.value) || 0,\n        expiryDate: expiry.toISOString().slice(0, 10),\n        daysLeft: isNaN(daysLeft) ? null : daysLeft\n      }\n    };\n  })\n  .filter(item => item.json.daysLeft !== null && item.json.status !== 'warranty expired');"
      },
      "typeVersion": 2
    },
    {
      "id": "08b53c61-6a6b-4f3a-8a88-fa0df72104f5",
      "name": "Route By Urgency",
      "type": "n8n-nodes-base.switch",
      "position": [
        992,
        592
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Expired",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "sw-1",
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    },
                    "leftValue": "={{ $json.daysLeft }}",
                    "rightValue": 0
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "7 Days",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "sw-2",
                    "operator": {
                      "type": "number",
                      "operation": "lte"
                    },
                    "leftValue": "={{ $json.daysLeft }}",
                    "rightValue": 7
                  }
                ]
              },
              "renameOutput": true
            },
            {
