      "parameters": {
        "color": 7,
        "width": 480,
        "height": 368,
        "content": "## Save and notify user\n\nHandles the non-duplicate path by appending the new registration to Google Sheets and sending a confirmation email through Gmail."
      },
      "typeVersion": 1
