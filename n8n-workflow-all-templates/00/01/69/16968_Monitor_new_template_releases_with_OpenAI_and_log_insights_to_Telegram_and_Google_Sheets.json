    {
      "id": "b94f5e9d-f110-477c-849a-49245a909c4e",
      "name": "Build Telegram digest",
      "type": "n8n-nodes-base.code",
      "position": [
        2192,
        304
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst cfg = $('Configuration').first().json;\nconst cat = cfg.template_category;\nconst plural = rows.length > 1 ? 's' : '';\nconst header = '🆕 ' + rows.length + ' new \"' + cat + '\" template' + plural + ' on n8n.io';\nconst blocks = rows.map(r => {\n  let imp = (r.ai_improvements || '').trim();\n  if (imp.length > 600) imp = imp.slice(0, 600) + '…';\n  return '• ' + r.template_name + '\\nby ' + r.author + '  |  ' + r.template_url + '\\n\\nImprovements for businesses:\\n' + imp;\n});\nlet message = header + '\\n\\n' + blocks.join('\\n\\n-----\\n\\n');\nif (message.length > 3900) message = message.slice(0, 3900) + '\\n\\n… (truncated)';\nreturn [{ json: { message } }];"
      },
      "typeVersion": 2
    },
