      "position": [
        1152,
        32
      ],
      "parameters": {
        "color": 7,
        "width": 704,
        "height": 576,
        "content": "## Validate and handle errors\n\nThis mid-canvas branch checks whether the cleaned CNPJ is valid and, on failure, sends the user through a nearby pair of form nodes for an error or retry response."
      },
      "typeVersion": 1
    },
    {
