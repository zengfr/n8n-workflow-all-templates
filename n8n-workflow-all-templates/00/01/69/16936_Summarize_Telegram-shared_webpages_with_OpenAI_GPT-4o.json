      "name": "Extract Page Content",
      "type": "n8n-nodes-base.html",
      "onError": "continueErrorOutput",
      "position": [
        1120,
        112
      ],
      "parameters": {
        "options": {
          "trimValues": true,
          "cleanUpText": true
        },
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "page_title",
              "cssSelector": "title"
