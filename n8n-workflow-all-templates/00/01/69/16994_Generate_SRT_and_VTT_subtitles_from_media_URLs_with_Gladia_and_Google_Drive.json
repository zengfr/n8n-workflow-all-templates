      ],
      "parameters": {
        "color": 7,
        "width": 676,
        "height": 428,
        "content": "## Poll until subtitles are ready\n\nWait, fetch the result, and route by status until Gladia returns done or the attempt limit is reached."
      },
      "typeVersion": 1
    },
    {
