      "webhookId": "191a3031-b079-42f2-9268-a7dc6c281e76",
      "parameters": {
        "text": "=🚨 *Critical client email while I'm OOO* — need your eyes, <@{{ $('Set Configuration Fields').item.json.backupSlackUserId }}>\n\n*From:* {{ $('Prepare Email Data').item.json.fromEmail }}\n*Subject:* {{ $('Prepare Email Data').item.json.subject }}\n*Category:* {{ $json.category }}\n*Why it's urgent:* {{ $json.urgencyReason }}\n\n*Summary:* {{ $json.slackSummary }}\n\nBack {{ $('Set Configuration Fields').item.json.oooReturnDate }}. Reply to the client directly on this thread.",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Set Configuration Fields').item.json.slackChannelId }}"
        },
        "otherOptions": {}
