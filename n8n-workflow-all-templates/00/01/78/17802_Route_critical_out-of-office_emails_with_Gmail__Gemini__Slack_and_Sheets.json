    {
      "id": "8b1b9af7-042f-44a1-b883-4bc0acdb35af",
      "name": "Post to Gemini API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1184,
        304
      ],
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: `You are an inbox triage assistant for ${$('Set Configuration Fields').item.json.companyName}, a product company (product: ${$('Set Configuration Fields').item.json.productName}). The account owner is on vacation. Decide if this incoming email is CRITICAL (needs a human backup during vacation) or NOT CRITICAL (can wait).\n\nMark CRITICAL only for: production/service outage, app completely down, security or data breach, payment/billing failure blocking a customer, a contract or renewal deadline expiring within days, a VIP or high-value client threatening to churn or escalating angrily.\n\nMark NOT CRITICAL for: general questions, feature requests, feedback, sales/marketing emails, newsletters, anything with no real time pressure.\n\nEmail from: ${$json.fromEmail}\nSubject: ${$json.subject}\nBody: ${$json.bodyText}\n\nRespond ONLY with JSON in this exact shape, no markdown, no preamble:\n{\"isCritical\": boolean, \"category\": string, \"urgencyReason\": string, \"slackSummary\": string}` }] }], generationConfig: { responseMimeType: 'application/json' } }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "nodeCredentialType": "googlePalmApi"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "credential-id",
          "name": "vaar@blankarray"
        },
        "httpHeaderAuth": {
          "id": "credential-id",
          "name": "CoinGecko"
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "9b71b1bc-f3d0-4f10-8e42-069f28180400",
      "name": "Build Urgency Data",
      "type": "n8n-nodes-base.set",
      "position": [
        1408,
        304
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "isCritical",
              "type": "boolean",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).isCritical }}"
            },
            {
              "name": "category",
              "type": "string",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).category }}"
            },
            {
              "name": "urgencyReason",
              "type": "string",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).urgencyReason }}"
            },
            {
              "name": "slackSummary",
              "type": "string",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).slackSummary }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
