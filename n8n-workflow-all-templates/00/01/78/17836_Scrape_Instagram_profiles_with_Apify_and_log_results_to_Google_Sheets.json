              "type": "number",
              "value": 3
            },
            {
              "id": "cfg-followers",
              "name": "min_followers_highlight",
              "type": "number",
              "value": 10000
            },
            {
              "id": "cfg-usernames",
              "name": "usernames_list",
              "type": "array",
              "value": "={{ $json.Usernames.split(/[\\n,]+/).map(u => u.trim().replace(\"@\", \"\")).filter(u => u.length > 0) }}"
