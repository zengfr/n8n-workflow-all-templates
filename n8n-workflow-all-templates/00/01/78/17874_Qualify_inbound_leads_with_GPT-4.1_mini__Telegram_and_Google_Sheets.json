  \"WhatsApp\"\n      ]\n    },\n    \"next_action\": {\n      \"type\": \"string\"\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"company_name\",\n    \"industry\",\n    \"company_summary\",\n    \"products\",\n    \"services\",\n    \"company_size\",\n    \"lead_score\",\n    \"lead_priority\",\n    \"buying_intent\",\n    \"lead_temperature\",\n    \"pain_points\",\n    \"opportunities\",\n    \"email_subject\",\n    \"email_body\",\n    \"whatsapp_message\",\n    \"linkedin_message\",\n    \"call_script\",\n    \"recommended_followup\",\n    \"recommended_channel\",\n    \"next_action\",\n    \"reason\"\n  ]\n}"
      },
      "typeVersion": 1.3
    },
