        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"name\": \"Beginner Batch\",\n  \"template_id\": 5,\n  \"title\": \"Certificate of Excellence\",\n  \"description\": \"Awarded for outstanding performance.\",\n  \"signatory\": \"Dr. Sarah Johnson\",\n  \"signatory_title\": \"Director of Education\",\n  \"format\": \"png\",\n  \"send_emails\": false,\n  \"recipients\": {{ JSON.stringify($('Read Rows from Sheet1').all().map(item => ({ name: item.json.recipients, email: item.json.emails }))) }}\n}",
        "sendBody": true,
