      "parameters": {
        "color": 7,
        "width": 480,
        "height": 464,
        "content": "## Fetch completed results\n\nRetrieves the completed batch results from Bulkcertify and downloads the consolidated ZIP archive from the returned download URL."
      },
      "typeVersion": 1
    },
    {
      "id": "463cb972-0986-4fe5-998f-12b017d5beab",
