      "position": [
        1008,
        -512
      ],
      "parameters": {
        "color": 7,
        "width": 496,
        "height": 320,
        "content": "## Manual sheet input\n\nStarts the workflow manually and reads recipient rows from the configured Google Sheet to prepare the data for certificate generation."
      },
      "typeVersion": 1
    },
    {
      "id": "571641d9-3fe4-4005-9ec3-83133c7dfce9",
