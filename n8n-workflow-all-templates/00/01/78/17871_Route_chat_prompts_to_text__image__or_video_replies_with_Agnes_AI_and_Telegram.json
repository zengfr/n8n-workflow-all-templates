      ],
      "parameters": {
        "url": "https://apihub.agnes-ai.com/v1/videos",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n    \"model\": \"agnes-video-v2.0\",\n    \"prompt\": \"{{ $json.chatInput }}\"\n}",
        "sendBody": true,
