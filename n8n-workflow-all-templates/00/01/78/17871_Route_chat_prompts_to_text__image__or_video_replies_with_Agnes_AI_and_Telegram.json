        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "credential-id",
          "name": "Bearer Auth Agnes Ai"
        }
      },
      "typeVersion": 4.4
    },
