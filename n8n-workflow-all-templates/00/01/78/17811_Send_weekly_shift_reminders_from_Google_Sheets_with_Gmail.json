          }
        ]
      ]
    },
    "Every Monday 07:00": {
      "main": [
        [
          {
            "node": "Configure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Row Update": {
      "main": [
        [
          {
            "node": "Update Notification Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Schedule Sheet": {
      "main": [
        [
          {
            "node": "Capture Row Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Confirmed & Unnotified": {
