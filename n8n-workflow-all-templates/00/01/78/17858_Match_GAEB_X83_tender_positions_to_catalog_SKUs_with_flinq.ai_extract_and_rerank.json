      "typeVersion": 1
    },
    {
      "id": "a1b2c3d4e5f60004",
      "name": "Build catalog texts",
      "type": "n8n-nodes-base.code",
      "position": [
        688,
        60
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nreturn [{ json: {\n  texts: items.map(c => `${c.name}. ${c.description}`),\n  skus: items.map(c => c.sku),\n}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "a1b2c3d4e5f60005",
      "name": "Download GAEB tender",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1008,
        60
      ],
      "parameters": {
        "url": "https://flinq.ai/docs/samples/sample-lv.x83",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "flinq-example/1.0"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "a1b2c3d4e5f60006",
      "name": "Extract tender positions",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1200,
        60
      ],
      "parameters": {
        "url": "https://api.flinq.ai/v1/extract",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "multipart-form-data",
        "authentication": "genericCredentialType",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            }
          ]
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "flinqheaderauth1",
          "name": "flinq API"
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "a1b2c3d4e5f60007",
      "name": "Flatten positions",
      "type": "n8n-nodes-base.code",
      "position": [
        1392,
        60
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const positions = [];\nfunction walk(nodes) {\n  for (const node of nodes) {\n    if (node.type === 'item') {\n      let text = node.short_text;\n      if (node.long_text) text += '. ' + node.long_text;\n      positions.push({ rno: node.rno, qty: node.qty, unit: node.unit, text });\n    } else if (node.type === 'group') {\n      walk(node.children);\n    }\n  }\n}\nwalk($input.first().json.tree);\nreturn positions.map(p => ({ json: p }));"
      },
      "typeVersion": 2
    },
    {
      "id": "a1b2c3d4e5f60008",
      "name": "Match position to catalog",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        1712,
        60
      ],
      "parameters": {
        "url": "https://api.flinq.ai/v1/rerank",
        "method": "POST",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2000
            }
          }
        },
        "jsonBody": "={{ JSON.stringify({ model: \"flinq-pilot-otter\", query: $json.text, documents: $('Build catalog texts').first().json.texts, top_k: 3 }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "flinqheaderauth1",
          "name": "flinq API"
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 4000
    },
    {
      "id": "a1b2c3d4e5f60009",
      "name": "Pick best match",
      "type": "n8n-nodes-base.code",
      "position": [
        1904,
        60
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const pos = $('Flatten positions').item.json;\nconst cat = $('Build catalog texts').first().json;\nconst best = $json.data[0];\nreturn { json: {\n  rno: pos.rno,\n  qty: `${pos.qty} ${pos.unit}`,\n  position: pos.text,\n  sku: cat.skus[best.index],\n  score: Number(best.relevance_score.toFixed(2)),\n}};"
      },
      "typeVersion": 2
    }
  ],
