    {
      "id": "2ffcd1ab-d0f3-48bd-a1da-a63d8e5af2a1",
      "name": "Build FAQ Context",
      "type": "n8n-nodes-base.code",
      "position": [
        480,
        48
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(function (i) { return i.json; });\nconst faq = rows.map(function (r, idx) { const q = r.Question || r.question || ''; const a = r.Answer || r.answer || ''; return (idx + 1) + '. Q: ' + q + '\\n   A: ' + a; }).join('\\n');\nconst q = $('Customer Question').first().json.chatInput || '';\nreturn [{ json: { question: q, sessionId: $('Customer Question').first().json.sessionId, faq: faq } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "dc0093d9-92be-4ff4-b91b-a09fe646ac26",
      "name": "Answer from FAQ with Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        704,
        48
      ],
      "parameters": {
        "text": "=You are a support assistant. Answer the customer question using ONLY the FAQ below. If the answer is not clearly covered by the FAQ, reply exactly: \"I am not sure about that - I will pass this to our support team.\" Do not invent anything. Start your reply with \"ANSWERED:\" if you found the answer in the FAQ, or \"UNANSWERED:\" if you did not.\n\nFAQ:\n{{ $json.faq }}\n\nQuestion: {{ $json.question }}",
        "batching": {},
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
    {
      "id": "13c45ffb-6539-4edf-9a6c-4e2d8dcaa00a",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
        704,
        224
      ],
      "parameters": {
        "options": {
          "temperature": 0.1
        },
        "modelName": "models/gemini-3.1-flash-lite"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "SqSj0UBxvATZV3OU",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "b6c7fa1b-7de4-4ad8-82df-5d58f4d81575",
      "name": "Shape Reply",
      "type": "n8n-nodes-base.code",
      "position": [
        1008,
        48
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = String($json.text || '');\nconst answered = /^\\s*ANSWERED:/i.test(raw);\nconst clean = raw.replace(/^\\s*(ANSWERED|UNANSWERED):\\s*/i, '').trim();\nreturn { reply: clean || 'I am not sure about that - I will pass this to our support team.', answered: answered, question: $('Build FAQ Context').item.json.question, sessionId: $('Build FAQ Context').item.json.sessionId };"
      },
      "typeVersion": 2
    },
    {
