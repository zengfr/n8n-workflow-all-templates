        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"tweets\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"linkedin_post\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"tweets\",\n    \"linkedin_post\"\n  ]\n}"
