      ],
      "parameters": {
        "color": 7,
        "width": 1188,
        "height": 660,
        "content": "## 📅 Logging, Calendar & Notifications\nSends the checklist to the client, appends a new case row to Google Sheets, creates a consultation slot in Google Calendar, and fires two parallel Telegram messages — one to the lawyer with intake details and one to the client with their booking confirmation."
      },
      "typeVersion": 1
    },
    {
      "id": "c485202e-d335-4e7f-8cd4-22c0bd04d678",
      "name": "Section – Daily Fee Reminders",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
