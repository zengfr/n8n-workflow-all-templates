    {
      "id": "9f56cec2-3d7f-4e12-81ff-1a71d9479ee8",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueErrorOutput",
      "position": [
        480,
        48
      ],
      "parameters": {
        "url": "={{ $json.url }}",
