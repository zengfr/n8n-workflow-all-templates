      "parameters": {
        "color": 7,
        "width": 464,
        "height": 524,
        "content": "## 2. Human approval in Slack\nThe draft is posted to Slack with Send it / Discard buttons. The workflow pauses until someone clicks."
      },
      "typeVersion": 1
    },
    {
      "id": "c12d360c-55cf-448a-aa15-e0588de35c81",
