    {
      "id": "e01d847d-9afe-4e69-9e1d-728cc8436b68",
      "name": "Build task data",
      "type": "n8n-nodes-base.code",
      "position": [
        1600,
        736
      ],
      "parameters": {
        "jsCode": "const b = $('Webhook Placetel AI').first().json.body || {};\nconst j = $input.first().json || {};\nconst p = j.properties || {};\nconst contactId = b.contact_id || j.id || '';\nconst name = b.name || [b.first_name,b.last_name].filter(Boolean).join(' ')\n  || [p.firstname,p.lastname].filter(Boolean).join(' ') || 'Unbekannt';\nconst phone = b.phone || b.caller_number || p.phone || '';\nconst reason = b.reason || b.anliegen || 'Rueckruf gewuenscht';\nconst preferred = b.preferred_time || b.wunschzeit || '';\nreturn [{ json: {\n  contactId: contactId ? String(contactId) : '',\n  taskSubject: `Rueckruf: ${name} (${phone})`,\n  taskBody: `Rueckrufwunsch ueber Placetel AI.\\nName: ${name}\\nTelefon: ${phone}\\nAnliegen: ${reason}\\nWunschzeit: ${preferred || 'keine Angabe'}`\n} }];\n"
      },
      "typeVersion": 2
    },
