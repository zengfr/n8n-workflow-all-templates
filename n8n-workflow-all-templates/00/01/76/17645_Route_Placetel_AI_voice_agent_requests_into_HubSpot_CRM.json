      "name": "Build response (unknown)",
      "type": "n8n-nodes-base.code",
      "position": [
        1344,
        2192
      ],
      "parameters": {
        "jsCode": "const operation = ($json.query && $json.query.operation) || ($json.body && $json.body.operation) || '(none)';\nreturn [{ json: { success:false, error:'unknown_operation', received_operation: operation,\n  speech: 'Entschuldigung, dieses Anliegen kann ich nicht zuordnen. Ich verbinde Sie mit einem Mitarbeiter.' } }];\n"
