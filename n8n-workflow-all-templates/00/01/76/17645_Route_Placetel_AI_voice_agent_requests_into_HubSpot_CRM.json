      "type": "n8n-nodes-base.code",
      "position": [
        1584,
        1776
      ],
      "parameters": {
        "jsCode": "const b = $('Webhook Placetel AI').first().json.body || {};\nconst j = $input.first().json || {};\nconst contactId = b.contact_id || j.id || '';\nconst teile = [];\nteile.push('Anruf ueber Placetel AI Voice Agent');\nif (b.intent) teile.push(`Anliegen/Intent: ${b.intent}`);\nif (b.outcome) teile.push(`Ergebnis: ${b.outcome}`);\nif (b.summary) teile.push(`Zusammenfassung: ${b.summary}`);\nif (b.transcript) teile.push(`\\nTranskript:\\n${b.transcript}`);\nreturn [{ json: { contactId: contactId ? String(contactId) : '', callBody: teile.join('\\n'),\n  fromNumber: b.phone || b.caller_number || '', recordingUrl: b.recording_url || '' } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "2a86a75f-e92e-45ba-a23c-9c586c5e9d84",
      "name": "HubSpot: Log call",
      "type": "n8n-nodes-base.hubspot",
      "onError": "continueRegularOutput",
      "position": [
        1824,
        1776
      ],
      "parameters": {
        "type": "call",
        "metadata": {
          "body": "={{ $json.callBody }}",
          "status": "COMPLETED",
          "fromNumber": "={{ $json.fromNumber }}",
          "recordingUrl": "={{ $json.recordingUrl }}"
        },
        "resource": "engagement",
        "authentication": "oAuth2",
        "additionalFields": {
          "associations": {
            "contactIds": "={{ $json.contactId }}"
          }
        }
      },
      "typeVersion": 2
    },
    {
      "id": "9b29d8d1-ce2b-460a-b4d4-53317731befc",
      "name": "Build response (call note)",
      "type": "n8n-nodes-base.code",
      "position": [
        2064,
        1776
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json || {};\nconst id = (r.engagement && r.engagement.id) || r.id || null;\nreturn [{ json: { success: !!id, note_id: id?String(id):null } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "8ccdc83e-54c1-4cf2-9244-c103919a6983",
