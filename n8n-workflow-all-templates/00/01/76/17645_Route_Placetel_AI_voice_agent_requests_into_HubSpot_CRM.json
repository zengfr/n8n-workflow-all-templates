      "position": [
        1600,
        1088
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json || {};\nconst props = r.properties || {};\nconst pv = (k) => { const v = props[k]; return (v && typeof v === 'object' && 'value' in v) ? v.value : v; };\nconst stageMap = { '1':'Neu','2':'Warten auf Kontakt','3':'Warten auf uns','4':'Geschlossen' };\nconst id = r.objectId || r.id || pv('hs_object_id') || null;\nconst subject = pv('subject') || '';\nif (!(id || subject)) return [{ json: { found:false, speech:'Zu dieser Ticketnummer konnte ich nichts finden. Bitte pruefen Sie die Nummer.' } }];\nconst stageRaw = pv('hs_pipeline_stage');\nconst status = stageMap[stageRaw] || stageRaw || 'unbekannt';\nreturn [{ json: { found:true, ticket_id: id?String(id):null, subject, status, priority: pv('hs_ticket_priority') || '',\n  speech: `Ihr Ticket ${subject ? '\"' + subject + '\" ' : ''}hat den Status: ${status}.` } }];\n"
      },
      "typeVersion": 2
