    {
      "id": "5ed86b38-ff87-46e9-9d50-02b6fbf0e828",
      "name": "Build response (existing customer)",
      "type": "n8n-nodes-base.code",
      "position": [
        1616,
        -224
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nif (j.id) {\n  const p = j.properties || {};\n  const vorname = p.firstname || '';\n  const name = [p.firstname, p.lastname].filter(Boolean).join(' ').trim();\n  return [{ json: {\n    is_customer: true, found: true, contact_id: String(j.id),\n    first_name: vorname, last_name: p.lastname || '', full_name: name,\n    email: p.email || '', company: p.company || '', lifecyclestage: p.lifecyclestage || '',\n    speech: vorname\n      ? `Willkommen zurueck, ${vorname}! Ich habe Sie als Bestandskunde gefunden. Wie kann ich Ihnen helfen?`\n      : `Ich habe Sie als Bestandskunde in unserem System gefunden. Wie kann ich Ihnen helfen?`\n  } }];\n}\nreturn [{ json: { is_customer:false, found:false, contact_id:null,\n  speech: 'Ich konnte Sie nicht als Bestandskunde finden. Soll ich Sie gern neu als Kontakt aufnehmen?' } }];\n"
      },
      "typeVersion": 2
    },
