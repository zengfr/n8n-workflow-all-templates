    {
      "id": "a00bb2bf-72a9-43b2-8a52-6bb109b4d9e6",
      "name": "Calculate Utilization",
      "type": "n8n-nodes-base.code",
      "position": [
        -2160,
        -240
      ],
      "parameters": {
        "jsCode": "const result = {};\n\nfor (const item of items) {\n  const contractId = item.json.contract_id;\n  const contractValue = Number(item.json.total_value || 0);\n  const spend = Number(item.json.amount || 0);\n\n  if (!result[contractId]) {\n    result[contractId] = {\n      contractId,\n      totalValue: contractValue,\n      totalSpend: 0\n    };\n  }\n\n  result[contractId].totalSpend += spend;\n}\n\n// Calculate utilization\nreturn Object.values(result).map(r => {\n  return {\n    json: {\n      ...r,\n     utilization: r.totalValue ? Number((r.totalSpend / r.totalValue).toFixed(2)) : 0\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "2d54226b-b431-4e04-a9d3-c84db85d249a",
