    {
      "id": "ca3b8173-535e-4af9-bd58-71caa2998617",
      "name": "Generate AI Insights",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        -1632,
        -480
      ],
      "parameters": {
        "text": "=Analyze contract utilization data and provide insights.\n\nContract ID: {{$json.contractId}}\nUtilization: {{$json.utilization}}\n\nGive:\n1. Contract ID\n2. Utilization\n3. Short insight (1 line)\n4. Risk level (Low/Medium/High)\n5. Recommended action\n\nIMPORTANT:\n- Always include Contract ID and Utilization in output\n- Keep exact format:\n\nContract ID: <id>\nUtilization: <value>\nInsight: <text>\nRisk Level: <level>\nRecommended Action: <text>\n\nKeep it concise and business-focused.",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "7c9ef351-cba9-42b1-b1b0-f9547fbc8d16",
      "name": "Extract AI Output (Risk & Action)",
      "type": "n8n-nodes-base.code",
      "position": [
        -1312,
        -480
      ],
      "parameters": {
        "jsCode": "return items.map(item => {\n  const text = item.json.output || \"\";\n\n  const idMatch = text.match(/Contract ID:\\s*(\\w+)/);\n  const utilMatch = text.match(/Utilization:\\s*([\\d.]+)/);\n\n  let utilization = utilMatch ? Number(utilMatch[1]) : 0;\n\n  let risk = \"Low\";\n  if (utilization < 0.4) risk = \"High\";\n  else if (utilization < 0.7) risk = \"Medium\";\n\n  // action from AI\n  let action = \"No action required\";\n  const actionMatch = text.match(/Recommended Action:\\s*([\\s\\S]*)/i);\n  if (actionMatch) action = actionMatch[1].trim();\n\n  return {\n    json: {\n      contractId: idMatch ? idMatch[1] : \"\",\n      utilization,\n      risk,\n      action\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
