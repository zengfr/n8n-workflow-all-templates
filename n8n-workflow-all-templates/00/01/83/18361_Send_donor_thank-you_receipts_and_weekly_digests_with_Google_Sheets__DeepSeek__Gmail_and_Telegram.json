        "jsCode": "const items = $input.all();\nconst rows = items.map(i => i.json).filter(r => !isNaN(Number(r.amount)));\nif (rows.length === 0) {\n  return [{ json: { total: 0, total_amount: 0, avg_amount: 0, new_donors: 0, top_campaign: '', lines: '' } }];\n}\nconst total = rows.length;\nconst sum = rows.reduce((acc, r) => acc + (Number(r.amount) || 0), 0);\nconst avg_amount = Math.round(sum / total);\nconst new_donors = rows.filter(r => String(r.tier || '') === 'new').length;\nconst byCamp = {};\nfor (const r of rows) { const c = String(r.campaign || 'General'); byCamp[c] = (byCamp[c] || 0) + 1; }\nlet top_campaign = '';\nlet topN = 0;\nfor (const c in byCamp) { if (byCamp[c] > topN) { topN = byCamp[c]; top_campaign = c; } }\nconst lines = rows.slice(-8).map(r => (r.donor_name || '') + ' | ' + (r.amount || '') + ' | ' + (r.campaign || '')).join('\\n');\nreturn [{ json: { total, total_amount: sum, avg_amount, new_donors, top_campaign, lines } }];"
      },
      "typeVersion": 2
    },
