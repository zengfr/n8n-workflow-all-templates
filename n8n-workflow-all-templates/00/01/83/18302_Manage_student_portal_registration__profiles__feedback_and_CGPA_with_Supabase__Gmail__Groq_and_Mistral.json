    {
      "id": "033ad6c8-0471-4f87-bd8f-78aa57fe4c9b",
      "name": "Validate & Format CGPA Response",
      "type": "n8n-nodes-base.code",
      "position": [
        736,
        2496
      ],
      "parameters": {
        "jsCode": "let result = $json;\n\n// If AI Agent returns JSON inside \"output\"\nif (result.output !== undefined) {\n  if (typeof result.output === \"string\") {\n    try {\n      result = JSON.parse(result.output);\n    } catch (error) {\n      throw new Error(\n        \"AI Agent output is not valid JSON: \" + result.output\n      );\n    }\n  } else {\n    result = result.output;\n  }\n}\n\n// Make sure CGPA is a number\nconst cgpa = Number(result.cgpa);\nconst totalCredits = Number(result.totalCredits);\nconst semestersUsed = Number(result.semestersUsed);\n\nif (!Number.isFinite(cgpa)) {\n  throw new Error(\n    \"Invalid CGPA received from AI Agent: \" + result.cgpa\n  );\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n      cgpa: cgpa,\n      totalCredits: Number.isFinite(totalCredits)\n        ? totalCredits\n        : 0,\n      semestersUsed: Number.isFinite(semestersUsed)\n        ? semestersUsed\n        : 0,\n      message: \"CGPA calculated successfully\"\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
