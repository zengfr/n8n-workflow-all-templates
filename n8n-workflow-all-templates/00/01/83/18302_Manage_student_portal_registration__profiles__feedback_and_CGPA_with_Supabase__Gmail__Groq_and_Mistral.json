    {
      "id": "54467a5c-d2c8-45c4-b127-33ffd17d9f92",
      "name": "Sticky Note9",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -2288,
        1280
      ],
      "parameters": {
        "width": 528,
        "height": 688,
        "content": "🎓 𝗦𝘁𝘂𝗱𝗲𝗻𝘁𝗟𝗼𝗴 - 𝗦𝘁𝘂𝗱𝗲𝗻𝘁 𝗣𝗼𝗿𝘁𝗮𝗹 𝗔𝘂𝘁𝗼𝗺𝗮𝘁𝗶𝗼𝗻 & 𝗔𝗜 𝗣𝗹𝗮𝘁𝗳𝗼𝗿𝗺\n\nThis project provides a centralized and automated student management platform that connects the frontend with an n8n-powered backend through a unified webhook. It manages multiple student services including registration, login authentication, profile updates, feedback submission, and CGPA calculation.\n\nStudent data is validated and securely stored in Supabase, while automation handles database operations and frontend responses. AI agents are used for intelligent tasks such as analyzing student feedback, generating personalized email responses, and assisting with academic calculations.\n\nThe system follows a modular and scalable architecture, where a Switch node identifies each request and routes it to the appropriate process. Automated email notifications and webhook responses provide immediate communication between the system and students.\n\n𝗞𝗲𝘆 𝗧𝗲𝗰𝗵𝗻𝗼𝗹𝗼𝗴𝗶𝗲𝘀:\n       • n8n\n       • React/Frontend\n       • Supabase\n       • AI Agents\n       • Groq/Mistral\n       • Gmail\n       • Webhooks\n       • Database Automation"
      },
      "typeVersion": 1
    }
