    {
      "id": "3ac80569-a4cb-4354-9d92-e9482ce5e5a1",
      "name": "Format Response Data",
      "type": "n8n-nodes-base.code",
      "position": [
        1072,
        3264
      ],
      "parameters": {
        "jsCode": "const input = $input.all();\n\nreturn input.map((item, index) => {\n  return {\n    json: {\n      itemNumber: index,\n      rawData: item.json\n    }\n  };\n});"
