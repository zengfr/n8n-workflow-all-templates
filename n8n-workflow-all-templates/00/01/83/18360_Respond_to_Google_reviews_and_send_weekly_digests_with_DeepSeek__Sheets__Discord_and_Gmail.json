    {
      "id": "104680ad-74c1-4e6d-b947-232e8e0bd0c6",
      "name": "Build Weekly Review Stats",
      "type": "n8n-nodes-base.code",
      "position": [
        3536,
        288
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rows = items.map(i => i.json).filter(r => !isNaN(Number(r.rating)));\nif (rows.length === 0) {\n  return [{ json: { total: 0, avg_rating: 0, positive_count: 0, negative_count: 0, top_business: '', lines: '' } }];\n}\nconst total = rows.length;\nconst sum = rows.reduce((acc, r) => acc + (Number(r.rating) || 0), 0);\nconst avg_rating = Math.round((sum / total) * 10) / 10;\nconst negative = rows.filter(r => (Number(r.rating) || 0) <= 2 || String(r.sentiment || '').toLowerCase() === 'negative').length;\nconst positive = rows.filter(r => (Number(r.rating) || 0) >= 4).length;\nconst byBiz = {};\nfor (const r of rows) { const b = String(r.business_name || 'Unknown'); byBiz[b] = (byBiz[b] || 0) + 1; }\nlet top_business = '';\nlet topN = 0;\nfor (const b in byBiz) { if (byBiz[b] > topN) { topN = byBiz[b]; top_business = b; } }\nconst lines = rows.slice(-10).map(r => (r.business_name || '') + ' | ' + (r.rating || '') + ' | ' + String(r.review_text || '').slice(0, 60)).join('\\n');\nreturn [{ json: { total, avg_rating, positive_count: positive, negative_count: negative, top_business, lines } }];"
      },
      "typeVersion": 2
    },
