    {
      "id": "0df1674e-5823-4a29-b828-2367a71d4083",
      "name": "Classify and Assess Change Risk",
      "type": "n8n-nodes-base.code",
      "position": [
        2480,
        384
      ],
      "parameters": {
        "jsCode": "// Assign a severity per attack-surface change and flag any out-of-policy cloud footprint.\nconst cfg = $('Set Configuration Parameters').first().json;\nconst allowedProviders = String(cfg.allowedCloudProviders || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nconst allowedRegions = String(cfg.allowedCloudRegions || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\n\nconst HIGH_RISK_PORTS = [21, 22, 23, 3389, 3306, 5432, 6379, 9200, 27017, 2375];\nconst SENSITIVE_KEYWORDS = ['admin', 'debug', 'staging', 'internal', 'jenkins', 'kibana', 'grafana', 'phpmyadmin'];\n\nconst items = $input.all();\n\nconst classified = items.map(item => {\n  const d = item.json;\n  let severity = 'low';\n  const reasons = [];\n\n  if (d.changeType === 'new') {\n    if (d.port && HIGH_RISK_PORTS.includes(Number(d.port))) {\n      severity = 'critical';\n      reasons.push('Newly exposed high-risk port ' + d.port);\n    } else if (d.identifier && SENSITIVE_KEYWORDS.some(k => String(d.identifier).toLowerCase().includes(k))) {\n      severity = 'high';\n      reasons.push('Newly exposed asset matches a sensitive naming pattern');\n    } else if (d.assetType === 'service') {\n      severity = 'high';\n      reasons.push('New externally exposed service detected');\n    } else {\n      severity = 'medium';\n      reasons.push('New attack-surface asset discovered');\n    }\n  } else if (d.changeType === 'changed') {\n    severity = 'medium';\n    reasons.push('Existing asset configuration changed since last scan');\n  } else if (d.changeType === 'removed') {\n    severity = 'low';\n    reasons.push('Asset no longer detected — verify this was an intentional decommission');\n  }\n\n  const isUnauthorizedCloudFootprint = (\n    d.changeType === 'new' &&\n    d.assetType === 'cloud-resource' &&\n    (\n      (d.cloudProvider && allowedProviders.length && !allowedProviders.includes(String(d.cloudProvider).toLowerCase())) ||\n      (d.region && allowedRegions.length && !allowedRegions.includes(String(d.region).toLowerCase()))\n    )\n  );\n\n  if (isUnauthorizedCloudFootprint) {\n    severity = 'critical';\n    reasons.push('Cloud resource is outside the approved provider/region allowlist');\n  }\n\n  return { json: { ...d, severity, reasons, isUnauthorizedCloudFootprint } };\n});\n\nreturn classified;"
      },
      "typeVersion": 2
    },
