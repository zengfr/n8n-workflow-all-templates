    {
      "id": "0b845a84-f913-4862-97b1-c89593fd33b0",
      "name": "Normalize and Deduplicate Assets",
      "type": "n8n-nodes-base.code",
      "position": [
        1520,
        544
      ],
      "parameters": {
        "jsCode": "// Flatten the three discovery-source shapes into one unified asset inventory, fingerprint, and dedupe.\nconst crypto = require('crypto');\nconst items = $input.all();\n\nfunction fingerprint(rec) {\n  const raw = [rec.assetType, rec.identifier, rec.port || '', rec.service || ''].join('|').toLowerCase();\n  return crypto.createHash('sha256').update(raw).digest('hex').slice(0, 16);\n}\n\nlet unified = [];\n\nfor (const item of items) {\n  const d = item.json;\n\n  if (Array.isArray(d.subdomains)) {\n    for (const s of d.subdomains) {\n      const hostname = typeof s === 'string' ? s : (s.hostname || s.domain);\n      unified.push({\n        assetType: 'domain',\n        identifier: hostname,\n        ipAddress: (s && s.ip) || null,\n        port: null,\n        protocol: null,\n        service: null,\n        cloudProvider: null,\n        region: null,\n        discoveredVia: 'subdomain-enum'\n      });\n    }\n  }\n\n  if (Array.isArray(d.services)) {\n    for (const svc of d.services) {\n      const host = svc.ip || svc.host;\n      unified.push({\n        assetType: 'service',\n        identifier: host + ':' + svc.port,\n        ipAddress: host || null,\n        port: svc.port || null,\n        protocol: svc.protocol || null,\n        service: svc.service || svc.banner || null,\n        cloudProvider: null,\n        region: null,\n        discoveredVia: 'exposed-service-scan'\n      });\n    }\n  }\n\n  if (Array.isArray(d.resources)) {\n    for (const res of d.resources) {\n      unified.push({\n        assetType: 'cloud-resource',\n        identifier: res.resourceId || res.arn || res.name,\n        ipAddress: res.publicIp || null,\n        port: null,\n        protocol: null,\n        service: res.resourceType || null,\n        cloudProvider: res.provider || null,\n        region: res.region || null,\n        discoveredVia: 'cloud-inventory'\n      });\n    }\n  }\n}\n\nunified = unified\n  .filter(rec => !!rec.identifier)\n  .map(rec => ({ ...rec, scannedAt: new Date().toISOString(), fingerprint: fingerprint(rec) }));\n\nconst seen = new Set();\nconst deduped = unified.filter(rec => {\n  if (seen.has(rec.fingerprint)) return false;\n  seen.add(rec.fingerprint);\n  return true;\n});\n\nreturn deduped.map(rec => ({ json: rec }));"
      },
      "typeVersion": 2
    },
