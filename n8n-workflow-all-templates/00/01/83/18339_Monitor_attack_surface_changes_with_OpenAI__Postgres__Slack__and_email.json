      ],
      "parameters": {
        "text": "=You are a security analyst reviewing one attack-surface change:\n\n{{ JSON.stringify({ assetType: $json.assetType, identifier: $json.identifier, changeType: $json.changeType, severity: $json.severity, port: $json.port, service: $json.service, cloudProvider: $json.cloudProvider, region: $json.region, reasons: $json.reasons }) }}\n\nWrite one or two concise sentences explaining why this matters and the recommended next action for the engineering/security team. Return ONLY the sentences — no JSON, no preamble, no markdown.",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 1.6
    },
    {
      "id": "a62467ea-e037-4a50-9c1c-a02a87d2d0f3",
      "name": "Attach AI Risk Narrative",
      "type": "n8n-nodes-base.code",
      "position": [
        2976,
        384
      ],
      "parameters": {
        "jsCode": "// The AI Agent node only returns its own output, so re-attach the risk note to the original change record.\nconst original = $('Classify and Assess Change Risk').item.json;\nconst agentOutput = $input.item.json;\nconst aiRiskNote = String(agentOutput.output || agentOutput.text || agentOutput.response || '').trim();\n\nreturn [{ json: { ...original, aiRiskNote } }];"
      },
      "typeVersion": 2
    },
