    {
      "id": "a8cebaeb-13bf-4be5-b39a-3756d4eda30f",
      "name": "Log Decline & Increment Attempt",
      "type": "n8n-nodes-base.code",
      "position": [
        4368,
        1328
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $('Pick Next Available Candidate').item.json;\nconst rejected = item.rejectedNames || [];\nrejected.push(item.substituteName);\nconst attemptNumber = (item.attemptNumber || 1) + 1;\n\nif (attemptNumber > 3) {\n  return { json: { ...item, rejectedNames: rejected, attemptNumber, candidateFound: false, escalate: true } };\n}\n\nreturn { json: { ...item, rejectedNames: rejected, attemptNumber } };"
      },
      "typeVersion": 2
    },
