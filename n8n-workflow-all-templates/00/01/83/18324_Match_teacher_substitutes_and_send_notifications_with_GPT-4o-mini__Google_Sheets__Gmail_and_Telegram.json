    {
      "id": "9b366ef2-84fd-4a76-b583-40a2d01f2d56",
      "name": "Aggregate Substitute Workload",
      "type": "n8n-nodes-base.code",
      "position": [
        1648,
        2064
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst totals = {};\nfor (const r of rows) {\n  const name = r['Substitute Name'];\n  if (!name) continue;\n  totals[name] = (totals[name] || 0) + Number(r['Hours'] || 0);\n}\nconst entries = Object.entries(totals).sort((a, b) => b[1] - a[1]);\nconst avg = entries.length ? entries.reduce((s, e) => s + e[1], 0) / entries.length : 0;\n\nconst lines = entries.map(([name, hours]) => {\n  const flag = hours > avg * 1.5 ? ' ⚠️ overloaded' : (hours < avg * 0.5 ? ' 🔹 underused' : '');\n  return `- ${name}: ${hours}h${flag}`;\n});\n\nreturn [{ json: { digestText: lines.join('\\n') || 'No substitute hours logged this period.', averageHours: Math.round(avg * 10) / 10 } }];"
      },
      "typeVersion": 2
    },
