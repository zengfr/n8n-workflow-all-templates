    {
      "id": "673a995c-249b-4887-a40e-078f71318684",
      "name": "Parse Ranked Candidates",
      "type": "n8n-nodes-base.code",
      "position": [
        3072,
        1136
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const classInfo = $('Build AI Substitute Ranking Prompt').item.json;\nconst aiResponse = $input.item.json.message.content;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(aiResponse);\n} catch(e) {\n  const match = aiResponse.match(/\\{[\\s\\S]*\\}/);\n  parsed = match ? JSON.parse(match[0]) : { candidates: [] };\n}\n\nreturn {\n  json: {\n    ...classInfo,\n    candidates: parsed.candidates || [],\n    rejectedNames: []\n  }\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "6feef5b2-8543-4989-ba93-4ab6965ae5ff",
      "name": "Section: Conflict Check & Retry Loop",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        3328,
        864
      ],
      "parameters": {
        "color": 7,
        "width": 1236,
        "height": 760,
        "content": "## 🔁 Conflict Check + Confirmation Retry Loop\nWalks the ranked candidate list, skipping anyone already double-booked or previously rejected. Sends the current top candidate a live Accept/Decline request via Telegram (Send-and-Wait). If they decline or don't respond, the loop tries the next-ranked candidate — up to 3 attempts — before escalating to a human."
      },
      "typeVersion": 1
    },
    {
      "id": "6536613a-2fc2-4eaf-ae37-960007db891e",
      "name": "Pick Next Available Candidate",
      "type": "n8n-nodes-base.code",
      "position": [
        3440,
        1136
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst alreadyAssigned = $('Fetch Today\\'s Assigned Substitutes').all().map(a => (a.json['Substitute Teacher'] || '').toLowerCase().trim());\nconst rejected = (item.rejectedNames || []).map(n => n.toLowerCase().trim());\n\nconst available = (item.candidates || []).filter(c => {\n  const name = (c.substituteName || '').toLowerCase().trim();\n  return name && !alreadyAssigned.includes(name) && !rejected.includes(name);\n});\n\nif (available.length === 0) {\n  return { json: { ...item, candidateFound: false } };\n}\n\nconst pick = available[0];\nreturn {\n  json: {\n    ...item,\n    candidateFound: true,\n    substituteName: pick.substituteName,\n    substituteEmail: pick.substituteEmail,\n    substituteTelegramChatId: pick.telegramChatId,\n    substitutePhone: pick.phone,\n    matchReason: pick.matchReason,\n    confidence: pick.confidence\n  }\n};"
      },
      "typeVersion": 2
    },
