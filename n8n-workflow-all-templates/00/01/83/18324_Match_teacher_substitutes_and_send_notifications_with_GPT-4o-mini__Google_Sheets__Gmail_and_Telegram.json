    {
      "id": "741b171c-96f8-449f-b1d9-682872a794fd",
      "name": "Section: Filter",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1856,
        912
      ],
      "parameters": {
        "color": 7,
        "width": 480,
        "height": 624,
        "content": "## 🔍 Class Filtering\nFilters the timetable to find only classes assigned to the absent teacher on the leave date. One item per affected class."
      },
      "typeVersion": 1
    },
    {
      "id": "f07bb214-3e16-47c1-abc3-731ae543d4b2",
      "name": "Filter Classes for Absent Teacher",
      "type": "n8n-nodes-base.code",
      "position": [
        2032,
        1184
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const leaveDate = $('Receive Teacher Leave Request').first().json['Leave Date'];\nconst teacherName = $('Receive Teacher Leave Request').first().json['Teacher Name'];\nconst teacherEmail = $('Receive Teacher Leave Request').first().json['Teacher Email'];\nconst timetable = $('Fetch Full Timetable from Sheets').all();\n\nconst affectedClasses = timetable\n  .map(item => item.json)\n  .filter(row => {\n    const rowDate = (row['Date'] || '').toString().trim();\n    const rowTeacher = (row['Teacher'] || '').toString().toLowerCase().trim();\n    return rowDate === leaveDate.toString().trim()\n        && rowTeacher === teacherName.toLowerCase().trim();\n  });\n\nif (affectedClasses.length === 0) {\n  return [{\n    json: {\n      teacherName, teacherEmail, leaveDate,\n      debugError: 'NO MATCH FOUND',\n      sheetDates: timetable.map(i => i.json['Date']).join(', '),\n      sheetTeachers: timetable.map(i => i.json['Teacher']).join(', ')\n    }\n  }];\n}\n\nreturn affectedClasses.map(cls => ({\n  json: {\n    teacherName, teacherEmail, leaveDate,\n    className: cls['Class'] || '',\n    subject: cls['Subject'] || '',\n    timeSlot: cls['Time'] || '',\n    room: cls['Room'] || '',\n    studentGroup: cls['Student Group'] || '',\n    studentEmails: cls['Student Emails'] || '',\n    attemptNumber: 1\n  }\n}));"
      },
      "typeVersion": 2
    },
    {
      "id": "24f619e9-b1c7-40ab-9b32-2a2a94b6605d",
      "name": "Section: AI Matching",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2400,
        912
      ],
      "parameters": {
        "color": 7,
        "width": 864,
        "height": 548,
        "content": "## 🤖 AI Ranks Top 3 Candidates\nUnlike v1's single pick, GPT-4o-mini now returns a RANKED list of up to 3 substitutes per class, so the workflow has fallbacks if the top choice is unavailable or declines."
      },
      "typeVersion": 1
    },
    {
      "id": "23dac677-44e6-4a0c-8fdf-fdbc8836d306",
      "name": "Build AI Substitute Ranking Prompt",
      "type": "n8n-nodes-base.code",
      "position": [
        2464,
        1136
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const classInfo = $input.item.json;\nconst substitutes = $('Fetch Substitute Availability').all().map(s => s.json);\n\nconst subList = substitutes.map(s =>\n  `Name: ${s['Name']}, Email: ${s['Email']}, Telegram Chat ID: ${s['Telegram Chat ID'] || ''}, Phone: ${s['Phone'] || ''}, Subjects: ${s['Subjects']}, Available Today: ${s['Available Today']}, Current Hours: ${s['Hours This Week'] || 0}`\n).join('\\n');\n\nconst prompt = `You are a school scheduling assistant. Rank the BEST 3 substitute teachers for the following class, best first:\\n\\nClass Details:\\n- Subject: ${classInfo.subject}\\n- Time Slot: ${classInfo.timeSlot}\\n- Class: ${classInfo.className}\\n- Date: ${classInfo.leaveDate}\\n\\nAvailable Substitutes:\\n${subList}\\n\\nRules:\\n1. Each candidate SHOULD teach the required subject (or closest related subject if no exact match)\\n2. Each candidate MUST be available today (Available Today = Yes)\\n3. Prefer substitutes with fewer hours this week (fair workload)\\n4. Rank 1-3, best match first. Return fewer than 3 if fewer qualify.\\n\\nRespond ONLY with a JSON object (no markdown, no explanation):\\n{\\n  \"candidates\": [\\n    {\"substituteName\": \"...\", \"substituteEmail\": \"...\", \"telegramChatId\": \"...\", \"phone\": \"...\", \"matchReason\": \"...\", \"confidence\": \"high|medium|low\"}\\n  ]\\n}`;\n\nreturn {\n  json: {\n    ...classInfo,\n    aiPrompt: prompt\n  }\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "30338eff-0d1c-4f5e-98cb-c8ecd396fefb",
      "name": "AI Rank Substitute Candidates",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        2720,
        1136
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {},
