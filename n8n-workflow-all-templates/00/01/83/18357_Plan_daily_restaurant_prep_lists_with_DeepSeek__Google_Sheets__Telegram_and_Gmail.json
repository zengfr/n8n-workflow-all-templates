    {
      "id": "0d456065-64b1-45b5-b277-13d2ba5056c7",
      "name": "Parse AI Prep Plan",
      "type": "n8n-nodes-base.code",
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const out = JSON.parse(($json.output || '{}').replace(/```/g, ''));\nconst raw = Array.isArray(out.items) ? out.items : [];\nconst date = $('Set Prep Date Context').item.json.prep_date;\nconst enriched = raw.map((it, idx) => ({\n  row_key: date + '|' + String(it.item || 'item' + idx),\n  prep_date: date,\n  item: String(it.item || ''),\n  station: String(it.station || 'Other'),\n  qty: Number(it.qty) || 0,\n  unit: String(it.unit || 'pcs'),\n  status: 'PENDING'\n})).filter(it => it.item);\nreturn [{ json: { prep_items: enriched, item_count: enriched.length } }];"
      },
      "typeVersion": 2
    },
