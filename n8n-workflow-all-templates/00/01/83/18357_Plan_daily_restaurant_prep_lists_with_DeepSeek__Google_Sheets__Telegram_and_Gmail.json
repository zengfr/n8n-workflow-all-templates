    {
      "id": "3756db0e-7be5-4e8e-bd2a-b8efc52f41ab",
      "name": "Build Prep Context",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json).filter(r => r.item && String(r.item).trim() !== '');\nconst ctx = {\n  prep_date: $('Set Prep Date Context').item.json.prep_date,\n  day_name: $('Set Prep Date Context').item.json.day_name,\n  item_count: items.length,\n  items_json: JSON.stringify(items.map(r => ({ item: r.item, station: r.station || 'Other', par_qty: r.par_qty, unit: r.unit || 'pcs' })))\n};\nreturn [{ json: ctx }];"
      },
      "typeVersion": 2
    },
    {
      "id": "3b83e29e-4b17-4025-87c8-0049e9a225b0",
      "name": "AI Prep List Planner",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        960,
        0
      ],
      "parameters": {
        "text": "={{ 'Generate today prep list. Day: ' + $json.day_name + '. Master items: ' + $json.items_json }}",
        "options": {
          "systemMessage": "You are the prep manager of a restaurant kitchen. Based on the prep master items (each with item, station, par_qty, unit) and the current day of the week, decide what the kitchen should prep today. Prep the items that need restocking toward their par level: use par_qty as the target, reduce quantities on slow weekdays, and increase on Fridays and weekends. Only use stations from the provided list. Return ONLY valid JSON with a single key items: an array of objects with exactly item (string, same as master), station (string, from master), qty (number, how much to prep), unit (string, same as master). Max 12 items. Do not use markdown code fences."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
