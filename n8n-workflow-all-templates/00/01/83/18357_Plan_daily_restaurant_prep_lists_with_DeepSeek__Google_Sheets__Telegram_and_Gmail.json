    {
      "id": "fa1a9020-d42a-45e1-9eb3-a43b74c7ab25",
      "name": "Build Kitchen Summary",
      "type": "n8n-nodes-base.code",
      "position": [
        2160,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst date = items[0]?.prep_date || '';\nconst total = items.length;\nconst byStation = {};\nfor (const it of items) { const s = it.station || 'Other'; byStation[s] = (byStation[s] || 0) + 1; }\nconst lines = items.map(it => '- ' + it.qty + ' ' + it.unit + ' ' + it.item + ' (' + it.station + ')').join('\\n');\nconst stationLine = Object.keys(byStation).map(s => s + ': ' + byStation[s]).join(', ');\nreturn [{ json: { prep_date: date, item_count: total, summary_text: 'Prep list for ' + date + ' (' + total + ' items)\\n' + stationLine + '\\n\\n' + lines } }];"
      },
      "typeVersion": 2
    },
