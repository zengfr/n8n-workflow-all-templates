    {
      "id": "b1a58a15-3294-43f1-a39d-c169b16981b2",
      "name": "Build Weekly Prep Stats",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        1152
      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json).filter(it => it.item && String(it.item).trim() !== '');\nif (items.length === 0) return [{ json: { total: 0, done: 0, pending: 0, rate: 0, station_line: '', lines: '' } }];\nconst done = items.filter(it => String(it.status || '').toUpperCase() === 'DONE').length;\nconst pending = items.length - done;\nconst rate = Math.round((done / items.length) * 100);\nconst byStation = {};\nfor (const it of items) { const s = it.station || 'Other'; if (!byStation[s]) byStation[s] = { total: 0, done: 0 }; byStation[s].total++; if (String(it.status || '').toUpperCase() === 'DONE') byStation[s].done++; }\nconst stationLine = Object.keys(byStation).map(s => s + ': ' + byStation[s].done + '/' + byStation[s].total).join(', ');\nconst lines = items.slice(-15).map(it => (it.prep_date || '') + ' | ' + it.item + ' | ' + (it.status || 'PENDING')).join('\\n');\nreturn [{ json: { total: items.length, done, pending, rate, station_line, lines } }];"
      },
      "typeVersion": 2
    },
    {
