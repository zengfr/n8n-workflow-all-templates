    {
      "id": "3b9fc399-90f4-40e0-b404-bb7b42bb7cc5",
      "name": "Create NDA Identifier",
      "type": "n8n-nodes-base.code",
      "position": [
        928,
        176
      ],
      "parameters": {
        "jsCode": "const id = `NDA-${new Date().getFullYear()}-${Date.now()}`;\nconst fileName = $json.name || $binary?.data?.fileName || 'unknown';\nconst mimeType = $json.mimeType || $binary?.data?.mimeType || '';\nconst supported = [\n  'application/pdf',\n  'application/vnd.openxmlformats-officedocument.wordprocessingml.document'\n].includes(mimeType) || /\\.(pdf|docx)$/i.test(fileName);\nreturn [{json:{...$json, ndaId:id, fileName, mimeType, supported, receivedAt:new Date().toISOString()}}];"
      },
      "typeVersion": 1
    },
    {
      "id": "305feb7b-0694-4491-a167-8bf2955710a0",
      "name": "Check File Format",
      "type": "n8n-nodes-base.if",
      "position": [
        1152,
        176
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.supported}}",
              "value2": true
            }
          ]
        }
      },
      "typeVersion": 1
    },
    {
      "id": "1b30c524-aef6-4c8f-9a8d-18cb94de7524",
      "name": "Extract Text from Document",
      "type": "n8n-nodes-base.extractFromFile",
      "position": [
        1856,
        160
      ],
      "parameters": {
        "options": {
          "joinPages": true
        },
        "operation": "pdf"
      },
      "typeVersion": 1
    },
    {
      "id": "035cf0ef-fffd-484e-9772-10c43ce24715",
      "name": "Check Text Extraction Success",
      "type": "n8n-nodes-base.if",
      "position": [
        2080,
        160
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{($json.text || '').length}}",
