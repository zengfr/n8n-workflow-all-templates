    {
      "id": "d25d384f-d745-4600-9ac4-db0f73128c3a",
      "name": "OpenAI Extract NDA Clauses",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        2304,
        144
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a corporate legal NDA analysis assistant. Extract structured NDA clauses. Do not make approval decisions."
            },
            {
              "content": "={{`Extract the following NDA into JSON. Preserve page numbers when present. Return ONLY valid JSON with keys: document_type, parties, clauses. Each clause must contain type, value, page, evidence, confidence.\\n\\nNDA ID: ${$json.ndaId}\\nFILE: ${$json.fileName}\\n\\nDOCUMENT:\\n${$json.text}`}}"
            }
          ]
        },
        "jsonOutput": true
      },
      "typeVersion": 1
    },
    {
      "id": "89c67fe5-4620-42d1-b1dd-7cf5e926d049",
      "name": "Prepare for Playbook Analysis",
      "type": "n8n-nodes-base.code",
      "position": [
        2880,
        144
      ],
      "parameters": {
        "jsCode": "const itemsIn = $input.all();\nconst playbook = itemsIn.map(i=>i.json);\nconst clauses = $('OpenAI Extract NDA Clauses').first().json;\nconst base = $('Create NDA Identifier').first().json;\nreturn [{json:{\n  ndaId:base.ndaId,fileName:base.fileName,\n  extractedClauses:clauses,playbook\n}}];"
      },
      "typeVersion": 1
    },
    {
      "id": "2a9e3a60-1411-4b4d-bbb4-191dfba7308d",
      "name": "OpenAI Compare with Playbook",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        3104,
        144
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Compare NDA clauses against the supplied legal playbook. Return ONLY valid JSON."
            },
            {
              "content": "={{`Return JSON with keys: overall_status, deviations, missing_clauses, risk_score, risk_level, confidence, blocking_issues, decision_recommendation, decision_reason. Allowed risk levels: LOW, MEDIUM, HIGH. Allowed recommendation: AUTO_APPROVE, LEGAL_REVIEW. Never recommend AUTO_APPROVE if there is a high-risk deviation, missing mandatory clause, unknown clause, or low confidence.\\n\\nINPUT:\\n${JSON.stringify($json)}`}}"
            }
          ]
        },
        "jsonOutput": true
      },
      "typeVersion": 1
    },
    {
      "id": "a013b2b6-19ae-44ed-986e-6e1a81d2efc9",
      "name": "Apply Rules to NDA",
      "type": "n8n-nodes-base.code",
      "position": [
        3456,
        144
      ],
      "parameters": {
        "jsCode": "let raw = $json;\nlet result = raw.output || raw.text || raw.content || raw;\nif (typeof result === 'string') { try { result = JSON.parse(result.replace(/^```json|```$/g,'').trim()); } catch(e) { result = {}; } }\nconst risk = String(result.risk_level || 'HIGH').toUpperCase();\nconst score = Number(result.risk_score ?? 100);\nconst confidence = Number(result.confidence ?? 0);\nconst blocking = Array.isArray(result.blocking_issues) ? result.blocking_issues : [];\nconst deviations = Array.isArray(result.deviations) ? result.deviations : [];\nconst missing = Array.isArray(result.missing_clauses) ? result.missing_clauses : [];\nconst canAutoApprove = risk === 'LOW' && score <= 30 && confidence >= 0.90 &&\n  blocking.length === 0 && missing.length === 0 &&\n  !deviations.some(d => String(d.risk||'').toUpperCase()==='HIGH');\nreturn [{json:{...$('Create NDA Identifier').first().json,...result,risk_level:risk,risk_score:score,confidence,decision:canAutoApprove?'AUTO_APPROVED':'LEGAL_REVIEW',decision_reason:canAutoApprove?'Low risk, high confidence, no blocking issues.':'One or more approval criteria failed.',playbookVersion:'v1.0',aiModel:'gpt-4o-mini',completedAt:new Date().toISOString()}}];"
      },
      "typeVersion": 1
    },
    {
      "id": "72a9a1b0-7b98-416e-956f-9ad8675c89f9",
      "name": "Determine NDA Approval Path",
      "type": "n8n-nodes-base.if",
      "position": [
        3680,
        144
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.decision}}",
              "value2": "AUTO_APPROVED"
            }
          ]
        }
      },
      "typeVersion": 1
    },
