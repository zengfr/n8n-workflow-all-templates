    {
      "id": "9057e3b0-51cd-4513-902c-3cea5b6e4623",
      "name": "Fetch File from Drive",
      "type": "n8n-nodes-base.googleDrive",
      "position": [
        704,
        176
      ],
      "parameters": {
        "fileId": "={{$json.id}}",
        "options": {},
        "operation": "download",
        "authentication": "oAuth2"
      },
      "typeVersion": 1
