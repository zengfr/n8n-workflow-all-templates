              "value": "={{ $json.body.receiptUrl || $json.body.receiptNote || '' }}"
            },
            {
              "id": "a9",
              "name": "valid",
              "type": "boolean",
              "value": "={{ (() => { const b = $json.body || {}; const errs = []; if (!b.employeeEmail && !b.employeeName) errs.push('employeeName or employeeEmail is required'); if (!b.vendor) errs.push('vendor is required'); if (b.amount === undefined || isNaN(Number(b.amount)) || Number(b.amount) <= 0) errs.push('amount must be a positive number'); if (!b.category) errs.push('category is required'); if (!b.description) errs.push('description is required'); return errs.length === 0; })() }}"
            },
            {
              "id": "a10",
              "name": "validationError",
              "type": "string",
              "value": "={{ (() => { const b = $json.body || {}; const errs = []; if (!b.employeeEmail && !b.employeeName) errs.push('employeeName or employeeEmail is required'); if (!b.vendor) errs.push('vendor is required'); if (b.amount === undefined || isNaN(Number(b.amount)) || Number(b.amount) <= 0) errs.push('amount must be a positive number'); if (!b.category) errs.push('category is required'); if (!b.description) errs.push('description is required'); return errs.join('; '); })() }}"
            }
