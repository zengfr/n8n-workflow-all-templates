      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "v1",
              "name": "valid",
              "type": "boolean",
              "value": "={{ (() => { const b = $json.body || {}; const name = b.employeeName || b.name; const email = b.employeeEmail || b.email; const lwd = b.lastWorkingDay || b.last_working_day; const reason = b.reason || b.departureReason; return !!((name || email) && lwd && reason); })() }}"
            },
            {
              "id": "v2",
              "name": "validationError",
              "type": "string",
              "value": "={{ (() => { const b = $json.body || {}; const name = b.employeeName || b.name; const email = b.employeeEmail || b.email; const lwd = b.lastWorkingDay || b.last_working_day; const reason = b.reason || b.departureReason; const missing = []; if (!name && !email) missing.push('employeeName or employeeEmail'); if (!lwd) missing.push('lastWorkingDay'); if (!reason) missing.push('reason'); return missing.length ? ('Missing required field(s): ' + missing.join(', ')) : ''; })() }}"
            },
            {
              "id": "v3",
              "name": "employeeName",
              "type": "string",
              "value": "={{ $json.body.employeeName || $json.body.name || '' }}"
            },
            {
              "id": "v4",
              "name": "employeeEmail",
              "type": "string",
              "value": "={{ $json.body.employeeEmail || $json.body.email || '' }}"
            },
            {
              "id": "v5",
              "name": "lastWorkingDay",
              "type": "string",
              "value": "={{ $json.body.lastWorkingDay || $json.body.last_working_day }}"
            },
            {
              "id": "v6",
              "name": "reason",
              "type": "string",
              "value": "={{ $json.body.reason || $json.body.departureReason }}"
            },
            {
              "id": "v7",
              "name": "managerEmail",
              "type": "string",
              "value": "={{ $json.body.managerEmail || $json.body.manager_email || '' }}"
            }
          ]
        },
        "includeOtherFields": false
      },
      "typeVersion": 3.4
    },
