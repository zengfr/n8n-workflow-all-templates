    {
      "id": "338124fb-aa1a-48f8-8235-3678b4982326",
      "name": "Parse AI Assessment",
      "type": "n8n-nodes-base.code",
      "position": [
        1904,
        1088
      ],
      "parameters": {
        "jsCode": "\nreturn  $input.all().map(item => {\n  try {\n    const parsed = JSON.parse(item.json.text);\n    return { json: parsed };\n  } catch (e) {\n    return {\n      json: {\n        ai_fit_score: 0,\n        strength: \"Parsing Error\",\n        recommendation: \"Consider\"\n      }\n    };\n  }\n});\n"
      },
      "typeVersion": 2
    },
