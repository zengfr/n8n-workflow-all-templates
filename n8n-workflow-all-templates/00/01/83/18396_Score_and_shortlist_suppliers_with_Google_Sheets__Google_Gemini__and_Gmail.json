    {
      "id": "b646c7b8-f01f-4151-93ee-e71ab50f2109",
      "name": "Calculate Final Score",
      "type": "n8n-nodes-base.code",
      "position": [
        2912,
        1040
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n\n  const aiFit = Number(item.json.ai_fit_score || 0);\n  const esg = Number(item.json.ESG_Score || 0);\n  const years = Number(item.json.Years_In_Business || 0);\n  const financialHealth = Number(item.json.financial_health_score || 0);\n  const risk = Number(item.json.risk_score || 0);\n\n  const diversityBonus =\n    item.json.Diversity_Certified === 'Yes'\n      ? 10\n      : 0;\n\n  const experienceBonus =\n    Math.min(years, 20);\n\n  const finalScore =\n    (aiFit * 0.45) +\n    (esg * 0.20) +\n    (financialHealth * 0.15) +\n    diversityBonus +\n    experienceBonus -\n    (risk * 0.20);\n\n  return {\n    json: {\n      ...item.json,\n      diversity_bonus: diversityBonus,\n      experience_bonus: experienceBonus,\n      final_score: Number(finalScore.toFixed(2))\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
