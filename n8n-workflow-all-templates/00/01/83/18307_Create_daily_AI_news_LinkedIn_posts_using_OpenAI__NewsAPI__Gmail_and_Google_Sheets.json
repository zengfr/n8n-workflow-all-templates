    {
      "id": "39f27bc9-45c5-4381-b1cf-8266ad5f8347",
      "name": "Generate Image for Top Article",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        -1264,
        400
      ],
      "parameters": {
        "prompt": "=Create a realistic social media news-style image.\n\nPost:\n{{ $json.output[0].content[0].text }}\n\nRequirements:\n\n- Generate a realistic photograph related to the main topic\n- Add a large bold headline directly on the image\n- Headline must summarize the key message\n- News-style visual layout\n- High contrast text\n- Professional LinkedIn quality\n- Human subjects when relevant\n- Modern social media design\n- Square format 1200x1200\n\nThe image should look like a viral LinkedIn or business news graphic.\n\nDo not use generic icons.\nDo not create posters.\nUse realistic photography.",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-image-1-mini"
        },
        "options": {
          "size": "1024x1024",
          "quality": "medium"
        },
        "resource": "image"
      },
      "credentials": {
