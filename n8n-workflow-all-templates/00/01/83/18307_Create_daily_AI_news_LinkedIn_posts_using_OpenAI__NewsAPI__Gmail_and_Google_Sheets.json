    {
      "id": "4923ec72-2037-4e61-93b3-048b1ec4047c",
      "name": "Aggregate Summaries",
      "type": "n8n-nodes-base.code",
      "position": [
        -2112,
        400
      ],
      "parameters": {
        "jsCode": "const articles = $input.all();\nconst topArticle = articles[0].json;\n\nlet message = '🤖 *AI News Digest - ' + $now.toFormat('MMMM d, yyyy') + '*\\n\\n';\n\narticles.forEach((item, index) => {\n  const article = item.json;\n  message += (index + 1) + '. *' + (article.title || 'No Title') + '*\\n';\n  message += (article.summary || '') + '\\n';\n  message += '🔗 ' + (article.url || '') + '\\n\\n';\n});\n\nreturn [{\n  json: {\n    message: message,\n    topArticleTitle: topArticle.title || 'No Title',\n    topArticleSummary: topArticle.summary || ''\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "4c63c50b-de4d-4e6a-90e9-fafc9c052e7b",
      "name": "Summarize Article with GPT-4o-mini",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        -720,
        928
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "maxTokens": 100,
          "temperature": 0.7
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert news summarizer.\n\nYour task is to summarize the provided news article.\n\nRules:\n- Write exactly 2 sentences.\n- Each sentence must be on a new line.\n- Maximum 20 words per sentence.\n- Focus only on the specific article provided.\n- Mention the actual people, companies, and events from the article.\n- Do not use placeholder text.\n- Do not repeat examples.\n- No opinions or commentary.\n- Return only the summary."
            },
            {
              "content": "={{ \"Title: \" + $json.title + \"\\n\\nDescription: \" + $json.description }}"
            }
          ]
        },
        "builtInTools": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "credential-id",
          "name": "n8n free OpenAI API credits"
        }
      },
      "typeVersion": 2.3
    },
