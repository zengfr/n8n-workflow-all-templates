    {
      "id": "3121383d-d156-43c8-a9ae-1642f7c8a49e",
      "name": "Analyze Notification Timing",
      "type": "n8n-nodes-base.code",
      "position": [
        4608,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const days = Number($json.days_remaining);\n\nlet notification_stage;\n\nif (days >= 0 && days <= 7) {\n  notification_stage = \"Reminder Required\";\n} else {\n  notification_stage = \"No Reminder\";\n}\n\nreturn {\n  json: {\n    ...$json,\n    days_remaining: days,\n    notification_stage\n  }\n};"
      },
      "typeVersion": 2
    },
