    {
      "id": "8a2a9b4d-faab-4d20-8b7b-7b5860e200c7",
      "name": "Define AI Content Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        5408,
        400
      ],
      "parameters": {
        "text": "=Create a professional daily reminder email for this upcoming event.\n\nEvent Name: {{ $json.event_name }}\nEvent Date: {{ $json.event_date }}\nDays Remaining: {{ $json.days_remaining }}\nPlatform: {{ $json.platform || \"Not specified\" }}\nDescription: {{ $json.description || \"No description provided\" }}\nPriority: {{ $json.priority || \"Not specified\" }}\n\nThe event is within 7 days, so this is a daily reminder.\n\nReturn only:\n1. Email Subject\n2. Email Body\n\nKeep the email concise, professional, and useful.\n\nGenerate only the reminder message content.\n\nDo NOT use placeholders such as:\n[Name]\n[Your Name]\n[Recipient Name]\n[Organization]\n[Date]\n\nDo not include a greeting such as \"Dear [Name]\".\n\nThe recipient greeting and sender signature are handled separately by the email template.\n\nWrite the reminder in a professional, concise and natural business tone.\n\nReturn only the reminder body content.",
        "options": {},
        "promptType": "define"
      },
      "retryOnFail": true,
      "typeVersion": 3.1,
      "waitBetweenTries": 5000
    },
    {
      "id": "09bcd3d0-63cb-40af-a9e3-546e3f1e039e",
      "name": "Send Email via Gmail",
      "type": "n8n-nodes-base.gmail",
      "position": [
        6256,
        400
      ],
      "webhookId": "c7a926b1-d8b0-41c4-9542-f44b5c8dfa55",
      "parameters": {
        "sendTo": "user@example.com",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: auto; padding: 25px; color: #1f2937;\">\n\n  <h2 style=\"color:#4f46e5;\">\n    🔔 Event Reminder\n  </h2>\n\n  <p>Hello Manasa,</p>\n\n  <p>\n    This is a reminder regarding your upcoming event.\n  </p>\n\n  <div style=\"\n    background:#f8fafc;\n    padding:18px;\n    border-radius:10px;\n    margin:20px 0;\n    border:1px solid #e5e7eb;\n  \">\n\n    <p>\n      📌 <strong>Event:</strong>\n      {{ $('Retrieve Rows from Supabase').item.json.event_name }}\n    </p>\n\n    <p>\n      📅 <strong>Date:</strong>\n      {{ $('Retrieve Rows from Supabase').item.json.event_date }}\n    </p>\n\n    <p>\n      ⏳ <strong>Days Remaining:</strong>\n      {{ $('Analyze Notification Timing').item.json.days_remaining }}\n    </p>\n\n    <p>\n      ⭐ <strong>Priority:</strong>\n      {{ $('Retrieve Rows from Supabase').item.json.priority }}\n    </p>\n\n    <p>\n      📱 <strong>Platform:</strong>\n      {{ $('Retrieve Rows from Supabase').item.json.platform || 'Not specified' }}\n    </p>\n\n  </div>\n\n  <h3 style=\"color:#111827;\">\n    🤖 CreatorPulse AI Reminder\n  </h3>\n\n  <div style=\"\n    background:#ffffff;\n    padding:15px;\n    border-radius:8px;\n    line-height:1.6;\n  \">\n    \n  </div>\n{{ $json.message }}\n  <hr style=\"border:none;border-top:1px solid #e5e7eb;margin:25px 0;\">\n\n  <p style=\"font-size:12px;color:#6b7280;\">\n    This reminder was automatically generated by CreatorPulse AI.\n  </p>\n\n</div>",
        "options": {
          "appendAttribution": false
        },
        "subject": "=🔔 Reminder:{{ $json.subject }}"
      },
      "typeVersion": 2.2
    },
    {
      "id": "47ed7310-4418-4472-ad4f-8df695dceb7c",
      "name": "Process Notification Email",
      "type": "n8n-nodes-base.code",
      "position": [
        5904,
        400
      ],
      "parameters": {
        "jsCode": "return items.map((item) => {\n\n  const output = item.json.output || \"\";\n\n  let subject = \"\";\n  let message = \"\";\n\n  // Subject extraction\n  const subjectMatch = output.match(\n    /\\*{0,2}(?:Email Subject|Subject):\\*{0,2}\\s*(.+)/i\n  );\n\n  if (subjectMatch) {\n    subject = subjectMatch[1].trim();\n  }\n\n  // Body extraction\n  const bodyMatch = output.match(\n    /\\*{0,2}(?:Email Body|Body):\\*{0,2}\\s*([\\s\\S]*)/i\n  );\n\n  if (bodyMatch) {\n    message = bodyMatch[1].trim();\n  }\n\n  // If Subject was not found\n  if (!subject) {\n    subject = \"CreatorPulse AI Reminder\";\n  }\n\n  // If Body was not found\n  if (!message) {\n    message = output;\n  }\n\n  return {\n    json: {\n      notification_type: \"email\",\n      notification_stage: \"Reminder\",\n      recipient_email: \"user@example.com\",\n      subject: subject,\n      message: message,\n      status: \"Pending\"\n    }\n  };\n\n});"
      },
      "typeVersion": 2
    },
