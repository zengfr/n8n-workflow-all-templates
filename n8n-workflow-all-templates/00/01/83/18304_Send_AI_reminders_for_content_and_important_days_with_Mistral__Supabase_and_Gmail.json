    {
      "id": "9410bc41-181a-4414-adbf-38db46db5d45",
      "name": "Process Important Day Email",
      "type": "n8n-nodes-base.code",
      "position": [
        5072,
        2064
      ],
      "parameters": {
        "jsCode": "return items.map((item) => {\n\n  const output = item.json.output || \"\";\n\n  let subject = \"\";\n  let message = \"\";\n\n  // ---------------------------------------\n  // Try to parse JSON output\n  // ---------------------------------------\n\n  try {\n\n    // Remove markdown code fences if AI adds them\n    const cleanedOutput = output\n      .replace(/```json/gi, \"\")\n      .replace(/```/g, \"\")\n      .trim();\n\n    const parsed = JSON.parse(cleanedOutput);\n\n    subject = parsed.subject || \"\";\n    message = parsed.body || \"\";\n\n  } catch (error) {\n\n    // ---------------------------------------\n    // Fallback for non-JSON AI output\n    // ---------------------------------------\n\n    const subjectMatch = output.match(\n      /\\*{0,2}(?:Email Subject|Subject):\\*{0,2}\\s*(.+)/i\n    );\n\n    if (subjectMatch) {\n      subject = subjectMatch[1].trim();\n    }\n\n    const bodyMatch = output.match(\n      /\\*{0,2}(?:Email Body|Body):\\*{0,2}\\s*([\\s\\S]*)/i\n    );\n\n    if (bodyMatch) {\n      message = bodyMatch[1].trim();\n    }\n\n    // If subject wasn't found\n    if (!subject) {\n      subject = \"CreatorPulse AI Reminder\";\n    }\n\n    // If body wasn't found\n    if (!message) {\n      message = output;\n    }\n  }\n\n  // ---------------------------------------\n  // Return clean notification data\n  // ---------------------------------------\n\n  return {\n    json: {\n      notification_type: \"Important Day\",\n      notification_stage:\n        item.json.notification_stage || \"Reminder\",\n\n      recipient_email:\n        item.json.recipient_email || \"user@example.com\",\n\n      subject: subject,\n\n      message: message,\n\n      status: \"Pending\",\n\n      source_type:\n        item.json.source_type || \"important_day\",\n\n      source_id:\n        item.json.source_id || null,\n\n      event_date:\n        item.json.event_date || null\n    }\n  };\n\n});"
      },
      "typeVersion": 2
    }
