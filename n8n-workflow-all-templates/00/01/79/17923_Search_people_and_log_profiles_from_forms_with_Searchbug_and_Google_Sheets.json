    {
      "id": "eec48eaf-97aa-4f83-8e8c-79d60bfc25d3",
      "name": "Flatten Results",
      "type": "n8n-nodes-base.code",
      "position": [
        1952,
        1200
      ],
      "parameters": {
        "jsCode": "const data = $json;\n\nfunction toArray(value) {\n  if (!value) return [];\n  return Array.isArray(value) ? value : [value];\n}\n\nfunction safe(value) {\n  return value === null || value === undefined ? \"\" : String(value);\n}\n\nconst persons = toArray(data?.people?.person);\n\nif (persons.length === 0) {\n  return [{\n    json: {\n      reportID: \"\", fullName: \"No results found\",\n      firstName: \"\", middleName: \"\", lastName: \"\",\n      DOB: \"\", currentAge: \"\", deceased: \"\", SSN: \"\",\n      primaryAddress: \"\", city: \"\", state: \"\", zip: \"\",\n      primaryPhone: \"\", allPhones: \"\", allEmails: \"\",\n      relatives: \"\", driversLicenseNumbers: \"\",\n      bankruptcies: \"\", liens: \"\", judgements: \"\",\n      reportToken: \"\"\n    }\n  }];\n}\n\nreturn persons.map((person) => {\n  const names = toArray(person?.names?.name);\n  const primaryName = names[0] || {};\n\n  const firstName  = safe(primaryName.firstName);\n  const middleName = safe(primaryName.middleName);\n  const lastName   = safe(primaryName.lastName);\n  const suffix     = safe(primaryName.suffix);\n\n  const fullName = [firstName, middleName, lastName, suffix]\n    .filter(Boolean)\n    .join(\" \");\n\n  const addresses = toArray(person?.addresses?.address);\n  const primaryAddressObj = addresses[0] || {};\n\n  const primaryAddress = safe(primaryAddressObj.fullStreet);\n  const city           = safe(primaryAddressObj.city);\n  const state          = safe(primaryAddressObj.state);\n  const zip            = safe(primaryAddressObj.zip);\n\n  const addressPhones = toArray(primaryAddressObj?.phones?.phone);\n  const otherPhones   = toArray(person?.otherPhones?.phone);\n  const allPhoneObjects = [...addressPhones, ...otherPhones];\n\n  const allPhones = [...new Set(\n    allPhoneObjects\n      .map(phone => safe(phone.phoneNumber))\n      .filter(Boolean)\n  )].join(\" | \");\n\n  const primaryPhone = allPhones.split(\" | \")[0] || \"\";\n\n  const allEmails = toArray(person?.emails?.email)\n    .map(email => safe(email))\n    .filter(Boolean)\n    .join(\" | \");\n\n  const relatives = toArray(person?.relatives?.relative)\n    .map(relative => [\n      safe(relative.firstName),\n      safe(relative.middleName),\n      safe(relative.lastName)\n    ].filter(Boolean).join(\" \"))\n    .filter(Boolean)\n    .join(\" | \");\n\n  const driversLicenseNumbers = toArray(person?.driversLicenses?.driversLicense)\n    .map(dl => safe(dl.driversLicenseNumber))\n    .filter(Boolean)\n    .join(\" | \");\n\n  const currentAge = toArray(person?.driversLicenses?.driversLicense)[0]?.currentAge || \"\";\n\n  return {\n    json: {\n      reportID:             safe(person.reportID),\n      fullName,\n      firstName,\n      middleName,\n      lastName,\n      DOB:                  safe(person?.DOBs?.DOB),\n      currentAge:           safe(currentAge),\n      deceased:             safe(person.deceased),\n      SSN:                  safe(person?.SSNs?.SSNInfo?.SSN),\n      primaryAddress,\n      city,\n      state,\n      zip,\n      primaryPhone,\n      allPhones,\n      allEmails,\n      relatives,\n      driversLicenseNumbers,\n      bankruptcies:         safe(person.bankruptcies),\n      liens:                safe(person.liens),\n      judgements:           safe(person.judgements),\n      reportToken:          safe(person.reportToken)\n    }\n  };\n});\n"
      },
      "typeVersion": 2
    },
