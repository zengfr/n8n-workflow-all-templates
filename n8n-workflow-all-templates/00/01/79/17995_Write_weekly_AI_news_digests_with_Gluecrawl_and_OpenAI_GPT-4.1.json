    {
      "id": "c3a70e59-6d82-4b14-8f97-2e5b1c9d4a06",
      "name": "Build the Brief",
      "type": "n8n-nodes-base.code",
      "position": [
        1472,
        800
      ],
      "parameters": {
        "jsCode": "// Collapse the week into a single item. The model has to see every story at\n// once to group them; one prompt per article would only ever produce a list.\nconst EXCERPT = 1200;\n\n// A news index holds more than a week of stories, and these sites publish\n// faster than one edition can carry. Cap what the model is asked to read; the\n// archive still keeps every article. Raising this raises the prompt cost and\n// dilutes the digest, in that order.\nconst PER_SOURCE = 10;\n\n// A source whose run failed, and a run that finished with no rows, both reach\n// the archive carrying no URL. Neither is a story.\nconst articles = $input\n  .all()\n  .map((item) => item.json)\n  .filter((row) => row.url);\n\nconst bySource = {};\nfor (const article of articles) {\n  (bySource[article.source] ??= []).push(article);\n}\n\n// An unparseable date sorts last but is never dropped: a site whose mapper\n// returns \"2 days ago\" would otherwise lose its whole section.\nconst publishedAt = (row) => Date.parse(row.published_at) || 0;\n\nlet included = 0;\n\nconst brief = Object.entries(bySource)\n  .map(([source, rows]) => {\n    const newest = [...rows].sort((a, b) => publishedAt(b) - publishedAt(a)).slice(0, PER_SOURCE);\n    included += newest.length;\n\n    const entries = newest.map((row) => {\n      const parts = [`### ${row.title}`, row.url];\n      if (row.published_at) parts.push(`Published: ${row.published_at}`);\n      if (row.body) parts.push(row.body.slice(0, EXCERPT));\n      return parts.join('\\n');\n    });\n\n    // The count is in the heading so that a capped week is legible in the\n    // digest row itself, rather than only to whoever opens this node.\n    const heading =\n      newest.length < rows.length ? `## ${source} (${newest.length} most recent of ${rows.length})` : `## ${source}`;\n\n    return `${heading}\\n\\n${entries.join('\\n\\n')}`;\n  })\n  .join('\\n\\n');\n\nreturn [\n  {\n    json: {\n      week_of: new Date().toISOString().slice(0, 10),\n      article_count: included,\n      sources: Object.keys(bySource).join(', '),\n      brief,\n    },\n  },\n];"
      },
      "typeVersion": 2
    },
