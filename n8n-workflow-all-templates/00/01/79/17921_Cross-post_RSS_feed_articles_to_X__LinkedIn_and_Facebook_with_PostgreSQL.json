    {
      "id": "638df649-81ab-4bed-a51d-52d850a5ba12",
      "name": "Build Post Configurations",
      "type": "n8n-nodes-base.code",
      "position": [
        944,
        352
      ],
      "parameters": {
        "jsCode": "const input=$json;\nconst urls=String(input.feed_urls||'').split(/[\\n,]/).map(v=>v.trim()).filter(Boolean);\nif(!urls.length) throw new Error('At least one HTTPS RSS feed URL is required.');\nconst makeFeed=(url,index)=>{let host;try{host=new URL(url).hostname.replace(/^www\\./,'')}catch{host='feed-'+(index+1)};const name=index===0&&input.feed_name?String(input.feed_name).trim():host;return {feedId:'feed-'+(index+1),name,url,enabled:true,destinations:{x:{enabled:Boolean(input.enable_x),template:String(input.x_template||'[[title]]\\\\n\\\\n[[url]]')},linkedin:{enabled:Boolean(input.enable_linkedin),organizationId:String(input.linkedin_organization_id||''),template:String(input.linkedin_template||'[[title]]\\\\n\\\\n[[excerpt]]\\\\n\\\\nRead more: [[url]]')},facebook:{enabled:Boolean(input.enable_facebook),pageId:String(input.facebook_page_id||''),template:String(input.facebook_template||'[[title]]\\\\n\\\\n[[excerpt]]\\\\n\\\\n[[url]]')}}}};\nconst configuration={policyVersion:'1.0.0',timezone:'Europe/Madrid',dryRun:Boolean(input.dry_run),maxEnabledFeeds:10,appendUtmParameters:Boolean(input.append_utm_parameters),utmSourcePrefix:String(input.utm_source_prefix||'rss-cross-post'),utmMedium:String(input.utm_medium||'social'),feeds:urls.slice(0,10).map(makeFeed)};\nreturn [{json:{...input,configuration}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "rsscp-validate",
      "name": "Validate Post Configurations",
      "type": "n8n-nodes-base.code",
      "position": [
        1168,
        352
      ],
      "parameters": {
        "jsCode": "const c=$json.configuration||{};const errors=[];if(c.timezone!=='Europe/Madrid')errors.push('timezone must be Europe/Madrid');if(!Array.isArray(c.feeds)||!c.feeds.length)errors.push('at least one feed is required');const ids=new Set();let enabledFeeds=0;let enabledDestinations=0;for(const f of c.feeds||[]){if(!f.feedId||ids.has(f.feedId))errors.push('feedId values must be unique and non-empty');ids.add(f.feedId);if(f.enabled){enabledFeeds++;if(!/^https:\\/\\//i.test(f.url||''))errors.push('enabled feed URLs must use HTTPS');for(const channel of ['x','linkedin','facebook'])if(f.destinations?.[channel]?.enabled)enabledDestinations++;}}if(enabledFeeds>c.maxEnabledFeeds)errors.push('maxEnabledFeeds exceeded');if(!enabledDestinations)errors.push('at least one enabled destination is required');return [{json:{...$json,configuration:c,validation_errors:errors,configuration_valid:errors.length===0}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "rsscp-config-gate",
