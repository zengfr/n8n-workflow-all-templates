    {
      "id": "rsscp-feed-requests",
      "name": "Create RSS Fetch Requests",
      "type": "n8n-nodes-base.code",
      "position": [
        1808,
        352
      ],
      "parameters": {
        "jsCode": "const c=$('Build Post Configurations').first().json.configuration; const errors=$('Validate Post Configurations').first().json.validation_errors||[]; const base={...$json,configuration:c,configuration_valid:errors.length===0,validation_errors:errors,run_type:'scheduled',run_id:'rss-cross-post-'+Date.now()}; return (c.feeds||[]).filter(f=>f.enabled).map(feed=>({json:{...base,feed_id:feed.feedId,feed_name:feed.name,feed_url:feed.url,url:feed.url}}));"
      },
      "typeVersion": 2
    },
    {
      "id": "rsscp-config-error",
