    {
      "id": "rsscp-normalize",
      "name": "Normalize for Publishing",
      "type": "n8n-nodes-base.code",
      "position": [
        2768,
        352
      ],
      "parameters": {
        "jsCode": "const c=$('Build Post Configurations').first().json.configuration; const source=$json; const request=$('Create RSS Fetch Requests').all()[$itemIndex]?.json||{}; const title=String(source.title||source.titleText||'').replace(/<[^>]*>/g,'').replace(/&amp;/g,'&').replace(/\\s+/g,' ').trim(); const url=String(source.link||source.url||'').trim(); const excerpt=String(source.contentSnippet||source.description||source.content||'').replace(/<[^>]*>/g,'').replace(/&amp;/g,'&').replace(/\\s+/g,' ').trim().slice(0,500); const published=new Date(source.pubDate||source.isoDate||source.published||Date.now()); if(!title&&!url) return []; const identity=String(source.guid||url||title+'|'+published.toISOString()).trim(); const feedId=source.feed_id||source.feedId||request.feed_id||'example-blog'; const feed=c.feeds.find(f=>f.feedId===feedId)||c.feeds[0]; const withUtm=(input,channel)=>{try{const u=new URL(input); if(c.appendUtmParameters){u.searchParams.set('utm_source',c.utmSourcePrefix+'-'+channel);u.searchParams.set('utm_medium',c.utmMedium);u.searchParams.set('utm_campaign',feed.feedId);u.searchParams.set('utm_content',identity.slice(0,16));} return u.toString();}catch{return input;}}; const render=(template,channel)=>String(template||'{{title}}\\n\\n{{url}}').replace(/\\[\\[title\\]\\]/g,title).replace(/\\[\\[url\\]\\]/g,withUtm(url,channel)).replace(/\\[\\[excerpt\\]\\]/g,excerpt).replace(/\\[\\[author\\]\\]/g,String(source.creator||source.author||'')).replace(/{{title}}/g,title).replace(/{{url}}/g,withUtm(url,channel)).replace(/{{excerpt}}/g,excerpt).replace(/{{author}}/g,String(source.creator||source.author||'')); const out=[]; for(const channel of ['x','linkedin','facebook']){const d=feed?.destinations?.[channel]; if(!d?.enabled) continue; const destinationReference=channel==='linkedin'?(d.organizationId||''):channel==='facebook'?d.pageId:'account'; const text=render(d.template,channel); const limited=channel==='x'?text.slice(0,280):text.slice(0,3000); out.push({json:{configuration:c,run_type:$json.run_type||'scheduled',feed_id:feed.feedId,feed_name:feed.name,feed_url:feed.url,article_identity:identity,article_content_hash:'',article_guid:String(source.guid||''),article_url:withUtm(url,channel),article_title:title,article_published_at:Number.isNaN(published.getTime())?new Date().toISOString():published.toISOString(),channel,destination_reference:destinationReference,post_text:limited,post_status:c.dryRun?'dry_run':'pending',record_key:[feed.feedId,channel,String(destinationReference||'').replace(/[^A-Za-z0-9_-]/g,'_'),String(identity).replace(/[^A-Za-z0-9_-]/g,'_').slice(-20)].join(':'),attempt_count:0,first_seen_at:new Date().toISOString(),created_at:new Date().toISOString(),updated_at:new Date().toISOString(),hash_input:[title,url,excerpt,Number.isNaN(published.getTime())?'':published.toISOString()].join('|')}});} return out;"
      },
      "typeVersion": 2
    },
