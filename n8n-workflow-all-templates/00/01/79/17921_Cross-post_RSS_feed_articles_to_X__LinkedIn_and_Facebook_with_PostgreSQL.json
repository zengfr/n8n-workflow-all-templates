      "parameters": {
        "query": "CREATE TABLE IF NOT EXISTS workflow_factory.rss_cross_post_ledger (record_key text PRIMARY KEY, record_type text NOT NULL, feed_id text, feed_name text, feed_url_hash text, article_identity text, article_content_hash text, article_guid text, article_url text, article_title text, article_published_at timestamptz, channel text, destination_reference text, status text, attempt_count integer NOT NULL DEFAULT 0, next_attempt_at timestamptz, external_post_id text, external_post_url text, sanitized_error_code text, sanitized_error_summary text, first_seen_at timestamptz, published_at timestamptz, created_at timestamptz NOT NULL DEFAULT now(), updated_at timestamptz NOT NULL DEFAULT now());",
        "options": {},
