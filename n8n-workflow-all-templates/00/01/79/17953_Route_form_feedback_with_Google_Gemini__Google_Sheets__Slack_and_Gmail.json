      "parameters": {
        "color": 7,
        "width": 480,
        "height": 836,
        "content": "## 1. Classify (AI Text Classifier)\nThe form message is sorted into Bug / Feature / Praise / Other - each a separate output branch."
      },
      "typeVersion": 1
    },
    {
      "id": "47f7edff-4e47-4218-8511-b385d797afe7",
      "name": "S2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        512,
        -224
      ],
      "parameters": {
        "color": 7,
        "width": 1128,
        "height": 844,
        "content": "## 2. Act per category\nBug -> log + Slack + AI acknowledgement email. Feature -> backlog sheet. Praise -> kudos channel. Other -> log."
      },
      "typeVersion": 1
    }
