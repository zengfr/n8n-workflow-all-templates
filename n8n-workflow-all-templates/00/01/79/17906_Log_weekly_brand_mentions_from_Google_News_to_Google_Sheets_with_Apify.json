    {
      "id": "f1c4d538-0006-4a06-b006-000000000006",
      "name": "One row per article",
      "type": "n8n-nodes-base.code",
      "position": [
        1300,
        520
      ],
      "parameters": {
        "jsCode": "// One row per article, with the search term kept on every row so a sheet\n// covering several brands stays sortable.\nconst weekOf = $now.toFormat('yyyy-MM-dd');\n\nconst clip = (s, n) => {\n  const v = String(s || '').replace(/\\s+/g, ' ').trim();\n  return v.length > n ? v.slice(0, n - 3) + '...' : v;\n};\n\nconst rows = [];\nfor (const item of $input.all()) {\n  const term = (item.json.search_parameters || {}).q || '';\n  for (const a of item.json.news_results || []) {\n    rows.push({\n      json: {\n        'Week of': weekOf,\n        Watching: term,\n        Rank: a.position ?? '',\n        Headline: clip(a.title, 200),\n        Source: a.source || '',\n        Published: a.date || '',\n        Snippet: clip(a.snippet, 400),\n        Link: a.link || '',\n      },\n    });\n  }\n}\nreturn rows;\n"
      },
      "typeVersion": 2
    },
    {
