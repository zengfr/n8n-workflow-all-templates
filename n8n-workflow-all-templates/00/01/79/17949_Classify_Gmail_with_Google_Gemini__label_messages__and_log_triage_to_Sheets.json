    {
      "id": "eb47a3c2-80f3-49ed-8869-db5187934868",
      "name": "Email Classification Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        80,
        32
      ],
      "parameters": {
        "text": "=From: {{ $('When Email Received').item.json.from.text }}\nSubject: {{ $('When Email Received').item.json.subject }}\n\nBody:\n{{ $('When Email Received').item.json.text || $('When Email Received').item.json.snippet }}",
        "options": {
          "systemMessage": "You are an email triage assistant. Classify the email and return via the output parser:\n- category: exactly one of URGENT, CAN_WAIT, NEWSLETTER, SPAM.\n  URGENT = a real person needs a timely response (deadline, client/boss request, meeting, payment or account issue).\n  CAN_WAIT = a genuine message that needs a reply but is not time-sensitive.\n  NEWSLETTER = marketing, digests, notifications, automated updates; no personal reply expected.\n  SPAM = unsolicited junk, phishing, or scams.\n- needsReply: true only if a human reply is expected. Always false for NEWSLETTER and SPAM.\n- priorityScore: integer 1-10 (10 = most urgent).\n- summary: one sentence describing what the email wants.\n- sentiment: positive, neutral, or negative.\n- replyGuidance: 1-2 sentences on what a good reply should say (empty string if needsReply is false).\n- reasoning: brief reason for the classification.\n\nBe decisive. Never ask questions. Respond only through the parser."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
