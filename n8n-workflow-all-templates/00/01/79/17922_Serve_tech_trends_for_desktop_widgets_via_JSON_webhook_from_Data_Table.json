    {
      "id": "1a086ed6-1eb4-49aa-8486-3e552bd4a47b",
      "name": "Format Trends for Desktop",
      "type": "n8n-nodes-base.code",
      "position": [
        496,
        0
      ],
      "parameters": {
        "jsCode": "const all = $input.all();\nconst newsItems = [];\nconst youtubeItems = [];\nfor (let i = 0; i < all.length; i++) {\n  const row = all[i].json;\n  if (!row || !row.title) continue;\n  if (row.source === \"youtube\") {\n    youtubeItems.push({ rank: row.rank, title: row.title });\n  } else {\n    newsItems.push({ rank: row.rank, title: row.title });\n  }\n}\nnewsItems.sort(function(a, b) { return a.rank - b.rank; });\nyoutubeItems.sort(function(a, b) { return a.rank - b.rank; });\nconst news = newsItems.slice(0, 3).map(function(i) { return \"• \" + i.title; });\nconst youtube = youtubeItems.slice(0, 3).map(function(i) { return \"▶ \" + i.title; });\nreturn [{ json: { output: JSON.stringify({ news: news, youtube: youtube }) } }];"
      },
      "typeVersion": 2
    },
