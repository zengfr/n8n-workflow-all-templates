              "id": "61d9e339-0a62-42c6-8e1c-71c9d88e32b9",
              "name": "candidateEmail",
              "type": "string",
              "value": "={{ $json.replyTo.text }}"
            },
            {
              "id": "db19c417-706a-49f5-ae61-4badce206fd8",
              "name": "subject",
              "type": "string",
              "value": "={{ $json.subject }}"
            },
            {
              "id": "14d21a5e-0fae-4049-9420-cf3f29576ee0",
              "name": "companyEmail",
              "type": "string",
              "value": "={{ $json.to.text }}"
            }
