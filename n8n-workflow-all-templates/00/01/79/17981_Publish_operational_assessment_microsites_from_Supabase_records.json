    {
      "id": "4cd1ddf7-f869-4461-9a13-1ef63f38c44e",
      "name": "Split Assessment Records",
      "type": "n8n-nodes-base.code",
      "position": [
        1720,
        560
      ],
      "parameters": {
        "jsCode": "const records = Array.isArray($json) ? $json : [];\nreturn records.map(record => ({ json: record }));"
      },
      "typeVersion": 2
    },
    {
      "id": "8181b46c-b2d3-4129-b556-4a3f014cbfbb",
      "name": "Validate Assessment",
      "type": "n8n-nodes-base.code",
      "position": [
        2000,
        560
      ],
      "parameters": {
        "jsCode": "const record = $json;\nconst company = String(record.company || '').trim();\nconst slug = String(record.microsite_slug || record.slug || '').trim().toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '');\nconst summary = String(record.assessment_summary || '').trim();\nconst missing = [];\nif (!record.id) missing.push('id');\nif (!company) missing.push('company');\nif (!slug) missing.push('microsite_slug');\nif (!summary) missing.push('assessment_summary');\nreturn [{json:{...record,company,microsite_slug:slug,valid:missing.length===0,validation_error:missing.length?`Missing required fields: ${missing.join(', ')}`:''}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "14ada281-fcdf-4029-b475-2fbfada4ef2e",
      "name": "If Assessment Is Valid",
      "type": "n8n-nodes-base.if",
      "position": [
        2280,
        560
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 3,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "f9126ada-afb9-4590-aa1d-42ca1fa5c2d1",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "leftValue": "={{ $json.valid }}",
              "rightValue": true
            }
          ]
        }
      },
      "typeVersion": 2.3
    },
    {
      "id": "bfd0db65-2156-4d49-bbf6-a624b910f1a9",
      "name": "Build Microsite Content",
      "type": "n8n-nodes-base.code",
      "position": [
        2560,
        460
      ],
      "parameters": {
        "jsCode": "const record=$json; const setup=$('Set Microsite Settings').first().json;\nconst painPoints=Array.isArray(record.pain_points)?record.pain_points.filter(Boolean).slice(0,4):[];\nconst opportunities=Array.isArray(record.opportunity_ideas)?record.opportunity_ideas.filter(Boolean).slice(0,4):[];\nconst titles=['Where work slows down','Where coordination costs time','Where manual handoffs create risk','Where reporting delays decisions'];\nconst cards=painPoints.length?painPoints.map((body,i)=>({title:titles[i]||`Operational challenge ${i+1}`,body:String(body)})):[\n {title:'Where work slows down',body:'Manual coordination across teams can create avoidable delays and rework.'},\n {title:'Where automation may help',body:'Repeated handoffs, updates and reporting steps are useful candidates for structured automation.'},\n {title:'A safe first pilot',body:'Start with one visible workflow where time, quality and effort can be measured before and after.'}\n];\nconst defaultIdeas=['Automate recurring status updates from agreed source systems.','Route operational exceptions to the right owner with context attached.','Replace manual reporting assembly with a scheduled summary.','Create a controlled intake and approval workflow for high-volume requests.'];\nconst micrositeUrl=`${String(setup.public_site_base_url).replace(/\\/$/,'')}/${record.microsite_slug}`;\nreturn [{json:{source_record_id:record.id,microsite_url:micrositeUrl,page:{slug:record.microsite_slug,company:record.company,industry:String(record.industry||'general'),page_title:record.page_title||`Operational Assessment — ${record.company}`,hero_headline:record.hero_headline||`An operational assessment for ${record.company}`,hero_subheadline:record.hero_subheadline||'A focused view of operational friction, improvement opportunities and a practical first step.',assessment_summary:record.assessment_summary,primary_observation:record.primary_observation||'The most valuable opportunities often sit between teams and systems: repeated coordination, manual handoffs and reporting work that grows with operational volume.',recommended_next_step:record.recommended_next_step||'Select one high-frequency workflow, document the current effort and quality baseline, then test a controlled improvement with clear ownership.',risk_note:record.risk_note||'Adding tools without simplifying the operating process can increase complexity rather than reduce it.',cards,opportunity_ideas:opportunities.length?opportunities:defaultIdeas,status:'published',published_url:micrositeUrl,published_at:new Date().toISOString(),cta:{label:setup.cta_label,url:setup.booking_url}}}}];"
      },
      "typeVersion": 2
    },
