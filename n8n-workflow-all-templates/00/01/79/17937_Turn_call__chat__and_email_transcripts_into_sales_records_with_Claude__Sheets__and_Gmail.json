        "formDescription": "Paste any call, chat, or email transcript. You get a structured summary, the extracted deal facts, and a ready-to-send follow-up in seconds."
      },
      "typeVersion": 2.6
    },
    {
      "id": "13f1dbdd-f65f-4170-92e7-e1962efbb351",
      "name": "POST Analyze Conversation Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [
        220,
        440
      ],
      "webhookId": "c95ff914-9a4a-4966-9cba-4f753572efdb",
      "parameters": {
        "path": "analyze-conversation",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "b614f2d9-7f1e-41bd-a4f3-b54d96848dfb",
      "name": "Normalize Conversation Data",
      "type": "n8n-nodes-base.code",
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst b = raw.body || raw;\nconst transcript = String(b.transcript || b.Transcript || '');\nconst channel = String(b.channel || b.Channel || 'unknown').toLowerCase();\nconst source = raw.body ? 'api' : 'form';\nreturn [{ json: { received_at: $now.toISO(), source, channel, transcript } }];",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
    {
      "id": "29fe9807-fb4c-4632-8ffe-0d9d7c3e2707",
      "name": "Process with Claude AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        800,
        304
      ],
      "parameters": {
        "text": "=You are a senior sales operations analyst. Read this {{ $json.channel }} transcript and extract the record.\n\nTranscript:\n{{ $json.transcript }}\n\nReturn strict JSON only, no prose: {\"summary\": \"three sentences maximum\", \"contact_name\": \"\", \"company\": \"\", \"needs\": \"\", \"intent\": \"buying\" | \"exploring\" | \"support\" | \"unclear\", \"budget\": \"\", \"timeline\": \"\", \"objections\": \"\", \"urgency\": \"high\" | \"medium\" | \"low\", \"next_action\": \"one concrete recommended step for the rep\", \"follow_up_message\": \"a short ready-to-send follow-up in the tone of the conversation, under 120 words\"}\n\nRules: only use facts stated in the transcript, leave a field as an empty string when the information is not present, and never invent names, numbers or commitments.",
        "batching": {},
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
    {
      "id": "f3387288-ba77-437a-a098-10d40c58b0c1",
      "name": "Claude Sonnet Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "position": [
        784,
        624
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-4-6",
          "cachedResultName": "Claude Sonnet 4.6"
        },
        "options": {
          "effort": "low",
          "thinkingMode": "adaptive",
          "maxTokensToSample": 2048
        }
      },
      "typeVersion": 1.5
    },
    {
      "id": "423b8456-3a47-4268-ab70-76d44c35dd44",
      "name": "Parse and Structure Output",
      "type": "n8n-nodes-base.code",
      "position": [
        1056,
        304
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const base = $('Normalize Conversation Data').first().json;\nlet ai = {};\ntry { ai = JSON.parse($input.first().json.text.replace(/```json|```/g, '').trim()); } catch (e) { ai = { summary: 'AI parse failed, review manually', contact_name: '', company: '', needs: '', intent: 'unclear', budget: '', timeline: '', objections: '', urgency: 'high', next_action: 'Manual review', follow_up_message: '' }; }\nconst readable = [\n  'CONVERSATION SUMMARY (' + base.channel + ')',\n  '',\n  ai.summary,\n  '',\n  'Contact: ' + (ai.contact_name || 'unknown') + (ai.company ? ' at ' + ai.company : ''),\n  'Intent: ' + ai.intent + '  |  Urgency: ' + ai.urgency,\n  'Needs: ' + (ai.needs || 'not stated'),\n  'Budget: ' + (ai.budget || 'not stated') + '  |  Timeline: ' + (ai.timeline || 'not stated'),\n  'Objections: ' + (ai.objections || 'none raised'),\n  '',\n  'NEXT ACTION: ' + ai.next_action,\n  '',\n  'SUGGESTED FOLLOW-UP:',\n  ai.follow_up_message\n].join('\\n');\nreturn [{ json: { ...base, ...ai, readable } }];",
        "language": "javaScript"
      },
      "typeVersion": 2
    },
    {
