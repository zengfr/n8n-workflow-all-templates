    {
      "id": "53226400-eaad-4cd2-8980-b55509ace1dc",
      "name": "Parse LINE Event",
      "type": "n8n-nodes-base.code",
      "position": [
        272,
        48
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || {};\nconst ev = (b.events && b.events[0]) || {};\nconst msg = ev.message || {};\nreturn { replyToken: ev.replyToken || '', userId: (ev.source && ev.source.userId) || '', type: msg.type || '', text: msg.text || '' };"
      },
      "typeVersion": 2
    },
    {
