        0,
        -160
      ],
      "parameters": {
        "color": 7,
        "width": 620,
        "height": 504,
        "content": "## 1. Receive & parse\nLINE calls the webhook; a Code node extracts the text and reply token. Non-text messages are ignored."
      },
      "typeVersion": 1
    },
    {
      "id": "e4890e86-d387-41b8-a990-06752fddb167",
      "name": "S2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        640,
