    {
      "id": "0d94cdd6-3a8a-40e1-b44f-2fe5bdb98a30",
      "name": "Extract Requested Data",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        3088,
        0
      ],
      "parameters": {
        "text": "={{ \"Page URL: \" + $(\"Normalize Scraped Content\").item.json.scraped_url + \"\\n\\nRequested fields:\\n\" + $(\"Normalize Input\").item.json.target_data.map(d => \"- \" + d.name + \": \" + d.description).join(\"\\n\") + \"\\n\\nPage content (Markdown):\\n\" + $(\"Normalize Scraped Content\").item.json.scraped_content.slice(0, 12000) }}",
        "options": {
          "systemMessage": "You are a precise data-extraction assistant. Only use information present in the provided page content. If a requested field cannot be found on the page, set its value to the string \"NA\". Never invent data."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
