      "id": "38701e7e-4499-4e3c-be26-bd7d4e765482",
      "name": "Scrape Page with Apify",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Uses apify/website-content-crawler: crawls the resolved URL, follows optional login cookies, and returns clean Markdown content (no browser automation to maintain).",
      "onError": "continueErrorOutput",
      "maxTries": 3,
      "position": [
        2240,
        0
      ],
      "parameters": {
        "url": "https://api.apify.com/v2/acts/apify~website-content-crawler/run-sync-get-dataset-items",
        "method": "POST",
        "options": {
          "timeout": "={{ $(\"Configuration\").item.json.request_timeout_seconds * 1000 }}"
        },
        "jsonBody": "={{ { startUrls: [{ url: $json.resolved_url }], crawlerType: $(\"Configuration\").item.json.crawler_type, maxCrawlDepth: $(\"Configuration\").item.json.max_crawl_depth, maxCrawlPages: $(\"Configuration\").item.json.max_crawl_pages, saveMarkdown: true, initialCookies: ($(\"Normalize Input\").item.json.cookies || []).map(c => ({ name: c.name, value: c.value, domain: c.domain, path: c.path || \"/\", expires: c.expirationDate || -1, httpOnly: !!c.httpOnly, secure: !!c.secure, sameSite: ({unspecified: \"None\", lax: \"Lax\", strict: \"Strict\"}[c.sameSite] || ([\"Strict\",\"Lax\",\"None\"].includes(c.sameSite) ? c.sameSite : \"Lax\")) })) } }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "dx4Ha8066t5Hlkqk",
          "name": "Apify API"
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.4,
      "waitBetweenTries": 5000
    },
