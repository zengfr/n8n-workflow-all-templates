              "type": "string",
              "value": "={{ \"Invoice-\" + $('SET – Wrap Form Data').item.json.form_data.invoice_no + \"-\" + $('SET – Wrap Form Data').item.json.form_data.fullName.replace(/\\s+/g, \"_\") }}"
