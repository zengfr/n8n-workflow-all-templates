    {
      "id": "654bbed1-52a2-432a-8440-1d3a907b8c15",
      "name": "AI Invoice Assistant",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        736,
        -304
      ],
      "parameters": {
        "text": "={{ 'Vendor: ' + $json.vendor_name + ' | Email: ' + $json.vendor_email + ' | Invoice: ' + $json.invoice_number + ' | Amount: ' + $json.amount + ' ' + $json.currency + ' | Category: ' + $json.category + ' | Due: ' + $json.due_date }}",
        "options": {
          "systemMessage": "You are the accounts payable assistant for a small business. Use the VendorMaster tool to look up the vendor (match by vendor_name or vendor_email) and the ApprovalPolicy tool to read the approval rules. Decide: auto-approve the invoice if the amount is at or below the auto_approve_limit AND the vendor is known; otherwise route to human review with the correct suggested approver (use the vendor's default_approver from VendorMaster, or user@example.com if unknown). Write a short, professional reason. Return ONLY valid JSON with double quoted keys and no code fences: {\"decision\":\"auto_approve\" or \"review\",\"suggested_approver\":\"email\",\"reason\":\"...\",\"confidence\":0.0to1.0}. No markdown, no emojis, no text outside the JSON."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
