    {
      "id": "ae2173a4-712d-4d11-8b18-4f4e4ea516ad",
      "name": "Parse Invoice Decision",
      "type": "n8n-nodes-base.code",
      "position": [
        1136,
        -192
      ],
      "parameters": {
        "jsCode": "const base = $('Normalize Invoice').first().json;\nconst item = $input.first().json;\nlet raw = String(item.output || '').replace(/```json/gi,'').replace(/```/g,'').trim();\nraw = raw.replace(/\\\\\\\\\\\\\\\"/g,'\\\\\\\\\"').replace(/\\\\\\\\\\\\\\\\/g,'\\\\\\\\');\nlet parsed = {};\ntry { parsed = JSON.parse(raw); } catch(e) { const m = raw.match(/\\{[\\s\\S]*\\}/); if (m) { try { parsed = JSON.parse(m[0]); } catch(e2) {} } }\nconst decision = ['auto_approve','review'].includes(String(parsed.decision||'').toLowerCase()) ? parsed.decision.toLowerCase() : 'review';\nconst approver = parsed.suggested_approver || 'user@example.com';\nconst amt = parseFloat(String(base.amount).replace(/[^0-9.]/g,'')) || 0;\nlet approval_due = base.received_at;\ntry { const d = new Date(base.received_at); d.setDate(d.getDate()+2); approval_due = d.toISOString(); } catch(e){}\nlet due = base.due_date;\nif (!due) { try { const d = new Date(base.received_at); d.setDate(d.getDate()+30); due = d.toISOString().slice(0,10); } catch(e){} }\nreturn [{ json: { ...base, amount: String(amt), approval_due: approval_due, due_date: due,\n  decision: decision, suggested_approver: approver, reason: parsed.reason || 'Needs review',\n  confidence: parsed.confidence != null ? parsed.confidence : 0.6, status: 'pending' } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "d77bcda3-952b-42c3-8945-e57b58decf99",
      "name": "Route Approval Decision",
      "type": "n8n-nodes-base.code",
      "position": [
        1360,
        -192
      ],
      "parameters": {
        "jsCode": "const a = $input.first().json;\nconst amt = parseFloat(String(a.amount).replace(/[^0-9.]/g,'')) || 0;\nconst known = ['Acme Office Supplies','CloudHost Labs','GreenClean Services'].includes(a.vendor_name);\nlet finalDecision = a.decision;\nif (finalDecision === 'auto_approve') {\n  if (amt > 500000 || !known) { finalDecision = 'review'; a.reason = (a.reason||'') + ' (Policy: over limit or unknown vendor, escalated to review).'; }\n}\nconst needs_human = finalDecision === 'review';\nreturn [{ json: { ...a, decision: finalDecision, needs_human: needs_human } }];"
      },
      "typeVersion": 2
    },
