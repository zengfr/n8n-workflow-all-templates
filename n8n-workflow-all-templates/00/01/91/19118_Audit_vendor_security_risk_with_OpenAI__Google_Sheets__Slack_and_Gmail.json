    {
      "id": "5be21254-0a81-4f81-9e60-e5c195b81125",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        864,
        2208
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"overallRiskScore\": {\n      \"type\": \"number\",\n      \"description\": \"0-100, higher = riskier\"\n    },\n    \"riskTier\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Critical\",\n        \"High\",\n        \"Medium\",\n        \"Low\"\n      ]\n    },\n    \"executiveSummary\": {\n      \"type\": \"string\"\n    },\n    \"recommendations\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"overallRiskScore\",\n    \"riskTier\",\n    \"executiveSummary\",\n    \"recommendations\"\n  ]\n}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "39c43dd6-c736-4208-8972-4e3c69331d6d",
      "name": "Vendor Risk Analysis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "onError": "continueErrorOutput",
      "position": [
        640,
        1936
      ],
      "parameters": {
        "text": "=You are a security risk auditor. Score this vendor from the findings below.\n\nVendor: {{ $json.vendorName }}\nWebsite: {{ $json.vendorWebsite }}\nData access level: {{ $json.dataAccessLevel }}\n\nFindings:\n{{ $json.rawFindingsForAgent }}\n\nWeigh missing security headers, a young domain, any breach history, and no privacy policy as risk factors — and weigh them more heavily if the data access level is Confidential or PII/Sensitive. Output your assessment per the schema.",
        "options": {
          "systemMessage": "Be evidence-based. Only use the findings you were given — don't invent evidence."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.9
    },
    {
      "id": "89021a33-eaa2-4596-99d4-83efa2e2b0e2",
      "name": "Parse Agent Output",
      "type": "n8n-nodes-base.code",
      "position": [
        1040,
        1920
      ],
      "parameters": {
        "jsCode": "const src = $input.item.json;\nconst out = src.output ?? src;\nconst tier = out.riskTier || 'Medium';\nconst nextAuditDays = { Critical: 30, High: 90, Medium: 180, Low: 365 }[tier] ?? 180;\nconst next = new Date();\nnext.setDate(next.getDate() + nextAuditDays);\nreturn [{ json: {\n  ...$('Compile Findings').first().json,\n  overallRiskScore: out.overallRiskScore ?? 50,\n  riskTier: tier,\n  executiveSummary: out.executiveSummary ?? '',\n  recommendations: out.recommendations ?? [],\n  nextAuditDate: next.toISOString().slice(0,10)\n} }];\n"
      },
      "typeVersion": 2
    },
