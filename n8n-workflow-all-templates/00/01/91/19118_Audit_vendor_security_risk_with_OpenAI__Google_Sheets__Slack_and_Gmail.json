    {
      "id": "00cf0df8-d964-4b84-a18d-cc4ee80a208e",
      "name": "Compile Findings",
      "type": "n8n-nodes-base.code",
      "position": [
        464,
        1936
      ],
      "parameters": {
        "jsCode": "const vendor = $('Set - Vendor Data').first().json;\nconst homepage = $json; // this node's own input = Fetch Website Headers output\nconst rdap = $('Check Domain Age (RDAP)').first().json;\nconst hibp = $('Check Breach History (HIBP)').first().json;\n\n// Security headers\nconst headers = homepage.headers || {};\nconst has = (n) => Object.keys(headers).some(h => h.toLowerCase() === n);\nconst headerChecks = ['strict-transport-security','content-security-policy','x-frame-options','x-content-type-options','referrer-policy'];\nconst passed = headerChecks.filter(has).length;\nconst headerScore = Math.round((passed / headerChecks.length) * 100);\n\n// Domain age from RDAP\nconst events = (rdap.body || {}).events || [];\nconst reg = events.find(e => e.eventAction === 'registration');\nconst domainAgeYears = reg ? Math.round(((Date.now() - new Date(reg.eventDate).getTime()) / (1000*60*60*24*365.25)) * 10) / 10 : 0;\n\n// Breach check\nconst domain = vendor.vendorWebsite.replace('https://','').replace('http://','').split('/')[0].replace('www.','');\nconst breaches = Array.isArray(hibp.body) ? hibp.body : [];\nconst breachCount = breaches.filter(b => (b.Domain||'').toLowerCase() === domain.toLowerCase()).length;\n\n// Rough privacy policy check: look for the word 'privacy' on the homepage itself\nconst privacyPolicyFound = /privacy/i.test(homepage.body || '');\n\nconst summary = { ...vendor, headerScore, domainAgeYears, breachCount, privacyPolicyFound };\nreturn [{ json: { ...summary, rawFindingsForAgent: JSON.stringify(summary) } }];\n"
      },
      "typeVersion": 2
    },
