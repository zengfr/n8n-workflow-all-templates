    {
      "id": "code-0009",
      "name": "Score the opportunity",
      "type": "n8n-nodes-base.code",
      "position": [
        1460,
        -40
      ],
      "parameters": {
        "jsCode": "// Opportunity score favours volume, low competition and cheap clicks.\nconst source = $('Keyword rows only (skip the run summary)').all();\nconst rows = $input.all().map((item, i) => {\n  const row = { ...(source[i] ? source[i].json : {}) };\n  const ai = item.json.output || {};\n  const volume = Number(row.avgMonthlySearches) || 0;\n  const competition = Number(row.competitionIndex) || 0;\n  const cpc = Number(row.cpcUsd) || 0;\n  const score = Math.round((volume * (1 - competition / 100)) / Math.max(cpc, 0.05) * 10) / 10;\n  return { ...row, ...ai, opportunity_score: score };\n});\nrows.sort((a, b) => b.opportunity_score - a.opportunity_score);\nreturn rows.map((row, i) => ({ json: { ...row, rank: i + 1 } }));"
      },
      "typeVersion": 2
    },
