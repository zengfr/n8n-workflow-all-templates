    {
      "id": "1e5efb77-d53c-4fcb-a0bc-2ed47791f75b",
      "name": "Calculate stamps and streak",
      "type": "n8n-nodes-base.code",
      "position": [
        752,
        80
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst j = $('Parse judgement').first().json;\n\nconst childName = cfg.CHILD_NAME;\nconst goal = Number(cfg.STAMPS_PER_REWARD) || 10;\n\n// Past records (survive an empty sheet)\nlet rows = [];\ntry {\n  rows = $('Read past records').all().map(i => i.json).filter(r => r && r.Date);\n} catch (e) {\n  rows = [];\n}\nconst mine = rows.filter(r => String(r['Child Name']) === String(childName));\n\n// Today's result\nconst today = $now.toFormat('yyyy-MM-dd');\nconst earnedToday = j.clean_plate ? 1 : 0;\nconst totalStamps = mine.reduce((s, r) => s + (Number(r['Stamps Earned']) || 0), 0) + earnedToday;\n\n// Consecutive days\nconst byDate = {};\nfor (const r of mine) {\n  const d = String(r.Date);\n  if (String(r['Clean Plate']).toUpperCase() === 'TRUE') byDate[d] = true;\n}\nif (j.clean_plate) byDate[today] = true;\n\nlet streak = 0;\nlet cursor = $now;\nwhile (byDate[cursor.toFormat('yyyy-MM-dd')]) {\n  streak++;\n  cursor = cursor.minus({ days: 1 });\n}\n\n// Stamp card\nconst inCycle = totalStamps % goal;\nconst rewardReached = totalStamps > 0 && inCycle === 0;\nconst filled = rewardReached ? goal : inCycle;\nconst remaining = rewardReached ? 0 : goal - inCycle;\nconst card = '⭐'.repeat(filled) + '☆'.repeat(Math.max(0, goal - filled));\n\n// Message to send back to LINE\nlet message;\nif (!j.is_plate) {\n  message = 'That does not look like a plate. Send a photo of the plate after the meal and I will take a look!';\n} else if (j.clean_plate) {\n  message = `${j.praise}\\n\\n${card}\\n${totalStamps} stamps  /  ${streak}-day streak`;\n  message += rewardReached ? '\\n\\nReward unlocked!' : `\\n${remaining} more to go!`;\n} else {\n  message = `${j.praise}\\n\\n${card}\\n${totalStamps} stamps\\nStill on the plate: ${j.leftovers}`;\n}\n\nreturn [{\n  json: {\n    date: today,\n    time: $now.toFormat('HH:mm'),\n    childName,\n    isPlate: j.is_plate,\n    score: j.score,\n    cleanPlate: j.clean_plate,\n    leftovers: j.leftovers,\n    praise: j.praise,\n    earnedToday,\n    totalStamps,\n    streak,\n    remaining,\n    rewardReached,\n    card,\n    message\n  }\n}];"
      },
      "typeVersion": 2
    },
