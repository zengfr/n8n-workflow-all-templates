    {
      "id": "6a6f23cf-0e43-4ae1-8a89-3b36da30479f",
      "name": "Search Answer on Google",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1216,
        544
      ],
      "parameters": {
        "url": "Search_URL_link_here",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"q\": \"{{ $json.Question }}\",\n  \"num\": 5\n}",
        "sendBody": true,
        "jsonHeaders": "{\n  \"X-API-KEY\": \"YOUR_API_KEY\",\n  \"Content-Type\": \"application/json\"\n}",
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "json"
      },
      "typeVersion": 4.4
    },
    {
      "id": "d327b4dd-f0a0-4042-9971-92670941110d",
      "name": "Prepare Search Results for AI",
      "type": "n8n-nodes-base.code",
      "position": [
        1408,
        544
      ],
      "parameters": {
        "jsCode": "const results = items[0].json.organic || [];\n\nlet summaries = results.slice(0, 3).map(r => {\n  return `Title: ${r.title}\\nSnippet: ${r.snippet}\\nLink: ${r.link}`;\n});\n\nreturn [\n  {\n    json: {\n      question: $json.question,\n      answer: $json.answer,\n      sources: summaries.join(\"\\n\\n\")\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
    {
      "id": "809ffddb-5309-4200-afee-cc71bcbb98c7",
      "name": "Check Answer with AI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1696,
        544
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4-turbo",
          "cachedResultName": "GPT-4-TURBO"
        },
        "options": {},
        "responses": {
          "values": [
            {
              "content": "=You are an AI fact-checker.\n\nQuestion:\n{{ $('Extract Question & Answer').item.json.Question }}\n\nAnswer:\n{{ $('Extract Question & Answer').item.json.Answer }}\n\nSources:\n{{ $json.sources }}\n\nTasks:\n1. Check if the answer is correct\n2. Give confidence score (0-100)\n3. Explain reasoning\n4. Classify as: SAFE / SUSPICIOUS / HALLUCINATED\n\nReturn ONLY valid JSON (no markdown, no ```):\n\n{\n  \"confidence\": 0,\n  \"reason\": \"\"\n}"
            }
          ]
        },
        "builtInTools": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "yOfw9W9XwQefVROR",
          "name": "OpenAI (PAID) (AI-ML Team)"
        }
      },
      "typeVersion": 2.1
    },
    {
      "id": "1aded53e-f953-4967-84e6-dd39e04fd47c",
      "name": "Calculate Risk Level",
      "type": "n8n-nodes-base.code",
      "position": [
        2016,
        544
      ],
      "parameters": {
        "jsCode": "const confidence = $json.confidence;\n\nlet status = \"\";\n\nif (confidence >= 80) {\n  status = \"SAFE\";\n} else if (confidence >= 50) {\n  status = \"SUSPICIOUS\";\n} else {\n  status = \"HALLUCINATED\";\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      status\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
    {
      "id": "0d79eaa0-65a9-49b2-a530-b48acd06c29f",
      "name": "Convert AI Response to Data",
      "type": "n8n-nodes-base.code",
      "position": [
        2208,
        544
      ],
      "parameters": {
        "jsCode": "return [\n  {\n    json: JSON.parse($json.output[0].content[0].text)\n  }\n];"
      },
      "typeVersion": 2
    },
    {
