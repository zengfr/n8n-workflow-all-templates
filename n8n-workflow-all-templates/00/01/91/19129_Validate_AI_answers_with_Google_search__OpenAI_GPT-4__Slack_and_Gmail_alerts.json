                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "HALLUCINATED",
                    "rightValue": "={{ $json.classification }}"
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 3.4
    },
