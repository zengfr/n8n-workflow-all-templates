    {
      "id": "6a328555-c393-427f-b960-91ed361557ce",
      "name": "Normalize Check",
      "type": "n8n-nodes-base.code",
      "position": [
        -1328,
        304
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nif (!body.service_key || String(body.service_key).trim() === '') {\n  throw new Error('service_key is required');\n}\n\nreturn [{\n  json: {\n    request_type: 'check',\n    service_key: String(body.service_key).trim(),\n    now: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "71614ddd-8cab-44af-8c19-2877409800a1",
      "name": "Normalize Result",
      "type": "n8n-nodes-base.code",
      "position": [
        -1328,
        960
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nif (!body.service_key || String(body.service_key).trim() === '') {\n  throw new Error('service_key is required');\n}\n\nconst validBoolean =\n  body.success === true ||\n  body.success === false ||\n  body.success === 'true' ||\n  body.success === 'false';\n\nif (!validBoolean) {\n  throw new Error('success must be true or false');\n}\n\nreturn [{\n  json: {\n    request_type: 'result',\n    service_key: String(body.service_key).trim(),\n    success: body.success === true || body.success === 'true',\n    error: body.error ? String(body.error) : '',\n    now: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "bf6ca4ba-8c46-461c-98d3-0fa06ec5b2fc",
      "name": "Configure Circuit Breaker",
      "type": "n8n-nodes-base.code",
      "position": [
        -1104,
        608
      ],
      "parameters": {
        "jsCode": "const config = {\n  failure_threshold: 3,\n  cooldown_minutes: 5\n};\n\nif (\n  !Number.isInteger(config.failure_threshold) ||\n  config.failure_threshold < 1\n) {\n  throw new Error('failure_threshold must be a positive integer');\n}\n\nif (\n  !Number.isFinite(config.cooldown_minutes) ||\n  config.cooldown_minutes <= 0\n) {\n  throw new Error('cooldown_minutes must be greater than zero');\n}\n\nreturn [{ json: { ...$json, config } }];"
      },
      "typeVersion": 2
    },
