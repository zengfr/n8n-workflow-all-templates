    {
      "id": "fc692b83-07ff-4588-98c5-2bf91899250b",
      "name": "Evaluate Circuit",
      "type": "n8n-nodes-base.code",
      "position": [
        -432,
        336
      ],
      "parameters": {
        "jsCode": "const input = $('Configure Circuit Breaker').first().json;\nconst circuit = $json;\nconst now = new Date(input.now);\nconst threshold = Number(\n  circuit.failure_threshold || input.config.failure_threshold\n);\n\nif (!circuit.service_key) {\n  return [{\n    json: {\n      route: 'create',\n      service_key: input.service_key,\n      state: 'closed',\n      allow_request: true,\n      action: 'allow_request',\n      failure_count: 0,\n      failure_threshold: threshold,\n      opened_at: null,\n      open_until: null,\n      last_checked_at: now.toISOString(),\n      last_success_at: null,\n      last_failure_at: null,\n      last_error: '',\n      retry_after_seconds: 0\n    }\n  }];\n}\n\nconst state = circuit.state || 'closed';\n\nif (state === 'closed') {\n  return [{\n    json: {\n      route: 'respond',\n      ...circuit,\n      state: 'closed',\n      allow_request: true,\n      action: 'allow_request',\n      retry_after_seconds: 0\n    }\n  }];\n}\n\nif (state === 'half_open') {\n  return [{\n    json: {\n      route: 'respond',\n      ...circuit,\n      state: 'half_open',\n      allow_request: false,\n      action: 'trial_in_progress',\n      retry_after_seconds: 0\n    }\n  }];\n}\n\nif (state !== 'open') {\n  throw new Error('Unsupported circuit state: ' + state);\n}\n\nconst openUntil = circuit.open_until\n  ? new Date(circuit.open_until)\n  : null;\nconst validOpenUntil =\n  openUntil && !Number.isNaN(openUntil.getTime());\n\nif (validOpenUntil && openUntil > now) {\n  return [{\n    json: {\n      route: 'respond',\n      ...circuit,\n      state: 'open',\n      allow_request: false,\n      action: 'circuit_open',\n      retry_after_seconds: Math.ceil(\n        (openUntil.getTime() - now.getTime()) / 1000\n      )\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    route: 'half_open',\n    ...circuit,\n    state: 'half_open',\n    allow_request: true,\n    action: 'trial_request',\n    last_checked_at: now.toISOString(),\n    retry_after_seconds: 0\n  }\n}];"
      },
      "typeVersion": 2
    },
