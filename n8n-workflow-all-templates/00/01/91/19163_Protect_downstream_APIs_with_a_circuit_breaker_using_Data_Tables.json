    {
      "id": "6a44b912-7df7-487f-bfd4-2a5e95592275",
      "name": "Build Check Result",
      "type": "n8n-nodes-base.code",
      "position": [
        288,
        368
      ],
      "parameters": {
        "jsCode": "const decision = $('Evaluate Circuit').first().json;\n\nreturn [{\n  json: {\n    service_key: decision.service_key,\n    state: decision.state,\n    allow_request: decision.allow_request,\n    action: decision.action,\n    failure_count: Number(decision.failure_count || 0),\n    failure_threshold: Number(decision.failure_threshold || 0),\n    open_until: decision.open_until ?? null,\n    retry_after_seconds: Number(\n      decision.retry_after_seconds || 0\n    )\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "e6782b87-888b-4f08-99bb-84ba20ac01e6",
      "name": "Apply Service Result",
      "type": "n8n-nodes-base.code",
      "position": [
        -432,
        976
      ],
      "parameters": {
        "jsCode": "const input = $('Configure Circuit Breaker').first().json;\nconst circuit = $json;\n\nif (!circuit.service_key) {\n  throw new Error(\n    'No circuit found. Call the check endpoint before reporting a result.'\n  );\n}\n\nconst now = new Date(input.now);\nconst threshold = Number(\n  circuit.failure_threshold || input.config.failure_threshold\n);\n\nif (input.success) {\n  return [{\n    json: {\n      service_key: circuit.service_key,\n      action: 'circuit_closed',\n      state: 'closed',\n      failure_count: 0,\n      failure_threshold: threshold,\n      opened_at: null,\n      open_until: null,\n      last_checked_at: circuit.last_checked_at ?? now.toISOString(),\n      last_success_at: now.toISOString(),\n      last_failure_at: circuit.last_failure_at ?? null,\n      last_error: ''\n    }\n  }];\n}\n\nconst failureCount = Number(circuit.failure_count || 0) + 1;\nconst shouldOpen =\n  circuit.state === 'half_open' ||\n  failureCount >= threshold;\n\nreturn [{\n  json: {\n    service_key: circuit.service_key,\n    action: shouldOpen ? 'circuit_opened' : 'failure_recorded',\n    state: shouldOpen ? 'open' : 'closed',\n    failure_count: failureCount,\n    failure_threshold: threshold,\n    opened_at: shouldOpen ? now.toISOString() : null,\n    open_until: shouldOpen\n      ? new Date(\n          now.getTime() +\n          Number(input.config.cooldown_minutes) * 60 * 1000\n        ).toISOString()\n      : null,\n    last_checked_at: circuit.last_checked_at ?? now.toISOString(),\n    last_success_at: circuit.last_success_at ?? null,\n    last_failure_at: now.toISOString(),\n    last_error: input.error\n  }\n}];"
      },
      "typeVersion": 2
    },
