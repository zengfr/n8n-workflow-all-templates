    {
      "id": "c301cbc9-3ef0-4488-a6ab-40cd341b43ed",
      "name": "Generate Weekly Digest",
      "type": "n8n-nodes-base.code",
      "position": [
        420,
        600
      ],
      "parameters": {
        "jsCode": "// Summarise the last 7 days of the lead log into one Telegram message\nconst rows = $input.all().map(i => i.json).filter(r => r && r.Email);\nconst counts = { Hot: 0, Warm: 0, Cold: 0, Review: 0 };\nfor (const r of rows) {\n  const tier = String(r.Tier || 'Review');\n  counts[tier] = (counts[tier] || 0) + 1;\n}\nconst scored = rows\n  .filter(r => r.Score !== '' && r.Score !== null && r.Score !== undefined)\n  .map(r => Number(r.Score))\n  .filter(n => Number.isFinite(n));\nconst avg = scored.length ? Math.round(scored.reduce((a, b) => a + b, 0) / scored.length) : null;\nconst topHot = rows\n  .filter(r => r.Tier === 'Hot')\n  .sort((a, b) => Number(b.Score) - Number(a.Score))\n  .slice(0, 5);\n\nconst lines = ['📊 Weekly lead digest (last 7 days)', 'Total leads: ' + rows.length];\nlines.push('🔥 Hot: ' + counts.Hot + ' | 🌤 Warm: ' + counts.Warm + ' | ❄️ Cold: ' + counts.Cold + ' | ⚠️ Review: ' + counts.Review);\nlines.push('Average score: ' + (avg === null ? 'n/a' : avg + '/100'));\nif (topHot.length) {\n  lines.push('', 'Top hot leads:');\n  for (const r of topHot) lines.push('• ' + (r.Name || r.Email) + ' (' + (r.Company || 'no company') + ') - ' + r.Score);\n}\nif (!rows.length) lines.push('No new leads this week. Check that your form still points to the webhook.');\n\nreturn [{ json: { text: lines.join('\\n'), total: rows.length, ...counts, avg_score: avg } }];"
      },
      "typeVersion": 2
    },
