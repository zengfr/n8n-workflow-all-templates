              "name": "company",
              "type": "string",
              "value": "={{ ($json.body.company ?? $json.body.company_name ?? $json.body.organization ?? '').toString().trim() }}"
            },
            {
              "id": "1e4bc2bb-fc8d-41df-ab0f-9ecb7a4923f0",
              "name": "phone",
              "type": "string",
              "value": "={{ ($json.body.phone ?? $json.body.phone_number ?? $json.body.tel ?? '').toString().trim() }}"
            },
            {
              "id": "0c860ce2-848c-4df2-ab77-62d5080d3acc",
              "name": "website",
              "type": "string",
              "value": "={{ ($json.body.website ?? $json.body.url ?? '').toString().trim() }}"
            },
            {
              "id": "303b869e-36b0-404b-abdd-515b2aa4e98c",
              "name": "budget",
              "type": "string",
              "value": "={{ ($json.body.budget ?? $json.body.Budget ?? '').toString().trim() }}"
            },
            {
              "id": "f49291cf-975f-40e2-a9a2-e43ef2294439",
              "name": "timeline",
              "type": "string",
              "value": "={{ ($json.body.timeline ?? $json.body.start_date ?? $json.body.when ?? '').toString().trim() }}"
            },
            {
              "id": "7ca5e5ca-cf3d-4319-a3d7-ef5c3070c1a9",
              "name": "message",
              "type": "string",
              "value": "={{ ($json.body.message ?? $json.body.msg ?? $json.body.description ?? $json.body.details ?? $json.body.project ?? '').toString().trim() }}"
            },
            {
              "id": "85c9e759-2533-4e8a-a481-c273bcef363d",
              "name": "honeypot",
              "type": "string",
              "value": "={{ ($json.body.honeypot ?? $json.body._honey ?? $json.body.fax ?? '').toString().trim() }}"
            }
          ]
        },
        "includeOtherFields": false
      },
      "typeVersion": 3.4
    },
    {
      "id": "1db1fd25-596a-451a-aa49-a8b85143424b",
      "name": "Filter Valid Leads",
      "type": "n8n-nodes-base.filter",
      "position": [
        420,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": false,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-email-valid",
              "operator": {
                "type": "string",
                "operation": "regex"
              },
              "leftValue": "={{ $json.email }}",
              "rightValue": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$"
            },
            {
              "id": "c-email-disposable",
              "operator": {
                "type": "string",
                "operation": "notRegex"
              },
              "leftValue": "={{ $json.email }}",
              "rightValue": "@(mailinator|guerrillamail|10minutemail|tempmail|temp-mail|yopmail|trashmail|sharklasers|dispostable|getnada)\\."
            },
            {
              "id": "c-honeypot",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              },
              "leftValue": "={{ $json.honeypot }}"
            },
            {
              "id": "c-message",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.message }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "78a92520-fe68-4070-a3c5-74c796ec7300",
      "name": "Lead Scoring Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "onError": "continueErrorOutput",
      "position": [
        880,
        0
      ],
      "parameters": {
        "text": "=Lead received {{ $json.received_at }} via {{ $json.source }}\nName: {{ $json.name }}\nEmail: {{ $json.email }}\nCompany: {{ $json.company }}\nPhone: {{ $json.phone }}\nWebsite: {{ $json.website }}\nBudget: {{ $json.budget }}\nTimeline: {{ $json.timeline }}\nMessage:\n{{ $json.message }}",
        "options": {
          "systemMessage": "You qualify inbound sales leads for the business described below. Rate the lead on four criteria, 0-25 points each, using ONLY the information provided. Do not invent facts. When something is unknown, score it in the middle (10-13) and say so in the reasons.\n\n=== ABOUT YOUR BUSINESS (edit this block) ===\nWhat we sell: [e.g. custom web and automation development for online retailers]\nIdeal customer: [e.g. e-commerce businesses with 5-50 staff in Europe and North America]\nMinimum project budget: [e.g. 2,000 USD]\nNot a fit: [e.g. students, job seekers, agencies looking for white-label resellers, one-off bug fixes]\n=== END ===\n\nCriteria:\n- budget: how well the stated or implied budget matches our minimum project budget.\n- authority: is the person likely the decision maker (owner, founder, director, head of ...) or an intermediary.\n- need: how clearly the problem is described and how well it matches what we sell.\n- timeline: how soon they want to start (this month = 25, this quarter = 15-20, no timeline = 8).\n\nAlso provide: a one-sentence summary, 2-4 short reasons, the lead's language as an ISO 639-1 code, and a suggested reply (max 120 words, same language as the lead, friendly, confirm you understood the need, ask at most two clarifying questions, propose the next step, sign off as \"Sales team\"). No invented prices, dates or promises.\n\nReturn ONLY JSON that matches the schema."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
      "id": "6c32ce33-90f2-4276-a5be-265306a7389d",
      "name": "OpenAI GPT-4o-mini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        800,
        240
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "a8dd66f2-bbd7-4d2c-add2-ceb8a0f8412d",
      "name": "Apply Scoring JSON Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1020,
        240
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"budget\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 25,\n      \"description\": \"Budget fit, 0-25\"\n    },\n    \"authority\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 25,\n      \"description\": \"Decision-making authority, 0-25\"\n    },\n    \"need\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 25,\n      \"description\": \"Clarity and fit of the need, 0-25\"\n    },\n    \"timeline\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 25,\n      \"description\": \"Urgency, 0-25\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence about who the lead is and what they want\"\n    },\n    \"reasons\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"2-4 short reasons behind the scores\"\n    },\n    \"language\": {\n      \"type\": \"string\",\n      \"description\": \"ISO 639-1 code of the language the lead wrote in\"\n    },\n    \"suggested_reply\": {\n      \"type\": \"string\",\n      \"description\": \"Reply to the lead, max 120 words, in their language\"\n    }\n  },\n  \"required\": [\n    \"budget\",\n    \"authority\",\n    \"need\",\n    \"timeline\",\n    \"summary\",\n    \"reasons\",\n    \"language\",\n    \"suggested_reply\"\n  ]\n}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "17109ce9-b001-49c8-a233-701d23362593",
      "name": "Compute Lead Score",
      "type": "n8n-nodes-base.code",
      "position": [
        1240,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ---- Tune these to your sales process ----\nconst WEIGHTS = { budget: 1, authority: 1, need: 1, timeline: 1 }; // relative importance of each 0-25 criterion\nconst BONUS_BUSINESS_EMAIL = 5; // company domain instead of gmail / outlook / ...\nconst BONUS_PHONE = 5;          // the lead left a phone number\nconst FREE_MAIL = ['gmail.com', 'googlemail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'live.com', 'msn.com',\n  'icloud.com', 'me.com', 'aol.com', 'mail.com', 'gmx.com', 'gmx.de', 'gmx.net', 'web.de', 'proton.me', 'protonmail.com',\n  'yandex.com', 'yandex.ru', 'mail.ru', 'qq.com', '163.com'];\n// -------------------------------------------\n\nconst lead = $('Set Lead Fields').item.json;\nconst ai = $input.item.json.output || {};\n\nconst clamp = (v, max) => Math.max(0, Math.min(max, Number(v) || 0));\nconst pts = {};\nlet weighted = 0;\nlet maxWeighted = 0;\nfor (const key of ['budget', 'authority', 'need', 'timeline']) {\n  const w = Number(WEIGHTS[key]) || 0;\n  pts[key + '_pts'] = clamp(ai[key], 25);\n  weighted += pts[key + '_pts'] * w;\n  maxWeighted += 25 * w;\n}\nlet score = maxWeighted > 0 ? (weighted / maxWeighted) * 100 : 0;\n\nconst domain = String(lead.email || '').split('@')[1] || '';\nconst businessEmail = domain !== '' && !FREE_MAIL.includes(domain);\nif (businessEmail) score += BONUS_BUSINESS_EMAIL;\nif (String(lead.phone || '').trim() !== '') score += BONUS_PHONE;\nscore = Math.round(Math.max(0, Math.min(100, score)));\n\nreturn {\n  json: {\n    ...lead,\n    ...pts,\n    score,\n    business_email: businessEmail,\n    ai_summary: String(ai.summary || ''),\n    reasons: Array.isArray(ai.reasons) ? ai.reasons.join('; ') : String(ai.reasons || ''),\n    language: String(ai.language || 'en'),\n    suggested_reply: String(ai.suggested_reply || ''),\n  },\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "8b6c14b7-37de-4d5e-ac95-0467cb24ce26",
      "name": "Route by Lead Quality",
      "type": "n8n-nodes-base.switch",
      "position": [
        1640,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Hot",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": false,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "sw-hot",
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    },
                    "leftValue": "={{ $json.score }}",
                    "rightValue": 70
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Warm",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": false,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "sw-warm",
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    },
                    "leftValue": "={{ $json.score }}",
                    "rightValue": 40
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Cold",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": false,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "sw-cold",
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    },
                    "leftValue": "={{ $json.score }}",
                    "rightValue": 40
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 3.2
    },
    {
