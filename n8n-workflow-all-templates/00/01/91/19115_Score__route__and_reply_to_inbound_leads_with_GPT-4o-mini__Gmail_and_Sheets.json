        "responseMode": "responseNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "e30c8983-2439-41d7-a2c7-c55155ff43d4",
      "name": "Acknowledge Lead Submission",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
