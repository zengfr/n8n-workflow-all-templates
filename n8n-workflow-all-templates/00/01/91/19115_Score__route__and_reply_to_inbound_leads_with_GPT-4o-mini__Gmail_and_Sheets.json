    {
      "id": "e58a5087-ca87-491c-a417-e966fd5c7a83",
      "name": "Send Hot Lead Alert Email",
      "type": "n8n-nodes-base.gmail",
      "position": [
        2340,
        0
      ],
      "parameters": {
        "sendTo": "user@example.com",
        "message": "=<h2>Hot lead: {{ $json.name }}{{ $json.company ? \" (\" + $json.company + \")\" : \"\" }}</h2>\n<p><b>Score:</b> {{ $json.score }}/100 &nbsp;|&nbsp; budget {{ $json.budget_pts }}/25, authority {{ $json.authority_pts }}/25, need {{ $json.need_pts }}/25, timeline {{ $json.timeline_pts }}/25</p>\n<p><b>Summary:</b> {{ $json.ai_summary }}</p>\n<p><b>Why:</b> {{ $json.reasons }}</p>\n<p><b>Contact:</b> {{ $json.email }} {{ $json.phone }}<br>\n<b>Budget:</b> {{ $json.budget || \"not stated\" }} &nbsp;|&nbsp; <b>Timeline:</b> {{ $json.timeline || \"not stated\" }}<br>\n<b>Source:</b> {{ $json.source }} &nbsp;|&nbsp; <b>Business email:</b> {{ $json.business_email ? \"yes\" : \"no\" }}</p>\n<p><b>Message:</b><br>{{ $json.message.replace(/\\n/g, \"<br>\") }}</p>\n<p><b>Next step:</b> {{ $json.next_step }}</p>",
