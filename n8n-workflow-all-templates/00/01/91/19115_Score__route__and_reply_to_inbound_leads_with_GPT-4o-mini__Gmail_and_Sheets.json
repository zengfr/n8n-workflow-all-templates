        "respondWith": "json",
        "responseBody": "{\n  \"ok\": true,\n  \"message\": \"Thanks! We received your request and will get back to you shortly.\"\n}"
      },
      "typeVersion": 1.4
    },
    {
      "id": "7b90a8c6-7546-49d4-a665-93aad773a917",
      "name": "Set Lead Fields",
      "type": "n8n-nodes-base.set",
      "position": [
        200,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "70495fba-99f2-43e9-a49f-d07d7607eede",
              "name": "lead_id",
              "type": "string",
              "value": "={{ $execution.id }}"
            },
            {
              "id": "339d20dd-b659-489a-a41a-9f16b6b39daa",
              "name": "received_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
