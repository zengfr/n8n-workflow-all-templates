    {
      "id": "5d79a36e-3ee3-41a6-a5f9-1942a4208b4e",
      "name": "Tool - Run Terraform Plan",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "position": [
        -5840,
        6704
      ],
      "parameters": {
        "url": "=https://ci.internal.example.com/api/terraform/plan",
        "method": "POST",
        "jsonBody": "={{ JSON.stringify({ repo: $fromAI('repo', 'owner/name of the repository'), branch: $fromAI('branch', 'the PR head branch to plan'), workingDir: $fromAI('working_dir', 'Terraform root module path within the repo, e.g. environments/prod') }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "toolDescription": "Trigger a read-only `terraform plan` on the PR branch (never apply) and return the resource-level diff: resources added/changed/destroyed, and any changed IAM/security-group/network rules. Use this to see the actual infrastructure impact rather than guessing from the raw HCL diff."
      },
      "typeVersion": 1.1
    },
    {
      "id": "975946ee-4d28-4776-8c87-06487b8adecf",
      "name": "Tool - Run Security Scan",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "position": [
        -5584,
        6704
      ],
      "parameters": {
        "url": "=https://ci.internal.example.com/api/terraform/security-scan",
        "method": "POST",
        "jsonBody": "={{ JSON.stringify({ repo: $fromAI('repo', 'owner/name of the repository'), branch: $fromAI('branch', 'the PR head branch to scan') }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "toolDescription": "Run a static security scan (tfsec/Checkov-style) against the PR branch's Terraform code and return findings: open security groups, unencrypted storage, public-facing resources, overly broad IAM policies, missing logging, hardcoded secrets, etc., each with a severity."
      },
      "typeVersion": 1.1
    },
    {
