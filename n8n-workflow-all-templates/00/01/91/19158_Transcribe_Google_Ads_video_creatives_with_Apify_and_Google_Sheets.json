      "name": "Domains, one per item",
      "type": "n8n-nodes-base.code",
      "position": [
        180,
        -40
      ],
      "parameters": {
        "jsCode": "// One item per advertiser domain, so the loop below handles them one at a time.\nconst raw = String($json.advertiserDomains || '');\nconst targets = raw.split(/\\r?\\n|,/).map((t) => t.trim()).filter(Boolean);\nif (!targets.length) {\n  throw new Error('No advertiser domain set. Open the Config node and add at least one.');\n}\nreturn targets.map((target) => ({ json: { target } }));"
      },
      "typeVersion": 2
    },
