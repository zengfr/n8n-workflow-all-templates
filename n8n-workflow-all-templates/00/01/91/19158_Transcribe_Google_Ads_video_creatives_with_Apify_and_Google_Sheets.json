        200
      ],
      "parameters": {
        "url": "=https://api.apify.com/v2/acts/silva95gustavo~google-ads-scraper/runs?waitForFinish=60",
        "method": "POST",
        "options": {
          "timeout": 120000
        },
        "jsonBody": "={{ JSON.stringify({ startUrls: [{ url: 'https://adstransparency.google.com/?region=' + $('Config').first().json.region + '&domain=' + $json.target }], resultsLimit: $('Config').first().json.maxAdsPerDomain }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 5000
    },
