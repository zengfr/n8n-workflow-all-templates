    {
      "id": "code-0017",
      "name": "Build one row per ad",
      "type": "n8n-nodes-base.code",
      "position": [
        2440,
        -40
      ],
      "parameters": {
        "jsCode": "// The AI node replaces each item with its extracted attributes, so put the\n// original row back together with them. Items come back in the same order.\nconst source = $('Any new ads?').all();\nreturn $input.all().map((item, i) => {\n  const row = { ...(source[i] ? source[i].json : {}) };\n  const ai = item.json.output || {};\n  const transcript = row.transcript || '';\n  row.transcript_words = transcript.trim() ? transcript.trim().split(/\\s+/).length : 0;\n  row.seconds = row.durationSeconds ?? null;\n  row.has_speech = row.status === 'transcribed';\n  return { json: { ...row, ...ai } };\n});"
      },
      "typeVersion": 2
    },
