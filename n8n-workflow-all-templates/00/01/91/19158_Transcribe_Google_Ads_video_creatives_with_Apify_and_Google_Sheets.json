        "options": {
          "systemPromptTemplate": "You break down YouTube video ad scripts for a performance marketing sheet. Answer only from the transcript given. If the ad has no speech, say so plainly in the summary and use \"none\" where a field cannot be answered."
        },
        "attributes": {
          "attributes": [
            {
              "name": "hook_type",
              "type": "string",
