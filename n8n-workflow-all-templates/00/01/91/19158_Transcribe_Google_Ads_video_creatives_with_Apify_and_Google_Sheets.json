    {
      "id": "code-0021",
      "name": "Write the email digest",
      "type": "n8n-nodes-base.code",
      "position": [
        3380,
        -40
      ],
      "parameters": {
        "jsCode": "// Longest transcribed ads first; silent ads are counted, not listed.\nconst rows = $input.first().json.rows || [];\nconst spoken = rows.filter((r) => r.status === 'transcribed');\nconst silent = rows.length - spoken.length;\nconst top = spoken.slice().sort((a, b) => (b.seconds || 0) - (a.seconds || 0)).slice(0, 5);\nconst brands = [...new Set(rows.map((r) => r.advertiser).filter(Boolean))].join(', ') || 'your advertisers';\nconst lines = top.map((r) => `- ${r.advertiser}: ${r.hook_type} hook, promise \"${r.promise || ''}\", ${r.script_structure} structure (${r.seconds || 0}s)\\n  ${r.video_url || ''}`);\nconst digest = [\n  `${rows.length} new video ad${rows.length === 1 ? '' : 's'} from ${brands}.`,\n  `${spoken.length} transcribed, ${silent} with no speech (uncharged).`,\n  '',\n  ...lines,\n].join('\\n');\nreturn [{ json: { digest, subject: `New video ads from ${brands}: ${rows.length} this week` } }];"
      },
      "typeVersion": 2
    },
