      "id": "bcust",
      "name": "Build Customer Reply",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        -352
      ],
      "parameters": {
        "jsCode": "const zen = $input.first() ? $input.first().json : {};\nconst p = $('Parse Request').first().json;\nconst found = !!(zen && zen.id);\nconst out = found\n  ? { operation: 'check_customer', found: true, customer_id: zen.id, name: zen.name, email: zen.email || null, phone: zen.phone || null, speech: `I found your account, ${zen.name}. How can I help you today?` }\n  : { operation: 'check_customer', found: false, callerNumber: p.callerNumber, speech: `I could not find an account for your phone number. I can create one for you if you like.` };\nreturn [{ json: out }];"
      },
      "typeVersion": 2
    },
