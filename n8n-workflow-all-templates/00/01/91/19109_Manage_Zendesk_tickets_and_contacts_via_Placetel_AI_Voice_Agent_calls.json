        "jsCode": "const p = $('Parse Request').first().json;\nconst zen = $input.first() ? $input.first().json : {};\nconst v = String((p.body && p.body.verify_value) || '').trim().toLowerCase();\nlet verified = false;\nif (zen && zen.id && v) {\n  const hay = [zen.name, zen.email].filter(Boolean).map(x => String(x).toLowerCase());\n  if (zen.user_fields) Object.values(zen.user_fields).forEach(x => { if (x != null) hay.push(String(x).toLowerCase()); });\n  verified = hay.some(h => h === v || h.includes(v));\n}\nreturn [{ json: { operation: 'verify_identity', verified, customer_id: zen && zen.id ? zen.id : null, speech: verified ? 'Thank you, your identity is verified.' : 'I am sorry, I could not verify your identity with that information.' } }];"
      },
