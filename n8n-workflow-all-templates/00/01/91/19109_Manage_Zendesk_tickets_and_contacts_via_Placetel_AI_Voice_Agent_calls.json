      "parameters": {
        "jsCode": "const p = $('Parse Request').first().json;\nconst uf = $('Zendesk: Find User (Tickets)').first();\nconst user = uf ? uf.json : {};\nconst items = $input.all().map(i => i.json).filter(t => t && t.id);\nlet speech;\nif (!user || !user.id) speech = 'I could not find an account for your number.';\nelse if (items.length === 0) speech = 'You have no open tickets at the moment.';\nelse {\n  const list = items.slice(0, 3).map(t => `ticket ${t.id}, ${t.subject}, ${t.status}`).join('; ');\n  speech = `You have ${items.length} open ${items.length === 1 ? 'ticket' : 'tickets'}: ${list}.`;\n}\nreturn [{ json: { operation: 'my_tickets', count: items.length, tickets: items.map(t => ({ id: t.id, subject: t.subject, status: t.status })), speech } }];"
