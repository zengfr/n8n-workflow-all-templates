    {
      "id": "bstatus",
      "name": "Build Ticket Status Reply",
      "type": "n8n-nodes-base.code",
      "position": [
        1232,
        560
      ],
      "parameters": {
        "jsCode": "const zen = $input.first() ? $input.first().json : {};\nconst p = $('Parse Request').first().json;\nconst status = zen && zen.status ? zen.status : null;\nconst id = zen && zen.id ? zen.id : (p.body.ticket_id || p.body.id);\nconst map = { new: 'new', open: 'open and being worked on', pending: 'pending, waiting for your reply', hold: 'on hold', solved: 'solved', closed: 'closed' };\nreturn [{ json: { operation: 'ticket_status', found: !!status, ticket_id: id, status, speech: status ? `Ticket ${id} is currently ${map[status] || status}.` : `I could not find a ticket with the number ${id}.` } }];"
      },
