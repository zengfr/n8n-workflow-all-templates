    {
      "id": "parse",
      "name": "Parse Request",
      "type": "n8n-nodes-base.code",
      "position": [
        -256,
        1328
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body || {};\nconst query = item.query || {};\nconst headers = item.headers || {};\n\n// operation from body OR query (never call it 'action')\nconst operation = String(body.operation || query.operation || 'unknown').trim();\n\n// Real caller number: phone-system header, or the agent's `phone` arg (Placetel %%caller_number%%), never invented\nconst rawCaller = headers['x-caller-number'] || headers['x-caller-id'] || headers['x-placetel-caller'] || body.phone || body.caller || body.from || body.caller_number || query.phone || query.caller || '';\n\n// Reduce to the German national significant number (NSN), then normalise to 49+NSN.\n// Zendesk user search matches its stored +49.. numbers on this 49.. form.\nlet sig = String(rawCaller).replace(/[^\\d+]/g, '');\nlet nsn = sig;\nif (nsn.startsWith('+49')) nsn = nsn.slice(3);\nelse if (nsn.startsWith('0049')) nsn = nsn.slice(4);\nelse if (nsn.startsWith('49') && nsn.length > 10) nsn = nsn.slice(2);\nelse if (nsn.startsWith('0')) nsn = nsn.slice(1);\nconst callerNumber = nsn ? '49' + nsn : '';\nconst callerE164 = nsn ? '+49' + nsn : '';\n\nreturn [{ json: { operation, callerNumber, callerE164, callerRaw: String(rawCaller), body, query } }];"
      },
      "typeVersion": 2
    },
