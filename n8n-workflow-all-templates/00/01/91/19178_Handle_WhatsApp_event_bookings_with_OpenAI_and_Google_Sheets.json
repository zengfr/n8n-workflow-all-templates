    {
      "id": "985f351a-26db-4aef-aea7-f1f02d56e554",
      "name": "Reply agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        3584,
        -672
      ],
      "parameters": {
        "text": "=#INPUT:\n- User Message Time: \n{{ $now.minus({ hours: 5 }).toFormat('cccc yyyy-LL-dd HH:mm') }}\n- User Message:\n{{ $json.user_message }}\n\n- User Attachments:\n{{ $json.user_attachments || \"\"}}\n\n- Our Message:\n{{ $json.our_message }}\n\n- Calender of This Week:\n{{\n(() => {\n  const today = new Date();\n  const day = today.getDay();                     // 0=Sun, 1=Mon...\n  const monday = new Date(today);\n  monday.setDate(today.getDate() - (day === 0 ? 6 : day - 1));\n\n  const days = [\"Sunday\",\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"];\n  const months = [\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"];\n\n  let output = [];\n  for (let i = 0; i < 7; i++) {\n    let d = new Date(monday);\n    d.setDate(monday.getDate() + i);\n    output.push(\n      `${String(d.getDate()).padStart(2, \"0\")} ${months[d.getMonth()]} (${days[d.getDay()]})`\n    );\n  }\n  return output.join(\"\\n\");\n})()\n}}",
        "options": {
          "systemMessage": "={{ $json.prompt }}\n#Additional Information\n- send this table chart url \"YOUR_PRICE_CHART_IMAGE_URL\" when someone asked you to share table chart or flow.\n- do not add this url in text message add this url in \"image url\" : \"\" section."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 2.2
    },
