    {
      "id": "c10b908a-0e3b-4129-bddd-995b992e28bc",
      "name": "Filter & Format Product",
      "type": "n8n-nodes-base.code",
      "position": [
        2672,
        656
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const p = item.json;\n  return {\n    json: {\n      productId: p.id || '12345',\n      title: p.title || 'Sample Shopify Product',\n      price: (p.variants && p.variants[0]) ? p.variants[0].price : '19.99',\n      imageUrl: (p.images && p.images[0]) ? p.images[0].src : 'https://via.placeholder.com/300',\n      bodyHtml: p.body_html || 'Product description goes here.'\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
