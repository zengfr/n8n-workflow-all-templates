      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "onError": "continueRegularOutput",
      "position": [
        1720,
        -40
      ],
      "parameters": {
        "text": "={{ 'My brand: ' + $('Config').first().json.yourBrand + '\\n\\nCreator: ' + ($json.ownerUsername || '') + '\\nCaption: ' + ($json.caption || '') + '\\nSpoken transcript: ' + ($json.transcript || $json.onScreenText || '(this reel has no speech)') }}",
        "options": {
          "systemPromptTemplate": "You help a social media manager build a swipe file. Study the reel given and rewrite its hook for the brand described at the top of the input. Keep the rewrite concrete and speakable."
        },
        "attributes": {
          "attributes": [
            {
              "name": "hook_type",
              "type": "string",
              "required": false,
              "description": "How the reel opens. One of: question, statistic, pain-point, story, bold-claim, listicle, other."
            },
            {
              "name": "content_pillar",
              "type": "string",
              "required": false,
              "description": "One of: education, entertainment, behind-the-scenes, promo, story, other."
            },
            {
              "name": "emotional_trigger",
              "type": "string",
              "required": false,
              "description": "The feeling the opening goes for, in one or two words, for example curiosity, fear of missing out, relief."
            },
            {
              "name": "cta_present",
              "type": "boolean",
              "required": false,
              "description": "True if the reel asks the viewer to do something."
            },
            {
              "name": "rewrite_for_my_brand",
              "type": "string",
              "required": false,
              "description": "Rewrite the opening hook for the brand described under \"My brand\", in 20 words or fewer."
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "groq-0014",
      "name": "Groq chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "position": [
