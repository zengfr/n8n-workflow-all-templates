    {
      "id": "code-0015",
      "name": "Build one row per reel",
      "type": "n8n-nodes-base.code",
      "position": [
        2140,
        -40
      ],
      "parameters": {
        "jsCode": "// The AI node replaces each item with its extracted attributes, so put the\n// original row back together with them. Items come back in the same order.\nconst source = $('Any new reels?').all();\nreturn $input.all().map((item, i) => {\n  const row = { ...(source[i] ? source[i].json : {}) };\n  const ai = item.json.output || {};\n  const transcript = row.transcript || '';\n  row.transcript_words = transcript.trim() ? transcript.trim().split(/\\s+/).length : 0;\n  return { json: { ...row, ...ai } };\n});"
      },
      "typeVersion": 2
    },
