    {
      "id": "code-0019",
      "name": "Write the Telegram digest",
      "type": "n8n-nodes-base.code",
      "position": [
        3080,
        -40
      ],
      "parameters": {
        "jsCode": "// Five most-liked new reels; fall back to newest when likes are missing.\nconst rows = $input.first().json.rows || [];\nconst ranked = rows.slice().sort((a, b) => ((b.likes || 0) - (a.likes || 0)) || String(b.posted_at || '').localeCompare(String(a.posted_at || '')));\nconst top = ranked.slice(0, 5);\nconst lines = top.map((r) => `@${r.creator || '?'} (${r.hook_type || 'hook'}, ${(r.likes || 0).toLocaleString()} likes)\\nRewrite: ${r.rewrite_for_my_brand || '-'}\\n${r.reel_url || ''}`);\nconst digest = [`*${rows.length} new reel${rows.length === 1 ? '' : 's'} in your swipe file*`, ...lines].join('\\n\\n');\nreturn [{ json: { digest, new_reels: rows.length } }];"
      },
      "typeVersion": 2
    },
