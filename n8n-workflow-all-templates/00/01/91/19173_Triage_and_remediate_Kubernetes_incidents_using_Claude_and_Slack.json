          "temperature": 0.1
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "4c1b45ea-c330-437d-ac1c-eece18d42d6c",
      "name": "JS - Parse Diagnosis Output",
      "type": "n8n-nodes-base.code",
      "position": [
        -3904,
        5088
      ],
      "parameters": {
        "jsCode": "const upstream = $('JS - Merge Config & Diagnostics').first().json;\nconst response = $input.first().json;\n\nlet parsed = {\n  rootCauseHypothesis: '',\n  confidence: 'Low',\n  proposedActionType: 'no_action_investigate_further',\n  proposedActionDetails: '',\n  riskLevel: 'NeedsApproval',\n  riskReasoning: 'AI diagnosis unavailable this cycle; defaulted to manual review as a safety default.'\n};\ntry {\n  const raw = String(response.output || response.text || response.response || '{}').replace(/```json|```/g, '').trim();\n  const result = JSON.parse(raw);\n  parsed = { ...parsed, ...result };\n} catch (e) {\n  // keep safe default above\n}\n\nconst autoList = (upstream.autoExecutableActionTypes || '').split(',').map(s => s.trim());\nconst isOnAutoList = autoList.includes(parsed.proposedActionType);\nconst safeToAutoExecute = parsed.riskLevel === 'Safe' && isOnAutoList;\n\nreturn [{\n  json: {\n    ...upstream,\n    rootCauseHypothesis: parsed.rootCauseHypothesis,\n    confidence: parsed.confidence,\n    proposedActionType: parsed.proposedActionType,\n    proposedActionDetails: parsed.proposedActionDetails,\n    riskLevel: parsed.riskLevel,\n    riskReasoning: parsed.riskReasoning,\n    safeToAutoExecute\n  }\n}];"
      },
      "typeVersion": 2
    },
