    {
      "id": "5c76e9f6-bd6b-4780-878d-c12e1e26ec9d",
      "name": "AI Agent - Verify Symptoms Resolved",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        -2832,
        5088
      ],
      "parameters": {
        "text": "=You are verifying whether a Kubernetes remediation actually fixed the original problem.\n\nOriginal alert reason: {{ $('JS - Parse Diagnosis Output').item.json.alertReason }}\nOriginal root cause hypothesis: {{ $('JS - Parse Diagnosis Output').item.json.rootCauseHypothesis }}\nAction taken: {{ $('JS - Parse Diagnosis Output').item.json.proposedActionType }} — {{ $('JS - Parse Diagnosis Output').item.json.proposedActionDetails }}\n\nPost-remediation events:\n{{ JSON.stringify($json.events) }}\n\nPost-remediation logs:\n{{ $json.logs || $json.recentLogs }}\n\nPost-remediation resource usage:\n{{ JSON.stringify($json.resourceUsage || $json.top) }}\n\nBased on this fresh diagnostic snapshot, has the original problem actually been resolved? Look for the specific error/crash pattern being gone, not just the absence of new events.\n\nReturn ONLY a JSON object (no markdown fences, no commentary) with keys: resolved (boolean), verificationSummary (1-2 sentences).",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 1.6
    },
    {
      "id": "1f95a546-4f2e-44ed-bb73-614800a140b6",
      "name": "JS - Parse Verification Output",
      "type": "n8n-nodes-base.code",
      "position": [
        -2544,
        5088
      ],
      "parameters": {
        "jsCode": "const upstream = $('JS - Parse Diagnosis Output').item.json;\nconst response = $input.first().json;\n\nlet parsed = {\n  resolved: false,\n  verificationSummary: 'AI verification unavailable this cycle; defaulted to unresolved as a safety default.'\n};\ntry {\n  const raw = String(response.output || response.text || response.response || '{}').replace(/```json|```/g, '').trim();\n  const result = JSON.parse(raw);\n  parsed = { ...parsed, ...result };\n} catch (e) {\n  // keep safe default above\n}\n\nreturn [{\n  json: {\n    ...upstream,\n    resolved: parsed.resolved,\n    verificationSummary: parsed.verificationSummary\n  }\n}];"
      },
      "typeVersion": 2
    },
