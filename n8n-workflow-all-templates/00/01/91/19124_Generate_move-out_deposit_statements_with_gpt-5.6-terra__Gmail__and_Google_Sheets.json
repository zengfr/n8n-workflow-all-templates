    {
      "id": "6caf75c0-96fd-48fb-a620-e83b4352aa98",
      "name": "Compute Unprocessed Move Outs",
      "type": "n8n-nodes-base.code",
      "position": [
        448,
        624
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(function(i){ return i.json; });\nconst now = Date.now();\nconst unprocessed = [];\nrows.forEach(function(r){\n  const st = String(r.status || '').toLowerCase();\n  if (st === 'refund' || st === 'owed') return;\n  const recv = Date.parse(r.received_at || '');\n  const days = recv ? (now - recv) / 86400000 : 99;\n  if (days >= 3) {\n    unprocessed.push({\n      moveout_id: r.moveout_id,\n      tenant_name: r.tenant_name || '',\n      tenant_email: r.tenant_email || '',\n      unit: r.unit || '',\n      move_out_date: r.move_out_date || '',\n      deposit_amount: r.deposit_amount || '',\n      days_pending: Math.floor(days)\n    });\n  }\n});\nreturn [{ json: { unprocessed_json: JSON.stringify(unprocessed), unprocessed_count: unprocessed.length } }];\n"
      },
      "typeVersion": 2
    },
