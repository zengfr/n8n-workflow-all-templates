    {
      "id": "c4a175ce-2d0a-4eee-8cd2-349e8b28a743",
      "name": "AI Classify Damages",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1120,
        -80
      ],
      "parameters": {
        "text": "={{ 'Move-out inspection for unit ' + $json.unit + '. Security deposit: ' + $json.deposit_amount + '. Inspected items: ' + $json.damages }}",
        "options": {
          "systemMessage": "You are a fair property manager assistant handling a move-out inspection. The deposited items are listed in the prompt. For EVERY item decide whether its repair is a legitimate CHARGEABLE deduction from the security deposit or normal WEAR AND TEAR that should NOT be charged. Estimate a fair repair cost in whole dollars (0 for normal wear and tear), write a short reason in under 12 words, and set severity to low, medium or high. Be consistent and reasonable: normal aging, light scuffs, faded paint, small nail holes and standard carpet cleaning are normal wear and tear at 0. If a listed item has an obvious large cost (hole in wall, broken window, missing furniture, deep damage) mark it chargeable with a realistic cost. Return ONLY valid JSON: an array of objects, each with keys item (the exact item name), classification (exactly chargeable or wear_and_tear), cost (a number), reason (a string), severity (a string). No markdown, no code fences, no text outside the JSON."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "6b86911c-388f-44a9-bc71-1b3f36a566ef",
      "name": "Parse Damage Classification",
      "type": "n8n-nodes-base.code",
      "position": [
        1472,
        -80
      ],
      "parameters": {
        "jsCode": "const base = $('Build Disposition Prompt').first().json;\nconst item = $input.first().json;\nlet raw = String(item.output || '').replace(/```json/gi, '').replace(/```/g, '').trim();\nconst cleaned = raw.split('\\\\\"').join('\"');\nlet parsed = [];\ntry { parsed = JSON.parse(cleaned); } catch (e) {\n  const m = cleaned.match(/\\[[\\s\\S]*\\]/);\n  if (m) { try { parsed = JSON.parse(m[0].split('\\\\\"').join('\"')); } catch (e2) {} }\n}\nconst items = Array.isArray(parsed) ? parsed : [];\nconst clean = items.map(function(d, i) {\n  return {\n    item: String(d.item || ('Item ' + (i + 1))),\n    classification: String(d.classification || 'wear_and_tear'),\n    cost: Number(d.cost) || 0,\n    reason: String(d.reason || ''),\n    severity: String(d.severity || 'low')\n  };\n});\nconst chargeable = clean.filter(function(x){ return x.classification === 'chargeable'; });\nreturn [{ json: Object.assign({}, base, {\n  items_json: JSON.stringify(clean),\n  chargeable_json: JSON.stringify(chargeable),\n  items_count: clean.length,\n  chargeable_count: chargeable.length\n}) }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "35a53fb3-db50-4a2f-8660-9029b7369c2d",
      "name": "Compute Deposit Disposition",
      "type": "n8n-nodes-base.code",
      "position": [
        1696,
        -80
      ],
      "parameters": {
        "jsCode": "const base = $('Parse Damage Classification').first().json;\nconst deposit = Number(base.deposit_amount) || 0;\nconst unpaidRent = Number(base.unpaid_rent) || 0;\nconst unpaidUtils = Number(base.unpaid_utilities) || 0;\nconst items = [];\ntry { const arr = JSON.parse(base.items_json || '[]'); if (Array.isArray(arr)) items.push.apply(items, arr); } catch (e) {}\nconst chargeable = items.filter(function(x){ return x.classification === 'chargeable'; });\nlet deductionTotal = 0;\nchargeable.forEach(function(x){ deductionTotal += (Number(x.cost) || 0); });\ndeductionTotal = Math.round(deductionTotal * 100) / 100;\nconst unpaidTotal = Math.round((unpaidRent + unpaidUtils) * 100) / 100;\nconst net = Math.round((deposit - deductionTotal - unpaidTotal) * 100) / 100;\nconst tenantOwes = net < 0;\nconst netRefund = tenantOwes ? 0 : net;\nconst amountOwed = tenantOwes ? Math.abs(net) : 0;\nconst status = tenantOwes ? 'owed' : 'refund';\nconst classifiedAt = new Date().toISOString();\nconst largeDeduction = deductionTotal > deposit * 0.5;\n\nconst lines = [];\nlines.push('ITEMIZED SECURITY DEPOSIT DISPOSITION');\nlines.push('Unit: ' + base.unit + ' | Tenant: ' + base.tenant_name + ' | Move-out: ' + base.move_out_date);\nlines.push('');\nlines.push('Security deposit: $' + deposit.toFixed(2));\nlines.push('');\nlines.push('Itemized charges:');\nif (items.length === 0) lines.push('  (none recorded)');\nitems.forEach(function(it){\n  if (it.classification === 'chargeable') {\n    lines.push('  - ' + it.item + ': $' + (Number(it.cost)||0).toFixed(2) + ' (' + it.reason + ')');\n  } else {\n    lines.push('  - ' + it.item + ': $0.00 (normal wear and tear)');\n  }\n});\nlines.push('');\nif (unpaidRent > 0) lines.push('Unpaid rent: $' + unpaidRent.toFixed(2));\nif (unpaidUtils > 0) lines.push('Unpaid utilities: $' + unpaidUtils.toFixed(2));\nlines.push('Total deductions: $' + deductionTotal.toFixed(2));\nlines.push('');\nif (tenantOwes) {\n  lines.push('Net: -$' + amountOwed.toFixed(2) + ' (amount due from tenant)');\n} else {\n  lines.push('Net refund to tenant: $' + netRefund.toFixed(2));\n}\nconst statement = lines.join('\\n');\nconst subject = base.unit ? ('Security deposit statement for ' + base.unit) : 'Security deposit statement';\n\nreturn [{ json: Object.assign({}, base, {\n  deduction_total: deductionTotal,\n  unpaid_total: unpaidTotal,\n  net_refund: netRefund,\n  amount_owed: amountOwed,\n  tenant_owes: tenantOwes,\n  large_deduction: largeDeduction,\n  status: status,\n  classified_at: classifiedAt,\n  chargeable_count: chargeable.length,\n  statement: statement,\n  subject: subject\n}) }];\n"
      },
      "typeVersion": 2
    },
