    {
      "id": "18ffde57-36ba-41a5-84cf-b2f8b472d163",
      "name": "Count run outcomes",
      "type": "n8n-nodes-base.code",
      "notes": "One item in, one item out: turns N per-domain rows into a single run summary. Kept as a Code node deliberately - counting into 4 fixed named buckets from a status field is exactly the 'complex data structure' case where Code beats Summarize's group-by output shape.",
      "position": [
        -144,
        1840
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst counts = { role_found: 0, personal_only_review: 0, no_contact_published: 0, retry_next_run: 0 };\nfor (const item of items) {\n  const status = item.json.status;\n  if (status === 'role_found') counts.role_found++;\n  else if (status === 'personal_only_review') counts.personal_only_review++;\n  else if (status === 'no_contact_published') counts.no_contact_published++;\n  else counts.retry_next_run++; // empty string status = retry\n}\nreturn [{\n  json: {\n    run_at: new Date().toISOString(),\n    role_found: counts.role_found,\n    personal_only_review: counts.personal_only_review,\n    no_contact_published: counts.no_contact_published,\n    retry_next_run: counts.retry_next_run,\n    total: items.length\n  }\n}];"
      },
      "typeVersion": 2
    },
