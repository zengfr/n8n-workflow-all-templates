    {
      "id": "d24742fe-50cd-4e26-9735-b167564ed964",
      "name": "Merge run results",
      "type": "n8n-nodes-base.merge",
      "notes": "Waits for all 4 branches to finish, then combines their outputs into one list so the next node can count outcomes across the whole batch.",
      "position": [
        -368,
        1840
      ],
      "parameters": {
        "numberInputs": 4
      },
      "typeVersion": 3.2
