    {
      "id": "8181d847-da23-434e-8dab-bba36154c69c",
      "name": "Classify Email",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Set up an 'Anthropic API' generic credential (header auth or the built-in Anthropic credential type if available in your n8n version) and select it in the node's Authentication settings.",
      "position": [
        224,
        832
      ],
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-sonnet-5\",\n  max_tokens: 500,\n  system: \"You are an email triage assistant. Classify the email into exactly one category: Urgent, Important, Normal, or Promotional. Urgent = time-sensitive, needs action within hours (deadlines, client escalations, payment issues, outages). Important = needs a response but not time-critical (client questions, proposals, meeting requests). Normal = FYI or routine correspondence needing a light reply. Promotional = marketing, newsletters, automated notifications with no reply needed. Also extract a one-sentence summary, a list of action items, whether a response is required, and sentiment. Respond with ONLY valid JSON, no markdown fences, no preamble, in this exact shape: {\\\"category\\\":\\\"Urgent|Important|Normal|Promotional\\\",\\\"summary\\\":\\\"string\\\",\\\"action_items\\\":[\\\"string\\\"],\\\"requires_response\\\":true,\\\"sentiment\\\":\\\"string\\\"}\",\n  messages: [\n    {\n      role: \"user\",\n      content: \"From: \" + $json.from + \"\\nSubject: \" + $json.subject + \"\\n\\n\" + $json.bodyText\n    }\n  ]\n}) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $credentials.anthropicApi.apiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "b449e7d5-1a5f-4693-b809-aace35b66cc0",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "notes": "Falls back to 'Normal' if the AI response isn't valid JSON, so nothing gets silently dropped.",
      "position": [
        448,
        832
      ],
      "parameters": {
        "jsCode": "const original = $('Extract Email Data').first().json;\nconst raw = $json.content[0].text;\nlet parsed;\ntry {\n  parsed = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  parsed = {\n    category: 'Normal',\n    summary: 'Could not parse AI classification, defaulted to Normal.',\n    action_items: [],\n    requires_response: true,\n    sentiment: 'unknown'\n  };\n}\nreturn [{\n  json: {\n    ...original,\n    category: parsed.category,\n    summary: parsed.summary,\n    action_items: parsed.action_items,\n    requires_response: parsed.requires_response,\n    sentiment: parsed.sentiment\n  }\n}];"
      },
      "typeVersion": 2
    },
