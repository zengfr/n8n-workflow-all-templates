    {
      "id": "860a13a7-e593-466e-93b9-691629706dbb",
      "name": "Parse AI Classification",
      "type": "n8n-nodes-base.code",
      "position": [
        2368,
        400
      ],
      "parameters": {
        "jsCode": "const content =\n  $json.content?.[0]?.text ||\n  $json.output?.[0]?.content?.[0]?.text ||\n  \"\";\n\n// Remove markdown code blocks\nconst cleaned = content\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(\"INVALID_AI_JSON_RESPONSE\");\n}\n\nreturn [\n  {\n    json: parsed\n  }\n];"
      },
      "typeVersion": 2
    },
    {
      "id": "1ec218d5-f02f-4176-8fc9-b937531aafe0",
      "name": "Combine OCR + AI + File Data",
      "type": "n8n-nodes-base.merge",
