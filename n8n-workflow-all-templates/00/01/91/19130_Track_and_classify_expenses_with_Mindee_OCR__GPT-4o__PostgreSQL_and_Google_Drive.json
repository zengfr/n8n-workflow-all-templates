      "name": "Final Expense Validation",
      "type": "n8n-nodes-base.code",
      "position": [
        2800,
        544
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst errors = [];\n\nif (!item.amount) {\n  errors.push(\"AMOUNT_NOT_FOUND\");\n}\n\nif (!item.merchant) {\n  errors.push(\"MERCHANT_NOT_FOUND\");\n}\n\nif (item.confidence && item.confidence < 0.6) {\n  errors.push(\"LOW_CONFIDENCE\");\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n      isValid: errors.length === 0,\n      errors\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
