    {
      "id": "950b31f3-54c5-4562-90b2-c3c74052c360",
      "name": "Extract OCR Fields",
      "type": "n8n-nodes-base.code",
      "position": [
        944,
        272
      ],
      "parameters": {
        "jsCode": "const fields = $input.first().json.inference.result.fields || {};\n\nconst rawText =\n  $input.first().json.inference.result.raw_text?.pages\n    ?.map(page => page.content)\n    ?.join(\"\\n\") || \"\";\n\nreturn [\n  {\n    json: {\n      merchant: fields.supplier_name?.value || null,\n      amount: fields.total_amount?.value || null,\n      date: fields.date?.value || null,\n      category: fields.purchase_category?.value || \"Other\",\n      subcategory: fields.purchase_subcategory?.value || null,\n      currency: fields.locale?.fields?.currency?.value || null,\n      country: fields.locale?.fields?.country?.value || null,\n      receiptNumber: fields.receipt_number?.value || null,\n      supplierAddress: fields.supplier_address?.value || null,\n      rawText\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
    {
      "id": "01f56550-bff8-412a-8b18-ebe1e6cb8c11",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        32,
        96
      ],
      "parameters": {
        "color": 7,
        "width": 1104,
        "height": 672,
        "content": "## Receipt OCR Extraction Engine\nThis section sends the uploaded receipt image to Mindee OCR for intelligent document extraction. The workflow asynchronously processes the receipt, waits for completion, and retrieves structured expense data such as merchant name, amount, receipt number, date, category, and raw OCR text."
      },
      "typeVersion": 1
