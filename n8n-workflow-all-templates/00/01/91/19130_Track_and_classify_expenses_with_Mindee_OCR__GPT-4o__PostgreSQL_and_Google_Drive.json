    {
      "id": "865c2eb7-7609-4828-99a2-9849fcbfbf11",
      "name": "Calculate Monthly Spending",
      "type": "n8n-nodes-base.postgres",
      "position": [
        -864,
        1024
      ],
      "parameters": {
        "query": "SELECT\nDATE_TRUNC('month', expense_date) AS month,\nSUM(amount::numeric) AS total_expense\nFROM expenses\nGROUP BY 1\nORDER BY 1;",
        "options": {},
        "operation": "executeQuery"
      },
      "typeVersion": 2.6
    },
    {
      "id": "f7cff4bd-d9f9-41ce-b762-95e76340ebdd",
      "name": "Generate Category Analytics",
      "type": "n8n-nodes-base.postgres",
      "position": [
        -864,
        1216
      ],
      "parameters": {
        "query": "SELECT\nai_category,\nSUM(amount::numeric) AS total\nFROM expenses\nGROUP BY 1\nORDER BY total DESC;",
        "options": {},
        "operation": "executeQuery"
      },
      "typeVersion": 2.6
    },
    {
      "id": "a654a2a3-f1eb-4344-9ece-20f4aa21c69f",
      "name": "Generate Merchant Analytics",
      "type": "n8n-nodes-base.postgres",
      "position": [
        -864,
        1408
      ],
      "parameters": {
        "query": "SELECT\nmerchant,\nCOUNT(*) AS transactions,\nSUM(amount::numeric) AS total_spend\nFROM expenses\nGROUP BY 1\nORDER BY total_spend DESC\nLIMIT 10;",
        "options": {},
        "operation": "executeQuery"
      },
      "typeVersion": 2.6
    },
