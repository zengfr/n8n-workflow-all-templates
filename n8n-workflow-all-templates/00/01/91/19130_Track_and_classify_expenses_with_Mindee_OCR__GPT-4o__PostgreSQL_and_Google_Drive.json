      "name": "Validate Receipt File",
      "type": "n8n-nodes-base.code",
      "position": [
        -256,
        480
      ],
      "parameters": {
        "jsCode": "const file = $input.first().binary.receipt;\n\nif (!file) {\n  throw new Error(\"NO_RECEIPT_BINARY_FOUND\");\n}\n\n// Convert size safely (n8n sometimes gives KB format)\nconst sizeInBytes = file.fileSize || file?.size || null;\n\nreturn [\n  {\n    json: {\n      userId: $input.first().json.userId || null,\n      fileName: file.fileName,\n      mimeType: file.mimeType,\n      size: sizeInBytes,\n      hasFile: true\n    },\n    binary: {\n      receipt: file\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
