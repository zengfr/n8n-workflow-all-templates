    {
      "id": "9997d6da-ca23-4c26-9e28-d4172ce97821",
      "name": "Validate Extracted Expense",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        272
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst errors = [];\n\nif (!item.amount) {\n  errors.push(\"AMOUNT_NOT_FOUND\");\n}\n\nif (!item.merchant) {\n  errors.push(\"MERCHANT_NOT_FOUND\");\n}\n\nreturn [\n  {\n    json: {\n      ...item,\n      webViewLink:$input.first().json.webViewLink,\n      isValid: errors.length === 0,\n      errors\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
