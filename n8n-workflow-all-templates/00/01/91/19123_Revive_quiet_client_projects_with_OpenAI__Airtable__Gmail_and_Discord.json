      "parameters": {
        "text": "={{ 'Weekly client health digest for ' + $json.digest_date + '. Active projects: ' + $json.total_active + '. Quiet 10 to 29 days: ' + $json.stale_10_29 + '. Past 30 days: ' + $json.stale_30_plus + '. Check-in emails sent in the last 7 days: ' + $json.emails_sent_7d + '. At-risk list: ' + $json.risk_lines }}",
        "options": {
          "systemMessage": "You are an ops assistant writing the Friday client health digest for a small studio owner. In under 80 words: state how many projects are healthy, how many went quiet 10 to 29 days ago, and call out anything past 30 days of silence by name. Plain and direct, no greeting, no sign-off. Return ONLY valid JSON with a single key brief_text. No markdown, no code fences."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "91ad09cb-aec6-4c6b-bbe5-31452a1adedf",
      "name": "Parse Digest",
      "type": "n8n-nodes-base.code",
      "position": [
        1072,
        544
      ],
      "parameters": {
        "jsCode": "// Parse the AI digest narrative.\nconst raw = $input.first().json.output !== undefined ? $input.first().json.output : ($input.first().json.message ? $input.first().json.message.content : JSON.stringify($input.first().json));\nlet text = String(raw == null ? '' : raw).trim();\ntext = text.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\nconst m = text.match(/\\{[\\s\\S]*\\}/);\nlet parsed = null;\nif (m) { try { parsed = JSON.parse(m[0]); } catch (e) { parsed = null; } }\nconst d = $('Compile Digest Stats').first().json;\nlet narrative = '';\nif (parsed && typeof parsed.brief_text === 'string' && parsed.brief_text.trim()) {\n  narrative = parsed.brief_text.trim();\n} else {\n  narrative = d.stale_30_plus + ' project(s) past 30 days of silence, ' + d.stale_10_29 + ' between 10 and 29 days. ' + d.emails_sent_7d + ' check-in email(s) sent in the last 7 days.';\n}\nreturn [{ json: { narrative } }];\n"
      },
      "typeVersion": 2
    },
