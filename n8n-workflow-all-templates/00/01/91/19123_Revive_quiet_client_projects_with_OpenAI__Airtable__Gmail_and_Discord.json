    {
      "id": "e3a193ee-474d-4b72-becd-9da90404b72a",
      "name": "Compute Quiet Projects",
      "type": "n8n-nodes-base.code",
      "position": [
        448,
        -64
      ],
      "parameters": {
        "jsCode": "// Compute quietness for every active project in Client Projects.\n// Reads: all rows from Read Client Projects. Today comes from $now (workflow timezone).\nconst rows = $input.all().map(i => {\n  const j = i.json;\n  if (j && j.fields) return Object.assign({ id: j.id }, j.fields);\n  return j || {};\n});\nconst today = $now.toFormat('yyyy-MM-dd');\n\nfunction parseDate(s) {\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(s || '').trim());\n  return m ? new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])) : null;\n}\nconst t0 = parseDate(today);\nconst results = [];\nconst problems = [];\nfor (const r of rows) {\n  const pid = String(r.project_id || '').trim();\n  const last = String(r.last_touch || '').trim();\n  const status = String(r.status || 'active').trim().toLowerCase();\n  if (!pid) continue;\n  if (status !== 'active') continue;\n  if (!last) { problems.push(pid + ': last_touch missing'); continue; }\n  const lt = parseDate(last);\n  if (!lt || isNaN(lt)) { problems.push(pid + ': last_touch not YYYY-MM-DD'); continue; }\n  const days = Math.floor((t0 - lt) / 86400000);\n  results.push({\n    record_id: r.id,\n    project_id: pid,\n    project_name: String(r.project_name || ''),\n    client_name: String(r.client_name || ''),\n    client_email: String(r.client_email || ''),\n    stage: String(r.stage || ''),\n    last_touch: last,\n    days_quiet: days,\n    record_ok: true,\n  });\n}\nreturn [{ json: {\n  computed_at: today,\n  projects: results,\n  project_count: results.length,\n  problems: problems.join(' | '),\n  rows_bad: problems.length,\n}}];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "90e36e26-4992-48fc-b500-b6486b1a62e7",
      "name": "Build Quiet Flag",
      "type": "n8n-nodes-base.code",
      "position": [
        672,
        -160
      ],
      "parameters": {
        "jsCode": "// Branch condition fields for the any-quiet IF node.\nconst data = $('Compute Quiet Projects').first().json;\nconst quiet = (data.projects || []).filter(p => p.days_quiet >= 10);\nreturn [{ json: { has_quiet: quiet.length > 0, quiet_count: quiet.length, total: data.project_count } }];\n"
      },
      "typeVersion": 2
    },
