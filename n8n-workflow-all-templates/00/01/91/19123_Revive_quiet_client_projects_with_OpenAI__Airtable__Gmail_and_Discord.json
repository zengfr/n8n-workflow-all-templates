    {
      "id": "639a09a5-8103-43f1-8361-caab8acb2045",
      "name": "Compile Digest Stats",
      "type": "n8n-nodes-base.code",
      "position": [
        496,
        544
      ],
      "parameters": {
        "jsCode": "// Weekly ops digest from Client Projects + Touch Log.\n// Converging reads: run once per arriving input, only the last run sees both.\nconst fmt = (d) => d.toFormat('yyyy-MM-dd');\nfunction flat(r) { return r.fields ? Object.assign({ id: r.id }, r.fields) : r; }\nlet projects = [];\nlet touches = [];\ntry { projects = ($if($('Read Projects for Digest').isExecuted, () => $('Read Projects for Digest').all().map(i => i.json)) || []).map(flat); } catch (e) { projects = []; }\ntry { touches = ($if($('Read Touch Log for Digest').isExecuted, () => $('Read Touch Log for Digest').all().map(i => i.json)) || []).map(flat); } catch (e) { touches = []; }\nif (!projects.length) { projects = $input.all().map(i => i.json).filter(j => j && (j.project_id || j.fields)); }\nif (!touches.length) { const c = $input.all().map(i => i.json).filter(j => j && (j.log_id || (j.fields && j.fields.log_id))); if (c.length) touches = c; }\n\nfunction flat(r) { return r.fields ? Object.assign({ id: r.id }, r.fields) : r; }\nconst projs = projects.map(flat).filter(p => String(p.status || 'active').toLowerCase() === 'active');\nconst logs = touches.map(flat).filter(l => l.log_id || l.sent_at);\n\nfunction parseDate(s) {\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})$/.exec(String(s || '').trim());\n  return m ? new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])) : null;\n}\nconst t0 = parseDate(fmt($now));\nconst t7 = parseDate(fmt($now.minus({ days: 7 })));\nconst t30 = parseDate(fmt($now.minus({ days: 30 })));\n\nconst lines = [];\nlet stale7 = 0, stale30 = 0, sent7 = 0;\nconst risk = [];\nfor (const p of projs) {\n  const lt = parseDate(p.last_touch);\n  if (!lt) continue;\n  const dq = Math.floor((t0 - lt) / 86400000);\n  if (dq >= 30) { stale30++; risk.push(p.project_id + ' ' + p.project_name + ' (' + p.client_name + '): ' + dq + ' days quiet, stage ' + p.stage); }\n  else if (dq >= 10) stale7++;\n}\nfor (const l of logs) {\n  const s = String(l.sent_at || '').trim();\n  const m = /^(\\d{4})-(\\d{2})-(\\d{2})/.exec(s);\n  const sd = m ? parseDate(m[1] + '-' + m[2] + '-' + m[3]) : null;\n  if (sd && sd >= t7) sent7++;\n}\nconst digest_date = fmt($now);\nreturn [{ json: {\n  digest_date,\n  total_active: projs.length,\n  stale_10_29: stale7,\n  stale_30_plus: stale30,\n  emails_sent_7d: sent7,\n  risk_lines: risk.length ? risk.join(' | ') : 'no project past 30 days of silence',\n  has_risk: risk.length > 0,\n}}];\n"
      },
      "typeVersion": 2
    },
