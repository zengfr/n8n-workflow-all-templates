    {
      "id": "de98bbb9-d4e9-44e7-856b-ef8af78f885c",
      "name": "AI Draft Check-in Email",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1344,
        -256
      ],
      "parameters": {
        "text": "={{ 'Project ' + $json.project_name + ' for client ' + $json.client_name + '. Current stage: ' + $json.stage + '. Days since the last touchpoint: ' + $json.days_quiet + '.' }}",
        "options": {
          "systemMessage": "You are an account manager writing a short check-in email to a client whose project has gone quiet. You are NOT selling anything and NOT apologizing. In under 120 words: greet them by first name, mention the project by name and its current stage, share one believable neutral reason the team is heads-down this week (do not invent specific dates, numbers or deliverables), then invite them to raise anything they want moved or changed. Warm, plain, human. No corporate filler. Never use placeholder names like [Your Name]; sign off with just Best. Return ONLY valid JSON with keys subject and body. body must use \\\\n for line breaks. No markdown, no code fences."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "d30745d0-f673-4657-89a4-d78d323e2206",
      "name": "Parse Check-in Draft",
      "type": "n8n-nodes-base.code",
      "position": [
        1696,
        -256
      ],
      "parameters": {
        "jsCode": "// Parse the AI update draft. Tolerates code fences / stray text around JSON.\nconst raw = $input.first().json.output !== undefined ? $input.first().json.output : ($input.first().json.message ? $input.first().json.message.content : JSON.stringify($input.first().json));\nlet text = String(raw == null ? '' : raw).trim();\ntext = text.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\nconst m = text.match(/\\{[\\s\\S]*\\}/);\nlet parsed = null;\nif (m) {\n  try { parsed = JSON.parse(m[0]); } catch (e) {\n    try { parsed = JSON.parse(m[0].replace(/\\\\\"/g, '\"').replace(/\\\\n/g, '\\n')); } catch (e2) { parsed = null; }\n  }\n}\nconst p = $('Pick Next Quiet Project').first().json;\nlet subject = '';\nlet body = '';\nlet ai_ok = false;\nif (parsed && typeof parsed.subject === 'string' && typeof parsed.body === 'string' && parsed.subject.trim() && parsed.body.trim()) {\n  subject = parsed.subject.trim().replace(/\\s+/g, ' ').slice(0, 120);\n  body = parsed.body.trim();\n  ai_ok = true;\n} else {\n  subject = 'Quick update on ' + p.project_name;\n  body = 'Hi ' + p.client_name + ',\\\\n\\\\nWanted to keep you in the loop on ' + p.project_name + '. We are currently in the ' + p.stage + ' stage and it has been a little quiet on this thread. Nothing is blocked on our side. If anything has changed on your end, or there is something you want moved up, just reply to this email.\\\\n\\\\nBest,\\\\n' + 'The ' + p.project_name + ' team';\n}\nreturn [{ json: { ai_ok, ai_subject: subject, ai_body: body } }];\n"
      },
      "typeVersion": 2
    },
