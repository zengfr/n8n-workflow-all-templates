    {
      "id": "d15416e7-bba1-4888-beaa-eabd399b26ca",
      "name": "Rank Invoices by Due Date",
      "type": "n8n-nodes-base.code",
      "position": [
        848,
        -16
      ],
      "parameters": {
        "jsCode": "// Rank unsettled invoices by how overdue they are and build a prompt for Gemini\nconst raw = items.map(i => i.json);\nconst invoices = raw.flatMap(d => d.invoices || (Array.isArray(d) ? d : [d]));\nconst threshold = Number($('Prepare Configuration Settings').item.json.overdue_threshold_days) || 30;\nconst today = new Date();\n\nlet total = 0;\nlet severeCount = 0;\n\nconst ranked = invoices.map(inv => {\n  const amount = inv.total_amount || 0;\n  total += amount;\n  const dueDate = inv.due_date ? new Date(inv.due_date) : null;\n  const overdueDays = dueDate ? Math.max(0, Math.floor((today - dueDate) / 86400000)) : 0;\n  if (overdueDays >= threshold) severeCount += 1;\n  return {\n    partner: inv.partner_display_name || inv.partner_name || '(unknown)',\n    amount,\n    overdueDays\n  };\n}).sort((a, b) => b.overdueDays - a.overdueDays);\n\nconst listText = ranked.length\n  ? ranked.map(r => `- ${r.partner}: ¥${r.amount.toLocaleString('ja-JP')}, ${r.overdueDays} days overdue`).join('\\n')\n  : 'No unsettled invoices today.';\n\nconst promptText = `You are a concise accounting assistant. Summarize the following unsettled invoice list for a Slack notification. Group by urgency, call out any invoice over ${threshold} days overdue, and end with the total outstanding amount. Keep it under 150 words and use plain text (no markdown tables).\\n\\nInvoices (already sorted, most overdue first):\\n${listText}\\n\\nTotal outstanding: ¥${total.toLocaleString('ja-JP')}\\nInvoice count: ${ranked.length}\\nInvoices at or beyond the ${threshold}-day threshold: ${severeCount}`;\n\nreturn [{\n  json: {\n    promptText,\n    total,\n    invoiceCount: ranked.length,\n    severeCount\n  }\n}];"
      },
      "typeVersion": 2
    },
