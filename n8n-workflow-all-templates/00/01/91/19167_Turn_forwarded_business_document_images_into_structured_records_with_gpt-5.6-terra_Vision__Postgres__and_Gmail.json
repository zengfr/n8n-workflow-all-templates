      "position": [
        -96,
        144
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst lines = rows.map(r => '- [' + r.doc_type + '] ' + r.title + ' (from ' + (r.submitter || 'unknown') + ', due ' + (r.due_date || 'n/a') + ', id ' + r.doc_id + ')');\nreturn [\n  {\n    json: {\n      count: rows.length,\n      body: 'Open documents still awaiting action:\\n' + lines.join('\\n')\n    }\n  }\n];"
