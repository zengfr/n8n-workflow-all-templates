    {
      "id": "n_vision",
      "name": "Build GPT-4o vision request",
      "type": "n8n-nodes-base.code",
      "position": [
        48,
        -320
      ],
      "parameters": {
        "jsCode": "const img = $json.img_url ? $json.img_url : ('data:image/png;base64,' + $json.img_b64);\nconst system = 'You are a document intake clerk for a small business. The user forwards a photo or screenshot of a business document (receipt, invoice, contract, ID card, bank statement, bill, or other). Classify the document type, extract the key fields into a structured record, and write a short plain-language summary for a non-technical owner. Respond with ONLY valid JSON using this exact shape: {\"doc_type\": string, \"title\": string, \"summary\": string, \"extracted\": object, \"amount\": number or null, \"currency\": string or null, \"party_name\": string or null, \"doc_date\": string or null, \"due_date\": string or null, \"confidence\": number between 0 and 1}. If the image is not a readable business document, set doc_type to \"unrecognized\".';\nconst userText = 'Document type hint from sender: ' + $json.doc_type_label + '. Sender note: ' + $json.note + '.';\nreturn [{ json: { reqObj: {\n  model: 'gpt-4o', temperature: 0.1, max_tokens: 1200,\n  messages: [\n    { role: 'system', content: system },\n    { role: 'user', content: [ { type: 'text', text: userText }, { type: 'image_url', image_url: { url: img } } ] }\n  ]\n} } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "n_parseai",
      "name": "Parse vision result",
      "type": "n8n-nodes-base.code",
      "position": [
        496,
        -320
      ],
      "parameters": {
        "jsCode": "// Parse the GPT-4o vision JSON from the OpenAI response\nlet raw = '';\ntry {\n  const choices = $json.choices;\n  raw = (choices && choices[0] && choices[0].message && choices[0].message.content) || '';\n} catch (e) {\n  raw = '';\n}\nraw = (raw || '').trim();\nif (raw.startsWith('```')) {\n  raw = raw.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n}\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = { doc_type: 'unrecognized', title: 'Could not parse model output', summary: 'The vision model returned an answer we could not read.', extracted: {}, amount: null, currency: null, party_name: null, doc_date: null, due_date: null, confidence: 0 };\n}\nreturn [\n  {\n    json: {\n      doc_id: $('Normalize submission').item.json.doc_id,\n      source: $('Normalize submission').item.json.source,\n      received_at: $('Normalize submission').item.json.received_at,\n      submitter: $('Normalize submission').item.json.submitter,\n      note: $('Normalize submission').item.json.note,\n      doc_type: parsed.doc_type || 'unrecognized',\n      title: parsed.title || 'Untitled document',\n      summary: parsed.summary || '',\n      extracted: parsed.extracted || {},\n      amount: parsed.amount ?? null,\n      currency: parsed.currency || null,\n      party_name: parsed.party_name || null,\n      doc_date: parsed.doc_date || null,\n      due_date: parsed.due_date || null,\n      confidence: parsed.confidence ?? null\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
