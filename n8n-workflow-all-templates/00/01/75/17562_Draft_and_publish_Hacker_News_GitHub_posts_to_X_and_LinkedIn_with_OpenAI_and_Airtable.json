      "name": "Crawl HN Home",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1136,
        48
      ],
      "parameters": {
        "url": "https://news.ycombinator.com/",
        "options": {
          "response": {
            "response": {
