      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 320,
        "content": "## Aggregate and evaluate results\n\nGroups all finalized repository items into a single bundle and checks if there are any results to report."
      },
      "typeVersion": 1
    },
    {
      "id": "a72983b3-02ba-4308-a114-c950d0f174e5",
