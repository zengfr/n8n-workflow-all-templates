              "type": "string",
              "value": "={{ ($json.name || '').trim() }}"
            },
            {
              "id": "c2",
              "name": "repoFullName",
              "type": "string",
              "value": "={{ ($json.repoPath || '').trim().replace(/^\\//,'') }}"
            },
            {
              "id": "c3",
              "name": "repoUrl",
              "type": "string",
              "value": "={{ 'https://github.com' + ($json.repoPath || '').trim() }}"
            },
            {
              "id": "c4",
              "name": "description",
              "type": "string",
              "value": "={{ ($json.description || '').trim() || 'No description' }}"
