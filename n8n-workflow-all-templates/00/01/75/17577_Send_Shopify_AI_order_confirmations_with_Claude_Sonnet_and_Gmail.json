          "mode": "list",
          "value": "claude-sonnet-4-6",
          "cachedResultName": "Claude Sonnet 4.6"
        },
        "options": {
          "temperature": 0.5,
          "maxTokensToSample": 800
        }
      },
      "typeVersion": 1.5
    },
