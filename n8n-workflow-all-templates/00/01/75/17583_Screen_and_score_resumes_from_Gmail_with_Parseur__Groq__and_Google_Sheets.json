      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2048,
        256
      ],
      "parameters": {
        "text": "=You are an HR screening assistant. Based on the candidate details below, give a single fit score from 1 (poor fit) to 10 (excellent fit) for the applied position. Reply with ONLY the number, nothing else — no words, no punctuation.\n\nCandidate Name: {{ $json[\"Candidate Name\"] }}\nPosition Applied For: {{ $json[\"Position Applied For\"] }}\nYears of Experience:{{ $json['Years of Experiance'] }}\nKey Skills: {{ $json[\"Key Skills\"] }}",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 3.1
