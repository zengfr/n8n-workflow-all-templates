    {
      "id": "4b38d994-5734-41db-835e-5c9e70f62d8a",
      "name": "Split Into One Item Per Language",
      "type": "n8n-nodes-base.code",
      "position": [
        5344,
        1648
      ],
      "parameters": {
        "jsCode": "const g = $input.first().json.generation;\nconst langs = String($('When Content Form Submitted').item.json['Languages'] || '')\n  .split(/[;,\\s]+/)\n  .map(s => s.trim())\n  .filter(Boolean);\nif (!langs.length) throw new Error('No languages listed in the form');\nreturn langs.map(language => ({ json: { language, referenceGenerationId: g.id, originalTitle: g.title, originalUrl: (g.outputs && g.outputs[0] && g.outputs[0].fileUrl) || '' } }));"
      },
      "typeVersion": 2
    },
