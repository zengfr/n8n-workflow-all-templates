    {
      "id": "277efe8e-6ff0-4ace-ac76-b7dd3c27227a",
      "name": "Prepare Language Slack Message",
      "type": "n8n-nodes-base.code",
      "position": [
        7104,
        1696
      ],
      "parameters": {
        "jsCode": "const g = $input.first().json.generation;\nconst lang = $('Loop Over Each Language').item.json.language;\nconst urls = (g.outputs || []).map(o => o.fileUrl).join('\\n');\nconst ok = ['completed', 'partial'].includes(g.status);\nconst text = ok\n  ? `🌍 *${lang}* version ready:\\n${urls}\\nReview or edit: https://canvora.ai/generations/${g.id}`\n  : `⚠️ ${lang} localization ${g.status} — credits for failures refund automatically.`;\nreturn [{ json: { text } }];"
      },
      "typeVersion": 2
