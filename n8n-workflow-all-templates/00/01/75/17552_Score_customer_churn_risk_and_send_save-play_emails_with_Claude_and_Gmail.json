      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -80,
        -176
      ],
      "parameters": {
        "color": 5,
        "width": 316,
        "height": 392,
        "content": "### 📥 Input payload (POST JSON)\n`customer_id, customer_name, email, plan_value, days_since_login, usage_change_pct, email_open_rate, support_sentiment, days_to_renewal, open_tickets`\n\nMissing fields default safely. Send one customer per call (loop upstream for bulk)."
      },
      "typeVersion": 1
    },
