      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst product = body.product;\nconst asset = product.asset;\n\nif (!asset || !asset.assetBlobId) throw new Error(\"No GLB found for product \" + product.uuid);\n\nreturn [{\n  json: {\n    productUuid: product.uuid,\n    productName: product.name,\n    organizationUuid: body.organization.uuid,\n    clientUuid: body.client.uuid,\n    modelBlobId: asset.assetBlobId\n  }\n}];"
      },
      "typeVersion": 2
    },
