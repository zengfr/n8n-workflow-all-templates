    {
      "id": "2c1dd0ac-c989-40ec-b15a-5b1e61f4a884",
      "name": "Build AI Prompt and Metadata",
      "type": "n8n-nodes-base.set",
      "position": [
        4448,
        400
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "4130a980-9b69-4dc3-915d-8de73c1e55a6",
              "name": "digest_date",
              "type": "string",
              "value": "={{ $now.setZone('Africa/Casablanca').toFormat('yyyy-LL-dd') }}"
            },
            {
              "id": "c58d0860-77b2-41ca-8870-d09c8734fa3c",
              "name": "article_count",
              "type": "number",
              "value": "={{ $json.articles.length }}"
            },
            {
              "id": "3c34f451-6f93-4048-821b-a61377146adb",
              "name": "ai_prompt",
              "type": "string",
              "value": "={{ \"You are a strict senior news editor producing ONE daily Telegram intelligence brief.\\n\\nDATE: \" + $now.setZone('Africa/Casablanca').toFormat('yyyy-LL-dd') + \"\\nOUTPUT LANGUAGE: \" + $('Set Telegram Chat and Language').first().json.digest_language + \"\\n\\nUse ONLY the supplied RSS data. Do not invent facts, quotes, numbers, causes, context, or consequences.\\n\\nYOUR JOB:\\n1. Detect headlines about the same underlying event and merge them into ONE story.\\n2. Ignore clickbait, celebrity gossip, routine sports, minor local crime, opinion pieces and low-value stories unless globally significant.\\n3. Select only the 8-12 most important DISTINCT events.\\n4. Cover World, Morocco, AI/Tech, Business/Economy, Markets and Science when there are genuinely important stories.\\n5. Score each selected event from 1-10. Normally include only 7/10 or higher.\\n6. Prefer consequential events: geopolitics, policy, elections, macroeconomics, major company/AI moves, market shocks, disasters, important science and developments materially affecting Morocco.\\n7. Rank from most important to least important.\\n\\nRETURN ONLY THE FINAL TELEGRAM MESSAGE. No JSON. No code fence. Keep it under 3000 characters.\\n\\nFORMAT:\\n📰 DAILY NEWS INTELLIGENCE — DATE\\n\\n🔴 10/10 · [WORLD]\\nHeadline\\n1-2 sentence factual summary.\\nWhy it matters: one short sentence.\\nSource: Publisher\\nRead: URL\\n\\n──────────────\\n\\nFinish with:\\n📊 ANALYZED: X recent headlines\\n⭐ SELECTED: X important stories\\n\\nINPUT ARTICLES:\\n\" + JSON.stringify($json.articles) }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
