    {
      "id": "5b42746f-7c11-4f7c-a542-0035ad752569",
      "name": "Test Bright Data",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Connectivity/authentication test for Bright Data.\n\nThis intentionally uses the SAME Bright Data request endpoint and zone used by the production workflow:\n- Endpoint: https://api.brightdata.com/request\n- Zone: fetch_truths\n- Target: Truth Social account statuses\n- Limit: 1\n\nIf this node returns a successful Bright Data response, the configured Bearer credential and zone are usable.\n\nIf you get \"Missing zone parameter\", verify that this node uses POST and that the JSON body contains `zone: fetch_truths`.\nIf you get a zone/authorization error, verify the Bright Data credential and that the `fetch_truths` zone exists for the customer's account.\n\nThis test does not store or expose the API key.",
      "position": [
        1168,
        -112
      ],
      "parameters": {
        "url": "https://api.brightdata.com/request",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "authentication": "genericCredentialType",
        "bodyParameters": {
          "parameters": [
            {}
          ]
        },
        "genericAuthType": "httpBearerAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "48c1ec3e-1286-400b-9abf-f9c80a2d2610",
      "name": "Test ChatGPT",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Connectivity/authentication test for OpenAI.\n\nThis sends a deliberately tiny request to the OpenAI Responses API using the selected n8n OpenAI credential.\n\nExpected successful response:\n- HTTP 200\n- A response object containing the model output.\n\nIf you see \"Invalid request to GET /v1/responses\", the HTTP Request node is not using POST. This node is explicitly configured with requestMethod=POST and sendBody=true.\n\nIf you see an authentication error, select/create the customer's OpenAI API credential in this node.\nThe API key is stored in n8n credentials and is never written to the Data Table.",
      "position": [
        1424,
        -112
      ],
      "parameters": {
        "url": "https://api.openai.com/v1/responses",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "sendHeaders": true,
        "authentication": "predefinedCredentialType",
        "bodyParameters": {
          "parameters": [
            {}
          ]
        },
        "headerParameters": {
          "parameters": [
            {}
          ]
        },
        "nodeCredentialType": "openAiApi"
      },
      "typeVersion": 4.2
    },
    {
      "id": "13c4f170-6ded-4441-bd6b-e9b41c7f26f2",
      "name": "Setup Test Summary",
      "type": "n8n-nodes-base.code",
      "notes": "Produces a concise final setup summary after the state table and API tests have run.",
      "position": [
        2032,
        368
      ],
      "parameters": {
        "jsCode": "const bright = $('Test Bright Data').first().json;\nconst openai = $('Test ChatGPT').first().json;\n\nconst brightError = bright?.error?.message || bright?.message || bright?.data?.error || null;\nconst openaiError = openai?.error?.message || openai?.message || null;\n\nreturn [{\n  json: {\n    setup_status: (!brightError && !openaiError) ? 'complete' : 'failed',\n    state_table: 'workflow_state',\n    last_id: 0,\n    bright_data_test: brightError ? `FAILED: ${brightError}` : 'PASSED',\n    openai_test: openaiError ? `FAILED: ${openaiError}` : 'PASSED',\n    message: (!brightError && !openaiError)\n      ? 'Setup checks completed successfully. workflow_state is initialized and both API tests passed.'\n      : 'Setup completed with one or more failed checks. Inspect Test Bright Data and Test ChatGPT for details.'\n  }\n}];"
      },
      "typeVersion": 2
    },
