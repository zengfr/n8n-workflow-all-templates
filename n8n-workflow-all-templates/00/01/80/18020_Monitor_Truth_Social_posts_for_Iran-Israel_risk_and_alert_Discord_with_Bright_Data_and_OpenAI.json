      "parameters": {
        "color": 3,
        "width": 600,
        "height": 320,
        "content": "## 2. API Connection Tests\nVerifies authentication for Bright Data and OpenAI before running the main workflow. These nodes do not affect production data."
      },
      "typeVersion": 1
