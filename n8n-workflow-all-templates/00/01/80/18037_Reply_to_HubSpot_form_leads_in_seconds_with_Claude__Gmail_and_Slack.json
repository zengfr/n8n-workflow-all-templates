    {
      "id": "5c3fb860-8b19-41ec-afa2-57a08befffa4",
      "name": "Normalize HubSpot Data",
      "type": "n8n-nodes-base.code",
      "position": [
        656,
        768
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst events = Array.isArray(b) ? b : [b];\n// contact.creation only; drop bulk imports before any API call is spent on them\nreturn events\n  .filter(function(e){ return e && e.objectId && e.subscriptionType === 'contact.creation' && e.changeSource !== 'IMPORT'; })\n  .map(function(e){ return {json: e}; });"
      },
      "typeVersion": 2
    },
