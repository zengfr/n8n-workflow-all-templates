    {
      "id": "7b07ac30-923b-4a27-a29f-29eef2856c60",
      "name": "Draft Reply with Claude Agent",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "position": [
        1840,
        448
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-4-5"
        },
        "options": {
          "system": "You are the instant first responder for an inbound sales team. You draft short, warm, specific reply emails to new leads within seconds of their form submission. You never invent facts about the lead or the company. If the lead left no message, write a friendly welcome that references their company instead. Output strict JSON only.",
          "maxTokens": 1024,
          "temperature": 0.4
        },
        "messages": {
          "values": [
            {
              "content": "=A new lead just submitted the form \"{{ $json.formName }}\". Draft their instant reply email now.\n\nLEAD\nName: {{ $json.leadFirstName }} {{ $json.leadLastName }}\nEmail: {{ $json.leadEmail }}\nCompany: {{ $json.leadCompany }}\nJob title: {{ $json.leadJobTitle }}\nWebsite: {{ $json.leadWebsite }}\nTheir message: {{ $json.leadMessage }}\n\nABOUT US\nCompany: {{ $json.companyName }}\nWhat we do: {{ $json.whatWeDo }}\nBooking link: {{ $json.bookingLink }}\nDo not add any sign-off, name, or signature at the end; the sender's real signature block is appended automatically after your last paragraph.\n\nGUIDELINES\n{{ $json.replyGuidelines }}\n\nReturn STRICT JSON only, no markdown fences, with exactly these keys:\n{\"subject\": \"...\", \"body_html\": \"... simple HTML paragraphs only ...\", \"summary\": \"one sentence on who the lead is and what they want\"}"
            }
          ]
        }
      },
      "typeVersion": 1
    },
