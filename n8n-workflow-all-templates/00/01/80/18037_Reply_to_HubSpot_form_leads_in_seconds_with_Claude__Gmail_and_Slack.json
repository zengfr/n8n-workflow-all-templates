              "value": "={{ (JSON.parse($json.content[0].text.replace(/^\\s*\\u0060\\u0060\\u0060(?:json)?/i, '').replace(/\\u0060\\u0060\\u0060\\s*$/, '').trim()).subject).replace(/\\u2014/g, ', ').replace(/\\u2013/g, '-') }}"
            },
            {
              "id": "2",
              "name": "bodyHtml",
