              "type": "string",
              "value": "EDIT ME: e.g. Alex from Acme"
            },
            {
              "id": "s3",
              "name": "whatWeDo",
              "type": "string",
              "value": "EDIT ME: One or two sentences on what your company does and who you help."
            },
            {
              "id": "s4",
              "name": "bookingLink",
              "type": "string",
              "value": "EDIT ME: https://your-booking-or-calendar-link"
            },
            {
              "id": "s5",
              "name": "replyGuidelines",
              "type": "string",
              "value": "Reply to what the lead actually wrote. Acknowledge their specific question or problem in one sentence. Connect it to how we help in one sentence, no more. Invite them to book a call on the booking link if they want to talk it through. If they left no message, send a short friendly welcome that references their company and offer the call. Keep it under 100 words. Sound like a person, not a campaign. No hype, no jargon, no placeholder text. Do not pitch services or pricing. Never promise deliverables or timelines. Never claim the lead requested something unless their message says so."
            },
            {
              "id": "s6",
              "name": "slackChannel",
              "type": "string",
              "value": "EDIT ME: your-slack-channel-name"
            },
            {
              "id": "s7",
              "name": "allowedForms",
              "type": "string",
              "value": ""
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
