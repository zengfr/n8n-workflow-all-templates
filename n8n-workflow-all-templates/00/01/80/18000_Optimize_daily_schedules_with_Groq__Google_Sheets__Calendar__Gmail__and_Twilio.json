        "jsCode": "// ============================================\n// 1. PARSE LLM OUTPUT\n// ============================================\nconst text = $json.text ?? \"\";\nconst clean = text.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(clean);\n  if (!parsed || !Array.isArray(parsed.conflicts)) {\n    throw new Error(\"LLM output does not contain a conflicts array\");\n  }\n} catch (error) {\n  // Parse failed -> surface it, write nothing\n  return [{\n    json: {\n      success: false,\n      error: \"Invalid JSON from LLM\",\n      message: error.message,\n      raw: clean,\n      state: [],\n      daily_routine: []\n    }\n  }];\n}\n\nconst conflicts = parsed.conflicts;\n\n// No NEW conflicts this run -> sheet already holds the correct times.\n// Return empty arrays so nothing is rewritten (idempotent, saves quota).\nif (conflicts.length === 0) {\n  return [{ json: { success: true, state: [], daily_routine: [] } }];\n}\n\n// ============================================\n// 2. GET CURRENT ROUTINE FROM MERGE NODE\n// ============================================\nconst data = $('Merge Data for AI Processing').first().json;\nconst routine = Array.isArray(data.DataRoutine) ? data.DataRoutine : [];\n\n// ============================================\n// HELPERS\n// ============================================\nfunction toMinutes(time) {\n  if (time === null || time === undefined || time === '') return null;\n  const [h, m] = String(time).split(':').map(Number);\n  if (Number.isNaN(h) || Number.isNaN(m)) return null;\n  return h * 60 + m;\n}\nfunction toTime(minutes) {\n  minutes = ((minutes % 1440) + 1440) % 1440;\n  const h = Math.floor(minutes / 60);\n  const m = minutes % 60;\n  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;\n}\n\n// ============================================\n// 3. BUILD FIXED EVENTS (dedup on event_id)\n// ============================================\nconst seen = new Set();\nconst stateIds = [];      // -> state array (strings)\nconst fixedEvents = [];\nconst maxRoutineRow = Math.max(0, ...routine.map(i => Number(i.row_number) || 0));\nlet nextFixedRow = maxRoutineRow + 1;\n\nfor (const row of conflicts) {\n  if (!row || !row.event_id) continue;\n  if (seen.has(row.event_id)) continue;\n  seen.add(row.event_id);\n\n  const start = toMinutes(row.event_start);\n  const end = toMinutes(row.event_end);\n  if (start === null || end === null) continue;\n\n  fixedEvents.push({\n    row_number: nextFixedRow,\n    Activity: row.event,\n    \"Start Time\": toTime(start),\n    \"Duration (min)\": end - start,\n    Category: \"Meeting (fixed)\",\n    _start: start,\n    _end: end\n  });\n  stateIds.push(row.event_id);\n  nextFixedRow++;\n}\n\n// ============================================\n// 4. SHIFT ROUTINE AROUND OCCUPIED BLOCKS\n// ============================================\nconst occupied = fixedEvents.map(e => ({ start: e._start, end: e._end }));\n\nconst sortedRoutine = [...routine].sort((a, b) => {\n  const as = toMinutes(a[\"Start Time\"]);\n  const bs = toMinutes(b[\"Start Time\"]);\n  if (as === bs) return Number(a.row_number) - Number(b.row_number);\n  return as - bs;\n});\n\nconst shifted = sortedRoutine.map(item => {\n  const duration = Number(item[\"Duration (min)\"]);\n  let start = toMinutes(item[\"Start Time\"]);\n  if (start === null || Number.isNaN(duration)) return null;\n  let end = start + duration;\n\n  let changed = true;\n  while (changed) {\n    changed = false;\n    for (const block of occupied) {\n      if (start < block.end && end > block.start) {\n        start = block.end;\n        end = start + duration;\n        changed = true;\n        break;\n      }\n    }\n  }\n  occupied.push({ start, end });\n\n  return {\n    row_number: item.row_number,\n    Activity: item.Activity,\n    \"Start Time\": toTime(start),\n    \"Duration (min)\": duration,\n    Category: item.Category,\n    _start: start,\n    _end: end\n  };\n}).filter(Boolean);\n\n// ============================================\n// 5. MERGE + CLEAN INTERNAL FIELDS\n// ============================================\nconst daily_routine = [...fixedEvents, ...shifted]\n  .sort((a, b) => (a._start !== b._start)\n    ? a._start - b._start\n    : Number(a.row_number) - Number(b.row_number))\n  .map(({ _start, _end, ...clean }) => clean);\n\nreturn [{\n  json: {\n    success: true,\n    state: stateIds,       // array of strings (event_ids)\n    daily_routine          // array of objects (full recomputed schedule)\n  }\n}];"
      },
      "typeVersion": 2
    },
