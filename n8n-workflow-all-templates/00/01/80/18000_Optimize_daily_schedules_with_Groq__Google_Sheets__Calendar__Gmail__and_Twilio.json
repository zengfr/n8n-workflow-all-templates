    {
      "id": "cf15cffd-b451-4008-be30-3bc3e0a8d012",
      "name": "Decide Communication Method",
      "type": "n8n-nodes-base.code",
      "position": [
        1008,
        1120
      ],
      "parameters": {
        "jsCode": "const now = $now.setZone(\"Asia/Makassar\");\nconst currentMinutes = now.hour * 60 + now.minute;\n\nreturn items\n  .map(item => {\n    const startTime = item.json[\"Start Time\"];\n    if (!startTime) return null;\n\n    const [hour, minute] = startTime.split(\":\").map(Number);\n\n    const activityMinutes = hour * 60 + minute;\n    const minutesUntil = activityMinutes - currentMinutes;\n\n    // Lewati aktivitas yang sudah lewat\n    if (minutesUntil < 0) return null;\n\n    // Lewati aktivitas yang masih terlalu jauh (>60 menit)\n    if (minutesUntil > 60) return null;\n\n    let reminderType = null;\n\n    // 0–15 menit → Telepon\n    if (minutesUntil <= 15) {\n      reminderType = \"call\";\n    }\n    // 16–30 menit → Email kedua\n    else if (minutesUntil <= 30) {\n      reminderType = \"email30\";\n    }\n    // 31–60 menit → Email pertama\n    else {\n      reminderType = \"email60\";\n    }\n\n    return {\n      json: {\n        ...item.json,\n        minutesUntil,\n        reminderType,\n      }\n    };\n  })\n  .filter(Boolean);"
      },
      "typeVersion": 2
    },
