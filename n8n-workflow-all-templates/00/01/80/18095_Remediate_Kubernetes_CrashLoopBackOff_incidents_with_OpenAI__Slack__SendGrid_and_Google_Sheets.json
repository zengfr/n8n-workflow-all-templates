      "name": "Prepare Rollback Result Data",
      "type": "n8n-nodes-base.code",
      "position": [
        8720,
        3456
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst outcome = item.rollbackAvailable\n  ? `Rolled back deployment ${item.deployment} to revision ${item.rollbackRevision}`\n  : `Rollback requested but no earlier stable revision was found for ${item.deployment}; escalated instead`;\n\nreturn [{ json: { ...item, actionTaken: outcome } }];"
      },
      "typeVersion": 2
    },
