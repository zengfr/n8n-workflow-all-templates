      ],
      "parameters": {
        "jsCode": "// Pick the most recent ReplicaSet that previously had replicas > 0 and isn't the current one\nconst item = $('Parse AI Crash Diagnosis').item.json;\nconst replicaSets = ($input.first().json.items) || [];\n\nconst sorted = replicaSets\n  .filter(rs => (rs.status && rs.status.replicas > 0) || (rs.spec && rs.spec.replicas > 0))\n  .sort((a, b) => new Date(b.metadata.creationTimestamp) - new Date(a.metadata.creationTimestamp));\n\n// Skip the newest (current, crashing) revision; take the next stable one\nconst target = sorted[1] || sorted[0] || null;\n\nreturn [{\n  json: {\n    ...item,\n    rollbackRevision: target ? target.metadata.name : null,\n    rollbackPodTemplate: target ? target.spec.template : null,\n    rollbackAvailable: !!target\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "8fe5eae5-290f-49fc-bab3-0a909a33fa48",
      "name": "Patch Deployment for Rollback",
