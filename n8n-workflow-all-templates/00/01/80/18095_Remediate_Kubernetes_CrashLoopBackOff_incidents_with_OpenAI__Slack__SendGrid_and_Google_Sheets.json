    {
      "id": "0cdd0fa2-dc0d-40f9-af1e-1fe925abcd52",
      "name": "Parse AI Crash Diagnosis",
      "type": "n8n-nodes-base.code",
      "position": [
        7552,
        3200
      ],
      "parameters": {
        "jsCode": "// Safely parse the AI's structured diagnosis; default to escalate on any doubt\nconst item = $input.item.json;\nconst raw = item.output || item.text || item.response || '{}';\n\nlet parsed = {};\ntry {\n  const cleaned = String(raw).replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    rootCause: 'Unknown',\n    confidence: 0,\n    summary: 'Could not parse AI diagnosis output.',\n    recommendedAction: 'escalate',\n    reasoning: 'unparseable_ai_response'\n  };\n}\n\nconst CONFIDENCE_THRESHOLD = 60;\nlet action = (parsed.recommendedAction || 'escalate').toLowerCase();\nif ((parsed.confidence || 0) < CONFIDENCE_THRESHOLD) {\n  action = 'escalate';\n}\n\nconst original = $('Prepare Log Data for AI').item.json;\n\nreturn {\n  json: {\n    ...original,\n    rootCause: parsed.rootCause || 'Unknown',\n    confidence: parsed.confidence || 0,\n    diagnosisSummary: parsed.summary || '',\n    recommendedAction: action,\n    reasoning: parsed.reasoning || ''\n  }\n};"
      },
      "typeVersion": 2
    },
