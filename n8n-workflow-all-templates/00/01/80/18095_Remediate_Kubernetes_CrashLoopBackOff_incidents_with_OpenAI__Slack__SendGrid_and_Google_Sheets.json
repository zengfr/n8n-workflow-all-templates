    {
      "id": "d1f9eefa-2d6c-4246-880d-9719045d1e99",
      "name": "Scan CrashLoopBackOff Pods",
      "type": "n8n-nodes-base.code",
      "position": [
        6160,
        3296
      ],
      "parameters": {
        "jsCode": "// Scan all pods for containers currently in CrashLoopBackOff\nconst pods = ($input.first().json.items) || [];\n\nconst crashPods = pods.filter(pod => {\n  const statuses = (pod.status && pod.status.containerStatuses) || [];\n  return statuses.some(cs => cs.state && cs.state.waiting && cs.state.waiting.reason === 'CrashLoopBackOff');\n});\n\nif (crashPods.length === 0) {\n  return [{ json: { crashLoopPodsFound: false } }];\n}\n\nreturn crashPods.map(pod => {\n  const statuses = (pod.status && pod.status.containerStatuses) || [];\n  const crashed = statuses.find(cs => cs.state && cs.state.waiting && cs.state.waiting.reason === 'CrashLoopBackOff') || {};\n  const ownerName = (pod.metadata.ownerReferences && pod.metadata.ownerReferences[0] && pod.metadata.ownerReferences[0].name) || '';\n\n  return {\n    json: {\n      crashLoopPodsFound: true,\n      podName: pod.metadata.name,\n      namespace: pod.metadata.namespace,\n      deployment: ownerName.replace(/-[a-z0-9]+$/, ''),\n      containerName: crashed.name || '',\n      restartCount: crashed.restartCount || 0,\n      lastTerminatedReason: (crashed.lastState && crashed.lastState.terminated && crashed.lastState.terminated.reason) || 'unknown',\n      exitCode: (crashed.lastState && crashed.lastState.terminated && crashed.lastState.terminated.exitCode) ?? null,\n      detectedAt: new Date().toISOString(),\n      incidentId: 'K8S-' + Date.now().toString()\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
