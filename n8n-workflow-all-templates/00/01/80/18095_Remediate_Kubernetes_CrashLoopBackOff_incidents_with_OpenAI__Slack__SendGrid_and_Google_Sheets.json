    {
      "id": "3acba73f-4351-4a7a-8dff-47b810cacd14",
      "name": "Prepare Log Data for AI",
      "type": "n8n-nodes-base.code",
      "position": [
        7040,
        3200
      ],
      "parameters": {
        "jsCode": "// Merge crash metadata with a trimmed log excerpt for the AI to read\nconst podInfo = $('Scan CrashLoopBackOff Pods').item.json;\nconst logsResponse = $input.first().json;\nconst rawLogs = (typeof logsResponse === 'string') ? logsResponse : (logsResponse.data || JSON.stringify(logsResponse));\n\nreturn {\n  json: {\n    ...podInfo,\n    logExcerpt: String(rawLogs || '').slice(-4000)\n  }\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "fbc3fab8-cd23-4fce-a489-394a4a237485",
      "name": "Log Analysis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        7216,
        3200
      ],
      "parameters": {
        "text": "=You are a Kubernetes SRE assistant. A pod is stuck in CrashLoopBackOff. Read the crash metadata and recent logs below and return ONLY a JSON object (no markdown, no commentary) with these fields:\n\n- rootCause (string, one of: \"OOMKilled\", \"ImagePullError\", \"ConfigError\", \"DependencyUnavailable\", \"ApplicationBug\", \"LivenessProbeFailure\", \"Unknown\")\n- confidence (number 0-100)\n- summary (short string, plain-language explanation of the root cause)\n- recommendedAction (string, one of: \"restart\", \"scaleUp\", \"rollback\", \"escalate\")\n- reasoning (short string, why this action was chosen)\n\nPod: {{ $json.podName }}\nNamespace: {{ $json.namespace }}\nContainer: {{ $json.containerName }}\nRestart Count: {{ $json.restartCount }}\nLast Terminated Reason: {{ $json.lastTerminatedReason }}\nExit Code: {{ $json.exitCode }}\n\nRecent logs (tail):\n{{ $json.logExcerpt }}",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 1.6
    },
    {
      "id": "baf3712d-bf78-4247-b2f4-1172271e7be6",
      "name": "OpenAI GPT-4.1-Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        7600,
        3408
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini"
