    {
      "id": "49b47075-dda5-4255-b318-d8488e75afc8",
      "name": "Determine Scaling Target",
      "type": "n8n-nodes-base.code",
      "position": [
        8048,
        3120
      ],
      "parameters": {
        "jsCode": "// Simple scale-up: current replicas + 1, capped at MAX_REPLICAS\nconst MAX_REPLICAS = 10;\nconst item = $input.first().json;\nconst currentReplicas = item.currentReplicas || 1;\nconst newReplicas = Math.min(currentReplicas + 1, MAX_REPLICAS);\n\nreturn [{ json: { ...item, newReplicas } }];"
      },
      "typeVersion": 2
    },
