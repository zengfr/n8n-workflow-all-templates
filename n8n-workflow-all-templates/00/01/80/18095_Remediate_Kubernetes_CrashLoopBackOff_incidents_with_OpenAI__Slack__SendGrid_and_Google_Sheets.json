      "parameters": {
        "url": "=https://YOUR_K8S_API_SERVER/apis/apps/v1/namespaces/{{ $json.namespace }}/deployments/{{ $json.deployment }}",
        "method": "PATCH",
        "options": {},
        "jsonBody": "={\n  \"spec\": { \"template\": {{ JSON.stringify($json.rollbackPodTemplate) }} }\n}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
