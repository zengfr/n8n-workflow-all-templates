          "combinator": "and",
          "conditions": [
            {
              "id": "0ca5e6ea-f952-465f-a7bb-56407580b958",
              "operator": {
                "type": "string",
                "operation": "regex"
              },
              "leftValue": "={{ $json.messageText }}",
              "rightValue": "/(?:youtu\\.be\\/|youtube\\.com\\/(?:watch\\?(?:.*&)?v=|shorts\\/|embed\\/|live\\/))[A-Za-z0-9_-]{11}/i"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
