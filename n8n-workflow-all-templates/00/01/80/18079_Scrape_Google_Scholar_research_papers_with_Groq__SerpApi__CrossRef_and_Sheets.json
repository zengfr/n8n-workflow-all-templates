    {
      "id": "1a3e0b40-45f6-4a4c-a270-2bbc5833413e",
      "name": "Combine CrossRef & Scholar Data",
      "type": "n8n-nodes-base.code",
      "position": [
        3328,
        1424
      ],
      "parameters": {
        "jsCode": "// CrossRef result + Scholar data combine karo\nconst crossrefData = $input.item.json;\n\n// Loop Over Items se original scholar data lo\nconst scholarItem = $input.item.json._scholar || $('Process Batch Items').item.json;\n\nconst result = crossrefData.message?.items?.[0];\nlet doi = result?.DOI || 'N/A';\nlet doi_url = result?.URL || (doi !== 'N/A' ? 'https://doi.org/' + doi : 'N/A');\n\nif (doi !== 'N/A') {\n  doi = doi.replace(/[.,;)>\\s]+$/, '');\n}\n\nreturn [{\n  json: {\n    query: scholarItem.query || 'N/A',\n    title: scholarItem.title || 'N/A',\n    authors: scholarItem.authors || 'N/A',\n    year: scholarItem.year || 'N/A',\n    journal: scholarItem.journal || 'N/A',\n    snippet: scholarItem.snippet || '',\n    link: scholarItem.link || 'N/A',\n    cited_by: scholarItem.cited_by || 0,\n    doi: doi,\n    doi_url: doi_url\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "fd7fd776-7534-4a44-b433-f71eb29b95dd",
      "name": "Remove Duplicate Entries",
      "type": "n8n-nodes-base.code",
      "position": [
        3376,
        1072
      ],
      "parameters": {
        "jsCode": "const seen = new Set();\n\nreturn items.filter(item => {\n  if (seen.has(item.json.link)) return false;\n  seen.add(item.json.link);\n  return true;\n});"
      },
      "typeVersion": 2
    },
