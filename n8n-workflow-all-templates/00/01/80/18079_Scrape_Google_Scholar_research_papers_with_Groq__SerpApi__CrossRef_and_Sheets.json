    {
      "id": "e8f8366c-3769-41ff-925f-c959fd852def",
      "name": "LLM Chain Processor",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1200,
        1088
      ],
      "parameters": {
        "batching": {},
        "messages": {
          "messageValues": [
            {
              "message": "=You are an expert in academic research and Google Scholar search optimization.\n\nYour task is to convert the user's research title and description into at least 3 highly relevant Google Scholar search queries.\n\nRules:\n- Use short academic keywords\n- Remove unnecessary words\n- Add synonyms using OR\n- Combine concepts using AND\n- Use quotes for exact phrases\n- Focus on research-friendly terms\n- Prioritize terms used in research papers\n\nOutput:\nReturn ONLY valid JSON in this format:\n{\n  \"query1\": \"query 1\",\n  \"query1\": \"query 2\",\n  \"query1\": \"query 3\",\n  \"query1\": \"query 4\",\n  \"query1\": \"query 5\"\n}"
            }
          ]
        }
      },
      "typeVersion": 1.7
    },
