    {
      "id": "f20e5be2-ed0f-4fc8-b7fd-7ffe29542e1c",
      "name": "Flatten Google Results",
      "type": "n8n-nodes-base.code",
      "position": [
        2480,
        1088
      ],
      "parameters": {
        "jsCode": "let output = [];\nitems.forEach(item => {\n  const results = item.json.organic_results || [];\n  results.forEach((res, index) => {\n    \n    // DOI extract karo link se\n    const link = res.link || '';\n    let doi = 'N/A';\n    if (link.includes('doi.org/')) {\n      doi = link.split('doi.org/')[1].split('?')[0];\n    } else {\n      const doiMatch = link.match(/10\\.\\d{4,}\\/[^\\s&?#]+/);\n      if (doiMatch) doi = doiMatch[0];\n    }\n\n    // Year extract karo summary se\n    const summary = res.publication_info?.summary || '';\n    const year = summary.match(/\\d{4}/)?.[0] || 'N/A';\n\n    output.push({\n      query: item.json.search_parameters.q,\n      title: res.title,\n      link: link,\n      doi: doi,\n      doi_url: doi !== 'N/A' ? 'https://doi.org/' + doi : 'N/A',\n      year: year,\n      snippet: res.snippet,\n      authors: summary,\n      cited_by: res.inline_links?.cited_by?.total || 0\n    });\n  });\n});\nreturn output;"
      },
      "typeVersion": 2
    },
