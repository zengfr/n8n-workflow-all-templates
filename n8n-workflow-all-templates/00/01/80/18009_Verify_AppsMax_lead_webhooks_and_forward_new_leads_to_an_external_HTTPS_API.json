    {
      "id": "8734f58a-0c9e-4e79-9823-8bc45ea6d33d",
      "name": "Compare signatures",
      "type": "n8n-nodes-base.code",
      "position": [
        -420,
        120
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst expected = String(item.json.appsmax_hmac ?? '');\nconst received = String(item.json.headers?.['x-appsmax-signature'] ?? '');\nconst validFormat = /^[a-f0-9]{64}$/.test(expected) && /^[a-f0-9]{64}$/.test(received);\nlet difference = 0;\nfor (let index = 0; index < 64; index += 1) {\n  difference |= (expected.charCodeAt(index) || 0) ^ (received.charCodeAt(index) || 0);\n}\nconst json = { ...item.json, appsmax_signature_valid: validFormat && difference === 0 };\ndelete json.appsmax_hmac;\nreturn [{ json }];"
      },
      "typeVersion": 2
    },
