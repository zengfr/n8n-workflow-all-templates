    {
      "id": "dddd967d-7fe9-45da-8339-013f15d8a769",
      "name": "Compute Days Overdue",
      "type": "n8n-nodes-base.code",
      "position": [
        480,
        48
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst due = new Date(r['Due Date'] || r.dueDate || '');\nconst today = new Date();\nlet days = 0;\nif (!isNaN(due.getTime())) { days = Math.floor((today - due) / 86400000); }\nconst last = String(r['Last Reminder'] || '');\nlet daysSinceReminder = 999;\nif (last) { const l = new Date(last); if (!isNaN(l.getTime())) { daysSinceReminder = Math.floor((today - l) / 86400000); } }\nlet stage = 'not_due';\nif (days > 30) stage = 'escalate';\nelse if (days > 7) stage = 'firm';\nelse if (days > 0) stage = 'gentle';\nconst shouldSend = stage !== 'not_due' && daysSinceReminder >= 5;\nreturn { invoiceNo: r['Invoice No'] || '', client: r.Client || '', email: r['Contact Email'] || '', amount: r.Amount || '', dueDate: r['Due Date'] || '', daysOverdue: days, stage: shouldSend ? stage : 'skip', daysSinceReminder: daysSinceReminder };"
      },
      "typeVersion": 2
    },
    {
      "id": "39bd8812-0f03-42be-b512-70a6752b244b",
      "name": "Write Reminder with Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        720,
        48
      ],
      "parameters": {
        "text": "=You are an accounts receivable specialist. Write a payment reminder email body (no subject line) to {{ $json.client }} about invoice {{ $json.invoiceNo }} for {{ $json.amount }}, which was due on {{ $json.dueDate }} and is now {{ $json.daysOverdue }} days overdue.\n\nTone must match the stage \"{{ $json.stage }}\": gentle = warm nudge assuming they simply forgot; firm = polite but clear, ask for a payment date; escalate = professional and serious, mention it may be passed to accounts and request immediate contact. Always stay courteous and never threaten legal action. Max 120 words.",
        "batching": {},
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
