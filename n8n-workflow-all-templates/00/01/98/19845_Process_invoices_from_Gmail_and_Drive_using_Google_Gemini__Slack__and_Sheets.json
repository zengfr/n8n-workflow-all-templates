    {
      "id": "5ae88287-3528-4aa8-8828-4b4f29582723",
      "name": "Determine Approval Route",
      "type": "n8n-nodes-base.code",
      "position": [
        -208,
        288
      ],
      "parameters": {
        "jsCode": "const extraction = $(\"Parse & Validate Extraction\").first().json;\nconst classificationItem = $input.first().json;\nlet category = \"Other\";\nconst c = classificationItem.content;\nif (c && typeof c === \"object\" && Array.isArray(c.parts) && c.parts[0] && typeof c.parts[0].text === \"string\") {\n  category = c.parts[0].text;\n} else if (typeof c === \"string\") {\n  category = c;\n} else if (typeof classificationItem.text === \"string\") {\n  category = classificationItem.text;\n} else if (typeof classificationItem.output === \"string\") {\n  category = classificationItem.output;\n}\ncategory = category.trim();\nconst total = Number(extraction.total) || 0;\nconst needsApproval = total > 500;\nreturn [{\n  json: {\n    vendor_name: extraction.vendor_name,\n    invoice_number: extraction.invoice_number,\n    invoice_date: extraction.invoice_date,\n    due_date: extraction.due_date,\n    subtotal: extraction.subtotal,\n    tax: extraction.tax,\n    total: extraction.total,\n    currency: extraction.currency,\n    category: category,\n    source: extraction.source,\n    needsApproval: needsApproval\n  }\n}];"
      },
      "typeVersion": 2
    },
