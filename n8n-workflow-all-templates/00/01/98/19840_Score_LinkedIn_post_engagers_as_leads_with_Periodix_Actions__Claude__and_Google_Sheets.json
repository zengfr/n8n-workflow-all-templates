      "parameters": {
        "jsCode": "const post = $('Current Post').item.json;\nreturn $input.all().map(i => { const j = i.json; return { json: {\n  source: 'reaction',\n  name: j.name || [j.first_name, j.last_name].filter(Boolean).join(' ') || '',\n  headline: j.headline || j.occupation || '',\n  company: j.company || j.company_name || '',\n  provider_id: j.provider_id || j.id || j.entity_urn || '',\n  profile_url: j.profile_url || j.public_url || j.url || '',\n  matched_post: post.post_text,\n  post_url: post.post_url\n} }; });"
