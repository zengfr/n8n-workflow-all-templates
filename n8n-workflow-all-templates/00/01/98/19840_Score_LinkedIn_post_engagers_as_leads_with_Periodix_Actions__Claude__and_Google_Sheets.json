    {
      "id": "6143d7c3-f156-45d4-95fd-a6968e5c8a3c",
      "name": "Extract Posts",
      "type": "n8n-nodes-base.code",
      "position": [
        672,
        512
      ],
      "parameters": {
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const i of $input.all()) {\n  const j = i.json;\n  const id = j.social_id || j.id || j.entity_urn || j.urn || j.post_id || '';\n  if (!id || seen.has(id)) continue;\n  seen.add(id);\n  out.push({ json: {\n    post_id: id,\n    post_url: j.url || j.post_url || '',\n    post_text: String(j.text || j.commentary || j.summary || '').slice(0, 500)\n  } });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
    {
      "id": "f7fda168-696a-4c54-8d36-b6ccfa494a0b",
      "name": "Collect All Engagers",
      "type": "n8n-nodes-base.code",
      "position": [
        1616,
        96
      ],
      "parameters": {
        "jsCode": "return $('Merge Post Engagers').all();"
      },
      "typeVersion": 2
    },
    {
      "id": "f26abbba-6f78-4993-b290-e093befd40fc",
      "name": "Dedupe and Pre-filter by ICP",
      "type": "n8n-nodes-base.code",
      "position": [
        1840,
        96
      ],
      "parameters": {
        "jsCode": "const cfg = $('Campaign Config').first().json;\nconst kw = String(cfg.icp_keywords || '').toLowerCase().split(',').map(s => s.trim()).filter(Boolean);\nconst seen = new Set();\nconst out = [];\nfor (const i of $input.all()) {\n  const j = i.json;\n  const id = j.provider_id || j.profile_url;\n  if (!id || seen.has(id)) continue;\n  seen.add(id);\n  const hay = ((j.headline || '') + ' ' + (j.company || '')).toLowerCase();\n  if (kw.length && !kw.some(k => hay.includes(k))) continue;\n  out.push({ json: j });\n}\nreturn out;"
      },
      "typeVersion": 2
    },
    {
      "id": "f33877eb-7a0d-4705-9ab1-c587a343f885",
      "name": "Score and Draft with AI",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueRegularOutput",
      "position": [
        2064,
        96
      ],
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          }
        },
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 350, messages: [ { role: 'user', content: 'Qualify and personalize LinkedIn outreach to a person who engaged with a post on our target topic. Person headline: ' + $json.headline + '. Company: ' + $json.company + '. The post they engaged with: ' + $json.matched_post + '. Our ICP: ' + $('Campaign Config').first().json.icp_description + '. Our offer: ' + $('Campaign Config').first().json.offer + '. Tasks: score fit from 1 to 10 with a short reason; if the score is 5 or higher write a LinkedIn connection note under 300 characters referencing the post topic, warm and specific, first person, no apostrophes, no hard pitch. Respond in raw JSON only, keys score number, reason string, note string.' } ] }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "nodeCredentialType": "anthropicApi"
      },
      "retryOnFail": true,
      "typeVersion": 4.4
    },
    {
      "id": "ce9e173c-424c-4d6d-9e05-b9587a3cdd6d",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "position": [
        2288,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const person = $('Dedupe and Pre-filter by ICP').item.json;\nlet parsed = { score: 0, reason: 'parse error', note: '' };\ntry {\n  let raw = $json.content?.[0]?.text || '{}';\n  raw = raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  parsed = JSON.parse(raw);\n} catch (e) {}\nreturn { json: { ...person, score: parsed.score || 0, reason: parsed.reason || '', connection_note: parsed.note || '' } };"
      },
      "typeVersion": 2
    },
