        "jsCode": "const post = $('Current Post').item.json;\nreturn $input.all().map(i => { const j = i.json; const a = j.author || j; return { json: {\n  source: 'comment',\n  name: a.name || [a.first_name, a.last_name].filter(Boolean).join(' ') || '',\n  headline: a.headline || a.occupation || '',\n  company: a.company || a.company_name || '',\n  provider_id: a.provider_id || a.id || a.entity_urn || '',\n  profile_url: a.profile_url || a.public_url || a.url || '',\n  matched_post: post.post_text,\n  post_url: post.post_url\n} }; });"
