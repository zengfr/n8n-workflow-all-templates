              "name": "email",
              "type": "string",
              "value": "={{ ($json.body?.email ?? $json.email ?? '').toString().toLowerCase().trim() }}"
            },
            {
              "id": "a-phone",
              "name": "phone",
              "type": "string",
              "value": "={{ ($json.body?.phone ?? $json.phone ?? '').toString().trim() }}"
            },
            {
              "id": "a-country",
              "name": "country",
              "type": "string",
              "value": "={{ ($json.body?.country ?? $json.country ?? '').toString().trim() }}"
            },
            {
              "id": "a-programme",
              "name": "programme",
              "type": "string",
              "value": "={{ ($json.body?.programme ?? $json.programme ?? '').toString().trim() }}"
            },
            {
              "id": "a-route",
              "name": "route",
              "type": "string",
              "value": "={{ (($json.body?.programme ?? $json.programme ?? '').toString().trim() === 'Computer Science') ? 'Priority' : 'General' }}"
            },
            {
              "id": "a-valid",
              "name": "isValid",
              "type": "boolean",
              "value": "={{ (() => { const b = $json.body ?? $json; const g = (k) => (b?.[k] ?? '').toString().trim(); const re = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/; return !!g('name') && !!g('phone') && !!g('country') && !!g('programme') && re.test(g('email')); })() }}"
            },
            {
              "id": "a-errors",
              "name": "validationErrors",
              "type": "string",
              "value": "={{ (() => { const b = $json.body ?? $json; const g = (k) => (b?.[k] ?? '').toString().trim(); const re = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/; const e = []; if(!g('name')) e.push('name is required'); if(!g('phone')) e.push('phone is required'); if(!g('country')) e.push('country is required'); if(!g('programme')) e.push('programme is required'); if(!g('email')) e.push('email is required'); else if(!re.test(g('email'))) e.push('email is invalid'); return e.join('; '); })() }}"
            }
          ]
        }
      },
      "typeVersion": 3.5
    },
