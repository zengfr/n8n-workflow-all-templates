    {
      "id": "ac0bbf2f-5838-4951-b7ce-68801a0a8331",
      "name": "Calculate Offer Tool",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "position": [
        3472,
        736
      ],
      "parameters": {
        "jsCode": "const deal = $('Prepare Deal Data').first().json;\nconst cfg = $('Set Dealer Configuration').first().json;\n\nlet q = query;\nif (typeof q === 'string') {\n  try { q = JSON.parse(q); } catch (e) { q = { customer_offer: q }; }\n}\nq = q || {};\n\nconst toNum = (v) => Number(String(v ?? '').replace(/[^0-9.]/g, ''));\nconst offer = toNum(q.customer_offer);\n\nif (!Number.isFinite(offer) || offer <= 0) {\n  return JSON.stringify({ decision: 'INVALID_OFFER', guidance: 'No usable price was given. Ask the customer which price they have in mind.' });\n}\nif (String(deal.status).toLowerCase() !== 'available') {\n  return JSON.stringify({ decision: 'UNAVAILABLE', guidance: 'This vehicle is no longer available. Do not negotiate it. Offer to have a sales rep suggest similar vehicles.' });\n}\n\nconst list = Number(deal.list_price);\nconst floor = Number(deal.floor_price);\nconst minimum = Math.max(floor, list * (1 - Number(cfg.max_discount_percent) / 100));\n\nif (offer >= list) {\n  return JSON.stringify({ decision: 'ACCEPT', accepted_price: Math.round(list), list_price: Math.round(list), guidance: 'Accept at the list price. Never quote above list.' });\n}\nif (offer >= minimum) {\n  return JSON.stringify({ decision: 'ACCEPT', accepted_price: Math.round(offer), list_price: Math.round(list), guidance: 'Accept the customer offer.' });\n}\n\nreturn JSON.stringify({\n  decision: 'COUNTER',\n  customer_offer: Math.round(offer),\n  counter_price: Math.round(minimum),\n  list_price: Math.round(list),\n  guidance: 'Do not accept the customer offer. Counter with counter_price as the best confirmed price right now.'\n});",
        "description": "Deterministic vehicle negotiation engine. Call whenever the customer proposes a price, asks for a discount, or asks for the best price. Input: customer_offer (number, USD). Returns ACCEPT, COUNTER, UNAVAILABLE, or INVALID_OFFER and the only price the agent may quote.",
        "jsonSchemaExample": "{\n  \"customer_offer\": 28500\n}",
        "specifyInputSchema": true
      },
      "typeVersion": 1.3
    },
