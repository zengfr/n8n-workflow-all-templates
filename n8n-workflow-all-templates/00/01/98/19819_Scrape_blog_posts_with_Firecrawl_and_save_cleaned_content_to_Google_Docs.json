    {
      "id": "d6277044-193b-409e-a619-ad666792266f",
      "name": "Clean Scraped Markdown",
      "type": "n8n-nodes-base.code",
      "position": [
        4128,
        2112
      ],
      "parameters": {
        "jsCode": "const items = $('If Scrape Completed').item.json.data;\n\nfunction cleanPage(page) {\n  let text = page.markdown || '';\n\n  // Drop everything before the first H1 (nav / login banner)\n  const firstH1 = text.indexOf('\\n# ');\n  if (firstH1 !== -1) {\n    text = text.slice(firstH1 + 1);\n  }\n\n  // Drop everything from the repeated site footer onward\n  const footerMarkers = ['### ¿Quiénes somos?', '¿Quiénes somos?'];\n  for (const marker of footerMarkers) {\n    const idx = text.indexOf(marker);\n    if (idx !== -1) {\n      text = text.slice(0, idx);\n      break;\n    }\n  }\n\n  text = text\n    .replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '')            // images\n    .replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1')         // [text](url) -> text\n    .replace(/\\*\\*\\*\\*([^*]+)\\*\\*\\*\\*/g, '$1')       // ****text****\n    .replace(/\\*\\*([^*]+)\\*\\*/g, '$1')               // **bold**\n    .replace(/\\*([^*]+)\\*/g, '$1')                   // *italic*\n    .replace(/\\\\([#*_\\[\\]()])/g, '$1')               // escaped markdown chars\n    .replace(/^#{1,6}\\s*/gm, '')                     // # headers\n    .replace(/[ \\t]+\\n/g, '\\n')                      // trailing spaces\n    .replace(/\\n{3,}/g, '\\n\\n')                      // collapse blank lines\n    .trim();\n\n  return text;\n}\n\nconst combined = items\n  .map(page => {\n    const title = page.metadata?.title || page.metadata?.['og:title'] || '';\n    const url = page.metadata?.sourceURL || page.metadata?.url || '';\n    const body = cleanPage(page);\n    return `${title}\\n${url}\\n\\n${body}`;\n  })\n  .join('\\n\\n\\n');\n\nreturn [{ json: { data: combined } }];\n"
      },
      "typeVersion": 2
    },
