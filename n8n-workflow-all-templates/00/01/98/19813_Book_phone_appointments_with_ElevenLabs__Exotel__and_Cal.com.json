    {
      "id": "cb8dda25-a153-46e8-988d-20bf65f7513d",
      "name": "Send Slots Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1392,
        160
      ],
      "parameters": {
        "options": {},
        "respondWith": "json",
        "responseBody": "={{\n  (() => {\n    const slotsObj = $json.data || {};\n    const allSlots = Object.values(slotsObj).flat();\n    const hasSlots = allSlots.length > 0;\n    \n    return {\n      hasSlots: hasSlots,\n      suggestedTimes: allSlots.slice(0, 4).map(s => {\n        const iso = typeof s === 'string' ? s : (s.start || s.time);\n        return DateTime.fromISO(iso).setZone('Asia/Kolkata').toFormat('h:mm a');\n      }),\n      rawISOStartTimes: allSlots.slice(0, 4).map(s => typeof s === 'string' ? s : (s.start || s.time)),\n      message: hasSlots \n        ? \"Slots are available for this date.\" \n        : \"No slots are available for this date.\"\n    };\n  })()\n}}"
      },
      "typeVersion": 1.2
    },
