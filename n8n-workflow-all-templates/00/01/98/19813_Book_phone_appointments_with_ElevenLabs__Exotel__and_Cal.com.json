      "parameters": {
        "color": 7,
        "width": 464,
        "height": 336,
        "content": "## Receive and route request\n\nThe main appointment webhook receives incoming requests and performs the first routing check to determine whether the request is asking for available slots or should continue to booking-related handling."
      },
      "typeVersion": 1
    },
