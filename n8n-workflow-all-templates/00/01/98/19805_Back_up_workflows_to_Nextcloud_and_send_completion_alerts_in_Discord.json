      "id": "a5578e66-c7ac-4fcf-82e8-37e9b5dfaa28",
      "name": "Upload to NextCloud",
      "type": "n8n-nodes-base.nextCloud",
      "notes": "In the filename the / character is changed to and underscore.  slashes are allowed in n8n but not in a lot of operating systems. ",
      "onError": "continueRegularOutput",
      "position": [
