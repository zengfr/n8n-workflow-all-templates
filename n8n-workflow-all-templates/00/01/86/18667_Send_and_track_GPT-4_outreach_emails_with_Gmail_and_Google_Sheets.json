    {
      "id": "d41ca74e-1a36-48ef-9905-31f97e03e7e4",
      "name": "Parse AI Email Output (JavaScript)",
      "type": "n8n-nodes-base.code",
      "position": [
        960,
        336
      ],
      "parameters": {
        "jsCode": "// Loop through AI results and clean up JSON output\n\nreturn items.map((item, index) => {\n\n  let raw = item.json.output || '';\n\n  // Remove code block markers like ```json or ```\n  raw = raw.replace(/```json|```/g, '').trim();\n\n  // Parse JSON safely\n  let parsed;\n\n  try {\n    parsed = JSON.parse(raw);\n  } catch (e) {\n    parsed = {\n      subject: \"No Subject\",\n      body_html: \"Error parsing AI output.\"\n    };\n  }\n\n  // Get matching lead information\n  const lead = $('Filter for Booked Leads').all()[index];\n\n  return {\n    json: {\n      Email: lead?.json?.Email || '',\n      CompanyName: lead?.json?.[\"Company Name\"] || '',\n      ContactPerson: lead?.json?.[\"Contact Person\"] || '',\n      subject: parsed.subject || \"No Subject\",\n      body_html: parsed.body_html || \"\"\n    }\n  };\n\n});"
      },
      "typeVersion": 2
    },
