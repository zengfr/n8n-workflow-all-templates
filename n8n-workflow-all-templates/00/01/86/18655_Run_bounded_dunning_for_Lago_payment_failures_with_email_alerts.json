    {
      "id": "01cd15db-11ac-4104-8284-a337cf0f8909",
      "name": "Decide Whether To Retry",
      "type": "n8n-nodes-base.code",
      "position": [
        5616,
        1392
      ],
      "parameters": {
        "jsCode": "const previous = $input.first().json;\nconst event = $('Normalize Billing Event').first().json;\nconst invoice = $('Get Failed Invoice').first().json;\nconst customer = $('Get Billing Customer').first().json;\nconst retryCount = Number(previous.retry_count ?? 0);\nconst maxRetries = 3;\nconst paymentStatus = String(invoice.payment_status ?? event.payment_status ?? '').toLowerCase();\nconst shouldRetry = Boolean(event.invoice_id) && paymentStatus !== 'succeeded' && retryCount < maxRetries;\n\nreturn [{ json: {\n  ...event,\n  invoice_number: String(invoice.number ?? event.invoice_number ?? ''),\n  external_customer_id: String(customer.external_id ?? event.external_customer_id ?? ''),\n  customer_email: String(customer.email ?? event.customer_email ?? ''),\n  payment_status: paymentStatus,\n  total_amount_cents: Number(invoice.total_amount_cents ?? event.total_amount_cents ?? 0),\n  currency: String(invoice.currency ?? event.currency ?? ''),\n  retry_count: retryCount,\n  next_retry_count: retryCount + 1,\n  max_retries: maxRetries,\n  should_retry: shouldRetry,\n  decision_reason: shouldRetry\n    ? 'retry limit allows another collection attempt'\n    : (paymentStatus === 'succeeded' ? 'invoice is already paid' : 'retry limit reached'),\n} }];"
      },
      "typeVersion": 2
    },
