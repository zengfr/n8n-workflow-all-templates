    {
      "id": "31168abc-d291-42f6-b67b-3d3917c61eaf",
      "name": "Normalize Billing Event",
      "type": "n8n-nodes-base.code",
      "position": [
        4304,
        1712
      ],
      "parameters": {
        "jsCode": "const envelope = $input.first().json;\nconst eventType = String(envelope.webhook_type ?? envelope.type ?? '');\nconst dataObject = envelope.data?.object ?? {};\n\nlet invoice = envelope.invoice ?? dataObject.invoice ?? {};\nlet payment = envelope.payment ?? dataObject.payment ?? {};\n\nif (Object.keys(invoice).length === 0 && (envelope.object_type === 'invoice' || dataObject.payment_status !== undefined || dataObject.invoice_type !== undefined)) {\n  invoice = dataObject;\n}\nif (Object.keys(payment).length === 0 && (envelope.object_type === 'payment' || dataObject.invoice_id !== undefined || dataObject.payable_id !== undefined)) {\n  payment = dataObject;\n}\n\nconst invoiceId = String(\n  invoice.lago_id ??\n  payment.invoice_id ??\n  payment.invoice_lago_id ??\n  payment.invoice?.lago_id ??\n  ((String(payment.payable_type ?? '').toLowerCase() === 'invoice') ? payment.payable_id : '') ??\n  envelope.invoice_id ??\n  ''\n).trim();\n\nconst externalCustomerId = String(\n  invoice.external_customer_id ??\n  invoice.customer?.external_id ??\n  payment.external_customer_id ??\n  payment.customer?.external_id ??\n  dataObject.external_customer_id ??\n  ''\n).trim();\n\nconst paymentStatus = String(invoice.payment_status ?? payment.status ?? dataObject.payment_status ?? '').toLowerCase();\nconst rawEventAt = envelope.webhook_at ?? envelope.created_at ?? dataObject.updated_at ?? dataObject.created_at ?? new Date().toISOString();\nconst parsedEventAt = new Date(rawEventAt);\nconst eventAt = Number.isNaN(parsedEventAt.getTime()) ? new Date().toISOString() : parsedEventAt.toISOString();\n\nlet action = 'ignore';\nif (eventType === 'invoice.payment_failure') action = 'retry';\nelse if (eventType === 'payment.requires_action') action = 'action_required';\nelse if (eventType === 'payment.succeeded') action = 'recovered';\nelse if (eventType === 'invoice.payment_status_updated' && paymentStatus === 'succeeded') action = 'recovered';\n\nif (!invoiceId) action = 'ignore';\n\nreturn [{ json: {\n  action,\n  event_type: eventType,\n  invoice_id: invoiceId,\n  invoice_number: String(invoice.number ?? payment.invoice?.number ?? ''),\n  external_customer_id: externalCustomerId,\n  customer_email: String(invoice.customer?.email ?? payment.customer?.email ?? ''),\n  payment_status: paymentStatus,\n  total_amount_cents: Number(invoice.total_amount_cents ?? payment.amount_cents ?? 0),\n  currency: String(invoice.currency ?? payment.currency ?? ''),\n  action_url: String(payment.url ?? payment.checkout_url ?? dataObject.url ?? ''),\n  event_at: eventAt,\n  ignore_reason: invoiceId ? 'event does not require dunning action' : 'invoice ID was not present in the webhook payload',\n} }];"
      },
      "typeVersion": 2
    },
