    {
      "id": "e9bf34a9-c717-4599-8e75-888bc3c564e8",
      "name": "Analyze Screenshot With Vision",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1120,
        0
      ],
      "parameters": {
        "text": "Analyze this landing page screenshot from a Conversion Rate Optimization perspective. Describe: the above-the-fold content and visual hierarchy, the CTA (visibility, placement, contrast), trust signals visible (logos, testimonials, badges), overall clutter/whitespace, apparent mobile-friendliness cues, and any obvious visual issues that could hurt conversions. Be specific and reference exactly what you see in the image.",
        "images": {
          "values": [
            {}
          ]
        },
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Configuration').item.json.openai_model }}"
        },
        "options": {
          "detail": "high",
          "maxTokens": 800
        },
        "resource": "image",
        "inputType": "base64",
        "operation": "analyze"
      },
      "credentials": {
        "openAiApi": {
          "id": "6h3DfVhNPw9I25nO",
          "name": "OpenAi account"
        }
      },
      "typeVersion": 2.3
    },
    {
      "id": "7f570bc8-76d7-474d-b3d2-2d5b23922664",
      "name": "Prepare Agent Input",
      "type": "n8n-nodes-base.set",
      "position": [
        1408,
        0
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "pai-1",
              "name": "landing_page_url",
              "type": "string",
              "value": "={{ $('Configuration').item.json.landing_page_url }}"
            },
            {
              "id": "pai-2",
              "name": "num_recommendations",
              "type": "number",
              "value": "={{ $('Configuration').item.json.num_recommendations }}"
            },
            {
              "id": "pai-3",
              "name": "html_snippet",
              "type": "string",
              "value": "={{ $('Scrape Landing Page HTML').item.json.data.slice(0, 15000) }}"
            },
            {
              "id": "pai-4",
              "name": "visual_analysis",
              "type": "string",
              "value": "={{ $json.content ?? $json.text ?? \"\" }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "67111c12-0b9a-447b-b92a-4bed66a86b40",
      "name": "Generate CRO Audit",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1680,
        0
      ],
      "parameters": {
        "text": "=Landing Page URL: {{ $json.landing_page_url }}\n\nHTML SOURCE (truncated):\n{{ $json.html_snippet }}\n\nSCREENSHOT VISUAL ANALYSIS:\n{{ $json.visual_analysis }}\n\nProduce exactly {{ $json.num_recommendations }} recommendations.",
        "options": {
          "maxIterations": 5,
          "systemMessage": "You are a world-class expert in Conversion Rate Optimization who helps founders and marketers improve their landing pages. You will roast the landing page (friendly, casual, unconventional, human-to-human tone that agitates the reader's feelings in a fun way) based on BOTH the HTML source and the screenshot visual analysis you are given, then deliver highly specific, creative, easy-to-implement, 2025-relevant Conversion Rate Optimization recommendations. Never give generic advice like 'add a live chat' or 'improve your headline' — always describe exactly what the new headline, CTA copy, or layout change should be for THIS specific page. Reference details from the roast in your recommendations so they feel 100% personalized."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
    {
      "id": "97aff0b1-7b4f-419f-8d3d-8054a1873d33",
