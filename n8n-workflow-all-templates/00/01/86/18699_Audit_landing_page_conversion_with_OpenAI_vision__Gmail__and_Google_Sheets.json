      "id": "5537de0e-8b4d-41cb-ac09-a9f9efd3094b",
      "name": "Landing Page URL Input",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        0,
        0
      ],
      "webhookId": "d850c666-dd21-4435-8a5b-4a1a6ada2fed",
      "parameters": {
        "options": {
          "buttonLabel": "Audit my landing page",
          "appendAttribution": false,
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thanks! We're analyzing your landing page now (scraping the page, reviewing a screenshot, and running the AI audit). If you gave an email address you'll receive the full report shortly — the audit is also logged for you to review anytime."
            }
          }
        },
        "formTitle": "Landing Page Conversion Rate Audit",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Landing Page URL",
              "placeholder": "https://example.com",
              "requiredField": true
            },
            {
              "fieldType": "email",
              "fieldLabel": "Email address to receive the report",
              "placeholder": "you@example.com"
            }
          ]
        },
        "formDescription": "Paste your landing page URL and get an instant AI-powered CRO audit — with visual screenshot analysis, a scored breakdown, and a report emailed to you."
      },
      "typeVersion": 2.6
    },
