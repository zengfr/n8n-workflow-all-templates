    {
      "id": "fc48a284-3f76-4697-b7bf-406910e4c573",
      "name": "CRO Audit Structured Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1904,
        240
      ],
      "parameters": {
        "autoFix": true,
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"overall_score\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10,\"description\":\"Overall conversion-readiness score out of 10\"},\"category_scores\":{\"type\":\"object\",\"properties\":{\"headline\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10},\"cta\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10},\"trust_signals\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10},\"visual_design\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10},\"mobile_friendliness\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10},\"copywriting\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":10}},\"required\":[\"headline\",\"cta\",\"trust_signals\",\"visual_design\",\"mobile_friendliness\",\"copywriting\"]},\"roast_markdown\":{\"type\":\"string\",\"description\":\"A friendly, casual, unconventional roast of the landing page in Markdown, explaining exactly what is wrong and why it hurts conversions\"},\"recommendations\":{\"type\":\"array\",\"minItems\":5,\"items\":{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\",\"description\":\"Short punchy name of the recommendation\"},\"detail\":{\"type\":\"string\",\"description\":\"Specific, personalized, ready-to-implement instructions for this exact landing page\"}},\"required\":[\"title\",\"detail\"]}}},\"required\":[\"overall_score\",\"category_scores\",\"roast_markdown\",\"recommendations\"]}"
      },
      "typeVersion": 1.3
    },
