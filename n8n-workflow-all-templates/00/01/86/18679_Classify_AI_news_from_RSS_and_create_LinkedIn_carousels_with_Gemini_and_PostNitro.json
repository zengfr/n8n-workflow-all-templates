    {
      "id": "c6bd6039-4561-41d9-8a5e-d15cb27e4f64",
      "name": "Initial LLM Processing Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1424,
        192
      ],
      "parameters": {
        "text": "=You are an AI news classifier.\n\nAnalyze the TechCrunch article below.\n\nYour job is to determine whether this article is significantly about artificial intelligence.\n\nAn article is RELEVANT if it discusses:\n\n- New or upcoming AI models or versions\n- New AI tools, products, or platforms\n- AI agents\n- Generative AI\n- AI coding/developer tools\n- AI's impact on jobs or employment\n- AI's impact on humans or society\n- AI safety, risks, regulation, or ethics\n- Major AI research or breakthroughs\n- Major AI company developments\n- Predictions about the future of AI\n\nDo NOT mark an article relevant just because AI is mentioned briefly.\n\nReturn these fields:\n\nrelevant: true or false\ncategory: one of [AI Models, AI Tools, AI Agents, AI & Jobs, AI & Humans, AI Safety, AI Research, AI Business, AI Future, Other]\nimportance: number from 1 to 10\nreason: short explanation\ntopic: short description\n\nARTICLE TITLE:\n{{ $json.title }}\n\nARTICLE DESCRIPTION:\n{{ $json.contentSnippet }}\n\nARTICLE URL:\n{{ $json.link }}",
        "batching": {},
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.9
    },
    {
      "id": "8dc299b3-af28-49d6-9152-b2a4ef314384",
      "name": "Gemini LLM Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
        1440,
        432
      ],
      "parameters": {
        "options": {},
        "modelName": "models/gemini-3.1-flash-lite"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "credential-id",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "623dfabe-cfcf-42ff-b2aa-c9534ce3e23c",
      "name": "Parse as Structured Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1664,
        448
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"relevant\": {\n      \"type\": \"boolean\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"importance\": {\n      \"type\": \"number\"\n    },\n    \"reason\": {\n      \"type\": \"string\"\n    },\n    \"topic\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"relevant\",\n    \"category\",\n    \"importance\",\n    \"reason\",\n    \"topic\"\n  ]\n}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "e4bc0f33-c7d9-4b1b-8f11-8280b831816b",
      "name": "If Relevant Output",
      "type": "n8n-nodes-base.if",
      "position": [
        1744,
