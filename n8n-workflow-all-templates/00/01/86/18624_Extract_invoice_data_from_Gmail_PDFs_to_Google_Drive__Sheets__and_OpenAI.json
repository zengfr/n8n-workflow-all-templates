    {
      "id": "309988f4-1a53-4dc1-9fe5-c1080860bfd6",
      "name": "Pull PDF attachments out",
      "type": "n8n-nodes-base.code",
      "position": [
        2160,
        144
      ],
      "parameters": {
        "jsCode": "const outputItems = [];\n\n// Process each email from Gmail\nfor (const email of $input.all()) {\n  \n  // Optional: extract date for logging\n  let emailDate = null;\n  if (email.json.internalDate) {\n    if (typeof email.json.internalDate === 'number') {\n      emailDate = new Date(email.json.internalDate);\n    } else if (typeof email.json.internalDate === 'string' && /^\\d+$/.test(email.json.internalDate)) {\n      emailDate = new Date(parseInt(email.json.internalDate));\n    } else {\n      emailDate = new Date(email.json.internalDate);\n    }\n  } else if (email.json.date) {\n    emailDate = new Date(email.json.date);\n  }\n  \n  // Check if email has attachments\n  if (email.binary && Object.keys(email.binary).length > 0) {\n    \n    // Process each attachment\n    for (const attachmentKey in email.binary) {\n      const attachment = email.binary[attachmentKey];\n      \n      // Only process PDF files (invoices)\n      if (attachment.mimeType === 'application/pdf') {\n        outputItems.push({\n          json: {\n            emailSubject: email.json.subject || 'No Subject',\n            emailId: email.json.id,\n            emailDate: emailDate ? emailDate.toISOString() : 'Date not available',\n            fileName: attachment.fileName || attachmentKey,\n            mimeType: attachment.mimeType,\n            fileType: 'PDF',\n            attachmentKey: attachmentKey\n          },\n          binary: {\n            data: attachment\n          }\n        });\n      } else {\n      }\n    }\n  } else {\n  }\n}\n\nreturn outputItems;"
      },
      "typeVersion": 2
    },
