    {
      "id": "cd95c406-0bc6-4387-bf5b-c79c8fd76934",
      "name": "Build Drive links",
      "type": "n8n-nodes-base.code",
      "position": [
        5568,
        400
      ],
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const file of $input.all()) {\n  const fileId = file.json.id;\n  const parentId = file.json.parents?.[0]; // parent folder ID\n  const fileName = file.json.name || file.json.fileName;\n  const fileType = file.json.fileType || (file.json.mimeType === 'application/pdf' ? 'PDF' : 'IMAGE');\n\n  results.push({\n    json: {\n      ...file.json, // keep existing fields\n      pdf_filename: fileName,\n      fileName: fileName,\n      fileType: fileType,\n      pdfUrl: `https://drive.google.com/file/d/${fileId}/view?usp=drivesdk`,\n      driveLink: `https://drive.google.com/drive/folders/${parentId}`\n    },\n    binary: file.binary // pass binary if needed downstream\n  });\n}\n\nreturn results;\n"
      },
      "typeVersion": 2
    },
