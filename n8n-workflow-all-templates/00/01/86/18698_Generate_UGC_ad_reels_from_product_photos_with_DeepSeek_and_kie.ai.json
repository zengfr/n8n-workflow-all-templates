    {
      "id": "8d39086f-3d79-4f8e-bd00-3c6a7a0684a9",
      "name": "Sticky Note4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1024,
        2272
      ],
      "parameters": {
        "color": 7,
        "width": 880,
        "height": 544,
        "content": "## Create and monitor video\n\nStarts the Seedance Mini video generation task, waits between checks, polls the job status, and branches based on success or failure while looping for unfinished jobs."
      },
      "typeVersion": 1
