        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ model: \"deepseek-chat\", temperature: 0.8, messages: [ { role: \"system\", content: \"You are a UGC ad scriptwriter. Write a punchy 15-20 second vertical video ad script with a strong 3-second hook, casual creator tone, natural spoken dialogue only, no camera directions or stage notes. Keep it under 60 words. Write in the requested language.\" }, { role: \"user\", content: \"Brand: \" + ($('When UGC Ad Requested').item.json['Brand Name'] || 'the brand') + \"\\nLanguage: \" + $('When UGC Ad Requested').item.json['Target Language'] + \"\\nProduct/Ad idea: \" + $('When UGC Ad Requested').item.json['Ad Prompt / Description'] } ] }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
