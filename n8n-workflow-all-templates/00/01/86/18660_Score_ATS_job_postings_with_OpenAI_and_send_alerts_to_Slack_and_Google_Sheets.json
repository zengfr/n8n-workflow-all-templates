    {
      "id": "73bca8dd-5af4-4ea2-8a93-c2a2e99441ad",
      "name": "Build company watchlist",
      "type": "n8n-nodes-base.code",
      "position": [
        624,
        0
      ],
      "parameters": {
        "jsCode": "// Split the sheet into the two inputs the Actor accepts: plain company names\n// (its ATS is auto-detected) and explicit career page URLs.\nconst companies = [];\nconst careerPageUrls = [];\n\nfor (const item of items) {\n  const row = item.json;\n  const url = String(row['Career page URL'] || '').trim();\n  const company = String(row.Company || '').trim();\n  if (/^https?:\\/\\//i.test(url)) careerPageUrls.push(url);\n  else if (company) companies.push(company);\n}\n\nif (companies.length === 0 && careerPageUrls.length === 0) {\n  throw new Error('No companies found. Add a \"Company\" column to your Companies sheet with one company name per row.');\n}\n\nreturn [{ json: { companies, careerPageUrls, watchCount: companies.length + careerPageUrls.length } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "f4f5cde8-34fa-4a5f-8057-ce97e97ec1fa",
      "name": "Scan job boards",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "onlyNewJobs plus a stable monitorId make the Actor remember what it already delivered, so every posting is returned - and charged - exactly once.",
      "position": [
        880,
        0
      ],
      "parameters": {
        "url": "=https://api.apify.com/v2/acts/{{ $('Settings').first().json.apifyActorId }}/runs",
        "method": "POST",
        "options": {
          "timeout": 60000
        },
        "jsonBody": "={{ JSON.stringify({\n  companies: $json.companies,\n  careerPageUrls: $json.careerPageUrls,\n  onlyNewJobs: true,\n  monitorId: $('Settings').first().json.monitorId,\n  includeDescriptions: true,\n  dedupeAcrossPlatforms: true,\n  maxJobsPerCompany: 200\n}) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
