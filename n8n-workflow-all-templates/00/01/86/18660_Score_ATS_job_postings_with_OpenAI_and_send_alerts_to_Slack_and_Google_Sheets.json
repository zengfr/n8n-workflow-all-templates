    {
      "id": "f3ece0bb-6b3a-49de-89ab-ef67cb33ba4d",
      "name": "Normalize jobs",
      "type": "n8n-nodes-base.code",
      "position": [
        2016,
        0
      ],
      "parameters": {
        "jsCode": "// Flatten the dataset array and keep the fields the alert and the sheet need.\nconst rows = [];\nfor (const item of items) {\n  const value = item.json;\n  if (Array.isArray(value)) rows.push(...value);\n  else if (Array.isArray(value.data)) rows.push(...value.data);\n  else rows.push(value);\n}\n\n// Everything derives from the single HTTP response item, so pair back to item 0.\nreturn rows\n  .filter((row) => row && row.title && row.url)\n  .map((row) => ({\n    pairedItem: { item: 0 },\n    json: {\n      company: row.companyName || '',\n      title: row.title,\n      url: row.url,\n      location: row.location || (row.locations || []).join(', ') || 'not stated',\n      remote: row.remote === true,\n      employmentType: row.employmentType || '',\n      salary: row.salaryRaw || '',\n      platform: row.platform || '',\n      postedAt: row.postedAt || '',\n      department: row.department || '',\n      description: String(row.descriptionText || '').slice(0, 6000),\n    },\n  }));\n"
      },
      "typeVersion": 2,
      "alwaysOutputData": true
    },
    {
      "id": "5e3ae664-25d7-4fa5-8131-c3fc7a711f9b",
