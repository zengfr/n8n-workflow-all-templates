    {
      "id": "08b596db-33b5-4ecf-89b8-3dd84857af49",
      "name": "Get target companies",
      "type": "n8n-nodes-base.googleSheets",
      "notes": "Sheet tab \"Companies\" with columns: Company and (optional) Career page URL. Add a URL only when the company name alone is ambiguous.",
      "position": [
        416,
        0
      ],
      "parameters": {
        "options": {},
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Settings').first().json.companiesSheet }}"
        },
        "documentId": {
          "__rl": true,
          "mode": "id",
