    {
      "id": "3c8dd11d-6e85-46c7-819b-27682b9c7688",
      "name": "Format Slack alert",
      "type": "n8n-nodes-base.code",
      "position": [
        3136,
        -32
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// One tidy Slack message per matching job.\nconst job = $('Normalize jobs').item.json;\nconst ai = $json.output || {};\n\nconst facts = [\n  job.location,\n  job.remote ? 'remote' : ai.workplace,\n  job.salary,\n  job.employmentType,\n  job.platform ? `via ${job.platform}` : '',\n].filter(Boolean).join(' · ');\n\nconst text = [\n  `*<${job.url}|${job.title}>* at *${job.company}*`,\n  `${facts}`,\n  `Fit ${ai.score}/100 (${ai.seniority || 'unknown seniority'}) — ${ai.reason || ''}`,\n].join('\\n');\n\nreturn { json: { slackText: text, score: ai.score } };\n"
      },
      "typeVersion": 2
    },
