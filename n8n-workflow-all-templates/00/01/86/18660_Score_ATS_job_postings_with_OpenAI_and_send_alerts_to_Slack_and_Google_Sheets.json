    },
    {
      "id": "6f12caa7-37b4-45ae-830f-0e2b560b3bd0",
      "name": "Build daily summary",
      "type": "n8n-nodes-base.code",
      "position": [
        2928,
        208
      ],
      "parameters": {
        "jsCode": "// One roll-up line so you can see the scan ran even on a day with no strong matches.\nconst settings = $('Settings').first().json;\nconst scored = items.map((item) => item.json.output || {});\nconst strong = scored.filter((s) => Number(s.score) >= Number(settings.minScore)).length;\nconst companies = new Set($('Any new jobs?').all().map((i) => i.json.company)).size;\n\nreturn [{\n  json: {\n    slackText: `Job scan finished: *${scored.length}* new posting(s) across *${companies}* company board(s), *${strong}* scored ${settings.minScore}+ and were posted above.`,\n  },\n}];\n"
      },
      "typeVersion": 2
    },
