    {
      "id": "ef5d00d7-65a7-42ae-85b5-18d86f38d0f2",
      "name": "Parse Slack Message",
      "type": "n8n-nodes-base.code",
      "notes": "Extracts channelId, userId and text from the raw Slack event, and flags bot/edited messages so they can be filtered out downstream.",
      "position": [
        1248,
        928
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst event = input.event || input.body?.event || input;\n\n// Ignore the bot's own messages and edited-message events to avoid infinite loops\nconst isBot = !!event.bot_id;\nconst subtype = event.subtype || '';\nconst text = (event.text || '').trim();\n\nreturn [{\n  json: {\n    channelId: event.channel || '',\n    userId: event.user || '',\n    text,\n    isBot,\n    subtype,\n  },\n}];"
      },
      "typeVersion": 2
    },
