        "url": "https://api.heygen.com/v3/videos",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ {\n  \"type\": \"avatar\",\n  \"avatar_id\": \"YOUR_HEYGEN_AVATAR_ID\",\n  \"script\": $('Query Pending Session Data').item.json.script,\n  \"voice_id\": \"YOUR_HEYGEN_VOICE_ID\",\n  \"resolution\": \"720p\",\n  \"aspect_ratio\": \"16:9\"\n} }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.4,
      "waitBetweenTries": 5000
    },
