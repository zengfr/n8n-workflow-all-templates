    {
      "id": "c00fd705-0cf0-412b-b953-05cef32b86ca",
      "name": "AI Duplicate Risk Assessment",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1616,
        800
      ],
      "parameters": {
        "text": "=You are a Procurement and Accounts Payable fraud analyst.\n\nAnalyze the following duplicate invoice detection result and determine whether this invoice should be considered:\n\n* Exact Duplicate\n* Near Duplicate\n* Legitimate Invoice\n\nInvoice ID: {{ $json.invoice_id }}\n\nRisk Score: {{ $json.riskScore }}\n\nDuplicate Found: {{ $json.duplicateFound }}\n\nMatched Invoice: {{ $json.matchedInvoice }}\n\nDetection Details:\n{{ $json.reason }}\n\nNew Invoice:\n{{ JSON.stringify($json.newInvoice) }}\n\nMatched Historical Invoice:\n{{ JSON.stringify($json.matchedInvoiceDetails) }}\n\nProvide your response in the following format:\n\nClassification: <Exact Duplicate / Near Duplicate / Legitimate Invoice>\n\nConfidence: <High / Medium / Low>\n\nReasoning:\n<2-3 sentence explanation>\n\nRecommended Action:\n<What the Accounts Payable team should do>\n",
        "batching": {},
        "promptType": "define"
      },
      "typeVersion": 1.9,
      "alwaysOutputData": true
    },
    {
      "id": "8b8af567-2964-43d2-8b80-c388b96b74c8",
      "name": "Extract AI Investigation Results",
      "type": "n8n-nodes-base.code",
      "position": [
        2096,
        848
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const text = item.json.text || '';\n\n  const classification =\n    text.match(/Classification:\\s*(.*?)(?:\\n|$)/i)?.[1]?.trim() || 'Unknown';\n\n  const confidence =\n    text.match(/Confidence:\\s*(.*?)(?:\\n|$)/i)?.[1]?.trim() || 'Unknown';\n\n  const reasoning =\n    text.match(/Reasoning:\\s*([\\s\\S]*?)Recommended Action:/i)?.[1]?.trim() || '';\n\n  const recommendedAction =\n    text.match(/Recommended Action:\\s*([\\s\\S]*)/i)?.[1]?.trim() || '';\n\n  return {\n    json: {\n      classification,\n      confidence,\n      reasoning,\n      recommendedAction\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
