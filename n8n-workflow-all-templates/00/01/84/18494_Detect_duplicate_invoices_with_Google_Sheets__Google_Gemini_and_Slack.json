    {
      "id": "2276f36b-effd-4519-870c-8c604cc4777b",
      "name": "Duplicate Detection Engine",
      "type": "n8n-nodes-base.code",
      "position": [
        1392,
        688
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst newInvoices = input.new_invoices || [];\nconst historyInvoices = input.history_invoices || [];\n\n// Validation\nif (newInvoices.length === 0) {\n  return [{\n    json: {\n      status: \"INVALID_DATA\",\n      duplicateFound: false,\n      riskScore: 0,\n      reason: \"No invoice found in New Invoice sheet\"\n    }\n  }];\n}\n\nif (historyInvoices.length === 0) {\n  return [{\n    json: {\n      status: \"FAILED\",\n      duplicateFound: false,\n      riskScore: 0,\n      reason: \"No historical invoices available\"\n    }\n  }];\n}\n\nfunction getLevenshteinDistance(s1, s2) {\n  s1 = s1 || \"\";\n  s2 = s2 || \"\";\n\n  const len1 = s1.length;\n  const len2 = s2.length;\n\n  const matrix = Array(len1 + 1)\n    .fill(null)\n    .map(() => Array(len2 + 1).fill(0));\n\n  for (let i = 0; i <= len1; i++) matrix[i][0] = i;\n  for (let j = 0; j <= len2; j++) matrix[0][j] = j;\n\n  for (let i = 1; i <= len1; i++) {\n    for (let j = 1; j <= len2; j++) {\n      const cost = s1[i - 1] === s2[j - 1] ? 0 : 1;\n\n      matrix[i][j] = Math.min(\n        matrix[i - 1][j] + 1,\n        matrix[i][j - 1] + 1,\n        matrix[i - 1][j - 1] + cost\n      );\n    }\n  }\n\n  return matrix[len1][len2];\n}\n\nfunction getStringSimilarity(s1, s2) {\n  if (s1 === s2) return 1;\n\n  const maxLen = Math.max(s1.length, s2.length);\n\n  if (maxLen === 0) return 1;\n\n  const distance = getLevenshteinDistance(s1, s2);\n\n  return 1 - distance / maxLen;\n}\n\nfunction normalizeSupplier(name) {\n  if (!name) return \"\";\n\n  return name\n    .toLowerCase()\n    .replace(/[.,\\/#!$%\\^&\\*;:{}=\\-_`~()]/g, \"\")\n    .replace(/\\b(corp|corporation|inc|co|ltd|limited|llc|gmbh|plc)\\b/g, \"\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction normalizeInvoiceNumber(number) {\n  if (!number) return \"\";\n\n  return number\n    .toString()\n    .replace(/[^A-Za-z0-9]/g, \"\")\n    .toUpperCase();\n}\n\nconst results = [];\n\nfor (const newInvoice of newInvoices) {\n\n  const requiredFields = [\n    \"supplier_name\",\n    \"invoice_number\",\n    \"invoice_date\",\n    \"amount\"\n  ];\n\n  let missingField = null;\n\n  for (const field of requiredFields) {\n    if (!newInvoice[field]) {\n      missingField = field;\n      break;\n    }\n  }\n\n  if (missingField) {\n    results.push({\n      status: \"INVALID_DATA\",\n      invoice_id: newInvoice.invoice_id || null,\n      duplicateFound: false,\n      riskScore: 0,\n      reason: `Missing required invoice field: ${missingField}`\n    });\n\n    continue;\n  }\n\n  if (isNaN(Number(newInvoice.amount))) {\n    results.push({\n      status: \"INVALID_AMOUNT\",\n      invoice_id: newInvoice.invoice_id,\n      duplicateFound: false,\n      riskScore: 0,\n      reason: \"Invoice amount is not numeric\"\n    });\n\n    continue;\n  }\n\n  let bestMatch = null;\n  let bestScore = 0;\n  let bestReasonDetails = [];\n\n  for (const hist of historyInvoices) {\n\n    let currentScore = 0;\n    const matchDetails = [];\n\n    // Invoice Number Score (40)\n    const newInvNumNorm = normalizeInvoiceNumber(\n      newInvoice.invoice_number\n    );\n\n    const histInvNumNorm = normalizeInvoiceNumber(\n      hist.invoice_number\n    );\n\n    const invNumSimilarity = getStringSimilarity(\n      newInvNumNorm,\n      histInvNumNorm\n    );\n\n    if (\n      newInvNumNorm &&\n      newInvNumNorm === histInvNumNorm\n    ) {\n      currentScore += 40;\n      matchDetails.push(\n        \"Exact normalized invoice number match (+40)\"\n      );\n    } else if (invNumSimilarity >= 0.85) {\n      currentScore += 30;\n      matchDetails.push(\n        \"Fuzzy invoice number match (+30)\"\n      );\n    }\n\n    // Supplier Score (30)\n    const newSupplierNorm = normalizeSupplier(\n      newInvoice.supplier_name\n    );\n\n    const histSupplierNorm = normalizeSupplier(\n      hist.supplier_name\n    );\n\n    const supplierSimilarity = getStringSimilarity(\n      newSupplierNorm,\n      histSupplierNorm\n    );\n\n    if (\n      newSupplierNorm &&\n      newSupplierNorm === histSupplierNorm\n    ) {\n      currentScore += 30;\n      matchDetails.push(\n        \"Exact normalized supplier match (+30)\"\n      );\n    } else if (supplierSimilarity >= 0.8) {\n      currentScore += 25;\n      matchDetails.push(\n        \"Fuzzy supplier match (+25)\"\n      );\n    }\n\n    // Amount Score (20)\n    const newAmount = Number(newInvoice.amount);\n    const histAmount = Number(hist.amount);\n\n    if (\n      !isNaN(newAmount) &&\n      !isNaN(histAmount)\n    ) {\n      const difference = Math.abs(\n        newAmount - histAmount\n      );\n\n      const maxAmount = Math.max(\n        newAmount,\n        histAmount\n      );\n\n      const percentDiff =\n        maxAmount > 0\n          ? difference / maxAmount\n          : 0;\n\n      if (difference === 0) {\n        currentScore += 20;\n        matchDetails.push(\n          \"Exact amount match (+20)\"\n        );\n      } else if (percentDiff <= 0.01) {\n        currentScore += 15;\n        matchDetails.push(\n          \"Near amount match (+15)\"\n        );\n      }\n    }\n\n    // Date Score (10)\n    if (\n      newInvoice.invoice_date &&\n      hist.invoice_date\n    ) {\n      const newDate = new Date(\n        newInvoice.invoice_date\n      );\n\n      const histDate = new Date(\n        hist.invoice_date\n      );\n\n      if (\n        !isNaN(newDate.getTime()) &&\n        !isNaN(histDate.getTime())\n      ) {\n        const diffDays =\n          Math.abs(\n            newDate.getTime() -\n            histDate.getTime()\n          ) /\n          (1000 * 60 * 60 * 24);\n\n        if (diffDays === 0) {\n          currentScore += 10;\n          matchDetails.push(\n            \"Exact date match (+10)\"\n          );\n        } else if (diffDays <= 3) {\n          currentScore += 8;\n          matchDetails.push(\n            `Near date match (+8)`\n          );\n        }\n      }\n    }\n\n    if (currentScore > bestScore) {\n      bestScore = currentScore;\n      bestMatch = hist;\n      bestReasonDetails = matchDetails;\n    }\n  }\n\n  results.push({\n    status: \"SUCCESS\",\n    invoice_id: newInvoice.invoice_id,\n    duplicateFound: bestScore >= 75,\n    riskScore: bestScore,\n    matchedInvoice: bestMatch\n      ? bestMatch.invoice_id\n      : null,\n    reason:\n      bestMatch\n        ? `Best match ${bestMatch.invoice_id}. ${bestReasonDetails.join(\", \")}`\n        : \"No significant matches found.\",\n    newInvoice,\n    matchedInvoiceDetails: bestMatch\n  });\n}\n\nreturn results.map(result => ({\n  json: result\n}));"
      },
      "typeVersion": 2
    },
