    {
      "id": "tr1200-0000-0000-0000-000000000015",
      "name": "Summarize & Classify Ticket",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1552,
        256
      ],
      "parameters": {
        "text": "=Ticket #{{ $json.number }}\nSubject: {{ $json.subject }}\n\nFirst customer message:\n{{ $json.customerMessage }}",
        "messages": {
          "messageValues": [
            {
              "message": "You triage customer support tickets for a software team's retrospective parking lot. Given one ticket, return exactly:\n- actionable: true only if the team could discuss or act on it in a retrospective (bug reports, product friction, feature requests). False for pure venting, thanks, or praise with nothing to act on.\n- category: exactly one of bug, friction, feature-ask, praise.\n- summary: ONE sentence, maximum 90 characters, written in the team's voice as an observation (e.g. \"Search on large accounts times out for enterprise customers\"). Never include customer names or email addresses."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "tr1200-0000-0000-0000-000000000016",
      "name": "OpenAI GPT-5 Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1552,
        480
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "options": {}
      },
      "typeVersion": 1.2
    },
    {
      "id": "tr1200-0000-0000-0000-000000000017",
      "name": "Parse Structured Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1744,
        480
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"actionable\": {\n      \"type\": \"boolean\",\n      \"description\": \"True only if the team could act on this in a retrospective\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\"bug\", \"friction\", \"feature-ask\", \"praise\"]\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"One team-voiced sentence, max 90 characters\"\n    }\n  },\n  \"required\": [\"actionable\", \"category\", \"summary\"]\n}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "tr1200-0000-0000-0000-000000000018",
      "name": "If Ticket is Actionable",
      "type": "n8n-nodes-base.if",
      "position": [
        1856,
        256
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
