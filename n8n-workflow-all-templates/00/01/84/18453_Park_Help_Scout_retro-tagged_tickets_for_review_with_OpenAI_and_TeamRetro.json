    },
    {
      "id": "tr1200-0000-0000-0000-000000000014",
      "name": "Set Ticket Details",
      "type": "n8n-nodes-base.set",
      "position": [
        1280,
        256
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "f-subject",
              "name": "subject",
              "type": "string",
              "value": "={{ $json.subject }}"
            },
