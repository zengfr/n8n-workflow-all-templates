            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "is-actionable",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.output.actionable === true && $json.output.category !== 'praise' }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "tr1200-0000-0000-0000-000000000019",
      "name": "Fetch Recent Parked Conversations",
      "type": "n8n-nodes-teamretro.teamRetro",
      "position": [
        2080,
        256
      ],
      "parameters": {
        "teamId": "REPLACE_WITH_TEAM_ID",
        "filters": {
          "dateFrom": "={{ $now.minus({ days: 30 }).toISODate() }}"
        },
        "resource": "parkedItem",
        "operation": "getAll",
        "returnAll": true
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "id": "tr1200-0000-0000-0000-000000000020",
      "name": "Remove Token Overlap Duplicates",
      "type": "n8n-nodes-base.code",
      "position": [
        2288,
        256
      ],
      "parameters": {
        "jsCode": "// Token-overlap (Jaccard) dedupe between the new AI summary and recently parked items.\n// LLM output is never byte-identical, so exact comparison would never fire — instead we\n// normalise both sides to word sets and measure overlap.\n//\n// THRESHOLD: 0.6 catches rewordings of the same issue. Raise it towards 0.8 if distinct\n// items get swallowed as duplicates; lower it if near-duplicates slip through.\nconst THRESHOLD = 0.6;\n\nconst STOPWORDS = new Set([\n  'the', 'a', 'an', 'and', 'or', 'but', 'for', 'with', 'when', 'that', 'this',\n  'are', 'is', 'was', 'were', 'our', 'has', 'have', 'had', 'not', 'can',\n  'into', 'from', 'over', 'on', 'in', 'to', 'of', 'it', 'its',\n]);\n\nfunction tokens(text) {\n  return new Set(\n    String(text)\n      .toLowerCase()\n      .replace(/\\(hs #\\d+\\)/g, ' ') // strip the ticket ref we append to parked titles\n      .replace(/[^\\p{L}\\p{N}\\s]/gu, ' ') // strip emoji and punctuation\n      .split(/\\s+/)\n      .filter((w) => w.length > 1 && !STOPWORDS.has(w)),\n  );\n}\n\nfunction jaccard(a, b) {\n  if (a.size === 0 || b.size === 0) return 0;\n  let overlap = 0;\n  for (const t of a) if (b.has(t)) overlap += 1;\n  return overlap / (a.size + b.size - overlap);\n}\n\nconst summary = $('Summarize & Classify Ticket').first().json.output.summary;\nconst fresh = tokens(summary);\n\nlet bestTitle = null;\nlet bestScore = 0;\nfor (const { json: item } of $input.all()) {\n  const title = item.title ?? item.name ?? '';\n  if (!title) continue; // alwaysOutputData emits one empty item when the lot is empty\n  const score = jaccard(fresh, tokens(title));\n  if (score > bestScore) {\n    bestScore = score;\n    bestTitle = title;\n  }\n}\n\nreturn [\n  {\n    json: {\n      duplicate: bestScore >= THRESHOLD,\n      matchedTitle: bestTitle,\n      matchScore: Math.round(bestScore * 100) / 100,\n      summary,\n    },\n  },\n];"
      },
      "typeVersion": 2
    },
