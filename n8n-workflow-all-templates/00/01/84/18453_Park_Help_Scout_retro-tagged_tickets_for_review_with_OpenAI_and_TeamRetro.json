              "name": "customerMessage",
              "type": "string",
              "value": "={{ (($json._embedded?.threads ?? []).find(t => t.type === 'customer')?.body ?? $('When Help Scout Tag Added').first().json.preview ?? $json.subject).replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim() }}"
            },
            {
              "id": "f-number",
              "name": "number",
              "type": "number",
              "value": "={{ $json.number }}"
            },
            {
              "id": "f-convid",
