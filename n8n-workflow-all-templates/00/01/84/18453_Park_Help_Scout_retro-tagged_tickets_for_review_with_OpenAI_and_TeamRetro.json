              "name": "url",
              "type": "string",
              "value": "=https://secure.helpscout.net/conversation/{{ $json.id }}/{{ $json.number }}"
            },
            {
              "id": "f-mailbox",
              "name": "mailboxId",
              "type": "number",
              "value": "={{ $json.mailboxId }}"
            }
          ]
