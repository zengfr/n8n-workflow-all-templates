    {
      "id": "2d39172c-8741-416d-8e6c-4d482dcfa919",
      "name": "Compute Risk Index",
      "type": "n8n-nodes-base.code",
      "position": [
        -400,
        784
      ],
      "parameters": {
        "jsCode": "const students = $input.all();\nreturn students.map(item => {\n  const s = item.json;\n  const attendance = parseFloat(s['Attendance %\\n(Last 4 Weeks)'] || s['Attendance %'] || s['Attendance']) || 0;\n  const assignments = parseFloat(s['Assignments\\nCompleted (%)'] || s['Assignments Completed (%)'] || s['Assignments']) || 0;\n  const w1 = parseFloat(s['Test Score\\nWeek 1'] || s['Test Score Week 1'] || 0);\n  const w2 = parseFloat(s['Test Score\\nWeek 2'] || s['Test Score Week 2'] || 0);\n  const w3 = parseFloat(s['Test Score\\nWeek 3'] || s['Test Score Week 3'] || 0);\n  const w4 = parseFloat(s['Test Score\\nWeek 4'] || s['Test Score Week 4'] || 0);\n  const avgScore = Math.round(((w1+w2+w3+w4)/4)*10)/10;\n  const riskIndex = Math.round((attendance*0.4 + assignments*0.3 + avgScore*0.3)*10)/10;\n  const scoreTrend = w4-w1 > 5 ? 'Improving' : w1-w4 > 5 ? 'Declining' : 'Stable';\n  const riskLevel = riskIndex < 45 ? 'HIGH' : riskIndex < 65 ? 'MEDIUM' : 'LOW';\n  return { json: { ...s, attendance, assignments, avgScore, riskIndex, riskLevel, scoreTrend } };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "5093019f-837d-4a12-83a0-120b3e9e8286",
      "name": "Filter HIGH Risk Students",
      "type": "n8n-nodes-base.code",
      "position": [
        -96,
        512
      ],
      "parameters": {
        "jsCode": "return $input.all().filter(item => item.json.riskLevel === 'HIGH');"
      },
      "typeVersion": 2
    },
    {
      "id": "3a637bf1-8a97-4759-886b-0804d5e88c5b",
