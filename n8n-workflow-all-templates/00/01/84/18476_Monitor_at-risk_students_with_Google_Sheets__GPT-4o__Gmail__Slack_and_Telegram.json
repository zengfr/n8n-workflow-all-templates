              "content": "=Student: {{ $json['Student Name'] }}\nGrade: {{ $json.Grade }}\nAttendance: {{ $json.attendance }}%\nAssignments done: {{ $json.assignments }}%\nScore trend: {{ $json.scoreTrend }}\nAvg score: {{ $json.avgScore }}/100\n\nWrite the message."
