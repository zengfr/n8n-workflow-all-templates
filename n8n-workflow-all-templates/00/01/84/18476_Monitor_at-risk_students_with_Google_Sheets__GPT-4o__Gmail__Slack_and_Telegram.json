    {
      "id": "9cf43e6c-c09d-4de0-9e17-fd65e7ab00d3",
      "name": "Build Teacher Digest",
      "type": "n8n-nodes-base.code",
      "position": [
        608,
        896
      ],
      "parameters": {
        "jsCode": "const all = $input.all();\nconst high = all.filter(i => i.json.riskLevel === 'HIGH');\nconst medium = all.filter(i => i.json.riskLevel === 'MEDIUM');\nconst digest = `Weekly At-Risk Report\\n\\nHIGH RISK (${high.length}):\\n${high.map((s,i) => `${i+1}. ${s.json['Student Name']} (Gr.${s.json.Grade}) — Risk: ${s.json.riskIndex} | Att: ${s.json.attendance}% | Asgn: ${s.json.assignments}% | Trend: ${s.json.scoreTrend}`).join('\\n')}\\n\\nMEDIUM RISK (${medium.length}):\\n${medium.map((s,i) => `${i+1}. ${s.json['Student Name']} (Gr.${s.json.Grade}) — Risk: ${s.json.riskIndex}`).join('\\n')}`;\nreturn [{ json: { digest, highCount: high.length, mediumCount: medium.length } }];"
      },
      "typeVersion": 2
    },
