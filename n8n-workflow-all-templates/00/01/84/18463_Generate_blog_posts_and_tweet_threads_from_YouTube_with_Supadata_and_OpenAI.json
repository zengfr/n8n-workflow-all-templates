    {
      "id": "731eaadf-fdcd-425e-a821-9b9da17ce7c5",
      "name": "Extract Transcript",
      "type": "n8n-nodes-base.code",
      "position": [
        1216,
        384
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\nlet transcriptText = '';\n\nif (data.error) {\n  transcriptText = 'ERROR: transcript fetch failed - ' + (data.error.message || 'unknown error') + '. Check the Supadata API key and the video URL.';\n} else if (data.status === 'failed') {\n  transcriptText = 'ERROR: Supadata could not produce a transcript for this video (job failed). It may have no captions or audio track available.';\n} else if (data.content) {\n  transcriptText = data.content;\n} else {\n  transcriptText = 'ERROR: no transcript content was returned.';\n}\n\nreturn { json: { transcriptText: transcriptText.slice(0, 8000) } };"
      },
      "typeVersion": 2
    },
    {
      "id": "07cc9576-a020-4126-818e-425d9dae6282",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1904,
        576
      ],
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "typeVersion": 1.2
    },
    {
      "id": "1285c924-a365-4510-9354-274710d6853a",
      "name": "Write Blog Post",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1712,
        384
      ],
      "parameters": {
        "text": "=Video URL: {{ $('On YouTube URL Submitted').item.json['YouTube URL'] }}\n\nTranscript:\n{{ $json.transcriptText }}\n\nIf the transcript above starts with \"ERROR:\", respond with only that message, nothing else.\n\nOtherwise, write a blog post version of this video's content:\n- A compelling title\n- An intro paragraph\n- The main points as ## sections with short paragraphs\n- A brief closing takeaway\n\nWrite it as a standalone article, not a transcript rehash - keep the speaker's key points and examples but organize and tighten the prose. 600-900 words.",
        "promptType": "define"
      },
      "typeVersion": 1.6
    },
    {
      "id": "29c58a31-fbcc-4565-9874-f88f9dd6d394",
      "name": "Write Tweet Thread",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2000,
        384
      ],
      "parameters": {
        "text": "=Video URL: {{ $('On YouTube URL Submitted').item.json['YouTube URL'] }}\n\nTranscript:\n{{ $json.transcriptText }}\n\nIf the transcript above starts with \"ERROR:\", respond with only that message, nothing else.\n\nOtherwise, turn this video's content into a 5-8 tweet thread:\n- Tweet 1 is a hook that makes people want to read on\n- Each following tweet covers one distinct point from the video\n- Final tweet is a short takeaway or call to action\n- Number each tweet (1/, 2/, etc), keep each under 280 characters, no hashtags spam (0-1 max per tweet)",
        "promptType": "define"
      },
      "typeVersion": 1.6
    }
  ],
