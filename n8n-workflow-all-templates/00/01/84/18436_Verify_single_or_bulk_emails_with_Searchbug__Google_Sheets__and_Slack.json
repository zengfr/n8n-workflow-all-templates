{
  "id": "cD4sH4s6vm7XdMoS",
  "name": "Email Verification (Single + Bulk CSV)",
  "tags": [],
  "nodes": [
    {
      "id": "ft-001",
      "name": "Email Verification Form",
      "type": "n8n-nodes-base.formTrigger",
      "notes": "Entry point of the workflow. User can submit a single email address OR upload a CSV file. Both fields are optional — the next IF node decides which path to take based on what was filled in.",
      "position": [
        -400,
        440
      ],
      "webhookId": "c3d4e5f6-a7b8-9012-cdef-012345678901",
      "parameters": {
        "options": {},
        "formTitle": "Email Verification",
        "formFields": {
          "values": [
            {
              "fieldType": "email",
              "fieldLabel": "Email",
              "placeholder": "Enter email address (leave blank for CSV upload)"
            },
            {
              "fieldType": "file",
              "fieldLabel": "CSV File",
              "acceptFileTypes": ".csv"
            }
          ]
        },
        "responseMode": "lastNode",
        "formDescription": "Enter a single email address OR upload a CSV file for bulk verification."
      },
      "typeVersion": 2.5
    },
    {
      "id": "if-001",
      "name": "Single or Bulk?",
      "type": "n8n-nodes-base.if",
      "notes": "Routes the flow based on whether the Email field was filled in. TRUE (top path) = single email mode. FALSE (bottom path) = bulk CSV mode.",
      "position": [
        -140,
        440
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": false,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-001",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.Email }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "ss-001",
      "name": "Set Single Email",
      "type": "n8n-nodes-base.set",
      "notes": "Trims any leading/trailing whitespace from the submitted email and stores it under the standardized field name `email` so it matches the output format from the CSV path.",
      "position": [
        120,
        340
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "se-001",
              "name": "email",
              "type": "string",
              "value": "={{ $json.Email.trim() }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "ef-001",
      "name": "Extract CSV",
      "type": "n8n-nodes-base.extractFromFile",
      "notes": "Parses the uploaded CSV binary file and outputs one item per row. n8n stores the uploaded file under the key `CSV_File` (spaces in field labels are replaced with underscores). CSV must have an `email` column header.",
      "position": [
        120,
        560
      ],
      "parameters": {
        "options": {},
        "binaryPropertyName": "CSV_File"
      },
      "typeVersion": 1
    },
    {
      "id": "nm-001",
      "name": "Normalize",
      "type": "n8n-nodes-base.set",
      "notes": "Merges both the single and bulk paths into one consistent `email` field. Handles CSV headers with different capitalizations — checks for `email`, `Email`, and `EMAIL` in that order.",
      "position": [
        380,
        440
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "nm-001",
              "name": "email",
              "type": "string",
              "value": "={{ $json.email || $json.Email || $json.EMAIL }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "ve-001",
      "name": "Verify Email",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "Calls the Searchbug Email Verification API (api_emver) for each email address. `continueOnFail` is enabled so the workflow continues even if a single address returns an error instead of stopping entirely.",
      "position": [
        640,
        440
      ],
      "parameters": {
        "url": "https://data.searchbug.com/api/search.aspx",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "CO_CODE"
            },
            {
              "name": "PASS"
            },
            {
              "name": "TYPE",
              "value": "api_emver"
            },
            {
              "name": "E_MAIL",
              "value": "={{ $json.email }}"
            },
            {
              "name": "FORMAT",
              "value": "JSON"
            }
          ]
        }
      },
      "typeVersion": 4.4,
      "continueOnFail": true
    },
    {
      "id": "er-001",
      "name": "Extract Result",
      "type": "n8n-nodes-base.set",
      "notes": "Flattens the Searchbug response into clean columns: email (pulled from Normalize, not the API response), status, and the domain / MX / SMTP verification fields.",
      "position": [
        900,
        440
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "r-001",
              "name": "email",
              "type": "string",
              "value": "={{ $('Normalize').item.json.email }}"
            },
            {
              "id": "r-002",
              "name": "status",
              "type": "string",
              "value": "={{ ($json.Data ?? $json[0]?.Data)?.STATUS ?? ($json.error ? 'ERROR' : '') }}"
            },
            {
              "id": "r-003",
              "name": "sub_status",
              "type": "string",
              "value": "={{ ($json.Data ?? $json[0]?.Data)?.SUB_STATUS ?? '' }}"
            },
            {
              "id": "r-004",
              "name": "free_email",
              "type": "string",
              "value": "={{ ($json.Data ?? $json[0]?.Data)?.FREE_EMAIL ?? '' }}"
            },
            {
              "id": "r-005",
              "name": "catchall_domain",
              "type": "string",
              "value": "={{ ($json.Data ?? $json[0]?.Data)?.CATCHALL_DOMAIN ?? '' }}"
            },
            {
              "id": "r-006",
              "name": "did_you_mean",
              "type": "string",
              "value": "={{ ($json.Data ?? $json[0]?.Data)?.DID_YOU_MEAN ?? '' }}"
            },
            {
              "id": "r-007",
              "name": "domain",
              "type": "string",
              "value": "={{ ($json.Data ?? $json[0]?.Data)?.DOMAIN ?? '' }}"
            },
            {
              "id": "r-008",
              "name": "mx_found",
              "type": "string",
              "value": "={{ ($json.Data ?? $json[0]?.Data)?.MX_FOUND ?? '' }}"
            },
            {
              "id": "r-009",
              "name": "smtp_provider",
              "type": "string",
              "value": "={{ ($json.Data ?? $json[0]?.Data)?.SMTP_PROVIDER ?? '' }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "ev-sheets",
      "name": "Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
