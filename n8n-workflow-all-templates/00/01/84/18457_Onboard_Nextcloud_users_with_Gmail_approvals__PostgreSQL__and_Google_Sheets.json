    {
      "id": "a0bcc9d0-c8c4-40d2-9352-c01fc0d09f92",
      "name": "Create Temp Password",
      "type": "n8n-nodes-base.code",
      "position": [
        2544,
        352
      ],
      "parameters": {
        "jsCode": "// ==========================================================================\n// TEMPLATE: Secure Temporary Password Generator\n// ==========================================================================\nfor (const item of $input.all()) {\n  const email = item.json[\"Email Address\"] || item.json[\"email\"] || \"\";\n  \n  // Generate a random 8-character alphanumeric string with special character\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789!@#$%';\n  let randomStr = '';\n  for (let i = 0; i < 8; i++) {\n    randomStr += chars.charAt(Math.floor(Math.random() * chars.length));\n  }\n  \n  // Combine prefix with random entropy\n  const tempPassword = `Pass!${randomStr}`;\n  \n  // Output password property for downstream nodes\n  item.json.password = tempPassword;\n  item.json.generatedAt = new Date().toISOString();\n}\n\nreturn $input.all();"
      },
      "typeVersion": 2
    },
