    {
      "id": "b6c28ba6-e71e-418b-92dc-9e7f688791ac",
      "name": "Create QR Login URL",
      "type": "n8n-nodes-base.code",
      "position": [
        3056,
        416
      ],
      "parameters": {
        "jsCode": "// ==========================================================================\n// TEMPLATE: Build Nextcloud Mobile Login Deep Link Payload\n// ==========================================================================\nconst userEmail = $('When Form Submitted').item.json['Email Address'];\nconst userPassword = $('Create Temp Password').item.json.password;\n\n// Configure your instance address here (or use an environment variable)\nconst serverAddress = \"https://your-nextcloud-instance.com\";\n\n// 1. Build standard Nextcloud mobile auto-login deep link format\nconst loginPayload = `nextcloud://login/server=${serverAddress}&user=${encodeURIComponent(userEmail)}&password=${encodeURIComponent(userPassword)}`;\n\n// 2. Safely URL encode payload for the QR code API service\nconst encodedPayload = encodeURIComponent(loginPayload);\n\n// 3. Construct public QR code generation endpoint (or replace with internal microservice)\nconst qrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&format=png&data=${encodedPayload}`;\n\nreturn {\n  json: {\n    username: userEmail,\n    serverUrl: serverAddress,\n    qrCodeUrl: qrCodeUrl\n  }\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "12baa7bd-f531-4971-88af-1c4c15c45071",
