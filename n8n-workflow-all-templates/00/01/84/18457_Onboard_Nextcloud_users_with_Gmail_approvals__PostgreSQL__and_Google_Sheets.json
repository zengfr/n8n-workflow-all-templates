    {
      "id": "a2169a92-a013-4aae-b01b-aaabf1820bf9",
      "name": "Prepare Email Attachment",
      "type": "n8n-nodes-base.code",
      "position": [
        3472,
        416
      ],
      "parameters": {
        "jsCode": "// ==========================================================================\n// TEMPLATE: Format Attachment for Email Node\n// ==========================================================================\nconst inputItem = $input.first();\nconst username = $('When Form Submitted').item.json['Email Address'];\nconst fullName = $('When Form Submitted').item.json['Full Name'];\nconst password = $('Create Temp Password').item.json.password;\n\n// Retrieve binary file from HTTP request node (defaults to property 'data')\nconst binaryFile = inputItem.binary?.data;\n\nreturn {\n  json: {\n    username,\n    fullName,\n    password\n  },\n  binary: {\n    attachment_0: binaryFile || {\n      data: inputItem.json?.qrImage || \"\",\n      mimeType: 'image/png',\n      fileName: 'nextcloud-login-qr.png'\n    }\n  }\n};"
      },
      "typeVersion": 2
    },
