    {
      "id": "c7d6d687-65f1-421c-9214-e90674be01f0",
      "name": "Validate & Normalize PR Data",
      "type": "n8n-nodes-base.code",
      "position": [
        368,
        1216
      ],
      "parameters": {
        "jsCode": "const pr = $input.first().json.body;\n\n// Required fields\nconst requiredFields = [\n  \"pr_id\",\n  \"requester\",\n  \"description\",\n  \"amount\"\n];\n\n// Check for missing required fields\nconst missingFields = requiredFields.filter(\n  field => !pr[field]\n);\n\n// Stop workflow if required data missing\nif (missingFields.length > 0) {\n  throw new Error(\n    `Missing required field(s): ${missingFields.join(\", \")}`\n  );\n}\n\n// Normalize data\nconst normalizedPR = {\n  pr_id: pr.pr_id,\n  requester: pr.requester,\n  department: pr.department || \"Unknown Department\",\n  description: pr.description.trim(),\n  amount: Number(pr.amount) || 0,\n  currency: pr.currency || \"USD\",\n  items: Array.isArray(pr.items) ? pr.items : [],\n  suggested_category: pr.suggested_category || \"Uncategorized\",\n\n  // Metadata\n  received_at: new Date().toISOString(),\n\n  // Derived values\n  item_count: Array.isArray(pr.items)\n    ? pr.items.length\n    : 0\n};\n\nreturn [\n  {\n    json: normalizedPR\n  }\n];"
      },
      "typeVersion": 2
    },
