    {
      "id": "node-config",
      "name": "Build Initial Config Values",
      "type": "n8n-nodes-base.code",
      "position": [
        -1960,
        300
      ],
      "parameters": {
        "jsCode": "// Reset the daily run counters and hold the config values everything downstream reads.\nconst staticData = $getWorkflowStaticData('global');\nstaticData.summary = { checked: 0, drops: 0, errors: 0, lowConfidence: 0 };\n\nreturn [{\n  json: {\n    slackAlertChannelId: 'REPLACE_WITH_SLACK_ALERT_CHANNEL_ID',\n    slackErrorChannelId: 'REPLACE_WITH_SLACK_ERROR_CHANNEL_ID',\n    notionDatabaseId: 'REPLACE_WITH_NOTION_DATABASE_ID',\n    googleSheetId: 'REPLACE_WITH_GOOGLE_SHEET_ID',\n    priceDropThresholdPercent: 5\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
