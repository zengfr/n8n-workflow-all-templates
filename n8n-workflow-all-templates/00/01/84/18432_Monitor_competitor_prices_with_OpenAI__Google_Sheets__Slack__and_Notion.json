      "type": "n8n-nodes-base.slack",
      "position": [
        -180,
        120
      ],
      "parameters": {
        "text": "=🔍 *Low-confidence price extraction — needs manual check*\n*Product:* {{ $json.productName }}\n*URL:* {{ $json.competitorUrl }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.slackErrorChannelId }}"
        },
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "node-compare-price",
      "name": "Evaluate Price Changes",
      "type": "n8n-nodes-base.code",
      "position": [
        48,
        224
      ],
      "parameters": {
        "jsCode": "// Compare the extracted price to the last known price and flag significant drops.\nconst item = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nstaticData.summary.checked = (staticData.summary.checked || 0) + 1;\n\nconst newPrice = parseFloat(item.price);\nconst lastPrice = parseFloat(item.lastKnownPrice) || newPrice;\nconst pctChange = lastPrice ? ((newPrice - lastPrice) / lastPrice) * 100 : 0;\nconst threshold = parseFloat(item.priceDropThresholdPercent) || 5;\nconst isSignificantDrop = pctChange <= -threshold;\n\nif (isSignificantDrop) {\n  staticData.summary.drops = (staticData.summary.drops || 0) + 1;\n}\n\nreturn [{\n  json: {\n    ...item,\n    newPrice,\n    pctChange: Math.round(pctChange * 100) / 100,\n    isSignificantDrop\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "node-if-drop",
      "name": "Assess Significant Price Drop",
      "type": "n8n-nodes-base.if",
      "position": [
        272,
        224
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-drop",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.isSignificantDrop }}",
              "rightValue": true
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
