    {
      "id": "node-build-summary",
      "name": "Create Daily Competitor Summary",
      "type": "n8n-nodes-base.code",
      "position": [
        -1504,
        656
      ],
      "parameters": {
        "jsCode": "// Build and post the daily summary once every row has been processed.\nconst staticData = $getWorkflowStaticData('global');\nconst s = staticData.summary || { checked: 0, drops: 0, errors: 0, lowConfidence: 0 };\n\nconst summaryText = `Daily competitor price check complete.\\nChecked: ${s.checked}\\nPrice drops flagged: ${s.drops}\\nFetch errors: ${s.errors}\\nLow-confidence extractions: ${s.lowConfidence}`;\n\nconst config = $('Build Initial Config Values').first().json;\n\nreturn [{\n  json: {\n    summaryText,\n    slackAlertChannelId: config.slackAlertChannelId\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "node-slack-summary",
      "name": "Post Summary to Slack",
      "type": "n8n-nodes-base.slack",
      "position": [
        -1280,
        656
      ],
      "parameters": {
        "text": "={{ $json.summaryText }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.slackAlertChannelId }}"
        },
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "node-http-fetch",
      "name": "Fetch Competitor Web Page",
      "type": "n8n-nodes-base.httpRequest",
      "onError": "continueErrorOutput",
      "maxTries": 3,
      "position": [
        -1248,
        224
      ],
      "parameters": {
        "url": "={{ $json.competitorUrl }}",
        "method": "GET",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
    },
    {
      "id": "node-handle-error",
      "name": "Process Fetch Error",
      "type": "n8n-nodes-base.code",
      "position": [
        -1024,
        128
      ],
      "parameters": {
        "jsCode": "// Fetch failed even after retries — carry the original row through with the error message attached.\nconst item = $input.first().json;\nconst row = $('Loop Over Competitor URL List').item.json;\nconst config = $('Build Initial Config Values').first().json;\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.summary.errors = (staticData.summary.errors || 0) + 1;\n\nreturn [{\n  json: {\n    ...row,\n    ...config,\n    errorMessage: item.error?.message || item.message || 'Unknown fetch error'\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "node-slack-fetch-error",
      "name": "Post Fetch Error Alert to Slack",
      "type": "n8n-nodes-base.slack",
      "position": [
        -800,
        128
      ],
      "parameters": {
        "text": "=⚠️ *Could not fetch competitor page*\n*Product:* {{ $json.productName }}\n*URL:* {{ $json.competitorUrl }}\n*Error:* {{ $json.errorMessage }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.slackErrorChannelId }}"
        },
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_YOUR_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "node-clean-html",
      "name": "Convert HTML to Plain Text",
      "type": "n8n-nodes-base.code",
      "position": [
        -1056,
        576
      ],
      "parameters": {
        "jsCode": "// Strip the fetched HTML down to plain text so the AI prompt stays small.\nconst httpResponse = $input.first().json;\nconst row = $('Loop Over Competitor URL List').item.json;\n\nlet html = httpResponse.data ?? httpResponse.body ?? (typeof httpResponse === 'string' ? httpResponse : JSON.stringify(httpResponse));\nlet text = String(html)\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 4000);\n\nreturn [{\n  json: {\n    ...row,\n    pageText: text\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "node-openai-extract",
      "name": "OpenAI Price and Stock Extraction",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        -832,
        576
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a price-monitoring assistant. You will be given the visible text scraped from a competitor's product page. Extract the current price and stock status. Respond ONLY with valid JSON (no markdown, no code fences) in this exact shape:\n{\n  \"price\": number or null,\n  \"inStock\": true, false, or null,\n  \"confidence\": \"high\" | \"low\"\n}\nUse null and \"low\" confidence if the price cannot be reliably found in the text."
            },
            {
              "role": "user",
              "content": "=Product: {{ $json.productName }}\nOur current price: {{ $json.ourPrice }}\nScraped page text:\n{{ $json.pageText }}"
            }
          ]
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "node-parse-ai",
      "name": "Parse AI Extraction Results",
      "type": "n8n-nodes-base.code",
      "position": [
        -624,
        576
      ],
      "parameters": {
        "jsCode": "// Parse the AI response and track low-confidence extractions.\nconst raw = $input.first().json.message?.content ?? $input.first().json.text ?? $input.first().json.output ?? '';\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { price: null, inStock: null, confidence: 'low' };\n}\nif (!parsed.confidence) {\n  parsed.confidence = (parsed.price === null || parsed.price === undefined) ? 'low' : 'high';\n}\n\nconst staticData = $getWorkflowStaticData('global');\nif (parsed.confidence === 'low') {\n  staticData.summary.lowConfidence = (staticData.summary.lowConfidence || 0) + 1;\n}\n\nconst row = $('Loop Over Competitor URL List').item.json;\nconst config = $('Build Initial Config Values').first().json;\n\nreturn [{\n  json: {\n    ...row,\n    ...parsed,\n    ...config\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "node-if-low-confidence",
      "name": "Check Extraction Confidence",
      "type": "n8n-nodes-base.if",
      "position": [
        -400,
        220
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-low-conf",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.confidence }}",
              "rightValue": "low"
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "node-slack-low-conf",
