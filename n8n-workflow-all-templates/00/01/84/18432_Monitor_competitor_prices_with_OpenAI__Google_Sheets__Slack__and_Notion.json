      "parameters": {
        "text": "=📉 *Competitor price drop detected*\n*Product:* {{ $json.productName }}\n*New price:* {{ $json.newPrice }} ({{ $json.pctChange }}%)\n*Our price:* {{ $json.ourPrice }}\n*URL:* {{ $json.competitorUrl }}",
