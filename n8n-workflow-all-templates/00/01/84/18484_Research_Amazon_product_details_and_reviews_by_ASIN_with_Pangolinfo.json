            {
              "id": "00a825a9-48b9-4203-9fb0-e45ec461d515",
              "name": "asin",
              "type": "string",
              "value": "B0DYTF8L2W"
            },
            {
              "id": "099a417a-f591-4aa8-bf96-305c3783ff0f",
              "name": "site",
              "type": "string",
              "value": "amz_us"
            },
            {
              "id": "d22d0870-486f-4e09-a102-45255b99e708",
              "name": "zipcode",
              "type": "string",
              "value": "10041"
            },
            {
              "id": "4a0221c1-fd9e-4806-9e12-e6beec76f163",
