              "type": "number",
              "value": 1
            },
            {
              "id": "5bf7f5a5-88ec-4f15-a145-f3473db50f20",
              "name": "starFilter",
              "type": "string",
              "value": "all_stars"
            },
            {
              "id": "1739ec12-c7f8-4ae7-9ca9-5fd519506d0e",
              "name": "reviewSort",
              "type": "string",
              "value": "recent"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "8f745130-196d-412c-87e1-d13516cce30c",
