      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        0,
        160
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "f8495010-f2a7-48bd-ac4d-e1efc03f51ba",
