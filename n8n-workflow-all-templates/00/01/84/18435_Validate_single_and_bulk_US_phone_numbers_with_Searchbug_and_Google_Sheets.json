    {
      "id": "5851e94b-d128-4ca1-a9c7-f0bbe9350b26",
      "name": "Extract Results",
      "type": "n8n-nodes-base.code",
      "position": [
        2416,
        448
      ],
      "parameters": {
        "jsCode": "const phones = $('Clean Phone').all();\nconst apiItems = $input.all();\nconst total = Math.max(phones.length, apiItems.length);\n\nconst results = [];\nfor (let i = 0; i < total; i++) {\n  const phone = phones[i] ? String(phones[i].json.phone || '') : '';\n  const api = apiItems[i] ? apiItems[i].json : null;\n\n  if (!api || api.Status !== 'Success') {\n    results.push({ json: {\n      phone,\n      phone_type: '', carrier: '', voip: '', dnc: '', tcpa: '',\n      ported: '', state: '', timezone: '', cnam: '', location_code: '',\n      formatted_phone: '', lata: '', local_time: '', ocn: '',\n      validated_at: new Date().toISOString(),\n      validation_status: 'Failed'\n    }});\n    continue;\n  }\n\n  const p = api.Data && api.Data.PHONE ? api.Data.PHONE : {};\n  results.push({ json: {\n    phone,\n    phone_type: p.TYPE || '',\n    carrier: p.CARRIER || '',\n    voip: p.VOIP || '',\n    dnc: p.DNC !== null && p.DNC !== undefined ? String(p.DNC) : 'N/A',\n    tcpa: p.TCPA !== null && p.TCPA !== undefined ? String(p.TCPA) : 'N/A',\n    ported: p.PORTED || '',\n    state: p.STATE || '',\n    timezone: p.TIMEZONE || '',\n    cnam: p.CNAM !== null && p.CNAM !== undefined ? String(p.CNAM) : '',\n    location_code: p.LOCATION || '',\n    formatted_phone: p.NUMBER2 || '',\n    lata: p.LATA || '',\n    local_time: p.TIMENOW || '',\n    ocn: p.OCN || '',\n    validated_at: new Date().toISOString(),\n    validation_status: 'Success'\n  }});\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
