      "parameters": {
        "color": 7,
        "width": 1136,
        "height": 520,
        "content": "## 📊 Data Processing & Risk Flagging\nReads all student rows, fetches last week's snapshot for comparison, calculates attendance rate, grade average, and homework completion, then flags each student by the number of red-flag indicators (attendance <80%, grade <60%, homework <70%, declining trend)."
      },
      "typeVersion": 1
    },
