    {
      "id": "7827bf28-4a76-4b71-94f5-62377cc6e4c0",
      "name": "Process & Flag Students",
      "type": "n8n-nodes-base.code",
      "position": [
        -1248,
        848
      ],
      "parameters": {
        "jsCode": "const rows = $input.all();\nlet previousRows = [];\ntry { previousRows = $('Fetch Previous Week Snapshot').all(); } catch (e) { previousRows = []; }\n\nfunction findPrevious(name) {\n  const match = previousRows.find(r => (r.json.student_name || '').trim() === (name || '').trim());\n  return match ? match.json : null;\n}\n\nreturn rows.map(r => {\n  const s = r.json;\n  const attendance = parseFloat(s.attendance_pct) || 0;\n  const testScore = parseFloat(s.avg_test_score) || 0;\n  const hwCompletion = parseFloat(s.homework_completion_pct) || 0;\n\n  const attendanceThreshold = parseFloat(s.attendance_threshold) || 75;\n  const testThreshold = parseFloat(s.test_score_threshold) || 50;\n  const hwThreshold = parseFloat(s.homework_threshold) || 60;\n  const urgentFlagCount = parseInt(s.urgent_flag_count) || 3;\n\n  const redFlags = [];\n  if (attendance < attendanceThreshold) redFlags.push(`Low attendance: ${attendance}%`);\n  if (testScore < testThreshold) redFlags.push(`Low test score: ${testScore}%`);\n  if (hwCompletion < hwThreshold) redFlags.push(`Low homework completion: ${hwCompletion}%`);\n\n  const prev = findPrevious(s.student_name);\n  let trend = 'No prior data';\n  if (prev) {\n    const prevAvg = ((parseFloat(prev.attendance) || 0) + (parseFloat(prev.test_score) || 0) + (parseFloat(prev.hw_completion) || 0)) / 3;\n    const currAvg = (attendance + testScore + hwCompletion) / 3;\n    const delta = currAvg - prevAvg;\n    if (delta > 2) trend = `Improving (+${delta.toFixed(1)} pts avg)`;\n    else if (delta < -2) trend = `Declining (${delta.toFixed(1)} pts avg)`;\n    else trend = 'Stable';\n  }\n\n  return {\n    json: {\n      ...s,\n      attendance,\n      testScore,\n      hwCompletion,\n      redFlags,\n      redFlagCount: redFlags.length,\n      isUrgent: redFlags.length >= urgentFlagCount,\n      trend,\n      preferred_channel: (s.preferred_channel || 'both').toLowerCase()\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "45c42ab1-a837-4eee-bc4e-9e88a6c49b2c",
      "name": "AI: Write Parent Narrative",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
