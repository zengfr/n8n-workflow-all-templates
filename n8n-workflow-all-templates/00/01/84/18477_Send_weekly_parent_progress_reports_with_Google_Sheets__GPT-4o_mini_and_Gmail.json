          "temperature": 0.7
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a compassionate school communication assistant. Write warm, personalised, constructive parent progress updates in 3-4 paragraphs. Mention specific numbers naturally. Reference the trend (improving/declining/stable) if provided. Avoid being overly negative. Sign off as 'The Academic Team'."
            },
            {
              "content": "=Write a weekly progress report for parent of student: {{$json.student_name}}\n\nAttendance: {{$json.attendance}}%\nAverage Test Score: {{$json.testScore}}%\nHomework Completion: {{$json.hwCompletion}}%\nSubject: {{$json.subject}}\nClass: {{$json.class_name}}\nWeek-over-week trend: {{$json.trend}}\nWeek ending: {{$now.format('DD MMM YYYY')}}\n\nRed Flags (if any): {{$json.redFlags.join(', ') || 'None'}}\n\nWrite a personalised, warm narrative progress update for the parent. DO NOT use a generic template. Reference specific metrics and the trend naturally."
            }
          ]
        }
      },
      "typeVersion": 1.4
    },
