        "jsonBody": "={{ JSON.stringify({\n  mediaUrls: $json.mediaUrls,\n  model: $('On transcription request').first().json['Whisper model'] || 'base',\n  language: $json.language || undefined,\n  outputFormats: ['text', 'segments']\n}) }}",
