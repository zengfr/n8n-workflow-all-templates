    {
      "id": "70804307-7892-4309-8a2b-575fd739c7e5",
      "name": "Log transcript in Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        3248,
        -128
      ],
      "parameters": {
        "columns": {
          "value": {
            "Error": "",
            "Title": "={{ $('Build Markdown note').item.json.title }}",
            "Words": "={{ $('Build Markdown note').item.json.wordCount }}",
            "Status": "transcribed",
            "Topics": "={{ $('Build Markdown note').item.json.topics }}",
