      "parameters": {
        "color": 7,
        "width": 1008,
        "height": 528,
        "content": "## Summarize each recording\n\nOne item per file. Transcripts that came back empty branch off to the failure log. The rest get a summary, key points, action items and topics from the LLM."
      },
      "typeVersion": 1
    },
    {
      "id": "df6d4af5-15f0-45e3-8fa8-54e0322c11d9",
