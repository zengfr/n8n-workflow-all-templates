    {
      "id": "56395674-a7cb-4e49-8d2c-75902cb012ec",
      "name": "Get transcripts",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1552,
        -32
      ],
      "parameters": {
        "url": "=https://api.apify.com/v2/actor-runs/{{ $('Start transcription run').first().json.data.id }}/dataset/items?clean=true&format=json",
        "method": "GET",
        "options": {
          "timeout": 60000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "2d97abcd-1258-4447-88ac-ea0f6631a7f0",
      "name": "Split transcripts",
      "type": "n8n-nodes-base.code",
      "position": [
        1760,
        -32
      ],
      "parameters": {
        "jsCode": "// The dataset endpoint answers with an array. Emit one n8n item per media file\n// so every transcript is summarised, saved and logged on its own.\nconst rows = [];\nfor (const item of items) {\n  const value = item.json;\n  if (Array.isArray(value)) rows.push(...value);\n  else if (Array.isArray(value.data)) rows.push(...value.data);\n  else rows.push(value);\n}\n// All rows come from the single HTTP response item, so pair them back to item 0\n// and n8n can still trace data lineage in later nodes.\nreturn rows.map((row) => ({ json: row, pairedItem: { item: 0 } }));\n"
      },
      "typeVersion": 2
    },
    {
      "id": "a1e1530c-b7ad-4a33-8472-33f05c812ce8",
      "name": "Transcribed OK?",
      "type": "n8n-nodes-base.if",
