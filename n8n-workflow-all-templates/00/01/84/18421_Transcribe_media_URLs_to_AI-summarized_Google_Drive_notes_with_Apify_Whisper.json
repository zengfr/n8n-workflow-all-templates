    {
      "id": "502c6702-38b8-44e9-8333-45169db44e33",
      "name": "Build Apify input",
      "type": "n8n-nodes-base.code",
      "position": [
        416,
        0
      ],
      "parameters": {
        "jsCode": "// Turn the pasted textarea into a clean, de-duplicated list of media URLs.\nconst settings = $('Settings').first().json;\nconst pasted = $('On transcription request').first().json['Media URLs'] || '';\n\nconst mediaUrls = [...new Set(\n  String(pasted)\n    .split(/[\\s,]+/)\n    .map((u) => u.trim().replace(/[),.]+$/, ''))\n    .filter((u) => /^https?:\\/\\//i.test(u)),\n)].slice(0, settings.maxUrlsPerRun);\n\nif (mediaUrls.length === 0) {\n  throw new Error('No valid http(s) media URL was submitted. Paste one URL per line.');\n}\n\nconst language = String($('On transcription request').first().json['Spoken language'] || '').trim();\n\nreturn [{ json: { mediaUrls, urlCount: mediaUrls.length, language } }];\n"
      },
      "typeVersion": 2
    },
