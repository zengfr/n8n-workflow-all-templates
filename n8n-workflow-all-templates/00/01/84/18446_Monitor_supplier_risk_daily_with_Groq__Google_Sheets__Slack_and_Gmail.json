    {
      "id": "c4968699-ea8d-4a75-b18a-0a9bdf356071",
      "name": "Pre-AI Data Formatting",
      "type": "n8n-nodes-base.code",
      "position": [
        1856,
        720
      ],
      "parameters": {
        "jsCode": "// This script takes the huge XML and extracts only the top 5 news titles\nconst xmlData = $node[\"Combine Research Data\"].json[\"data\"];\n\n// Use a simple regex to find the <title> tags in the RSS feed\nconst titles = xmlData.match(/<title>(.*?)<\\/title>/g) || [];\n\n// Remove the first title (which is the name of the RSS feed itself) \n// and join the next 5 headlines into a clean string\nconst cleanHeadlines = titles.slice(1, 6)\n  .map(t => t.replace(/<\\/?title>/g, ''))\n  .join(\" | \");\n\nreturn {\n  headlines: cleanHeadlines\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "cb903cd2-95f1-401a-9a7e-eec31396c094",
      "name": "Analyze Sentiment & Risk",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2432,
        752
      ],
      "parameters": {
        "text": "=You are a Senior Supply Chain Risk Auditor.\nAnalyze the following multi-source dossier for Supplier: {{ $node[\"Process Each Supplier\"].json[\"Supplier Name\"] }}\n\n--- 1. INTERNAL KPIs ---\nDelay Rate: {{ $node[\"Process Each Supplier\"].json[\"Delay Rate (%)\"] }}%\nRejection Rate: {{ $node[\"Process Each Supplier\"].json[\"Rejection Rate (%)\"] }}%\n\n--- 2. EXTERNAL NEWS ---\n{{ $json.headlines }}\n\n--- 3. REGULATORY/ECONOMIC SIGNALS ---\nSanctions Status: {{ $json[\"sanctions_result\"] || \"No direct matches\" }}\nCurrency Volatility: {{ $json[\"currency_report\"] || \"Stable\" }}\n\n--- TASK ---\n1. Identify if external signals (News/Currency) explain or predict the internal KPIs.\n2. Assign a 'Sentiment Risk Score' from 1-10.\n3. Identify 2 'Mitigation Actions' (e.g., \"Seek backup in Vietnam,\" \"Hedge currency\").\n\nReturn ONLY a JSON object:\n{\n  \"sentiment_score\": [Number],\n  \"risk_summary\": \"[1 sentence]\",\n  \"mitigation_plan\": [\"[Step 1]\", \"[Step 2]\"],\n  \"early_warning_level\": \"High/Medium/Low\"\n}",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "e41109bc-b631-44f9-874a-0934a73b1377",
      "name": "Calculate Final Risk Score",
      "type": "n8n-nodes-base.code",
      "position": [
        2784,
        752
      ],
      "parameters": {
        "jsCode": "// 1. Clean the AI response and parse\nconst rawOutput = $json.output;\nconst cleanOutput = rawOutput.replace(/```json|```/g, \"\").trim();\nconst ai = JSON.parse(cleanOutput);\n\n// 2. Fetch the raw KPI data\nconst delayRate = $node[\"Process Each Supplier\"].json[\"Delay Rate (%)\"] || 0;\nconst rejectionRate = $node[\"Process Each Supplier\"].json[\"Rejection Rate (%)\"] || 0;\n\n// 3. Define Weights\nconst sentimentWeight = 0.5;\nconst delayWeight = 0.3;\nconst rejectionWeight = 0.2;\n\n// 4. Calculate Final Composite Risk Score\nconst score = (ai.sentiment_score * 10 * sentimentWeight) + \n              (delayRate * delayWeight) + \n              (rejectionRate * rejectionWeight);\n\n// 5. Determine Level\nlet finalLevel = ai.early_warning_level;\nif (score > 80) finalLevel = \"High\";\n\nreturn {\n  supplier: $node[\"Process Each Supplier\"].json[\"Supplier Name\"],\n  final_composite_score: Math.round(score),\n  risk_level: finalLevel,\n  ai_summary: ai.risk_summary,\n  mitigation_plan: ai.mitigation_plan\n};"
      },
      "typeVersion": 2
    },
