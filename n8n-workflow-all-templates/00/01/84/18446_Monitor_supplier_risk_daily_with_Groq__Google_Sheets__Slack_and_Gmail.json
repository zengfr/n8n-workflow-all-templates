    {
      "id": "4bb510b7-c13f-4b42-b3cc-969c3b3223d3",
      "name": "Deduplicate & Slim Data",
      "type": "n8n-nodes-base.code",
      "position": [
        2448,
        208
      ],
      "parameters": {
        "jsCode": "// 1. Get all items from the previous Google Sheets node\nconst allData = items;\nconst uniqueSuppliers = {};\n\nallData.forEach(item => {\n    // Check if the column is named \"Supplier Name\" or just \"Supplier\"\n    const name = item.json[\"Supplier Name\"] || item.json[\"Supplier\"];\n    \n    if (name) {\n        uniqueSuppliers[name] = {\n            supplier: name,\n            risk_score: item.json[\"Risk Score\"],\n            level: item.json[\"Risk Level\"],\n            // Just the first 80 characters of the strategy to keep it tiny\n            snippet: (item.json.Strategy || item.json.ai_summary || \"\").substring(0, 80) + \"...\"\n        };\n    }\n});\n\n// 2. Convert to a clean list\nconst cleanedList = Object.values(uniqueSuppliers);\n\nreturn {\n    report_count: cleanedList.length,\n    report_data: JSON.stringify(cleanedList, null, 2)\n};"
      },
      "typeVersion": 2
    },
