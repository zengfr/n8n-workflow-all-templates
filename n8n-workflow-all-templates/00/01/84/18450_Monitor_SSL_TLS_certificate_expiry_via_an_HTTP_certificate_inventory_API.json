    },
    {
      "id": "cc3fa1b3-d179-479d-b626-25735180562c",
      "name": "Calculate Days Until Expiry & Urgency Tier",
      "type": "n8n-nodes-base.set",
      "position": [
        352,
        -272
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "daysUntilExpiry",
              "type": "number",
              "value": "={{ Math.ceil((new Date($json.expiryDate).getTime() - Date.now()) / 86400000) }}"
            },
            {
              "name": "urgencyTier",
              "type": "string",
              "value": "={{ (Math.ceil((new Date($json.expiryDate).getTime() - Date.now()) / 86400000) <= $json.criticalDaysThreshold) ? 'Critical' : (Math.ceil((new Date($json.expiryDate).getTime() - Date.now()) / 86400000) <= $json.warningDaysThreshold) ? 'Warning' : (Math.ceil((new Date($json.expiryDate).getTime() - Date.now()) / 86400000) <= $json.watchDaysThreshold) ? 'Watch' : 'OK' }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
