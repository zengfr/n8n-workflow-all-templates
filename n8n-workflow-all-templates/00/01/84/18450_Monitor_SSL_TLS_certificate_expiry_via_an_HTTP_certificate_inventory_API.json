        -192
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "certInventoryApiUrl",
              "type": "string",
              "value": "https://your-cert-inventory.example.com/api/v1"
            },
            {
              "name": "watchDaysThreshold",
              "type": "number",
              "value": 60
            },
            {
              "name": "warningDaysThreshold",
              "type": "number",
              "value": 30
            },
            {
              "name": "criticalDaysThreshold",
              "type": "number",
              "value": 7
            },
            {
              "name": "includeInternalServices",
              "type": "boolean",
              "value": true
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "527dd893-85b0-4227-84a6-e7af6b27c1ac",
      "name": "Fetch Certificate Inventory",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -528,
        -192
      ],
      "parameters": {
        "url": "={{ $json.certInventoryApiUrl }}/certificates?scope=all&includeInternal={{ $json.includeInternalServices }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2,
      "continueOnFail": true
    },
    {
      "id": "47e0a8ca-8c06-4bc9-b354-d06002417a4f",
      "name": "Wait for Inventory Sync",
