      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        -976,
        -272
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
