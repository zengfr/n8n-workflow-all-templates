        "jsCode": "const lead = $input.first().json;\n\nconst msgs = {\n  'NEET Coaching': `Hi ${lead.fullName}! 👋 Thanks for your interest in *NEET Coaching*. Our experts have helped 500+ students crack NEET with top ranks!\\n\\nI'm ${lead.counsellorName} — your personal counsellor. I'll be sharing helpful resources over the next few days. Stay tuned! 📚`,\n  'IIT-JEE':       `Hi ${lead.fullName}! 👋 Thanks for enquiring about *IIT-JEE Prep*. 200+ IIT selections from our institute last year! 🎯\\n\\nI'm ${lead.counsellorName}. Let me send you our course details shortly!`,\n  'CA Foundation': `Hi ${lead.fullName}! 👋 Great to hear from you about *CA Foundation*! Our batch has a 78% first-attempt pass rate 📊\\n\\nI'm ${lead.counsellorName} — here to guide you every step of the way.`,\n  'MBA Entrance':  `Hi ${lead.fullName}! 👋 Interested in *MBA Entrance Prep*? Our students have cracked CAT, XAT & GMAT! 🏆\\n\\nI'm ${lead.counsellorName}, your dedicated counsellor. More details coming soon!`,\n  'CLAT Prep':     `Hi ${lead.fullName}! 👋 Thanks for your interest in *CLAT Prep*. Top NLU selections every year! ⚖️\\n\\nI'm ${lead.counsellorName} — let's get you started on your journey!`\n};\n\nconst waMsg = msgs[lead.courseCategory] || `Hi ${lead.fullName}! 👋 Thanks for reaching out. I'm ${lead.counsellorName}, your counsellor at [Institute Name]. I'll be in touch with details shortly!`;\n\nconst tgMsg = `🎓 *New Lead — Instant Reply Sent*\\n\\n👤 *Name:* ${lead.fullName}\\n📱 *Phone:* ${lead.phone}\\n📚 *Course:* ${lead.courseCategory}\\n🏙️ *City:* ${lead.city}\\n🔥 *AI Score:* ${lead.intentScore}/100\\n🏷️ *Category:* ${lead.aiCategory}\\n📝 *Note:* ${lead.counsellorNote}\\n\\n✅ WhatsApp reply auto-sent within 60 seconds.`;\n\nreturn [{ json: { ...lead, whatsappMessage: waMsg, telegramMessage: tgMsg } }];"
      },
