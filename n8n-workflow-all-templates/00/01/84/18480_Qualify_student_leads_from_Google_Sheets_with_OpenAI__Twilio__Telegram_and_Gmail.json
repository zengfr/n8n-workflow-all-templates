    {
      "id": "65735c2e-6340-4d0d-a88c-a310166f9384",
      "name": "Normalise Lead Data",
      "type": "n8n-nodes-base.code",
      "position": [
        -944,
        848
      ],
      "parameters": {
        "jsCode": "const src = $input.first().json;\nconst leadId = 'LD' + Date.now();\nconst now    = new Date().toISOString();\n\nconst fullName  = src['Full Name']       || src.full_name  || 'Unknown';\nconst phone     = src['Phone']           || src.phone      || '';\nconst email     = src['Email']           || src.email      || '';\nconst course    = src['Course Interest'] || src.course     || 'General Enquiry';\nconst city      = src['City']            || src.city       || '';\nconst source    = src['Source Channel']  || src.source     || 'Google Sheet';\nconst rowNumber = src['__row']           || null;\n\nreturn [{ json: { leadId, fullName, phone, email, course, city, source, leadDate: now, rowNumber } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "e0552b72-0d18-4f83-9d21-00cb2d66077f",
      "name": "AI – Score and Classify Lead Intent",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        -704,
        848
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {
          "temperature": 0.2
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an AI lead-qualification assistant for an education institute. Given lead info, respond ONLY in this exact JSON (no markdown, no extra text):\n{\"intentScore\": 82, \"category\": \"Hot - High Intent\", \"courseCategory\": \"NEET Coaching\", \"note\": \"One-line counsellor tip.\"}\n\nintentScore: 0-100 (0=cold, 100=ready to enrol)\ncategory: one of 'Hot - Ready to Enrol' | 'Hot - High Intent' | 'Warm - Interested' | 'Warm - Exploring' | 'Cold - Just Browsing'\ncourseCategory: one of 'NEET Coaching' | 'IIT-JEE' | 'CA Foundation' | 'MBA Entrance' | 'CLAT Prep' | 'Other'"
            },
            {
              "content": "Name: {{ $json.fullName }}\nPhone: {{ $json.phone }}\nCourse Interest: {{ $json.course }}\nCity: {{ $json.city }}\nSource: {{ $json.source }}"
            }
          ]
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "93084771-a274-4a9c-8012-bea41eb751de",
      "name": "Parse AI Response and Assign Counsellor",
      "type": "n8n-nodes-base.code",
      "position": [
        -368,
        848
      ],
      "parameters": {
        "jsCode": "const lead  = $('Normalise Lead Data').first().json;\nconst aiRaw = $input.first().json.message?.content || '{}';\n\nlet ai = {};\ntry { ai = JSON.parse(aiRaw); } catch(e) { ai = { intentScore: 50, category: 'Warm - Exploring', courseCategory: lead.course, note: '' }; }\n\n// Replace with your actual counsellor names, emails, and Telegram group IDs\nconst counsellors = [\n  { name: 'Counsellor One',   email: 'user@example.com',   telegramId: '-1+1234567890' },\n  { name: 'Counsellor Two',   email: 'user@example.com',   telegramId: '-1+1234567890' },\n  { name: 'Counsellor Three', email: 'user@example.com',   telegramId: '-1+1234567890' }\n];\nconst c = counsellors[Math.floor(Math.random() * counsellors.length)];\n\nreturn [{ json: {\n  ...lead,\n  intentScore:    ai.intentScore    || 50,\n  aiCategory:     ai.category       || 'Warm - Exploring',\n  courseCategory: ai.courseCategory || lead.course,\n  counsellorNote: ai.note           || '',\n  counsellorName:       c.name,\n  counsellorEmail:      c.email,\n  counsellorTelegramId: c.telegramId,\n  stage: 'New Lead'\n}}];"
      },
      "typeVersion": 2
    },
