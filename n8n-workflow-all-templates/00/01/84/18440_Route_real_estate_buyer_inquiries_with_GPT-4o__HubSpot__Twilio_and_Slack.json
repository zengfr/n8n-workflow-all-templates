      "parameters": {
        "text": "🏡 New Lead Assigned — {{ $('Property Inquiry (Webhook)').item.json.body.name }} | Phone: {{ $('Property Inquiry (Webhook)').item.json.body.phone }} | Segment: {{ $('AI Qualify Buyer').item.json.message.content.segment }} | Intent: {{ $('AI Qualify Buyer').item.json.message.content.intent }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#agents",
          "cachedResultName": "#agents"
        },
        "otherOptions": {}
