  "nodes": [
    {
      "id": "81d2b05e-b846-44cf-a679-d94a5c24219e",
      "name": "Documentation Header",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        80,
        2112
      ],
      "parameters": {
        "color": 6,
        "width": 1148,
        "height": 352,
        "content": "## 🏠 Real Estate — AI Property Inquiry Router & Instant Responder\n\nAutomates buyer inquiry qualification, smart agent assignment, AI-drafted SMS responses, and team alerts for incoming real estate leads.\n\n### ⚡ Setup Instructions & Configuration\n1. **Webhook Integration:** Configure listing portals (Zillow, Realtor.com, site webhooks) to POST JSON payloads to `Property Inquiry (Webhook)`.\n2. **Database API:** Update URL & Headers in `Enrich Listing` to query your CMS/database for property details.\n3. **OpenAI Credentials:** Ensure valid OpenAI API credentials are attached to `AI Qualify Buyer`.\n4. **HubSpot & Messaging:** Authenticate HubSpot nodes for lead routing, Twilio for `Instant SMS Reply`, and Slack channel `#agents` for team notifications."
      },
      "typeVersion": 1
    },
    {
      "id": "0951bcb2-b7bc-46e5-a5fe-861d058eb3de",
      "name": "Stage 1: Ingestion & Enrichment",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1456,
        2544
      ],
      "parameters": {
        "color": 4,
        "width": 720,
        "height": 420,
        "content": "### 1. Webhook Ingestion & Property Enrichment\n\n\n\n\n\n\n\n\n\n\n\n\n\n**Purpose:** Receives incoming buyer lead (name, email, phone, budget, listing ID) and queries property CMS to enrich lead with actual listing price, neighborhood, & agent status."
      },
      "typeVersion": 1
    },
    {
      "id": "b1e5b4d5-78ed-4023-ab83-5cc4b3ac37b5",
      "name": "Stage 2: AI Qualification",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2240,
        2544
      ],
      "parameters": {
        "color": 3,
        "width": 460,
        "height": 420,
        "content": "### 2. AI Lead Qualification & Intent Extraction\n\n\n\n\n\n\n\n\n\n\n\n\n\n**Purpose:** GPT-4o analyzes buyer budget vs listing price, qualifies buyer intent (Hot/Warm/Cold), determines segment (`luxury`, `rental`, `standard`), and drafts an instant personalized SMS."
      },
      "typeVersion": 1
    },
    {
      "id": "45bffdf2-1355-4e35-a720-360b7ac82b19",
      "name": "Stage 3: Segment Routing",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2768,
        2448
      ],
      "parameters": {
        "color": 2,
        "width": 800,
        "height": 620,
        "content": "### 3. Segment Routing & CRM Upsert\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n**Purpose:** Directs luxury buyers to senior agents, rental leads to leasing, and standard buyers to the general pool in HubSpot CRM."
      },
      "typeVersion": 1
    },
    {
      "id": "65ae1655-ac3d-46d5-bb0b-d06d7c1772db",
      "name": "Stage 4: Outreach & Notification",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        3616,
        2544
      ],
      "parameters": {
        "color": 5,
        "width": 700,
        "height": 420,
        "content": "### 4. Speed-to-Lead SMS & Agent Notification\n\n\n\n\n\n\n\n\n\n\n\n\n\n**Purpose:** Sends AI-drafted reply to buyer via Twilio SMS in seconds and posts lead summary to `#agents` Slack channel for immediate human follow-up."
      },
      "typeVersion": 1
    },
    {
      "id": "e0dc9a3a-a54e-496d-b731-7fd80df70919",
      "name": "Property Inquiry (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "position": [
        1520,
        2688
      ],
      "webhookId": "fd0813c4-ba56-4248-88dd-90b7ddf85ed0",
      "parameters": {
        "path": "property-inquiry",
        "options": {},
        "httpMethod": "POST"
      },
      "typeVersion": 2
    },
    {
      "id": "b30716ce-7e77-4087-a079-5cbcd20f264c",
      "name": "Enrich Listing Details",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1840,
        2688
      ],
      "parameters": {
        "url": "=https://api.yourcms.com/properties/{{ $json.body.listing_id }}",
        "options": {}
      },
      "typeVersion": 4.2
    },
    {
      "id": "1658be6b-a6cb-4216-a421-5f5b17d7aa69",
      "name": "AI Qualify Buyer",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        2304,
        2688
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o",
          "cachedResultName": "GPT-4O"
        },
        "options": {
          "temperature": 0.2
        },
        "messages": {
          "values": [
            {
              "content": "Evaluate buyer lead. Inquiry: {{ JSON.stringify($json.body) }}. Listing details: {{ JSON.stringify($json.listing) }}. Classify segment as 'luxury' (price > $1M), 'rental', or 'standard'. Qualify intent as 'hot', 'warm', or 'cold'. Return JSON: {\"segment\":\"luxury|rental|standard\",\"intent\":\"hot|warm|cold\",\"sms_reply\":\"short personalized text message\"}"
            }
          ]
        },
        "jsonOutput": true
      },
      "credentials": {
        "openAiApi": {
          "id": "credential-id",
          "name": "n8n free OpenAI API credits"
        }
      },
      "typeVersion": 1.8
    },
    {
