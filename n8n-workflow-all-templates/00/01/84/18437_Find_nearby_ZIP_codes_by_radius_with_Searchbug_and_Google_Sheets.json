    {
      "id": "8880289d-c2fa-4150-8fc9-5891a0c7f77e",
      "name": "Radius Market Summary",
      "type": "n8n-nodes-base.code",
      "position": [
        3312,
        384
      ],
      "parameters": {
        "jsCode": "function round(value, places) {\n  const f = Math.pow(10, places);\n  return Math.round(value * f) / f;\n}\n\nconst groups = {};\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (!j.zip || j.city === 'NORESULTS') continue;\n\n  const key = String(j.center_zip || '');\n  if (!groups[key]) {\n    groups[key] = {\n      center_zip: key,\n      requested_distance_mi: j.requested_distance_mi || 0,\n      zips: {},\n      cities: {},\n      states: {},\n      total_population: 0,\n      total_businesses: 0,\n      total_employees: 0,\n      distance_sum: 0,\n      max_distance_mi: 0,\n      largest_city: '',\n      largest_city_pop: -1,\n      nearest_city: '',\n      nearest_city_dist: Infinity,\n    };\n  }\n\n  const g = groups[key];\n  const dist = Number(j.distance_mi) || 0;\n  const pop = Number(j.population) || 0;\n  const label = [j.city, j.state].filter(Boolean).join(', ');\n\n  g.zips[j.zip] = true;\n  if (j.city) g.cities[label] = true;\n  if (j.state) g.states[j.state] = true;\n\n  g.total_population += pop;\n  g.total_businesses += Number(j.businesses) || 0;\n  g.total_employees += Number(j.employees) || 0;\n  g.distance_sum += dist;\n  if (dist > g.max_distance_mi) g.max_distance_mi = dist;\n\n  if (pop > g.largest_city_pop) {\n    g.largest_city_pop = pop;\n    g.largest_city = label;\n  }\n  if (j.is_center !== 'Yes' && dist < g.nearest_city_dist) {\n    g.nearest_city_dist = dist;\n    g.nearest_city = label;\n  }\n}\n\nconst summaryDate = new Date().toISOString().slice(0, 10);\nconst out = [];\n\nfor (const key of Object.keys(groups)) {\n  const g = groups[key];\n  const zipCount = Object.keys(g.zips).length;\n  const perThousand =\n    g.total_population > 0\n      ? round((g.total_businesses / g.total_population) * 1000, 1)\n      : 0;\n\n  let tier = 'LOW';\n  if (g.total_population >= 250000 && g.total_businesses >= 10000) tier = 'HIGH';\n  else if (g.total_population >= 50000) tier = 'MEDIUM';\n\n  out.push({\n    json: {\n      center_zip: g.center_zip,\n      requested_distance_mi: g.requested_distance_mi,\n      zip_count: zipCount,\n      city_count: Object.keys(g.cities).length,\n      states_covered: Object.keys(g.states).sort().join(', '),\n      total_population: g.total_population,\n      total_businesses: g.total_businesses,\n      total_employees: g.total_employees,\n      avg_distance_mi: zipCount > 0 ? round(g.distance_sum / zipCount, 2) : 0,\n      max_distance_mi: round(g.max_distance_mi, 2),\n      largest_city: g.largest_city,\n      nearest_city: g.nearest_city,\n      businesses_per_1k: perThousand,\n      market_tier: tier,\n      summary_date: summaryDate,\n    },\n  });\n}\n\nreturn out;"
      },
      "typeVersion": 2
    },
