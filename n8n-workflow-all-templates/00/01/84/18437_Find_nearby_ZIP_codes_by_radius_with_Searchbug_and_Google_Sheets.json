    {
      "id": "d8c6c489-a432-48fa-9f7f-902d9e206e6e",
      "name": "Flatten & Rank ZIPs",
      "type": "n8n-nodes-base.code",
      "position": [
        3056,
        80
      ],
      "parameters": {
        "jsCode": "function toArray(value) {\n  if (value === null || value === undefined) return [];\n  return Array.isArray(value) ? value : [value];\n}\n\nfunction safe(value) {\n  return value === null || value === undefined ? '' : String(value).trim();\n}\n\nfunction num(value) {\n  const n = Number(safe(value).replace(/[^0-9.-]/g, ''));\n  return isNaN(n) ? 0 : n;\n}\n\nfunction band(miles) {\n  if (miles <= 5) return '0-5 mi';\n  if (miles <= 10) return '5-10 mi';\n  if (miles <= 25) return '10-25 mi';\n  if (miles <= 50) return '25-50 mi';\n  return '50+ mi';\n}\n\nfunction round(value, places) {\n  const f = Math.pow(10, places);\n  return Math.round(value * f) / f;\n}\n\nconst searchedAt = new Date().toISOString().slice(0, 10);\nconst out = [];\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const j = items[i].json;\n  const centerZip = safe(j.center_zip);\n  const requested = num(j.requested_distance);\n  const minPop = num(j.min_population);\n\n  const rows = toArray(j.results)\n    .map((r) => {\n      const zip = safe(r.Zip);\n      const pop = num(r.Population);\n      const biz = num(r.NumberOfBusinesses);\n      const emp = num(r.NumberOfEmployees);\n      const dist = num(r.Dist);\n      return {\n        center_zip: centerZip,\n        requested_distance_mi: requested,\n        rank: 0,\n        zip: zip,\n        city: safe(r.City),\n        state: safe(r.State),\n        distance_mi: round(dist, 2),\n        radius_band: band(dist),\n        population: pop,\n        businesses: biz,\n        employees: emp,\n        businesses_per_1k: pop > 0 ? round((biz / pop) * 1000, 1) : 0,\n        employees_per_business: biz > 0 ? round(emp / biz, 1) : 0,\n        is_center: zip === centerZip ? 'Yes' : 'No',\n        searched_at: searchedAt,\n      };\n    })\n    .filter((r) => r.zip !== '' && r.population >= minPop)\n    .sort((a, b) => a.distance_mi - b.distance_mi);\n\n  if (rows.length === 0) {\n    out.push({\n      json: {\n        center_zip: centerZip,\n        requested_distance_mi: requested,\n        rank: 0,\n        zip: '',\n        city: 'NORESULTS',\n        state: '',\n        distance_mi: 0,\n        radius_band: '',\n        population: 0,\n        businesses: 0,\n        employees: 0,\n        businesses_per_1k: 0,\n        employees_per_business: 0,\n        is_center: 'No',\n        searched_at: searchedAt,\n      },\n      pairedItem: { item: i },\n    });\n    continue;\n  }\n\n  for (let r = 0; r < rows.length; r++) {\n    rows[r].rank = r + 1;\n    out.push({ json: rows[r], pairedItem: { item: i } });\n  }\n}\n\nreturn out;"
      },
      "typeVersion": 2
    },
