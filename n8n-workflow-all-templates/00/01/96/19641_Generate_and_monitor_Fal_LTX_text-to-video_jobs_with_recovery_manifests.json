      "parameters": {
        "jsCode": "const x=$input.first().json;\nif(!['demo','live','resume'].includes(x.mode))throw Error('mode must be demo, live or resume');\nconst maxPolls=Number(x.maxPolls),pollSeconds=Number(x.pollSeconds);\nif(!Number.isInteger(maxPolls)||maxPolls<1||maxPolls>120)throw Error('maxPolls must be 1–120');\nif(!Number.isInteger(pollSeconds)||pollSeconds<5||pollSeconds>120)throw Error('pollSeconds must be 5–120');\nif(!String(x.prompt||'').trim()||x.prompt.length>5000)throw Error('Provide a prompt of 1–5000 characters');\nif(!['success','provider_error','timeout','transient'].includes(x.demoScenario))throw Error('Unknown demoScenario');\nif(x.mode==='live'&&x.allowPaidGeneration!==true)throw Error('Live submission requires allowPaidGeneration=true after checking Fal pricing');\nconst safeUrl=(s,id)=>{const m=String(s).match(/^https:\\/\\/queue\\.fal\\.run(\\/[^?#]*)$/);if(!m||!m[1].startsWith('/fal-ai/ltx-2-19b/requests/'+id))throw Error('Resume URLs must be HTTPS queue.fal.run LTX request URLs');return s;};\nif(x.mode==='resume'){if(!/^[a-zA-Z0-9-]{8,100}$/.test(x.resumeRequestId))throw Error('Missing valid resumeRequestId');safeUrl(x.resumeStatusUrl,x.resumeRequestId);safeUrl(x.resumeResponseUrl,x.resumeRequestId);}\nreturn [{json:{...x,prompt:x.prompt.trim(),maxPolls,pollSeconds,startedAt:new Date().toISOString(),pollCount:0}}];"
      },
