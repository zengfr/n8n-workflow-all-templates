      "parameters": {
        "jsCode": "const c=$('Validate configuration').first().json,r=$input.first().json,b=r.body||{};\nconst base={...c,pollCount:0,history:[],requestId:b.request_id||null,statusUrl:null,responseUrl:null};\nif(r.error||r.statusCode<200||r.statusCode>=300||!b.request_id)return [{json:{...base,outcome:'submission_unconfirmed',detail:'Submission did not produce a trustworthy receipt. Do not auto-resubmit: check Fal dashboard first; the job may have been accepted.',httpStatus:r.statusCode||null}}];\nconst id=String(b.request_id);const safe=s=>typeof s==='string'&&/^https:\\/\\/queue\\.fal\\.run\\//.test(s)&&!/[?#]/.test(s)&&s.startsWith('https://queue.fal.run/fal-ai/ltx-2-19b/requests/'+id);\nif(!/^[a-zA-Z0-9-]{8,100}$/.test(id)||!safe(b.status_url)||!safe(b.response_url))return [{json:{...base,outcome:'invalid_receipt',detail:'Refused unexpected provider URLs; inspect Fal dashboard without resubmitting.'}}];\nreturn [{json:{...base,requestId:id,statusUrl:b.status_url,responseUrl:b.response_url,outcome:'pending'}}];"
