      "parameters": {
        "jsCode": "const j=$input.first().json;\nconst manifest={workflow:'LTX video queue with recovery',mode:j.mode,outcome:j.outcome,detail:j.detail,requestId:j.requestId,pollCount:j.pollCount||0,startedAt:j.startedAt,finishedAt:new Date().toISOString(),videoUrl:j.videoUrl||null,providerUrls:{status:j.statusUrl||null,response:j.responseUrl||null},history:j.history||[],resumeInstructions:'Set mode=resume, copy requestId/status/response into resume fields, and rerun. Resume never submits a new generation. Do not retry an unconfirmed POST without checking your Fal dashboard.',demo:j.mode==='demo'};\nconst data=await this.helpers.prepareBinaryData(Buffer.from(JSON.stringify(manifest,null,2),'utf8'),'video-job-'+(j.requestId||'unconfirmed')+'.json','application/json');return [{json:manifest,binary:{data}}];"
      },
