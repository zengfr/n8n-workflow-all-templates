      "position": [
        3460,
        -80
      ],
      "parameters": {
        "jsCode": "const j=$('Evaluate queue state').item.json,r=$input.first().json,b=r.body||{},v=b.video||{};\nconst url=String(v.url||'');const valid=/^https:\\/\\/(?:[a-zA-Z0-9-]+\\.)*fal\\.media\\//.test(url);\nif(r.error||r.statusCode<200||r.statusCode>=300||b.error||!valid)return [{json:{...j,outcome:'result_unavailable',detail:'Result could not be verified. Keep request URLs and resume; do not create a new generation.',httpStatus:r.statusCode||null}}];\nreturn [{json:{...j,outcome:j.mode==='demo'?'demo_completed':'completed',detail:j.mode==='demo'?'Fixture only: this URL is a placeholder, no video was generated.':'Result URL retrieved. Download before provider retention expires and review output before publishing.',videoUrl:url,contentType:v.content_type||null,seed:b.seed??null}}];"
