      ],
      "parameters": {
        "jsCode": "const j=$('Wait between polls').item.json,r=$input.first().json,b=r.body||{},n=j.pollCount+1;\nconst transient=!!r.error||r.statusCode===429||r.statusCode>=500;\nlet outcome='pending',detail='Waiting for provider';\nif(!transient){if(r.statusCode<200||r.statusCode>=300){outcome='failed';detail='Queue check returned HTTP '+r.statusCode;}else if(b.request_id&&b.request_id!==j.requestId){outcome='failed';detail='Request ID mismatch';}else if(b.error||b.error_type){outcome='failed';detail='Provider reported: '+String(b.error||b.error_type).slice(0,500);}else if(b.status==='COMPLETED'){outcome='ready';detail='Fetch result';}else if(!['IN_QUEUE','IN_PROGRESS'].includes(b.status)){outcome='failed';detail='Unknown provider status';}}\nif(outcome==='pending'&&n>=j.maxPolls){outcome='timed_out';detail='Stopped local polling. Provider job may still run and charge. Resume using saved request URLs; do not submit it again.';}\nreturn [{json:{...j,pollCount:n,outcome,detail,history:[...j.history,{poll:n,httpStatus:r.statusCode||null,status:b.status||'transport_error',at:new Date().toISOString()}].slice(-120)}}];"
