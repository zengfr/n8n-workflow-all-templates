    {
      "id": "6c4d6eed-eada-42e6-9318-a2c5a5e031f1",
      "name": "Health Check",
      "type": "n8n-nodes-base.code",
      "position": [
        2288,
        496
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json.body;\n\nconst statusOk = $input.first().json.statusCode === 200;\nconst responseTimeOk =  $input.first().json.responseTime< 5000;\n\nconst bodyValid =!!(\n  response.id &&\n  response.userId &&\n  response.title &&\n  response.body\n);\n\nconst apiName = $('Loop Over Items').first().json.name\n\nconst healthy =\n  $input.first().json.statusCode === 200 &&\n   $input.first().json.responseTime < 5000 &&\n  !!response.body;\n\nreturn [{\n  json: {\n    ...$json,\n    statusOk,\n    responseTimeOk,\n    bodyValid,\n    API: apiName,\n    Time: new Date().toLocaleString(),\n    Status: $input.first().json.statusCode,\n    \"Response Time\": `${$input.first().json.responseTime} ms`,\n    Result: healthy ? \"Healthy\" : \"Unhealthy\",\n    healthy: healthy\n  }\n}];"
      },
      "typeVersion": 2
    },
