    {
      "id": "9285b116-b998-42fe-961d-0209bbac4677",
      "name": "Create Alert Object",
      "type": "n8n-nodes-base.code",
      "position": [
        2864,
        864
      ],
      "parameters": {
        "jsCode": "const reason =\n  $('Health Check').first().json.statusCode !== 200\n    ? `HTTP $('Health Check').first().json.statusCode ${$('Health Check').first().json.statusMessage || ''}`\n    : $('Health Check').first().json.responseTime >= 5000\n      ? `Response time exceeded threshold (${ $('Health Check').first().json.responseTime } ms)`\n      : !$('Health Check').first().json.bodyValid\n        ? \"Invalid response body\"\n        : \"Unknown error\";\n\nreturn [{\n  json: {\n    alert: {\n      api: $('Health Check').first().json.API,\n      status: $('Health Check').first().json.Status,\n      responseTime: $('Health Check').first().json.responseTime,\n      reason,\n      timestamp: new Date().toISOString(),\n      url: $('Loop Over Items').first().json.url\n    }\n  }\n}];"
      },
      "typeVersion": 2
    },
