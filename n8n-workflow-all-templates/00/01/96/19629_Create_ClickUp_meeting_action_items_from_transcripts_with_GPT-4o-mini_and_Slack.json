        "additionalFields": {
          "content": "=Owner: {{$json.owner}}\nPriority: {{$json.priority}}\nFrom meeting: {{$json.meetingTitle}}",
          "dueDate": "={{ $json.deadline ? new Date($json.deadline).getTime() : undefined }}",
          "priority": "={{ $json.priority === 'High' ? 2 : ($json.priority === 'Low' ? 4 : 3) }}"
        }
      },
      "credentials": {
