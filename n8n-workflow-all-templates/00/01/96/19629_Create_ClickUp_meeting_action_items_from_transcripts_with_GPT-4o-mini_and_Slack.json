        "jsCode": "const msg = $json.message;\nreturn [{\n  json: {\n    transcriptText: msg.text || '',\n    meetingTitle: 'Meeting via Telegram - ' + new Date().toISOString().slice(0, 10),\n    source: 'Telegram',\n    telegramChatId: msg.chat.id\n  }\n}];"
