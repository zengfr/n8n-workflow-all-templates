    {
      "id": "672458df-3c20-4f47-b59e-b2a20fa41fe4",
      "name": "Detect Meeting Type",
      "type": "n8n-nodes-base.code",
      "position": [
        4416,
        5424
      ],
      "parameters": {
        "jsCode": "\nconst text = ($('Validate Transcript Length').item.json.transcriptText || '').toLowerCase();\nlet meetingType = 'General Meeting';\nif (text.includes('sprint') || text.includes('planning') || text.includes('roadmap')) {\n  meetingType = 'Planning Meeting';\n} else if (text.includes('retrospective') || text.includes('retro') || text.includes('went well')) {\n  meetingType = 'Retrospective';\n} else if (text.includes('standup') || text.includes('stand-up') || text.includes('yesterday i')) {\n  meetingType = 'Standup';\n} else if (text.includes('review') || text.includes('demo') || text.includes('presentation')) {\n  meetingType = 'Review/Demo';\n}\nreturn [{ json: { ...items[0].json, meetingType } }];\n"
      },
      "typeVersion": 2
    },
