    {
      "id": "7b858166-819c-4a71-8396-a76c20ba3b15",
      "name": "Normalize Drive Transcript1",
      "type": "n8n-nodes-base.code",
      "position": [
        1984,
        5744
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binaryKeys = Object.keys(item.binary || {});\nconst key = binaryKeys[0];\nconst bin = item.binary[key];\nconst text = Buffer.from(bin.data, 'base64').toString('utf8');\n\nreturn [{\n  json: {\n    transcriptText: text,\n    meetingTitle: item.json.name || bin.fileName || 'Meeting Transcript',\n    source: 'Google Drive',\n    telegramChatId: ''\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "bcddcf17-ffea-47e9-9e61-82150d52ef82",
      "name": "Parse Action Items JSON1",
      "type": "n8n-nodes-base.code",
      "position": [
        3408,
        5424
      ],
      "parameters": {
        "jsCode": "let meta = {};\ntry { meta = $('Normalize Telegram Transcript1').item.json; } catch (e) {}\nif (!meta || !meta.source) {\n  try { meta = $('Normalize Drive Transcript1').item.json; } catch (e) {}\n}\n\nconst resp = items[0].json;\nlet parsed;\ntry {\n  const raw = resp.message?.content ?? resp.content ?? resp.text ?? '';\n  const cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { summary: 'Could not parse transcript', actionItems: [] };\n}\n\nreturn [{\n  json: {\n    meetingTitle: meta.meetingTitle || 'Untitled Meeting',\n    summary: parsed.summary || '',\n    actionItems: Array.isArray(parsed.actionItems) ? parsed.actionItems : [],\n    source: meta.source || 'Unknown',\n    telegramChatId: meta.telegramChatId || ''\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "c7a29d6c-e748-41bc-bb53-c30d62da6d13",
      "name": "Split Action Items1",
      "type": "n8n-nodes-base.code",
      "position": [
        3648,
        5424
      ],
      "parameters": {
        "jsCode": "const data = items[0].json;\nconst meetingTitle = data.meetingTitle;\nconst summary = data.summary;\nconst source = data.source;\nconst telegramChatId = data.telegramChatId;\n\nreturn (data.actionItems || []).map(a => ({\n  json: {\n    owner: a.owner || 'Unassigned',\n    task: a.task || 'Untitled task',\n    deadline: a.deadline || '',\n    priority: a.priority || 'Normal',\n    meetingTitle,\n    summary,\n    source,\n    telegramChatId\n  }\n}));"
      },
      "typeVersion": 2
    },
    {
      "id": "ef3b5e81-c283-4bc7-950c-154006f1dce8",
      "name": "ClickUp - Create Task1",
      "type": "n8n-nodes-base.clickUp",
      "position": [
