      "name": "Validate Transcript Length",
      "type": "n8n-nodes-base.code",
      "position": [
        2240,
        5440
      ],
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nreturn items.map(item => {\n  const text = item.json.transcriptText || '';\n  const wordCount = text.split(/\\s+/).filter(Boolean).length;\n  return {\n    json: {\n      ...item.json,\n      wordCount,\n      isLongEnough: wordCount >= 20,\n    }\n  };\n});\n"
      },
      "typeVersion": 2
    },
