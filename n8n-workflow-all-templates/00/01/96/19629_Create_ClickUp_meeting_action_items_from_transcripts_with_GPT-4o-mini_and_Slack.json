        }
      },
      "typeVersion": 1
    },
    {
      "id": "b10017c9-c57c-41b0-b23e-1fe05613cf36",
      "name": "Aggregate Created Tasks1",
      "type": "n8n-nodes-base.aggregate",
      "position": [
        4096,
        5424
      ],
