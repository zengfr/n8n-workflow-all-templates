    {
      "id": "17ef0ff7-a122-4d12-a06e-0cfeabb4eb4a",
      "name": "Build Slack Summary1",
      "type": "n8n-nodes-base.code",
      "position": [
        4944,
        5408
      ],
      "parameters": {
        "jsCode": "const originals = $('Split Action Items1').all().map(i => i.json);\nconst meetingTitle = originals[0]?.meetingTitle || 'Meeting';\nconst summary = originals[0]?.summary || '';\nconst telegramChatId = originals[0]?.telegramChatId || '';\n\nconst lines = originals.map((t, i) => `${i + 1}. *${t.task}* — Owner: ${t.owner}${t.deadline ? `, Due: ${t.deadline}` : ''} (${t.priority})`);\n\nreturn [{\n  json: {\n    slackText: `📝 *Action Items from: ${meetingTitle}*\\n\\n${summary}\\n\\n*Tasks created (${originals.length}):*\\n${lines.join('\\n')}`,\n    telegramChatId\n  }\n}];"
      },
      "typeVersion": 2
    },
