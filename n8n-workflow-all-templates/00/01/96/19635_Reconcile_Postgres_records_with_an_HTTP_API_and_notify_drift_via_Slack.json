    {
      "id": "d7c37cd0-ba04-5cc8-8a32-b4ee9380d304",
      "name": "Explain Which Fields Differ",
      "type": "n8n-nodes-base.code",
      "position": [
        2240,
        560
      ],
      "parameters": {
        "jsCode": "// One row that exists on both sides but does not agree. compareDatasets with resolve\n// \"includeBoth\" hands us {keys, same, different:{field:{input1, input2}}}, so the field names are\n// already known and nothing has to be guessed.\nconst policy = $('Drift Rules').first().json;\nconst out = [];\n\nconst listOf = (v) => String(v || '').split(',').map(x => x.trim().toLowerCase()).filter(Boolean);\n// Fields the two systems always disagree about. Dropped BEFORE anything is counted, or every\n// record drifts forever on a timestamp and the report is ignored within a week.\nconst ignored = listOf(policy.ignore_fields);\n// When compare_fields is set, everything outside it is ignored. This is what stops a column\n// the other system simply does not return from looking like drift on every single record.\nconst onlyCompare = listOf(policy.compare_fields);\n// Fields where a disagreement is an incident. These decide escalation.\nconst critical = listOf(policy.critical_fields);\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const diff = (j.different && typeof j.different === 'object') ? j.different : {};\n  const keys = (j.keys && typeof j.keys === 'object') ? j.keys : {};\n  const allFields = Object.keys(diff);\n  const suppressed = allFields.filter(f => ignored.includes(f.toLowerCase()));\n  const fields = allFields.filter(f => !ignored.includes(f.toLowerCase())\n    && (!onlyCompare.length || onlyCompare.includes(f.toLowerCase())));\n  // A record whose ONLY differences were ignored fields has not drifted in any way that matters.\n  if (!fields.length) continue;\n\n  const changes = fields.map(function (f) {\n    const pair = diff[f] || {};\n    const a = pair.input1 === undefined ? null : pair.input1;\n    const b = pair.input2 === undefined ? null : pair.input2;\n    return { field: f, database_value: a, api_value: b };\n  });\n\n  const criticalHit = fields.filter(f => critical.includes(f.toLowerCase()));\n\n  out.push({ json: {\n    // every key on every branch, so all three drift kinds have the same shape (error A21)\n    record_key: Object.values(keys).join(' / ') || '(no key)',\n    drift_kind: 'fields_disagree',\n    drifted_fields: fields.length,\n    field_names: fields.join(', '),\n    changes: changes.slice(0, Number(policy.max_fields_per_record) || 10),\n    // the triage decision, and the evidence for it\n    is_critical: criticalHit.length > 0,\n    critical_fields_hit: criticalHit.join(', ') || null,\n    suppressed_fields: suppressed.join(', ') || null,\n    database_only: null,\n    api_only: null,\n  } });\n}\nreturn out;\n"
      },
      "typeVersion": 2,
      "alwaysOutputData": true
    },
