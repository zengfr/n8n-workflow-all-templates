    {
      "id": "4a8827db-2b9f-5fea-b56f-120ed11eda4a",
      "name": "Summarise The Drift",
      "type": "n8n-nodes-base.code",
      "position": [
        4528,
        320
      ],
      "parameters": {
        "jsCode": "// What drifted, across all three kinds. Reads the merged stream, not the individual branches, so\n// this runs exactly once per reconciliation.\nconst policy = $('Drift Rules').first().json;\nconst maxRows = Number(policy.max_rows_in_report) || 20;\n\n// An empty item is what alwaysOutputData emits for a branch that matched nothing. It is not drift.\nconst rows = $input.all().map(i => i.json).filter(r => r && r.drift_kind);\n\n// Records the two systems agree on arrive here too, labelled no_drift. They are never counted as\n// drift, but they ARE counted, so the all-clear can say how much was actually checked.\nconst agreed = rows.filter(r => r.drift_kind === 'no_drift');\n\nconst byKind = { fields_disagree: [], missing_in_api: [], missing_in_database: [] };\nfor (const r of rows) if (byKind[r.drift_kind]) byKind[r.drift_kind].push(r);\n\n// The two \"missing\" kinds are reportable only if the user asked for them. A record that has not\n// synced yet is normal in some setups and an incident in others.\nconst wantApiOnly = policy.report_when_only_in_api === true || String(policy.report_when_only_in_api) === 'true';\nconst wantDbOnly = policy.report_when_only_in_database === true || String(policy.report_when_only_in_database) === 'true';\n\nconst reported = byKind.fields_disagree\n  .concat(wantApiOnly ? byKind.missing_in_api : [])\n  .concat(wantDbOnly ? byKind.missing_in_database : []);\n\nconst lines = [];\nfor (const r of reported.slice(0, maxRows)) {\n  if (r.drift_kind === 'fields_disagree') {\n    lines.push('- ' + r.record_key + ': ' + r.drifted_fields + ' field(s) differ (' + r.field_names + ')');\n  } else if (r.drift_kind === 'missing_in_api') {\n    lines.push('- ' + r.record_key + ': in the database, not in the API');\n  } else {\n    lines.push('- ' + r.record_key + ': in the API, not in the database');\n  }\n}\n\nconst criticalRows = reported.filter(r => r.is_critical === true);\n\nreturn [{ json: {\n  drifted_records: reported.length,\n  critical_records: criticalRows.length,\n  minor_records: reported.length - criticalRows.length,\n  fields_disagree_count: byKind.fields_disagree.length,\n  missing_in_api_count: byKind.missing_in_api.length,\n  missing_in_database_count: byKind.missing_in_database.length,\n  suppressed_count: (wantApiOnly ? 0 : byKind.missing_in_api.length)\n                  + (wantDbOnly ? 0 : byKind.missing_in_database.length),\n  records_in_agreement: agreed.length,\n  records_compared: agreed.length + reported.length,\n  anything_drifted: reported.length > 0,\n  report_text: reported.length\n    ? reported.length + ' record(s) disagree between the two systems:\\n' + lines.join('\\n')\n      + (reported.length > maxRows ? '\\n...and ' + (reported.length - maxRows) + ' more.' : '')\n    : 'Both systems agree on all ' + agreed.length + ' record(s) compared.',\n} }];\n"
      },
      "typeVersion": 2
    },
