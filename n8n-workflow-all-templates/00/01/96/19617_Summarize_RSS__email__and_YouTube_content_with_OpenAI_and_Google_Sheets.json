      "position": [
        -2400,
        4240
      ],
      "parameters": {
        "jsCode": "const text = $json.message.text.trim();\nlet videoId = '';\nconst patterns = [\n  /(?:youtube\\.com\\/watch\\?v=)([\\w-]{11})/,\n  /(?:youtu\\.be\\/)([\\w-]{11})/,\n  /(?:youtube\\.com\\/shorts\\/)([\\w-]{11})/\n];\nfor (const p of patterns) {\n  const m = text.match(p);\n  if (m) { videoId = m[1]; break; }\n}\nreturn [{ json: { videoId, url: text, chatId: $json.message.chat.id } }];"
      },
      "typeVersion": 2
    },
