        "jsCode": "const aiItems = items;\nconst originalItems = $('Check Duplicate1').all();\n\nreturn aiItems.map((item, i) => {\n  const original = originalItems[i]?.json || {};\n  let parsed;\n  try {\n    const raw = item.json.message?.content ?? item.json.content ?? item.json.text ?? '';\n    const cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    parsed = { relevant: true, reason: 'Could not parse relevance check - defaulting to include' };\n  }\n  return {\n    json: {\n      ...original,\n      relevant: parsed.relevant !== false,\n      relevance_reason: parsed.reason || ''\n    }\n  };\n});"
      },
