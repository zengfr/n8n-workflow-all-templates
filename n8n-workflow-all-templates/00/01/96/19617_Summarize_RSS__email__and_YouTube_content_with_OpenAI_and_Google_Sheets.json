    {
      "id": "fe244b90-b48d-403a-a00e-0dbe4a0d908f",
      "name": "Parse Category & Priority",
      "type": "n8n-nodes-base.code",
      "position": [
        768,
        3664
      ],
      "parameters": {
        "jsCode": "const aiItems = items;\nconst originalItems = $('Parse Relevance1').all();\n\nreturn aiItems.map((item, i) => {\n  const original = originalItems[i]?.json || {};\n  let parsed;\n  try {\n    const raw = item.json.message?.content ?? item.json.content ?? item.json.text ?? '';\n    const cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    parsed = { category: 'Other', priority: 5 };\n  }\n  return {\n    json: {\n      ...original,\n      category: parsed.category || 'Other',\n      priority: typeof parsed.priority === 'number' ? parsed.priority : 5\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "bca8430c-8dd3-4aa6-9767-593cc6e6efab",
      "name": "Find Related Entries",
      "type": "n8n-nodes-base.code",
      "position": [
        1792,
        3776
      ],
      "parameters": {
        "jsCode": "const existing = $('Get Existing Links1').all() || [];\nconst currentTags = ($json.tags || '').split(',').map(t => t.trim().toLowerCase()).filter(Boolean);\n\nconst related = existing\n  .filter(i => {\n    const rowTags = (i.json.Tags || i.json.tags || '').toString().toLowerCase();\n    return currentTags.some(t => t && rowTags.includes(t));\n  })\n  .slice(0, 3)\n  .map(i => i.json.Title || i.json.title)\n  .filter(Boolean);\n\nreturn [{ json: { ...$json, related_items: related.join(' | ') } }];"
      },
      "typeVersion": 2
    },
