    {
      "id": "2d130b2f-ce73-479e-ae25-b0ad25e73597",
      "name": "Parse AI Summary Response",
      "type": "n8n-nodes-base.code",
      "position": [
        1568,
        3776
      ],
      "parameters": {
        "jsCode": "const aiItems = items; // output of AI Summarize\nconst originalItems = $('Parse Category & Priority').all();\n\nreturn aiItems.map((item, i) => {\n  const original = originalItems[i]?.json || {};\n  let parsed;\n  try {\n    const raw = item.json.message?.content ?? item.json.content ?? item.json.text ?? '';\n    const cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    parsed = {\n      summary: item.json.message?.content || item.json.content || 'Could not parse summary',\n      key_points: [],\n      tags: []\n    };\n  }\n  return {\n    json: {\n      title: original.title,\n      source: original.source,\n      link: original.link,\n      date: original.date,\n      category: original.category || 'Other',\n      priority: original.priority ?? 5,\n      summary: parsed.summary,\n      key_points: Array.isArray(parsed.key_points) ? parsed.key_points.join(' | ') : '',\n      tags: Array.isArray(parsed.tags) ? parsed.tags.join(', ') : ''\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
