    {
      "id": "d7909802-8a19-468b-b1c2-3ac420e9f774",
      "name": "Normalize Email Item",
      "type": "n8n-nodes-base.code",
      "position": [
        -1072,
        3840
      ],
      "parameters": {
        "jsCode": "function stripHtml(html) {\n  if (!html) return '';\n  return html\n    .replace(/<style[^>]*>.*?<\\/style>/gs, '')\n    .replace(/<script[^>]*>.*?<\\/script>/gs, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nreturn items.map(item => {\n  const d = item.json;\n  const bodyHtml = d.html || d.textHtml || '';\n  const bodyText = d.text || d.textPlain || stripHtml(bodyHtml);\n  return {\n    json: {\n      source: 'Email Newsletter',\n      title: d.subject || 'No Subject',\n      content: bodyText.slice(0, 6000),\n      link: d.id ? `https://mail.google.com/mail/u/0/#inbox/${d.id}` : '',\n      date: d.date || new Date().toISOString()\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
