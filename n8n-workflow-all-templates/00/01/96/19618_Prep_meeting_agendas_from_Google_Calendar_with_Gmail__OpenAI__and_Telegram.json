    {
      "id": "a7a56f80-2a92-4a09-9ca1-10bfbb12a1f2",
      "name": "Build Meeting Context",
      "type": "n8n-nodes-base.code",
      "position": [
        -1648,
        2944
      ],
      "parameters": {
        "jsCode": "const meeting = $('Loop Over Items').item.json;\nconst emails = items.filter(e => e.json && e.json.id);\n\nconst emailContext = emails.length\n  ? emails.map((e, i) => `${i + 1}. From: ${e.json.from || 'Unknown'} - \"${e.json.subject || 'No subject'}\" (${e.json.date || ''})\\n${(e.json.snippet || '').slice(0, 200)}`).join('\\n\\n')\n  : 'No recent related emails found.';\n\nconst promptText = `Meeting: ${meeting.title}\\nWhen: ${meeting.start} to ${meeting.end}\\nAttendees: ${meeting.attendeesText || 'none listed'}\\nLocation/Link: ${meeting.location || 'n/a'}\\nDescription: ${meeting.description || 'none provided'}\\n\\nRecent related emails with attendees:\\n${emailContext}`;\n\nreturn [{\n  json: {\n    ...meeting,\n    promptText\n  }\n}];"
      },
      "typeVersion": 2
    },
