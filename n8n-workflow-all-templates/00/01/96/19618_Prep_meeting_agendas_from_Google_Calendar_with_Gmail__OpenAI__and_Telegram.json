        "jsCode": "const raw = $input.first().json.message?.content ?? $input.first().json.content ?? $input.first().json.text ?? '';\nconst meeting = $('Loop Over Items').item.json;\n\nreturn [{\n  json: {\n    ...meeting,\n    agendaText: raw,\n    fullMessage: `📅 *Meeting Prep: ${meeting.title}*\\nWhen: ${meeting.start}\\nAttendees: ${meeting.attendeesText || 'n/a'}\\n\\n${raw}`\n  }\n}];"
