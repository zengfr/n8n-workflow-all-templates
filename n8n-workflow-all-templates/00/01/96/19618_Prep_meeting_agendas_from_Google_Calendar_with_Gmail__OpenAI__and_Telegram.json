    {
      "id": "a86ba432-3894-4354-9c52-37b6e2b8c1e2",
      "name": "Filter Unprocessed Meetings",
      "type": "n8n-nodes-base.code",
      "position": [
        -2432,
        2928
      ],
      "parameters": {
        "jsCode": "const processed = new Set(\n  ($('Get Processed Events').all() || [])\n    .map(i => (i.json['Event ID'] || '').toString())\n    .filter(Boolean)\n);\n\nreturn items\n  .filter(item => item.json.id && !processed.has(item.json.id))\n  .map(item => {\n    const d = item.json;\n    const attendees = (d.attendees || []).map(a => a.email).filter(Boolean);\n    return {\n      json: {\n        eventId: d.id,\n        title: d.summary || 'Untitled Meeting',\n        description: d.description || '',\n        start: d.start?.dateTime || d.start?.date || '',\n        end: d.end?.dateTime || d.end?.date || '',\n        attendees,\n        attendeesText: attendees.join(', '),\n        location: d.location || d.hangoutLink || ''\n      }\n    };\n  });"
      },
      "typeVersion": 2
    },
