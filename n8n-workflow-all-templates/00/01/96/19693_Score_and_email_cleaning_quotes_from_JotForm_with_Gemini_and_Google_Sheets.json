              "value": "={{ (((Number($json['Approximate Square Feet']) / 500) + (Number($json['Extra Bathrooms']) * 0.5) + (Number($json['Extra Kitchens']) * 1)) * Number($json['Complexity Multiplier']) * ($json['Property Type'] === 'Office' ? 1.15 : 1)).toFixed(2) }}"
