    {
      "id": "39a51bb3-727e-4968-bec4-31bf39518e7a",
      "name": "Quote Analysis Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        3424,
        80
      ],
      "parameters": {
        "text": "=You are a cleaning/property services quote analyst. Analyze this job and extract structured requirements.\n\nProperty Type: {{ $json['Property Type'] }}\nApproximate Square Feet: {{ $json['Approximate Square Feet'] }}\nAddress: {{ $json['Address'] }}\nAdditional Notes From Customer: {{ $json['Other Information'] }}\n\nExtract the bathroom count, kitchen count, any special requirements mentioned, a complexity multiplier (1.0 = standard job, up to 2.0 = highly complex), and the most likely service type.",
        "options": {
          "systemMessage": "You are an expert estimator assistant for a property services company. Only extract details the customer actually stated. If something isn't mentioned, use a sensible default (0 for counts, 1.0 for the multiplier) instead of guessing."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 2.1
    },
