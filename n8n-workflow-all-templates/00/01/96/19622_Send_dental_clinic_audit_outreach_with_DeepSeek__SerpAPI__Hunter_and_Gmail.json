      "typeVersion": 1
    },
    {
      "id": "sn-19622-1",
      "name": "Clinic discovery",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -32,
        217
      ],
      "parameters": {
        "color": "7",
        "width": 1424,
        "height": 392.75,
        "content": "## Clinic discovery\n\nStarts the Monday prospecting run, loads your city and offer settings, finds dental clinics in Google Maps, then normalizes results and keeps clinics with phone numbers and websites."
      },
      "typeVersion": 1
    },
    {
      "id": "sn-19622-2",
      "name": "Personalized outreach",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2256,
        689.75
      ],
      "parameters": {
        "color": "7",
        "width": 1392,
        "height": 440.75,
        "content": "## Personalized outreach\n\nDeepSeek scores each eligible clinic and drafts a tailored audit offer. Gmail sends it while Google Sheets logs the lead and Telegram alerts your team."
      },
      "typeVersion": 1
    },
    {
      "id": "sn-19622-3",
      "name": "Weekly performance digest",
      "type": "n8n-nodes-base.stickyNote",
