    {
      "id": "603132c1-cadf-4a33-8f2e-3e4a097b4faf",
      "name": "AI Personalize Audit Pitch",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2336,
        838.5
      ],
      "parameters": {
        "text": "={{ 'Dental clinic lead. Name: ' + $json.clinic_name + ' | Address: ' + ($json.address || '') + ' | Phone: ' + ($json.phone || '') + ' | Website: ' + ($json.website || '') + ' | Google rating: ' + ($json.rating || 'unknown') + ' from ' + ($json.reviews_count || 0) + ' reviews | Work email: ' + $json.emails[0].value + ' | Sender: ' + $('Prospecting Config').first().json.sender_name + ', offering ' + $('Prospecting Config').first().json.sender_service }}",
        "options": {
          "systemMessage": "You write cold outreach for a marketing agency that offers dental clinics a free patient acquisition audit. Pick the strongest angle from the data: low rating below 4.5 stars, few reviews under 100, or a generic info style email address. Score the opportunity 0 to 100: start at 50, add 20 if rating is below 4.5, add 15 if reviews are under 100, add 15 if the email looks generic. Write a short plain text email under 140 words: personal opener with clinic name and the specific observation, one line on the free audit, one soft call to action to reply. No hype, no exclamation marks, no invented facts. Return ONLY valid JSON, no markdown, no code fences, with exactly these keys: clinic_name, work_email, phone, website, rating, reviews_count, opportunity_score (number), audit_angle (one short phrase), email_subject (under 60 chars), email_body (plain text with line breaks), tg_text (one line summary for Telegram). Copy clinic_name, work_email, phone, website, rating and reviews_count from the input without changing them."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
