    {
      "id": "e33717b1-0155-49bd-87cd-064249a7e30a",
      "name": "Parse Receipt JSON1",
      "type": "n8n-nodes-base.code",
      "position": [
        -384,
        3744
      ],
      "parameters": {
        "jsCode": "let meta = {};\ntry { meta = $('Convert Image to Base64 String1').item.json; } catch (e) {}\nif (!meta || !meta.source) {\n  try { meta = $('Prepare Email Attachment1').item.json; } catch (e) {}\n}\n\nconst resp = items[0].json;\nlet parsed;\ntry {\n  const raw = resp.choices?.[0]?.message?.content || '';\n  const cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    vendor: 'Unknown',\n    date: new Date().toISOString().slice(0, 10),\n    amount: 0,\n    currency: 'USD',\n    category: 'Other',\n    summary: 'Could not parse receipt'\n  };\n}\n\nreturn [{\n  json: {\n    vendor: parsed.vendor || 'Unknown',\n    date: parsed.date || new Date().toISOString().slice(0, 10),\n    amount: typeof parsed.amount === 'number' ? parsed.amount : 0,\n    currency: parsed.currency || 'USD',\n    category: parsed.category || 'Other',\n    summary: parsed.summary || '',\n    source: meta.source || 'Unknown',\n    telegramChatId: meta.telegramChatId || ''\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "100f4376-b44d-43e1-9c98-cf482d08e617",
      "name": "Extract PDF Text1",
      "type": "n8n-nodes-base.extractFromFile",
      "position": [
        -976,
        3136
      ],
      "parameters": {
        "options": {},
        "operation": "pdf"
      },
      "typeVersion": 1
    },
    {
      "id": "8e207b5b-3f48-4283-a6ea-a9a8459e1784",
      "name": "Is PDF1",
      "type": "n8n-nodes-base.if",
      "position": [
        -1264,
        3152
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-is-pdf",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{$json.isPdf}}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "560fd4ae-af7b-464b-981c-e2ffbc01cf01",
      "name": "Prepare Email Attachment1",
      "type": "n8n-nodes-base.code",
      "position": [
        -1472,
        3152
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binaryKeys = Object.keys(item.binary || {});\nif (!binaryKeys.length) {\n  return [];\n}\nconst key = binaryKeys[0];\nconst bin = item.binary[key];\n\nreturn [{\n  json: {\n    imageBase64: bin.data,\n    mimeType: bin.mimeType || 'application/octet-stream',\n    isPdf: (bin.mimeType || '').includes('pdf'),\n    source: 'Gmail Receipt',\n    telegramChatId: ''\n  },\n  binary: { data: bin }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "7eccfe02-97cf-4027-926c-76babe99887d",
      "name": "Gmail Trigger Receipts1",
      "type": "n8n-nodes-base.gmailTrigger",
      "position": [
        -1696,
        3152
      ],
      "parameters": {
        "simple": false,
        "filters": {
          "q": "has:attachment (receipt OR invoice OR \"order confirmation\")"
        },
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "2f11699e-0fae-4d25-9432-515de62bf725",
      "name": "Convert Image to Base64 String1",
      "type": "n8n-nodes-base.code",
      "position": [
        -1024,
        3760
      ],
      "parameters": {
        "jsCode": "const binary = $input.first().binary;\nconst key = Object.keys(binary)[0];\nconst base64 = binary[key].data;\nconst mimeType = binary[key].mimeType || 'image/jpeg';\n\nreturn [{\n  json: {\n    imageBase64: base64,\n    mimeType,\n    telegramChatId: $('Telegram Trigger1').item.json.message.chat.id,\n    source: 'Telegram Photo'\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "d8063d84-6974-406f-9392-d5381a5534cf",
      "name": "Telegram Get Photo File1",
