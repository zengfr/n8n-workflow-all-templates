      "parameters": {
        "color": 7,
        "width": 560,
        "height": 464,
        "content": "## Loop and scrape listings\n\nIterates through each search item, sends it to Apify for scraping, and attaches the relevant location and keyword context before continuing the loop."
      },
      "typeVersion": 1
    },
    {
      "id": "72c921c2-b139-4d69-8e8c-dbba008acce4",
