    {
      "id": "d7fd8cae-bbbb-420e-99fa-eca3a6733c6d",
      "name": "Calc: Inflation Adjusted Spend",
      "type": "n8n-nodes-base.code",
      "position": [
        -288,
        464
      ],
      "parameters": {
        "jsCode": "// 1. Parse the values and handle the \"NaN\" strings\nconst spend = parseFloat($json.spend) || 0;\nconst inflationValue = parseFloat($json.inflation) || 0; // Converts \"NaN\" to 0\nconst fx = parseFloat($json.fx_rate) || 1;\n\n// 2. Calculations\nconst adj_spend_usd = spend * (1 + inflationValue);\nconst adj_spend_local = adj_spend_usd * fx;\n\n// 3. Return data, OVERWRITING the broken inflation field\nreturn {\n  ...$json,\n  inflation: inflationValue, // This replaces the string \"NaN\" with the number 0\n  adj_spend_usd: adj_spend_usd,\n  adj_spend_local: adj_spend_local\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "2fc9f83b-9864-4ec1-b2a3-9c1616e5869f",
      "name": "Calc: Budget Variance Analysis",
      "type": "n8n-nodes-base.code",
      "position": [
        -64,
        464
      ],
      "parameters": {
        "jsCode": "const budget = parseFloat($json.budget) || 0;\nconst fx = parseFloat($json.fx_rate) || 1;\nconst adj_local = $json.adj_spend_local;\n\nconst budget_local = budget * fx;\nconst variance = adj_local - budget_local;\nconst variance_pct = budget_local !== 0 ? (variance / budget_local) * 100 : 0;\n\nreturn {\n  ...$json,\n  budget_local: budget_local,\n  variance_amount: variance,\n  variance_pct: variance_pct.toFixed(2) + \"%\",\n  is_over_budget: variance > 0\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "bb867d70-4565-4adf-b307-1c96055f3958",
      "name": "Calc: Margin Leakage Risk",
      "type": "n8n-nodes-base.code",
      "position": [
        160,
        464
      ],
      "parameters": {
        "jsCode": "// Assuming a baseline margin (e.g., 20%) if not provided in your sheet\nconst baseline_margin = $json.margin_goal || 0.20; \nconst variance_pct_raw = parseFloat($json.variance_pct) / 100;\n\n// Impact: If costs go up by 10%, margin drops by roughly that amount \n// relative to total revenue.\nconst margin_impact = baseline_margin - (variance_pct_raw * 0.15); // Weighted impact\n\nreturn {\n  ...$json,\n  estimated_margin_leakage: (variance_pct_raw > 0 ? variance_pct_raw : 0).toFixed(2) + \"%\",\n  margin_safety: margin_impact > 0.05 ? \"Safe\" : \"Critical\"\n};"
      },
      "typeVersion": 2
    },
