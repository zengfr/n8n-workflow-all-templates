        ],
        "signingSecret": ""
      },
      "typeVersion": 1
    },
    {
      "id": "tr1300-0000-0000-0000-000000000011",
      "name": "Get Current Dimensions",
      "type": "n8n-nodes-teamretro.teamRetro",
      "position": [
        680,
        300
      ],
      "parameters": {
        "resource": "healthCheck",
        "operation": "getAllDimensions",
        "returnAll": true,
        "meetingSlug": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.data.healthCheck.id }}"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "tr1300-0000-0000-0000-000000000012",
      "name": "Get Recent Health Checks",
      "type": "n8n-nodes-teamretro.teamRetro",
      "position": [
        900,
        300
      ],
      "parameters": {
        "limit": 5,
        "filters": {
          "sort": "-date",
          "teamIds": "={{ $('When Health Check Completes').first().json.data.healthCheck.team.id }}"
        },
        "resource": "healthCheck",
        "operation": "getAll",
        "returnAll": false
      },
      "executeOnce": true,
      "typeVersion": 1
    },
    {
      "id": "tr1300-0000-0000-0000-000000000013",
      "name": "Enough History?",
      "type": "n8n-nodes-base.if",
      "position": [
        1120,
        300
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "at-least-two-priors",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": "={{ $('Get Recent Health Checks').all().filter(c => c.json.id !== $('When Health Check Completes').first().json.data.healthCheck.id).length }}",
              "rightValue": 2
            },
            {
              "id": "is-a-prior-check",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": "={{ $json.id }}",
              "rightValue": "={{ $('When Health Check Completes').first().json.data.healthCheck.id }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "tr1300-0000-0000-0000-000000000014",
      "name": "Get Prior Dimensions",
      "type": "n8n-nodes-teamretro.teamRetro",
      "position": [
        1460,
        300
      ],
      "parameters": {
        "resource": "healthCheck",
        "operation": "getAllDimensions",
        "returnAll": true,
        "meetingSlug": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "tr1300-0000-0000-0000-000000000015",
      "name": "Compute Baseline & Flag Drops",
      "type": "n8n-nodes-base.code",
      "position": [
        1680,
        300
      ],
      "parameters": {
        "jsCode": "// ── Tune me ──────────────────────────────────────────────────────────────\nconst THRESHOLD = 0.75; // flag a dimension when it sits this many points (5-pt scale) below its baseline\n\n// Current scores: one item per dimension of the just-completed check.\nconst current = $('Get Current Dimensions').all().map((i) => i.json);\n\n// History: this node's input is one item per dimension per prior check.\n// Group prior scores by dimension name; a skipped dimension has no numeric\n// average on that check and simply contributes nothing.\nconst history = {};\nfor (const { json: dim } of $input.all()) {\n  const score = dim.ratings?.average;\n  if (typeof score !== 'number') continue;\n  (history[dim.name] ??= []).push(score);\n}\n\nconst round2 = (n) => Math.round(n * 100) / 100;\n\nconst flagged = [];\nfor (const dim of current) {\n  const score = dim.ratings?.average;\n  const priors = history[dim.name] ?? [];\n  if (typeof score !== 'number' || priors.length === 0) continue; // skipped now, or no history yet\n  const baseline = priors.reduce((sum, s) => sum + s, 0) / priors.length;\n  const delta = round2(score - baseline);\n  if (delta <= -THRESHOLD) {\n    flagged.push({\n      dimension: dim.name,\n      current: score,\n      baseline: round2(baseline),\n      delta,\n    });\n  }\n}\n\nconst hc = $('When Health Check Completes').first().json.data.healthCheck;\nreturn [{\n  json: {\n    team: hc.team?.name ?? '',\n    healthCheck: hc.title,\n    date: hc.date,\n    threshold: THRESHOLD,\n    flagged,\n  },\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "tr1300-0000-0000-0000-000000000016",
      "name": "Any Dimension Dropped?",
      "type": "n8n-nodes-base.if",
      "position": [
        1900,
        300
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "has-flagged-drops",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ $json.flagged.length }}",
              "rightValue": 0
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "tr1300-0000-0000-0000-000000000017",
      "name": "Interpret the Drops",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2240,
        300
      ],
      "parameters": {
        "text": "=The \"{{ $json.healthCheck }}\" health check for team \"{{ $json.team }}\" ({{ $json.date }}) just completed. These dimensions dropped at least {{ $json.threshold }} points (5-point scale) below the team's rolling baseline:\n\n{{ JSON.stringify($json.flagged, null, 2) }}\n\nWrite the interpretation and one discussion prompt per flagged dimension.",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You help team leads read team-health trends. You receive dimensions whose score dropped below the team's rolling baseline. Return: (1) interpretation — one short, neutral paragraph (under 80 words) describing what changed, using only the numbers provided, with no blame and no speculation about individuals or causes; (2) prompts — for each flagged dimension exactly one open discussion question the lead can bring to the team, phrased to invite explanation rather than defensiveness."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "tr1300-0000-0000-0000-000000000018",
      "name": "OpenAI GPT-5 Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        2240,
        540
      ],
      "parameters": {
        "model": {
