      "parameters": {
        "text": "=:chart_with_downwards_trend: *Team health early warning — {{ $('Compute Baseline & Flag Drops').first().json.team }}*\n_{{ $('Compute Baseline & Flag Drops').first().json.healthCheck }} ({{ $('Compute Baseline & Flag Drops').first().json.date }})_\n\n{{ $json.output.interpretation }}\n\n{{ $('Compute Baseline & Flag Drops').first().json.flagged.map(f => `• *${f.dimension}*: ${f.current} — baseline ${f.baseline} (${f.delta})`).join('\\n') }}\n\n*Suggested discussion prompts*\n{{ $json.output.prompts.map(p => `• _${p.dimension}_: ${p.prompt}`).join('\\n') }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#team-leads"
