      "parameters": {
        "text": "=*HIGH RISK SUPPLIER ALERT* \n\n*Supplier:* {{ $('Fetch: Supplier Master List').item.json.name }}\n\n*Contract at Risk:* {{ $('Fetch: Supplier Contract Profile').item.json.contract_value }}  *Issue:* {{ JSON.parse($('Gate: Violation Detected?').item.json.output).summary }}  \n\nAction taken: A formal warning email has been auto-drafted and saved to Gmail for review._",
