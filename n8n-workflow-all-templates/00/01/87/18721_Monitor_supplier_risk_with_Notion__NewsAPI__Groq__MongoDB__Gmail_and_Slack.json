    {
      "id": "003bf085-8f0c-48fa-97f7-4638cd61965f",
      "name": "AI: Draft Warning Email",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        5232,
        768
      ],
      "parameters": {
        "text": "={{ $json.ai_context }}",
        "options": {
          "systemMessage": "You are a Corporate Compliance Officer. Draft a formal, stern, and professional warning email to a supplier regarding recent labor and human rights violation allegations.\nYou will be provided with the supplier's name, the violation summary, their contract value, and the specific penalty clauses.\nExplicitly mention the contract value at risk and quote the penalty clause to enforce compliance.\nKeep the tone legally sound and actionable. Output strictly the email body (no subject line, no markdown)."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
