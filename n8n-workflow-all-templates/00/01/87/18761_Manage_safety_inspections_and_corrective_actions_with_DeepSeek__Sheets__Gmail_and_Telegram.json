    {
      "id": "si-parse",
      "name": "Parse Findings",
      "type": "n8n-nodes-base.code",
      "position": [
        1168,
        48
      ],
      "parameters": {
        "jsCode": "const norm = $('Normalize Inspection Data').item.json;\nlet raw = String(($json.output || '[]')).replace(/```json\\n?/g, '').replace(/```/g, '').trim();\nlet parsed = [];\ntry { parsed = JSON.parse(raw); } catch (e) { parsed = []; }\nif (!Array.isArray(parsed)) parsed = [];\nconst areas = JSON.parse(norm.findings_json || '[]');\nconst sevRank = { Critical: 3, Major: 2, Minor: 1, Pass: 0 };\nconst defaultAction = (a, s) => ({ area: a.area, severity: s, finding: a.area + ' needs attention during this inspection', corrective_action: 'Inspect and fix ' + a.area + ' before the next shift', suggested_owner: 'Facilities Lead', due_days: s === 'Critical' ? 1 : 7 });\nconst byArea = {};\nfor (const f of parsed) { if (f && f.area) byArea[String(f.area).toLowerCase()] = f; }\nconst findings = [];\nfor (const a of areas) {\n  if (String(a.status || '') === 'Pass') continue;\n  const f = byArea[String(a.area).toLowerCase()] || defaultAction(a, a.status);\n  const severity = sevRank[f.severity] ? f.severity : (a.status === 'Critical' ? 'Critical' : (a.status === 'Minor' ? 'Minor' : 'Major'));\n  const dueDays = [1, 7, 30].includes(Number(f.due_days)) ? Number(f.due_days) : (severity === 'Critical' ? 1 : severity === 'Major' ? 7 : 30);\n  findings.push({\n    action_id: 'ACT-' + norm.inspection_id + '-' + (findings.length + 1),\n    inspection_id: norm.inspection_id,\n    area: a.area,\n    severity: severity,\n    finding: String(f.finding || (a.area + ' needs attention')).slice(0, 200),\n    corrective_action: String(f.corrective_action || defaultAction(a, severity).corrective_action).slice(0, 300),\n    suggested_owner: String(f.suggested_owner || 'Facilities Lead'),\n    due_date: new Date(Date.now() + dueDays * 86400000).toISOString().slice(0, 10),\n    status: 'Open',\n    created_at: norm.received_at,\n    is_critical: severity === 'Critical'\n  });\n}\nconst counts = {\n  findings_total: findings.length,\n  critical_total: findings.filter(f => f.severity === 'Critical').length,\n  major_total: findings.filter(f => f.severity === 'Major').length,\n  minor_total: findings.filter(f => f.severity === 'Minor').length\n};\nconst critical_list = findings.filter(f => f.severity === 'Critical').map(f => ({ area: f.area, action: f.corrective_action, owner: f.suggested_owner, due: f.due_date }));\nreturn [{ json: { ...norm, findings: findings, ...counts, has_critical: counts.critical_total > 0, critical_list: critical_list, header: { inspection_id: norm.inspection_id, inspector: norm.inspector, location: norm.location, received_at: norm.received_at } } }];"
      },
      "typeVersion": 2
    },
