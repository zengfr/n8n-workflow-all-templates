    {
      "id": "si-agent",
      "name": "AI Analyze Findings",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        816,
        48
      ],
      "parameters": {
        "text": "={{ 'You analyze safety inspection results. Input: ' + JSON.stringify($json) + '. The findings_json field is an array of inspected areas, each with status and optional notes. For every area whose status is not Pass, produce exactly one corrective action object with keys: area (the area name), severity (Critical, Major or Minor, matching the input status), finding (short description of the issue), corrective_action (a concrete fix), suggested_owner (one of: Facilities Lead, Safety Officer, Site Manager), due_days (1 for Critical, 7 for Major, 30 for Minor). Return ONLY the JSON array, no markdown, no code fences. If all areas are Pass, return [].' }}",
        "options": {
          "systemMessage": "You are a pragmatic workplace safety analyst for small and mid-size sites. You turn inspection checklist results into clear corrective actions with owners and deadlines. Keep findings concrete and actionable, and always respond with valid JSON only."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
