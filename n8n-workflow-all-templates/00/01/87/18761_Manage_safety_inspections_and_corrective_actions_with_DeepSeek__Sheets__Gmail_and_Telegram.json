    {
      "id": "si-stats",
      "name": "Compute Weekly Stats",
      "type": "n8n-nodes-base.code",
      "position": [
        1856,
        1040
      ],
      "parameters": {
        "jsCode": "const inspections = $('Read Inspections').all().map(i => i.json);\nconst actions = $('Read Corrective Actions for Digest').all().map(i => i.json);\nconst weekAgo = Date.now() - 7 * 86400000;\nconst weekInspectionIds = new Set(inspections.filter(x => { const t = new Date(String(x.received_at || '')); return !isNaN(t.getTime()) && t.getTime() >= weekAgo; }).map(x => x.inspection_id));\nconst weekActions = actions.filter(a => weekInspectionIds.has(a.inspection_id));\nconst open = actions.filter(a => String(a.status || '') === 'Open');\nconst overdue = actions.filter(a => String(a.status || '') === 'Open' && String(a.due_date || '') < new Date().toISOString().slice(0, 10));\nconst sev = s => weekActions.filter(a => a.severity === s).length;\nconst top_areas = [...new Set(weekActions.map(a => a.area))].slice(0, 5);\nconst stats_text = 'Inspections this week: ' + weekInspectionIds.size + '\\nFindings this week: ' + weekActions.length + ' (critical ' + sev('Critical') + ', major ' + sev('Major') + ', minor ' + sev('Minor') + ')\\nOpen actions total: ' + open.length + ', overdue: ' + overdue.length + (top_areas.length ? '\\nTop areas: ' + top_areas.join(', ') : '');\nreturn [{ json: { inspections_this_week: weekInspectionIds.size, findings_this_week: weekActions.length, critical_this_week: sev('Critical'), major_this_week: sev('Major'), minor_this_week: sev('Minor'), open_total: open.length, overdue_total: overdue.length, top_areas: top_areas, stats_text: stats_text } }];"
      },
      "typeVersion": 2
    },
