      "type": "n8n-nodes-base.code",
      "position": [
        560,
        1008
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst today = new Date().toISOString().slice(0, 10);\nconst overdue = rows.filter(r => String(r.status || '').toLowerCase() === 'open' && String(r.due_date || '') < today);\nreturn [{ json: { overdue_count: overdue.length, overdue_list: overdue, today: today } }];"
      },
      "typeVersion": 2
    },
