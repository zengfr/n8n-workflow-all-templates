      "typeVersion": 2.2
    },
    {
      "id": "dm1",
      "name": "Ask the workbook what it needs",
      "type": "n8n-nodes-docmint.docMint",
      "onError": "continueRegularOutput",
      "position": [
        520,
        200
      ],
      "parameters": {
        "resource": "template",
        "operation": "getFields",
        "readOptions": {},
        "templateName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.template_name }}"
        }
      },
