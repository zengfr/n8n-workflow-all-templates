          "name": "DocMint account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "if2",
      "name": "Is the template reachable?",
      "type": "n8n-nodes-base.if",
      "position": [
        740,
        200
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "t1",
              "operator": {
                "type": "array",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.fields }}",
              "rightValue": ""
            }
          ]
        },
        "looseTypeValidation": true
      },
      "typeVersion": 2.2
    },
    {
      "id": "code1",
      "name": "Total the rows and roll up by region",
      "type": "n8n-nodes-base.code",
      "position": [
        960,
        200
      ],
      "parameters": {
        "jsCode": "// The export arrives as flat rows. The workbook wants both the rows and a\n// per-region roll-up, so the aggregation happens here rather than in Excel.\nconst src = $('Set your company and template').first().json;\n\nconst rows = src.rows_in.map((r) => {\n  const units = Number(r.units);\n  const unitPrice = Number(r.unit_price);\n  return {\n    region: r.region,\n    rep: r.rep,\n    channel: r.channel || 'Direct',\n    units,\n    unit_price: unitPrice,\n    revenue: Math.round(units * unitPrice * 100) / 100,\n    prior_revenue: Number(r.prior_revenue || 0),\n  };\n});\n\nconst byRegion = new Map();\nfor (const r of rows) {\n  const g = byRegion.get(r.region) || { name: r.region, reps: [], units: 0, revenue: 0, prior_revenue: 0 };\n  if (!g.reps.includes(r.rep)) g.reps.push(r.rep);\n  g.units += r.units;\n  g.revenue = Math.round((g.revenue + r.revenue) * 100) / 100;\n  g.prior_revenue = Math.round((g.prior_revenue + r.prior_revenue) * 100) / 100;\n  byRegion.set(r.region, g);\n}\nconst regions = [...byRegion.values()].sort((a, b) => b.revenue - a.revenue);\n\nreturn [{\n  json: {\n    template_name: src.template_name,\n    company: src.company,\n    currency: src.currency,\n    source: src.source,\n    period: src.period,\n    generated: new Date().toISOString().slice(0, 10),\n    rows,\n    regions,\n  },\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "dm2",
      "name": "Fill the Excel workbook",
      "type": "n8n-nodes-docmint.docMint",
      "onError": "continueRegularOutput",
      "position": [
        1180,
        200
      ],
      "parameters": {
        "output": "document",
        "options": {
          "currency": "={{ $json.currency }}",
          "onMissing": "empty"
        },
        "dataJson": "={{ $json }}",
        "fileName": "={{ 'sales-report-' + $json.period + '.xlsx' }}",
        "template": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.template_name }}"
        },
        "sendRawJson": true
      },
      "credentials": {
        "docMintApi": {
          "id": "DOCMINT_CRED",
          "name": "DocMint account"
        }
      },
      "typeVersion": 1
    },
