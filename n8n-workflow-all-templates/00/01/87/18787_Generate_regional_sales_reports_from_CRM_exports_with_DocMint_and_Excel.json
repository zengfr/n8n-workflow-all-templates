                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.rows_in }}",
              "rightValue": ""
            },
            {
              "id": "v2",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": "={{ $json.period }}",
              "rightValue": ""
            }
          ]
