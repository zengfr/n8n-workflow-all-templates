    {
      "id": "edb99fd9-3fb7-4773-9b40-a7678a3ab21a",
      "name": "Clean the markdown",
      "type": "n8n-nodes-base.code",
      "position": [
        1792,
        96
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Clean the markdown from the Gaffa node and build a safe filename.\nconst url = $('Loop over URLs').item.json.url;\nconst md = ($input.item.json.actions?.[0]?.output ?? '').toString();\nconst clean = md\n  .replace(/!\\[[^\\]]*\\]\\([^)]+\\)/g, '')\n  .replace(/\\[([^\\]]+)\\]\\([^)]+\\)/g, '$1')\n  .replace(/https?:\\/\\/\\S+/g, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\nconst filename = url\n  .replace(/^https?:\\/\\//, '')\n  .replace(/[^a-zA-Z0-9]+/g, '-')\n  .replace(/^-+|-+$/g, '')\n  .slice(0, 120);\nreturn { url, filename, markdown: clean };"
      },
      "typeVersion": 2
    },
