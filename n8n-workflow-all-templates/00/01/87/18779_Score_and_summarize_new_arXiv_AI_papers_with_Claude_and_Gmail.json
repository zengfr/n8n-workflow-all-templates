        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": "=Summarize this AI research paper for a technically curious reader.\n\nTitle: {{ $json.title }}\nAbstract: {{ $json.summary }}\nURL: {{ $json.id }}\n\nReturn:\n1. A two-sentence summary\n2. The main contribution\n3. Why it matters\n4. One limitation or open question\n5. Three keywords\n\nRelevance score: {{ $json.relevance_score }}/10\nRelevance reason: {{ $json.relevance_reason }}\n\nDisplay both immediately below the paper title in your response.\n\nDo not invent information that is not present in the abstract.\n\nPaper title: {{ $json.title }}\nPaper URL: {{ $json.id }}\n\nBegin your response with:\n## [Paper title](Paper URL)"
            }
          ]
        }
      },
      "typeVersion": 1
