        -48,
        -240
      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 304,
        "content": "## Schedule and fetch feed\n\nStarts the workflow on a schedule and sends a GET request to the arXiv API feed."
      },
      "typeVersion": 1
    },
    {
