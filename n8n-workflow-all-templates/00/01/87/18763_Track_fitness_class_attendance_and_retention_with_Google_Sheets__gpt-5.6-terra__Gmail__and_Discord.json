    {
      "id": "449de5eb-410b-40ad-816c-83ad97873937",
      "name": "Compute Weekly Stats",
      "type": "n8n-nodes-base.code",
      "position": [
        720,
        608
      ],
      "parameters": {
        "jsCode": "const seenIds = new Set();\nconst roster = $input.all().map(i => i.json).filter(r => { const k = String(r.member_id || '').trim(); if (!k || seenIds.has(k)) return false; seenIds.add(k); return true; });\nconst rows = $('Read Attendance for Report').all().map(i => i.json);\nconst now = new Date();\nconst diff = (now.getDay() + 6) % 7;\nconst monday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - diff, 0, 0, 0);\nconst week = rows.filter(r => { const t = Date.parse(r.checkin_date || ''); return t && t >= monday.getTime(); });\nconst unique = new Set(week.map(r => String(r.member_id || '')));\nconst byClass = {};\nweek.forEach(r => { const c = r.class_name || 'unknown'; byClass[c] = (byClass[c] || 0) + 1; });\nconst noShow = week.filter(r => String(r.status || '').toLowerCase() === 'no_show').length;\nconst noShowRate = week.length ? Math.round(noShow / week.length * 100) : 0;\nconst cutoff = new Date(now.getTime() - 14 * 86400000);\nconst atRisk = roster.filter(mm => {\n  const j = Date.parse(mm.join_date || '');\n  const older = j && (now - j) / 86400000 > 30;\n  const seenRecent = rows.some(r => { const t = Date.parse(r.checkin_date || ''); return String(r.member_id || '').trim() === String(mm.member_id || '').trim() && t && t >= cutoff.getTime(); });\n  return older && !seenRecent;\n}).map(mm => mm.member_name);\nconst newMembers = roster.filter(mm => { const j = Date.parse(mm.join_date || ''); return j && (now - j) / 86400000 <= 7; }).map(mm => mm.member_name);\nconst stats = { week_start: monday.toISOString().slice(0,10), total_checkins: week.length, unique_members: unique.size, class_breakdown: byClass, no_show_total: noShow, no_show_rate: noShowRate, at_risk_members: atRisk, new_members: newMembers };\nreturn [{ json: { ...stats, stats_blob: JSON.stringify(stats) } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "f4cab617-8fe8-42be-9dd1-65cd76abc536",
      "name": "AI Write Weekly Insight",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        960,
        608
      ],
      "parameters": {
        "text": "={{ 'Write the weekly studio report. Data: ' + $json.stats_blob }}",
        "options": {
          "systemMessage": "You are the studio analytics assistant for a small fitness studio. Given the weekly attendance stats, write a friendly digest under 120 words for the studio owner: total check-ins, unique members, the busiest class, no-show count and rate, any members at risk of churn, and new members for the week. End with one actionable recommendation. If the week was quiet or there was no data, say so plainly. Return ONLY valid JSON: {\\\"digest\\\":\\\"...\\\"}. No markdown, no emojis, no text outside the JSON."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
