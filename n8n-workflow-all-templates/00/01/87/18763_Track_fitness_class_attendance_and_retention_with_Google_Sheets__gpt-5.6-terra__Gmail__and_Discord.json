    {
      "id": "7e0a0456-b46f-48c2-a33e-445cee4637b2",
      "name": "Match Member by ID",
      "type": "n8n-nodes-base.code",
      "position": [
        1008,
        -336
      ],
      "parameters": {
        "jsCode": "const norm = $('Normalize Check-in').first().json;\nconst roster = $input.all().map(i => i.json);\nconst id = String(norm.member_id || '').trim();\nlet m = null;\nfor (const r of roster) {\n  if (String(r.member_id || '').trim() === id) { m = r; break; }\n}\nif (!m) { return [{ json: { ...norm, found: false } }]; }\nreturn [{ json: { ...norm, found: true, member_name: m.member_name || '', member_email: m.member_email || '', membership: m.membership || '', join_date: m.join_date || '', email_ok: m.email_ok || 'yes' } }];"
      },
      "typeVersion": 2
    },
