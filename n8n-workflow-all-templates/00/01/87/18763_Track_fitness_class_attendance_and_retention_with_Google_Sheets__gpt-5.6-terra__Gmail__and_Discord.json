    {
      "id": "54324788-9c89-4c82-b7e7-a2fed9ee654e",
      "name": "AI Judge Engagement and Write Message",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1696,
        -352
      ],
      "parameters": {
        "text": "={{ 'Member: ' + $json.member_name + ' | membership: ' + $json.membership + ' | class today: ' + $json.class_name + ' | check-in status: ' + $json.status + ' | notes: ' + $json.notes + ' | joined: ' + $json.join_date + ' | new member: ' + $json.is_new + ' | received at: ' + $json.received_at }}",
        "options": {
          "systemMessage": "You are the member experience assistant for a small fitness studio. A front desk class check-in just came in. Judge the member engagement: at_risk when the check-in status is no_show (write a warm, gentle nudge encouraging them to come back soon, never blaming them); new when the member joined within the last 30 days (write a short encouraging note that helps them build the habit); otherwise engaged (write a brief warm thank you). Write ONE short message under 50 words addressed to the member by first name. Never mention internal metrics or algorithms. Return ONLY valid JSON with double quoted keys and no code fences: {\\\"engagement_status\\\":\\\"at_risk|new|engaged\\\",\\\"message\\\":\\\"...\\\"}. No markdown, no emojis, no text outside the JSON."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "092117c1-2b0f-4572-8606-dc1a6070e811",
      "name": "Engagement Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        1920,
        -224
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        },
        "builtInTools": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "credential-id",
          "name": "jonathan"
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "59a9c027-1c4f-41c8-81a3-ba89f75ecae8",
      "name": "Parse Agent Output",
      "type": "n8n-nodes-base.code",
      "position": [
        2000,
        -352
      ],
      "parameters": {
        "jsCode": "const base = $('Build Agent Input').first().json;\nconst item = $input.first().json;\nlet raw = String(item.output || '').replace(/```json/gi, '').replace(/```/g, '').trim();\nraw = raw.replace(/\\\\\"/g, '\"').replace(/\\\\\\\\/g, '\\\\');\nlet parsed = {};\ntry { parsed = JSON.parse(raw); } catch (e) { const m = raw.match(/\\{[\\s\\S]*\\}/); if (m) { try { parsed = JSON.parse(m[0]); } catch (e2) {} } }\nconst es = parsed.engagement_status || 'engaged';\nconst message = parsed.message || ('Thanks for coming to class, ' + (base.member_name || '') + '!');\nconst needsAttention = (es === 'at_risk' || String(base.status || '').toLowerCase() === 'no_show');\nreturn [{ json: { ...base, engagement_status: es, message: message, ai_ok: !!(parsed.message), needs_attention: needsAttention } }];"
      },
      "typeVersion": 2
    },
