    {
      "id": "c101afb3-d242-4cac-9947-092be41b683e",
      "name": "Parse Weekly Insight",
      "type": "n8n-nodes-base.code",
      "position": [
        1280,
        608
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst stats = $('Compute Weekly Stats').first().json;\nlet raw = String(item.output || '').replace(/```json/gi, '').replace(/```/g, '').trim();\nraw = raw.replace(/\\\\\"/g, '\"').replace(/\\\\\\\\/g, '\\\\');\nlet parsed = {};\ntry { parsed = JSON.parse(raw); } catch (e) { const m = raw.match(/\\{[\\s\\S]*\\}/); if (m) { try { parsed = JSON.parse(m[0]); } catch (e2) {} } }\nconst digest = parsed.digest || raw;\nreturn [{ json: { digest: digest, stats_blob: stats.stats_blob, week_start: stats.week_start, total_checkins: stats.total_checkins, unique_members: stats.unique_members, class_breakdown: JSON.stringify(stats.class_breakdown || {}), no_show_total: stats.no_show_total, no_show_rate: stats.no_show_rate, at_risk_members: JSON.stringify(stats.at_risk_members || []), new_members: JSON.stringify(stats.new_members || []) } }];"
      },
      "typeVersion": 2
    },
