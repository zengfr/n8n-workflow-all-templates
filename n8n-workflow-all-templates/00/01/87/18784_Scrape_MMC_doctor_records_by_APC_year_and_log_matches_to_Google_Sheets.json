      "parameters": {
        "color": 7,
        "width": 592,
        "height": 320,
        "content": "## Start and configure run\n\nManual entry point that sets the target scraping year and daily limit, then loads previously saved resume state so the run can continue from the last processed position."
      },
      "typeVersion": 1
    },
