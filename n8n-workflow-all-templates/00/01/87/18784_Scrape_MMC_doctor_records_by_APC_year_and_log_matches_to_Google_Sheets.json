      "name": "Update and Save Progress",
      "type": "n8n-nodes-base.code",
      "position": [
        2944,
        1024
      ],
      "parameters": {
        "jsCode": "// Simpan progress SETELAH tiap dokter (jaga-jaga kalau workflow terhenti/error di tengah jalan).\nconst staticData = $getWorkflowStaticData('global');\nconst prev = $('Match Check & Extract Data').first().json;\nconst matchesFoundToday = prev.matchesFoundToday + (prev.isMatch ? 1 : 0);\nconst nextRowIndex = prev.rowIndex + 1;\n\nstaticData.resumePage = prev.page;\nstaticData.resumeRowIndex = nextRowIndex;\n\nreturn [{ json: { ...prev, matchesFoundToday, rowIndex: nextRowIndex } }];"
