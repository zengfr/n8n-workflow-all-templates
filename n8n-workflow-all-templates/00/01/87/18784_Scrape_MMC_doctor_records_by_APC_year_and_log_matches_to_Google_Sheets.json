    {
      "id": "2fa21764-e759-4751-9618-27f4c6ca4521",
      "name": "Load Previous Progress",
      "type": "n8n-nodes-base.code",
      "position": [
        1184,
        1120
      ],
      "parameters": {
        "jsCode": "// Baca posisi terakhir dari run sebelumnya (persist otomatis oleh n8n).\n// Kalau ini run pertama kali, mulai dari halaman 1.\nconst sd = $getWorkflowStaticData('global');\nif (sd.resumePage === undefined) sd.resumePage = 1;\nif (sd.resumeRowIndex === undefined) sd.resumeRowIndex = 0;\n\nconst config = $input.first().json;\nreturn [{ json: {\n  page: sd.resumePage,\n  rowIndex: sd.resumeRowIndex,\n  matchesFoundToday: 0,\n  targetYear: config.targetYear,\n  dailyTarget: config.dailyTarget\n} }];"
      },
      "typeVersion": 2
    },
    {
      "id": "f54d1382-817b-486d-9189-d7da0bd217f9",
      "name": "Fetch Doctor Page",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1424,
        1120
      ],
      "parameters": {
        "url": "=https://merits.mmc.gov.my/search/registeredDoctor?name=&graduateFrom=&place-of-practice=&tindakanSiasatan=&full=&provisional=&tpc=&page={{ $json.page }}",
        "options": {}
      },
      "typeVersion": 4.2
    },
    {
      "id": "9fe34e43-f4b8-4d17-ac50-9f33f818a82a",
      "name": "Parse Doctor Rows",
      "type": "n8n-nodes-base.code",
      "position": [
        1616,
        1120
      ],
      "parameters": {
        "jsCode": "const html = $input.first().json.data || $input.first().json.body || $input.first().json;\nconst htmlStr = typeof html === 'string' ? html : JSON.stringify(html);\n\n// Total halaman: ambil angka page= terbesar dari link pagination\nconst pageNums = [...htmlStr.matchAll(/[?&]page=(\\d+)/g)].map(m => parseInt(m[1]));\nconst totalPages = pageNums.length ? Math.max(...pageNums) : 1;\n\n// Ambil tiap baris tabel hasil: No, Nama, Graduated From, doctorId (dari viewDoctor/{id}/search)\nconst rowRegex = /<tr>\\s*<td>\\d+<\\/td>\\s*<td>([^<]*)<\\/td>\\s*<td>([^<]*)<\\/td>\\s*<td>[\\s\\S]*?viewDoctor\\/(\\d+)\\/search/gi;\nconst rows = [];\nlet m;\nwhile ((m = rowRegex.exec(htmlStr)) !== null) {\n  rows.push({ name: m[1].trim(), graduatedFrom: m[2].trim(), doctorId: m[3] });\n}\n\nlet state;\ntry {\n  state = $('Proceed to Next Page').first().json;\n} catch (e) {\n  state = $('Load Previous Progress').first().json;\n}\nreturn [{ json: { ...state, rows, totalPages } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "34121a5c-2b34-4ad8-abb2-9bd8345a099e",
      "name": "Check More Rows",
      "type": "n8n-nodes-base.if",
      "position": [
        1824,
        1120
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "leftValue": "={{ $json.rowIndex }}",
              "rightValue": "={{ $json.rows.length }}"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "51b47ee1-5f53-4073-a284-39631e7625be",
      "name": "Fetch Doctor Details",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2048,
        1024
      ],
      "parameters": {
        "url": "=https://merits.mmc.gov.my/viewDoctor/{{ $json.rows[$json.rowIndex].doctorId }}/search",
        "options": {}
      },
      "typeVersion": 4.2
    },
    {
      "id": "1052dfd7-33e3-43ee-bc76-5f7171cfc774",
      "name": "Match Check & Extract Data",
      "type": "n8n-nodes-base.code",
      "position": [
        2256,
        1024
      ],
      "parameters": {
        "jsCode": "const html = $input.first().json.data || $input.first().json.body || $input.first().json;\nconst htmlStr = typeof html === 'string' ? html : JSON.stringify(html);\n\nconst getField = (label) => {\n  const re = new RegExp('>' + label.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&') + '\\\\s*</label>\\\\s*<div class=\"col-sm-6\">\\\\s*([\\\\s\\\\S]*?)\\\\s*</div>', 'i');\n  const mm = htmlStr.match(re);\n  return mm ? mm[1].replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim() : '';\n};\n\nconst fullName = getField('Full Name');\nconst qualification = getField('Qualification');\nconst dateProvisional = getField('Date of Provisional Registration');\nconst fullRegistrationNumber = getField('Full Registration Number');\n\n// Baris APC pertama (paling baru) di tabel: No=1, APC YEAR, APC NO, Place of Practice (Principle)\nconst apcRowMatch = htmlStr.match(/<td>1<\\/td>\\s*<td>(\\d{4})<\\/td>\\s*<td>[^<]*<\\/td>\\s*<td>([\\s\\S]*?)<\\/td>/i);\nconst apcYear = apcRowMatch ? apcRowMatch[1] : '';\nconst placeOfPractice = apcRowMatch\n  ? apcRowMatch[2].replace(/<br\\s*\\/?>/gi, ', ').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').replace(/(,\\s*)+/g, ', ').replace(/^,\\s*|,\\s*$/g, '').trim()\n  : '';\n\nconst state = $('Check More Rows').first().json;\nconst provYearMatch = dateProvisional.match(/\\d{4}/);\nconst provYear = provYearMatch ? provYearMatch[0] : '';\nconst isMatch = apcYear === String(state.targetYear);\n\nreturn [{ json: {\n  ...state,\n  fullName, qualification, dateProvisional, fullRegistrationNumber, apcYear, placeOfPractice, provYear, isMatch\n} }];"
      },
      "typeVersion": 2
    },
