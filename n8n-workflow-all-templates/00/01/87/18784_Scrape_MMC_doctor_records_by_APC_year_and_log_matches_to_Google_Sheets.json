      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst prev = $input.first().json;\nconst nextPage = prev.page + 1;\nconst exhausted = nextPage > prev.totalPages;\n\nif (!exhausted) {\n  staticData.resumePage = nextPage;\n  staticData.resumeRowIndex = 0;\n}\n\nreturn [{ json: { ...prev, page: nextPage, rowIndex: 0, exhausted } }];"
