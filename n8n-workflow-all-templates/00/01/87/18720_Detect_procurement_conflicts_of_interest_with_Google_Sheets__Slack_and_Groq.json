    {
      "id": "ea92ef98-603b-476b-bf65-aba804c19461",
      "name": "Find Potential Conflict Matches",
      "type": "n8n-nodes-base.code",
      "position": [
        1328,
        304
      ],
      "parameters": {
        "jsCode": "// Read directly from the source nodes so the logic stays dynamic\nconst employees = $items(\"Fetch Employee Data\").map(item => item.json);\nconst suppliers = $items(\"Fetch Supplier Data\").map(item => item.json);\n\nconst results = [];\nconst seenPairs = new Set();\n\n// ---------- Helpers ----------\nfunction normalizeText(value) {\n  return String(value ?? '')\n    .toLowerCase()\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction normalizePhone(value) {\n  return String(value ?? '').replace(/\\D/g, '');\n}\n\nfunction normalizeEmail(value) {\n  return String(value ?? '').toLowerCase().trim();\n}\n\nfunction getLastName(fullName) {\n  const parts = normalizeText(fullName).split(' ').filter(Boolean);\n  return parts.length ? parts[parts.length - 1] : '';\n}\n\nfunction safeNumber(value) {\n  const n = Number(value ?? 0);\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction getCity(address) {\n  const text = normalizeText(address);\n  if (!text) return '';\n  return text.split(',')[0].trim();\n}\n\n// ---------- Matching ----------\nfor (const emp of employees) {\n  const empId = String(emp.EmployeeID ?? '').trim();\n  const empName = normalizeText(emp.EmployeeName);\n  const empEmail = normalizeEmail(emp.EmployeeEmail);\n  const empPhone = normalizePhone(emp.EmployeePhone);\n  const empAddress = normalizeText(emp.EmployeeAddress);\n  const empCity = getCity(emp.EmployeeAddress);\n  const empLastName = getLastName(emp.EmployeeName);\n\n  for (const sup of suppliers) {\n    const supId = String(sup.SupplierID ?? '').trim();\n    const pairKey = `${empId}__${supId}`;\n    if (seenPairs.has(pairKey)) continue;\n    seenPairs.add(pairKey);\n\n    let score = 0;\n    const reasons = [];\n    const matchDetails = [];\n\n    const ownerName = normalizeText(sup.OwnerName);\n    const supEmail = normalizeEmail(sup.SupplierEmail);\n    const supPhone = normalizePhone(sup.SupplierPhone);\n    const supAddress = normalizeText(sup.SupplierAddress);\n    const supCity = getCity(sup.SupplierAddress);\n    const supLastName = getLastName(sup.OwnerName);\n\n    const txCount = safeNumber(sup.TransactionCount);\n    const totalSpend = safeNumber(sup.TotalSpend);\n\n    // 1. Strong direct signals\n    if (empName && ownerName && empName === ownerName) {\n      score += 50;\n      reasons.push('Employee full name matches supplier owner name');\n      matchDetails.push('full_name_exact');\n    }\n\n    if (empEmail && supEmail && empEmail === supEmail) {\n      score += 40;\n      reasons.push('Employee email matches supplier email');\n      matchDetails.push('email_exact');\n    }\n\n    if (empPhone && supPhone && empPhone === supPhone) {\n      score += 30;\n      reasons.push('Employee phone matches supplier phone');\n      matchDetails.push('phone_exact');\n    }\n\n    if (empAddress && supAddress && empAddress === supAddress) {\n      score += 25;\n      reasons.push('Employee address matches supplier address');\n      matchDetails.push('address_exact');\n    }\n\n    // 2. Medium / indirect signals\n    if (empLastName && supLastName && empLastName === supLastName && empName !== ownerName) {\n      score += 15;\n      reasons.push('Employee last name matches supplier owner last name');\n      matchDetails.push('last_name_match');\n    }\n\n    if (empCity && supCity && empCity === supCity && empAddress !== supAddress) {\n      score += 10;\n      reasons.push('Employee city matches supplier city');\n      matchDetails.push('city_match');\n    }\n\n    // 3. Transaction risk signals\n    if (txCount > 10 && totalSpend > 50000) {\n      score += 15;\n      reasons.push('Supplier has unusually high transaction activity');\n      matchDetails.push('high_transaction_activity');\n    } else if (txCount >= 5 && totalSpend >= 20000) {\n      score += 5;\n      reasons.push('Supplier has moderate transaction activity');\n      matchDetails.push('moderate_transaction_activity');\n    }\n\n    // 4. Decide risk level\n    let riskLevel = 'Low';\n    if (score >= 70) {\n      riskLevel = 'High';\n    } else if (score >= 40) {\n      riskLevel = 'Medium';\n    } else if (score >= 30) {\n      riskLevel = 'Low Review';\n    }\n\n    // 5. Output only cases worth reviewing\n    // Keep 30+ so medium and near-medium cases are visible for analysis\n    if (score >= 30) {\n      results.push({\n        json: {\n          Date: new Date().toISOString().split('T')[0],\n          EmployeeID: emp.EmployeeID ?? '',\n          EmployeeName: emp.EmployeeName ?? '',\n          EmployeeEmail: emp.EmployeeEmail ?? '',\n          EmployeePhone: emp.EmployeePhone ?? '',\n          EmployeeAddress: emp.EmployeeAddress ?? '',\n          Department: emp.Department ?? '',\n          SupplierID: sup.SupplierID ?? '',\n          SupplierName: sup.SupplierName ?? '',\n          OwnerName: sup.OwnerName ?? '',\n          SupplierEmail: sup.SupplierEmail ?? '',\n          SupplierPhone: sup.SupplierPhone ?? '',\n          SupplierAddress: sup.SupplierAddress ?? '',\n          TransactionCount: txCount,\n          TotalSpend: totalSpend,\n          RiskScore: score,\n          RiskLevel: riskLevel,\n          Reasons: reasons.join('; '),\n          MatchDetails: matchDetails.join(', '),\n          Status: 'Open'\n        }\n      });\n    }\n  }\n}\n\n// Optional: sort highest risk first\nresults.sort((a, b) => b.json.RiskScore - a.json.RiskScore);\n\nreturn results;"
      },
      "typeVersion": 2
    },
    {
      "id": "e3666dd9-3496-47c6-bad6-f0c4d83b1ec9",
