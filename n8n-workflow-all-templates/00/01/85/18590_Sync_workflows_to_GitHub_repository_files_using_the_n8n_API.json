      "position": [
        80,
        -128
      ],
      "parameters": {
        "color": 7,
        "width": 624,
        "height": 304,
        "content": "## Receive workflow request\n\nStarts when called by another workflow and normalizes the incoming workflow ID before using it to fetch the workflow from n8n."
      },
      "typeVersion": 1
    },
    {
      "id": "6ccc5e0e-3465-4406-b461-dddfdc473cdf",
      "name": "Sticky Note2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        752,
        -160
      ],
      "parameters": {
        "color": 7,
        "width": 416,
        "height": 320,
        "content": "## Prepare JSON export\n\nReduces the workflow data to the version-controlled properties and converts the cleaned object into a JSON file for GitHub."
      },
      "typeVersion": 1
    },
    {
      "id": "45b7942f-ce41-4cca-9bcf-867c207d9a85",
