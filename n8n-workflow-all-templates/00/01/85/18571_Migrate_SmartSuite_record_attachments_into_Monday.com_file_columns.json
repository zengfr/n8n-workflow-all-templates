    {
      "id": "93fec452-b06d-4330-905e-2dfcee2ab8f9",
      "name": "Extract files from records",
      "type": "n8n-nodes-base.code",
      "position": [
        2352,
        144
      ],
      "parameters": {
        "jsCode": "// Turn every file attached to every record into its own item\nconst fileFields = ($('Set config variables').first().json.smartsuite_file_field_slugs || '')\n  .split(',').map(s => s.trim()).filter(Boolean);\nconst results = [];\n\nfor (const item of $input.all()) {\n  const record = item.json;\n  for (const fieldSlug of fileFields) {\n    const fieldValue = record[fieldSlug];\n    if (Array.isArray(fieldValue)) {\n      for (const file of fieldValue) {\n        if (file && file.handle) {\n          results.push({\n            json: {\n              smartsuite_record_id: record.id,\n              record_title: record.title?.value || 'Unknown',\n              file_handle: file.handle,\n              file_name: file.metadata?.filename || 'file',\n              file_mimetype: file.metadata?.mimetype || 'application/octet-stream'\n            }\n          });\n        }\n      }\n    }\n  }\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
    {
      "id": "0d159d63-cfc7-4fb4-b33a-3b952a402053",
      "name": "Loop over files",
