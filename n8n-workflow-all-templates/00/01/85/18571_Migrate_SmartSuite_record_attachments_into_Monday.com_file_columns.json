      "type": "n8n-nodes-base.httpRequest",
      "position": [
        3072,
        160
      ],
      "parameters": {
        "url": "https://api.monday.com/v2",
        "method": "POST",
        "options": {},
        "jsonBody": "={\"query\": \"{ boards(ids: [{{ $('Set config variables').item.json.monday_board_id }}]) { items_page(limit: 1, query_params: { rules: [{ column_id: \\\"{{ $('Set config variables').item.json.monday_match_column_id }}\\\", compare_value: [\\\"{{ $json.smartsuite_record_id }}\\\"] }] }) { items { id name } } } }\"}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('Set config variables').item.json.monday_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "API-Version",
              "value": "2024-01"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "1e80142a-7fa7-454a-88d3-cde5d8a77c24",
      "name": "Extract Monday item ID",
      "type": "n8n-nodes-base.code",
      "position": [
        3312,
        160
      ],
      "parameters": {
        "jsCode": "// Read the matched Monday item and carry the file details forward.\n// Always return one item with a found flag so the loop never stalls on a miss.\nconst matches = $input.item.json?.data?.boards?.[0]?.items_page?.items || [];\nconst file = $('Loop over files').item.json;\n\nreturn [{\n  json: {\n    found: matches.length > 0,\n    monday_item_id: matches.length > 0 ? matches[0].id : null,\n    file_handle: file.file_handle,\n    file_name: file.file_name,\n    file_mimetype: file.file_mimetype\n  }\n}];"
      },
      "typeVersion": 2
    },
