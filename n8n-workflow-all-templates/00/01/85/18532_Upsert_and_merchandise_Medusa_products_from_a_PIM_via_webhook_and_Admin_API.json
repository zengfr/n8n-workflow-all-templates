      ],
      "parameters": {
        "color": 7,
        "width": 976,
        "height": 304,
        "content": "## Receive and validate launch\n\nReceives the incoming PIM product launch request, validates the payload, looks up the product by handle, and decides whether the flow should update or create a product."
      },
      "typeVersion": 1
    },
