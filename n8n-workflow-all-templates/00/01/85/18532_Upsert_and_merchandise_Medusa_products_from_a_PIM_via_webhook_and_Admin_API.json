    {
      "id": "b6b25ea2-cfaf-49a9-908f-0cc54f9e7ca9",
      "name": "Validate Launch Payload",
      "type": "n8n-nodes-base.code",
      "position": [
        2736,
        992
      ],
      "parameters": {
        "jsCode": "const request = $input.first().json;\nconst body = request.body ?? request;\nconst required = ['title', 'handle', 'variant_title', 'sku', 'currency_code', 'amount', 'category_id', 'collection_id', 'sales_channel_id'];\nfor (const field of required) {\n  if (body[field] === undefined || body[field] === null || String(body[field]).trim() === '') {\n    throw new Error(field + ' is required');\n  }\n}\nconst amount = Number(body.amount);\nif (!Number.isFinite(amount) || amount < 0) throw new Error('amount must be a non-negative number');\nconst status = body.status ?? 'draft';\nif (!['draft', 'proposed', 'published', 'rejected'].includes(status)) throw new Error('status is invalid');\nreturn [{ json: {\n  title: String(body.title).trim(),\n  handle: String(body.handle).trim(),\n  description: String(body.description ?? '').trim(),\n  external_id: String(body.external_id ?? '').trim(),\n  status,\n  variant_title: String(body.variant_title).trim(),\n  sku: String(body.sku).trim(),\n  currency_code: String(body.currency_code).trim().toLowerCase(),\n  amount,\n  category_id: String(body.category_id).trim(),\n  collection_id: String(body.collection_id).trim(),\n  sales_channel_id: String(body.sales_channel_id).trim(),\n}, pairedItem: { item: 0 } }];"
      },
      "typeVersion": 2
    },
