        560,
        16
      ],
      "parameters": {
        "color": 7,
        "height": 368,
        "content": "## Daily workflow trigger\n\nStarts the automation on a daily 9am schedule and fans out execution into the two data collection branches."
      },
      "typeVersion": 1
    },
