    {
      "id": "4f121f92-7926-4b55-b28a-95999478386d",
      "name": "Write Article and Title",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1280,
        0
      ],
      "parameters": {
        "text": "=Write an SEO-friendly blog article in {{ $('Configuration').item.json.output_language }} about:\n{{ $('Get Unprocessed Idea').item.json.PROMPT }}\n\nUse this up-to-date research to keep facts accurate and current:\n{{ $('Research Topic with Perplexity').item.json.choices[0].message.content }}",
        "options": {
          "systemMessage": "=You are an expert SEO copywriter. Write an article between {{ $('Configuration').item.json.article_min_words }} and {{ $('Configuration').item.json.article_max_words }} words.\nInstructions:\n- Introduction of about 120 words that introduces the topic.\n- 4-5 chapters that follow a logical, connected flow (no isolated blocks). Never label them 'Chapter 1', 'Chapter 2', etc. - use real chapter titles.\n- Conclusion of about 120 words summarizing the article.\n- Go deep on the subject, avoid superficial filler.\n- Format the body using HTML: paragraphs, bold, italics and lists only. No markdown, no code fences.\n- Ground factual claims in the research provided; do not contradict it."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3.1
    },
