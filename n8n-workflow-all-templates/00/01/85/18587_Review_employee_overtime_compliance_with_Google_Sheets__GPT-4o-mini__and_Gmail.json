      "parameters": {
        "sendTo": "user@example.com",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width:600px; margin:0 auto;\">\n  <div style=\"background-color:{{ $json.StatusColor }}; color:#ffffff; padding:16px 20px; border-radius:6px 6px 0 0;\">\n    <h2 style=\"margin:0; font-size:18px;\">{{ $json.StatusLabel }}</h2>\n  </div>\n  <div style=\"border:1px solid #e0e0e0; border-top:none; padding:20px; background:#ffffff;\">\n    <table style=\"width:100%; border-collapse:collapse; margin-bottom:16px;\">\n      <tr><td style=\"padding:6px 0; color:#555;\">Employee</td><td style=\"padding:6px 0; font-weight:bold;\">{{ $json.EmployeeName }}</td></tr>\n      <tr><td style=\"padding:6px 0; color:#555;\">Department</td><td style=\"padding:6px 0;\">{{ $json.Department }}</td></tr>\n      <tr><td style=\"padding:6px 0; color:#555;\">Total Hours This Week</td><td style=\"padding:6px 0;\">{{ $json.TotalHours }}</td></tr>\n      <tr><td style=\"padding:6px 0; color:#555;\">Overtime Hours</td><td style=\"padding:6px 0;\">{{ $json.OvertimeHours }}</td></tr>\n    </table>\n    <div style=\"background:#f7f7f7; border-left:4px solid {{ $json.StatusColor }}; padding:12px 16px; border-radius:4px; margin-bottom:16px;\">\n      <p style=\"margin:0; color:#333; line-height:1.5;\">{{ $json.EmailBody }}</p>\n    </div>\n    <p style=\"color:#888; font-size:12px; margin:0;\">Automatically sent via n8n — Employee Timesheet & Overtime Compliance Checker</p>\n  </div>\n</div>",
        "options": {
