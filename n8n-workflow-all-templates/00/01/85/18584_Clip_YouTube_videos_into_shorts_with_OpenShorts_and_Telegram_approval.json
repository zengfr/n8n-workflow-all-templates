    {
      "id": "note-act4",
      "name": "Act 4 note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -560,
        1260
      ],
      "parameters": {
        "color": 7,
        "width": 400,
        "height": 340,
        "content": "## ACT 4 — The feedback loop: learn what worked\n\nOnce a week the machine reads the analytics of everything it published (via the OpenShorts analytics API, which aggregates TikTok/Instagram/YouTube numbers) and sends you the verdict: total impressions, per-platform split, and your best post.\n\nThe machine that posts is the machine that measures — so every approval you make next week is informed by what actually landed. Close the loop further by feeding your winners back as examples in your clip prompts."
      },
      "typeVersion": 1
    },
    {
      "id": "weekly-schedule",
      "name": "Every Sunday 18:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        -80,
        1360
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                0
              ],
              "triggerAtHour": 18
            }
          ]
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "weekly-impressions",
      "name": "Weekly impressions",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        200,
        1360
      ],
      "parameters": {
        "url": "https://api.openshorts.app/api/social/analytics/impressions",
        "options": {},
        "sendQuery": true,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "queryParameters": {
          "parameters": [
            {
              "name": "period",
              "value": "last_week"
            },
            {
              "name": "breakdown",
              "value": "true"
            }
