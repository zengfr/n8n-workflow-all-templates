          "name": "Telegram bot"
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "note-act2",
      "name": "Act 2 note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -560,
        340
      ],
      "parameters": {
        "color": 7,
        "width": 400,
        "height": 380,
        "content": "## ACT 2 — Clips arrive on your phone\n\n**No polling, no Wait-node loop.** OpenShorts calls this webhook once per job (success **and** failure, so nothing ever hangs). Each finished 9:16 clip lands in your Telegram with two buttons: ✅ publish or ❌ skip — a human approves every post, which is also what keeps you on the right side of YouTube's inauthentic-content policy.\n\n**Setup**: copy the **production** URL of the *Clips ready* webhook node and paste it as `webhook_url` inside *Start OpenShorts job*. Telegram fetches videos by URL up to ~20 MB; bigger clips fall back to a message with the download link and the same buttons."
      },
      "typeVersion": 1
    },
    {
      "id": "clips-webhook",
      "name": "Clips ready (webhook)",
      "type": "n8n-nodes-base.webhook",
      "position": [
        -80,
        440
      ],
      "webhookId": "30f3bc66-1f03-4d2f-94b8-aed49571238d",
      "parameters": {
        "path": "openshorts-machine-clips",
        "options": {},
        "httpMethod": "POST"
      },
      "typeVersion": 2
    },
    {
      "id": "if-completed",
      "name": "Job completed?",
      "type": "n8n-nodes-base.if",
      "position": [
        200,
        440
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "job.completed"
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "split-clips",
      "name": "One item per clip",
      "type": "n8n-nodes-base.code",
      "position": [
        360,
        380
      ],
      "parameters": {
        "jsCode": "// One Telegram message per clip, carrying everything the approval\n// buttons need inside callback_data (Telegram caps it at 64 bytes:\n// action|job_id|clip_index fits).\nconst body = $json.body;\nreturn (body.clips || []).map((clip, i) => ({\n  json: {\n    job_id: body.job_id,\n    clip_index: i,\n    title: clip.title || `Clip ${i + 1}`,\n    download_url: clip.download_url || clip.video_url,\n  },\n}));"
      },
      "typeVersion": 2
    },
    {
      "id": "tg-clip-video",
      "name": "Send clip for approval",
      "type": "n8n-nodes-base.telegram",
      "onError": "continueErrorOutput",
      "position": [
        580,
        380
      ],
      "parameters": {
        "file": "={{ $json.download_url }}",
        "chatId": "={{ $('Settings (clips)').first().json.telegram_chat_id }}",
        "operation": "sendVideo",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Publish",
                    "additionalFields": {
                      "callback_data": "=pub|{{ $json.job_id }}|{{ $json.clip_index }}"
                    }
                  },
                  {
                    "text": "❌ Skip",
                    "additionalFields": {
                      "callback_data": "skip"
                    }
                  }
                ]
              }
