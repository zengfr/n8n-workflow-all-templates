    {
      "id": "write-digest",
      "name": "Write the digest",
      "type": "n8n-nodes-base.code",
      "position": [
        580,
        1360
      ],
      "parameters": {
        "jsCode": "// Turn the two analytics responses into one human digest message.\nconst impressions = $('Weekly impressions').first().json || {};\nconst postsResp = $input.first().json || {};\nconst posts = postsResp.posts || postsResp.data || postsResp.items || [];\n\nconst views = (post) => {\n  const m = post.post_metrics || post.metrics || post;\n  return Number(m.views || m.impressions || m.plays || 0);\n};\n\nconst total = impressions.total_impressions || posts.reduce((s, p) => s + views(p), 0);\nconst sorted = [...posts].sort((a, b) => views(b) - views(a));\nconst best = sorted[0];\n\nconst perPlatform = impressions.per_platform\n  ? Object.entries(impressions.per_platform)\n      .map(([p, v]) => `  • ${p}: ${Number(v).toLocaleString('en-US')}`)\n      .join('\\n')\n  : '';\n\nlet text = `📊 Your week on autopilot\\n\\n`;\ntext += `Posts published: ${posts.length}\\n`;\ntext += `Total impressions: ${Number(total).toLocaleString('en-US')}\\n`;\nif (perPlatform) {\n  text += `${perPlatform}\\n`;\n}\nif (best && views(best) > 0) {\n  const title = best.title || best.caption || best.platform_post_id || 'your top post';\n  text += `\\n🏆 Best post: \"${title}\" — ${views(best).toLocaleString('en-US')} views`;\n}\nif (posts.length === 0) {\n  text += `\\nNothing published this week. Approve some clips and the machine does the rest.`;\n}\nreturn [{ json: { digest: text } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "tg-digest",
      "name": "Send weekly digest",
      "type": "n8n-nodes-base.telegram",
      "position": [
        800,
        1360
      ],
      "parameters": {
        "text": "={{ $json.digest }}",
