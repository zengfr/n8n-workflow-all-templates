      "parameters": {
        "url": "https://api.openshorts.app/api/social/analytics/posts",
        "options": {},
        "sendQuery": true,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
