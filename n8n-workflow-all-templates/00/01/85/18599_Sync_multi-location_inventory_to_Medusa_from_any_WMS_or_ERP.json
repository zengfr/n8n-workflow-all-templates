  "nodes": [
    {
      "id": "b4e6d001-d88e-4483-844a-ba756b6f1169",
      "name": "When Stock Feed Received",
      "type": "n8n-nodes-base.webhook",
      "position": [
        2464,
        992
      ],
      "webhookId": "de8a2461-d85d-4bcd-a08d-2472fbe73743",
      "parameters": {
        "path": "medusa-inventory-sync",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "a8c62cd5-6308-437b-9609-3e8d18391ad9",
      "name": "Validate Stock Feed",
      "type": "n8n-nodes-base.code",
      "position": [
        2736,
        992
      ],
      "parameters": {
        "jsCode": "const request = $input.first().json;\nconst body = request.body ?? request;\nconst locationId = String(body.stock_location_id ?? '').trim();\nconst rows = body.items;\n\nif (!locationId) throw new Error('stock_location_id is required');\nif (!Array.isArray(rows) || rows.length === 0) throw new Error('items must be a non-empty array');\n\nreturn rows.map((row, index) => {\n  const sku = String(row.sku ?? '').trim();\n  const quantity = Number(row.stocked_quantity);\n  if (!sku) throw new Error('Row ' + (index + 1) + ': sku is required');\n  if (!Number.isInteger(quantity) || quantity < 0) {\n    throw new Error('Row ' + (index + 1) + ': stocked_quantity must be a non-negative integer');\n  }\n  return {\n    json: {\n      row: index + 1,\n      sku,\n      stocked_quantity: quantity,\n      stock_location_id: locationId,\n    },\n    pairedItem: { item: 0 },\n  };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "6563b4e3-b983-462d-a652-186b5442f1db",
      "name": "Fetch Inventory Item by SKU",
      "type": "@blackswampai/n8n-nodes-medusa.medusa",
      "position": [
        2992,
        992
      ],
      "parameters": {
        "limit": 1,
        "filters": {
          "sku": "={{ $json.sku }}"
        },
        "options": {
          "fields": "id,sku"
        },
        "resource": "inventoryItem"
      },
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
