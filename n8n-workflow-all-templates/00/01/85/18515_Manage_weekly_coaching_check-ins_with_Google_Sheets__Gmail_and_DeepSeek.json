        "formFields": {
          "values": [
            {
              "fieldName": "client_email",
              "fieldType": "email",
              "fieldLabel": "Your email (the one your coach uses)",
              "placeholder": "you@example.com",
              "requiredField": true
            },
            {
              "fieldName": "client_name",
              "fieldLabel": "Your name",
              "requiredField": true
            },
            {
              "fieldName": "energy",
              "fieldType": "dropdown",
              "fieldLabel": "Energy level this week",
              "fieldOptions": {
                "values": [
                  {
                    "option": "1 - Exhausted"
                  },
                  {
                    "option": "2 - Low"
                  },
                  {
                    "option": "3 - Okay"
                  },
                  {
                    "option": "4 - Good"
                  },
                  {
                    "option": "5 - Full of energy"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldName": "sleep",
              "fieldType": "dropdown",
              "fieldLabel": "How was your sleep",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Poor"
                  },
                  {
                    "option": "Fair"
                  },
                  {
                    "option": "Good"
                  },
                  {
                    "option": "Great"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldName": "workouts",
              "fieldType": "number",
              "fieldLabel": "Workouts completed this week",
              "placeholder": "e.g. 3",
              "requiredField": true
            },
            {
              "fieldName": "weight",
              "fieldType": "number",
              "fieldLabel": "Weight today (optional)",
              "placeholder": "e.g. 72.5"
            },
            {
              "fieldName": "mood",
              "fieldType": "dropdown",
              "fieldLabel": "Overall mood",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Low"
                  },
                  {
                    "option": "Okay"
                  },
                  {
                    "option": "Good"
                  },
                  {
                    "option": "Great"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldName": "notes",
              "fieldType": "textarea",
              "fieldLabel": "Anything else to share"
            }
