    {
      "id": "ck-agent",
      "name": "AI Check-in Coach",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1280,
        16
      ],
      "parameters": {
        "text": "={{ 'Review this weekly check-in for ' + JSON.stringify($json) + '. Use the Client Roster tool to find the client and read their goal and plan. Return ONLY valid JSON with keys: found (boolean, false when the email is not in the roster), adherence_score (number 0-100), needs_attention (boolean, true when adherence is below 60 or energy is 2 or lower or mood is Low or workouts are 0 for two or more weeks in a row), reply_subject (string, under 10 words), reply_body (string, 3-5 warm sentences: acknowledge the week, give one specific coaching tip based on the goal, end with one question or focus for next week, no markdown, no emojis), coaching_note (string, 1-2 sentences for the coach only, empty when there is nothing to flag).' }}",
        "options": {
          "systemMessage": "You are a caring online fitness coach. Clients submit a weekly check-in with energy, sleep, workouts, weight, mood and notes. The recent history field shows their previous check-ins. Review the check-in against the client's goal, plan and recent history, then write a short personal reply. Be specific, warm and encouraging. Always return valid JSON only, no code fences."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
