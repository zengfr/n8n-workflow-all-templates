    {
      "id": "swp-code",
      "name": "Build Missed List",
      "type": "n8n-nodes-base.code",
      "position": [
        512,
        800
      ],
      "parameters": {
        "jsCode": "const clients = $input.all().map(i => i.json);\nconst checkins = $('Read This Week Check-ins').all().map(i => i.json);\nconst weekAgo = Date.now() - 7 * 24 * 3600 * 1000;\nconst submitted = new Set();\nfor (const c of checkins) {\n  const t = new Date(String(c.received_at || '')).getTime();\n  if (!isNaN(t) && t >= weekAgo) {\n    submitted.add(String(c.client_email || '').trim().toLowerCase());\n  }\n}\nconst missed = clients\n  .filter(c => String(c.status || '') === 'active')\n  .filter(c => !submitted.has(String(c.client_email || '').trim().toLowerCase()))\n  .map(c => ({ client_name: c.client_name, client_email: c.client_email }));\nreturn [{ json: { missed_count: missed.length, missed_list: missed } }];"
      },
      "typeVersion": 2
    },
