              "name": "today_message",
              "type": "string",
              "value": "={{\n(() => {\n  const src = $('Prepare Study Plan Entry').item.json;\n  let plan = [];\n  try { plan = JSON.parse(src.daily_plan || '[]'); } catch (e) { plan = []; }\n  const today = $now.setZone('Africa/Casablanca').toFormat('yyyy-MM-dd');\n  const day = plan.find(d => d && d.date === today) || plan[0];\n  if (!day) { return 'No study plan could be generated. Please resend your exam details (subject, date, chapters, hours per day).'; }\n  const blocks = (day.blocks || []).map((b, i) => {\n    return [\n      (i + 1) + '. ' + (b.start_label || ('Block ' + (i + 1))) + ' - ' + (b.topic || 'Study'),\n      '   Time: ' + (b.minutes || 0) + ' min',\n      '   Task: ' + (b.task || ''),\n      '   Method: ' + (b.method || '')\n    ].join('\\n');\n  }).join('\\n\\n');\n  const tasks = (day.tasks || []).map((t, i) => (i + 1) + '. ' + t).join('\\n');\n  const msg = [\n    'STUDY PLAN - TODAY',\n    '',\n    'Subject: ' + src.subject,\n    'Date: ' + (day.date || today),\n    'Exam in: ' + src.days_remaining + ' day(s)',\n    'Priority: ' + (src.priority || 'NORMAL'),\n    'Focus: ' + (day.focus || ''),\n    'Total study time: ' + (day.total_minutes || 0) + ' min (breaks not included)',\n    '',\n    blocks || tasks || 'No blocks generated.',\n    '',\n    'Checklist:',\n    tasks || '-',\n    '',\n    'Before you stop: close everything and rewrite the day from memory in 5 minutes.'\n  ].join('\\n');\n  return msg.length > 3900 ? msg.slice(0, 3880) + '\\n... (truncated)' : msg;\n})()\n}}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
