    {
      "id": "85e3f649-cc42-41cc-9b60-a3f87ccb4ce3",
      "name": "Extract Exam Details AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "maxTries": 3,
      "position": [
        15200,
        3136
      ],
      "parameters": {
        "text": "=You are a strict information extractor for an exam study-planner. Return JSON only.\n\nTODAY IS: {{ $now.setZone('Africa/Casablanca').toFormat('yyyy-MM-dd') }} ({{ $now.setZone('Africa/Casablanca').toFormat('cccc') }})\n\nSTUDENT MESSAGE:\n\"\"\"\n{{ $json.request }}\n\"\"\"\n\nRULES\n1. exam_date MUST be ISO format yyyy-MM-dd. Resolve relative dates (\"next Friday\", \"in 3 weeks\", \"after 10 days\") against TODAY above.\n2. chapters: return each topic as a separate string. If the student only gives a count (\"5 chapters\"), return [\"Chapter 1\",\"Chapter 2\",...] up to that count.\n3. hours_per_day: a number between 0.5 and 8. If a range is given (\"2 to 3 hours\"), take the LOWER value. If nothing is said, leave it as 0 and add \"hours_per_day\" to missing_fields.\n4. subject: the exam subject only (e.g. \"Mathematics\"), not the whole sentence.\n5. missing_fields: list ONLY genuinely absent fields, using exactly these strings: \"subject\", \"exam_date\", \"chapters\", \"hours_per_day\". Return an empty array if nothing is missing.\n6. NEVER invent a subject, a date or chapters. If it is not in the message, it goes to missing_fields and the field stays empty.",
        "batching": {},
        "promptType": "define",
        "hasOutputParser": true
      },
      "retryOnFail": true,
      "typeVersion": 1.7,
      "waitBetweenTries": 2000
    },
    {
      "id": "116f96d7-054a-411e-846c-a0a36f3cb554",
      "name": "Parse Exam Details",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        15440,
        3344
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"properties\": {\"subject\": {\"type\": \"string\"}, \"exam_date\": {\"type\": \"string\"}, \"chapters\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"hours_per_day\": {\"type\": \"number\"}, \"missing_fields\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"subject\", \"exam_date\", \"chapters\", \"hours_per_day\", \"missing_fields\"], \"additionalProperties\": false}"
      },
      "typeVersion": 1.3
    },
    {
      "id": "c910db14-6c97-4fea-8e5f-412d0bc13467",
      "name": "Calculate Remaining Days",
      "type": "n8n-nodes-base.set",
      "position": [
        15504,
        3136
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "a00-subject",
              "name": "=subject",
              "type": "string",
              "value": "={{ $('Extract Exam Details AI').item.json.output.subject }}"
            },
            {
              "id": "a01-exam_date",
              "name": "exam_date",
              "type": "string",
              "value": "={{ $('Extract Exam Details AI').item.json.output.exam_date }}"
            },
            {
              "id": "a02-chapters",
              "name": "chapters",
              "type": "string",
              "value": "={{ ($('Extract Exam Details AI').item.json.output.chapters || []).join(', ') }}"
            },
            {
              "id": "a03-hours_per_day",
              "name": "hours_per_day",
              "type": "number",
              "value": "={{ Math.min(8, Math.max(0.5, Number($('Extract Exam Details AI').item.json.output.hours_per_day) || 0)) }}"
            },
            {
              "id": "a04-today",
              "name": "today",
              "type": "string",
              "value": "={{ $now.setZone('Africa/Casablanca').toFormat('yyyy-MM-dd') }}"
            },
            {
              "id": "a05-days_remaining",
              "name": "days_remaining",
              "type": "number",
              "value": "={{ Math.max(0, Math.ceil(DateTime.fromISO($('Extract Exam Details AI').item.json.output.exam_date, { zone: 'Africa/Casablanca' }).endOf('day').diff($now.setZone('Africa/Casablanca'), 'days').days)) }}"
            },
            {
              "id": "a06-missing_fields",
              "name": "missing_fields",
              "type": "string",
              "value": "={{ ($('Extract Exam Details AI').item.json.output.missing_fields || []).join(', ') }}"
            },
            {
              "id": "a07-chat_id",
              "name": "chat_id",
              "type": "string",
              "value": "={{ $('Set Study Details').item.json.chat_id }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "6b28627a-101c-4e63-b148-a376c7783d52",
      "name": "If Missing Information",
      "type": "n8n-nodes-base.if",
      "position": [
        15728,
        3136
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "or",
          "conditions": [
