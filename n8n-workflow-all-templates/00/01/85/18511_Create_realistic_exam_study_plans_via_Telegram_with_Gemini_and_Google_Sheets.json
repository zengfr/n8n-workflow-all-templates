              "id": "c-past",
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "leftValue": "={{ $json.days_remaining }}",
              "rightValue": 1
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
