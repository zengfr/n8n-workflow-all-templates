    {
      "id": "1a5d90b1-536a-449e-9d63-4840fda4d855",
      "name": "Format comments into text",
      "type": "n8n-nodes-base.code",
      "position": [
        3520,
        160
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const comments = item.json.results || [];\n  if (comments.length === 0) continue;\n\n  const smartsuite_record_id = comments[0]?.record || '';\n  let archiveText = '';\n\n  for (const comment of comments) {\n    const dateRaw = comment.created_on || '';\n    let date = 'Unknown Date';\n    if (dateRaw) {\n      try { date = new Date(dateRaw).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }); }\n      catch(e) { date = dateRaw; }\n    }\n\n    // First, build the text from the rich content blocks\n    let text = '';\n    try {\n      for (const block of (comment.message?.data?.content || [])) {\n        for (const el of (block.content || [])) {\n          if (el.type === 'text') text += el.text || '';\n          if (el.type === 'mention') text += `@${el.attrs?.title || ''}`;\n        }\n        text += ' ';\n      }\n    } catch(e) {}\n\n    // Fall back to the plain-text preview if no content blocks were found\n    if (!text.trim()) {\n      text = comment.message?.preview || '';\n      text = text.replace(/<[^>]*>/g, ' ');\n    }\n\n    text = text.replace(/\\s+/g, ' ').trim();\n    if (!text) continue;\n    if (text.length > 150) text = text.substring(0, 150) + '...';\n\n    archiveText += `[${date}] ${text}\\n`;\n  }\n\n  if (archiveText.length > 1900) {\n    archiveText = archiveText.substring(0, 1900) + '\\n...truncated';\n  }\n\n  results.push({ \n    json: { \n      archive_text: archiveText, \n      smartsuite_record_id, \n      comment_count: comments.length \n    } \n  });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
    {
      "id": "1ff1bc91-2dfe-4abe-8f92-97ccc824aa48",
      "name": "Extract Monday item ID",
      "type": "n8n-nodes-base.code",
      "position": [
        4160,
        160
      ],
      "parameters": {
        "jsCode": "const findItems = $input.all();\nconst formatItems = $('Format comments into text').all();\nconst results = [];\n\nfor (let i = 0; i < findItems.length; i++) {\n  const boards = findItems[i].json?.data?.boards?.[0]?.items_page?.items || [];\n  if (boards.length === 0) continue;\n  \n  const archiveText = formatItems[i]?.json?.archive_text || '';\n  \n  results.push({\n    json: {\n      monday_item_id: boards[0].id,\n      archive_text: archiveText\n    }\n  });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
