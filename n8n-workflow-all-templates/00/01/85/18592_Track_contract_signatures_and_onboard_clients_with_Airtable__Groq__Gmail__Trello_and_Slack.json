      "parameters": {
        "color": 7,
        "width": 864,
        "height": 384,
        "content": "## Webhook validation intake\n\nReceives contract signature webhook events, loads shared configuration, verifies the shared secret, and gates invalid requests before any CRM changes occur."
      },
      "typeVersion": 1
    },
