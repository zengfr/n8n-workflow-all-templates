        "jsCode": "const cutoff = new Date($('Set Stale Contract Configs').first().json.cutoff_date);\n\nreturn $input.all().filter(item => {\n  const lastUpdate = new Date(item.json.last_status_update);\n  return lastUpdate < cutoff;\n});"
