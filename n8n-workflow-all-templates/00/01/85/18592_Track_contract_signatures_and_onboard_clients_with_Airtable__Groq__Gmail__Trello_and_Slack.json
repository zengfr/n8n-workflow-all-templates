    {
      "id": "95990aec-a026-4a52-880a-a17a731111d7",
      "name": "Verify Webhook Shared Secret",
      "type": "n8n-nodes-base.code",
      "position": [
        1072,
        368
      ],
      "parameters": {
        "jsCode": "const webhookData = $('When Contract Signed').first().json;\nconst config = $('Set Initial Configurations').first().json;\n\nconst receivedToken = webhookData.headers['x-webhook-secret'] || webhookData.query.token;\nconst isValid = receivedToken === config.shared_secret_token;\n\nconst event = Array.isArray(webhookData.body) ? webhookData.body[0] : webhookData.body;\nconst data = event && event.data ? event.data : {};\nconst recipient = (data.recipients && data.recipients[0]) || {};\n\nreturn [{\n  json: {\n    is_valid: isValid,\n    document_id: data.id || '',\n    contract_status: data.status || '',\n    client_name: recipient.first_name || '',\n    client_email: recipient.email || '',\n    contract_amount: Number(data.pricing && data.pricing.total ? data.pricing.total : 0),\n    service_details: data.name || ''\n  }\n}];"
      },
      "typeVersion": 2
    },
