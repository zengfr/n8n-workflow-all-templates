    {
      "id": "c42fb250-170a-4edd-8b08-731573614c20",
      "name": "When Lead Form Submitted",
      "type": "n8n-nodes-base.webhook",
      "position": [
        48,
        1024
      ],
      "webhookId": "28ac7d6e-6f18-4f7b-9353-25b4f78f5ba5",
      "parameters": {
        "path": "new-lead-form",
        "options": {},
        "httpMethod": "POST"
      },
      "typeVersion": 2
    },
    {
      "id": "519d2b56-a455-4711-9943-456e63600b6c",
      "name": "Initialize Workflow Variables",
      "type": "n8n-nodes-base.code",
      "position": [
        240,
        1024
      ],
      "parameters": {
        "jsCode": "return [{\n  json: {\n    slackAlertChannelId: 'REPLACE_WITH_SLACK_ALERT_CHANNEL_ID',\n    slackReviewChannelId: 'REPLACE_WITH_SLACK_REVIEW_CHANNEL_ID',\n    notionDatabaseId: 'REPLACE_WITH_NOTION_DATABASE_ID',\n    googleSheetId: 'REPLACE_WITH_GOOGLE_SHEET_ID',\n    sdrEmails: ['sdr1@REPLACE_WITH_YOUR_DOMAIN.com', 'sdr2@REPLACE_WITH_YOUR_DOMAIN.com', 'sdr3@REPLACE_WITH_YOUR_DOMAIN.com']\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "b9473318-8fbf-4235-8b5d-b0414b75e04b",
      "name": "Classify Lead Email Domain",
      "type": "n8n-nodes-base.code",
      "position": [
        464,
        1024
      ],
      "parameters": {
        "jsCode": "// Classify the lead's email domain — no external API, so this never fails or costs anything.\nconst freeProviders = ['gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 'icloud.com', 'aol.com', 'protonmail.com', 'live.com'];\n\nconst lead = $('When Lead Form Submitted').item.json.body || $('When Lead Form Submitted').item.json;\nconst config = $('Initialize Workflow Variables').first().json;\n\nconst email = lead.email || '';\nconst domain = email.split('@')[1]?.toLowerCase() || '';\nconst domainType = freeProviders.includes(domain) ? 'personal' : 'business';\n\nreturn [{\n  json: {\n    name: lead.name || 'Unknown',\n    email,\n    company: lead.company || '',\n    message: lead.message || '',\n    domain,\n    domainType,\n    ...config\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "6e804fa1-d670-4764-b12c-4b8f17cafb81",
      "name": "OpenAI Lead Scoring",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        688,
        1024
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a sales lead qualification assistant. Given a new lead's details, assess how promising this lead is. Respond ONLY with valid JSON (no markdown, no code fences) in this exact shape:\n{\n  \"leadScore\": a number from 0 to 100,\n  \"tier\": \"hot\" | \"warm\" | \"cold\",\n  \"reasoning\": \"a one to two sentence explanation\",\n  \"suggestedNextStep\": \"a short suggested action for the sales rep\"\n}\nA business email domain (not a free personal provider) is a positive signal. A message that mentions budget, timeline, team size, or a specific business need is a strong positive signal. A vague, very short, or clearly spam-like message is a negative signal."
            },
            {
              "role": "user",
              "content": "=Name: {{ $json.name }}\nCompany: {{ $json.company }}\nEmail domain type: {{ $json.domainType }}\nMessage: {{ $json.message }}"
            }
          ]
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      },
      "typeVersion": 1.3
    },
    {
      "id": "1680ef2d-603e-46d3-82eb-5377dd9ceda7",
      "name": "Parse AI Scoring Result",
      "type": "n8n-nodes-base.code",
      "position": [
        912,
        1024
      ],
      "parameters": {
        "jsCode": "// Parse the AI response; fall back to a review-needed flag if it doesn't parse.\nconst raw = $input.first().json.message?.content ?? $input.first().json.text ?? $input.first().json.output ?? '';\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n  parsed.parseFailed = false;\n} catch (e) {\n  parsed = {\n    leadScore: 0,\n    tier: 'warm',\n    reasoning: '',\n    suggestedNextStep: '',\n    parseFailed: true\n  };\n}\n\nconst lead = $('Classify Lead Email Domain').first().json;\n\nreturn [{\n  json: {\n    ...lead,\n    ...parsed\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "f7f909ff-39cc-4859-bcca-a9d59683e353",
      "name": "Check AI Parsing Success",
      "type": "n8n-nodes-base.if",
      "position": [
        1152,
        1024
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-parse-fail",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.parseFailed }}",
              "rightValue": true
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "c4a0b388-572c-4c85-9763-f484a69454d4",
      "name": "Send Slack Alert for Review",
      "type": "n8n-nodes-base.slack",
      "position": [
        1376,
        880
      ],
      "webhookId": "36b34012-ee71-42a2-98f1-6059a987c0fb",
      "parameters": {
        "text": "=⚠️ *Could not score this lead — needs manual review*\n*Name:* {{ $json.name }}\n*Email:* {{ $json.email }}\n*Company:* {{ $json.company }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.slackReviewChannelId }}"
        },
        "otherOptions": {}
      },
      "typeVersion": 2.2
    },
    {
      "id": "52b7e25a-6dc8-480c-8000-75ab861d2a1d",
      "name": "If Hot Lead Score",
      "type": "n8n-nodes-base.if",
      "position": [
        1376,
        1152
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-hot",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.tier }}",
              "rightValue": "hot"
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "f467f6a3-90a6-4fe6-a3f6-f13fded48579",
      "name": "Assign SDR Round Robin",
      "type": "n8n-nodes-base.code",
      "position": [
        1600,
        1024
      ],
      "parameters": {
        "jsCode": "// Round-robin: cycle through the SDR list evenly using a shared counter.\nconst staticData = $getWorkflowStaticData('global');\nif (staticData.sdrIndex === undefined) staticData.sdrIndex = 0;\n\nconst item = $input.first().json;\nconst sdrList = item.sdrEmails || [];\nconst assignedSdr = sdrList.length > 0 ? sdrList[staticData.sdrIndex % sdrList.length] : 'REPLACE_WITH_SDR_EMAIL';\n\nstaticData.sdrIndex += 1;\n\nreturn [{ json: { ...item, assignedSdr } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "6fe6b3cf-3000-482d-879b-392bc21f142f",
      "name": "Build Hot Lead Notification",
      "type": "n8n-nodes-base.code",
      "position": [
        1824,
        1024
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nreturn [{\n  json: {\n    ...item,\n    status: 'Hot - Assigned',\n    notificationSubject: `Thanks for reaching out, ${item.name}!`,\n    notificationBody: `Hi ${item.name},\\n\\nThanks for getting in touch! Someone from our team will reach out to you shortly to discuss how we can help.\\n\\nTalk soon.`\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "0cc6c328-af86-46e4-b76e-56fd57418666",
      "name": "Notify Slack for Hot Lead",
      "type": "n8n-nodes-base.slack",
      "position": [
        2032,
        944
      ],
      "webhookId": "98ff12a8-6b1b-42f6-9902-5710dae2568d",
      "parameters": {
        "text": "=🔥 *Hot lead — assigned to {{ $json.assignedSdr }}*\n*Name:* {{ $json.name }}\n*Company:* {{ $json.company }}\n*Score:* {{ $json.leadScore }}/100\n*Reasoning:* {{ $json.reasoning }}\n*Suggested next step:* {{ $json.suggestedNextStep }}",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.slackAlertChannelId }}"
        },
        "otherOptions": {}
      },
      "typeVersion": 2.2
    },
    {
      "id": "1954c171-58e8-4e67-9985-a7dc47930230",
      "name": "Build Standard Lead Notification",
      "type": "n8n-nodes-base.code",
      "position": [
        1600,
        1392
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst statusLabel = item.tier === 'cold' ? 'Cold - Nurture' : 'Warm - Nurture';\n\nreturn [{\n  json: {\n    ...item,\n    status: statusLabel,\n    assignedSdr: 'Unassigned - Nurture Queue',\n    notificationSubject: `Thanks for reaching out, ${item.name}!`,\n    notificationBody: `Hi ${item.name},\\n\\nThanks for your interest! We've added you to our list and will follow up with helpful resources soon.\\n\\nTalk soon.`\n  }\n}];"
      },
      "typeVersion": 2
    },
