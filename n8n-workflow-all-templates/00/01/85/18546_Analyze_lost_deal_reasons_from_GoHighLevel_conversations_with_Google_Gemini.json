    {
      "id": "846cb38a-3198-4ea4-bfb4-5c0545cc18e8",
      "name": "Extract Total Messages Count",
      "type": "n8n-nodes-base.code",
      "position": [
        2656,
        -592
      ],
      "parameters": {
        "jsCode": "const messages = $json.messages?.messages || [];\n\nreturn [{\n  json: {\n    totalMessages: messages.length,\n    messageTypes: [...new Set(messages.map(m => m.messageType))],\n    types: [...new Set(messages.map(m => m.type))],\n    messages: messages.map(m => ({\n      id: m.id,\n      body: m.body,\n      direction: m.direction,\n      messageType: m.messageType,\n      type: m.type,\n      source: m.source,\n      dateAdded: m.dateAdded\n    }))\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "e34ca68b-465b-4a1e-bafa-468abb77fbc6",
      "name": "Filter Original Conversations",
      "type": "n8n-nodes-base.code",
      "position": [
        2880,
        -592
      ],
      "parameters": {
        "jsCode": "const messages = $json.messages?.messages || [];\n\n// Step 1: Filter out empty bodies and activity-type events\nconst realMessages = messages.filter(msg => {\n  return (\n    msg.body &&\n    msg.body.trim() &&\n    !msg.messageType?.startsWith('TYPE_ACTIVITY_')\n  );\n});\n\n// Step 2: Sort chronologically and build transcript\nconst transcript = realMessages\n  .sort((a, b) => new Date(a.dateAdded) - new Date(b.dateAdded))\n  .map(msg => {\n    const speaker = msg.direction === 'inbound' ? 'CUSTOMER' : 'SALES REP';\n    return `[${msg.dateAdded}] ${speaker}: ${msg.body}`;\n  })\n  .join('\\n');\n\n// Step 3: Return the combined output\nreturn [{\n  json: {\n    total: messages.length,\n    messageCount: realMessages.length,\n    realMessages,\n    transcript\n  }\n}];"
      },
      "typeVersion": 2
    },
