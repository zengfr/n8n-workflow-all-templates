    {
      "id": "2826f29b-f233-4ada-beaf-b3f6b4883e57",
      "name": "Construct Brief Context",
      "type": "n8n-nodes-base.code",
      "position": [
        32,
        672
      ],
      "parameters": {
        "jsCode": "// Latest status per client + upcoming calendar events, as ONE item.\nconst items = $input.all().map(i => i.json);\n\nconst events = items\n  .filter(i => i.start && i.summary)\n  .map(i => ({\n    title: i.summary,\n    when: (i.start.dateTime || i.start.date || '').slice(0, 16).replace('T', ' ')\n  }));\n\nconst logs = items.filter(i => i.client_id && i.timestamp);\n\nconst latest = {};\nfor (const l of logs) {\n  if (!latest[l.client_id] || new Date(l.timestamp) > new Date(latest[l.client_id].timestamp)) {\n    latest[l.client_id] = l;\n  }\n}\n\nconst today = new Date();\nconst clients = Object.values(latest).map(l => {\n  const days = l.deadline ? Math.ceil((new Date(l.deadline) - today) / 86400000) : null;\n  return {\n    client: l.client_name,\n    status: l.status,\n    last_update: l.summary,\n    blocker: l.blocker || '',\n    deadline: l.deadline || '',\n    days_left: days\n  };\n});\n\nreturn [{ json: { clients, events, generated_for: today.toISOString().slice(0, 10) } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "dd7ed4f6-8fc7-4da0-a777-5e5bd5263e94",
      "name": "Generate Brief with Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        256,
        672
      ],
      "parameters": {
        "text": "=Write ONE short Telegram morning brief for a freelancer. Date: {{ $json.generated_for }}.\n\nClient states:\n{{ JSON.stringify($json.clients) }}\n\nCalendar, next 7 days:\n{{ JSON.stringify($json.events) }}\n\nHard rules:\n- Under 140 words total.\n- Plain text only. No markdown, no asterisks, no underscores.\n- Order by urgency: blocked first, then deadline within 3 days, then everything else.\n- Anything with days_left <= 3 gets 🔴. days_left 4-7 gets 🟡.\n- One line per client. No preamble, no sign-off, no \"good morning\".\n- End with a single line: \"Today: <the one thing that matters most>\".\n- If there is nothing urgent, say so in one line and stop.",
        "promptType": "define"
