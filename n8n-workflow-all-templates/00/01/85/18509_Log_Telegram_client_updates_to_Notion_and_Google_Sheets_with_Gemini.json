    {
      "id": "a19bd83f-7220-4a39-bb34-2b2d09c3dfb7",
      "name": "Extract Client Update",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        -416,
        128
      ],
      "parameters": {
        "text": "=You extract project updates from a freelancer's casual message.\n\nMessage:\n\"\"\"\n{{ $json.message.text || $json.message.caption || \"\" }}\n\"\"\"\n\nRules:\n- client_hint: the client name or company exactly as the user wrote it. Do not correct it, do not expand it.\n- status: one of not_started | in_progress | blocked | done\n- blocker: the reason work is stuck, or empty string.\n- deadline_mentioned: ISO date (YYYY-MM-DD) ONLY if a date is explicitly stated or clearly derivable from words like \"Friday\" / \"next week\". Today is {{ $now.format('yyyy-MM-dd') }}. Otherwise empty string.\n- summary: one clean sentence, past tense, written for a client-facing timeline.\n\nNever invent a client name. If no client is named, return an empty client_hint.",
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "8c2cbf54-478d-472f-9a07-dbb0a72e08ac",
      "name": "Gemini Model for Extraction",
