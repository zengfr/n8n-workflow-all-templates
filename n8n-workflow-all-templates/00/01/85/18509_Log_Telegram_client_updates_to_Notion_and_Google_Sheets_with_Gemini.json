    {
      "id": "cd4c8ded-a065-405b-8b2e-aa4dd6dd7555",
      "name": "Compile Client Roster",
      "type": "n8n-nodes-base.code",
      "position": [
        192,
        240
      ],
      "parameters": {
        "jsCode": "// Collapse the client roster into ONE item so the matcher sees the whole list at once.\nconst extracted = $('Extract Client Update').first().json.output;\n\nconst roster = $input.all()\n  .map(i => i.json)\n  .filter(r => String(r.active).toLowerCase() === 'true')\n  .map(r => ({\n    client_id: r.client_id,\n    client_name: r.client_name,\n    aliases: r.aliases || '',\n    notion_page_id: String(r.notion_page_id || '').trim(),\n    drive_folder_id: String(r.drive_folder_id || '').trim()\n  }));\n\nif (roster.length === 0) {\n  throw new Error('Roster is empty. Check the Clients tab: is the active column set to TRUE and are the headers spelled exactly right?');\n}\n\nreturn [{\n  json: {\n    extracted,\n    roster,\n    roster_text: roster.map(r => `${r.client_id} | ${r.client_name} | aliases: ${r.aliases}`).join('\\n')\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "24e39090-4309-4fbe-a5ec-000b5212d0c8",
      "name": "Match Client with Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        416,
        128
      ],
      "parameters": {
        "text": "=Match a client mention to exactly one client in the roster.\n\nMention: \"{{ $json.extracted.client_hint }}\"\n\nRoster (client_id | client_name | aliases):\n{{ $json.roster_text }}\n\nScoring rules:\n- Exact or alias match: confidence 95-100.\n- Unique unambiguous partial (\"Ahmed\" and only one Ahmed exists): 85-94.\n- Partial that fits TWO OR MORE clients: confidence 40 or below, and list every candidate in candidates.\n- No plausible match at all: confidence 0, client_id empty, candidates empty.\n\nBe pessimistic. A wrong write is far worse than a question.",
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "fbf86e3c-f626-42e6-9d28-d3c8814ce490",
