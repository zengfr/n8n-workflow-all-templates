        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"client_hint\": { \"type\": \"string\" },\n    \"status\": { \"type\": \"string\", \"enum\": [\"not_started\", \"in_progress\", \"blocked\", \"done\"] },\n    \"blocker\": { \"type\": \"string\" },\n    \"deadline_mentioned\": { \"type\": \"string\" },\n    \"summary\": { \"type\": \"string\" }\n  },\n  \"required\": [\"client_hint\", \"status\", \"blocker\", \"deadline_mentioned\", \"summary\"]\n}"
      },
      "typeVersion": 1.2
    },
