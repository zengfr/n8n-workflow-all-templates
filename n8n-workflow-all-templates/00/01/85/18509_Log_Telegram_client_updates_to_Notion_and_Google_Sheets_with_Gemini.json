      "parameters": {
        "color": 7,
        "width": 416,
        "height": 528,
        "content": "## Resolve ambiguous matches\n\nChecks whether the client match is clear enough to continue; ambiguous updates trigger a Telegram clarification request, while valid matches are normalized for downstream processing."
      },
      "typeVersion": 1
    },
    {
      "id": "0f34389e-ebbc-40cc-ac40-753761c89491",
      "name": "Sticky Note5",
