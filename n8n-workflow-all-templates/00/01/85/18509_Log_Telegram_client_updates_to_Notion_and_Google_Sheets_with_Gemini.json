    {
      "id": "381a5a28-cab9-4a59-bc6c-931e8373c17a",
      "name": "Prompt Client Choice",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1024,
        336
      ],
      "webhookId": "REPLACE_WITH_YOUR_WEBHOOK_ID",
      "parameters": {
        "text": "=⚠️ Ambiguity Gate\n\nI did not write anything yet.\n\nYou said: {{ $('Extract Client Update').first().json.output.client_hint }}\nConfidence: {{ $json.output.confidence }}%\n\nWhich one do you mean?\n{{ $json.output.candidates.length ? $json.output.candidates.map((c, i) => (i+1) + '. ' + c).join('\\n') : 'No match found in your active client list.' }}\n\nReply with the full client name and I will log it.",
        "chatId": "={{ $('When Telegram Update Received').first().json.message.chat.id }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "credential-id",
          "name": "Telegram account AS"
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "e7d7d3d3-364a-46c9-a798-53483af8a646",
      "name": "Standardize Payload Format",
      "type": "n8n-nodes-base.code",
      "position": [
        1024,
        144
      ],
      "parameters": {
        "jsCode": "// One clean object for everything downstream.\nconst match = $input.first().json.output;\nconst extracted = $('Extract Client Update').first().json.output;\nconst msg = $('When Telegram Update Received').first().json.message;\nconst roster = $('Compile Client Roster').first().json.roster;\n\nconst row = roster.find(r => r.client_id === match.client_id) || {};\n\nif (!row.notion_page_id) {\n  throw new Error(`No notion_page_id in the Clients tab for ${match.client_name || match.client_id}. Add the 32-character page ID.`);\n}\n\nreturn [{\n  json: {\n    client_id: match.client_id,\n    client_name: match.client_name,\n    confidence: match.confidence,\n    notion_page_id: row.notion_page_id,\n    drive_folder_id: row.drive_folder_id || '',\n    status: extracted.status,\n    blocker: extracted.blocker,\n    deadline: extracted.deadline_mentioned,\n    summary: extracted.summary,\n    raw_message: msg.text || msg.caption || '',\n    chat_id: msg.chat.id,\n    has_file: Boolean(msg.photo || msg.document),\n    file_id: msg.document ? msg.document.file_id : (msg.photo ? msg.photo[msg.photo.length - 1].file_id : ''),\n    file_name: msg.document ? msg.document.file_name : `telegram-photo-${Date.now()}.jpg`,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
