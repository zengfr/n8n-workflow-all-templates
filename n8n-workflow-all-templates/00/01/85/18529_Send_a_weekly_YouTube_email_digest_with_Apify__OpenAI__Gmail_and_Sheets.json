    {
      "id": "c2e1cb91-e39e-4c99-8a1d-f6b781fc6051",
      "name": "Build digest email",
      "type": "n8n-nodes-base.code",
      "position": [
        3072,
        208
      ],
      "parameters": {
        "jsCode": "// Fold every summarised video into one HTML digest.\nconst escape = (value) => String(value ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// This node sits on its own branch off the summariser, so `items` is the LLM\n// output in the same order as the videos that went in. Pair them up by index.\nconst sources = $('Any new videos?').all();\nconst videos = items.map((item, index) => ({\n  source: sources[index]?.json || {},\n  ai: item.json.output || {},\n}));\n\nconst blocks = videos.map(({ source, ai }) => {\n  const takeaways = (ai.takeaways || [])\n    .map((t) => `<li>${escape(t)}</li>`)\n    .join('');\n  return `\n    <div style=\"margin:0 0 28px 0\">\n      <h3 style=\"margin:0 0 4px 0\"><a href=\"${escape(source.url)}\">${escape(source.title)}</a></h3>\n      <p style=\"margin:0 0 8px 0;color:#666;font-size:13px\">\n        ${escape(source.channelName)} &middot; ${escape(source.lengthMinutes)} min &middot;\n        worth watching: ${escape(ai.worthWatching)}\n      </p>\n      <p style=\"margin:0 0 8px 0\">${escape(ai.summary)}</p>\n      <ul style=\"margin:0 0 8px 18px;padding:0\">${takeaways}</ul>\n      <p style=\"margin:0;color:#666;font-size:13px\"><em>${escape(ai.verdict)}</em></p>\n    </div>`;\n}).join('');\n\nconst html = `<div style=\"font-family:Helvetica,Arial,sans-serif;max-width:640px\">\n  <h2 style=\"margin:0 0 16px 0\">Your YouTube digest</h2>\n  <p style=\"margin:0 0 24px 0;color:#666\">${videos.length} new video(s) since the last run.</p>\n  ${blocks}\n</div>`;\n\nreturn [{ json: { videoCount: videos.length, html } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "4a8ec9ce-9a95-4dd2-84c0-e7d3385eb524",
      "name": "Send weekly digest",
      "type": "n8n-nodes-base.gmail",
      "position": [
        3280,
        208
      ],
      "parameters": {
        "sendTo": "={{ $('Settings').first().json.digestRecipient }}",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        },
        "subject": "=Your YouTube digest - {{ $json.videoCount }} new video(s)",
        "emailType": "html"
      },
      "typeVersion": 2.1
    }
