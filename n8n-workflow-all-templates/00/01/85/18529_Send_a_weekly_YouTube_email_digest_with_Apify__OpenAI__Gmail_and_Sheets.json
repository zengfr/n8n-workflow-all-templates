    {
      "id": "aea5bdaa-4409-4eae-8eca-55f38c595d58",
      "name": "Get channels to watch",
      "type": "n8n-nodes-base.googleSheets",
      "notes": "Sheet tab \"Channels\" with one column: Source. Put a channel, playlist or single video URL in each row.",
      "position": [
