    {
      "id": "ee387546-1dce-4e48-83dd-7418730d5bab",
      "name": "Build source list",
      "type": "n8n-nodes-base.code",
      "position": [
        624,
        0
      ],
      "parameters": {
        "jsCode": "// Collect the watchlist into the single array the Apify Actor expects.\n// Channel and playlist URLs are expanded by the Actor itself.\nconst videoUrls = [...new Set(\n  items\n    .map((item) => String(item.json.Source || item.json.source || '').trim())\n    .filter((url) => /^https?:\\/\\//i.test(url)),\n)];\n\nif (videoUrls.length === 0) {\n  throw new Error('No sources found. Add a \"Source\" column to your Channels sheet with one YouTube channel, playlist or video URL per row.');\n}\n\nreturn [{ json: { videoUrls, sourceCount: videoUrls.length } }];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "730129dc-2cd4-4103-8057-b98e6a53206b",
      "name": "Start transcript run",
      "type": "n8n-nodes-base.httpRequest",
      "notes": "One Actor run covers every channel in the sheet. Only videos that actually return a transcript are billed.",
      "position": [
        880,
        0
      ],
      "parameters": {
        "url": "=https://api.apify.com/v2/acts/{{ $('Settings').first().json.apifyActorId }}/runs",
        "method": "POST",
        "options": {
          "timeout": 60000
        },
        "jsonBody": "={{ JSON.stringify({\n  videoUrls: $json.videoUrls,\n  transcriptFormat: 'text',\n  languages: ['en'],\n  fallbackToAnyLanguage: true,\n  includeFailures: false,\n  maxVideosPerSource: $('Settings').first().json.maxVideosPerSource\n}) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
