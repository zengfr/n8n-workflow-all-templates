    {
      "id": "b29525fc-fc63-4ce0-8156-d59153306134",
      "name": "Keep transcripts only",
      "type": "n8n-nodes-base.code",
      "position": [
        2016,
        0
      ],
      "parameters": {
        "jsCode": "// Flatten the dataset array and drop rows for videos that had no captions.\nconst rows = [];\nfor (const item of items) {\n  const value = item.json;\n  if (Array.isArray(value)) rows.push(...value);\n  else if (Array.isArray(value.data)) rows.push(...value.data);\n  else rows.push(value);\n}\n\n// Everything derives from the single HTTP response item, so pair back to item 0.\nreturn rows\n  .filter((row) => row && row.videoId && row.transcript)\n  .map((row) => ({\n    pairedItem: { item: 0 },\n    json: {\n      videoId: row.videoId,\n      url: row.url,\n      title: row.title || row.videoId,\n      channelName: row.channelName || '',\n      lengthMinutes: row.lengthSeconds ? Math.round(row.lengthSeconds / 60) : '',\n      wordCount: row.wordCount || 0,\n      transcript: String(row.transcript || ''),\n    },\n  }));\n"
      },
      "typeVersion": 2
    },
    {
      "id": "2f8202e9-66d7-46e1-89a8-68f3529be25b",
      "name": "Skip videos already sent",
      "type": "n8n-nodes-base.removeDuplicates",
      "notes": "Keyed on the YouTube video id, remembered across executions. A channel you added months ago will not be summarised again.",
      "position": [
        2224,
        0
      ],
      "parameters": {
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "options": {
          "scope": "node",
          "historySize": 10000
        },
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.videoId }}"
      },
      "typeVersion": 2,
      "alwaysOutputData": true
    },
