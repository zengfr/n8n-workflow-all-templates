    {
      "id": "5520918b-8569-47f0-8f98-802b15328d48",
      "name": "Evaluate JavaScript Cache",
      "type": "n8n-nodes-base.code",
      "position": [
        1152,
        592
      ],
      "parameters": {
        "jsCode": "// ==========================================================================\n// Semantic Cache Normalizer & Chat Input Preserver\n// Handles empty cache misses gracefully and forwards chatInput downstream\n// ==========================================================================\nconst chatInput = $('On Chat Message Received').item.json.chatInput || '';\nconst items = $input.all();\n\nif (items.length === 0) {\n  // Cache returned 0 items -> output a clean cache-miss object with chatInput\n  return [{\n    json: {\n      score: 0,\n      isCacheMiss: true,\n      chatInput: chatInput\n    }\n  }];\n}\n\n// Pass cache items through with chatInput preserved for downstream AI Agent\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    chatInput: chatInput\n  }\n}));"
      },
      "typeVersion": 2
    },
