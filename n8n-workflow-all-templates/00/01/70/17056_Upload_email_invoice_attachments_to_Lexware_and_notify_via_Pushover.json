    {
      "id": "9cf72050-ea5d-48da-b112-fec44e5c0127",
      "name": "Extract Email Attachments",
      "type": "n8n-nodes-base.code",
      "position": [
        -320,
        -16
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const binary = item.binary || {};\n  const attachmentKeys = Object.keys(binary).filter(k => k.startsWith(\"attachment_\"));\n  \n  if (attachmentKeys.length === 0) continue;\n  \n  for (const key of attachmentKeys) {\n    result.push({\n      json: { attachmentKey: key },\n      binary: { file: binary[key] }\n    });\n  }\n}\n\nreturn result;"
      },
      "typeVersion": 2
    },
