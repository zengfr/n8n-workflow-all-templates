        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ text: '✅ ' + ($json.data ? $json.data.length : 0) + ' ad(s) cleared Spendict and were logged to the sheet.' }) }}",
        "sendBody": true,
