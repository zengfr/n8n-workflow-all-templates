    {
      "id": "e44ebb93-ef60-4e1e-965c-91e0c3bca592",
      "name": "Analyze Metrics",
      "type": "n8n-nodes-base.code",
      "position": [
        2496,
        2208
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst metrics = raw.response || raw;\nconst cpuThreshold = $('Config: Detection Settings').item.json.cpuThreshold;\nconst trafficMultiplier = $('Config: Detection Settings').item.json.trafficMultiplier;\n\nfunction series(obj) {\n  if (!obj || !obj.usage) return [];\n  return Object.entries(obj.usage)\n    .map(([ts, val]) => ({ ts: Number(ts), val: Number(val) }))\n    .sort((a, b) => a.ts - b.ts);\n}\n\nfunction formatBytes(bytes) {\n  if (bytes === null || bytes === undefined || isNaN(bytes)) return 'N/A';\n  const units = ['B', 'KB', 'MB', 'GB', 'TB'];\n  let val = bytes;\n  let i = 0;\n  while (val >= 1024 && i < units.length - 1) { val /= 1024; i++; }\n  return `${val.toFixed(2)} ${units[i]}`;\n}\n\nfunction formatTimestamp(ts) {\n  if (!ts) return 'N/A';\n  const date = new Date(ts * 1000);\n  return date.toLocaleString('en-US', { timeZone: 'UTC', dateStyle: 'medium', timeStyle: 'medium' }) + ' UTC';\n}\n\nconst cpuSeries = series(metrics.cpu_usage);\nconst inSeries = series(metrics.incoming_traffic);\nconst outSeries = series(metrics.outgoing_traffic);\n\nif (cpuSeries.length === 0) {\n  return [{ json: { isCpuSpike: false, isTrafficAnomaly: false, note: 'No metrics data returned for this window' } }];\n}\n\nconst latestCpu = cpuSeries[cpuSeries.length - 1].val;\nconst isCpuSpike = latestCpu > cpuThreshold;\n\nfunction baseline(seriesArr) {\n  const prior = seriesArr.slice(0, -1);\n  if (prior.length === 0) return null;\n  const sum = prior.reduce((a, p) => a + p.val, 0);\n  return sum / prior.length;\n}\n\nconst latestIn = inSeries.length ? inSeries[inSeries.length - 1].val : 0;\nconst latestOut = outSeries.length ? outSeries[outSeries.length - 1].val : 0;\nconst baseIn = baseline(inSeries);\nconst baseOut = baseline(outSeries);\n\nconst inAnomaly = baseIn !== null && baseIn > 0 && latestIn > baseIn * trafficMultiplier;\nconst outAnomaly = baseOut !== null && baseOut > 0 && latestOut > baseOut * trafficMultiplier;\nconst isTrafficAnomaly = inAnomaly || outAnomaly;\n\nconst timestamp = cpuSeries[cpuSeries.length - 1].ts;\n\nreturn [{\n  json: {\n    isCpuSpike, isTrafficAnomaly, latestCpu,\n    latestIncoming: latestIn, latestOutgoing: latestOut,\n    baselineIncoming: baseIn, baselineOutgoing: baseOut,\n    timestamp,\n    formattedCpu: `${latestCpu.toFixed(2)}%`,\n    formattedIncoming: formatBytes(latestIn),\n    formattedOutgoing: formatBytes(latestOut),\n    formattedBaselineIncoming: formatBytes(baseIn),\n    formattedBaselineOutgoing: formatBytes(baseOut),\n    formattedTimestamp: formatTimestamp(timestamp)\n  }\n}];"
      },
      "typeVersion": 2
    },
