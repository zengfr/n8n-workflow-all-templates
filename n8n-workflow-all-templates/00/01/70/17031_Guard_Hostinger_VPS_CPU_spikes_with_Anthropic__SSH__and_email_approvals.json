    {
      "id": "43cfb9b5-d0c3-4189-a6a4-2eef28623a7b",
      "name": "Extract Case ID & Decision",
      "type": "n8n-nodes-base.code",
      "position": [
        2064,
        2720
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst subject = item.subject || '';\nconst bodyText = item.text || '';\nconst caseMatch = subject.match(/(CPU-\\d+)/i);\nconst caseId = caseMatch ? caseMatch[1] : null;\nconst approved = /\\bkill\\b/i.test(bodyText);\nreturn [{ json: { caseId, approved } }];"
      },
      "typeVersion": 2
    },
