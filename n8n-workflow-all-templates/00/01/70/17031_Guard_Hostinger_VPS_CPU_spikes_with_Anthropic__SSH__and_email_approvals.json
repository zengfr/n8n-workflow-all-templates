    {
      "id": "c84d1f65-44e7-4f68-b659-f5ae853692b5",
      "name": "Format Process List",
      "type": "n8n-nodes-base.code",
      "position": [
        3184,
        2160
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst output = raw.stdout || raw.data || raw.output || JSON.stringify(raw);\nconst lines = output.split('\\n').filter(Boolean);\nconst header = (lines[0] || '').trim().split(/\\s+/);\nconst rows = lines.slice(1, 11).map(line => {\n  const cols = line.trim().split(/\\s+/);\n  const fixed = cols.slice(0, 10);\n  const cmd = cols.slice(10).join(' ');\n  return fixed.concat([cmd]);\n});\n\nconst topProcesses = rows.map(r => ({\n  user: r[0], pid: r[1], cpu: parseFloat(r[2]), mem: parseFloat(r[3]), command: r[10]\n}));\n\nconst killThreshold = $('Config: Detection Settings').item.json.killCpuThreshold;\nconst flaggedPids = topProcesses.filter(p => p.cpu >= killThreshold).map(p => p.pid);\n\nconst html = `<table style=\"border-collapse:collapse;width:100%;font-family:monospace;font-size:12px;\">` +\n  `<tr>${header.map(h => `<th style=\"text-align:left;padding:2px 8px;border-bottom:1px solid #ccc;\">${h}</th>`).join('')}</tr>` +\n  rows.map(r => `<tr>${r.map(c => `<td style=\"padding:2px 8px;border-bottom:1px solid #eee;\">${c}</td>`).join('')}</tr>`).join('') +\n  `</table>`;\n\nreturn [{ json: { processListHtml: html, topProcesses, flaggedPids, rawProcessList: output } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "684f5478-93e5-4d20-983e-8c4b68732ed4",
      "name": "Parse AI Analysis",
      "type": "n8n-nodes-base.code",
      "position": [
        3680,
        2160
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst body = resp.response || resp;\nconst content = body.content || [];\nconst text = content.filter(c => c.type === 'text').map(c => c.text).join('\\n') || 'AI analysis unavailable.';\nreturn [{ json: { aiAnalysis: text } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "49114766-c651-4abf-88a1-c0e111a37d32",
      "name": "Build Log Entry",
      "type": "n8n-nodes-base.code",
      "position": [
        4256,
        2320
      ],
      "parameters": {
        "jsCode": "const caseId = 'CPU-' + Date.now();\nconst analysis = $('Parse AI Analysis').item.json.aiAnalysis;\nconst flaggedPids = $('Format Process List').item.json.flaggedPids;\nconst vpsId = $('Config: Detection Settings').item.json.vpsId;\n\nconst entry = {\n  caseId,\n  vpsId,\n  timestamp: new Date().toISOString(),\n  status: 'pending_approval',\n  flaggedPids,\n  analysis: analysis.replace(/\\n/g, ' ').slice(0, 2000)\n};\n\nconst base64 = Buffer.from(JSON.stringify(entry), 'utf-8').toString('base64');\nreturn [{ json: { logLineBase64: base64, caseId, flaggedPids } }];"
      },
      "typeVersion": 2
    },
