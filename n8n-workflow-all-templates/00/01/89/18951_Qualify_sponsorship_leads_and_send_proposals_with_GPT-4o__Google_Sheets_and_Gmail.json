      "parameters": {
        "text": "=High-fit sponsorship enquiry: {{ $('Shape Output').item.json.companyName }}\nContact: {{ $('Shape Output').item.json.contactName }}\nSuggested level: {{ $('Shape Output').item.json.matchedSponsorshipLevel }}\nReason: {{ $('Shape Output').item.json.reasoning }}",
