    {
      "id": "76a1d8b4-57f1-4a58-9f41-c157d34c5046",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        2144,
        352
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"fitTier\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"high\",\n        \"medium\",\n        \"low\"\n      ]\n    },\n    \"matchedSponsorshipLevel\": {\n      \"type\": \"string\"\n    },\n    \"proposalOpening\": {\n      \"type\": \"string\"\n    },\n    \"reasoning\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"fitTier\",\n    \"matchedSponsorshipLevel\",\n    \"proposalOpening\",\n    \"reasoning\"\n  ]\n}"
      },
      "retryOnFail": false,
      "typeVersion": 1.2
    },
    {
      "id": "e5b4eeb5-839d-4083-98de-5b8cbc3b106c",
      "name": "AI Agent - Qualify Sponsorship Fit",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2432,
        352
      ],
      "parameters": {
        "text": "=Company: {{ $json.companyName }}\nContact: {{ $json.contactName }}\nBudget range: {{ $json.budgetRange }}\nIndustry: {{ $json.industry }}\nEvent interest: {{ $json.eventInterest }}\n\nQualify sponsorship fit and produce the structured output.",
        "options": {
          "systemMessage": "You are a sponsorship sales qualification assistant for a B2B conference series. Assess the prospect's stated budget range and industry fit against our sponsorship tiers (Platinum $50k+, Gold $20-50k, Silver $5-20k, Community under $5k). Classify fitTier as high, medium, or low. Draft one warm, specific opening paragraph for a follow-up proposal email that references their stated goals — do not invent numbers or promises we haven't stated."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "retryOnFail": false,
      "typeVersion": 1.9
    },
    {
      "id": "e7cd09cd-1557-4f3d-9a14-46250275bf98",
      "name": "Shape Output",
      "type": "n8n-nodes-base.code",
      "position": [
        1856,
        576
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const o=$json.output;const lead=$('Validate Enquiry Contact').item.json;if(!o||typeof o!=='object'||!['high','medium','low'].includes(o.fitTier))throw Error('Invalid qualification result; no messages sent');for(const k of ['matchedSponsorshipLevel','proposalOpening','reasoning'])if(typeof o[k]!=='string'||!o[k].trim())throw Error('Missing qualification field: '+k);return {json:{...lead,...o,loggedAt:new Date().toISOString()}};"
      },
      "retryOnFail": false,
      "typeVersion": 2
    },
