    {
      "id": "21f65428-1fed-49ad-b5c5-190a265893b2",
      "name": "Route by Sentiment",
      "type": "n8n-nodes-base.switch",
      "position": [
        2496,
        1568
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Negative Sentiment",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    },
                    "leftValue": "={{ $('Meeting Analyzer Agent').first().json.output.sentiment }}",
                    "rightValue": "negative"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Positive Sentiment",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    },
                    "leftValue": "={{ $('Meeting Analyzer Agent').first().json.output.sentiment }}",
                    "rightValue": "positive"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Neutral"
        }
      },
      "typeVersion": 3.4
    },
