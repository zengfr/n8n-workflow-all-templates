      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"overallSentiment\": {\"type\": \"string\"},\n    \"emotionalTone\": {\"type\": \"string\"},\n    \"clientSatisfaction\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 10},\n    \"engagementLevel\": {\"type\": \"string\"},\n    \"riskFactors\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    \"positiveSignals\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n    \"recommendations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}\n  }\n}"
      },
