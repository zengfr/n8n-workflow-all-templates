      "parameters": {
        "text": "={{ $json.output }}",
        "options": {
          "systemMessage": "You are an action item formatter that structures meeting action items.\n\nYour task is to:\n1. Take the action items from the meeting analysis\n2. Format each action item with: owner, task description, deadline, and priority level\n3. Ensure owner names match attendee names from the meeting\n4. Assign priority based on urgency mentioned in the meeting (high, medium, low)\n5. Format deadlines in ISO 8601 format (YYYY-MM-DD)\n\nReturn the formatted action items in the structured JSON format defined by the output parser."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3
