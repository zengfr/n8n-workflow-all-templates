      "position": [
        1984,
        896
      ],
      "parameters": {
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ { filterGroups: [{ filters: $('Meeting Analyzer Agent').first().json.output.attendees.map(a => ({ propertyName: 'email', operator: 'EQ', value: a.email })) }] } }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.3
    },
