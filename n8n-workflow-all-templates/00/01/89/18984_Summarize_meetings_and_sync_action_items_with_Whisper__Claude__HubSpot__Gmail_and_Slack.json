    {
      "id": "b9f1c5bc-d58d-4e02-b0bc-dc157a4cf74a",
      "name": "Post High Priority Alert Slack",
      "type": "n8n-nodes-base.slack",
      "position": [
        3744,
        928
      ],
      "webhookId": "3c69b784-9df5-4c2f-8aa2-f3644af78d53",
      "parameters": {
        "text": "={{ '🚨 *HIGH PRIORITY ACTION ITEMS DETECTED*\\n\\n' + $json.task.map((task, i) => '• ' + task + ' (Owner: ' + $json.owner[i] + ', Due: ' + $json.deadline[i] + ')').join('\\n') + '\\n\\n⚠️ These items require immediate attention!' }}",
        "select": "channel",
        "channelId": {
