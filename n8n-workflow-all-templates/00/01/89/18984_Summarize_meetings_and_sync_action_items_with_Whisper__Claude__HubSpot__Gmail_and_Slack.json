    {
      "id": "a0dbc85a-26d0-41b7-9fbe-3e8785c35ece",
      "name": "Meeting Analyzer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1280,
        1136
      ],
      "parameters": {
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "You are a meeting intelligence assistant that analyzes meeting transcripts.\n\nYour task is to:\n1. Extract all attendee names and email addresses (if mentioned)\n2. Identify the main topics discussed\n3. List all decisions made during the meeting\n4. Extract action items with owners and deadlines\n5. Analyze the overall sentiment of the meeting (positive, neutral, negative)\n6. Identify any relationship health signals for account management\n\nReturn the analysis in the structured JSON format defined by the output parser."
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 3
    },
