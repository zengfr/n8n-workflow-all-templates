    },
    {
      "id": "58beef3a-576a-4c92-b925-90b779c944d6",
      "name": "Calculate Meeting Score",
      "type": "n8n-nodes-base.code",
      "position": [
        2272,
        1632
      ],
      "parameters": {
        "jsCode": "// Calculate comprehensive meeting score\nconst insights = $input.first().json.output;\nconst metrics = $input.first().json;\n\n// Scoring factors\nlet score = 50; // Base score\n\n// Positive factors\nif (insights.opportunities && insights.opportunities.length > 0) score += 10;\nif (insights.budgetSignals && insights.budgetSignals.toLowerCase().includes('approved')) score += 15;\nif (insights.urgencyLevel === 'high') score += 10;\nif (metrics.decisionsCount > 2) score += 5;\n\n// Negative factors\nif (insights.competitiveIntel && insights.competitiveIntel.length > 2) score -= 5;\nif (metrics.highPriorityCount > 3) score -= 5;\n\n// Cap score between 0-100\nscore = Math.max(0, Math.min(100, score));\n\nreturn {\n  json: {\n    ...metrics,\n    meetingScore: score,\n    scoreCategory: score >= 75 ? 'Excellent' : score >= 50 ? 'Good' : 'Needs Attention'\n  }\n};"
      },
      "typeVersion": 2
    },
