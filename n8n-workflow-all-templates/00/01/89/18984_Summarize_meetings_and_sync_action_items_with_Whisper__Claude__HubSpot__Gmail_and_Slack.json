    {
      "id": "cee8ff9a-27fe-463f-9029-58b311daecb4",
      "name": "Match Attendees to HubSpot",
      "type": "n8n-nodes-base.code",
      "position": [
        2208,
        896
      ],
      "parameters": {
        "jsCode": "// Match meeting attendees to HubSpot contacts\nconst attendees = $('Meeting Analyzer Agent').first().json.output.attendees;\nconst hubspotResults = $input.first().json.results || [];\nconst actionItems = $('Action Item Formatter Agent').first().json.output.actionItems;\n\n// Create mapping\nconst matched = attendees.map(attendee => {\n  const contact = hubspotResults.find(c => \n    c.properties.email?.toLowerCase() === attendee.email?.toLowerCase()\n  );\n  \n  return {\n    name: attendee.name,\n    email: attendee.email,\n    hubspotId: contact?.id || null,\n    matched: !!contact,\n    actionItemsCount: actionItems.filter(item => item.owner === attendee.name).length\n  };\n});\n\nreturn {\n  json: {\n    ...$('Action Item Formatter Agent').first().json,\n    attendeeMatches: matched,\n    matchRate: (matched.filter(m => m.matched).length / matched.length * 100).toFixed(1)\n  }\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "d9b9357f-db30-4cb5-996a-161939848da0",
