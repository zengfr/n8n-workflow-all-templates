      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'sourceImage');\nconst meta = $input.first().binary?.sourceImage ?? {};\nconst u24 = (o) => buffer[o] | (buffer[o + 1] << 8) | (buffer[o + 2] << 16);\nlet format = 'unknown', width = null, height = null;\nif (buffer.length >= 24 && buffer.toString('ascii', 1, 4) === 'PNG') { format = 'png'; width = buffer.readUInt32BE(16); height = buffer.readUInt32BE(20); }\nelse if (buffer.length >= 30 && buffer.toString('ascii', 0, 4) === 'RIFF' && buffer.toString('ascii', 8, 12) === 'WEBP') {\n  format = 'webp'; const chunk = buffer.toString('ascii', 12, 16);\n  if (chunk === 'VP8X') { width = 1 + u24(24); height = 1 + u24(27); }\n  else if (chunk === 'VP8 ') { width = buffer.readUInt16LE(26) & 0x3fff; height = buffer.readUInt16LE(28) & 0x3fff; }\n  else if (chunk === 'VP8L' && buffer[20] === 0x2f) { const bits = buffer.readUInt32LE(21); width = 1 + (bits & 0x3fff); height = 1 + ((bits >> 14) & 0x3fff); }\n} else if (buffer.length >= 4 && buffer[0] === 0xff && buffer[1] === 0xd8) {\n  format = 'jpeg'; let o = 2;\n  while (o + 9 < buffer.length) { if (buffer[o] !== 0xff) { o++; continue; } const m = buffer[o + 1]; if ([0xc0,0xc1,0xc2,0xc3,0xc5,0xc6,0xc7,0xc9,0xca,0xcb,0xcd,0xce,0xcf].includes(m)) { height = buffer.readUInt16BE(o + 5); width = buffer.readUInt16BE(o + 7); break; } const len = buffer.readUInt16BE(o + 2); if (len < 2) break; o += 2 + len; }\n}\nconst ratio = width && height ? width / height : null;\nconst issues = [];\nif (!['jpeg','png','webp'].includes(format) || !width || !height) issues.push('source: use a valid JPG, PNG, or WebP image.');\nif (buffer.length > 10 * 1024 * 1024) issues.push('source: keep the file at or below 10 MB.');\nif (width && height && Math.min(width, height) < 512) issues.push('source: use at least 512 px on the shorter side.');\nif (width && height && Math.max(width, height) > 8192) issues.push('source: reduce the longest side to 8192 px or less.');\nif (ratio && (ratio < 0.5 || ratio > 2)) issues.push('source: avoid an extremely wide or tall crop.');\nreturn [{ json: { source: { fileName: meta.fileName ?? null, mimeType: meta.mimeType ?? null, format, width, height, bytes: buffer.length, aspectRatio: ratio ? Math.round(ratio * 100) / 100 : null, issues }, sourceReady: issues.length === 0 } }];"
