      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst pick = (...parts) => {\n  const found = Object.entries(input).find(([key]) => parts.some((p) => key.toLowerCase().includes(p)));\n  return found?.[1];\n};\nconst sourceUrl = String(pick('source image url') ?? '').trim();\nconst referenceUrl = String(pick('reference image url') ?? '').trim();\nconst consent = String(pick('own or have permission') ?? '').trim();\nconst safeHttps = (raw) => {\n  const match = String(raw).match(/^https:\\/\\/([^/?#]+)(?:[/?#]|$)/i);\n  if (!match || match[1].includes('@')) return false;\n  const host = match[1].replace(/^\\[/, '').replace(/\\]$/, '').split(':')[0].toLowerCase();\n  const privateHost = host === 'localhost' || host === '::1' || /^127\\./.test(host) || /^10\\./.test(host) || /^192\\.168\\./.test(host) || /^169\\.254\\./.test(host) || /^172\\.(1[6-9]|2\\d|3[01])\\./.test(host);\n  return !privateHost;\n};\nconst sampleRun = input.sampleRun === true;\nreturn [{ json: {\n  requestId: 'LFS-' + new Date().toISOString().replace(/\\D/g, '').slice(0, 14),\n  requesterEmail: String(pick('requester email') ?? ''),\n  sourceUrl,\n  referenceUrl,\n  intendedEffect: String(pick('intended effect') ?? 'Face Swap'),\n  sessionChannel: String(pick('session channel') ?? 'Private test'),\n  authorizationConfirmed: consent.toLowerCase().startsWith('yes'),\n  urlsSafe: safeHttps(sourceUrl) && safeHttps(referenceUrl),\n  sampleRun,\n  privacyNotice: 'Use short-lived HTTPS URLs and configure n8n execution-data retention before accepting personal images.',\n  productUrl: 'https://livefaceswap.ai',\n  setupGuide: 'https://livefaceswap.ai/guides/live-face-swap-online'\n} }];"
