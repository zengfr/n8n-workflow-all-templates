                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "refresh"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 3.2
    },
