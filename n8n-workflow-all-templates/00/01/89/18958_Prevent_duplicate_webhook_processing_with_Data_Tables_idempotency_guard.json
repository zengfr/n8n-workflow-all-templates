        "jsCode": "const decision = $('Evaluate Idempotency').first().json;\n\nreturn [{\n  json: {\n    allow_processing: decision.allow_processing,\n    action: decision.action,\n    scope: decision.scope,\n    idempotency_key: decision.idempotency_key,\n    ledger_key: decision.ledger_key,\n    duplicate_count: decision.duplicate_count,\n    first_seen_at: decision.first_seen_at,\n    last_seen_at: decision.last_seen_at,\n    expires_at: decision.expires_at,\n    payload: decision.payload\n  }\n}];"
