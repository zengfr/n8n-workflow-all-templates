    {
      "id": "fe177143-99c0-4698-b15a-b4379f3cdf04",
      "name": "Compute Leave Deadlines",
      "type": "n8n-nodes-base.code",
      "position": [
        1168,
        800
      ],
      "parameters": {
        "jsCode": "// Group merged rows by employee, work out each person's own\n// leave year, and count how many days they still need to take.\n\nconst config = $('Set Leave Rule Parameters').first().json;\nconst requiredDays = Number(config.requiredDays);\nconst grantMethod = config.grantMethod;\nconst today = new Date(new Date().toISOString().slice(0, 10) + 'T00:00:00Z');\n\n// --- date helpers (UTC only, to avoid timezone drift) ---\nconst toDate = (v) => new Date(String(v).slice(0, 10) + 'T00:00:00Z');\nconst addMonths = (d, n) => {\n  const r = new Date(d);\n  r.setUTCMonth(r.getUTCMonth() + n);\n  return r;\n};\nconst addYears = (d, n) => addMonths(d, n * 12);\nconst addDays = (d, n) => {\n  const r = new Date(d);\n  r.setUTCDate(r.getUTCDate() + n);\n  return r;\n};\nconst iso = (d) => d.toISOString().slice(0, 10);\n\n// --- group rows by employee ---\nconst employees = {};\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (!row.employeeId) continue;\n\n  if (!employees[row.employeeId]) {\n    employees[row.employeeId] = {\n      employeeId: row.employeeId,\n      name: row.name,\n      email: row.email,\n      hireDate: row.hireDate,\n      grantedDays: Number(row.grantedDays || 0),\n      active: String(row.active).toUpperCase() === 'TRUE',\n      leave: [],\n    };\n  }\n  // Employees with no leave at all still arrive here, just without a date\n  if (row.leaveDate) {\n    employees[row.employeeId].leave.push({\n      date: toDate(row.leaveDate),\n      days: Number(row.days || 0),\n    });\n  }\n}\n\n// --- work out the leave year for one employee ---\nfunction getLeaveYear(emp) {\n  if (grantMethod === 'fixed_date') {\n    // Everyone is granted on the same calendar day each year\n    const [month, day] = config.fixedGrantMonthDay.split('-');\n    let grant = toDate(`${today.getUTCFullYear()}-${month}-${day}`);\n    if (grant > today) grant = addYears(grant, -1);\n    return { grant, deadline: addDays(addYears(grant, 1), -1) };\n  }\n\n  // Default: granted six months after the hire date, then every year\n  const first = addMonths(toDate(emp.hireDate), 6);\n  if (first > today) return null; // not entitled yet\n\n  let grant = first;\n  while (addYears(grant, 1) <= today) grant = addYears(grant, 1);\n  return { grant, deadline: addDays(addYears(grant, 1), -1) };\n}\n\n// --- build one output item per employee ---\nconst results = [];\nfor (const emp of Object.values(employees)) {\n  if (!emp.active) continue;\n\n  // The five-day rule only applies to people granted 10 days or more\n  if (emp.grantedDays < 10) continue;\n\n  const year = getLeaveYear(emp);\n  if (!year) continue;\n\n  const takenDays = emp.leave\n    .filter((l) => l.date >= year.grant && l.date <= year.deadline)\n    .reduce((sum, l) => sum + l.days, 0);\n\n  const shortfall = Math.max(0, requiredDays - takenDays);\n  const daysUntilDeadline = Math.ceil(\n    (year.deadline - today) / (1000 * 60 * 60 * 24)\n  );\n\n  results.push({\n    json: {\n      employeeId: emp.employeeId,\n      name: emp.name,\n      email: emp.email,\n      grantDate: iso(year.grant),\n      deadlineDate: iso(year.deadline),\n      takenDays,\n      shortfall,\n      daysUntilDeadline,\n    },\n  });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
