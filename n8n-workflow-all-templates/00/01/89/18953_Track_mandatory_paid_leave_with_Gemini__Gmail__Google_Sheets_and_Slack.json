    {
      "id": "d7de80f1-e1fc-4448-9489-1736495c9cc1",
      "name": "Gemini LLM Analysis",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1696,
        832
      ],
      "parameters": {
        "text": "=You are an HR assistant at a Japanese company.\n\nEmployee name: {{ $json.name }}\nPaid leave taken in the current leave year: {{ $json.takenDays }} days\nDays still required by law: {{ $json.shortfall }}\nDeadline: {{ $json.deadlineDate }}\n\nWrite two messages in Japanese, separated by a line containing only \"---\".\n\nFirst message: to the employee. Polite but warm (です・ます調).\nState how many more days they need to take and by when.\nEncourage them to plan it with their manager.\nDo not sound like a warning or a reprimand, and do not ask why they\nhave not taken leave. Keep it under 200 characters.\n\nSecond message: one line for the HR team.\nFormat: 氏名 / 残り必要日数 / 期限",
        "batching": {},
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
