    {
      "id": "32d7340f-6206-421f-ac15-3140c6c30557",
      "name": "Normalize Usage Data",
      "type": "n8n-nodes-base.code",
      "position": [
        -1008,
        1456
      ],
      "parameters": {
        "jsCode": "// Normalize usage data coming from any of the 4 platform branches into a common shape\nconst item = $input.item.json;\nconst subscription = $('Loop Over Subscriptions').item.json;\n\nlet lastActiveDate = null;\n\nif (subscription.platform === 'Google Workspace') {\n  lastActiveDate = item.lastLoginTime || null;\n} else if (subscription.platform === 'Slack') {\n  lastActiveDate = item?.user?.updated ? new Date(item.user.updated * 1000).toISOString() : null;\n} else if (subscription.platform === 'Zoom') {\n  lastActiveDate = item.last_login_time || null;\n} else {\n  lastActiveDate = item.lastActive || item.last_seen || null;\n}\n\nconst now = new Date();\nconst lastActive = lastActiveDate ? new Date(lastActiveDate) : null;\nconst daysSinceLastActive = lastActive ? Math.floor((now - lastActive) / (1000 * 60 * 60 * 24)) : null;\n\nreturn [{\n  json: {\n    platform: subscription.platform,\n    userEmail: subscription.userEmail,\n    seatId: subscription.seatId,\n    monthlyCostPerSeat: subscription.monthlyCostPerSeat,\n    ownerEmail: subscription.ownerEmail,\n    lastActiveDate,\n    daysSinceLastActive\n  }\n}];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "e4da341f-4be3-4454-99c7-12797994912f",
      "name": "Parse AI Decision",
      "type": "n8n-nodes-base.code",
      "position": [
        -480,
        1392
      ],
      "parameters": {
        "jsCode": "let decision;\ntry {\n  const raw = $json.message?.content || $json.content || $json.text || '{}';\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  decision = JSON.parse(cleaned);\n} catch (e) {\n  decision = { isUnused: false, recommendation: 'review', reasoning: 'Failed to parse AI response: ' + e.message };\n}\n\nconst usage = $('Normalize Usage Data').item.json;\n\nreturn [{\n  json: {\n    ...usage,\n    isUnused: decision.isUnused,\n    recommendation: decision.recommendation,\n    reasoning: decision.reasoning\n  }\n}];\n"
      },
      "typeVersion": 2
    },
