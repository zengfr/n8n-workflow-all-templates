      "parameters": {
        "url": "https://api.deepseek.com/chat/completions",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify({ model: \"deepseek-chat\", max_tokens: 1200, messages: [{ role: \"system\", content: \"You are a video editor's assistant. Given a script and style rules, split the script into sentences, decide which ones need a visual overlay, and describe what that visual should show. Style rules:\\n\" + $json.activeInstructions }, { role: \"user\", content: \"Script:\\n\" + $json.videoScript + \"\\n\\nOutput valid JSON only, no markdown fences: { segments: [{ text: string, needs_visual: boolean, image_description: string }] }\" }] }) }}",
