    {
      "id": "a91f52a6-4a28-4f1c-9a77-373cc23de40b",
      "name": "Aggregate Segment Data",
      "type": "n8n-nodes-base.code",
      "notes": "Now receives every segment's final result at once (via the loop's done output), so this simple map replaces the old fragile positional-indexing workaround.",
      "position": [
        3280,
        2560
      ],
      "parameters": {
        "jsCode": "return [{ json: { visualSegments: items.map(i => ({\n  text: i.json.text,\n  order: i.json.order,\n  image_description: i.json.image_description,\n  imageUrl: i.json.imageUrl || null\n})) } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "be609fc8-8eb9-43c4-8f7d-19894381d1ff",
      "name": "Format Final Script",
      "type": "n8n-nodes-base.code",
      "position": [
        3440,
        2560
      ],
      "parameters": {
        "jsCode": "const allSegments = $('Parse Visual Segments').all().map(i => i.json);\nconst visualMap = {};\n$json.visualSegments.forEach(v => { visualMap[v.order] = v; });\n\nconst annotated = allSegments.map(seg => {\n  const v = visualMap[seg.order];\n  if (v) {\n    return seg.text + '\\n[VISUAL: ' + v.image_description + '\\nImage: ' + (v.imageUrl || 'generation did not complete in time') + ']';\n  }\n  return seg.text;\n}).join('\\n\\n');\n\nconst instructionsUsed = $('Set Script Instructions').item.json.activeInstructions;\n\nreturn [{ json: { annotatedScript: annotated, instructionsUsed: instructionsUsed, MemoryText: instructionsUsed, SavedAt: new Date().toISOString() } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "243246b0-4fa0-4ee5-b140-c8e645c573b1",
      "name": "Save Memory to Sheets",
