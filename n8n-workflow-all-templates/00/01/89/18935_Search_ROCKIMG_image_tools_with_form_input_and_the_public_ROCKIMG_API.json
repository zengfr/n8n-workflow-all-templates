              "name": "error",
              "type": "string",
              "value": "={{ $json.error || 'ROCKIMG tools API returned no results. Try another keyword on https://www.rockimg.com' }}"
            },
            {
              "id": "c5e2a6b8-e9be-4b0f-6ca2-rockimg-err-015",
              "name": "website",
              "type": "string",
              "value": "https://www.rockimg.com"
            }
          ]
        }
      },
      "typeVersion": 3.4
    }
