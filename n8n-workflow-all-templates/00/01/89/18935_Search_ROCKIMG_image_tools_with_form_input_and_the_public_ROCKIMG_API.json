              "type": "string",
              "value": "={{ $json.name }}"
            },
            {
              "id": "c9e6a0b2-8358-45a9-064c-rockimg-set-009",
              "name": "url",
              "type": "string",
              "value": "={{ $json.url }}"
            },
            {
              "id": "d0f7b1c3-9469-46ba-175d-rockimg-set-010",
              "name": "description",
              "type": "string",
              "value": "={{ $json.description }}"
            },
            {
              "id": "e1a8c2d4-a57a-47cb-286e-rockimg-set-011",
              "name": "source",
              "type": "string",
              "value": "https://www.rockimg.com"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "d6f3b7c9-f0cf-4c10-7db3-rockimg-err-016",
      "name": "API error",
      "type": "n8n-nodes-base.set",
      "position": [
        800,
