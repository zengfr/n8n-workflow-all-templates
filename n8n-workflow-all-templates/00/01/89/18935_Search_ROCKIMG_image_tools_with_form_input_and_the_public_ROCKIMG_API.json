    "name": "Search ROCKIMG image tools with form input and the public ROCKIMG API",
    "wechat": "youandme10086",
    "id": 18935,
    "update_time": "2026-09-27"
  },
  "name": "Search ROCKIMG Image Tools (www.rockimg.com)",
  "tags": [
    {
      "id": "tag-rockimg",
      "name": "ROCKIMG"
    }
  ],
  "nodes": [
    {
      "id": "a1c8e2f4-9b70-4d21-8e6a-rockimg-note-001",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -420,
        120
      ],
      "parameters": {
        "color": 4,
        "width": 420,
        "height": 460,
        "content": "## Search ROCKIMG image tools\n**Website: [www.rockimg.com](https://www.rockimg.com)**\n\nFind free, browser-based image tools (GIF, filters, converters, color, memes) from the public catalog API on **https://www.rockimg.com**.\n\n**API (no key):** `GET https://www.rockimg.com/api/tools?q=`\n\n1. Submit a keyword in the form (try `matcha`, `pantone`, or `gif`).\n2. This workflow calls the ROCKIMG tools API.\n3. Each result includes **name**, **url**, and **description**.\n\nOptional query params: `lang` (`en-us`, `zh-cn`, …) and `limit` (1–100).\nLocalized catalog: `https://www.rockimg.com/zh-cn/api/tools?q=滤镜`"
      },
      "typeVersion": 1
    },
    {
      "id": "b2d9f3a5-1c81-4e32-9f7b-rockimg-form-002",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        80,
        280
      ],
      "webhookId": "c3e0a4b6-2d92-4f43-a08c-rockimg-wh-003",
      "parameters": {
        "options": {
          "appendAttribution": false
        },
        "formTitle": "Search tools on www.rockimg.com",
        "formFields": {
          "values": [
            {
              "fieldName": "keyword",
              "fieldLabel": "Keyword",
              "placeholder": "e.g. matcha, pantone, gif, filter",
              "requiredField": true
            },
            {
              "fieldName": "language",
              "fieldType": "dropdown",
              "fieldLabel": "Language",
              "fieldOptions": {
                "values": [
                  {
                    "option": "en-us"
                  },
                  {
                    "option": "zh-cn"
                  },
                  {
                    "option": "de-de"
                  },
                  {
                    "option": "es-es"
                  },
                  {
                    "option": "fr-fr"
                  },
                  {
                    "option": "it-it"
                  },
                  {
                    "option": "ja-jp"
                  },
                  {
                    "option": "ko-kr"
                  },
                  {
                    "option": "nl-nl"
                  },
                  {
                    "option": "ru-ru"
                  }
                ]
              }
            },
            {
              "fieldName": "limit",
              "fieldType": "number",
              "fieldLabel": "Limit",
              "placeholder": "10"
            }
          ]
        },
        "formDescription": "ROCKIMG (https://www.rockimg.com) — free in-browser image toolkit. Search the public catalog by keyword."
      },
      "typeVersion": 2.2
    },
    {
      "id": "d4f1b5c7-3e03-4054-b19d-rockimg-http-004",
      "name": "Search ROCKIMG tools API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        320,
        280
      ],
      "parameters": {
        "url": "https://www.rockimg.com/api/tools",
        "method": "GET",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.keyword || $json.Keyword }}"
            },
            {
              "name": "lang",
              "value": "={{ $json.language || $json.Language || 'en-us' }}"
            },
            {
              "name": "limit",
              "value": "={{ $json.limit || $json.Limit || 10 }}"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "f6b3d7e9-5025-4276-d31f-rockimg-if-006",
      "name": "API ok?",
      "type": "n8n-nodes-base.if",
      "position": [
        560,
        280
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "e5a2c6d8-4f14-4165-c20e-rockimg-if-005",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.ok }}",
              "rightValue": true
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
    {
      "id": "a7c4e8f0-6136-4387-e42a-rockimg-split-007",
      "name": "Split out tools",
      "type": "n8n-nodes-base.splitOut",
      "position": [
        800,
        180
      ],
      "parameters": {
        "options": {},
        "fieldToSplitOut": "tools"
      },
      "typeVersion": 1
    },
    {
      "id": "f2b9d3e5-b68b-48dc-397f-rockimg-set-012",
      "name": "Tool name, URL, description",
      "type": "n8n-nodes-base.set",
      "position": [
        1040,
        180
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "b8d5f9a1-7247-4498-f53b-rockimg-set-008",
