    {
      "id": "af528b3e-f3f0-44d4-a190-eae7f80c13ac",
      "name": "Search TikTok videos",
      "type": "n8n-nodes-apidirect.apidirect",
      "position": [
        120,
        60
      ],
      "parameters": {
        "query": "={{ $json.keyword }}",
        "resource": "tiktok",
        "operation": "videos",
        "additionalFields": {
          "sortBy": "most_recent",
          "publishTime": 1
        }
      },
      "credentials": {
        "apidirectApi": {
          "id": "credential-id",
          "name": "API Direct account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "e314aee2-dba7-4c7b-97fa-0c2bfacc817a",
      "name": "Keep only new videos",
      "type": "n8n-nodes-base.code",
      "position": [
        340,
        60
      ],
      "parameters": {
        "jsCode": "// Remembers what earlier runs already handled (persists once the workflow is active).\nconst staticData = $getWorkflowStaticData('global');\nconst seen = new Set(staticData.seenKeys ?? []);\nconst fresh = $input.all().filter(item => {\n  const key = item.json.url;\n  return key && !seen.has(key);\n});\nfor (const item of fresh) seen.add(item.json.url);\nstaticData.seenKeys = [...seen].slice(-2000);\nreturn fresh;"
      },
      "typeVersion": 2
    },
