      "name": "Configure Session Parameters",
      "type": "n8n-nodes-base.code",
      "position": [
        -1088,
        640
      ],
      "parameters": {
        "jsCode": "const config = {\n  session_ttl_hours: 12,\n  default_pause_minutes: 30,\n  max_pause_minutes: 10080,\n  deduplicate_message_id: true\n};\n\nif (!Number.isFinite(config.session_ttl_hours) || config.session_ttl_hours <= 0) {\n  throw new Error('session_ttl_hours must be greater than zero');\n}\n\nreturn [{ json: { ...$json, config } }];"
      },
      "typeVersion": 2
    },
