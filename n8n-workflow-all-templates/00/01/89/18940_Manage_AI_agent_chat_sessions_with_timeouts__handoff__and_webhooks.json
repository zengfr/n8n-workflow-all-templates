    {
      "id": "da4b4d5d-6c8c-4104-967f-a5eaec065a47",
      "name": "Build Session Context",
      "type": "n8n-nodes-base.code",
      "position": [
        544,
        288
      ],
      "parameters": {
        "jsCode": "const state = $('Evaluate Session State').first().json;\n\nreturn [{\n  json: {\n    user_key: state.user_key,\n    session_id: state.session_id,\n    thread_key: state.thread_key,\n    status: state.status,\n    action: state.action,\n    duplicate: state.action === 'duplicate_ignored',\n    message: state.message,\n    message_id: state.message_id,\n    expires_at: state.expires_at,\n    paused_until: state.paused_until,\n    handoff_reason: state.handoff_reason,\n    closed_at: state.closed_at,\n    close_reason: state.close_reason\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "3510555a-c0f4-4b50-a9a1-63d8567cce21",
      "name": "Handle Control Request",
      "type": "n8n-nodes-base.webhook",
      "position": [
        -1536,
        960
      ],
      "webhookId": "ai-agent-session-control-template-v1",
      "parameters": {
        "path": "ai-agent-session-control",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "typeVersion": 2.1
    },
    {
      "id": "72df7680-1773-4a51-98fc-0cab1639c426",
      "name": "Normalize Command Input",
      "type": "n8n-nodes-base.code",
      "position": [
        -1312,
        960
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nif (!body.user_key) {\n  throw new Error('user_key is required');\n}\n\nif (!body.command) {\n  throw new Error('command is required');\n}\n\nconst command = String(body.command).trim().toLowerCase();\nconst allowed = ['pause', 'handoff', 'resume', 'close'];\n\nif (!allowed.includes(command)) {\n  throw new Error('command must be one of: ' + allowed.join(', '));\n}\n\nconst pauseMinutes = body.pause_minutes === undefined\n  ? null\n  : Number(body.pause_minutes);\n\nreturn [{\n  json: {\n    request_type: 'control',\n    user_key: String(body.user_key).trim(),\n    command,\n    reason: body.reason ? String(body.reason).trim() : '',\n    pause_minutes: pauseMinutes,\n    now: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "4eb949d9-7f8a-44bf-86ec-ab05193d253b",
      "name": "Fetch Session for Control",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        -640,
        960
      ],
      "parameters": {
        "limit": 1,
        "filters": {
          "conditions": [
            {
              "keyName": "user_key",
              "keyValue": "={{ $('Configure Session Parameters').item.json.user_key }}"
            }
          ]
        },
        "orderBy": true,
        "matchType": "allConditions",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "agent_sessions"
        },
        "orderByColumn": "created_at"
      },
      "typeVersion": 1.1,
      "alwaysOutputData": true
    },
    {
      "id": "c387870a-2bba-4462-b0f1-5762074f83c8",
      "name": "Execute Session Command",
      "type": "n8n-nodes-base.code",
      "position": [
        -416,
        960
      ],
      "parameters": {
        "jsCode": "const input = $('Configure Session Parameters').first().json;\nconst session = $json;\n\nif (!session.session_id) {\n  throw new Error('No session found for user_key: ' + input.user_key);\n}\n\nconst now = new Date(input.now);\nconst pauseMinutes = input.pause_minutes === null\n  ? Number(input.config.default_pause_minutes)\n  : Number(input.pause_minutes);\n\nif (\n  input.command === 'pause' &&\n  (!Number.isFinite(pauseMinutes) ||\n    pauseMinutes < 1 ||\n    pauseMinutes > Number(input.config.max_pause_minutes))\n) {\n  throw new Error(\n    'pause_minutes must be between 1 and ' +\n    input.config.max_pause_minutes\n  );\n}\n\nconst next = {\n  user_key: session.user_key,\n  session_id: session.session_id,\n  thread_key: session.thread_key,\n  command: input.command,\n  action: '',\n  status: session.status || 'active',\n  created_at: session.created_at,\n  last_activity_at: session.last_activity_at,\n  expires_at: session.expires_at,\n  paused_until: session.paused_until ?? null,\n  handoff_reason: session.handoff_reason ?? '',\n  closed_at: session.closed_at ?? null,\n  close_reason: session.close_reason ?? '',\n  last_message_id: session.last_message_id ?? ''\n};\n\nswitch (input.command) {\n  case 'pause': {\n    if (next.status === 'closed' || next.status === 'expired') {\n      throw new Error('Cannot pause a ' + next.status + ' session');\n    }\n    next.status = 'paused';\n    next.action = 'session_paused';\n    next.paused_until = new Date(now.getTime() + pauseMinutes * 60 * 1000).toISOString();\n    next.handoff_reason = input.reason;\n    next.closed_at = null;\n    next.close_reason = '';\n    break;\n  }\n  case 'handoff': {\n    if (next.status === 'closed' || next.status === 'expired') {\n      throw new Error('Cannot hand off a ' + next.status + ' session');\n    }\n    next.status = 'handed_off';\n    next.action = 'route_to_human';\n    next.paused_until = null;\n    next.handoff_reason = input.reason || 'Human assistance requested';\n    next.closed_at = null;\n    next.close_reason = '';\n    break;\n  }\n  case 'resume': {\n    if (!['paused', 'handed_off'].includes(next.status)) {\n      throw new Error('Cannot resume a ' + next.status + ' session');\n    }\n    next.status = 'active';\n    next.action = 'session_resumed';\n    next.last_activity_at = now.toISOString();\n    next.expires_at = new Date(now.getTime() + Number(input.config.session_ttl_hours) * 60 * 60 * 1000).toISOString();\n    next.paused_until = null;\n    next.handoff_reason = '';\n    next.closed_at = null;\n    next.close_reason = '';\n    break;\n  }\n  case 'close': {\n    if (next.status === 'closed') {\n      throw new Error('Session is already closed');\n    }\n    next.status = 'closed';\n    next.action = 'session_closed';\n    next.paused_until = null;\n    next.closed_at = now.toISOString();\n    next.close_reason = input.reason;\n    break;\n  }\n}\n\nreturn [{ json: next }];"
      },
      "typeVersion": 2
    },
