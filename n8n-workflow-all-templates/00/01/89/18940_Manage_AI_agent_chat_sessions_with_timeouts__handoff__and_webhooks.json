      "typeVersion": 1.1,
      "alwaysOutputData": true
    },
    {
      "id": "f43e7602-3a8f-4494-b3a9-48be0fb613e6",
      "name": "Evaluate Session State",
      "type": "n8n-nodes-base.code",
      "position": [
        -416,
        320
      ],
      "parameters": {
        "jsCode": "const input = $('Configure Session Parameters').first().json;\nconst existing = $json;\nconst now = new Date(input.now);\nconst ttlHours = Number(input.config.session_ttl_hours);\nconst SESSION_TTL_MS = ttlHours * 60 * 60 * 1000;\n\nfunction newExpiry() {\n  return new Date(now.getTime() + SESSION_TTL_MS).toISOString();\n}\n\nfunction createNewSession(action, route) {\n  const unique = Date.now() + '_' + Math.random().toString(36).slice(2, 10);\n\n  return {\n    route,\n    action,\n    user_key: input.user_key,\n    session_id: 'sess_' + unique,\n    thread_key: 'thread_' + unique,\n    status: 'active',\n    created_at: now.toISOString(),\n    last_activity_at: now.toISOString(),\n    expires_at: newExpiry(),\n    paused_until: null,\n    handoff_reason: '',\n    closed_at: null,\n    close_reason: '',\n    last_message_id: input.message_id,\n    message: input.message,\n    message_id: input.message_id\n  };\n}\n\nfunction currentSession(overrides = {}) {\n  return {\n    route: '',\n    action: '',\n    user_key: input.user_key,\n    session_id: existing.session_id,\n    thread_key: existing.thread_key,\n    status: existing.status || 'active',\n    created_at: existing.created_at,\n    last_activity_at: existing.last_activity_at,\n    expires_at: existing.expires_at,\n    paused_until: existing.paused_until ?? null,\n    handoff_reason: existing.handoff_reason ?? '',\n    closed_at: existing.closed_at ?? null,\n    close_reason: existing.close_reason ?? '',\n    last_message_id: existing.last_message_id ?? '',\n    message: input.message,\n    message_id: input.message_id,\n    ...overrides\n  };\n}\n\nif (!existing.session_id) {\n  return [{ json: createNewSession('create_session', 'create') }];\n}\n\nif (\n  input.config.deduplicate_message_id &&\n  input.message_id &&\n  existing.last_message_id &&\n  input.message_id === existing.last_message_id\n) {\n  return [{\n    json: currentSession({\n      route: 'duplicate',\n      action: 'duplicate_ignored'\n    })\n  }];\n}\n\nconst status = existing.status || 'active';\n\nif (status === 'paused') {\n  const pausedUntil = existing.paused_until\n    ? new Date(existing.paused_until)\n    : null;\n\n  if (pausedUntil && Number.isNaN(pausedUntil.getTime())) {\n    throw new Error('Invalid paused_until for session ' + existing.session_id);\n  }\n\n  if (pausedUntil && pausedUntil <= now) {\n    return [{\n      json: currentSession({\n        route: 'resume',\n        action: 'session_auto_resumed',\n        status: 'active',\n        last_activity_at: now.toISOString(),\n        expires_at: newExpiry(),\n        paused_until: null,\n        handoff_reason: '',\n        closed_at: null,\n        close_reason: '',\n        last_message_id: input.message_id || existing.last_message_id || ''\n      })\n    }];\n  }\n\n  return [{\n    json: currentSession({\n      route: 'paused',\n      action: 'wait_for_human',\n      status: 'paused',\n      last_message_id: input.message_id || existing.last_message_id || ''\n    })\n  }];\n}\n\nif (status === 'handed_off') {\n  return [{\n    json: currentSession({\n      route: 'handoff',\n      action: 'route_to_human',\n      status: 'handed_off',\n      last_message_id: input.message_id || existing.last_message_id || ''\n    })\n  }];\n}\n\nif (status === 'closed' || status === 'expired') {\n  return [{ json: createNewSession('create_session', 'create') }];\n}\n\nif (status !== 'active') {\n  throw new Error('Unsupported session status: ' + status);\n}\n\nconst expiresAt = existing.expires_at\n  ? new Date(existing.expires_at)\n  : null;\n\nif (!expiresAt || Number.isNaN(expiresAt.getTime())) {\n  return [{\n    json: currentSession({\n      route: 'resume',\n      action: 'repair_and_continue',\n      status: 'active',\n      last_activity_at: now.toISOString(),\n      expires_at: newExpiry(),\n      paused_until: null,\n      handoff_reason: '',\n      closed_at: null,\n      close_reason: '',\n      last_message_id: input.message_id || existing.last_message_id || ''\n    })\n  }];\n}\n\nif (expiresAt <= now) {\n  const next = createNewSession('create_new_session', 'expired');\n  next.old_session_id = existing.session_id;\n  return [{ json: next }];\n}\n\nreturn [{\n  json: currentSession({\n    route: 'continue',\n    action: 'continue_agent',\n    status: 'active',\n    last_activity_at: now.toISOString(),\n    last_message_id: input.message_id || existing.last_message_id || ''\n  })\n}];"
      },
      "typeVersion": 2
    },
