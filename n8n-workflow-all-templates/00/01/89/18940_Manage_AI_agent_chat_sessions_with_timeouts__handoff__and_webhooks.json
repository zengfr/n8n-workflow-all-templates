    {
      "id": "779fe389-079f-474d-901a-675d837776db",
      "name": "Normalize Message Input",
      "type": "n8n-nodes-base.code",
      "position": [
        -1312,
        320
      ],
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nif (!body.user_key) {\n  throw new Error('user_key is required');\n}\n\nif (body.message === undefined || body.message === null) {\n  throw new Error('message is required');\n}\n\nreturn [{\n  json: {\n    request_type: 'message',\n    user_key: String(body.user_key).trim(),\n    message: String(body.message),\n    message_id: body.message_id ? String(body.message_id).trim() : '',\n    now: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "ba7fdd82-5162-4387-92d0-048876dc4c7e",
      "name": "Fetch Latest Session",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        -640,
        320
      ],
      "parameters": {
        "limit": 1,
        "filters": {
          "conditions": [
            {
              "keyName": "user_key",
              "keyValue": "={{ $('Configure Session Parameters').item.json.user_key }}"
            }
          ]
        },
        "orderBy": true,
        "matchType": "allConditions",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
