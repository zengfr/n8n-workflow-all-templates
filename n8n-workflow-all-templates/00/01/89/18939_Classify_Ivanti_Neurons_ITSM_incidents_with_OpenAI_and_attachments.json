    {
      "id": "928269e1-b017-4e53-9ffb-c2a1d29a81e5",
      "name": "Get Attachment RecIds",
      "type": "n8n-nodes-base.code",
      "position": [
        1920,
        352
      ],
      "parameters": {
        "jsCode": "function extractMarkerIds(text) {\n  const ids = [];\n  const re = /\\[\\[ATTACHMENT:id=([^\\]]+)\\]\\]/gi;\n  let match;\n\n  while ((match = re.exec(String(text ?? ''))) !== null) {\n    const id = match[1].trim();\n\n    if (!ids.includes(id)) {\n      ids.push(id);\n    }\n  }\n\n  return ids;\n}\n\nfunction handleIncident(item) {\n  let Attachments = $('Get related attachments')\n    .all()\n    .filter(\n      attachment =>\n        attachment.json.ParentLink_RecID === item.json.RecId\n    )\n    .map(attachment => attachment.json.RecId);\n\n  Attachments.push(\n    ...extractMarkerIds(item.json.Symptom)\n  );\n\n  return {\n    json: {\n      ...item.json,\n      Attachments\n    }\n  };\n}\n\nconst Incidents = $('Tag Attachments').all();\n\nreturn Incidents.map(item => handleIncident(item));"
      },
      "typeVersion": 2
    },
    {
      "id": "b4160f98-ef3c-4c03-a105-b7c890d7c197",
      "name": "Tag Attachments",
      "type": "n8n-nodes-base.code",
      "position": [
        1472,
        352
      ],
      "parameters": {
        "jsCode": "function processField(html) {\n  const withMarkers = String(html || '').replace(\n    /<a\\b[^>]*data-type=[\"']attachment[\"'][^>]*>[\\s\\S]*?<\\/a>/gi,\n    (anchor) => {\n      const hrefMatch = anchor.match(/href=[\"']([^\"']+)[\"']/i);\n\n      if (!hrefMatch) {\n        return anchor;\n      }\n\n      const href = hrefMatch[1].replace(/&amp;/gi, '&');\n      const idMatch = href.match(/[?&]id=([^&]+)/i);\n\n      if (!idMatch) {\n        return anchor;\n      }\n\n      return `[[ATTACHMENT:id=${idMatch[1].trim()}]]`;\n    }\n  );\n\n  return withMarkers.replace(/<img[^>]*>/gi, '');\n}\n\nconst Incident = $('Ivanti Neurons for ITSM Polling Trigger').all();\n\nreturn Incident.map(item => ({\n  json: {\n    ...item.json,\n    Description: processField(item.json.Symptom)\n  }\n}));"
      },
      "typeVersion": 2
    }
