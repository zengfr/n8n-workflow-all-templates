    {
      "id": "96d723bc-41fc-4212-89f6-e9827eb742d3",
      "name": "Incident Mapping",
      "type": "n8n-nodes-base.code",
      "position": [
        3040,
        352
      ],
      "parameters": {
        "jsCode": "const Incidents = $('Get Attachment RecIds').all();\n\nconst Services = $('Get all services')\n  .all()\n  .map(item => `${item.json.Name}(${item.json.RecId})`)\n  .toString();\n\nlet Attachments = [];\n\nif ($('Read an attachment').isExecuted) {\n  Attachments = $('Read an attachment').all();\n}\n\nfunction handleIncident(item) {\n  const incident = item.json;\n\n  const matchingAttachments = Attachments.filter(attachment =>\n    incident.Attachments.includes(attachment.json.Attachments)\n  );\n\n  const binary = {};\n\n  matchingAttachments.forEach((attachment, index) => {\n    if (attachment.binary?.data) {\n      binary[`attachment_${index}`] = attachment.binary.data;\n    }\n  });\n\n  return {\n    json: {\n      RecId: incident.RecId,\n      Summary: incident.Subject,\n      Status: incident.Status,\n      Description: incident.Description,\n      TransactionId: incident.TransactionId,\n      Services\n    },\n    binary\n  };\n}\n\nreturn Incidents.map(handleIncident);"
      },
      "executeOnce": false,
      "typeVersion": 2
    },
