    {
      "id": "945b9c61-b5b4-43ad-938b-498d08ffc7fd",
      "name": "Parse AI JSON Output",
      "type": "n8n-nodes-base.code",
      "position": [
        -1632,
        320
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst rawText =\n  item?.content?.parts?.[0]?.text ||\n  item?.text ||\n  item?.output ||\n  item?.response?.text ||\n  '';\n\nif (!rawText) {\n  throw new Error('No AI text output found to parse');\n}\n\nlet cleaned = rawText.trim();\n\ncleaned = cleaned.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/\\s*```$/i, '').trim();\n\nconst parsed = JSON.parse(cleaned);\n\nreturn [\n  {\n    json: {\n      request_type: parsed.request_type || 'Other',\n      summary: parsed.summary || '',\n      urgency_detected: parsed.urgency ?? false,\n      owner_suggestion: parsed.owner || 'Ops Triage',\n      checklist: Array.isArray(parsed.checklist) ? parsed.checklist : []\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
