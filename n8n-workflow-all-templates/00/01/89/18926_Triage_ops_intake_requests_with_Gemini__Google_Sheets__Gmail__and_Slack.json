    {
      "id": "6e9bd2d7-da11-43a1-b5e6-2006de818d15",
      "name": "Calculate Priority Score",
      "type": "n8n-nodes-base.code",
      "position": [
        -1344,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\nconst text = (item.full_request_text || '').toLowerCase();\nconst category = item.classification || item.category || item.request_type || item.output || 'Other';\nlet score = 0;\n\nconst requestType = item.request_type || 'Other';\nconst urgency = item.urgency_detected === true;\n\nif (/urgent|asap|immediately|today|blocked|cannot work|production down/.test(text)) score += 40;\nif (/manager|client|leadership|audit|payroll|security/.test(text)) score += 20;\nif (/new joiner|onboarding|offboarding|access|vpn|laptop|invoice/.test(text)) score += 15;\nif (/whenever|no rush|next week/.test(text)) score -= 15;\n\nif (category === 'IT Support') score += 10;\nif (category === 'Access Request') score += 15;\nif (category === 'HR and People Ops') score += 10;\nif (category === 'Procurement') score += 5;\n\nlet priority = 'Low';\nlet priority_score = 20;\n\nif (urgency) {\n  priority_score += 40;\n}\n\nif (requestType === 'IT Support') {\n  priority_score += 15;\n} else if (requestType === 'Access Request') {\n  priority_score += 20;\n} else if (requestType === 'HR and People Ops') {\n  priority_score += 10;\n} else if (requestType === 'Procurement') {\n  priority_score += 5;\n} else if (requestType === 'Facilities and Admin') {\n  priority_score += 10;\n} else if (requestType === 'Finance Ops') {\n  priority_score += 10;\n}\n\nif (priority_score >= 60) {\n  priority = 'High';\n} else if (priority_score >= 35) {\n  priority = 'Medium';\n}\n\nitem.priority = priority;\nitem.priority_score = priority_score;\n\nreturn item;"
      },
      "typeVersion": 2
    },
