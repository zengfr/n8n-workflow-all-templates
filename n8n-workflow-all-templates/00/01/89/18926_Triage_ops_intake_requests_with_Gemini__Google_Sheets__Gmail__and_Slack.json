        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": "=You are an operations intake classifier.\n\nAnalyze the input and return a structured result.\n\nRules:\n1. Choose exactly one request_type from:\nIT Support\nAccess Request\nHR and People Ops\nProcurement\nFacilities and Admin\nFinance Ops\nOther\n\n2. Create a short summary in one sentence.\n3. Detect urgency as true or false.\n4. Suggest one owner from:\nIT Queue\nIT Access Desk\nHR Ops\nProcurement Team\nAdmin Team\nFinance Operations\nOps Triage\n\n5. Generate a checklist with 3 to 5 actionable steps.\n6. Return only the structured result.\n\nInput:\n{{ $json.full_request_text }}"
            }
          ]
        },
        "builtInTools": {}
      },
      "credentials": {
        "googlePalmApi": {
          "id": "YjMToIWaaQ2guKzB",
          "name": "Gemini (PAID) (AI-ML Team)"
        }
      },
