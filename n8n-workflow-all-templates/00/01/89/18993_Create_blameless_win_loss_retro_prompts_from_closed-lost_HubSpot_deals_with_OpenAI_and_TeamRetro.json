        620
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"parkable\": {\n      \"type\": \"boolean\",\n      \"description\": \"True only if the loss carries something the team can learn from. False for no-info, test, or duplicate deals.\"\n    },\n    \"prompts\": {\n      \"type\": \"array\",\n      \"maxItems\": 2,\n      \"items\": {\n        \"type\": \"string\",\n        \"description\": \"One neutral, blameless discussion prompt, max 90 characters\"\n      }\n    }\n  },\n  \"required\": [\"parkable\", \"prompts\"]\n}"
      },
      "typeVersion": 1.2
    },
