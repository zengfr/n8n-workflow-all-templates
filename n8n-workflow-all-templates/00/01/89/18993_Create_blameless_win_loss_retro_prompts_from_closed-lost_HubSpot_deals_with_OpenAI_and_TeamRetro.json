    {
      "id": "tr1500-0000-0000-0000-000000000021",
      "name": "Token-Overlap Dedupe",
      "type": "n8n-nodes-base.code",
      "position": [
        1840,
        400
      ],
      "parameters": {
        "jsCode": "// Token-overlap (Jaccard) dedupe between the new AI prompts and recently parked items.\n// LLM output is never byte-identical, so exact comparison would never fire — instead we\n// normalise both sides to word sets and measure overlap. Same constants as our other\n// parking-lot templates — tune once, copy everywhere.\n//\n// THRESHOLD: 0.6 catches rewordings of the same issue. Raise it towards 0.8 if distinct\n// items get swallowed as duplicates; lower it if near-duplicates slip through.\nconst THRESHOLD = 0.6;\n\nconst STOPWORDS = new Set([\n  'the', 'a', 'an', 'and', 'or', 'but', 'for', 'with', 'when', 'that', 'this',\n  'are', 'is', 'was', 'were', 'our', 'has', 'have', 'had', 'not', 'can',\n  'into', 'from', 'over', 'on', 'in', 'to', 'of', 'it', 'its',\n]);\n\nfunction tokens(text) {\n  return new Set(\n    String(text)\n      .toLowerCase()\n      .replace(/\\([^)]*\\)\\s*$/, ' ') // strip the \"(deal name)\" ref we append to parked titles\n      .replace(/[^\\p{L}\\p{N}\\s]/gu, ' ') // strip emoji and punctuation\n      .split(/\\s+/)\n      .filter((w) => w.length > 1 && !STOPWORDS.has(w)),\n  );\n}\n\nfunction jaccard(a, b) {\n  if (a.size === 0 || b.size === 0) return 0;\n  let overlap = 0;\n  for (const t of a) if (b.has(t)) overlap += 1;\n  return overlap / (a.size + b.size - overlap);\n}\n\nconst ai = $('Draft Retro Prompts').first().json.output;\nconst prompts = (ai.prompts ?? []).slice(0, 2);\n\nconst existing = [];\nfor (const { json: item } of $input.all()) {\n  const title = item.title ?? item.name ?? '';\n  if (!title) continue; // alwaysOutputData emits one empty item when the lot is empty\n  existing.push({ title, tok: tokens(title) });\n}\n\nconst out = [];\nfor (const prompt of prompts) {\n  const fresh = tokens(prompt);\n  let bestTitle = null;\n  let bestScore = 0;\n  for (const e of existing) {\n    const score = jaccard(fresh, e.tok);\n    if (score > bestScore) {\n      bestScore = score;\n      bestTitle = e.title;\n    }\n  }\n  out.push({\n    json: {\n      prompt,\n      duplicate: bestScore >= THRESHOLD,\n      matchedTitle: bestTitle,\n      matchScore: Math.round(bestScore * 100) / 100,\n    },\n  });\n  // A second near-identical prompt from the same run counts as a duplicate too.\n  existing.push({ title: prompt, tok: fresh });\n}\n\nreturn out;"
      },
      "typeVersion": 2
    },
