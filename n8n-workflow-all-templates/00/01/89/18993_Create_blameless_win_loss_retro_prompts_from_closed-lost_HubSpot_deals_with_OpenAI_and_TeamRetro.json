        },
        "options": {}
      },
      "typeVersion": 1.2
    },
    {
      "id": "tr1500-0000-0000-0000-000000000018",
      "name": "Parse Structured Output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
