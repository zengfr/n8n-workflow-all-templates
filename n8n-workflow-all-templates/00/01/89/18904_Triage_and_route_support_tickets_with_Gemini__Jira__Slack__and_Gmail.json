      "parameters": {
        "color": 3,
        "width": 992,
        "height": 752,
        "content": "## Team routing and notifications\n\nThis section routes the final ticket to the correct support team based on the AI suggested team value, then sends matching Slack and email notifications for billing, technical, or general support. It makes sure each team receives the same relevant information through the correct communication channels."
      },
      "typeVersion": 1
