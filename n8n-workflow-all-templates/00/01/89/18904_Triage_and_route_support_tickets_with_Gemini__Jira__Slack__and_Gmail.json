    {
      "id": "2f7844d1-3405-499a-b81b-6d3056aa6e00",
      "name": "Build Final Ticket Payload",
      "type": "n8n-nodes-base.code",
      "position": [
        -48,
        272
      ],
      "parameters": {
        "jsCode": "const priorityData = $('Map Internal Priority').first().json;\nconst triageData = $('Parse Triage Response').first().json\nconst supportData = $('Standardize Support Payload').first().json.body;\n\nconst finalPayload = {\n  ticket_id: supportData.ticket_id,\n  source: supportData.source,\n  customer_name: supportData.customer_name,\n  customer_email: supportData.customer_email,\n  subject: supportData.subject,\n  message: supportData.message,\n  received_at: supportData.received_at,\n\n  category: triageData.category,\n  priority_score: triageData.priority_score,\n  priority_label: triageData.priority_label,\n  sentiment: triageData.sentiment,\n  summary: triageData.summary,\n  suggested_team: triageData.suggested_team,\n  sla_hours: triageData.sla_hours,\n  needs_human: triageData.needs_human,\n  reason: triageData.reason,\n\n  internal_priority: priorityData.internal_priority,\n  urgent_alert: priorityData.urgent_alert,\n  ticket_title: priorityData.ticket_title,\n  triage_timestamp: priorityData.triage_timestamp,\n  team_email: priorityData.team_email\n};\n\nreturn [\n  {\n    json: finalPayload\n  }\n];"
      },
      "typeVersion": 2
    },
