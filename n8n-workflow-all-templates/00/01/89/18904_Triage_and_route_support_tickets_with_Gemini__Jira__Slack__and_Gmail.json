      "parameters": {
        "color": 3,
        "width": 608,
        "height": 640,
        "content": "## AI triage and response parsing\nThis section sends the support message to the Gemini powered AI triage step, asks the model to classify the request and assign urgency, then safely parses the AI response into structured JSON so the next nodes can use category, summary, sentiment, and team values reliably."
      },
      "typeVersion": 1
    },
    {
      "id": "d4b3c699-8b9a-43ef-b4c4-9be634f4e3c0",
