    {
      "id": "301e2621-03ab-4853-8b4a-2e7fbe1a9251",
      "name": "Generate AI Triage Decision",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        -1408,
        288
      ],
      "parameters": {
        "text": "=You are a support triage assistant.\n\nAnalyze the support request and return ONLY valid JSON.\n\nReturn these fields:\n{\n  \"category\": \"billing|technical|general\",\n  \"priority_score\": 1,\n  \"priority_label\": \"low|medium|high|critical\",\n  \"sentiment\": \"positive|neutral|negative|frustrated\",\n  \"summary\": \"short summary in 1-2 sentences\",\n  \"suggested_team\": \"billing|technical|general\",\n  \"sla_hours\": 24,\n  \"needs_human\": true,\n  \"reason\": \"short reason for classification\"\n}\n\nRules:\n- billing: payments, invoices, refunds, subscriptions\n- technical: bugs, errors, login issues, integrations, API issues\n- general: product questions, how-to, onboarding, basic info\n- critical priority: service down, data loss, security issue, repeated failed payment on business-critical account, angry escalation, legal threat\n- high priority: blocking issue, payment issue, unable to use core feature\n- medium priority: issue exists but workaround possible\n- low priority: general inquiry, how-to, feature question\n\nSubject: {{ $json.body.subject }}\nMessage: {{ $json.body.message }}\nCustomer: {{ $json.body.customer_name }}\nSource: {{ $json.body.source }}",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "964a6d07-47f9-4114-a0e4-5b8c4fd66fcc",
      "name": "Gemini Triage Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
        -1408,
        512
      ],
      "parameters": {
        "options": {
          "temperature": 0.2,
          "maxOutputTokens": 500
        },
        "modelName": "models/gemini-2.5-flash-lite"
      },
      "credentials": {
        "googlePalmApi": {
          "id": "credential-id",
          "name": "Gemini (PAID) (AI-ML Team)"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "01ac7467-e39e-4bfe-984e-35e482dd787b",
      "name": "Parse Triage Response",
      "type": "n8n-nodes-base.code",
      "position": [
        -1056,
        288
      ],
      "parameters": {
        "jsCode": "let raw = $json.output || $json.text || $json.response || '';\n\nraw = raw.trim();\n\n// Remove ```json at start\nraw = raw.replace(/^```json\\s*/i, '');\n\n// Remove ``` at end\nraw = raw.replace(/\\s*```$/i, '');\n\n// Extra cleanup for plain ``` too\nraw = raw.replace(/^```\\s*/i, '').replace(/\\s*```$/i, '');\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  parsed = {\n    category: \"general\",\n    priority_score: 2,\n    priority_label: \"medium\",\n    sentiment: \"neutral\",\n    summary: \"AI response could not be parsed, sent for manual review.\",\n    suggested_team: \"general\",\n    sla_hours: 24,\n    needs_human: true,\n    reason: \"Invalid JSON returned by AI model\"\n  };\n}\n\nreturn [\n  {\n    json: {\n      ...$input.first().json,\n      ...parsed\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
