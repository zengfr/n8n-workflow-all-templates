    {
      "id": "e40ad1ff-344c-40cc-ab09-f4559a3330f2",
      "name": "AI – Extract Tasks from Screenshot",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        1248,
        384
      ],
      "parameters": {
        "text": "You are a task extraction assistant.\n\nAnalyze this screenshot and identify all tasks, to-dos, reminders, checklist items, deadlines, or action items visible in the image.\n\nReturn ONLY valid JSON in this format:\n\n{\n  \"tasks\": [\n    {\n      \"task_title\": \"short title\",\n      \"description\": \"Detailed description of my task what I am doing from the snapshot\",\n      \"priority\": \"High, Medium, or Low\",\n      \"due_date\": \"YYYY-MM-DD or empty string\",\n      \"confidence\": \"High, Medium, or Low\"\n    }\n  ]\n}\n\nRules:\n- If there are no tasks, return {\"tasks\":[]}\n- Do not include markdown\n- Do not explain anything outside JSON\n- Keep task titles short and clean\n- If due date is not visible, leave it empty\n- If priority is unclear, use Medium",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "options": {},
        "resource": "image",
        "inputType": "base64",
        "operation": "analyze"
      },
      "credentials": {
        "openAiApi": {
          "id": "yOfw9W9XwQefVROR",
          "name": "OpenAI (PAID) (AI-ML Team)"
        }
      },
      "typeVersion": 2.1
    },
    {
      "id": "a02f7b68-733b-4c21-96a1-e4839e7d87b0",
      "name": "Parse AI Task JSON",
      "type": "n8n-nodes-base.code",
      "position": [
        1456,
        384
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nlet raw = '{}';\n\nif (Array.isArray(item) && item[0]?.content?.[0]?.text) {\n  raw = item[0].content[0].text;\n} else if (item.content?.[0]?.text) {\n  raw = item.content[0].text;\n} else if (item.output_text) {\n  raw = item.output_text;\n} else if (item.text) {\n  raw = item.text;\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  throw new Error(`Failed to parse JSON. Raw value: ${raw}`);\n}\n\nreturn [\n  {\n    json: {\n      tasks: parsed.tasks || []\n    }\n  }\n];"
      },
      "typeVersion": 2
    },
    {
      "id": "c04b5308-2bf7-46f4-a05e-362f1585f4b4",
      "name": "Expand Tasks with File Details",
      "type": "n8n-nodes-base.code",
      "position": [
        1824,
        384
      ],
      "parameters": {
        "jsCode": "const tasks = $input.first().json.tasks || [];\nconst triggerData = $('Watch Task Screenshots Folder').first().json;\n\nreturn tasks.map(task => ({\n  json: {\n    file_name: triggerData.name || '',\n    source_link: triggerData.webViewLink || '',\n    task_title: task.task_title || '',\n    description: task.description || '',\n    priority: task.priority || 'Medium',\n    due_date: task.due_date || '',\n    confidence: task.confidence || 'Medium',\n    timestamp: new Date().toISOString(),\n  }\n}));"
      },
      "typeVersion": 2
    },
