  "nodes": [
    {
      "id": "65acbd16-3217-4166-93d4-7ea7c1b3ff0e",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        672,
        80
      ],
      "parameters": {
        "color": 4,
        "width": 448,
        "height": 544,
        "content": "## 1. Capture new screenshot from Drive\nThis section checks the Task Screenshots folder every minute, and whenever a new file appears it downloads the image for processing. It turns a raw Google Drive event into an actual image file that later nodes can send to the AI model for analysis."
      },
      "typeVersion": 1
    },
    {
      "id": "79e0fae1-e974-440a-8c77-55ff11b49af6",
      "name": "Sticky Note2",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1168,
        80
      ],
      "parameters": {
        "color": 4,
        "width": 480,
        "height": 544,
        "content": "## 2. Use AI to read screenshot and build task list\nHere the image is sent to GPT‑4o‑mini with a strict prompt that returns only JSON. The Parse node then safely converts the text into a tasks array, handling different response shapes and throwing clear errors if the JSON is invalid or empty"
      },
      "typeVersion": 1
    },
    {
      "id": "a741e949-6d65-49a6-9964-63b24e92c97f",
      "name": "Sticky Note3",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1696,
        80
      ],
      "parameters": {
        "color": 4,
        "width": 352,
        "height": 544,
        "content": "## 3. Turn tasks array into individual task items\nThis section converts the tasks array into one n8n item per task and enriches each task with the original file name, Drive link, and a timestamp. It prepares a clean, flat structure that all downstream systems, like Google Sheets or Slack, can easily consume."
      },
      "typeVersion": 1
    },
    {
      "id": "f59928d1-8238-4336-8135-1be43a3e63f3",
      "name": "Sticky Note4",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        2096,
        80
      ],
      "parameters": {
        "color": 4,
        "width": 496,
        "height": 544,
        "content": "## 4. Validate tasks and log them into Google Sheets\nThis section removes any tasks that do not have a title, preventing junk rows. Valid tasks are appended to the n8n_Task_Creator_workflow spreadsheet with their description, priority, source link, and creation timestamp, creating a structured, growing task log over time."
      },
      "typeVersion": 1
    },
