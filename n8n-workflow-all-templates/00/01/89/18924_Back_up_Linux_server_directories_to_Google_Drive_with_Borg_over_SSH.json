    {
      "id": "5c5fb1ca-a170-4260-9d15-9040afdaa80f",
      "name": "Create Server Backup",
      "type": "n8n-nodes-base.ssh",
      "position": [
        2608,
        512
      ],
      "parameters": {
        "command": "=set -e\n\nSRC=\"{{ $('Build Runtime Config').item.json.config.sourceDir }}\"\nREPO=\"{{ $('Build Runtime Config').item.json.config.repoPath }}\"\nARCHIVE=\"{{ $('Build Runtime Config').item.json.config.archiveName }}\"\nENCRYPTED=\"{{ $('Build Runtime Config').item.json.config.encrypted }}\"\n\nmkdir -p \"$REPO\"\n\nif [ \"$ENCRYPTED\" = \"true\" ]; then\n  PASSPHRASE_FILE=\"$HOME/.borg/passphrase\"\n  if [ ! -f \"$PASSPHRASE_FILE\" ]; then\n    echo \"ERROR: passphrase file not found at $PASSPHRASE_FILE\"\n    exit 1\n  fi\n  export BORG_PASSPHRASE=$(cat \"$PASSPHRASE_FILE\")\n  ENCRYPTION_MODE=\"repokey-blake2\"\nelse\n  ENCRYPTION_MODE=\"none\"\nfi\n\nborg init --encryption=\"$ENCRYPTION_MODE\" \"$REPO\" 2>/dev/null || true\n\nborg create --stats --compression zstd \"$REPO::$ARCHIVE\" \"$SRC\"\n\nborg prune --keep-last 1 \"$REPO\"\nborg compact \"$REPO\"\n\nunset BORG_PASSPHRASE\necho \"backup-created\""
      },
      "typeVersion": 1
    },
