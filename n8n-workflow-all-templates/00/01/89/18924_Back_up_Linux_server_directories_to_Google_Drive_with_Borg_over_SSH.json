{
  "name": "Back Up Server Directories to Google Drive with Borg",
  "nodes": [
    {
      "id": "fa35199c-8a8d-4ca7-816f-443cf09ade8c",
      "name": "Build Initial Config",
      "type": "n8n-nodes-base.code",
      "position": [
        1264,
        416
      ],
      "parameters": {
        "jsCode": "const form = $('Get Backup Settings').first().json;\n\nconst sourceDir = (form['Source directory on the server'] || '').trim();\nconst driveId = (form['Google Drive folder ID'] || '').trim();\nconst passphrase = form['Borg encryption passphrase'] || '';\n\nconst SAFE_PATH_RE = /^\\/[A-Za-z0-9_\\-./]+$/;\nconst SAFE_DRIVE_ID_RE = /^[A-Za-z0-9_-]+$/;\nconst SHELL_METACHAR_RE = /[;&|`$(){}<>\\\\'\"\\n\\r]/;\n\nif (!SAFE_PATH_RE.test(sourceDir)) {\n  throw new Error('Invalid source directory: must be an absolute path using only letters, numbers, underscores, hyphens, dots and slashes.');\n}\n\nif (sourceDir.includes('..')) {\n  throw new Error('Invalid source directory: path traversal is not allowed.');\n}\n\nif (!SAFE_DRIVE_ID_RE.test(driveId)) {\n  throw new Error('Invalid Google Drive folder ID: only letters, numbers, underscores and hyphens are allowed.');\n}\n\nif (SHELL_METACHAR_RE.test(passphrase)) {\n  throw new Error('Invalid passphrase: contains disallowed characters.');\n}\n\nconst modeLabel = $('Get Backup Settings').first().json['Google Drive backup mode']|| '';\nconst mode = modeLabel.toLowerCase().includes('sync') ? 'sync' : 'versioned';\n\nconst encryptLabel = form['Encrypt the backup?'] || '';\nconst encrypted = !encryptLabel.toLowerCase().startsWith('no');\n\nconst config = {\n  sourceDir,\n  mode,\n  encrypted,\n  driveId\n};\n\nreturn [{\n  json: {\n    config,\n    borgPassphrase: passphrase\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "26a4452d-9e23-4bdb-a48e-e689635ade8c",
      "name": "Export Backup Archive",
      "type": "n8n-nodes-base.ssh",
      "position": [
        2832,
        512
      ],
      "parameters": {
        "command": "=set -e\n\nREPO=\"{{ $('Build Runtime Config').item.json.config.repoPath }}\"\nSTAGING=\"{{ $('Build Runtime Config').item.json.config.stagingDir }}\"\nOUTFILE=\"{{ $('Build Runtime Config').item.json.config.exportFileName }}\"\n\nmkdir -p \"$STAGING\"\n\n# Package the entire Borg repository into a single tar.gz\ntar -czf \"$STAGING/$OUTFILE\" \\\n    -C \"$(dirname \"$REPO\")\" \\\n    \"$(basename \"$REPO\")\"\n\necho \"export-done\""
      },
      "typeVersion": 1
    },
    {
      "id": "ff8a5ccc-2391-42d4-8c73-7a693a500688",
