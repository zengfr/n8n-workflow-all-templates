    {
      "id": "af21a472-54ca-4aea-bccd-6e60e9eef3f5",
      "name": "Existing File Info",
      "type": "n8n-nodes-base.code",
      "position": [
        3280,
        512
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst existingFileId = (items.length > 0 && items[0].json && items[0].json.id) ? items[0].json.id : '';\nconst cfg = $('Build Runtime Config').item.json.config;\n\nreturn {\n  existingFileId,\n  fileBaseName: cfg.fileBaseName,\n  driveFolderId: cfg.driveFolderId,\n  driveMode: cfg.driveMode,\n  exportFileName: cfg.exportFileName,\n  archiveName: cfg.archiveName\n};"
      },
      "typeVersion": 2
    },
