    {
      "id": "1dcbec9e-7ca3-40fe-9973-dcfa95dd613b",
      "name": "Store Borg Passphrase on Server",
      "type": "n8n-nodes-base.ssh",
      "position": [
        1488,
        416
      ],
      "parameters": {
        "command": "=set -e\n\nENCRYPTED=\"{{ $json.config.encrypted }}\"\nPASSPHRASE_DIR=\"$HOME/.borg\"\nPASSPHRASE_FILE=\"$PASSPHRASE_DIR/passphrase\"\n\nmkdir -p \"$PASSPHRASE_DIR\"\nchmod 700 \"$PASSPHRASE_DIR\"\n\nif [ \"$ENCRYPTED\" = \"true\" ]; then\n  printf '%s' \"{{ $('Get Backup Settings').item.json['Borg encryption passphrase'] }}\" > \"$PASSPHRASE_FILE\"\n  chmod 600 \"$PASSPHRASE_FILE\"\n  echo \"passphrase-saved\"\nelse\n  rm -f \"$PASSPHRASE_FILE\"\n  echo \"no-encryption-configured\"\nfi"
      },
      "typeVersion": 1
    },
    {
      "id": "57bd2ef0-ca12-441e-99ea-4619ad479bdb",
      "name": "Install Borg on Server",
      "type": "n8n-nodes-base.ssh",
      "position": [
        2160,
        512
      ],
      "parameters": {
        "command": "=#!/bin/bash\nset -e\n\nif command -v borg >/dev/null 2>&1; then\n\techo \"Borg installed:\"\n\tborg --version\n\texit 0\nfi\n\necho \"Borg is not installed.\"\n\nif [ ! -f /etc/os-release ]; then\n\techo \"Unsupported OS\"\n\texit 1\nfi\n\n. /etc/os-release\n\nOS_ID=\"${ID:-unknown}\"\n\ncase \"$OS_ID\" in\nubuntu | debian)\n\tsudo apt-get update\n\tsudo apt-get install -y borgbackup\n\t;;\n\nfedora)\n\tsudo dnf install -y borgbackup\n\t;;\n\nrocky | rhel | centos | almalinux)\n\tif command -v dnf >/dev/null 2>&1; then\n\t\tsudo dnf install -y dnf-plugins-core\n\t\tVERSION_ID=\"${VERSION_ID:-0}\"\n\t\t# Rocky/RHEL 9+\n\t\tif [ \"${VERSION_ID%%.*}\" -ge 9 ]; then\n\t\t\tsudo dnf install -y epel-release\n\t\t\tsudo dnf config-manager --set-enabled crb\n\t\telse\n\t\t\t# Rocky/RHEL 8\n\t\t\tsudo dnf install -y epel-release\n\t\t\tsudo dnf config-manager --set-enabled powertools\n\t\tfi\n\n\t\tsudo dnf install -y borgbackup\n\n\telif command -v yum >/dev/null 2>&1; then\n\n\t\tsudo yum install -y epel-release\n\t\tsudo yum install -y borgbackup\n\n\telse\n\t\techo \"ERROR: Neither dnf nor yum is available.\"\n\t\texit 1\n\tfi\n\t;;\n\n*)\n\techo \"Unsupported OS: $OS_ID\"\n\texit 1\n\t;;\nesac\n\necho \"Borg installed:\"\nborg --version\n"
      },
      "typeVersion": 1
    },
    {
      "id": "4033b5ce-c50e-4fd5-b280-a2646a4d74d7",
      "name": "Build Runtime Config",
      "type": "n8n-nodes-base.code",
      "position": [
        2384,
        512
      ],
      "parameters": {
        "jsCode": "const cfg = $('Get Config').item.json;\n\nconst sourceDir = (cfg.sourceDir || '').replace(/\\/+$/, '');\nconst fileBaseName = sourceDir.split('/').filter(Boolean).pop() || 'backup';\n\nconst now = new Date();\nconst dateStr = now.toISOString().replace(/[:.]/g, '-').slice(0, 19);\n\nconst repoPath = `$HOME/.borg-repos/${fileBaseName}`;\nconst archiveName = `${fileBaseName}-${dateStr}`;\nconst stagingDir = '/tmp/borg-staging';\n\nconst driveMode = $('Get Config').first().json.backupMode\n\nconst exportFileName = driveMode === 'versioned'\n  ? `${archiveName}.tar.gz`\n  : `${fileBaseName}-latest-backup.tar.gz`;\n\nreturn {\n  config: {\n    sourceDir,\n    fileBaseName,\n    encrypted:$('Get Config').first().json.encrypted,\n    driveFolderId: cfg.driveFolderId,\n    driveMode,\n    repoPath,\n    archiveName,\n    stagingDir,\n    exportFileName\n  }\n};"
      },
      "typeVersion": 2
    },
