    {
      "id": "cac5085b-2f1c-4ec5-99a9-bb2c0452f4bb",
      "name": "Deduplicate Escalation",
      "type": "n8n-nodes-base.code",
      "position": [
        5040,
        2640
      ],
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.notifiedUsers) staticData.notifiedUsers = {};\n\nconst messages = $('WhatsApp Trigger').item.json.messages || [];\nconst phone = messages[0]?.from;\nconst now = Date.now();\nconst COOLDOWN_MS = 24 * 60 * 60 * 1000; // 24 hours\n\nif (phone && staticData.notifiedUsers[phone] && (now - staticData.notifiedUsers[phone] < COOLDOWN_MS)) {\n  return []; // notified within last 24h, skip\n}\n\nif (phone) {\n  staticData.notifiedUsers[phone] = now;\n}\n\nreturn [$input.item];"
      },
      "typeVersion": 2
    },
