    {
      "id": "c9ba1a0c-3e52-4b0f-8935-19cfc386af04",
      "name": "book_appointment",
      "type": "n8n-nodes-base.googleCalendarTool",
      "position": [
        4064,
        3888
      ],
      "parameters": {
        "end": "={{ $fromAI('End', 'Appointment end date and time in ISO 8601 format', 'string') }}",
        "start": "={{ $fromAI('Start', 'Appointment start date and time in ISO 8601 format', 'string') }}",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": ""
        },
        "descriptionType": "manual",
        "toolDescription": "Create an event in Google Calendar. Only call this after check_availability confirms the slot is free. If the slot is unavailable, do not book automatically. Tell the customer, suggest one or two nearby times, and wait for confirmation.\n\nBefore calling this, check conversation history. If an appointment for this property was already confirmed, do not create a new booking. Only call again if the customer explicitly asks to change, reschedule, or cancel.\n\nAlways express times with explicit timezone offset, Europe/London.",
        "additionalFields": {
          "summary": "={{ $fromAI('Summary', 'Short title for the viewing appointment, e.g., Property Viewing - 123 Main St', 'string') }}",
          "location": "={{ $fromAI('Location', 'Property address or meeting location in the UK (e.g., London, Manchester)', 'string') }}",
          "description": "={{ $fromAI('Description', `Details: client name, phone, property of interest, and any notes`, 'string') }}"
        }
