    {
      "id": "ebede562-045d-476f-b58c-ac29090d86bd",
      "name": "Split Outputs Into Items",
      "type": "n8n-nodes-base.code",
      "position": [
        54112,
        19056
      ],
      "parameters": {
        "jsCode": "const g = $input.first().json.generation;\nconst title = $('Build Product URL').item.json.productTitle;\nreturn (g.outputs || []).map(o => ({ json: {\n  product: title, format: o.format, fileUrl: o.fileUrl, generationId: g.id } }));"
      },
      "typeVersion": 2
    },
