      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inputData = $('¿Falta NIT?').item.json;\nconst googleResponse = $json || {};\nconst items = googleResponse.items || [];\nlet foundNit = '';\nlet foundRazon = '';\n\nfor (const item of items) {\n  const text = (item.title + ' ' + item.snippet).replace(/\\n/g, ' ');\n  \n  // Look for NIT pattern 800.xxx.xxx or 900.xxx.xxx\n  const nitMatch = text.match(/(?:NIT|N\\.I\\.T\\.?|Nit)[\\s:-]*([89][0-9]{2}[.\\-\\s]?[0-9]{3}[.\\-\\s]?[0-9]{3}[\\-\\s]?[0-9])/i);\n  if (nitMatch && !foundNit) {\n    foundNit = nitMatch[1].replace(/[^0-9]/g, '');\n  }\n}\n\nreturn {json: {\n  ...inputData,\n  nit: foundNit || inputData.nit,\n  estado: foundNit ? 'Enriquecido (Google API)' : inputData.estado,\n  observaciones: foundNit ? inputData.observaciones : inputData.observaciones + ' | No se encontró NIT en Google'\n}};"
      },
      "typeVersion": 2
    },
