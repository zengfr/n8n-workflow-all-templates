        "jsCode": "const x=$json;\nconst v = (val) => val ? val : '-vacio-';\nreturn {json:{\n'Fecha extracción':x.fecha_extraccion||'', 'Consulta':x.consulta||'', 'Place ID':x.place_id||'',\n'Dominio normalizado':v(x.dominio_normalizado), 'Nombre verificado':v(x.nombre_verificado),\n'Razón social':v(x.razon_social), 'NIT':v(x.nit), 'Dirección verificada':v(x.direccion_verificada),\n'Teléfono':v(x.telefono), 'WhatsApp':v(x.whatsapp), 'Correo':v(x.correo), 'Web oficial':v(x.web_oficial),\n'Instagram':v(x.instagram), 'Facebook':v(x.facebook), 'LinkedIn':v(x.linkedin),\n'Estado':x.estado||'', 'Confianza':x.confianza??'', 'Observaciones':x.observaciones||''\n}};"
      },
