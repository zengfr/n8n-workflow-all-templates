    {
      "id": "a66c9ebb-8242-4ac7-895f-d8a562324f05",
      "name": "Procesar Formulario",
      "type": "n8n-nodes-base.code",
      "position": [
        1360,
        336
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $json || {};\n\nfunction findValue(obj, keySubstrings) {\n    if (!obj || typeof obj !== 'object') return undefined;\n    for (const key of Object.keys(obj)) {\n        const lowerKey = key.toLowerCase();\n        if (keySubstrings.some(sub => lowerKey.includes(sub))) {\n            return obj[key];\n        }\n        if (typeof obj[key] === 'object') {\n            const found = findValue(obj[key], keySubstrings);\n            if (found !== undefined) return found;\n        }\n    }\n    return undefined;\n}\n\nconst nicho = findValue(src, ['nicho']) || 'restaurantes';\nconst ciudad = findValue(src, ['ciudad']) || 'Bogotá';\nconst pais = findValue(src, ['país', 'pais']) || 'Colombia';\nconst maxStr = findValue(src, ['máximo', 'maximo', 'max']) || 20;\n\nconst extractNum = (v) => { const m = String(v).match(/\\d+/); return m ? Number(m[0]) : NaN; };\nconst max_resultados = extractNum(maxStr) || 20;\n\nif (max_resultados > 60) {\n    throw new Error('⚠️ Has superado el límite de seguridad. No se permiten más de 60 resultados por ejecución para proteger tu cuota de API. Por favor, vuelve atrás y coloca un número entre 1 y 60.');\n}\n\nreturn {json: {\n    nicho,\n    ciudad,\n    pais,\n    max_resultados\n}};"
      },
      "typeVersion": 2
    },
    {
      "id": "16c6d97c-7de1-409c-bf08-36c0a276b58a",
      "name": "Google Places - Text Search",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1568,
        336
      ],
      "parameters": {
        "url": "https://places.googleapis.com/v1/places:searchText",
        "method": "POST",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "jsonBody": "={{ JSON.stringify({ textQuery: $json.nicho + ' en ' + $json.ciudad + ', ' + $json.pais, pageSize: Math.min(Number($json.max_resultados || 20), 20), languageCode: 'es' }) }}",
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Goog-Api-Key",
              "value": "PONER_TU_API_AQUI"
            },
            {
              "name": "X-Goog-FieldMask",
              "value": "places.id,places.displayName,places.formattedAddress,places.nationalPhoneNumber,places.internationalPhoneNumber,places.websiteUri,places.googleMapsUri"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "6f48f0ec-e12e-4a91-9f67-d3c9ee5cb42f",
      "name": "Preparar negocios",
      "type": "n8n-nodes-base.code",
      "position": [
        1760,
        336
      ],
      "parameters": {
        "jsCode": "const cfg = $('Procesar Formulario').first().json;\nconst places = Array.isArray($json.places) ? $json.places : [];\nconst normalizeDomain = (url) => {\n  if (!url) return '';\n  try { return new URL(url).hostname.toLowerCase().replace(/^www\\./, '').replace(/\\.$/, ''); }\n  catch { return ''; }\n};\nreturn places.slice(0, Number(cfg.max_resultados || 20)).map((p) => ({json: {\n  fecha_extraccion: new Date().toISOString(),\n  consulta: `${cfg.nicho} en ${cfg.ciudad}, ${cfg.pais}`,\n  place_id: p.id || '',\n  dominio_normalizado: normalizeDomain(p.websiteUri),\n  nombre_verificado: p.displayName?.text || '',\n  razon_social: '', nit: '',\n  direccion_verificada: p.formattedAddress || '',\n  telefono: p.internationalPhoneNumber || p.nationalPhoneNumber || '',\n  whatsapp: '', correo: '',\n  web_oficial: p.websiteUri || '',\n  instagram: '', facebook: '', linkedin: '',\n  estado: p.websiteUri ? 'Pendiente enriquecimiento web' : 'Sin sitio web',\n  confianza: p.websiteUri ? 60 : 45,\n  observaciones: p.websiteUri ? '' : 'Google Places no informó sitio web oficial'\n}}));"
      },
      "typeVersion": 2
    },
