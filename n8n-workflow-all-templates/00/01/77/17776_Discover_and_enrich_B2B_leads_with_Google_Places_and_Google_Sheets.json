    {
      "id": "5dcdd05a-6686-4d20-afe1-4ac9e2076309",
      "name": "Extraer datos web",
      "type": "n8n-nodes-base.code",
      "position": [
        2624,
        224
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst base = $('Loop Over Items - Negocios').item.json;\nconst body = typeof $json === 'string' ? $json : ($json.body || $json.data || '');\nconst html = String(body || '').slice(0, 1000000);\n\nconst clean = (v) => String(v || '').replace(/&amp;/gi,'&').replace(/&#64;/g,'@').trim();\nconst first = (regex, text) => { const m = (text||html).match(regex); return m ? clean(m[1]) : ''; };\nconst textOf = (value) => String(value || '').replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim();\n\nconst title = first(/<title[^>]*>([\\s\\S]*?)<\\/title>/i);\nconst nombre_verificado = title ? textOf(title) : '';\n\nconst hrefs = [...html.matchAll(/href=[\"']([^\"']+)[\"']/gi)].map(m => clean(m[1]));\nconst email = first(/mailto:([^?\"'<>\\s]+)/i) || first(/\\b([A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,})\\b/i);\n\nconst wa = hrefs.find(x => /(?:wa\\.me|api\\.whatsapp\\.com|whatsapp\\.com)/i.test(x)) || '';\nconst url_legal_raw = hrefs.find(x => /(?:privacidad|terminos|condiciones|legal|aviso|policies|terms)/i.test(x)) || '';\nconst makeAbsolute = (url) => { if (!url) return ''; if (url.startsWith('http')) return url; try { return new URL(url, base.web_oficial).href; } catch { return ''; } };\nconst url_legal = makeAbsolute(url_legal_raw);\nconst phone = first(/href\\s*=\\s*[\"']tel:([^\"']+)/i) || first(/(?:tel:|telefono|teléfono)[^\\d]{0,20}(\\+?[\\d][\\d\\s().-]{6,})/i);\n\nconst social = (host) => hrefs.find(x => x.toLowerCase().includes(host)) || '';\n\nconst nit = first(/(?:NIT|N\\.I\\.T\\.?|Nit)\\s*[:#-]?\\s*([0-9][0-9.\\-\\s]{6,18})/i);\nconst legal = first(/(?:Raz[oó]n social|Nombre legal)\\s*[:\\-]?\\s*([^<\\n]{3,120})/i);\n\nlet json_nombre = '', json_razon = '', json_nit = '', json_tel = '', json_dir = '';\nconst jsonLd = html.match(/<script[^>]+type=[\"']application\\/ld\\+json[\"'][^>]*>([\\s\\S]*?)<\\/script>/ig) || [];\nfor (const block of jsonLd) {\n  const raw = first(/>([\\s\\S]*)<\\/script>/i, block);\n  try {\n    const parsed = JSON.parse(raw);\n    const items = Array.isArray(parsed) ? parsed : [parsed];\n    for (const item of items) {\n      if (!json_nombre && item?.name) json_nombre = item.name;\n      if (!json_razon && item?.legalName) json_razon = item.legalName;\n      if (!json_nit && item?.taxID) json_nit = item.taxID;\n      if (!json_tel && item?.telephone) json_tel = item.telephone;\n      if (!json_dir && item?.address) json_dir = typeof item.address === 'string' ? item.address : [item.address.streetAddress, item.address.addressLocality, item.address.addressCountry].filter(Boolean).join(', ');\n    }\n  } catch(e) {}\n}\n\nconst final_razon = json_razon || legal || base.razon_social;\nconst final_nit = json_nit || nit || base.nit;\nconst final_wa = wa || base.whatsapp;\nconst final_correo = email || base.correo;\nconst final_tel = json_tel || phone || base.telefono;\nconst final_nombre = json_nombre || nombre_verificado || base.nombre_verificado;\nconst final_dir = json_dir || base.direccion_verificada;\n\nreturn {json:{...base,\n  nombre_verificado: final_nombre,\n  razon_social: final_razon,\n  nit: final_nit,\n  telefono: final_tel,\n  direccion_verificada: final_dir,\n  whatsapp: final_wa,\n  correo: final_correo,\n  instagram: social('instagram.com') || base.instagram,\n  facebook: social('facebook.com') || base.facebook,\n  linkedin: social('linkedin.com') || base.linkedin,\n  url_legal: url_legal,\n  estado: html ? 'Enriquecido (Nivel)' : 'Error controlado',\n  confianza: html ? Math.min(95, Number(base.confianza || 0) + (final_correo?10:0) + (final_nit?15:0) + (final_razon?10:0) + (json_nombre?5:0)) : base.confianza,\n  observaciones: html ? base.observaciones : [base.observaciones,'No fue posible leer el sitio web'].filter(Boolean).join(' | ')\n}};\n"
      },
      "typeVersion": 2
    },
    {
