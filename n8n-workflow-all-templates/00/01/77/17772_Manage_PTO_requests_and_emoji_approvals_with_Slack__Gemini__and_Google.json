              "id": "b1",
              "name": "start_date",
              "type": "string",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).start_date }}"
            },
            {
              "id": "b2",
              "name": "end_date",
              "type": "string",
              "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).end_date }}"
