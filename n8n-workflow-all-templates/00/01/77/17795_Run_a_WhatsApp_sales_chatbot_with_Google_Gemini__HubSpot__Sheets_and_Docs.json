        "color": 7,
        "width": 464,
        "height": 320,
        "content": "## WhatsApp intake filter\n\nReceives incoming WhatsApp messages and filters them so only valid inbound customer messages continue into the sales chatbot flow."
      },
      "typeVersion": 1
    },
