      "parameters": {
        "jsCode": "const g = $input.first().json.generation;\nconst fileUrl = (g.outputs && g.outputs[0] && g.outputs[0].fileUrl) || '';\nreturn [{ json: { fileUrl, postText: $('Extract Post Text').item.json.postText } }];"
      },
