      "webhookId": "f0880d53-cbc0-435f-8be8-f15f0a9035c3",
      "parameters": {
        "sendTo": "={{ $('Build Client Session').first().json.clientEmail }}",
        "message": "<div style=\"font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#1f2328;max-width:560px\">\n<p>Hi {{ $('Build Client Session').first().json.clientName }},</p>\n\n<p>You&rsquo;re confirmed &mdash; looking forward to it.</p>\n\n<table style=\"border-collapse:collapse;margin:18px 0\">\n  <tr><td style=\"padding:4px 16px 4px 0;color:#57606a\">When</td><td style=\"padding:4px 0;font-weight:600\">{{ $('Build Client Session').first().json.slotHuman }}</td></tr>\n  <tr><td style=\"padding:4px 16px 4px 0;color:#57606a\">Length</td><td style=\"padding:4px 0\">{{ $('Build Client Session').first().json.callDurationMinutes }} minutes</td></tr>\n  <tr><td style=\"padding:4px 16px 4px 0;color:#57606a\">Where</td><td style=\"padding:4px 0\">{{ $('Build Client Session').first().json.meetLink || 'Details are on the calendar invite' }}</td></tr>\n</table>\n\n<p style=\"color:#57606a;font-size:14px\">The event is already on your calendar, so you&rsquo;ll get Google&rsquo;s own reminders too.</p>\n\n<p>See you then,<br>{{ $('Build Client Session').first().json.hostName }}<br><span style=\"color:#57606a\">{{ $('Build Client Session').first().json.companyName }}</span></p>\n</div>",
        "options": {
