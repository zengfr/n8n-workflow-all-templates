    {
      "id": "54df79ee-4dc8-4cd6-92f7-9a188ec15c18",
      "name": "Suggest Discovery Call Slot",
      "type": "n8n-nodes-base.code",
      "position": [
        1808,
        688
      ],
      "parameters": {
        "jsCode": "// Picks the first free working-hours slot on the host calendar and attaches\n// it to the client record. Runs once for all items.\n\nconst cfg = $('Workflow Settings').first().json;\nconst client = $('Prepare Client Record').first().json;\n\nconst durationMin   = Number(cfg.callDurationMinutes) || 30;\nconst offsetHours   = Number(cfg.earliestSlotOffsetHours) || 24;\nconst dayStartHour  = Number(cfg.workDayStartHour) || 9;\nconst dayEndHour    = Number(cfg.workDayEndHour) || 17;\nconst searchDays    = Number(cfg.slotSearchWindowDays) || 21;\n\n// Collect busy blocks from the calendar lookup.\nconst busy = [];\nfor (const item of $input.all()) {\n  const s = item.json?.start?.dateTime || item.json?.start?.date;\n  const e = item.json?.end?.dateTime   || item.json?.end?.date;\n  const status = item.json?.status;\n  if (!s || !e || status === 'cancelled') continue;\n  busy.push([new Date(s).getTime(), new Date(e).getTime()]);\n}\n\nconst STEP_MS     = 30 * 60 * 1000;\nconst durationMs  = durationMin * 60 * 1000;\nconst limitMs     = Date.now() + searchDays * 24 * 60 * 60 * 1000;\n\n// Start from \"now + lead time\", rounded up to the next half hour.\nlet cursor = new Date(Date.now() + offsetHours * 60 * 60 * 1000);\ncursor.setSeconds(0, 0);\ncursor.setMinutes(cursor.getMinutes() % 30 === 0 ? cursor.getMinutes() : Math.ceil(cursor.getMinutes() / 30) * 30);\n\nlet chosen = null;\nwhile (cursor.getTime() < limitMs) {\n  const startMs = cursor.getTime();\n  const endMs   = startMs + durationMs;\n  const end     = new Date(endMs);\n\n  const isWeekday  = cursor.getDay() >= 1 && cursor.getDay() <= 5;\n  const startsInDay = cursor.getHours() >= dayStartHour && cursor.getHours() < dayEndHour;\n  const endsInDay   = end.getHours() < dayEndHour || (end.getHours() === dayEndHour && end.getMinutes() === 0);\n  const sameDay     = end.getDate() === cursor.getDate();\n  const clashes     = busy.some(([bs, be]) => startMs < be && endMs > bs);\n\n  if (isWeekday && startsInDay && endsInDay && sameDay && !clashes) {\n    chosen = { startMs, endMs };\n    break;\n  }\n  cursor = new Date(startMs + STEP_MS);\n}\n\nif (!chosen) {\n  throw new Error(\n    'No free ' + durationMin + '-minute slot found in the next ' + searchDays +\n    ' days. Widen workDayStartHour / workDayEndHour or slotSearchWindowDays in \"Workflow Settings\".'\n  );\n}\n\nconst start = new Date(chosen.startMs);\nconst end   = new Date(chosen.endMs);\n\nreturn [{\n  json: {\n    ...client,\n    slotStart: start.toISOString(),\n    slotEnd: end.toISOString(),\n    slotHuman: start.toLocaleString('en-US', {\n      weekday: 'long', month: 'long', day: 'numeric',\n      hour: 'numeric', minute: '2-digit', timeZoneName: 'short',\n    }),\n    callDurationMinutes: durationMin,\n  },\n}];"
      },
      "typeVersion": 2
    },
