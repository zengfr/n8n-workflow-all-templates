    {
      "id": "4994a61b-f82a-4785-91c0-e1aca0594986",
      "name": "Send Booking Invitation",
      "type": "n8n-nodes-base.gmail",
      "position": [
        2688,
        688
      ],
      "webhookId": "7efc379d-e569-462b-b8a2-3a3a627d8b38",
      "parameters": {
        "sendTo": "={{ $json.clientEmail }}",
        "message": "=<div style=\"font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#1f2328;max-width:560px\">\n<p>Hi {{ $json.clientName }},</p>\n\n<p>Thanks for reaching out{{ $json.clientCompany ? ' from ' + $json.clientCompany : '' }} &mdash; I&rsquo;d love to talk through {{ $json.clientGoal || 'what you\\'re working on' }}.</p>\n\n<p>I&rsquo;ve pencilled in a <strong>{{ $json.callDurationMinutes }}-minute discovery call</strong> for:</p>\n\n<p style=\"font-size:17px;font-weight:600;margin:18px 0\">{{ $json.slotHuman }}</p>\n\n<p>\n  <a href=\"{{ $json.bookingLink }}\"\n     style=\"display:inline-block;background:#1a73e8;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:6px;font-weight:600\">\n    Confirm this time\n  </a>\n</p>\n\n<p style=\"color:#57606a;font-size:14px\">\n  That link opens the invite in Google Calendar. Hit <strong>Yes</strong> to lock it in, or use\n  <em>Propose a new time</em> if it doesn&rsquo;t work &mdash; either way I&rsquo;ll see it.\n</p>\n\n{{ $json.reschedulePageUrl ? '<p style=\"color:#57606a;font-size:14px\">Prefer to pick your own slot? <a href=\"' + $json.reschedulePageUrl + '\">See my full availability here</a>.</p>' : '' }}\n\n<p>Speak soon,<br>{{ $json.hostName }}<br><span style=\"color:#57606a\">{{ $json.companyName }}</span></p>\n</div>",
        "options": {
          "senderName": "={{ $json.hostName }}",
          "appendAttribution": false
        },
        "subject": "=Your discovery call with {{ $json.hostName }} — confirm your slot"
      },
