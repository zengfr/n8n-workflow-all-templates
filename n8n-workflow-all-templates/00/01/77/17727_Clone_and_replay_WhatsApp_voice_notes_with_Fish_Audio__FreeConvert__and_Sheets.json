        576,
        160
      ],
      "parameters": {
        "color": 7,
        "width": 640,
        "height": 320,
        "content": "## Receive and classify message\n\nEntry cluster that receives an incoming WhatsApp message, extracts the phone number, message type, media ID, and text body, then routes the message based on whether it is a voice note."
      },
      "typeVersion": 1
    },
