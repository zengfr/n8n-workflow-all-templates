    },
    {
      "id": "77380b0e-bc69-429c-ad4c-3941b17b841b",
      "name": "Write SEO Article",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        48752,
        17680
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": "=You are an SEO content writer. Write a complete, publish-ready blog article optimized for the keyword \"{{ $('When Keyword Submitted').item.json['Target keyword'] }}\". Return STRICT JSON only: {\"title\": \"...\", \"body_html\": \"<p>...</p>\", \"summary\": \"one-sentence summary for the featured image\"}. No preamble, no markdown fences."
            }
          ]
        }
      },
      "typeVersion": 1.8
    },
    {
      "id": "fa79f947-e26b-4984-b1a0-a9e6d3b40c8c",
      "name": "Parse Article JSON",
      "type": "n8n-nodes-base.code",
      "position": [
        49024,
        17680
      ],
      "parameters": {
        "jsCode": "const raw = $json.message?.content ?? $json.text ?? $json.content ?? '';\nlet a; try { a = JSON.parse(raw); } catch(e) {\n  const m = String(raw).match(/\\{[\\s\\S]*\\}/); a = m ? JSON.parse(m[0]) : { title:'Untitled', body_html:String(raw), summary:'' };\n}\nreturn [{ json: a }];"
      },
      "typeVersion": 2
    },
    {
      "id": "99a2b135-2f3d-4049-814a-d412f9886d45",
      "name": "Post Article to Canvora",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        49312,
        17680
      ],
      "parameters": {
        "url": "https://api.canvora.ai/api/generations",
        "method": "POST",
        "options": {},
        "jsonBody": "={{ JSON.stringify(Object.assign({\n  inputType: 'text',\n  inputContent: $('Parse Article JSON').item.json.summary || $('Parse Article JSON').item.json.title,\n  title: 'Blog visuals: ' + $('Parse Article JSON').item.json.title,\n  outputFormats: ['blog_featured', 'og_image']\n}, $('When Keyword Submitted').item.json['Brand ID (optional)'] ? { brandId: $('When Keyword Submitted').item.json['Brand ID (optional)'] } : {})) }}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "typeVersion": 4.2
    },
    {
      "id": "bd2085f2-f7d2-4ba1-b193-912343938393",
