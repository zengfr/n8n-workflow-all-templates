    {
      "id": "6d39c73d-154a-4b94-8e08-aa3663664169",
      "name": "Build WordPress Post",
      "type": "n8n-nodes-base.code",
      "position": [
        50640,
        17680
      ],
      "parameters": {
        "jsCode": "const g = $input.first().json.generation;\nconst outs = g.outputs || [];\nconst featured = (outs.find(o => o.format === 'blog_featured') || outs[0] || {}).fileUrl || '';\nconst a = $('Parse Article JSON').item.json;\nconst content = (featured ? `<figure><img src=\"${featured}\" alt=\"${a.title}\"/></figure>\\n` : '') + (a.body_html || '');\nreturn [{ json: { title: a.title, content, featured } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "7a00b066-3170-4eff-bef3-852885758df8",
      "name": "Create WordPress Draft",
      "type": "n8n-nodes-base.wordpress",
