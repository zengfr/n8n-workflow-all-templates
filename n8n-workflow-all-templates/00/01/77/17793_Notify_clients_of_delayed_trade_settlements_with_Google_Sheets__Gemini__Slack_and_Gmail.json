        "jsCode": "let stocks = $input.first().json.items.map((item) => {\n  return {\n      trade_id: item.trade_id,\n      stock_name: item.stock_name,\n      settlement_date: item.settlement_date,\n      quantity: item.quantity,\n      price: item.price,\n      status: item.status,\n      slack_member_id: item.slack_member_id\n  }\n})\n\nreturn {\n  json:{\n    ai_input: {\n       client_email: $input.first().json.email,\n       stocks\n    }\n  }\n}"
