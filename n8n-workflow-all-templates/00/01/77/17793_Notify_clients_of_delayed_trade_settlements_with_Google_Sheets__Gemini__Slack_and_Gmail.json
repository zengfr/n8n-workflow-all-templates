    {
      "id": "ed1fc934-b1fd-4516-b3d6-a8f867cf333e",
      "name": "Validate & Format Settlement Dates",
      "type": "n8n-nodes-base.code",
      "position": [
        1376,
        448
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const rawDate = item.json.settlement_date;\n\n \n  if (!rawDate) {\n    item.json.settlement_date = null;\n    item.json.dateError = \"Missing date\";\n    return item;\n  }\n\n  const parsedDate = new Date(rawDate);\n\n  if (isNaN(parsedDate)) {\n    item.json.settlement_date = null;\n    item.json.dateError = \"Invalid format\";\n    return item;\n  }\n\n  item.json.settlement_date = parsedDate.toISOString().split('T')[0];\n  item.json.dateError = null;\n\n  return item;\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "e44038a5-29b7-48e3-a5d9-a20e01113dd6",
      "name": "Detect Delayed Trades",
      "type": "n8n-nodes-base.code",
      "position": [
        1648,
        448
      ],
      "parameters": {
        "jsCode": "const today = new Date();\ntoday.setHours(0,0,0,0);\n\nreturn $input.all().map(item => {\n  if (!item.json.settlement_date) {\n    item.json.isDelayed = false;\n    item.json.skipReason = \"Invalid or missing date\";\n    return item;\n  }\n\n  const settlement = new Date(item.json.settlement_date);\n  settlement.setHours(0,0,0,0)\n  item.json.isDelayed =\n    settlement < today && item.json.status !== \"settled\";\n\n  return item;\n});"
      },
      "typeVersion": 2
    },
