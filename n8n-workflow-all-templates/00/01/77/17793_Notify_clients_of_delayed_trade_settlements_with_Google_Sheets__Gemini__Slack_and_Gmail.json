    {
      "id": "ab15fd72-2ace-4248-b9db-798df4e80ca8",
      "name": "Group Trades by Client Email",
      "type": "n8n-nodes-base.code",
      "position": [
        2128,
        432
      ],
      "parameters": {
        "jsCode": "const grouped = $input.all().reduce((acc, item) => {\n  const email = item.json.client_email;\n  if (!acc[email]) acc[email] = { email, items: [] };\n  acc[email].items.push(item.json);\n  return acc;\n}, {});\nreturn Object.values(grouped).map(g => ({ json: g }));"
      },
      "typeVersion": 2
    },
