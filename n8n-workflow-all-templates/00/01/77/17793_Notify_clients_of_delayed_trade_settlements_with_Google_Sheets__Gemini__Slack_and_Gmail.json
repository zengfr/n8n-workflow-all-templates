    {
      "id": "793efb18-ac25-40d5-9c04-320ad999b976",
      "name": "Build Slack Alert Message",
      "type": "n8n-nodes-base.code",
      "position": [
        3984,
        272
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 1. Logic to build the dynamic Slack blocks\nlet tradeSections = items.map(item => {\n  const trade = item.json.trade_data;\n  \n  // Choose emoji based on severity\n  let severityEmoji = trade.severity === 'HIGH' ? '*HIGH*' : '*MEDIUM*';\n  \n  return `*Stock:* ${trade.stock} (ID: #${trade.trade_id})\\n*Urgency:* ${severityEmoji}\\n*Reason:* ${trade.reason}\\n*Next Step:* _${trade.action}_`;\n}).join('\\n\\n---\\n\\n');\n\n// 2. Compose the final message\nconst slackMessage = `\n*Hello! Quick Update on your Trade Settlements*\n\nOur automated monitoring has flagged ${items.length} trades that require attention. Here are the details:\n\n${tradeSections}\n\n*Note:* Our operations team is currently investigating these issues. You don't need to take any action unless contacted directly.\n`;\n\nreturn {\n  slack_id: items[0].json.client_slack_id,\n  text: slackMessage\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "2f183243-7537-4750-b9b0-9d157a7b5181",
      "name": "Build Email Report",
      "type": "n8n-nodes-base.code",
      "position": [
        4208,
        464
      ],
      "parameters": {
        "jsCode": "// Get the input data from the previous node\nconst items = $input.all();\n\n// Assuming all trades in this execution belong to the same client\nconst clientEmail = items[0].json.client_mail;\n\n// 1. Build the dynamic HTML table rows\nlet tableRows = items.map(item => {\n  const trade = item.json.trade_data;\n  \n  // Set a color for severity to make it look \"beautiful\"\n  let color = trade.severity === 'MEDIUM' ? '#e67e22' : '#27ae60';\n  \n  return `\n    <tr style=\"border-bottom: 1px solid #ddd;\">\n      <td style=\"padding: 12px; text-align: left;\"><b>${trade.stock}</b></td>\n      <td style=\"padding: 12px; text-align: left;\">#${trade.trade_id}</td>\n      <td style=\"padding: 12px; text-align: left; color: ${color}; font-weight: bold;\">${trade.severity}</td>\n      <td style=\"padding: 12px; text-align: left;\">${trade.reason}</td>\n    </tr>`;\n}).join('');\n\n// 2. Create the full HTML Email Template\nconst emailBody = `\n<div style=\"font-family: sans-serif; max-width: 600px; color: #333; line-height: 1.6;\">\n  <h2 style=\"color: #2c3e50;\">Trade Settlement Update</h2>\n  <p>Hello,</p>\n  <p>We are providing a transparent update regarding your recent transactions. Our systems have flagged the following trades for manual review or exchange-level verification:</p>\n  \n  <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n    <thead>\n      <tr style=\"background-color: #f8f9fa; border-bottom: 2px solid #eee;\">\n        <th style=\"padding: 12px; text-align: left;\">Stock</th>\n        <th style=\"padding: 12px; text-align: left;\">Trade ID</th>\n        <th style=\"padding: 12px; text-align: left;\">Severity</th>\n        <th style=\"padding: 12px; text-align: left;\">Status Reason</th>\n      </tr>\n    </thead>\n    <tbody>\n      ${tableRows}\n    </tbody>\n  </table>\n  \n  <p style=\"background: #fdf2e9; padding: 15px; border-left: 5px solid #e67e22;\">\n    <strong>Note:</strong> No action is required from your side. Our operations team is already working to resolve these discrepancies.\n  </p>\n  \n  <p>Best regards,<br><b>Trade Operations Team</b></p>\n</div>\n`;\n\n// 3. Return the data for the next node\nreturn {\n  recipient: clientEmail,\n  subject: `Status Update: Pending Settlements for ${items.length} Trades`,\n  bodyHtml: emailBody\n};"
      },
      "typeVersion": 2
    },
