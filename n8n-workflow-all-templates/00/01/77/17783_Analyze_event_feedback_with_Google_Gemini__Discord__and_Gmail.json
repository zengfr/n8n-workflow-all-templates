      ],
      "parameters": {
        "text": "=Analyze this event feedback and return structured JSON.\nEvent ID: {{ $json.event_id }}\nRating: {{ $json.rating }}\nFeedback: {{ $json.feedback }}",
        "options": {
          "systemMessage": "You analyze event attendee feedback. Copy event_id and rating verbatim from the input. Determine sentiment (positive, neutral, or negative), a short category (e.g. Venue, Content, Logistics, Catering, Staff), a priority of exactly \"High\", \"Medium\", or \"Low\", and a one-sentence summary. Set priority High for serious complaints or safety issues, Medium for actionable suggestions, Low for general praise. Respond only with the structured JSON."
        },
