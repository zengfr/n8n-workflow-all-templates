    {
      "id": "c1886efc-ad07-4963-ba3e-9371617bc077",
      "name": "Fetch Latest News",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1712,
        128
      ],
      "parameters": {
        "url": "=https://newsapi.org/v2/everything?apiKey={{ $('Initialize Parameters').first().json.apiKey }}&q={{ $json.companyName }}&from={{ DateTime.now().minus({ days: $('Initialize Parameters').first().json.newsAge }).toFormat('yyyy-MM-dd') }}&sortBy=publishedAt&language=en&pageSize={{ $('Initialize Parameters').first().json.maxArticles }}&searchIn=title",
        "options": {}
      },
      "typeVersion": 4.1
    },
    {
      "id": "78f81e6e-db34-4d9c-98af-b79a9c75ba6a",
      "name": "Format News for Email",
      "type": "n8n-nodes-base.code",
      "position": [
        1920,
        128
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let html = `<table style=\"width: 100%\">`;\nhtml += '</table>';\n\nfor(article of $input.item.json.articles) {\n  console.log(article)\n  html += `\n    <tr>\n      <td style=\"display: flex; background-color: #f2f4f8; font-family: sans-serif; padding: 0.3em 0.5em\">\n        <div style=\"padding: 1em\">\n          <a style=\"display: block; margin-bottom: 10px; font-size: 1.2em\" href=\"${article.url}\">${article.title}</a>\n          <i>\n            ${article.description ? article.description : article.content}\n          </i>\n          <div style=\"margin-top: 1em\">\n            ${ article.source?.name ? '<b>Source:</b> ' + article.source?.name : '' }\n          </div>\n        </div>\n      </td>\n    </tr>\n  `\n}\nreturn { \"html\": html };"
      },
      "typeVersion": 2
    },
    {
      "id": "9a40c6b4-4cfd-4c64-986a-71d4905ae39c",
      "name": "Email News via Gmail",
      "type": "n8n-nodes-base.gmail",
      "position": [
        2112,
        128
      ],
      "webhookId": "ec59b1c2-1f1a-43eb-aa1b-acea0b7a03e9",
      "parameters": {
        "sendTo": "={{ $('Initialize Parameters').first().json.emails }}",
        "message": "={{ $json.html }}",
        "options": {},
        "subject": "=Latest news for '{{ $('Extract Company Name').item.json.summary }}'"
      },
      "typeVersion": 2.1
    },
