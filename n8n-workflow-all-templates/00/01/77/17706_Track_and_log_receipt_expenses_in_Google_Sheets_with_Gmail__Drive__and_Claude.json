    {
      "id": "b7b9effe-b501-4a94-bdd5-6cfcb6573e35",
      "name": "Email Receipt In",
      "type": "n8n-nodes-base.gmailTrigger",
      "position": [
        0,
        160
      ],
      "parameters": {
        "simple": false,
        "filters": {
          "q": "label:receipts",
          "readStatus": "both"
        },
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "typeVersion": 1.4
