    {
      "id": "a1000000-0000-4000-8000-000000000014",
      "name": "Already up to date",
      "type": "n8n-nodes-base.noOp",
      "notes": "Nothing to do. This is the branch taken almost every run, and it costs one small registry call.",
      "position": [
