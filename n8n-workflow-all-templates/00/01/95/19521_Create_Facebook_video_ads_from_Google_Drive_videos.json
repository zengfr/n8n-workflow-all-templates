    {
      "id": "2e6e1f38-6d8c-4b67-9047-b1a847442761",
      "name": "Combine Trigger Inputs",
      "type": "n8n-nodes-base.code",
      "position": [
        6512,
        4032
      ],
      "parameters": {
        "jsCode": "// Both triggers feed here. We don't care what they sent —\n// the next node (List Drive Videos) reads the folder independently.\n// Just emit one marker item so the workflow has something to do.\nreturn [{ json: { triggered: true, at: new Date().toISOString() } }];"
      },
      "typeVersion": 2
    },
