      "waitBetweenTries": 2000
    },
    {
      "id": "8cdbe0ea-f4e9-4e7f-add7-af171e8c0609",
      "name": "Combine Shipment & Schedule Context",
      "type": "n8n-nodes-base.code",
      "position": [
        3264,
        352
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const s=$('Diff State & Compute Risk Tier').item.json;const t=$json.confirmedLoadTime||s.vesselLoadTime;if(typeof t!=='string'||!/(Z|[+-]\\d{2}:\\d{2})$/.test(t)||!Number.isFinite(Date.parse(t)))throw Error('Invalid confirmed vessel time');return {json:{...s,confirmedVesselLoadTime:t,confirmedHoursUntilLoad:Math.round((Date.parse(t)-Date.now())/360000)/10}};"
      },
      "retryOnFail": false,
      "typeVersion": 2
    },
    {
