            }
          ]
        }
      },
      "retryOnFail": false,
      "typeVersion": 1.2
    },
    {
      "id": "260e6b60-02d1-4055-a7c1-89d5f5b8994b",
      "name": "Fetch Open Ocean Shipments",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        1024,
        352
      ],
      "parameters": {
        "url": "https://forwarder.internal.example.com/api/shipments/open",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
    },
    {
      "id": "31f25a06-73b0-4047-a732-26939ec54279",
      "name": "Split Shipments by Bill of Lading",
      "type": "n8n-nodes-base.code",
      "position": [
        736,
        576
      ],
      "parameters": {
        "jsCode": "const feed=$('Fetch Open Ocean Shipments').first().json;const rows=$input.all().map(i=>i.json);if(!Array.isArray(feed.shipments))throw Error('Shipment API must return a shipments array');const seen=new Set();return feed.shipments.map(s=>{if(!s.billOfLading||!s.importerName||typeof s.filedStatus!=='boolean'||typeof s.vesselLoadTime!=='string'||!/(Z|[+-]\\d{2}:\\d{2})$/.test(s.vesselLoadTime)||!Number.isFinite(Date.parse(s.vesselLoadTime)))throw Error('Shipment requires BOL, importer, boolean filedStatus and an ISO load time with timezone');if(seen.has(s.billOfLading))throw Error('Duplicate bill of lading');seen.add(s.billOfLading);const prior=rows.filter(r=>r.billOfLading===s.billOfLading);if(prior.length>1)throw Error('Duplicate filing-state rows');return {json:{...s,priorState:prior[0]||null},pairedItem:{item:0}};});"
      },
      "retryOnFail": false,
      "typeVersion": 2
    },
    {
      "id": "d87370cc-f826-49f9-a231-12ce570abd8d",
      "name": "Read Prior Filing State",
      "type": "n8n-nodes-base.dataTable",
      "position": [
        1312,
        352
      ],
      "parameters": {
        "filters": {
          "conditions": []
        },
        "operation": "get",
        "returnAll": true,
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_DATA_TABLE_ID"
        }
      },
      "retryOnFail": false,
      "typeVersion": 1,
      "alwaysOutputData": true
    },
    {
      "id": "60943e5e-a191-428a-9201-edb1aac6f232",
      "name": "Diff State & Compute Risk Tier",
      "type": "n8n-nodes-base.code",
      "position": [
        1856,
        352
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item,index)=>{const s=item.json;const hours=(Date.parse(s.vesselLoadTime)-Date.now())/3600000;if(!Number.isFinite(hours)||typeof s.filedStatus!=='boolean')throw Error('Invalid shipment state');const riskTier=s.filedStatus?'green':hours>48?'green':hours>24?'yellow':'red';const priorTier=s.priorState?.riskTier??null;return {json:{billOfLading:s.billOfLading,importerName:s.importerName,vesselLoadTime:s.vesselLoadTime,hoursUntilLoad:Math.round(hours*10)/10,isfFiled:s.filedStatus,riskTier,priorTier,tierChanged:priorTier!==riskTier},pairedItem:{item:index}};});"
      },
      "retryOnFail": false,
      "typeVersion": 2
    },
    {
      "id": "5fd9464a-4e70-4d33-8b94-1fd81ad41a36",
      "name": "Has Risk Tier Changed Since Last Check",
      "type": "n8n-nodes-base.if",
      "position": [
        2144,
        352
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "9c9617c9-2883-4772-8bac-1abd4a0c1eb7",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{$json.tierChanged}}",
              "rightValue": true
            }
          ]
        }
      },
      "retryOnFail": false,
      "typeVersion": 2.2
    },
    {
      "id": "b442614b-63a0-4e0d-bab7-e53e512b8c11",
