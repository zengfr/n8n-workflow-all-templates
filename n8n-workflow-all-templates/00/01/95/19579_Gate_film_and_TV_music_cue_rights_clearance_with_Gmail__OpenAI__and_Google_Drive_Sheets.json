    {
      "id": "9d6bb44c-4ee4-465a-ac85-cf23fb1ac398",
      "name": "Normalize Production and Cue Text",
      "type": "n8n-nodes-base.code",
      "position": [
        1024,
        352
      ],
      "parameters": {
        "jsCode": "const input=$input.all();if(input.length!==1)throw Error('This approval template accepts one email per execution. Separate a multi-email batch before retrying.');const j=input[0].json;const text=j.textPlain||j.snippet;if(typeof text!=='string'||text.trim().length<20)throw Error('Cue details must be in the email body; attachments are not parsed');return [{json:{cueText:text,messageId:j.id||null}}];"
      },
      "retryOnFail": false,
      "typeVersion": 2
