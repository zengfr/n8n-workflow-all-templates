    {
      "id": "14b788d4-ba18-422f-97b7-bb0ff2476146",
      "name": "Validate Extracted Cues",
      "type": "n8n-nodes-base.code",
      "position": [
        1024,
        576
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j=$json.output||$json;if(typeof j.production!=='string'||!j.production.trim()||!Array.isArray(j.cues)||j.cues.length===0)throw Error('Missing production or cues');const seen=new Set();for(const c of j.cues){if(!c.cueId||!c.title||seen.has(c.cueId))throw Error('Each cue requires a unique cueId and title');seen.add(c.cueId);}return {json:j};"
      },
      "typeVersion": 2
    },
    {
      "id": "ed1d474e-13e6-47d7-98dd-58c37d33641d",
      "name": "Build Supervisor Review Packet",
      "type": "n8n-nodes-base.code",
