    {
      "id": "5e453572-1f03-4732-aaf0-b74c408cb1fd",
      "name": "Validate Supervisor Response",
      "type": "n8n-nodes-base.code",
      "position": [
        4384,
        352
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const packet=$('Build Supervisor Review Packet').first().json;const response=$json.body;if(!response||response.packetId!==packet.packetId||typeof response.approved!=='boolean'||typeof response.reviewer!=='string'||!response.reviewer.trim())throw Error('Approval callback must contain matching packetId, boolean approved and reviewer');return {json:{...packet,requestedApproval:response.approved,approved:response.approved&&packet.gaps.length===0,reviewer:response.reviewer,reviewedAt:new Date().toISOString()}};"
      },
      "typeVersion": 2
    },
