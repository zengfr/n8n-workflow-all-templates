    {
      "id": "99b770df-46db-45b3-9e7f-667ff5cec0b8",
      "name": "Calculate Clearance Gaps",
      "type": "n8n-nodes-base.code",
      "position": [
        1856,
        576
      ],
      "parameters": {
        "jsCode": "const source=$('Validate Extracted Cues').first().json;const pro=$('Fetch PRO Work Registrations').first().json;const master=$('Fetch Master Ownership Claims').first().json;if(!Array.isArray(pro.cues)||!Array.isArray(master.cues))throw Error('Both rights APIs must return a cues array');const find=(rows,id)=>{const hits=rows.filter(c=>c.cueId===id);if(hits.length>1)throw Error('Duplicate rights evidence for '+id);return hits[0]||{};};const gaps=[];const cues=source.cues.map(c=>{const p=find(pro.cues,c.cueId),m=find(master.cues,c.cueId);if(typeof p.writerShareTotal!=='number'||p.writerShareTotal!==100)gaps.push(c.cueId+':WRITER_SHARES');if(typeof m.masterOwner!=='string'||!m.masterOwner.trim())gaps.push(c.cueId+':MASTER_OWNER');if(typeof p.syncQuote!=='string'||!p.syncQuote.trim())gaps.push(c.cueId+':SYNC_QUOTE');return {...c,writerShareTotal:p.writerShareTotal??null,masterOwner:m.masterOwner||null,syncQuote:p.syncQuote||null};});return [{json:{production:source.production,cues,gaps,risk:gaps.length>2?'HIGH':gaps.length?'REVIEW':'CLEAR',packetId:'MC-'+$execution.id}}];"
      },
      "retryOnFail": false,
      "typeVersion": 2
    },
