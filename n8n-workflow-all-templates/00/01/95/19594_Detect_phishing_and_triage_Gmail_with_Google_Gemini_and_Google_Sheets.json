    {
      "id": "gmail_get_labels",
      "name": "Get all Gmail labels",
      "type": "n8n-nodes-base.gmail",
      "position": [
        448,
        144
      ],
      "parameters": {
        "resource": "label",
        "returnAll": true
      },
      "executeOnce": false,
      "typeVersion": 2.1
    },
    {
      "id": "code_map",
      "name": "Match categories to label IDs",
      "type": "n8n-nodes-base.code",
      "position": [
        672,
        144
      ],
      "parameters": {
        "jsCode": "const inputItems = $input.all();\nconst emails = $('Watch inbox for new email').all().map(i => i.json);\n\nconst perEmailCount = emails.length > 0 ? inputItems.length / emails.length : inputItems.length;\n\nfunction findId(labels, name) {\n  const match = labels.find(l => l.name === name);\n  return match ? match.id : null;\n}\n\nreturn emails.map((trigger, i) => {\n  const labels = inputItems.slice(i * perEmailCount, (i + 1) * perEmailCount).map(it => it.json);\n  return {\n    json: {\n      messageId: trigger.id,\n      subject: trigger.Subject || '(no subject)',\n      from: trigger.From || '',\n      bodyText: trigger.snippet || '',\n      fraudLabelId: findId(labels, '⚠️ Possible Fraud'),\n      urgentLabelId: findId(labels, '🔴 Urgent'),\n      adsLabelId: findId(labels, '📢 Ads'),\n      reviewLabelId: findId(labels, '🔎 Review'),\n      notImportantLabelId: findId(labels, '⚪ Not Important')\n    }\n  };\n});"
      },
      "typeVersion": 2
    },
    {
      "id": "ai_agent",
      "name": "Classify email with AI agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1152,
        272
      ],
      "parameters": {
        "text": "=Subject: {{ $json.subject }}\nFrom: {{ $json.from }}\n\nBody:\n{{ $json.bodyText }}",
        "options": {
          "systemMessage": "You are an email security and triage assistant. You will be given the subject, sender, and body of one incoming email. Classify it into EXACTLY ONE of these five categories, then call the matching tool to apply that label. Call only one tool, and only one of the five listed below — never reply, forward, delete, or take any other action.\n\n- ⚠️ Possible Fraud: phishing, scams, spoofed senders, requests for passwords, payment, gift cards or wire transfers, fake urgency about account suspension, suspicious or mismatched links. Call the tool \"Add 'Possible Fraud' label\".\n- 🔴 Urgent: a legitimate email that needs action soon — a real deadline, a coworker or client waiting on a reply, a bill or invoice due. Call the tool \"Add 'Urgent' label\".\n- 📢 Ads: promotions, marketing newsletters, sales offers. Call the tool \"Add 'Ads' label\".\n- 🔎 Review: anything you are not confident about, or that doesn't clearly fit the other categories. Call the tool \"Add 'Review' label\".\n- ⚪ Not Important: FYI-only messages, automated receipts or notifications, nothing to act on. Call the tool \"Add 'Not Important' label\".\n\nBe careful with fraud: only choose Possible Fraud when there are real warning signs, not just because an email is urgent or from an unfamiliar sender. When genuinely unsure, prefer Review over guessing.\n\nAfter calling exactly one tool, reply with a single line containing only the category name you chose (e.g. \"Possible Fraud\")."
        },
        "promptType": "define"
      },
      "typeVersion": 3.1
    },
    {
      "id": "lm_gemini",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
