    {
      "id": "6ba75bc0-45a9-5bea-87ac-c753a4d5686d",
      "name": "Pick Two Different Approvers",
      "type": "n8n-nodes-base.code",
      "position": [
        2736,
        320
      ],
      "parameters": {
        "jsCode": "\n// Choose the two approvers for ONE request. The loop node upstream hands over exactly one\n// request per iteration, which is why .first() is correct here: a Gmail send-and-wait parks\n// the whole execution, so two requests cannot be in flight at once.\n// Choose the two approvers. This node is the point of the template, so the rules are explicit:\n//   1. an address that is blank is not an approver\n//   2. an approver marked inactive is not an approver\n//   3. the requester is never an approver of their own request (when the policy says so)\n//   4. the SAME address listed twice is ONE person, not two approvals\n// Fewer than two survivors means the request is refused. It is never approved by default.\nconst policy = $('Approval Rules').first().json;\nconst req = $('Handle One Request At A Time').first().json;\n\nconst norm = (v) => (v === undefined || v === null) ? '' : String(v).trim().toLowerCase();\nconst requester = norm(req.requester_email);\nconst blockSelf = policy.block_self_approval === true || norm(policy.block_self_approval) === 'true';\n\nconst seen = new Set();\nconst pool = [];\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const f = (j.fields && typeof j.fields === 'object') ? j.fields : j;\n\n  const email = norm(f['Email']);\n  if (!email) continue;\n\n  const activeRaw = f['Active'];\n  const active = (activeRaw === undefined || activeRaw === null || activeRaw === '')\n    ? true\n    : (activeRaw === true || activeRaw === 1 || ['true', 'yes', 'checked', '1'].includes(norm(activeRaw)));\n  if (!active) continue;\n\n  if (blockSelf && email === requester) continue;\n  if (seen.has(email)) continue;\n  seen.add(email);\n  pool.push(email);\n}\n\nconst chosen = pool.slice(0, 2);\nconst enough = chosen.length === 2;\n\nreturn [{ json: Object.assign({}, req, {\n  approver_one:   chosen[0] || null,\n  approver_two:   chosen[1] || null,\n  eligible_count: pool.length,\n  refusal_reason: enough ? null : 'no_eligible_approvers',\n}) }];\n"
      },
      "typeVersion": 2
    },
