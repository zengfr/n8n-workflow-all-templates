    {
      "id": "cee370d1-80da-56e1-aa69-a0de63af188d",
      "name": "Read The Change Request",
      "type": "n8n-nodes-base.code",
      "position": [
        976,
        320
      ],
      "parameters": {
        "jsCode": "\n// Flatten one Airtable record into plain keys.\n// The Airtable trigger and the Airtable node do not agree on whether fields are nested under\n// `fields` or spread at the top level, so accept both rather than guess.\nconst policy = $('Approval Rules').first().json;\nconst out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const f = (j.fields && typeof j.fields === 'object') ? j.fields : j;\n\n  const text = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n  const status = text(f['Status']) || policy.pending_status;\n\n  out.push({ json: {\n    record_id:       text(j.id) || text(f['id']) || null,\n    request_id:      text(f['Request ID']) || null,\n    title:           text(f['Title']) || '(untitled request)',\n    detail:          text(f['Detail']) || '',\n    requester_email: text(f['Requester Email']).toLowerCase() || null,\n    status:          status,\n    // every key on every branch, null where there is nothing to say yet\n    approver_one:    null,\n    approver_two:    null,\n    eligible_count:  null,\n    refusal_reason:  null,\n  } });\n}\nreturn out;\n"
      },
      "typeVersion": 2
    },
    {
