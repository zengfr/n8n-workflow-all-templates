      "id": "29f98b17-9be2-56fc-8461-f57b1fcff083",
      "name": "Read The Approver Pool",
      "type": "n8n-nodes-base.airtable",
      "position": [
        2496,
        320
      ],
      "parameters": {
        "base": {
          "__rl": true,
          "mode": "list",
