      "name": "Filter Tomorrows Appointments",
      "type": "n8n-nodes-base.filter",
      "notes": "La tercera condicion evita reenviar el recordatorio si la cita ya tiene RecordatorioEnviado registrado (protege contra duplicados si el trigger corre mas de una vez).",
      "position": [
        -624,
        -16
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "2f9dfa1b-03d0-4c6e-8e5e-f7088c4b500a",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.Fecha }}",
              "rightValue": "={{ $today.plus({days:1}).toFormat('yyyy-MM-dd') }}"
            },
            {
              "id": "b8a52c14-ea5a-46c9-9130-f1be37b4f69b",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": "={{ $json.Estado }}",
              "rightValue": "Cancelada"
            },
            {
              "id": "d4e8f2a1-3c5b-47a6-9e1d-8b2f6a9c4e70",
              "operator": {
                "type": "string",
                "operation": "empty"
              },
              "leftValue": "={{ $json.RecordatorioEnviado }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2.2
    },
