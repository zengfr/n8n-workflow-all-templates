      "name": "Route by Response Type",
      "type": "n8n-nodes-base.switch",
      "notes": "Salida 0 = Confirmar, salida 1 = Cancelar, salida extra ('No reconocido') cuando el texto no coincide.",
      "position": [
        -624,
        400
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Confirmar",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "or",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    },
                    "leftValue": "={{ $json.respuesta }}",
                    "rightValue": "SI|SÍ|CONFIRMO"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Cancelar",
              "conditions": {
                "options": {
                  "version": 1,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "or",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "regex"
                    },
                    "leftValue": "={{ $json.respuesta }}",
                    "rightValue": "NO|CANCELAR"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "typeVersion": 3.2
    },
