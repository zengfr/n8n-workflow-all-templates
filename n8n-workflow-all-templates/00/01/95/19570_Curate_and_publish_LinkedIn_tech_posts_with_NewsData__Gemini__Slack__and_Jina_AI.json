    {
      "id": "54f74745-08e0-43c5-b083-5a7445c5fdb6",
      "name": "Generating Post Content",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        13248,
        4672
      ],
      "parameters": {
        "text": "=You are an expert storyteller and LinkedIn content strategist. Your task is to turn the following summary into a compelling, easy-to-read story for a broad audience.\n\nSummary to Use:\n{{ $json.data }}\n\nPost Requirements:\n\nStart with a strong hook based on the formula: Hook Score = (Curiosity x Relevance x Specificity) - Friction.\nCuriosity: Make them need to know what happens next.\nRelevance: Map it exactly to their situation.\nSpecificity: Use real numbers, names, and outcomes over vague claims.\nFriction: Strip out abstract or cliché openers (e.g., standard \"5 lessons I learned\" templates).\nWrite so a 15-year-old can understand (easy words, short sentences).\nAvoid sounding like generic AI. The post must sound like an actual person with actual receipts—sharp, human-edited, and authentic.\nFocus on a specific pain point and transition smoothly into the value or solution.\nKeep a casual and warm tone.\nMake it 250-350 words long.\nEnd with a soft, value-driven, open-ended question that creates zero burden or commitment for the reader to answer.\nDo not use asterisks (*) or hashtags.\n\n\nOUTPUT RULE - IMPORTANT - DON'T MISS:\n\nYour response must ONLY be the raw text of the LinkedIn post. Do not add any titles, labels, or explanations. Just the post itself.",
        "options": {},
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.7
    },
