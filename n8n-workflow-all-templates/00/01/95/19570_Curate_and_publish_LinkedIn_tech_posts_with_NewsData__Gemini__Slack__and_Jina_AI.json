    {
      "id": "bca1ebc2-16a6-415b-a9a1-8a9d668529cf",
      "name": "HTTP Request1",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        14176,
        4672
      ],
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite-image:generateContent",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        { \"text\": \"{{ $json.output }}\" }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseModalities\": [\"IMAGE\"],\n    \"imageConfig\": {\n      \"aspectRatio\": \"16:9\",\n      \"imageSize\": \"1K\"\n    }\n  }\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi"
      },
      "retryOnFail": false,
      "typeVersion": 4.2,
      "waitBetweenTries": 5000
    },
    {
      "id": "8788fe59-663f-4fd8-a5da-a82243e147da",
      "name": "Image Generation",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        13824,
        4672
      ],
      "parameters": {
        "text": "=Read following Social Media post which I have generated. And write a prompt to generate image which looks good, does not have much Character/Words. \n\n# INSTRUCTIONS:\n1- Don't include any special characters in prompt.\n2- Don't include any comma or inverted comma\n3- Only a return text based prompt for image generation\n\n# SOCIAL MEDIA POST:\n{{ $json.output }}",
        "options": {},
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
    {
      "id": "c990c41e-47df-4760-88fa-2d5ee6e8bfc1",
      "name": "Choose Best Artcile",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        12448,
        4672
      ],
      "parameters": {
        "text": "=You are an expert **tech** social media strategist and content curator. Your mission is to analyze the following articles and select the SINGLE best **tech-related** article with the highest potential for social media engagement.\n\n**Input Articles:**\n\nArticle #1:\nTitle: {{ $json.results[0].title }}\nDescription: {{ $json.results[0].description }}\nURL: {{ $json.results[0].link }}\n\nArticle #2:\nTitle: {{ $json.results[1].title }}\nDescription: {{ $json.results[1].description }}\nURL: {{ $json.results[1].link }}\n\nArticle #3:\nTitle: {{ $json.results[2].title }}\nDescription: {{ $json.results[2].description }}\nURL: {{ $json.results[2].link }}\n\n**Your Selection Process:**\n\n**Step 1: The Tech Filter (Primary Requirement)**\nFirst, determine which of the articles are primarily about technology. This includes topics like software development, AI, cybersecurity, hardware, SaaS, gadgets, data science, or the tech industry itself. An article is only eligible if it passes this filter.\n\n**Step 2: Social Potential Analysis (Secondary Requirement)**\nFrom the pool of **eligible tech articles**, evaluate them against these criteria to find the single best one:\n    *   **Curiosity Gap:** Does the title make people curious to know more?\n    *   **Value Proposition:** Does it promise a clear solution, benefit, or valuable insight for a tech audience?\n    *   **Emotional Hook:** Does it tap into a strong emotion relevant to professionals (e.g., inspiration, frustration with a common problem, excitement about innovation)?\n\n**Step 3: Make the Final Selection**\nChoose the one article that best meets the criteria from Step 1 and Step 2.\n\n**Fallback Rule:** If NONE of the articles are clearly about technology, then and only then should you disregard the tech filter and select the single article with the highest overall social potential from the original list.\n\n**Final Output Instructions (CRITICAL):**\n*   Your response must ONLY contain information for the single article you chose.\n*   Write a BRAND NEW summary. This summary must be under 100 words and rewritten to be compelling for social media, highlighting why someone should click. Do NOT just copy the original description.\n*   Do not include any explanation of your choice or mention the other articles.",
        "options": {
          "returnIntermediateSteps": false
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.7
    },
