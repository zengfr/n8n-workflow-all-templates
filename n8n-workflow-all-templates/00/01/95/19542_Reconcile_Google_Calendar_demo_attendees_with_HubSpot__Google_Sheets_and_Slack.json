    {
      "id": "67493326-cbd7-5d87-9306-656f40d60843",
      "name": "Prepare attendee checks",
      "type": "n8n-nodes-base.code",
      "position": [
        1620,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$('Validate setup').first().json;const now=Date.parse(c.checkedAt);const rows=[];const seen=new Set();\nfor(const {json:e} of $input.all()) {\n if(!e.id) {if(Object.keys(e).length===0) continue;throw new Error('Calendar response has no event ID');}\n if(e.status==='cancelled' || !e.start?.dateTime || Date.parse(e.start.dateTime)<now || Date.parse(e.start.dateTime)>now+c.lookAheadHours*3600000) continue;\n if(e.attendeesOmitted) throw new Error('Calendar attendee list is truncated. Remove maxAttendees restrictions before retrying.');\n if(!e.created || !Number.isFinite(Date.parse(e.created))) throw new Error('Calendar event has no valid creation timestamp');\n if(now-Date.parse(e.created)<c.bookingGraceMinutes*60000) continue;\n for(const a of e.attendees || []) {\n  const email=String(a.email||'').trim().toLowerCase();const domain=email.split('@')[1];\n  if(!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) || a.self || a.resource || a.responseStatus==='declined' || c.domains.some(d=>domain===d || domain.endsWith('.'+d))) continue;\n  const key=e.id+'|'+email;if(seen.has(key))continue;seen.add(key);\n  rows.push({json:{review_key:key,event_id:e.id,event_title:String(e.summary||'Untitled demo').slice(0,180),starts_at:e.start.dateTime,attendee_email:email,rsvp:a.responseStatus||'needsAction',calendar_url:/^https:\\/\\/calendar\\.google\\.com\\//.test(e.htmlLink||'')?e.htmlLink:'',checked_at:c.checkedAt}});\n }\n}\nif(rows.length>c.maxAttendees) throw new Error(`Found ${rows.length} attendee checks; maximum is ${c.maxAttendees}. Narrow the calendar/window.`);\nreturn rows;\n"
      },
      "typeVersion": 2
    },
    {
      "id": "b4a60dc6-1970-58a6-a363-d0f138ca7df4",
      "name": "Find exact primary-email contact",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        1900,
        320
