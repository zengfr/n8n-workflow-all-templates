    {
      "id": "c789d2f0-8e93-568d-88a0-f3f9fae0bccf",
      "name": "Classify CRM coverage",
      "type": "n8n-nodes-base.code",
      "position": [
        2160,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row=$('Prepare attendee checks').item.json;const r=$json;const owners=$('Index active owners').first().json.owners;\nif(!Array.isArray(r.results) || !Number.isInteger(r.total) || r.total<0) throw new Error('HubSpot contact search returned an invalid response');\nlet status,action,contactId='',ownerName='',lifecycle='';\nif(r.total===0){status='NO_PRIMARY_EMAIL_MATCH';action='Check alternate email and booking details before creating or merging any contact.';}\nelse if(r.total>1){status='AMBIGUOUS_CONTACT';action='Resolve duplicate primary-email matches in HubSpot before assigning a handoff.';}\nelse {\n const contact=r.results[0];if(!contact?.id || String(contact.properties?.email||'').toLowerCase()!==row.attendee_email) throw new Error('HubSpot exact-match response is inconsistent; no readiness report was sent');\n contactId=String(contact.id);lifecycle=contact.properties.lifecyclestage||'';const ownerId=String(contact.properties.hubspot_owner_id||'');\n if(!ownerId){status='UNASSIGNED_CONTACT';action='Assign an accountable contact owner before the demo.';}\n else if(!owners[ownerId]){status='OWNER_NOT_ACTIVE';action='Review the owner assignment; this ID is absent from the active owner directory.';}\n else {status='READY';ownerName=owners[ownerId].name;action='Primary email matches one contact with an active owner.';}\n}\nreturn {json:{...row,contact_id:contactId,owner_name:ownerName,lifecycle_stage:lifecycle,status,recommended_action:action}};\n"
      },
      "typeVersion": 2
    },
