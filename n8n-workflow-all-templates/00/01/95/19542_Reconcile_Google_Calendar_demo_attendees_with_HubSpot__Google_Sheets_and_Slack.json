    {
      "id": "42ceb50f-d3ef-58f8-bda0-12dbbb78199b",
      "name": "Build exception digest",
      "type": "n8n-nodes-base.code",
      "position": [
        2720,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows=$('Classify CRM coverage').all().map(x=>x.json);const c=$('Validate setup').first().json;\nconst issues=rows.filter(r=>r.status!=='READY');if(!issues.length)return [];\nconst esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/[\\r\\n]/g,' ').slice(0,180);\nconst counts={};for(const r of issues)counts[r.status]=(counts[r.status]||0)+1;\nconst lines=issues.slice(0,12).map(r=>`• ${esc(r.event_title)} — ${esc(r.starts_at)} — ${r.status}${r.calendar_url?' <'+r.calendar_url+'|Calendar>':''}`);\nreturn [{json:{text:`*Demo readiness review*\\n${rows.length} attendee checks; ${issues.length} require review. ${Object.entries(counts).map(([k,v])=>k+': '+v).join(' · ')}\\n${lines.join('\\n')}\\n${issues.length>12?'Showing 12; all findings are in the queue.\\n':''}<https://docs.google.com/spreadsheets/d/${encodeURIComponent(c.spreadsheetId)}/edit|Open review queue>\\nSnapshot: ${c.checkedAt}. Filter checked_at to this run. No primary-email match can mean an alias; verify before creating records.`}}];\n"
      },
      "typeVersion": 2
    },
