    {
      "id": "b880739b-7f20-51a3-913e-bb6e80c3f1a7",
      "name": "Validate setup",
      "type": "n8n-nodes-base.code",
      "position": [
        520,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const c = $json;\nfor (const k of ['calendarId','internalDomains','spreadsheetId','sheetName','slackChannelId']) if (!String(c[k] || '').trim()) throw new Error(`Set config values: ${k} is required`);\nif (c.internalDomains === 'example.com') throw new Error('Set internalDomains to your own comma-separated domains');\nfor (const [k,min,max] of [['lookAheadHours',1,168],['bookingGraceMinutes',0,120],['maxAttendees',1,500]]) if (!Number.isInteger(Number(c[k])) || Number(c[k])<min || Number(c[k])>max) throw new Error(`Invalid ${k}: allowed ${min}-${max}`);\nconst domains=c.internalDomains.toLowerCase().split(',').map(x=>x.trim()).filter(Boolean);\nif(domains.some(d=>!/^([a-z0-9-]+\\.)+[a-z]{2,}$/.test(d))) throw new Error('Use bare domains in internalDomains');\nreturn {json:{...c,domains,checkedAt:new Date().toISOString()}};\n"
      },
      "typeVersion": 2
    },
    {
      "id": "4007b314-f9cd-5f91-8d3c-903da9dbaad1",
      "name": "Read active HubSpot owners",
      "type": "n8n-nodes-base.httpRequest",
      "maxTries": 3,
      "position": [
        800,
        320
      ],
      "parameters": {
        "url": "https://api.hubapi.com/crm/v3/owners/",
        "method": "GET",
        "options": {
          "timeout": 30000,
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "name": "after",
                    "type": "qs",
                    "value": "={{ $response.body?.paging?.next?.after ?? undefined }}"
                  }
                ]
              },
              "maxRequests": 20,
              "paginationMode": "updateAParameterInEachRequest",
              "requestInterval": 300,
              "limitPagesFetched": true,
              "completeExpression": "={{ !($response.body?.paging?.next?.after) }}",
              "paginationCompleteWhen": "other"
            }
          }
        },
        "sendQuery": true,
        "authentication": "predefinedCredentialType",
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "100"
            },
            {
              "name": "archived",
              "value": "false"
            }
          ]
        },
        "nodeCredentialType": "hubspotAppToken"
      },
      "retryOnFail": true,
      "typeVersion": 4.4,
      "waitBetweenTries": 2000
    },
    {
      "id": "ffdbc6b3-1d12-5866-9205-d0242dd7f7d8",
      "name": "Index active owners",
      "type": "n8n-nodes-base.code",
      "position": [
        1060,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pages=$input.all().map(x=>x.json);\nif(pages.length===0 || pages.some(p=>!Array.isArray(p.results))) throw new Error('Invalid HubSpot owners response');\nif(pages.at(-1).paging?.next?.after) throw new Error('Owner directory exceeded page limit; report stopped');\nconst owners={};for(const p of pages) for(const o of p.results) if(!o.archived && o.id) owners[String(o.id)]={name:[o.firstName,o.lastName].filter(Boolean).join(' ') || `Owner ${o.id}`};\nreturn [{json:{owners}}];\n"
      },
      "typeVersion": 2
    },
    {
      "id": "58c5a806-acdb-5a12-8b20-ceb9c4e644f9",
      "name": "Read upcoming demos",
      "type": "n8n-nodes-base.googleCalendar",
      "maxTries": 3,
      "position": [
        1360,
        320
      ],
      "parameters": {
        "options": {
          "recurringEventHandling": "expand"
        },
        "timeMax": "={{ DateTime.fromISO($('Validate setup').first().json.checkedAt).plus({hours: $('Set config values').first().json.lookAheadHours}).toISO() }}",
        "timeMin": "={{ $('Validate setup').first().json.checkedAt }}",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Set config values').first().json.calendarId }}"
        },
        "resource": "event",
        "operation": "getAll",
        "returnAll": true
      },
      "retryOnFail": true,
      "typeVersion": 1.3,
      "alwaysOutputData": true,
      "waitBetweenTries": 2000
