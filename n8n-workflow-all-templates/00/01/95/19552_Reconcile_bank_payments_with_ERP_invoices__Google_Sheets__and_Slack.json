    {
      "id": "12f089bb-5251-49d5-a71f-764bde4a0b9e",
      "name": "Reconciliation Matching Engine",
      "type": "n8n-nodes-base.code",
      "position": [
        1136,
        -400
      ],
      "parameters": {
        "jsCode": "// Deterministic reconciliation logic. No AI involved - this is the\n// actual matching boundary and must stay auditable and reproducible.\nconst cfg = $('Set Configuration Parameters').first().json;\nconst paymentsResp = $('Fetch Payment Transactions').first().json;\nconst invoicesResp = $('Fetch Open Invoices').first().json;\n\nconst payments = Array.isArray(paymentsResp) ? paymentsResp : (paymentsResp.transactions || paymentsResp.data || []);\nconst invoices = Array.isArray(invoicesResp) ? invoicesResp : (invoicesResp.invoices || invoicesResp.data || []);\n\nconst amountTolerance = Number(cfg.amountToleranceValue ?? 1);\nconst dateToleranceMs = Number(cfg.dateToleranceDays ?? 3) * 24 * 60 * 60 * 1000;\n\nfunction daysApart(a, b) {\n  const da = new Date(a).getTime();\n  const db = new Date(b).getTime();\n  if (isNaN(da) || isNaN(db)) return Infinity;\n  return Math.abs(da - db);\n}\n\nconst results = [];\n\nfor (const payment of payments) {\n  const paymentRef = String(payment.reference || payment.memo || '').trim().toLowerCase();\n  const paymentAmount = Number(payment.amount);\n  const paymentCurrency = payment.currency || cfg.defaultCurrency;\n  const paymentDate = payment.date || payment.valueDate;\n\n  // 1. Exact reference match\n  let candidates = invoices.filter(inv => {\n    const invRef = String(inv.reference || inv.invoiceNumber || '').trim().toLowerCase();\n    return invRef && invRef === paymentRef;\n  });\n\n  // 2. Fallback: amount + currency + date-window fuzzy match\n  if (candidates.length === 0) {\n    candidates = invoices.filter(inv => {\n      const sameCurrency = (inv.currency || cfg.defaultCurrency) === paymentCurrency;\n      const withinAmount = Math.abs(Number(inv.amountDue) - paymentAmount) <= amountTolerance;\n      const withinDate = daysApart(inv.dueDate, paymentDate) <= dateToleranceMs;\n      return sameCurrency && withinAmount && withinDate;\n    });\n  }\n\n  let status, matchedInvoice = null, variance = null, reason;\n\n  if (candidates.length === 1) {\n    matchedInvoice = candidates[0];\n    variance = Number((paymentAmount - Number(matchedInvoice.amountDue)).toFixed(2));\n    if (Math.abs(variance) <= amountTolerance) {\n      status = 'matched';\n      reason = 'Exact or within-tolerance reference and amount match.';\n    } else {\n      status = 'partial';\n      reason = `Single candidate invoice found but amount differs by ${variance}.`;\n    }\n  } else if (candidates.length > 1) {\n    status = 'partial';\n    reason = `${candidates.length} candidate invoices matched within tolerance - needs a human pick.`;\n  } else {\n    status = 'unmatched';\n    reason = 'No invoice found matching reference, amount, and date window.';\n  }\n\n  results.push({\n    json: {\n      ...cfg,\n      paymentId: payment.id || payment.transactionId,\n      paymentReference: payment.reference || payment.memo || '',\n      paymentAmount,\n      paymentCurrency,\n      paymentDate,\n      status,\n      variance,\n      candidateInvoices: candidates,\n      matchedInvoice,\n      reason\n    }\n  });\n}\n\nreturn results;"
      },
      "typeVersion": 2
    },
