    {
      "id": "952241e0-c649-4ca1-8b65-894ff8555855",
      "name": "Build Run Summary",
      "type": "n8n-nodes-base.code",
      "position": [
        5296,
        -400
      ],
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst counts = { matched: 0, partial: 0, unmatched: 0 };\nlet totalAmount = 0;\nfor (const it of items) {\n  if (counts[it.status] !== undefined) counts[it.status]++;\n  totalAmount += Number(it.paymentAmount) || 0;\n}\nreturn [{\n  json: {\n    ...(items[0] || {}),\n    totalPayments: items.length,\n    matchedCount: counts.matched,\n    partialCount: counts.partial,\n    unmatchedCount: counts.unmatched,\n    totalAmount: Number(totalAmount.toFixed(2)),\n    runCompletedAt: new Date().toISOString()\n  }\n}];"
      },
      "typeVersion": 2
    },
