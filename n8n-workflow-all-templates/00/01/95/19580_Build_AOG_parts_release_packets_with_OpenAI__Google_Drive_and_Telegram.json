    {
      "id": "4511575d-4f28-453b-8dfc-a3c6c58108fc",
      "name": "Calculate Release Blockers",
      "type": "n8n-nodes-base.code",
      "position": [
        2976,
        352
      ],
      "parameters": {
        "jsCode": "const sources=['Fetch OEM Eligibility','Fetch Serialized Life History','Fetch Airworthiness Directive Status'].map(name=>$(name).all().map(i=>i.json));\nreturn $('Split Requested Parts').all().map((item,index)=>{const p=item.json;const lookup=rows=>{const matches=rows.filter(r=>r.partNumber===p.partNumber&&r.serialNumber===p.serialNumber);if(matches.length>1)throw Error('Ambiguous evidence for '+p.serialNumber);return matches[0]||{};};const [oem,life,ad]=sources.map(lookup);const blockers=[];\nif(oem.oemEligible!==true)blockers.push('OEM_ELIGIBILITY_NOT_CONFIRMED');\nif(typeof life.releaseCertificate!=='string'||!life.releaseCertificate.trim())blockers.push('MISSING_RELEASE_CERTIFICATE');\nif(typeof life.remainingCycles!=='number'||!Number.isFinite(life.remainingCycles)||life.remainingCycles<=0)blockers.push('LIFE_NOT_CONFIRMED');\nif(ad.openDirective!==false)blockers.push('DIRECTIVE_STATUS_NOT_CLEAR');\nreturn {json:{...p,evidence:{oem,life,ad},blockers,releaseState:blockers.length?'QUARANTINE':'ELIGIBLE'},pairedItem:{item:Math.min(index,$input.all().length-1)}};});"
      },
      "retryOnFail": false,
      "typeVersion": 2
    },
