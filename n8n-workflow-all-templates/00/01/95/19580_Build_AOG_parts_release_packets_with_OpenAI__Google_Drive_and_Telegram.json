    {
      "id": "ae54cb8b-51c0-4baa-bc60-e8a2803514ce",
      "name": "Normalize Part and Aircraft Context",
      "type": "n8n-nodes-base.code",
      "position": [
        1024,
        352
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item,index)=>{const b=item.json.body;if(!b||!Array.isArray(b.parts)||b.parts.length===0)throw Error('Provide a non-empty body.parts array');if(!b.requestId||!b.aircraftId)throw Error('requestId and aircraftId are required');return {json:{requestId:String(b.requestId),aircraftId:String(b.aircraftId),parts:b.parts},pairedItem:{item:index}};});"
      },
      "retryOnFail": false,
      "typeVersion": 2
    },
    {
      "id": "78306793-f7d9-4854-be44-b0f1b01d621a",
      "name": "Split Requested Parts",
      "type": "n8n-nodes-base.code",
      "position": [
        1312,
        352
      ],
      "parameters": {
        "jsCode": "const seen=new Set();return $input.all().flatMap((item,index)=>item.json.parts.map(p=>{if(!p.partNumber||!p.serialNumber)throw Error('Every part needs partNumber and serialNumber');const key=String(p.partNumber)+'|'+String(p.serialNumber);if(seen.has(key))throw Error('Duplicate part identity in request');seen.add(key);return {json:{requestId:item.json.requestId,aircraftId:item.json.aircraftId,partNumber:String(p.partNumber),serialNumber:String(p.serialNumber)},pairedItem:{item:index}};}));"
      },
      "retryOnFail": false,
      "typeVersion": 2
    },
