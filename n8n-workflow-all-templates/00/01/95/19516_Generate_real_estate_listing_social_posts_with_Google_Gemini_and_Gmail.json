    {
      "id": "771bbf69-baad-4159-bef2-4452f8205a6e",
      "name": "Extract Listing Details",
      "type": "n8n-nodes-base.code",
      "position": [
        -64,
        -64
      ],
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\n// Detect Google Form response vs webhook payload\n// Google Form responses come as column-named fields\nconst isFormResponse = !!(raw['Property Address'] || raw['Listing Price']);\n\nlet fields = {};\n\nif (isFormResponse) {\n  // Google Sheets Trigger — Form response columns\n  fields = {\n    agentName:           raw['Your Name']                    || null,\n    agentEmail:          raw['Agent Email']                  || null,\n    address:             raw['Property Address']             || null,\n    price:               raw['Listing Price']                || null,\n    bedrooms:            raw['Bedrooms']                     || null,\n    bathrooms:           raw['Bathrooms']                    || null,\n    propertyType:        raw['Property Type']                || null,\n    keyFeatures:         raw['Key Features']                 || null,\n    targetBuyer:         raw['Target Buyer']                 || null,\n    additionalHighlights:raw['Anything else to highlight?']  || null,\n    imageUrl:            raw['Property Image URL (for Instagram — optional)'] || null\n  };\n} else {\n  // Webhook payload\n  const body = raw.body || raw;\n  fields = {\n    agentName:           body.agentName           || body.name       || null,\n    agentEmail:          body.agentEmail           || body.email      || null,\n    address:             body.address                                 || null,\n    price:               body.price                                   || null,\n    bedrooms:            body.bedrooms             || body.beds       || null,\n    bathrooms:           body.bathrooms            || body.baths      || null,\n    propertyType:        body.propertyType         || body.type       || null,\n    keyFeatures:         body.keyFeatures          || body.features   || null,\n    targetBuyer:         body.targetBuyer          || body.buyer      || null,\n    additionalHighlights:body.additionalHighlights || body.highlights || null,\n    imageUrl:            body.imageUrl             || null\n  };\n}\n\nreturn [{\n  json: {\n    ...fields,\n    timestamp: new Date().toISOString(),\n    recordId: `post-${Date.now()}`\n  }\n}];"
      },
      "typeVersion": 2
    },
