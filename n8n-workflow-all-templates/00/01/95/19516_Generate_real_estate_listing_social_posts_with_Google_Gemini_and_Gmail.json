    {
      "id": "f1aa4860-c486-412e-90f8-1d9266ef2436",
      "name": "Generate Social Posts",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "position": [
        352,
        -64
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "options": {
          "systemMessage": "You are a real estate social media copywriter. Generate four platform-specific posts for a new property listing.\n\nPLATFORM REQUIREMENTS:\n\nINSTAGRAM:\n- 3-5 sentences, conversational and aspirational\n- 2-3 emojis used naturally\n- Clear call to action at the end\n- 20-25 relevant hashtags\n\nFACEBOOK:\n- 4-6 sentences, friendly and informative\n- Highlight specific key features\n- End with an engagement question\n- 5-8 hashtags only\n\nLINKEDIN:\n- 3-4 sentences, professional market-insight tone\n- Position as a market opportunity not just a listing\n- No more than 5 professional hashtags\n\nX (TWITTER):\n- Maximum 240 characters total including hashtags\n- One key selling point only, punchy and direct\n- 2-3 hashtags maximum\n- Count characters carefully — must be under 240\n\nTONE BY TARGET BUYER:\n- First-time buyer: encouraging, accessible, educational\n- Family: warm, practical, neighbourhood-focused\n- Investor: data-driven, ROI-focused, market context\n- Upsizer: aspirational, space and lifestyle focused\n- Downsizer: convenience, low-maintenance, lifestyle\n- Luxury buyer: exclusive, sophisticated, understated\n\nOutput ONLY valid JSON, no preamble, no markdown:\n{\n  \"instagram_post\": \"post text\",\n  \"instagram_hashtags\": \"#tag1 #tag2 #tag3\",\n  \"facebook_post\": \"post text\",\n  \"facebook_hashtags\": \"#tag1 #tag2\",\n  \"linkedin_post\": \"post text\",\n  \"linkedin_hashtags\": \"#tag1 #tag2\",\n  \"x_post\": \"post text under 240 chars including hashtags\",\n  \"x_hashtags\": \"#tag1 #tag2\",\n  \"suggested_caption\": \"one line image caption for any platform\"\n}"
        },
        "messages": {
          "values": [
            {
              "content": "=Property Address: {{ $('Extract Listing Details').first().json.address }}\nListing Price: {{ $('Extract Listing Details').first().json.price }}\nBedrooms: {{ $('Extract Listing Details').first().json.bedrooms }}\nBathrooms: {{ $('Extract Listing Details').first().json.bathrooms }}\nProperty Type: {{ $('Extract Listing Details').first().json.propertyType }}\nKey Features: {{ $('Extract Listing Details').first().json.keyFeatures }}\nTarget Buyer: {{ $('Extract Listing Details').first().json.targetBuyer }}\nAdditional Highlights: {{ $('Extract Listing Details').first().json.additionalHighlights || 'None' }}\nAgent Name: {{ $('Extract Listing Details').first().json.agentName || $('Configuration').first().json.AGENT_NAME }}"
            }
          ]
        },
        "builtInTools": {}
      },
      "credentials": {
        "googlePalmApi": {
          "id": "oaBZTFjPqHP2QG4W",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "e4a5bdcc-a27d-4b3d-af61-e891dceee55f",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "position": [
        704,
        -64
      ],
      "parameters": {
        "jsCode": "// ============================================================\nconst EXTRACT_NODE = 'Extract Listing Details';\nconst CONFIG_NODE  = 'Configuration';\n// ============================================================\n\nconst listing = $(EXTRACT_NODE).first().json;\nconst config  = $(CONFIG_NODE).first().json;\nconst allItems = $input.all();\n\n// Extract Gemini output\nlet rawText = '';\nfor (const item of allItems) {\n  const text = item.json?.content?.parts?.[0]?.text\n    || item.json?.candidates?.[0]?.content?.parts?.[0]?.text\n    || item.json?.output || '';\n  if (text && text.includes('instagram_post')) {\n    rawText = text;\n    break;\n  }\n}\n\nconst cleaned = rawText\n  .replace(/```json\\s*/gi, '')\n  .replace(/```\\s*/gi, '')\n  .trim();\n\n// Parse with fallback\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  const address = listing.address || 'this property';\n  parsed = {\n    instagram_post:    `Just listed! ${address} — a beautiful property waiting for its new owners. Contact us today to arrange a viewing! 🏠`,\n    instagram_hashtags: '#realestate #justlisted #newlisting #property #forsale',\n    facebook_post:     `Exciting new listing at ${address}! Get in touch to find out more about this fantastic property. We would love to help you make it your home.`,\n    facebook_hashtags: '#realestate #newlisting #forsale',\n    linkedin_post:     `New listing alert: ${address} has just come to market. A great opportunity in the current market — reach out for more information.`,\n    linkedin_hashtags: '#realestate #newlisting #property',\n    x_post:            `Just listed: ${address} 🏠 Contact us to arrange a viewing! #realestate #forsale`,\n    x_hashtags:        '#realestate #forsale',\n    suggested_caption: `Just listed: ${address} — your dream home awaits.`\n  };\n}\n\n// HTML email formatter\nfunction escapeHtml(text) {\n  if (!text) return '';\n  return String(text)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\nfunction section(platform, emoji, post, hashtags) {\n  return `\n    <div style=\"margin:20px 0;padding:16px;background:#f8f9fa;\n      border-radius:8px;border-left:4px solid #3498db;\">\n      <p style=\"margin:0 0 8px 0;font-weight:bold;font-size:15px;\">\n        ${emoji} ${platform}\n      </p>\n      <p style=\"margin:0 0 12px 0;line-height:1.6;\">\n        ${escapeHtml(post)}\n      </p>\n      <p style=\"margin:0;color:#666;font-size:13px;\">\n        ${escapeHtml(hashtags)}\n      </p>\n    </div>`;\n}\n\nconst agentName  = listing.agentName  || config.AGENT_NAME  || 'Your Agent';\nconst agentEmail = listing.agentEmail || config.AGENT_EMAIL || '';\n\nconst emailHtml = `\n  <div style=\"font-family:Arial,sans-serif;max-width:640px;margin:0 auto;color:#333;\">\n    <div style=\"background:#1a1a2e;color:white;padding:24px;border-radius:8px 8px 0 0;\">\n      <h2 style=\"margin:0;\">🏠 Social Media Posts Ready</h2>\n      <p style=\"margin:8px 0 0 0;opacity:0.8;font-size:14px;\">\n        ${escapeHtml(listing.address)} | \n        ${escapeHtml(listing.price)} | \n        ${escapeHtml(listing.bedrooms)}bd ${escapeHtml(listing.bathrooms)}ba\n      </p>\n    </div>\n    <div style=\"padding:24px;background:white;\">\n      <p style=\"color:#888;font-size:13px;margin:0 0 16px 0;\">\n        Copy and paste each post directly to your social media platforms.\n      </p>\n      ${section('Instagram', '📸', parsed.instagram_post, parsed.instagram_hashtags)}\n      ${section('Facebook', '📘', parsed.facebook_post, parsed.facebook_hashtags)}\n      ${section('LinkedIn', '💼', parsed.linkedin_post, parsed.linkedin_hashtags)}\n      ${section('X (Twitter)', '🐦', parsed.x_post, parsed.x_hashtags)}\n      <div style=\"margin:20px 0;padding:16px;background:#fff3cd;\n        border-radius:8px;border-left:4px solid #f39c12;\">\n        <p style=\"margin:0 0 4px 0;font-weight:bold;\">📷 Suggested Image Caption</p>\n        <p style=\"margin:0;font-size:14px;\">\n          ${escapeHtml(parsed.suggested_caption)}\n        </p>\n      </div>\n    </div>\n    <div style=\"background:#f8f9fa;padding:16px 24px;\n      border-radius:0 0 8px 8px;border-top:1px solid #ddd;\n      font-size:12px;color:#888;\">\n      Generated by QualMatic AI for ${escapeHtml(agentName)}\n    </div>\n  </div>\n`;\n\n// X character count validation\nconst xFull = `${parsed.x_post} ${parsed.x_hashtags}`.trim();\nconst xCharCount = xFull.length;\nconst xWarning = xCharCount > 240\n  ? `⚠️ X post is ${xCharCount} characters — trim before posting.`\n  : null;\n\nreturn [{\n  json: {\n    // Listing metadata\n    address:      listing.address,\n    price:        listing.price,\n    bedrooms:     listing.bedrooms,\n    bathrooms:    listing.bathrooms,\n    propertyType: listing.propertyType,\n    targetBuyer:  listing.targetBuyer,\n    agentName,\n    agentEmail,\n    imageUrl:     listing.imageUrl || null,\n    recordId:     listing.recordId,\n    timestamp:    listing.timestamp,\n\n    // Generated posts\n    instagram_post:      parsed.instagram_post,\n    instagram_hashtags:  parsed.instagram_hashtags,\n    facebook_post:       parsed.facebook_post,\n    facebook_hashtags:   parsed.facebook_hashtags,\n    linkedin_post:       parsed.linkedin_post,\n    linkedin_hashtags:   parsed.linkedin_hashtags,\n    x_post:              parsed.x_post,\n    x_hashtags:          parsed.x_hashtags,\n    suggested_caption:   parsed.suggested_caption,\n    xCharCount,\n    xWarning,\n\n    // Full post + hashtags combined for direct posting\n    facebook_full: `${parsed.facebook_post}\\n\\n${parsed.facebook_hashtags}`,\n    instagram_full: `${parsed.instagram_post}\\n\\n${parsed.instagram_hashtags}`,\n\n    // Email\n    emailHtml,\n\n    // Config\n    POST_TO_FACEBOOK:     config.POST_TO_FACEBOOK,\n    POST_TO_INSTAGRAM:    config.POST_TO_INSTAGRAM,\n    FACEBOOK_PAGE_ID:     config.FACEBOOK_PAGE_ID,\n    INSTAGRAM_ACCOUNT_ID: config.INSTAGRAM_ACCOUNT_ID,\n    META_ACCESS_TOKEN:    config.META_ACCESS_TOKEN\n  }\n}];"
      },
      "typeVersion": 2
    },
