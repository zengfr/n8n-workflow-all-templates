                      "type": "number",
                      "operation": "gte"
                    },
                    "leftValue": "={{ $runIndex + 1 }}",
                    "rightValue": "={{ $('Settings').item.json.maxPolls }}"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "still working"
        }
      },
      "typeVersion": 3.2
    },
