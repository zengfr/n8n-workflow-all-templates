                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "gave up",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "giveup",
