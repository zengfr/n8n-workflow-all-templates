    {
      "id": "a8321f6d-8725-4466-803c-e7c33a6f8745",
      "name": "Clean Data",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        1824,
        832
      ],
      "parameters": {
        "text": "=The following text was extracted via OCR from a screenshot of a LinkedIn post and may contain broken line breaks, misread characters, or garbled symbols. Reconstruct it as clean, readable text preserving the original paragraph/line-break structure as best you can infer it. Remove any kind of likes or comment numbers . Do not add or remove content — only fix OCR artifacts. Output ONLY the cleaned text with no preamble, no explanation, and no markdown formatting.\n\n{{ $('Google Drive Trigger').item.json.id }}",
