    {
      "id": "5b9d1826-1a56-4736-9d40-994ecb9046c5",
      "name": "Set Payment Friction",
      "type": "n8n-nodes-base.set",
      "position": [
        1504,
        576
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "6908d0e2-462a-4464-a88d-0657ff42de5d",
              "name": "paymentFriction",
              "type": "number",
              "value": "={{ Math.min(100, ($json.late_payment_count_6mo * 12) + ($json.avg_days_past_due * 2) + ($json.partial_payment_count * 8)) }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "id": "7af5280a-2463-4c2c-a196-237f64d2f5a4",
      "name": "Set Maintenance Friction",
      "type": "n8n-nodes-base.set",
      "position": [
        1728,
        576
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "d5bc6cd2-39cf-4125-ae73-eaab23e3514c",
              "name": "maintenanceFriction",
              "type": "number",
              "value": "={{ Math.min(100, ($json.unresolved_tickets_72h * 15) + ($json.emergency_ticket_count * 10) + ((5 - ($json.post_repair_rating || 5)) * 8)) }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "id": "709ee1d7-eb97-4e48-806e-19a68e546ad3",
