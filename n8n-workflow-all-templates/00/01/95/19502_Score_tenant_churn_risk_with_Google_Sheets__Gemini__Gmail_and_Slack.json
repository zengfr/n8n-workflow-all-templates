    {
      "id": "60d4d85c-8b31-42a0-be2d-2d3e4ac28370",
      "name": "Sentiment Analyzer Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        2176,
        576
      ],
      "parameters": {
        "text": "=Analyze the sentiment of this tenant's recent communications and return ONLY valid JSON, no markdown, no commentary.\n\nTenant ID: {{$json.tenant_id}}\nPortal messages: {{$json.portal_messages}}\nReview submissions: {{$json.review_text}}\nEmail communications: {{$json.email_text}}\n\nReturn JSON in this exact shape:\n{\"sentiment_score\": <integer 0-100, where 100 = most negative/highest churn risk>, \"sentiment_summary\": \"<one sentence>\"}",
        "options": {
          "systemMessage": "You are a tenant sentiment scoring engine for a property management churn model. You only ever respond with strict JSON matching the requested schema. Never add prose outside the JSON object."
        },
        "promptType": "define"
      },
      "typeVersion": 1.9
    },
    {
      "id": "2ac28ead-c22a-4122-b157-0cd66c2ddc9f",
      "name": "Set Sentiment Scores",
      "type": "n8n-nodes-base.set",
      "position": [
        2464,
        576
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "3fcda2bf-e697-4221-9231-e85fe0b63c00",
              "name": "sentimentScore",
              "type": "number",
              "value": "={{ JSON.parse($json.output).sentiment_score }}"
            },
            {
              "id": "ab781527-d556-41d9-970e-7bd16bbe9fb4",
              "name": "sentimentSummary",
              "type": "string",
              "value": "={{ JSON.parse($json.output).sentiment_summary }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "id": "49fed701-a557-4ecb-b219-a819457a3c31",
      "name": "Set Weighted Risk Score",
      "type": "n8n-nodes-base.set",
      "position": [
        2704,
        576
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "38280874-9cd3-4a55-b64a-c3f8d72eaa11",
              "name": "riskScore",
              "type": "number",
              "value": "={{ Math.round((Number($('Set Payment Friction').item.json.paymentFriction || 0) * Number($('Set Configuration Params').first().json.w_payment || 0.30)) + (Number($('Set Maintenance Friction').item.json.maintenanceFriction || 0) * Number($('Set Configuration Params').first().json.w_maintenance || 0.25)) + (Number($json.sentimentScore || 0) * Number($('Set Configuration Params').first().json.w_sentiment || 0.25)) + (Number($('Set Lease Proximity').item.json.leaseProximity || 0) * Number($('Set Configuration Params').first().json.w_lease || 0.20))) }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "id": "c2a0ecae-1de1-44c0-acf9-2378c11a0407",
      "name": "Set Risk Tier Label",
      "type": "n8n-nodes-base.set",
      "position": [
        2944,
        576
      ],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "c0010fbe-c55a-49ca-9bec-e21fa5a8781f",
              "name": "riskTier",
              "type": "string",
              "value": "={{ $json.riskScore >= 70 ? 'High' : ($json.riskScore >= 40 ? 'Medium' : 'Low') }}"
            }
          ]
        },
        "includeOtherFields": true
      },
      "typeVersion": 3.4
    },
    {
      "id": "a924e57d-2103-4a77-944e-22062b557bfa",
      "name": "Route by Risk Tier",
      "type": "n8n-nodes-base.switch",
      "position": [
        3152,
        544
      ],
      "parameters": {
        "mode": "expression",
        "output": "={{ $json.riskTier === 'High' ? 0 : ($json.riskTier === 'Medium' ? 1 : 2) }}"
      },
      "typeVersion": 3.2
    },
